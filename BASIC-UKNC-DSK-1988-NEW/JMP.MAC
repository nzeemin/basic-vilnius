	MOV	#MAG,R0
	MOV	#WR.*400,(0)+
	MOV	#11,(0)+
	MOV	(SP)+,22(0)
	MOV	(SP)+,20(0)
	CALL	$BIN
	BIC	#1,@R0
	SUB	(0)+,@R0
	BLOS	BS3
	CLC
	ROR	@R0
	ADC	(0)+
	MOV	R4,@#SAVJMP
	CALL	CAS
BS4:
	MOV	@#SAVJMP,R4

	CLR	@#SAVJMP
BS2::	JMP	@(4)+
BS3::	TRAP	5
