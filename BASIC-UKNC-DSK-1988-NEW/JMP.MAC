$SAVE::	CMP	TABTOP,FCB
	BEQ	ST
CALL	CLOALL

	MOV	#MAG,R0
	MOV	#WR.*400,(0)+
	MOV	#12,(0)+
	CALL	$ASC
	MOV	FCB,(R0)+
	MOV	#200,(0)+
	MOV	#WR.*400,-(SP)
	MOV	R4,@#SAVJMP
	MOV	@#FCB,R4
	MOV	#AVPK,R0
	CALL	TSTVCT
	BCC	2$
