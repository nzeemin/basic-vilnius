	BLE	NOTOP
FNDCR:	CALL	FNDBUF
	TST	@R0
	BEQ	NOTOP
	BIT	#RD.*400,@R0
	BEQ	BADFN
	CLR	R3
	BISB	@R0,R3
	ADD	R0,R3
	ADD	#22,R3
	RETURN
;
EOF::	CLR	-(SP)
	CALL	FNDCR
	CMPB	@R3,#32	;^Z
	BNE	1$
	COM	@SP
1$:	JMP	@(4)+
;
FILINP::CALL	FNDCHR
	MOV	R0,R5
	ADD	#22,R5
COPYIN::MOV	#BUF,R1
1$:	CMPB	@R3,#32
	BEQ	3$
	CMP	R1,#BUF+417
	BHIS	4$
	MOVB	(3)+,(1)

	INCB	(0)
	BNE	2$
	MOV	R1,-(SP)
	MOV	R0,-(SP)
	SUB	#400,R3
	CALL	BLOCKN
	CALL	CASCII
MOV	#16*400,@#MAG
	CALL	CAS
	CALL	ISVARD
	MOV	(SP)+,R0
	MOV	(SP)+,R1
2$:	CMPB	@R1,#CR
	BEQ	1$
	CMPB	(1)+,#LF
	BNE	1$
3$:	MOVB	#LF,@R1
5$:	RETURN
4$:	TRAP	25.
