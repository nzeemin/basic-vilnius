	BEQ	6$
	BIT	#WR.*400,R3
	BEQ	3$
	BIC	#177400,R3
	ADD	R0,R3
	ADD	#22,R3
	CALL	CLOUTF
	BR	6$

3$:	CALL	CASCII		;CLINF
	CALL	LASTBL
	CLR	@R0
	CALL	CAS
6$:
CLR	@#ASCFLG
	RETURN
