	SOB	R5,6$
7$:	MOV	#4,R5
8$:	MOVB	(3)+,(0)+
	DEC	R5
	BEQ	10$
	SOB	R2,8$
9$:	MOVB	#40,(0)+
	SOB	R5,9$
10$:	DEC	R2
	BGT	5$
	ADD	#10,R1
