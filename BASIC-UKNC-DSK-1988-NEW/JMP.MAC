$BLOAD::
CALL	CLOALL

	MOV	#MAG,R0
	MOV	#RD.*400,(0)+
	MOV	#11,(0)+
	MOV	(SP)+,20(0)
	MOV	#-2,22(0)
	CALL	$BIN

MOV	#160000,R1

;	CMP	@R0,#TEXT
;	BLO	BS3
	SUB	(0)+,R1
	BLOS	BS3
	CLC
	ROR	R1
	MOV	R1,(0)+
	MOV	R4,@#SAVJMP
	MOV	(SP)+,R3
	CALL	CAS
	CALL	ISVARD
	TST	R3
	BEQ	BL1
	CLR	LYGIS
	BIT	#1,@#MAG+ADRW
	BNE	10$
	CALL	@MAG+ADRW
	BR	BL1
