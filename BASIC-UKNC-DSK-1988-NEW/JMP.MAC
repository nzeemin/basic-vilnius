ISVARD::TSTB	LYGIS
	BNE	1$
	MOV	R0,-(SP)
	MOV	R1,-(SP)
	MOV	#MAG+NAMER,R1
	MOV	#20,R2
	CMP	6(R1),#401*352
	BNE	3$
	CMPB	#16,-NAMER+1(R1)
	BEQ	6$
	ADD	#12,R1
	SUB	#12,R2
3$:
	.BJSR	ISVEIL
	MOV	#12,R0
	CALL	ISV
6$:	MOV	(SP)+,R1
	MOV	(SP)+,R0
1$:	RETURN
;
TTANAL::
	MOV	R4,-(SP)
	MOV	R2,-(SP)
	MOV	R3,-(SP)
	TRAP	112
	MOV	R3,-(SP)

	CMP	-(SP),-(SP)
	MOV	SP,R5
	MOVB	(3)+,(5)+
	MOVB	(3)+,(5)+
	MOVB	(3)+,(5)+
	MOVB	(3)+,(5)+
	MOV	SP,R3
	TRAP	113
	.WORD	DEVTAB
	.BYTE	3,DEND-DRIVER-2
	BR	12$
	CMPB	@R3,#':
	BNE	12$
	INC	R3
	SUB	SP,R3
	CMP	(SP)+,(SP)+
	ADD	(SP)+,R3
	ADD	(SP),R2
	SUB	R3,R2
	BEQ	2$
	BMI	11$
	CMP	(SP)+,(SP)+
	BR	13$
12$:	ADD	#6,SP
11$:	MOV	(SP)+,R3
	MOV	(SP)+,R2
	CLR	R5
13$:	MOV	(SP)+,R4
	MOV	DRIVER(5),@#WRITE
	RETURN
2$:	TRAP	56.
