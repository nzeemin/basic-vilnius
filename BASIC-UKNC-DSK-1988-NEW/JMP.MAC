	.BYTE	RER.
	.BYTE	FER.,MER.,SER.
.EVEN
6$:
	.WORD	1$
	.WORD	7$,8$,BRKO

2$:	RETURN
1$:	TRAP	19.
7$:	TRAP	53.

8$:	TRAP	7

BLOCKN::MOV	#3,R1
	TST	-(R5)
