CLRMEM::
	CMP	@SP,@#WHIMEM
	BHI	C5
	CMP	@SP,#TEXT
	BLOS	C5

	MFPS	R3
	MTPS	#340
	.BJSR	NOSTOP
	CALL	CLOALL
	MOV	(SP)+,R2
	ASR	R2
	ASL	R2
	SUB	HIMEM,R2
	CALL	TABMOV
	ADD	R2,HIMEM
	.BJSR	CLRBUF
	.BJSR	CLRCOD
	MOV	(SP)+,R0
	INC	R0
	BIC	#1,R0
	MOV	R0,STRSIZ
	.BJSR	STOPEN
	MTPS	R3
S1T:
	JMP	STAR
;
TABMOV::MOV	TABTOP,R0
	ADD	R2,R0
	CMP	R0,TXEND
	BLO	CLRERR
	MOV	FCB,R1
	SUB	TABTOP,R1
	BEQ	4$
	ASR	R1
