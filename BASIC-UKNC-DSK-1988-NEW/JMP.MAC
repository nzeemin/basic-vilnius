CLOUTF::MOVB	#32,(R3)+	;^Z
	INCB	@R0
	BNE	CLOUTF
	CALL	CASCII
	CLR	@R0
	CALL	CAS
	CALL	LASTBL
	CLR	@MAG+ADRW
	CALL	CAS
	RETURN
