TESTR:
	CALL	ISVARD
	MOV	(SP)+,R5
	MOV	@#SAVJMP,R4
	CLR	@#SAVJMP
	TST	(SP)+
	BGT	BS2
	BEQ	1$
	MOV	FCB,R4
	MOV	-(4),R5
	CLR	LYGIS
	JMP	LRUN
1$:	MOV	R5,PC

DEVTAB:
	.BYTE	0,40
	.ASCII	/CAS /
	.EVEN

