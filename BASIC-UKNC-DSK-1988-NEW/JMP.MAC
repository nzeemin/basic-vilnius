$CSAVE::CMP	TABTOP,FCB
	BEQ	ST
CALL	CLOALL

	MOV	#MAG,R0
	MOV	#WR.*400,(0)+
	MOV	#11,(0)+
	CALL	$COD
	MOV	#TEXT,(0)+
	CLR	(0)+
	MOV	R4,SAVJMP
	.BJSR	CLRCOD
	.BJSR	GRBCOL
	MOV	R1,R5
	MOV	TABTOP,R4
	MOV	R5,@#MAG+LENW
	SUB	#TEXT-2,@#MAG+LENW
7$:	MOV	(4)+,(5)+
	CMP	R4,FCB
	BLO	7$

	MOV	R4,@R5
	SUB	TABTOP,(R5)
	MOV	#MAG,R1
	ADD	(5)+,LENW(R1)
	CLC
	ROR	LENW(R1)
	CALL	@WRITE
	CALL	ATSTAB
	CALL	CASERR
	BR	ST
