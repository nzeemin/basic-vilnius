FILNAM::MOV	4(SP),R3
	MOV	(SP)+,2(SP)
	CALL	CLRTSP
	MOV	(SP)+,R2
	BEQ	5$
	MOV	R5,-(SP)
	MOV	R4,SAVJMP
	CALL	TTANAL
	MOV	SAVJMP,R4
	CLR	SAVJMP
	MOV	#6,R5
1$:	CMPB	(R3),#'.
	BEQ	6$
	MOVB	(R3)+,(R0)+
	DEC	R5
	BEQ	3$
	SOB	R2,1$
2$:	MOVB	#40,(R0)+
	SOB	R5,2$
3$:	DEC	R2
	BLE	4$
	CMPB	@R3,#'.
	BEQ	7$
