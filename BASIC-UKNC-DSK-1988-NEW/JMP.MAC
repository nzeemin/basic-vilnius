	MFPS	-(SP)
	MTPS	#340
	.BJSR	NOSTOP
	MOV	@R0,R1
	MOV	-(R1),@R0
	CLR	@R1
	MOV	-(R1),@R2
	.BJSR	STOPEN
	MTPS	(SP)+
	CLC
