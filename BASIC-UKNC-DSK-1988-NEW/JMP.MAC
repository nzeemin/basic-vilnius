	MOV	R4,SAVJMP
	TST	@SP
	BEQ	FL6
	CALL	$ASC
	MOV	R4,SAVJMP
	MOV	-(0),-(SP)	;TURI BUTI >0
	MOV	#MAG+NAMEW+7,R3
	TRAP	113
	.WORD	FILTYP
	.BYTE	3,2
	BR	L1
	DEC	R3
	MOV	R3,R0
	CALL	@BINCOD(R5)
	BR	L2
