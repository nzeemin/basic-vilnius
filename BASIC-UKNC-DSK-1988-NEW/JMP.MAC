CASCII::CMP	R0,FCB
	BLO	2$
	MOV	DRIVER,@#WRITE
	MOV	#MAG,R1
	MOV	(0)+,(1)+
	BPL	10$
	BIC	#100000,-2(1)
	MOV	DRIVER+2,@#WRITE
10$:
	MOV	#12,(1)+
	MOV	#10,R5
1$:	MOV	(0)+,(1)+
	SOB	R5,1$
	MOV	R0,R5
	MOV	R0,(1)+
	MOV	#200,(R1)+
	SUB	#22,R0
