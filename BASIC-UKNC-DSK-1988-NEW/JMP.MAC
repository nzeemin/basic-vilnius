	CMP	R4,TABTOP
	BHI	1$
	CALL	CLOUTF
	MOV	#AVPK,R0
	CALL	TSTVCT
	BCC	3$
	MOV	#IVS,@R0
3$:
	MOV	#5007,@#BUF
	BR	BS4

$BL0::
	MOV	#1,-(SP)
