	.INCLUDE /GENUKD.MAC/
	.SBTTL	EXECUTIONS KERN EXPANTION

	.GLOBL	SYSPTR,USRLOC,ASCFLG

	.MACRO	.BJSR	ADR
	.IF EQ,MASINA-BK0011
		MOV	#PAG2,-(SP)
		MOV	#ADR,-(SP)
		.BJSR0
	.IFF
		CALL	ADR
	.ENDC
	.ENDM

	.GLOBL	BRKO,ISVEIL,DAUG,ENDPRG,TMPSP,CLRTMP,CLRTSP
	.GLOBL	TXEND,LYGIS,STRREG,STRSIZ,CURON,CUROFF,STACK
	.GLOBL	TRFLAG,TRIN,LIMIT,SAVJMP
	.GLOBL	ADRHLT,STAR,ENDCOD,LENT,CIKL,IVEIL
	.GLOBL	ISVTO,ISVETO,FCB,EGO,ISGUNP,HIMEM
	.GLOBL	NAMEW,NAMER,RD.,WR.,FR.,ADRR,ADRW,LENW,FER.,NER.,MER.,RER.,SER.
	.GLOBL	BUF,PACK,TABTOP,BUFOUT,FREBEG,FRELEN,NUMBER
	.GLOBL	USRTAB,DATINP,DATPTR,IODEV,MAG			;MAXFIL
	.GLOBL	WRITE,COPOUT,CISLO
	.GLOBL	EILUTE,LRUN,CLRTX1,ASCCOD,TEXT,ERRS,GRBCOL
	.GLOBL	CLRBUF,CLRCOD,LPTPOS,PFACT			;SIGNAL
	.GLOBL	VCTNMB						;ONERFL

	.GLOBL	ISV,SEPAP

	.GLOBL	ADR,RI,IR

	.GLOBL	RT11
	.GLOBL	MAGNIT

	.GLOBL	NOSTOP,STOPEN

	.GLOBL	TABX,TABY,INBF0,TSTBRK,AVPK,FIRST,LAST,IVS,ISV1
	.GLOBL	NIM,LN,MAXLL,LL,EBUF,CURS,LOK
	.GLOBL	SETWDT,MIDLE
	.GLOBL	CRTGRP

; INKEY$ - прочитать один символ из очереди клавиатуры без ожидания;
; пустая строка, если очередь пуста (FIRST=LAST - границы кольцевого буфера).
INKEY::	CLR	-(SP)		; длина строки-результата (пока 0)
	CLR	-(SP)		; адрес строки-результата (пока 0)
	CMP	FIRST,LAST	; очередь клавиатуры пуста?
	BEQ	1$		; да - вернуть пустую строку =>
	INC	@SP		; длина = 1 символ
	CALL	TSTFRE		; выделить память под строку из 1 байта
	CALL	NIM		; NIM = взять очередной символ из очереди
	MOVB	R0,@2(SP)	; записать его в строку
1$:	BR	NEWTMP		; зарегистрировать строку как временную, продолжить

; OCT$(n) - восьмеричное представление целого числа. Буфер максимального
; размера (VIETOS), цифры пишутся с конца назад, R0 сдвигается на 3 бита
; вправо (беззнаково, через CLC/ROR/ASR/ASR) на каждую цифру, пока не
; останется нулей; итоговая строка - фактически записанная часть буфера.
OCT::
	MOV	#6,R5		; максимум 6 восьмеричных цифр (16 бит)
	CALL	VIETOS		; выделить буфер, R1 = конец буфера
	MOV	@SP,R0		; R0 = число
	MOV	R1,-(SP)	; запомнить конец буфера (для вычисления длины)
1$:	DEC	R5
	BMI	REGFUL		; цифр больше, чем в буфере - не должно случаться =>
	MOV	R0,R2
	BIC	#177770,R2	; младшие 3 бита - очередная восьмеричная цифра
	ADD	#'0,R2		; в код символа '0'..'7'
	MOVB	R2,-(R1)	; записать цифру (с конца буфера)
	CLC
	ROR	R0		; беззнаковый сдвиг R0 вправо на 3 бита
	ASR	R0
	ASR	R0
	BNE	1$		; ещё есть значащие биты - следующая цифра =>
	SUB	R1,@SP		; длина строки = сколько цифр записано
	MOV	R1,2(SP)	; адрес начала строки
	BR	NEWTMP		; зарегистрировать строку как временную, продолжить
;
; BIN$(n) - двоичное представление целого числа. Как OCT, но по 1 биту
; за раз (максимум 16 цифр).
BIN::
	MOV	#16,R5		; максимум 16 двоичных цифр (16 бит)
	CALL	VIETOS		; выделить буфер, R1 = конец буфера
	MOV	@SP,R0		; R0 = число
	MOV	R1,-(SP)	; запомнить конец буфера (для вычисления длины)
1$:	DEC	R5
	BMI	REGFUL		; цифр больше, чем в буфере - не должно случаться =>
	MOV	R0,R2
	BIC	#177776,R2	; младший бит - очередная двоичная цифра
	ADD	#000060,R2	; в код символа '0'/'1'
	MOVB	R2,-(R1)	; записать цифру (с конца буфера)
	CLC
	ROR	R0		; беззнаковый сдвиг R0 вправо на 1 бит
	BNE	1$		; ещё есть значащие биты - следующая цифра =>
	SUB	R1,@SP		; длина строки = сколько цифр записано
	MOV	R1,2(SP)	; адрес начала строки
	BR	NEWTMP		; зарегистрировать строку как временную, продолжить
;
; HEX$(n) - шестнадцатеричное представление целого числа. Как OCT/BIN, но
; по 4 бита за раз (максимум 4 цифры), с выбором '0'-'9' или 'A'-'F'.
; ЗАМЕЧАНИЕ: цикл ниже переходит по BNE на 3$ (сразу на запись цифры),
; минуя пересчёт R2 из нового R0 (нет заново MOV R0,R2/BIC/CMP) - похоже на
; ошибку в исходнике: для чисел с более чем одной значащей цифрой повторно
; пишется цифра, вычисленная на первом проходе.
HEX::
	MOV	#4,R5		; максимум 4 шестнадцатеричные цифры (16 бит)
	CALL	VIETOS		; выделить буфер, R1 = конец буфера
	MOV	@SP,R0		; R0 = число
	MOV	R1,-(SP)	; запомнить конец буфера (для вычисления длины)
1$:	DEC	R5
	BMI	REGFUL		; цифр больше, чем в буфере - не должно случаться =>
	MOV	R0,R2
	BIC	#177760,R2	; младшие 4 бита - очередная шестнадцатеричная цифра
	CMP	R2,#9.
	BLE	2$		; цифра 0..9 =>
	ADD	#000067,R2	; 10..15 -> 'A'..'F'
	BR	3$
2$:	ADD	#000060,R2	; 0..9 -> '0'..'9'
3$:	MOVB	R2,-(R1)	; записать цифру (с конца буфера)
	CLC
	ROR	R0		; беззнаковый сдвиг R0 вправо на 4 бита
	ASR	R0
	ASR	R0
	ASR	R0
	BNE	3$		; ещё есть значащие биты - см. замечание выше
	SUB	R1,@SP		; длина строки = сколько цифр записано
	MOV	R1,2(SP)	; адрес начала строки

	BR	NEWTMP		; зарегистрировать строку как временную, продолжить
;
; TSTFRE - выделить в строковой области память под строку длиной 2(SP)
; (простой bump-аллокатор: FREBEG - начало свободной области, FRELEN -
; сколько там осталось). Если не хватает - сборка мусора (STRSQU), затем
; повторная попытка; если и после неё не хватает - ошибка.
TSTFRE::
	SUB	2(SP),FRELEN	; хватает места без сборки мусора?
	BGE	1$		; да =>
	CALL	STRSQU		; нет - сборка мусора строковой области
	SUB	2(SP),FRELEN	; хватает теперь?
	BMI	STRFUL		; нет - ошибка =>
1$:	MOV	FREBEG,4(SP)	; вернуть адрес начала выделенной памяти
	ADD	2(SP),FREBEG	; сдвинуть границу свободной области
	RETURN
;
STRFUL:	CLR	FRELEN		; свободного места больше нет
REGFUL:	TRAP	14.		; ошибка - не хватает памяти под строки
;
; $CONST - строковый литерал: длина и адрес - в коде сразу после опкода
; (см. TRAP 120), переложить на стек выражения и провалиться в NEWTMP.
$CONST::MOV	(4)+,-(SP)	; длина строки
	MOV	(4)+,-(SP)	; адрес строки (прямо в тексте программы)
; NEWTMP - зарегистрировать строку на вершине стека как временную (список
; TMPSP - см. его использование/распаковку в JMIN.MAC RETFN): запаковать
; текущий SP и сделать его новой головой списка, старую голову - в
; строковый дескриптор (byte рядом с адресом).
NEWTMP::MOVB	TMPSP+1,1(SP)	; записать старую голову списка в дескриптор строки
	MOV	SP,TMPSP	; новая голова списка - текущая позиция на стеке
	ASR	TMPSP		; упаковать адрес (см. формат в RETFN, JMIN.MAC)
	SWAB	TMPSP
	JMP	@(4)+		; продолжить (диспетчер шитого кода)
;
; $VAR - чтение простой строковой переменной: адрес её данных - в коде
; (см. AKINPP в COMP.MAC). Слово по этому адресу - длина, следующее - адрес
; текста строки; переложить оба на стек выражения.
$VAR::	MOV	(4)+,R1		; R1 = адрес данных переменной (из кода)
	MOV	2(1),-(SP)	; длина строки
	MOV	@R1,-(SP)	; адрес текста строки
	BR	NEWTMP		; => зарегистрировать как временную, продолжить
;
; $XVAR - чтение строкового элемента массива: адрес дескриптора уже на
; стеке (вычислен опкодом INDEX/ARRAY). Дескриптор упакован в 3 байта:
; длина, младший и старший байт адреса (см. $XMOV в JMIN.MAC) - распаковать
; в обычные два слова (длина, адрес) для стека выражения.
$XVAR::	MOV	@SP,R0		; R0 = адрес дескриптора
	MOVB	(0)+,R1		; R1 = байт длины
	MOVB	(0)+,@SP	; младший байт адреса -> заменить дескриптор на адрес...
	MOVB	(0)+,1(SP)	; ...старший байт адреса (вместе - слово адреса)
	CLR	-(SP)
	BISB	R1,@SP		; собрать слово длины из байта
	BR	NEWTMP		; => зарегистрировать как временную, продолжить
;
; $PAR - чтение строкового параметра DEF FN как значения (в отличие от
; APAR/JMIN.MAC, которое даёт только адрес). PFACT - адрес аргументов
; текущего вызова (см. FNCALL), смещение параметра - в коде.
$PAR::	MOV	PFACT,R0	; R0 = адрес аргументов текущего вызова
	SUB	(4)+,R0		; R0 -= смещение - адрес значения параметра
	MOV	-(0),-(SP)	; переложить длину строки
	MOV	-(0),-(SP)	; переложить адрес строки
	BR	NEWTMP		; => зарегистрировать как временную, продолжить
;
; CHR$(n) - строка из одного символа с кодом n (0..255).
CHR::	MOV	(SP)+,R5	; R5 = код символа
	BIT	#177400,R5	; вне диапазона 0..255?
	BNE	A5		; да - ошибка =>
	CLR	-(SP)		; адрес строки (пока 0)
	MOV	#1,-(SP)	; длина = 1 символ
	CALL	TSTFRE		; выделить память под строку из 1 байта
	MOVB	R5,@2(SP)	; записать символ
	BR	NEWTMP		; => зарегистрировать как временную, продолжить
;
; MID$(строка,позиция[,длина]) как выражение (в отличие от LMID/MIDMOV -
; присваивания, см. TRAP.MAC SIMFUN/MIDEND). На стеке: длина,адрес строки,
; позиция, и (для STR) явная длина результата сверху.
; STR2 - без явной длины: взять "до конца строки" - использовать длину
; самой строки (2(SP), уже на стеке) как верхнюю границу для STR1.
STR2::	MOV	2(SP),R0	; R0 = длина исходной строки (как предел длины результата)
	BR	STR1
;
; STR - с явной длиной результата (снята со стека, R0).
STR::	MOV	(SP)+,R0	; R0 = запрошенная длина результата
	BLT	A5		; отрицательная - ошибка =>
; STR1 - общий хвост: вычислить итоговые (длина,адрес) подстроки.
STR1:	MOV	(SP)+,R1	; R1 = позиция (1-based)
	BLE	A5		; позиция <= 0 - ошибка =>
	DEC	R1		; перевести в 0-based смещение
	ADD	R1,2(SP)	; сдвинуть адрес строки на это смещение
	MOV	@SP,R2		; R2 = слово длины строки (сохранить целиком)
	SWAB	R2
	BIC	#177400,@SP	; оставить только настоящую длину (младший байт)
	SUB	R1,@SP		; длина -= смещение = сколько символов осталось от позиции
	BLE	A5		; позиция за концом строки - ошибка =>
	CMP	R0,@SP		; запрошенная длина не превышает остаток?
	BGE	1$		; не превышает =>
	MOV	R0,@SP		; превышает - обрезать до запрошенной длины
1$:	BISB	R2,1(SP)	; восстановить сохранённый старший байт длины
	BR	NEWTMP		; => зарегистрировать как временную, продолжить
;
; CONCAT - конкатенация строк (оператор +). На стеке: длина1,адрес1
; (первая строка, снизу), длина2,адрес2 (вторая, сверху). Не копирует
; первую строку заново: предполагает, что она лежит на самой границе
; свободной строковой области (FREBEG) - только дописывает вторую строку
; сразу за ней и сдвигает FREBEG. Верно, когда первая строка - только что
; вычисленный временный результат (частый случай при построении выражений).
CONCAT::CLR	R0
	BISB	(SP)+,R0	; R0 = длина второй строки
	MOV	(SP)+,R1	; R1 = адрес второй строки
	CLR	R2
	MOV	@SP,R3		; R3 = слово длины первой строки (сохранить целиком)
	BISB	R3,R2		; R2 = длина первой строки (младший байт)
	MOV	R2,@SP		; перезаписать (гарантированно очищен старший байт)
	ADD	R0,@SP		; итоговая длина = длина1 + длина2
	BIT	#177400,@SP	; итоговая длина > 255?
	BNE	2$		; да - ошибка =>
	ADD	2(SP),R2	; R2 = адрес1 + длина1 = место сразу за первой строкой
	TST	R0
	BEQ	3$		; вторая строка пуста - копировать нечего =>
1$:	MOVB	(R1)+,(R2)+	; дописать байты второй строки следом за первой
	SOB	R0,1$
3$:	SUB	FREBEG,R2	; R2 = насколько записанное продвинулось за FREBEG
	ADD	R2,FREBEG	; сдвинуть границу свободной области
	SUB	R2,FRELEN
	SWAB	R3		; восстановить старший байт исходной длины первой строки...
	BISB	R3,1(SP)	; ...в старший байт итоговой длины (сохранить флаг/признак)
	BR	NEWTMP+6	; => продолжить (без повторной регистрации в списке временных)
2$:	TRAP	15.		; ошибка - результат длиннее 255 символов
;
; STRING$(n,код) - строка из n повторов символа с данным кодом.
ALLSK::	MOV	(SP)+,R5	; R5 = код символа
	BIT	#177400,R5	; вне диапазона 0..255?
	BEQ	STRING		; нет - общий хвост =>
A5:	TRAP	5		; да - ошибка
;
; STRING$(n,строка$) - строка из n повторов первого символа данной строки.
ALLSM::	CALL	CLRTMP
	TST	(SP)+		; снять длину строки-образца, пустая?
	BEQ	A5		; да - ошибка (нет первого символа) =>
	MOVB	@(SP)+,R5	; R5 = первый символ строки-образца (снять адрес, прочитать по нему)
; STRING - общий хвост: построить строку из n (на стеке) повторов R5.
STRING:
	BIT	#177400,@SP	; n вне диапазона 0..255?
	BNE	A5		; да - ошибка =>
	MOV	@SP,-(SP)	; продублировать n на стеке
	BEQ	2$		; n=0 - результат пустая строка, заполнять нечего =>
	CALL	TSTFRE		; выделить память под n байт
	MOV	2(SP),R2	; R2 = адрес выделенной строки
	MOV	@SP,R1		; R1 = n (счётчик)
1$:	MOVB	R5,(R2)+	; заполнить символом R5
	SOB	R1,1$
2$:	BR	NEWTMP		; => зарегистрировать как временную, продолжить

;
; NEWSTR - сделать настоящую независимую копию строки (в отличие от
; CONCAT, не полагается на то, что источник лежит на границе свободной
; области). Используется при присваивании (LET A$=B$), когда результат не
; должен ссылаться на память исходной строки.
NEWSTR::CALL	CLRTMP
NEW2:	MOV	2(SP),R5	; R5 = адрес исходной строки
	CALL	TSTFRE		; выделить новую память под копию (длина - на стеке)
	MOV	@SP,R1		; R1 = длина (счётчик копирования)
	BEQ	2$		; пустая строка - копировать нечего =>
	MOV	2(SP),R2	; R2 = адрес новой (выделенной) копии
1$:	MOVB	(R5)+,(R2)+	; скопировать байт
	SOB	R1,1$
2$:	BR	NEWTMP		; => зарегистрировать как временную, продолжить
;
; ASC(строка$) - код первого символа строки.
ASC::	CALL	CLRTMP
	TST	(SP)+		; снять длину строки, пустая?
	BEQ	A5		; да - ошибка =>
	CLR	R0
	BISB	@(SP)+,R0	; снять адрес, R0 = байт по этому адресу (первый символ)
	MOV	R0,-(SP)	; результат на стек
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
;
; INSTR([старт,]строка,искомая) - позиция первого вхождения искомой строки
; в строку, начиная с позиции старт (по умолчанию 1); 0, если не найдена.
; Наивный посимвольный поиск: сканирует строку в поисках первого символа
; искомой, затем при совпадении сверяет остаток целиком.
INSTR::	CALL	CLRTMP
	MOV	(SP)+,R0	; R0 = длина искомой строки
	MOV	(SP)+,R1	; R1 = адрес искомой строки
	CALL	CLRTMP
	MOV	(SP)+,R2	; R2 = длина строки, в которой ищем
	BEQ	I3		; строка пуста - не найдено =>
	MOV	(SP)+,R3	; R3 = адрес строки, в которой ищем
	MOV	(SP)+,R5	; R5 = позиция старта (1-based)
	BLE	A5		; <= 0 - ошибка =>
	CMP	R5,#255.	; > 255 - ошибка =>
	BHI	A5
	DEC	R5		; перевести в 0-based смещение
; I0 - общая точка входа (сюда же попадает INSTR2 с R5=0, без позиции старта).
I0:	MOV	R2,-(SP)	; запомнить полную длину строки поиска
	SUB	R5,R2		; R2 = сколько символов осталось от позиции старта
	BLE	A5		; старт за концом строки - ошибка =>
	ADD	R3,R5		; R5 = адрес, с которого начинать сканирование
	MOV	R0,-(SP)	; запомнить длину искомой строки
	BEQ	I6		; искомая строка пуста - результат = сама позиция старта =>
; Сканировать в поисках символа, совпадающего с первым символом искомой строки.
I1:	MOV	R1,-(SP)	; запомнить адрес искомой строки (для сверки с начала)
1$:	CMPB	(R5)+,(R1)	; символ строки поиска = первый символ искомой?
	BEQ	I5		; да - попробовать сверить целиком =>
	SOB	R2,1$		; нет - следующий символ
; Не найдено (дошли до конца строки поиска).
I2:	TST	(SP)+		; снять сохранённый адрес искомой строки
I3:	TST	(SP)+		; снять сохранённую длину искомой строки
I4:	CLR	@SP		; результат 0 (не найдена)
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
; Первый символ совпал - сверить искомую строку целиком с этой позиции.
I5:	CMP	R2,R0		; оставшихся символов хватает на всю искомую строку?
	BLT	I2		; нет - не найдено =>
	MOV	R5,-(SP)	; запомнить текущую позицию сканирования
	DEC	R5		; вернуться к только что совпавшему символу
8$:	CMPB	(R5)+,(R1)+	; посимвольная сверка искомой строки
	BNE	I7		; не совпало - продолжить сканирование дальше =>
	SOB	R0,8$
	CMP	(SP)+,(SP)+	; совпало целиком - снять сохранённые позицию и адрес
I6:	TST	(SP)+		; снять сохранённую длину искомой строки
	DEC	R2
	SUB	R2,@SP		; результат = позиция найденного совпадения (1-based)
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)

; Символ не совпал при полной сверке - вернуться к сканированию со следующей позиции.
I7:	MOV	(SP)+,R5	; восстановить позицию сканирования
	MOV	(SP)+,R1	; восстановить адрес искомой строки (сначала)
	MOV	(SP),R0		; восстановить длину искомой строки (не снимая)
	DEC	R2
	BR	I1
;
; INSTR(строка,искомая) - без позиции старта: то же самое, что INSTR, со
; смещением 0 (искать с самого начала строки) - общий код через I0.
INSTR2::CALL	CLRTMP
	MOV	(SP)+,R0	; R0 = длина искомой строки
	MOV	(SP)+,R1	; R1 = адрес искомой строки
	CALL	CLRTMP
	MOV	(SP)+,R2	; R2 = длина строки, в которой ищем
	BEQ	I4		; строка пуста - не найдено =>
	MOV	(SP)+,R3	; R3 = адрес строки, в которой ищем
	CLR	R5		; смещение старта = 0
	BR	I0		; => общий код поиска (см. INSTR)
;
; LEN(строка$) - длина строки. На стеке [длина,адрес] - снять длину и
; записать её на место адреса, оставив на стеке только результат.
LEN::	MOV	(SP)+,@SP	; переложить длину на место адреса (адрес больше не нужен)
	CALL	CLRTMP		; строка обработана - снять учёт временной
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
;
; VAL(строка$) - разобрать текст строки как число (см. PACK, FLOATS.MAC).
VAL::	CALL	CLRTMP		; строка обработана - снять учёт временной
	MOV	R4,SAVJMP	; запомнить позицию (для PACK - как признак контекста)
	CALL	PACK		; разобрать строку (адрес,длина на стеке) в число
	MOV	SAVJMP,R4
	CLR	SAVJMP
;
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
;
; SSTR/ISTR - STR$(число) для вещественного/целого: отформатировать число
; в текст (EGO/ISGUNP - как в PRINT, см. SOUTSP/IOUTSP в JMIN.MAC) во
; временный буфер, затем скопировать в новую строку через NEWSTR (буфер
; форматирования общий, не своя память - настоящая строка нужна для
; хранения как значения переменной/результата).
SSTR::	CALL	EGO		; отформатировать вещественное число в текст
	BR	STRE
;
ISTR::	MOV	(SP)+,R5	; R5 = целое число
	.BJSR	ISGUNP		; отформатировать в текст
	MOV	R1,-(SP)	; переложить длину текста
	MOV	R2,-(SP)	; переложить адрес текста (буфер форматирования)
STRE:	DEC	@SP		; поправка длины (см. формат EGO/ISGUNP)
	MOVB	TMPSP+1,1(SP)	; (см. NEWTMP) подготовить перед NEWSTR
	BR	NEWSTR		; => скопировать текст в настоящую (новую) строку
;
;
; FRE(x) - свободная общая память (числовой аргумент x игнорируется, просто
; снимается со стека - SFRE для вещественного, 2 слова; IFRE для целого,
; 1 слово). Результат = CIKL (вершина стека кадров FOR/GOSUB) - ENDCOD
; (конец занятой памяти программы/массивов) - память между ними свободна.
SFRE::	TST	(SP)+		; снять старшее слово (вещественный аргумент)
IFRE::	TST	(SP)+		; снять аргумент (целый, или младшее слово вещественного)
FRE::	MOV	CIKL,-(SP)
	SUB	ENDCOD,@SP
ENDFRE::JMP	@(R4)+		; продолжить (диспетчер шитого кода)
;
; $FRE(x$) - свободная память строковой области (строковый аргумент
; игнорируется). Сначала сборка мусора - чтобы результат был точным.
$FRE::	TST	(SP)+		; снять аргумент
	CALL	CLRTMP
	CALL	STRSQU		; сборка мусора строковой области
	MOV	FRELEN,@SP	; результат = сколько свободно после сборки
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
;
; VIETOS - выделить R5 байт временного буфера из строковой области (как
; TSTFRE, но размер в R5, а не на стеке, и без ошибки при нехватке памяти:
; если после сборки мусора всё ещё не хватает - просто выделяет сколько
; есть). R1 на выходе - КОНЕЦ буфера (для OCT$/BIN$/HEX$, пишущих цифры
; с конца буфера назад).
VIETOS:	SUB	R5,FRELEN	; хватает места без сборки мусора?
	BGE	1$		; да =>
	CALL	STRSQU		; нет - сборка мусора строковой области
	SUB	R5,FRELEN	; хватает теперь?
	BGE	1$		; да =>
	ADD	FRELEN,R5	; нет - урезать запрос до того, что реально есть
	CLR	FRELEN
1$:	ADD	R5,FREBEG	; сдвинуть границу свободной области
	MOV	FREBEG,R1	; R1 = новая граница = конец выделенного буфера
	RETURN
;
;-----------------------
;СБОРКА МУСОРА СИМВ. ОБЛ.
;-----------------------
STRSQU::MOV	R4,SAVJMP	;R3 - НОВЫЙ FREBEG
	MOV	R5,-(SP)	;R0 - НАЧАЛО ПЕРЕМЕЩАЕМОГО МАС.
	MOV	STRREG,R3	;R2 - УКАЗ. В ТАБЛ. ИМЕН
	MOV	R3,-(SP)	;@SP - КОНЕЦ STRREG
	ADD	STRSIZ,@SP
40$:	MOV	@SP,R0
	TST	-(SP)
	MOV	LENT,R2
8$:
	JSR	R4,FIND
	BR	58$
	BR	1$
	TST	(R2)+
	BEQ	7$
	CMP	@R2,R0
	BHIS	7$
	CMP	@R2,R3
	BLO	7$
	MOV	@R2,R0
	MOV	R2,@SP
7$:	TST	(R2)+
	BR	8$
;
1$:	CALL	SSQ1
38$:	CALL	SSQ2
	CMP	R4,R0
	BHIS	39$
	CMP	R4,R3
	BLO	39$
	MOV	R4,R0
	MOV	R5,@SP
39$:	CMP	R5,R1
	BLO	38$
	CMP	(R2)+,(R2)+
	BR	8$
;
58$:	MOV	(SP)+,R2
	CMP	R0,@SP
	BEQ	22$
	CMP	R2,LENT
	BLOS	11$
;
	MOV	R3,@R2
55$:	CLR	R1
	DEC	R2
	BISB	-(2),R1
	BR	3$

;
11$:	CMP	R2,@SP
	BLO	55$
	SWAB	R3
	MOVB	R3,-(R2)
	SWAB	R3
	MOVB	R3,-(R2)
	CLR	R1
	BISB	-(R2),R1
3$:	CALL	PERK
	BR	40$
;
22$:	MOV	R3,FREBEG
	SUB	R3,@SP
	MOV	(SP)+,FRELEN
	MOV	(SP)+,R5
	MOV	SAVJMP,R4
	CLR	SAVJMP
	RETURN

PERK:	CMP	R0,R3		;R0 - СТАРЫЙ
	BEQ	3$		;R3 - НОВЫЙ
				;R1 - ДЛИНА
	MOV	#TMPSP,R2
1$:	MOVB	1(2),R2
	BEQ	2$
	BIC	#177400,R2
	ASL	R2
	MOV	2(2),R5
	SUB	R0,R5
	BLO	1$
	CMP	R5,R1
	BGE	1$
	ADD	R3,R5
	MOV	R5,2(2)
	BR	1$

2$:	MOVB	(0)+,(3)+
	SOB	R1,1$
	RETURN

3$:	ADD	R1,R3
	RETURN
;
SSQ1:
	CLR	R5
	BISB	2(R2),R5
	ASL	R5
	ADD	@R2,R5
	MOV	(5)+,R1
	ADD	R5,R1
	RETURN
SSQ2:	CLR	R4
	TSTB	(R5)+
	BEQ	1$
	BISB	(R5)+,R4
	SWAB	R4

	BISB	(R5)+,R4
	SWAB	R4
	RETURN
1$:	CMPB	(R5)+,(R5)+
	RETURN
FIND:	CMP	R2,LENT
	BLO	10$
	CMP	R2,TABTOP
	BHIS	8$
				;ВХОД:	R2-> ИМЯ
	BIT	#20000,@R2	;ВЫХОД:	+0	КОНЕЦ ПЕРЕМЕННЫЦХ
	BEQ	1$		;	+2	СИМВ.МАС. R2->ИМЯ+2
	TSTB	@R2		;	+4	СИМВ.ПЕР. --//---
	BPL	2$		;		ВРЕМ.ПЕР. R2->ДЛИНА
	TST	2(2)
	BNE	3$
1$:	CALL	PRAL
	BR	FIND
2$:	TST	(4)+
3$:	TST	(2)+
4$:	TST	(4)+
7$:	RTS	R4
8$:	MOV	#TMPSP,R2
9$:	TST	(2)+
10$:	MOVB	-1(2),R2
	BEQ	7$
	BIC	#177400,R2
	ASL	R2
	TSTB	@R2
	BEQ	9$
	TST	(4)+
	BR	4$
;
PRAL:	TST	(R2)+
	BMI	8$
	TST	(R2)+
8$:	TST	(R2)+
	RETURN
;
CLRSTR::MOV	@SP,R0
	BLT	C5
	INC	R0
	BIC	#1,R0
	MOV	R0,@SP
	SUB	STRSIZ,R0	;
	MOV	R0,R1		;АНАЛИЗ I-ГО АРГУМЕНТА
	ADD	ENDCOD,R0	;
	CMP	R0,LENT
	BLOS	CLR1
CLRERR:	TRAP	7
CLR::	CLR	R1
	MOV	STRSIZ,-(SP)
;.............УСТАНОВКА ОБЛАСТИ ДЛЯ СТРОК..........
CLR1:	MOV	STRREG,R0

	MFPS	R3
	MTPS	#340

	.BJSR	NOSTOP
	MOV	R0,FREBEG
	MOV	@SP,FRELEN
	MOV	(SP)+,STRSIZ
	MOV	LENT,LIMIT
	MOV	LENT,CIKL
	ADD	R1,ENDCOD
;.........................СДВИГ МАССИВОВ...........
	MOV	R3,-(SP)

	ADD	STRSIZ,R0
	MOV	ENDCOD,R3
	MOV	R1,R5
	BEQ	1$
	NEG	R1
	BMI	20$
	ADD	R0,R1
10$:	MOV	(R1)+,(R0)+
	CMP	R0,R3
	BLO	10$
	BR	1$
20$:	ADD	R3,R1
22$:	MOV	-(R1),-(R3)
	CMP	R3,R0
	BHI	22$
;...................ОЧИСТКА ПЕРЕМЕННЫХ.............
1$:	MOV	LENT,R2
7$:	CMP	R2,TABTOP
	BHIS	8$
	TSTB	@R2
	BPL	6$
	TST	(R2)+
	TST	(R2)+
	BEQ	77$
	ADD	R5,-(R2)
	MOV	(R2)+,R0
	CLR	R3
	BISB	@R2,R3
	ASL	R3
	ADD	R3,R0
	MOV	(0)+,R1
	ASR	R1
2$:	CLR	(R0)+
	SOB	R1,2$
77$:	TST	(R2)+
	BR	7$
6$:	MOV	(R2)+,R0
	BMI	4$
5$:	CLR	(R2)+
4$:	CLR	(R2)+
3$:	BR	7$
8$:
	.BJSR	STOPEN
	MTPS	(SP)+

	CMP	R4,STRREG
	BLO	9$

	BR	S1T
9$:	JMP	@(R4)+
C5:	TRAP	5
;
;---------------------------------------------
CLRMEM::
	CMP	@SP,@#WHIMEM
	BHI	C5
	CMP	@SP,#TEXT
	BLOS	C5

	MFPS	R3
	MTPS	#340
	.BJSR	NOSTOP
	CALL	CLOALL
	MOV	(SP)+,R2
	ASR	R2
	ASL	R2
	SUB	HIMEM,R2
	CALL	TABMOV
	ADD	R2,HIMEM
	.BJSR	CLRBUF
	.BJSR	CLRCOD
	MOV	(SP)+,R0
	INC	R0
	BIC	#1,R0
	MOV	R0,STRSIZ
	.BJSR	STOPEN
	MTPS	R3
S1T:
	JMP	STAR
;
TABMOV::MOV	TABTOP,R0
	ADD	R2,R0
	CMP	R0,TXEND
	BLO	CLRERR
	MOV	FCB,R1
	SUB	TABTOP,R1
	BEQ	4$
	ASR	R1
	TST	R2
	BMI	2$
	MOV	FCB,R3
	MOV	R3,R0
	ADD	R2,R0
3$:	MOV	-(R3),-(R0)
	SOB	R1,3$
	BR	4$
2$:	MOV	TABTOP,R3
5$:	MOV	(R3)+,(R0)+
	SOB	R1,5$
4$:	ADD	R2,TABTOP
	RETURN
;
POKJMP::MOV	(SP)+,@(SP)+
	JMP	@(R4)+
;

OUTJMP::TST	(SP)+
	BEQ	1$
	BIS	(SP)+,@(SP)+
	JMP	@(R4)+
1$:	BIC	(SP)+,@(SP)+
	JMP	@(R4)+
;
PEEK::	MOV	@(SP),(SP)
	JMP	@(R4)+
;
INP::	MOV	@2(SP),2(SP)
INPEND:	COM	(SP)
	BIC	(SP)+,(SP)
	JMP	@(R4)+
;
IFCERR:	TRAP	5
;
$DEFUS::
	MOV	(SP)+,@(R4)+
	JMP	@(R4)+
$USR::	MOV	SP,R5
	MOV	(R4)+,R0
	MOV	(R4)+,R3
	BPL	10$
	MOVB	1(SP),TMPSP
	CLRB	1(SP)
10$:	MOV	R4,SAVJMP
	CALL	@USRTAB(R0)
	MOV	SAVJMP,R4
	CLR	SAVJMP
	MOVB	TMPSP,1(SP)
	JMP	@(R4)+

NOUSR::	TRAP	5

ONTRG$::MOV	(SP)+,R0
	CMP	(R4)+,(R4)+
	TST	(R4)+
	BNE	1$
	CALL	TSVCT

	MFPS	-(SP)
	MTPS	#340
	.BJSR	NOSTOP
	MOV	@R0,-2(R4)
	MOV	@#VCTNMB,-4(R4)
	MOV	R0,@#VCTNMB
	.BJSR	STOPEN
	MTPS	(SP)+
1$:
	MOV	#4537,@R4
	MOV	R4,(R0)+
	MOV	#340,@R0
	MOV	-6(R4),R4
	JMP	@(R4)+

TRPOF$::MOV	(SP)+,R0
	CALL	TSVCT
	CALL	RSTVCT
	BCS	NOUSR
	JMP	@(R4)+

RSTVCT::MOV	R1,-(SP)
	MOV	R2,-(SP)

	CALL	TSTVCT
	BCS	3$
	MOV	#VCTNMB,R2

1$:	CMP	@R2,#1		;TST	@R2
	BLO	3$		;BEQ
	CMP	@R2,R0
	BEQ	2$
	MOV	@(R2)+,R2
	CMP	-(R2),-(R2)
	BR	1$
2$:
	MFPS	-(SP)
	MTPS	#340
	.BJSR	NOSTOP
	MOV	@R0,R1
	MOV	-(R1),@R0
	CLR	@R1
	MOV	-(R1),@R2
	.BJSR	STOPEN
	MTPS	(SP)+
	CLC
3$:
	MOV	(SP)+,R2
	MOV	(SP)+,R1
	RETURN

TSVCT:	TST	R0
	BEQ	NOUSR
	CMP	R0,#500
	BHIS	NOUSR
	BIC	#3,R0
	CMP	R0,#30
	BEQ	NOUSR
	CMP	R0,#34
	BEQ	NOUSR
;.IF EQ,MASINA-BK0011
;	CMP	R0,#20
;	BEQ	NOUSR
;.ENDC
	RETURN

TSTVCT::CMP	@R0,@#TXEND
	BLO	1$
	CMP	@#STRREG,@R0
	BHI	1$
	SEC

1$:	RETURN

SREG::	CMP	SP,#520
	BHIS	1$
	TRAP	7
1$:	MOV	R4,-(SP)
	MOV	R3,-(SP)
	MOV	R2,-(SP)
	MOV	R1,-(SP)
	MOV	R0,-(SP)
	MOV	@#SAVJMP,-(SP)
	MOV	R5,PC

RREG::	CMP	SP,#STACK-20
	BHI	1$
	TST	(SP)+
	MOV	(SP)+,@#SAVJMP
	MOV	(SP)+,R0
	MOV	(SP)+,R1
	MOV	(SP)+,R2
	MOV	(SP)+,R3
	MOV	(SP)+,R4
	RTS	R5
1$:	;CLR	ONERFL
	TRAP	51.

;--------------------------------------------
; OPINP/OPOUT - оператор OPEN "файл" FOR INPUT/OUTPUT (см. COMP.MAC OPEN::/
; OP: OPINP,OPOUT). R1 - режим: 0 для INPUT, признак записи (WR.) для OUTPUT.
; Закомментированный код ниже - остатки поддержки нескольких номеров файлов
; (MAXFIL/AS#), в этой версии не используется - всегда один неявный файл
; (см. FNDBUF).
OPINP::
	CLR	R1		; режим - чтение
	BR	OPFILE
;
OPOUT::
	MOV	#WR.*400,R1	; режим - запись
OPFILE:;MOV	MAXFIL,R3	;JEI NERA AS#
;	MOV	(SP)+,R3	;JEI YRA AS#
;	BLE	BADFN
;	CMP	R3,MAXFIL
;	BHI	BADFN
	CALL	FNDBUF		; получить блок управления файлом (FCB)
	TST	(0)+
	BNE	2$		; файл уже открыт - ошибка =>
	CLR	@#ASCFLG
	JSR	R1,FILNAM	; разобрать имя файла из текста программы
	MOV	#".D,(0)+	; дописать расширение по умолчанию ".DAT"
	MOV	#"AT,(0)+
	CALL	BLOCK0		; прочитать блок каталога
	SUB	#22,R0
	MOV	(SP)+,@R0	; записать режим (INPUT/OUTPUT) в FCB
	BNE	10$		; режим OUTPUT =>
	MOV	@#WRITE,-(SP)	; режим INPUT - подготовить чтение файла
	CALL	CASCII
	MOV	(SP)+,@#WRITE
	MOV	#RD.*400,@#MAG
	CALL	CAS
	MOV	@#MAG,@R0
	CALL	ISVARD
10$:
	CMP	@#WRITE,DRIVER
	BEQ	1$
	BIS	#100000,@R0
1$:	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
2$:	TRAP	54.		; ошибка - файл уже открыт
BADFN:	TRAP	52.		; ошибка - недопустимое имя файла (сейчас недостижимо)
;
; FNDBUF - получить FCB. В этой (однофайловой) версии просто фиксированное
; смещение от FCB; закомментированный код - остатки поддержки нескольких
; открытых файлов (по номеру AS#, см. выше).
FNDBUF::MOV	FCB,R0
;	SUB	#22,R0
1$:	ADD	#400,R0		;VELIAU #422
;	SOB	R3,1$
	RETURN
;
; DEVICE - оператор "#файл," перед списком PRINT/INPUT (см. TSTFLN в
; COMP.MAC): выбрать файловое устройство. В этой (однофайловой) версии
; всегда файл №1 - закомментированный код ("VERSIJA 1"/"версия 1") остатки
; поддержки нескольких номеров файлов.
DEVICE::MOV	#1,IODEV	;MAXFIL,IODEV		;VERSIJA 1
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
;	MOV	(SP)+,IODEV
;	BLE	NOTOP
;	CMP	IODEV,MAXFIL
;	BGT	INIPRP		;VELIAU - BLOS
NOTOP:	TRAP	59.		; ошибка - недопустимый номер файла (сейчас недостижимо)
;
; DEVLP - оператор LPRINT: вывод на принтер (IODEV = -1 - см. COMP.MAC LPRINT::).
DEVLP::	MOV	#-1,IODEV	; устройство - принтер
INIPRP::JMP	@(4)+		; продолжить (диспетчер шитого кода)
;
; CLRDEV - вернуть устройство вывода к экрану по умолчанию (см. TSTFIL в
; COMP.MAC - вызывается после PRINT/INPUT #файл,...).
CLRDEV::CLR	IODEV		; устройство - экран
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
;
;
; LPOS(n) - текущая позиция на строке принтера (аргумент n не используется,
; как у POS - см. SLOCX/JMIN.MAC).
SLPOS::	TST	(SP)+		; снять (неиспользуемый) аргумент
ILPOS::	TST	(SP)+		; снять (неиспользуемый) аргумент
LPOS::
	MOV	LPTPOS,-(SP)	; вернуть текущую позицию на строке принтера
	JMP	@(4)+		; продолжить (диспетчер шитого кода)
;
; CLOFIL - оператор CLOSE (см. COMP.MAC CLOSE::). Закомментированный код -
; остатки поддержки закрытия по номеру файла; в этой (однофайловой) версии
; CLOSE всегда закрывает единственный открытый файл (как CLOALL).
CLOFIL::
;	MOV	(R4)+,R2
;	BEQ	3$
;1$:	MOV	(SP)+,R3
;	BEQ	2$
;	CMP	R3,MAXFIL
;	BHI	BADFN
;	CALL	FNDBUF
;	CALL	CLOF
;2$:	SOB	R2,1$
;	JMP	@(R4)+
3$:	CALL	CLOALL		; закрыть (единственный) открытый файл
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
;
; CLOALL - закрыть открытые файлы (вызывается также из RUN - см. JMIN.MAC).
; Закомментированный код - остатки цикла по нескольким файлам; сейчас
; вычисляет адрес единственного FCB (от HIMEM) и проваливается в CLOF.
CLOALL::;MOV	MAXFIL,R2
;	BEQ	5$
	MOV	HIMEM,R0	; R0 = верхняя граница памяти
4$:	SUB	#422,R0		; R0 = адрес FCB (размер записи FCB - 422 окт.)
;	CALL	CLOF
;	SOB	R2,4$
;5$:	RETURN
;
; CLOF - закрыть один файл (R0 - адрес FCB). Если открыт на запись -
; дозаписать/финализировать (CLOUTF); если на чтение - просто снять
; признак открытости.
CLOF:	MOV	(R0),R3		; R3 = слово состояния FCB (признак открытости/режим)

	BEQ	6$		; не был открыт - нечего закрывать =>
	BIT	#WR.*400,R3	; открыт на запись?
	BEQ	3$		; нет (на чтение) =>
	BIC	#177400,R3
	ADD	R0,R3
	ADD	#22,R3
	CALL	CLOUTF		; финализировать файл, открытый на запись
	BR	6$

3$:	CALL	CASCII		;CLINF
	CALL	LASTBL
	CLR	@R0		; снять признак открытости FCB
	CALL	CAS
6$:
CLR	@#ASCFLG
	RETURN			; готово
;
; CLOUTF - финализировать файл, открытый на запись (см. CLOF): дописать
; символ ^Z (код 32 окт., признак конца текстового файла в RT-11) и
; заполнить им же остаток текущего блока (пока байт-счётчик позиции в
; блоке не переполнится до 0), затем сбросить буфер на диск и снять
; признак открытости FCB.
CLOUTF::MOVB	#32,(R3)+	;^Z	; записать ^Z, продвинуть позицию в буфере
	INCB	@R0		; счётчик позиции в блоке
	BNE	CLOUTF		; блок не заполнен - дописать ещё ^Z =>
	CALL	CASCII		; сбросить буфер на диск
	CLR	@R0		; снять признак открытости FCB
	CALL	CAS
	CALL	LASTBL		; обновить последний блок файла в каталоге
	CLR	@MAG+ADRW
	CALL	CAS
	RETURN
;
; FNDCHR/FNDCR - найти адрес текущего непрочитанного символа в буфере
; чтения открытого файла (проверяет, что файл открыт и открыт на чтение).
; FNDCHR дополнительно проверяет, что вообще выбрано файловое устройство
; (IODEV) - для #функций, не привязанных к текущему PRINT/INPUT #файлу.
FNDCHR:	MOV	IODEV,R3
	BLE	NOTOP		; устройство не выбрано - ошибка =>
FNDCR:	CALL	FNDBUF		; R0 = FCB
	TST	@R0
	BEQ	NOTOP		; файл не открыт - ошибка =>
	BIT	#RD.*400,@R0	; открыт на чтение?
	BEQ	BADFN		; нет - ошибка =>
	CLR	R3
	BISB	@R0,R3		; R3 = позиция в текущем блоке буфера (байт)
	ADD	R0,R3
	ADD	#22,R3		; R3 = адрес текущего символа в буфере чтения
	RETURN
;
; EOF(файл) - достигнут ли конец файла (текущий символ - ^Z).
EOF::	CLR	-(SP)		; по умолчанию - не конец файла
	CALL	FNDCR		; R3 = адрес текущего символа
	CMPB	@R3,#32	;^Z	; это символ конца файла?
	BNE	1$
	COM	@SP		; да - результат = true (-1)
1$:	JMP	@(4)+		; продолжить (диспетчер шитого кода)
;
; FILINP - прочитать одну строку текста из открытого файла (см. GET:: в
; JMIN.MAC - используется для READ/INPUT из файла) в общий буфер BUF.
; Копирует байты из буфера файла, переходя на следующий блок диска, если
; текущий кончился (счётчик позиции в блоке переполняется - см. CLOF/
; CLOUTF); заканчивает на ^Z (конец файла) или LF (конец строки), отбрасывая
; одиночные CR (нормализует CRLF в LF).
FILINP::CALL	FNDCHR		; проверить файл, R3 = адрес текущего символа
	MOV	R0,R5
	ADD	#22,R5
COPYIN::MOV	#BUF,R1		; R1 = начало строки в BUF
1$:	CMPB	@R3,#32		; конец файла (^Z)?
	BEQ	3$		; да - завершить строку =>
	CMP	R1,#BUF+417	; буфер строки переполнен?
	BHIS	4$		; да - ошибка =>
	MOVB	(3)+,(1)	; скопировать символ из файла (в ту же позицию R1)
	INCB	(0)		; продвинуть позицию в текущем блоке файла
	BNE	2$		; блок не кончился =>
; Блок кончился - прочитать следующий блок диска в буфер файла.
	MOV	R1,-(SP)
	MOV	R0,-(SP)
	SUB	#400,R3		; вернуть R3 к началу буфера (туда читается новый блок)
	CALL	BLOCKN		; прочитать следующий блок
	CALL	CASCII
	MOV	#16*400,@#MAG
	CALL	CAS
	CALL	ISVARD
	MOV	(SP)+,R0
	MOV	(SP)+,R1
; Только что скопированный символ - CR? Пропустить его (не хранить в BUF,
; следующий символ перезапишет эту позицию). Иначе - продвинуться и
; проверить, не был ли это LF (конец строки).
2$:	CMPB	@R1,#CR		; символ - CR?
	BEQ	1$		; да - пропустить (не продвигая R1) =>
	CMPB	(1)+,#LF	; нет - продвинуться и проверить: это LF?
	BNE	1$		; не LF - следующий символ =>
3$:	MOVB	#LF,@R1		; конец строки - убедиться, что там LF
5$:	RETURN
4$:	TRAP	25.		; ошибка - строка файла слишком длинная
;
;..........................................
; $FIND - оператор FILES: вывести каталог диска (без аргумента - весь
; каталог, с именем файла/маской - искать конкретный файл/тип). Закрывает
; открытые файлы, готовит блок параметров MAG для операции FR. (поиск/
; чтение каталога RT-11), затем при наличии аргумента разбирает имя файла
; и его расширение (сравнение с таблицей известных типов FILTYP - для
; выбора, как выводить содержимое, если это не текстовый BASIC-файл).
$FIND::
	CALL CLOALL		; закрыть открытые файлы

	MOV	DRIVER,@#WRITE	; текущий дисковод
	MOV	#MAG,R0		; R0 = блок параметров операции с диском
	MOV	#FR.*400,(0)+	; код операции - поиск/чтение каталога
	MOV	#11,(0)+
	CLR	@R0
	MOV	R4,SAVJMP	; запомнить позицию (контекст для возможной ошибки)
	TST	@SP		; аргумент (имя файла) указан?
	BEQ	FL6		; нет - весь каталог =>
	CALL	$ASC		; разобрать имя файла из аргумента
	MOV	R4,SAVJMP
	MOV	-(0),-(SP)	;TURI BUTI >0
	MOV	#MAG+NAMEW+7,R3	; R3 = расширение имени файла
	TRAP	113		; сравнить с таблицей известных расширений (FILTYP)
	.WORD	FILTYP
	.BYTE	3,2
	BR	L1		; расширение не распознано =>
	DEC	R3
	MOV	R3,R0
	CALL	@BINCOD(R5)	; распознано - обработчик по типу файла
	BR	L2
;
; FL6 - FILES без аргумента: пометить "нет конкретного файла" (записать
; сюда сам SP как признак-заглушка, отличимый от настоящего адреса имени)
; и перейти к общему выводу каталога (L6).
FL6:	MOV	SP,2(SP)
	BR	L6
;
; $MERGE - оператор MERGE (загрузить файл, добавив к уже имеющейся
; программе, не стирая её). Кладёт R4 (ненулевой) как признак "это MERGE"
; для общего кода загрузки L0 (в отличие от $LOAD, кладущего 0).
$MERGE::MOV	R4,-(SP)	; признак: MERGE (не LOAD)
	BR	L0
;
; $LOAD - оператор LOAD (загрузить файл, заменив текущую программу).
$LOAD::	CLR	-(SP)		; признак: LOAD (не MERGE)
; L0 - общий код LOAD/MERGE: закрыть файлы, прочитать программу с диска.
; L0 - общий код LOAD/MERGE: открыть исходный файл на чтение, поставить
; свой обработчик прерывания (Ctrl-C, через RSTVCT/AVPK - остановить
; загрузку по нажатию), очистить текст программы (для LOAD, R5=0; для
; MERGE, R5<>0 - не очищать, см. $LOAD/$MERGE), затем построчно читать
; текст файла (COPYIN - тот же буфер, что FILINP) и компилировать каждую
; строку в программу (ASCCOD), пока не кончится файл.
L0:
	CALL	CLOALL		; закрыть открытые файлы
	MOV	(SP)+,R5	; R5 = признак LOAD(0)/MERGE(<>0)

	MOV	#MAG,R0		; R0 = блок параметров операции с диском

	MOV	#RD.*400,(0)+	; операция - чтение
	MOV	#12,(0)+
	CALL	$ASC		; разобрать имя файла
	MOV	FCB,(R0)+
	MOV	#200,(0)+
	MOV	R4,SAVJMP	; запомнить позицию (контекст для возможной ошибки)
	MOV	#AVPK,R0
2$:	CALL	RSTVCT		; установить обработчик прерывания по Ctrl-C
	BCC	2$
	MOV	#TSTBRK,@R0

	MOV	LAST,FIRST	; очистить очередь клавиатуры
	CALL	CAS		; открыть файл
	CALL	ISVARD
	TST	R5
	BNE	1$		; MERGE - не очищать текущую программу =>
	.BJSR	CLRTX1		; LOAD - очистить текущую программу
1$:	MOV	#400,-(SP)
	MOV	FCB,-(SP)
; Построчно прочитать файл и скомпилировать каждую строку программы.
4$:	MOV	(SP)+,R3
	MOV	SP,R0
	MOV	#MAG+NAMEW+20,R5
	CALL	COPYIN		; прочитать очередную строку файла в BUF
	CMP	R1,#BUF
	BEQ	L6		; пустая строка (конец файла) - готово =>
	MOV	R3,-(SP)
	JSR	R1,ASCCOD	; разобрать и вставить строку в текст программы
	BR	7$
	BR	4$		; => следующая строка
7$:	MOV	#LF,R0
	MOVB	R0,@#BUF
	CALL	ISV
	MOV	#AVPK,R0
3$:
	CALL	RSTVCT		; восстановить обычный обработчик Ctrl-C
	BCC	3$
	MOV	#IVS,@R0
	TRAP	57.		; ошибка - прервано (Ctrl-C) или ошибка формата строки
;
; L6/L1/L2 - общее завершение FILES/LOAD/MERGE: закрыть файл (LASTBL/CAS),
; восстановить обычный обработчик Ctrl-C (RSTVCT/AVPK - как в L0) и перейти
; к общему хвосту ST0/ST (сброс в обычный режим - подготовка строки вывода
; и переход в главный цикл монитора, см. MONIT.MAC).
L6:	TST	(SP)+		; снять оставшийся служебный флаг
L1:
	MOV	#12,@#MAG+2
	CALL	LASTBL		; завершить файловую операцию
L2:	CALL	CAS
	MOV	#AVPK,R0
1$:
	CALL	RSTVCT		; восстановить обычный обработчик Ctrl-C
	BCC	1$
	MOV	#IVS,@R0
	CALL	TESTR
ST0:	MOV	#5007,@#BUF	; подготовить строку вывода (см. ST, MONIT.MAC)
	BR	ST		; => в главный цикл монитора
;
; $CLOAD - оператор CLOAD (быстрая загрузка ранее сохранённого CSAVE
; двоичного образа скомпилированной программы, в отличие от LOAD - без
; повторной компиляции текста). Читает образ прямо в область TEXT, затем
; переносит его на рабочее место (LENT..TABTOP), по ходу переноса
; перевычисляя (релоцируя) адреса-указатели внутри данных прибавлением
; смещения между адресом сохранения и текущим адресом загрузки.
$CLOAD::
CALL	CLOALL			; закрыть открытые файлы

	MOV	#MAG,R0		; R0 = блок параметров операции с диском

	MOV	#RD.*400,(0)+	; операция - чтение
	MOV	#11,(0)+
	CALL	$COD		; разобрать имя файла (двоичный формат)
	MOV	#TEXT,(0)+	; читать в область TEXT
	MOV	FCB,@R0
	SUB	#TEXT,@R0
	CLC
	ROR	(0)+
	MOV	R4,@#SAVJMP	; запомнить позицию (контекст для возможной ошибки)
	.BJSR	CLRTX1		; очистить текущую программу
	CALL	CAS		; прочитать образ программы в TEXT
	MOV	#MAG+ADRR,R3
	MOV	(R3)+,R2	; R2 = адрес сохранения (в момент CSAVE)
	MOV	@R3,R0
	ASL	R0		; R0 = размер образа в байтах
	MOV	#TEXT,R3
	ADD	R3,R0		; R0 = конец прочитанных данных (TEXT+размер)
	SUB	R2,R3		; R3 = смещение (текущий адрес загрузки - адрес сохранения)
	MOV	FCB,R2		; R2 = целевой адрес переноса данных
	MOV	R2,R4
	SUB	-(R0),R4	; R4 = граница переноса (из завершающего слова образа)
; Перенести данные на рабочее место, релоцируя каждое третье слово
; (адрес-указатель) прибавлением смещения R3.
5$:	MOV	-(R0),-(R2)	; перенести слово как есть
	MOV	-(R0),-(R2)	; перенести слово как есть
	ADD	R3,@R2		; ...и релоцировать его (это был адрес)
	MOV	-(R0),-(R2)	; перенести слово как есть
	CMP	R2,R4
	BHI	5$
	MOV	R0,ENDCOD	; новая граница занятой памяти
	MOV	R0,TXEND
	MOV	R2,LENT		; начало таблицы переменных
	MOV	R2,LIMIT
	MOV	R2,CIKL
	MOV	R4,TABTOP	; конец таблицы переменных
	CALL	TESTR
; ST - общий хвост загрузки программы: сбросить стек и перейти в главный
; цикл монитора (см. STAR, MONIT.MAC).
ST:	MOV	#STACK,SP
	JMP	STAR
;
; $CSAVE - оператор CSAVE (сохранить программу как двоичный образ, парный
; к $CLOAD): перекомпилировать программу заново (CLRCOD), затем сложить
; код и таблицу переменных (TABTOP..FCB) в один непрерывный блок сразу
; после кода, дописать в конце размер таблицы переменных (тот же трейлер,
; что $CLOAD вычитает при загрузке), посчитать общий размер и записать на
; диск.
$CSAVE::CMP	TABTOP,FCB	; программа пуста?
	BEQ	ST		; да - нечего сохранять =>
	CALL	CLOALL		; закрыть открытые файлы
	MOV	#MAG,R0		; R0 = блок параметров операции с диском
	MOV	#WR.*400,(0)+	; операция - запись
	MOV	#11,(0)+
	CALL	$COD		; разобрать имя файла (двоичный формат)
	MOV	#TEXT,(0)+	; данные начинаются с TEXT
	CLR	(0)+
	MOV	R4,SAVJMP	; запомнить позицию (контекст для возможной ошибки)
	.BJSR	CLRCOD		; перекомпилировать программу заново
	.BJSR	GRBCOL		; сбросить графический/цветовой режим
	MOV	R1,R5		; R5 = конец только что скомпилированного кода
	MOV	TABTOP,R4	; R4 = начало таблицы переменных
	MOV	R5,@#MAG+LENW	; LENW = размер кода (пока без таблицы переменных)
	SUB	#TEXT-2,@#MAG+LENW
; Дописать таблицу переменных (TABTOP..FCB) сразу за кодом.
7$:	MOV	(4)+,(5)+
	CMP	R4,FCB
	BLO	7$
	MOV	R4,@R5		; трейлер - конец таблицы переменных (= FCB)
	SUB	TABTOP,(R5)	; трейлер = размер таблицы переменных (см. $CLOAD)
	MOV	#MAG,R1
	ADD	(5)+,LENW(R1)	; учесть размер таблицы переменных в общем размере
	CLC
	ROR	LENW(R1)	; перевести байты в блоки/слова
	CALL	@WRITE		; записать образ на диск
	CALL	ATSTAB		; занести файл в каталог
	CALL	CASERR		; проверить ошибку операции
	BR	ST		; => в главный цикл монитора
;
; $SAVE - оператор SAVE (сохранить программу как текст, парный к LOAD - в
; отличие от CSAVE, сохраняющего двоичный образ). Проходит по строкам
; программы от FCB назад к TABTOP, для каждой восстанавливает текстовый
; вид (EILUTE - та же детокенизация, что использует LIST) и записывает в
; файл (COPOUT), пока не дойдёт до начала программы.
$SAVE::	CMP	TABTOP,FCB	; программа пуста?
	BEQ	ST		; да - нечего сохранять =>
	CALL	CLOALL		; закрыть открытые файлы
	MOV	#MAG,R0		; R0 = блок параметров операции с диском
	MOV	#WR.*400,(0)+	; операция - запись
	MOV	#12,(0)+
	CALL	$ASC		; разобрать имя файла (текстовый формат)
	MOV	FCB,(R0)+
	MOV	#200,(0)+
	MOV	#WR.*400,-(SP)
	MOV	R4,@#SAVJMP	; запомнить позицию (контекст для возможной ошибки)
	MOV	@#FCB,R4	; R4 = конец таблицы строк программы
	MOV	#AVPK,R0
	CALL	TSTVCT		; установить обработчик прерывания по Ctrl-C
	BCC	2$
	MOV	#TSTBRK,@R0
2$:
	MOV	LAST,FIRST	; очистить очередь клавиатуры
	MOV	R4,-(SP)
	TST	-(R4)		; к предыдущей строке
; Для каждой строки: восстановить текст (EILUTE), записать в файл (COPOUT).
1$:	.BJSR	EILUTE		; разобрать одну строку обратно в текст (как LIST)
	MOVB	#CR,-1(R3)	; завершить строку символом CR
	MOVB	R0,(3)+
	INC	R2
	CMP	-(R4),-(R4)	; к предыдущей строке в таблице
	MOV	(SP)+,R3
	MOV	SP,R0
	MOV	#MAG+NAMEW+20,R5
	.BJSR	COPOUT		; записать строку текста в файл
	MOV	@SP,@#MAG
	MOV	R3,-(SP)
	CMP	R4,TABTOP	; строки ещё остались?
	BHI	1$		; да - следующая строка =>
	CALL	CLOUTF		; все строки записаны - финализировать файл
	MOV	#AVPK,R0
	CALL	TSTVCT		; восстановить обычный обработчик Ctrl-C
	BCC	3$
	MOV	#IVS,@R0
3$:
	MOV	#5007,@#BUF	; подготовить строку вывода
	BR	BS4		; => в главный цикл монитора

; $BL0 - BLOAD без явного адреса (см. COMP.MAC BLOAD::): признак "адрес по
; умолчанию" (сам файл несёт адрес загрузки) для $BLOAD ниже.
$BL0::
	MOV	#1,-(SP)	; признак: адрес не указан явно
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)

; $BLOAD - оператор BLOAD "файл"[,адрес][,R] (двоичная загрузка машинного
; кода/данных, необязательный запуск после загрузки - см. TSTRUN в COMP.MAC).
; Проверяет, что данные умещаются до верхней границы памяти (160000),
; читает файл прямо в память, и при указанном ",R" - выполняет загруженный
; код.
$BLOAD::
	CALL	CLOALL		; закрыть открытые файлы

	MOV	#MAG,R0		; R0 = блок параметров операции с диском
	MOV	#RD.*400,(0)+	; операция - чтение
	MOV	#11,(0)+
	MOV	(SP)+,20(0)	; признак ",R" (запустить после загрузки)
	MOV	#-2,22(0)	; заглушка адреса (см. ниже, для случая $BL0)
	CALL	$BIN		; разобрать имя файла (двоичный формат)
	MOV	#160000,R1	; R1 = верхняя граница памяти
;	CMP	@R0,#TEXT
;	BLO	BS3
	SUB	(0)+,R1		; R1 -= адрес загрузки = сколько места до границы
	BLOS	BS3		; не хватает места - ошибка =>
	CLC
	ROR	R1		; в блоках/словах
	MOV	R1,(0)+		; максимальный размер для чтения
	MOV	R4,@#SAVJMP	; запомнить позицию (контекст для возможной ошибки)
	MOV	(SP)+,R3	; R3 = признак ",R" (запускать после загрузки?)
	CALL	CAS		; прочитать файл в память по адресу загрузки
	CALL	ISVARD
	TST	R3
	BEQ	BL1		; ",R" не указан - просто загрузить =>
	CLR	LYGIS
	BIT	#1,@#MAG+ADRW
	BNE	10$
	CALL	@MAG+ADRW	; запустить загруженный код (точка входа 1)
	BR	BL1
10$:	CALL	@MAG+ADRR	; запустить загруженный код (точка входа 2)
BL1:
	BR	BS4		; => в главный цикл монитора
;
; $BSAVE - оператор BSAVE "файл",адрес,длина (двоичное сохранение блока
; памяти, парный к $BLOAD): вычислить размер в блоках/словах, проверить
; диапазон и записать память [адрес,адрес+длина) на диск.
$BSAVE::
	CALL	CLOALL		; закрыть открытые файлы

	MOV	#MAG,R0		; R0 = блок параметров операции с диском
	MOV	#WR.*400,(0)+	; операция - запись
	MOV	#11,(0)+
	MOV	(SP)+,22(0)	; длина (со стека, из POKE-подобных аргументов BSAVE)
	MOV	(SP)+,20(0)	; адрес начала
	CALL	$BIN		; разобрать имя файла (двоичный формат)
	BIC	#1,@R0		; выровнять адрес на слово
	SUB	(0)+,@R0	; вычислить диапазон (адрес относительно длины)
	BLOS	BS3		; недопустимый диапазон - ошибка =>
	CLC
	ROR	@R0		; перевести размер в блоки/слова
	ADC	(0)+		; учесть остаток при округлении
	MOV	R4,@#SAVJMP	; запомнить позицию (контекст для возможной ошибки)
	CALL	CAS		; записать блок памяти на диск
; BS4/BS2 - общий хвост операций с файлами (LOAD/SAVE/BLOAD/BSAVE):
; восстановить R4 и вернуться в главный цикл монитора.
BS4:
	MOV	@#SAVJMP,R4
	CLR	@#SAVJMP
BS2::	JMP	@(4)+		; продолжить (диспетчер шитого кода)
BS3::	TRAP	5		; ошибка - недопустимый адрес/длина
;
; TESTR - общий финальный диспетчер файловых операций (FILES/LOAD/MERGE/
; CLOAD/CSAVE/SAVE/BSAVE/BLOAD): по флагу со стека (положен вызывающим
; кодом) решает, что делать дальше - >0: просто продолжить (BS2); =0:
; передать управление по адресу R5 (напр. продолжить вывод каталога);
; <0: автоматически запустить только что загруженную программу (LRUN).
TESTR:
	CALL	ISVARD
	MOV	(SP)+,R5	; R5 = адрес продолжения (для случая =0)
	MOV	@#SAVJMP,R4	; восстановить R4
	CLR	@#SAVJMP
	TST	(SP)+		; флаг действия
	BGT	BS2		; >0 - просто продолжить =>
	BEQ	1$		; =0 - передать управление по R5 =>
	MOV	FCB,R4		; <0 - запустить загруженную программу
	MOV	-(4),R5
	CLR	LYGIS
	JMP	LRUN
1$:	MOV	R5,PC		; переход по вычисленному адресу

; DEVTAB - имя устройства "CAS" (кассета) для таблицы драйверов ниже.
DEVTAB:
	.BYTE	0,40
	.ASCII	/CAS /
	.EVEN

; DRIVER - адреса драйверов устройств: диск (RT11) и лента/кассета (MAGNIT).
DRIVER:
	.WORD	RT11
	.WORD	MAGNIT
DEND:

; FILTYP/BINCOD - распознаваемые расширения не-BASIC файлов (см. $FIND) и
; соответствующие им обработчики.
FILTYP::.ASCII	/COD BIN /
BINCOD:	.WORD	CODEND,BINEND
;
; ISVARD - вывести имя файла на экран после файловой операции (только в
; прямом режиме, LYGIS=0 - не во время выполнения программы). Если
; устройство - системное по умолчанию, пропускает префикс устройства при
; выводе (короче отображаемое имя); если имя не задано - вообще ничего не
; выводит.
ISVARD::TSTB	LYGIS
	BNE	1$		; идёт выполнение/компиляция программы - не выводить =>
	MOV	R0,-(SP)
	MOV	R1,-(SP)
	MOV	#MAG+NAMER,R1	; R1 = имя файла (в блоке параметров MAG)
	MOV	#20,R2		; R2 = длина для вывода (с префиксом устройства)
	CMP	6(R1),#401*352	; устройство - системное по умолчанию?
	BNE	3$		; нет =>
	CMPB	#16,-NAMER+1(R1)
	BEQ	6$		; имя пустое - нечего выводить =>
	ADD	#12,R1		; да - пропустить префикс устройства
	SUB	#12,R2		; короче длина вывода
3$:
	.BJSR	ISVEIL		; вывести имя файла на экран
	MOV	#12,R0
	CALL	ISV		; вывести перевод строки
6$:	MOV	(SP)+,R1
	MOV	(SP)+,R0
1$:	RETURN
;
; TTANAL - разобрать необязательный префикс устройства в имени файла
; ("CAS:имя" - кассета, иначе - обычный диск). Сравнивает первые 4 символа
; со списком известных устройств (DEVTAB), и если за именем устройства
; сразу идёт ':' - потребляет префикс и выбирает соответствующий драйвер
; (DRIVER, по индексу совпадения R5); иначе оставляет текст как есть и
; использует драйвер по умолчанию (диск).
TTANAL::
	MOV	R4,-(SP)	; сохранить регистры
	MOV	R2,-(SP)
	MOV	R3,-(SP)
	TRAP	112		; пропуск пробелов
	MOV	R3,-(SP)	; запомнить начало имени

	CMP	-(SP),-(SP)	; зарезервировать буфер (4 байта) на стеке
	MOV	SP,R5
	MOVB	(3)+,(5)+	; скопировать первые 4 символа имени в буфер
	MOVB	(3)+,(5)+
	MOVB	(3)+,(5)+
	MOVB	(3)+,(5)+
	MOV	SP,R3		; сравнивать будем с этим буфером
	TRAP	113		; совпадает с именем известного устройства?
	.WORD	DEVTAB
	.BYTE	3,DEND-DRIVER-2
	BR	12$		; нет - не префикс устройства =>
	CMPB	@R3,#':	; да - а сразу за ним ':'?
	BNE	12$		; нет - тоже не префикс устройства =>
	INC	R3		; да - съесть ':'
	SUB	SP,R3		; R3 = число распознанных символов префикса
	CMP	(SP)+,(SP)+	; снять буфер сравнения
	ADD	(SP)+,R3	; R3 = абсолютная позиция в тексте после префикса
	ADD	(SP),R2		; учесть исходную длину имени
	SUB	R3,R2		; R2 = оставшаяся длина имени файла (без префикса)
	BEQ	2$		; имени не осталось - ошибка =>
	BMI	11$		; (не должно случаться) - откатить как при несовпадении =>
	CMP	(SP)+,(SP)+	; снять оставшееся сохранённое слово
	BR	13$
12$:	ADD	#6,SP		; несовпадение - просто снять резервы со стека
11$:	MOV	(SP)+,R3	; восстановить исходные R3,R2
	MOV	(SP)+,R2
	CLR	R5		; R5=0 - устройство по умолчанию
13$:	MOV	(SP)+,R4	; восстановить R4
	MOV	DRIVER(5),@#WRITE	; выбрать драйвер по индексу совпадения (R5)
	RETURN
2$:	TRAP	56.		; ошибка - имя файла пустое после префикса устройства
;
; FILNAM - разобрать и упаковать имя файла в формат RT-11 (6 символов
; имени + 3 символа расширения, дополненные пробелами) по адресу R0.
; Вызывается как JSR R1,FILNAM - R1 служит адресом возврата: если
; расширение было указано явно в тексте, при возврате R1 сдвигается на 4
; слова вперёд, чтобы пропустить код вызывающего, дописывающий расширение
; по умолчанию (см. $BIN/$COD/$ASC и т.п. - обычно 2 MOV-с-константой сразу
; после JSR). Необязательный префикс устройства ("CAS:") разбирает TTANAL.
FILNAM::MOV	4(SP),R3	; R3 = текст имени файла
	MOV	(SP)+,2(SP)
	CALL	CLRTSP
	MOV	(SP)+,R2	; R2 = длина текста имени
	BEQ	5$		; пусто - ошибка =>
	MOV	R5,-(SP)
	MOV	R4,SAVJMP	; запомнить позицию (контекст для возможной ошибки)
	CALL	TTANAL		; разобрать необязательный префикс устройства
	MOV	SAVJMP,R4
	CLR	SAVJMP
	MOV	#6,R5		; до 6 символов имени
; Скопировать символы имени (до точки или конца текста, или 6 символов).
1$:	CMPB	(R3),#'.	; точка (начало расширения)?
	BEQ	6$		; да =>
	MOVB	(R3)+,(R0)+	; скопировать символ имени
	DEC	R5
	BEQ	3$		; имя набрало 6 символов =>
	SOB	R2,1$
2$:	MOVB	#40,(R0)+	; текст кончился раньше 6 символов - дополнить пробелами
	SOB	R5,2$
3$:	DEC	R2
	BLE	4$		; текста больше нет - расширения не было (по умолчанию) =>
	CMPB	@R3,#'.		; далее действительно точка (расширение)?
	BEQ	7$		; да =>
5$:	TRAP	56.		; нет - ошибка (лишние символы в имени)
6$:	MOVB	#40,(0)+	; имя короче 6 символов - дополнить пробелами

	SOB	R5,6$
; Скопировать символы расширения (после точки).
7$:	MOV	#4,R5
8$:	MOVB	(3)+,(0)+	; скопировать символ расширения
	DEC	R5
	BEQ	10$
	SOB	R2,8$
9$:	MOVB	#40,(0)+	; расширение короче - дополнить пробелами
	SOB	R5,9$
10$:	DEC	R2
	BGT	5$		; текст ещё остался - ошибка (лишние символы) =>
; Расширение было указано явно - пропустить код вызывающего, дописывающий
; расширение по умолчанию (4 слова = 2 инструкции MOV #расш,(R0)+).
	ADD	#10,R1
4$:	MOV	(SP)+,R5
	MOV	R1,PC		; вернуться по R1 (см. описание выше)
;
; $BIN - разобрать имя файла (FILNAM) с расширением по умолчанию ".BIN"
; (см. $BLOAD/$BSAVE). BINEND - если расширение уже было в имени (FILNAM
; пропустила два MOV выше), допаковать оставшиеся байты записи пробелами.
$BIN:	MOV	(SP)+,R1
	JSR	R1,FILNAM	; разобрать имя, вернуться сюда или на BINEND
	MOV	#".B,(R0)+	; расширение по умолчанию - ".BIN"
	MOV	#"IN,(R0)+
BINEND:	MOV	#20040,(R0)+	; дополнить запись пробелами
	MOV	#20040,(R0)+
	MOV	#20040,(R0)+
	RTS	PC
;
; $COD - разобрать имя файла (FILNAM) с расширением по умолчанию ".COD"
; (см. $CLOAD/$CSAVE). CODEND - остаток записи дополняется нулями (не
; пробелами, как у $BIN) - формат двоичного образа программы отличается.
$COD:	MOV	(SP)+,R1
	JSR	R1,FILNAM	; разобрать имя, вернуться сюда или на CODEND
	MOV	#".C,(R0)+	; расширение по умолчанию - ".COD"
	MOV	#"OD,(R0)+
CODEND:	CLR	(R0)+		; дополнить запись нулями
	CLR	(R0)+
	CLR	(R0)+
	RTS	PC
;
; $ASC - разобрать имя файла (FILNAM) с расширением по умолчанию ".ASC"
; (текстовый файл - см. LOAD/SAVE, $ASC вызывается вместо $BIN/$COD). Далее
; проваливается в BLOCK0 - дописать хвост записи (номер версии "000" и
; завершающее слово); BLOCK0 также вызывается отдельно из OPFILE (OPEN).
$ASC:	MOV	(SP)+,R1
	JSR	R1,FILNAM	; разобрать имя, вернуться сюда (расширение по умолчанию)
	MOV	#".A,(R0)+	; расширение по умолчанию - ".ASC"
	MOV	#"SC,(R0)+
BLOCK0::MOV	#" 0,(R0)+	; номер версии файла ("000") - остаток записи RT-11
	MOV	#"00,(R0)+
	MOV	#40433,(R0)+	; завершающее слово записи
	RETURN
;
; LASTBL - подготовить и выполнить операцию "последний блок файла" (нужно
; при завершении файла - см. CLOF, $SAVE, $CLOAD): сбросить служебные поля
; блока параметров MAG, задать длину операции в 1 блок; если файл был
; открыт на чтение - переключить код операции на соответствующий для
; получения последнего блока при чтении.
LASTBL::
	MOV	#MAG+NAMEW+13,R1	; поле в блоке параметров MAG
	CLRB	(R1)+		; сбросить служебные поля...
	CLR	(R1)+
	CLR	(R1)+
	MOV	#1,@#MAG+LENW	; длина операции - 1 блок
	CMPB	@#MAG+1,#RD.	; файл был открыт на чтение?
	BNE	1$		; нет =>
	MOV	#16*400,@#MAG	; да - код операции "последний блок" для чтения
1$:
	RETURN
;
; ATSTAB - вызывается после записи файла (см. $CSAVE). Если R5 (переданная
; вызывающим позиция) не выше TABTOP - ничего не делает; иначе сдвигает
; блок памяти от TABTOP на величину (R5-FCB), копируя данные назад
; (двигаясь от R4 к R5). Точное назначение (для чего именно освобождается
; место) не выяснено до конца.
ATSTAB:	CMP	R5,TABTOP
	BLO	2$		; сдвигать нечего =>
	MOV	R5,R4
	SUB	FCB,R4		; R4 = величина сдвига

	ADD	R5,R4		; R4 = откуда брать данные для сдвига
1$:	MOV	-(R4),-(R5)	; сдвинуть слово
	CMP	R5,TABTOP
	BHI	1$
2$:	RETURN
;
; CASCII - подготовить блок параметров MAG для операции с диском по данным
; открытого файла (R0 - адрес FCB): скопировать запись FCB в MAG, выбрав
; нужный драйвер по флагу устройства, хранящемуся в старшем бите первого
; слова FCB (бит установлен - кассета/MAGNIT, см. TTANAL; иначе - диск/RT11).
; Ничего не делает, если R0 указывает не на настоящий FCB (< FCB).
CASCII::CMP	R0,FCB
	BLO	2$		; недопустимый FCB - ничего не делать =>
	MOV	DRIVER,@#WRITE	; по умолчанию - драйвер диска
	MOV	#MAG,R1
	MOV	(0)+,(1)+	; скопировать слово режима/состояния FCB
	BPL	10$		; флаг устройства не установлен (диск) =>
	BIC	#100000,-2(1)	; кассета - снять флаг из скопированного слова
	MOV	DRIVER+2,@#WRITE	; выбрать драйвер кассеты
10$:
	MOV	#12,(1)+
	MOV	#10,R5		; скопировать остаток записи FCB (8 слов)
1$:	MOV	(0)+,(1)+
	SOB	R5,1$
	MOV	R0,R5
	MOV	R0,(1)+		; адрес буфера операции
	MOV	#200,(R1)+	; размер блока
	SUB	#22,R0		; вернуть R0 к началу записи FCB
2$:	RETURN

; CAS1/CAS - выполнить операцию с диском по блоку параметров MAG (через
; драйвер WRITE) и проверить результат (CASERR). CAS1 предварительно
; выводит имя файла (см. ISVARD) - используется при повторной попытке.
CAS1:	CALL	ISVARD		; вывести имя файла (перед повтором операции)
CAS::
	MOV	#MAG,R1		; R1 = блок параметров операции
	CALL	@WRITE		; выполнить операцию через текущий драйвер
; CASERR - проверить код ошибки операции (R1 - его результат): 0 - успех;
; NER. (диск не готов и т.п.) - повторить операцию (CAS1); иначе - если
; код входит в список "программных" ошибок (RER./FER./MER./SER. - ошибки
; чтения/файла/носителя/структуры) - перейти на конкретный обработчик из
; таблицы 6$ по номеру совпадения; иначе - общая обработка (1$).
CASERR:
	MOVB	@R1,R1		; R1 = код ошибки
	BEQ	2$		; успех =>
	CMPB	R1,#NER.	; устройство не готово?
	BEQ	CAS1		; да - повторить операцию =>

	CMPB	R1,#RER.
	BGE	1$
	MOV	#5$,R0		; R0 = таблица распознаваемых кодов ошибок
3$:	TSTB	@R0
	BEQ	1$		; конец таблицы - не распознано =>
	CMPB	R1,(R0)+	; совпадает с этим кодом?
	BNE	3$		; нет - следующий =>

	SUB	#5$+1,R0	; вычислить номер совпавшего кода
	ASL	R0
	JMP	@6$(R0)		; => обработчик для этого конкретного кода ошибки
5$:
	.BYTE	RER.
	.BYTE	FER.,MER.,SER.
	.EVEN
; Обработчики по конкретному коду ошибки (см. таблицу 5$/CASERR выше):
; RER. и нераспознанные/старшие коды - ошибка чтения; FER. - ошибка файла;
; MER. - переполнение памяти; SER. - как прерывание (Ctrl-C, см. BRKO).
6$:
	.WORD	1$
	.WORD	7$,8$,BRKO

2$:	RETURN			; успех - выход из CASERR
1$:	TRAP	19.		; ошибка чтения/устройства
7$:	TRAP	53.		; ошибка файла (не найден и т.п.)

8$:	TRAP	7		; не хватает памяти

; BLOCKN - прочитать следующий последовательный блок файла (см. FILINP):
; увеличить 3-значный десятичный ASCII-номер блока в записи FCB на 1,
; как счётчик-одометр (перенос через '9'->'0' в следующий разряд).
BLOCKN::MOV	#3,R1		; 3 разряда номера блока
	TST	-(R5)		; отступить к последнему разряду
6$:	CMPB	-(R5),#'9	; этот разряд - '9' (нужен перенос)?
	BNE	7$		; нет =>
	MOVB	#'0,@R5		; да - обнулить разряд (перенос)
	SOB	R1,6$		; и перейти к следующему разряду
	CMPB	(R5)+,(R5)+	; (все разряды были '9' - просто сдвинуть R5)
7$:	INCB	@R5		; увеличить разряд, не требующий переноса
	RETURN

;---------------------------------------------
; Опкоды оператора WIDTH (см. AWDT/COMP.MAC WIDTH::), три формы:
;   $MIDLE - WIDTH ,ширина_устройства     (ширина экрана не меняется)
;   $WDMD  - WIDTH ширина_экрана,ширина_устройства  (обе заданы)
;   $WIDTH - WIDTH ширина_экрана           (ширина устройства не меняется)
; $MIDLE/$WDMD сначала проверяют ширину устройства (не длиннее оставшегося
; места до MAXLL), затем (как и $WIDTH) - общий код $W1 проверяет и
; применяет ширину экрана, и, если задано (R3>=0), сохраняет ширину
; устройства в MIDLE.
$MIDLE::MOV	(SP)+,R3	; R3 = ширина устройства
	MOV	LL,-(SP)	; сравнивать будем с текущей длиной строки экрана
	BR	$M1
$WDMD::	MOV	(SP)+,R3	; R3 = ширина устройства (ширина экрана уже на стеке)
$M1:	MOV	#MAXLL,R0
	SUB	@SP,R0		; R0 = сколько места останется под ширину устройства
	CMP	R3,R0		; ширина устройства умещается?
	BLOS	$W1		; да =>
WERR:	TRAP	5		; нет - ошибка
;
$WIDTH::
	MOV	#-1,R3		; ширина устройства не меняется
; $W1 - проверить и применить ширину экрана (R2, со стека).
$W1:
	TST	CRTGRP		; в графическом режиме менять ширину нельзя
	BNE	WERR
	MOV	(SP)+,R2	; R2 = ширина экрана
	BLE	WERR		; должна быть положительной
	CMP	R2,#MAXLL
	BGT	WERR		; и не больше MAXLL
	MFPS	-(SP)
	MTPS	#340		; запретить прерывания
	.BJSR	NOSTOP
	CALL	SETWDT		; применить новую ширину экрана
	TST	R3
	BMI	1$		; ширина устройства не задана - не менять =>
	MOV	R3,MIDLE	; сохранить новую ширину устройства
1$:
	.BJSR	STOPEN
	MTPS	(SP)+		; восстановить прерывания

	MOV	#FF,R0
	CALL	ISV		; очистить экран (перерисовать с новой шириной)

	JMP	@(4)+
;
; TRUN - оператор TRON (включить трассировку выполнения - вывод номеров
; выполняемых строк). Включает TRFLAG (0 - выключена, >0 - включена,
; <0 - включена, но особое состояние на этой строке); действует только
; во время выполнения программы (LYGIS<>0). Если строка не пуста - продолжает
; в TRIN (вывод номера строки, не показан здесь).
TRUN::	TST	TRFLAG
	BNE	TEND		; уже включена - ничего не менять =>
	INC	TRFLAG		; включить трассировку
	TSTB	LYGIS
	BEQ	TEND		; программа не выполняется - без эффекта =>
	TST	NUMBER		; есть текущий номер строки?
	BEQ	1$		; нет =>
	NEG	TRFLAG		; есть - особое состояние (уже отображён номер этой строки)
	BR	TEND

1$:	CMP	@R4,#ENDPRG	; программа сразу заканчивается?
	BEQ	TEND		; да - трассировать нечего =>
	JMP	TRIN		; => вывести номер текущей строки и продолжить

; TREND - оператор TROFF (выключить трассировку).
TREND::	TST	TRFLAG
	BLE	1$		; уже выключена (или особое состояние) =>
	TSTB	LYGIS
	BEQ	1$		; программа не выполняется =>
	JSR	R2,SEPAP	; завершить вывод трассировки (разделитель)
1$:	CLR	TRFLAG		; выключить трассировку
TEND:	JMP	@(4)+		; продолжить (диспетчер шитого кода)

;
;--------------------------------------------
.END
