22$:	MOV	-(R1),-(R3)
	CMP	R3,R0
	BHI	22$
;...................ОЧИСТКА ПЕРЕМЕННЫХ.............
1$:	MOV	LENT,R2
7$:	CMP	R2,TABTOP
	BHIS	8$
	TSTB	@R2
	BPL	6$
	TST	(R2)+
	TST	(R2)+
	BEQ	77$
	ADD	R5,-(R2)
	MOV	(R2)+,R0
	CLR	R3
	BISB	@R2,R3
	ASL	R3
	ADD	R3,R0
	MOV	(0)+,R1
	ASR	R1
