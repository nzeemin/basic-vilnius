		.INCLUDE /GENUKD.MAC/
		.SBTTL	MONIT
		.ENABLE LC

; ###################
; #                 #
; #   BASIC - VVU   #
; #                 #
; ###################

; ИСПОЛНИТЕЛЬ: ВЦКП ВГУ
; ВИЛЬНЮС,1987

; ===========================
; ****СИСТЕМНЫЕ КОНСТАНТЫ****
; ===========================

BREAKW==4	;АДРЕС ВЕКТОРА ПРЕРЫВАНИЙ ПО КЛАВИШЕ "СТОП"
ILCODW==10	;АДРЕС ВЕКТОРА ПРЕРЫВАНИЙ "НЕДОПУСТИМЫЙ КОД"
FLOATW==244	;АДРЕС ВЕКТОРА ПРЕРЫВАНИЙ ПЛАВАЮЩЕЙ АРИФМЕТИКИ
TRAPW=34	;АДРЕС ВЕКТОРА ПРЕРЫВАНИЙ ПО ИНСТРУКЦИИ TRAP

TIMER==100	;АДРЕС ВЕКТОРА ПРЕРЫВАНИЙ ТАЙМЕРА

CHIMEM==160000

ABRKW=070074	;ВЕКТОР ОБРАБОТКИ "СТОП": 160170/2
AMEM=176640	;РЕГИСТР АДРЕСА ДОСТУПА КО ВСЕЙ ПАМЯТИ
DMEM=176642	;РЕГИСТР ДАННЫХ

; ========================
; ****МАКРООПРЕДЕЛЕНИЯ****
; ========================

	.MACRO	.KOI87	STRING
		.IRPC	A,<STRING>
	.IF LT,''A-100
		.BYTE	''A
	.IFF
		.BYTE	200+''A
	.ENDC
		.ENDM
	.ENDM

	.MCALL	.SETTOP,.EXIT,.PRINT,.SERR,.SCCA

	.MACRO	.BJMP	N
	.IF EQ,MASINA-BK0011
		MOV	#PAG2,-(SP)
		MOV	#N,-(SP)
		EMT	56
	.IFF
		JMP	N

	.ENDC
	.ENDM	.BJMP

	.MACRO	.BJSR	N
	.IF EQ,MASINA-BK0011
		MOV	#PAG2,-(SP)
		MOV	#N,-(SP)
		.BJSR0
	.IFF
		CALL	N
	.ENDC
	.ENDM	.BJSR

; ====================
; ****ПУСК СИСТЕМЫ****
; ====================

	.GLOBL	TEXT,MAGSIZ,MIDM
	.GLOBL	BC,CASCII,BLOCKN,FNDBUF,TRTOPL
	.GLOBL	TOINT,CAS,NEXINT,NEXJMP,JMP,RTS,LNUM,ISVARD
	.GLOBL	STEP,SEPAP,NOUSR
	.GLOBL	SYSPTR,USRLOC,JSW
	.GLOBL	BRUK

	.GLOBL	FILTYP,AVPK,ISV1,IVS

	.GLOBL	KOS,SING,IR,RI,MLR

	.GLOBL	MIG,KBON

	.GLOBL	TRAP

	.GLOBL	CURON,CUROFF
	.GLOBL	ISV
	.GLOBL	MONERR,AOPEND,AOPMON,AOPSUB,OPRNAM,AOPNAM
	.GLOBL	STOPEN,NOSTOP,TSTVCT,RSTVCT

	.GLOBL	CURS
	.GLOBL	ENDPRG
	.GLOBL	ISVEIL,IVEIL
	.GLOBL	RESTV,ISVETO,DFCB,TMPSP
	.GLOBL	CLOALL,TABMOV,PFACT

	.GLOBL	RWREN,ISVSS

	.GLOBL	INBF1,FIRST,LAST
;
;----------------------------
;

; START - холодный старт BASIC (точка входа всего интерпретатора). Сохраняет
; исходные (RT-11) векторы прерываний и переключение памяти в SAUG (см.
; ADDRMN - зеркальное восстановление при выходе), переключает память в режим
; BASIC (AMEM/DMEM/BRUK), запрашивает память у RT-11 (.SETTOP), инициализирует
; системные переменные (счётчики AUTO, генератор случайных чисел, таблицу
; USR-функций), устройства (MIDM) и пустую программу (CLRTXT), затем уходит
; в SETW (установка векторов) -> STAR.
START::
	MOV	#STACK,SP	; начальный стек

	MOV	#SAUG,R0	; SAUG <- исходные векторы (для ADDRMN/RT11::)
	CLR	R1

	MOV	#6,R2
6$:	MOV	(R1)+,(R0)+	; скопировать 6 слов низкой памяти (векторы, см. RT11::)
	SOB	R2,6$
	MOV	@#AVPK,(R0)+	; + исходный AVPK
	MOV	@#AVPK+2,(R0)+

	MOV	@#FLOATW,(0)+	; Сохраняем обработчик ошибок FIS
	MOV	@#FLOATW+2,(0)+	; и его PSW
	CLR	@#BRKFLG		;ЗАПРЕТИТЬ BREAK (ДЛЯ УК)

	MOV	#ABRKW,@#AMEM	; переключить память: сохранить старую карту...
	MOV	@#DMEM,(0)+
	MOV	#BRUK,@#DMEM	; ...установить карту BASIC (страница BRUK)
	INC	@#AMEM
	MOV	@#DMEM,(0)+
	MOV	#600,@#DMEM
	CLR	RUSLAT		; режим ЛАТ (латиница) по умолчанию

	MOV	@#SYSPTR,R0	; получить верхнюю границу памяти через системную
	MOV	USRLOC(R0),R0	; область RT-11 (USRLOC) и запросить её (.SETTOP)
	MOV	R0,@#WHIMEM
	TST	-(R0)
	.SETTOP

	MOV	@#WHIMEM,@#HIMEM

	.SERR			; включить обработку ошибок RT-11
	.SCCA	#PARAM,#WSCCA	; настроить область разбора командной строки (CSI)
	BIS	#10000,@#JSW
	CLR	@#ASCFLG

	CLR	TRFLAG		; трассировка выключена
	CLR	LPTPOS
	MOV	#200.,STRSIZ	; размер области строк по умолчанию (128)
	MOV	#AUINC,R0
	MOV	#12,(0)+	; AUINC = 10 (шаг AUTO по умолчанию)
	MOV	#12,(0)+	;CURLIN (= 10 по умолчанию)
	CLR	(R0)+		;VCTNMB	(цепочка подменённых векторов пуста, см. WRESET)
;	CLR	(R0)+		;ONERFL

;! --> MDINIT
;	MOV	#III,R0
	MOV	R0,R1
	MOV	#40101,(0)+	;III	начальное состояние генератора случайных чисел
	MOV	#27076,(0)+
	MOV	(1)+,(0)+	;RNDSAV
	MOV	(1)+,(0)+

;	MOV	#1,(R0)+	;MAXFIL <- 1
	MOV	#10.,R1
1$:				;USRTAB
	MOV	#NOUSR,(0)+	;НЕОПРЕДЕЛЕННАЯ ФУНКЦИИ USR	; все 8 слотов USR() не определены
	SOB	R1,1$

;	MOV	#15,R1		;НЕЯВНЫЙ ТИП
;.IF DF,SNG			;APRL
;5$:	MOV	#1002,(R0)+

;.IFF
;5$:	MOV	#2004,(R0)+
;.ENDC
;	SOB	R1,5$
;
	CLR	@#PNTSAV	;STOPAR	(нет активных точек останова STEP)

	CALL	MIDM			;ИНИЦИАЛИЗАЦИЯ УСТРОЙСТВ
	CLR	@#VCTNMB
	CALL	CLRTXT		; NEW: пустая программа, стартовый баннер

TOSETW:	JMP	SETW		; установить векторы прерываний и войти в STAR

; INIT - обработчик вектора 2 (нечётный адрес/ошибка шины) - аварийное
; восстановление: сбросить стек, снять точки останова (SEPAP), заново
; инициализировать устройства и вернуться к установке векторов.
INIT:	MOV	#STACK,SP
	JSR	R2,SEPAP	; снять точки останова STEP, сбросить стек интерпретатора
	CALL	MIDM		; переинициализировать устройства
	MOV	#14,R0
	CALL	ISV
	BR	TOSETW

; CTRLC - обработчик CTRL/C вне выполнения программы (LYGIS>=0): просто
; прервать текущий ввод и вернуться в монитор. Во время выполнения (LYGIS<0)
; - полноценная обработка через BREAK.
CTRLC::	TST	LYGIS
	BMI	BREAK		; программа выполняется => полная обработка =>
	MOV	#STACK,SP
	MOV	#12,R0
	CALL	ISV		; перевод строки
	JMP	STAR

; ADDRMN - выход из BASIC обратно в RT-11 (восстанавливает исходные векторы
; прерываний и переключение памяти AMEM/DMEM, точное назначение регистров
; AMEM/DMEM не выяснено до конца).
ADDRMN::TRAP	106		; конец оператора
	CALL	WRESET		; откатить векторы, подменённые программой
	MOV	#14,R0
	CALL	ISV
	CALL	CURON
	.BJSR	SETCRT

	MOV	#SAUG,R0	; восстановить исходные (RT-11) векторы из SAUG
	CLR	R1
	MOV	#6,R2
1$:	MOV	(R0)+,(R1)+
	SOB	R2,1$
	MOV	(R0)+,@#AVPK
	MOV	(R0)+,@#AVPK+2

	MOV	(0)+,@#FLOATW	; Восстанавливаем обработчик ошибок FIS
	MOV	(0)+,@#FLOATW+2	; и его PSW

	MOV	#ABRKW,@#AMEM	; восстановить переключение памяти в исходное состояние
	MOV	(0)+,@#DMEM
	INC	@#AMEM
	MOV	(0)+,@#DMEM

	.PRINT	#LC1		; сбросить терминал (escape-последовательность)
	.EXIT			; выйти в RT-11

BRKO::				; точка входа вектора BREAK - сразу в BREAK

; BREAK - обработчик CTRL/C во время выполнения программы. Сбрасывает стек,
; вывод на принтер, очередь клавиатуры, режим РУС/ЛАТ и графику; печатает
; "СТОП" и (если программа выполнялась) номер прерванной строки, определяя
; точную позицию через сравнение сохранённого PC с адресами внутри диспетчера
; шитого кода (NEXINT/NEXJMP/JMP/RTS-обработчик) - интерпретатор мог быть
; прерван на середине выборки следующей инструкции, что требует поправки
; указателя. Завершается общей очисткой (SEPAP/TRTOPL/STOPEN) и падает в
; SETW (переустановка векторов) -> STAR.
BREAK::
	MOV	#STACK,SP	; сбросить стек интерпретатора

	CLR	@#IODEV		; отменить вывод на печать

	MOV	FIRST,LAST	; очистить очередь клавиатуры
	MOVB	RUSLAT+1,RUSLAT	; восстановить режим РУС/ЛАТ

	TST	CRTGRP
	BEQ	13$		; не в графике => пропустить сброс графики =>
	MOV	#15,R1
	CLR	R0
12$:	CALL	ISV1		; сбросить графический режим экрана
	SOB	R1,12$
	CALL	KBON
13$:

	.BJSR	SETCRT
	MOV	#WSTOP,R1
	MOV	#5,R2
	CALL	ISVEIL		; вывести "СТОП"
	TST	LYGIS
	BGE	2$		; программа не выполнялась => просто перевод строки =>
	TST	SAVJMP		; ждал ли CONT после HALT (SAVJMP)?
	BEQ	3$
	MOV	SAVJMP,R4	; да - использовать эту точку продолжения
	CLR	SAVJMP
3$:	CMP	R4,STRREG
	BHI	2$		; R4 вне кода программы => не выводить номер строки =>
	CMP	@SP,#NEXINT+24	; сохранённый PC внутри диспетчера шитого кода?
	BEQ	10$
	CMP	@SP,#NEXJMP+22
	BEQ	10$
	CMP	@SP,#JMP+2
	BEQ	10$
	CMP	@SP,#RTS+14
	BLO	11$
	CMP	@SP,#RTS+26
	BHI	11$
	BEQ	10$
	TST	(4)+		; поправить R4 (прервано на выборке инструкции)
10$:	TST	(4)+		; поправить R4 ещё на слово
11$:	CALL	LNUM		; вывести номер прерванной строки
	MOV	-(4),ADRHLT	; запомнить адрес останова для CONT
	BR	4$
2$:	MOV	#12,R0
	CALL	ISV		; перевод строки
4$:	JSR	R2,SEPAP	; снять точки останова STEP, сбросить стек интерпретатора
	CALL	TRTOPL
	CLR	LYGIS		; отметить: программа не выполняется
	CALL	STOPEN		; снова разрешить CTRL/C
; SETW - установка векторов прерываний интерпретатора (вызывается из
; START при холодном старте). Для каждого вектора: TSTVCT - установить,
; только если ещё свободен; RSTVCT - установить принудительно (в цикле,
; пока не получится - .BJSR возвращает признак занятости через carry).
SETW::					;УСТАНОВКА ВЕКТОРОВ ПРЕРЫВАНИЙ
	MOV	#137,@#0	; вектор 0 (чётность/шина): опкод останова
	MOV	#INIT,@#2	; вектор 2 (нечётный адрес/шина): переинициализация
;---
	MOV	#BREAKW,R0	; вектор CTRL/C (BREAK)
	.BJSR	TSTVCT		; занят кем-то другим (пользовательской программой)?

	BCC	2$		; да => не трогать =>
	MOV	#BRKO,@R0	; свободен => обработчик BRKO
	MOV	#340,2(R0)	; PSW обработчика (макс. приоритет)
2$:
;---
	MOV	#TRAPW,R0	; вектор команды TRAP
6$:	.BJSR	RSTVCT
	BCC	6$		; повторять, пока не установится =>
	MOV	#TRAP,@R0	; обработчик - главный диспетчер TRAP (см. TRAP.MAC)
	MOV	#340,2(R0)
;---
	MOV	#AVPK,R0	; вектор клавиатуры
3$:	.BJSR	RSTVCT
	BCC	3$
	MOV	#IVS,@R0	; обработчик - IVS (приём символа, см. IO.MAC)
	MOV	#340,2(R0)
MOV	#100,@#ARSK		; регистр клавиатуры/экрана - начальное значение
;---
	MOV	#ILCODW,R0	; вектор недопустимой инструкции
7$:	.BJSR	RSTVCT
	BCC	7$
	MOV	#ILCDO,@R0	; обработчик - ILCDO (TRAP 51, см. выше)
	MOV	#340,2(R0)

;---
	MOV	#FLOATW,R0	; Адрес обработчика ошибок FIS
4$:	.BJSR	RSTVCT
	BCC	4$
	MOV	#FERRI,@R0	; Устанавливаем обработчик ошибок FIS
	MOV	#340,2(R0)	; PSW для обработчика ошибок FIS

	MOV	#PARAM+4,R0	; PARAM+4.. - похоже, ячейки для CTRL/P (см. MEND в DISK.MAC)
	MOV	#STOPEN,@R0	; адрес STOPEN
	MOV	#NOSTOP,-(R0)	; и NOSTOP - точное назначение этой пары не выяснено
	CLR	-(R0)

	.BJSR	MDINIT		; инициализировать драйвер диска (MDBLOC.MAC)

;---
	BR	STAR		;ПЕРЕХОД НА БЕЙСИК МОНИТОР

; FERRI - обработчик прерывания по ошибке сопроцессора FIS (аппаратная
; плавающая арифметика). Код ошибки в флагах PS кадра прерывания (C/N/Z)
; выбирает конкретную ошибку BASIC; N (BMI) - не ошибка (напр. переполнение,
; продолжается со значением по умолчанию), сразу к очистке без TRAP.
FERRI:
	MOV	R0,-(SP)
	MTPS	4(SP)		; восстановить флаги PS из кадра прерывания

	BCS	1$		; C => =>
	BMI	2$		; N => не ошибка, просто очистить и продолжить =>
	BEQ	3$		; Z => =>

	TRAP	6		; иначе - общая ошибка FIS
1$:	TRAP	11.		; C => конкретная ошибка (переполнение?)
3$:	TRAP	5		; Z => конкретная ошибка (деление на 0?)
2$:
	MOV	SP,R0
	ADD	#6,R0		; R0 -> в кадр прерванной программы (после PC/PS/R0)

	CLR	(R0)+		; сбросить слово (результат/флаг ошибочной операции)

	CLR	(R0)+		; и ещё одно
	MOV	(SP)+,R0
	RTI

;-------
; MONIT - вход в монитор (после NEW/загрузки программы): сбросить точку
; останова и провалиться в главный цикл (STAR).
MONIT::
	CLR	ADRHLT

; ======================================
; ***БЛОК ВВОДА ДИРЕКТИВ ПОЛЬЗОВАТЕЛЯ***
; ======================================

; STAR - главный цикл прямого режима (приглашение "Ok", ввод и разбор строк
; с клавиатуры). Разрешает прерывания, сбрасывает AUTO-режим и признак
; "программа выполняется" (LYGIS), выводит "Ok" и включает курсор. Затем в
; цикле PRGLIN/NEXTL: если включён AUTO (автонумерация строк при вводе) -
; сразу переходит к выводу следующего номера строки (AUNEXT), иначе ждёт
; ввода строки (IVEIL) и передаёт её на разбор.
STAR::
	MTPS	#0		; разрешить прерывания
AUTOCL:	CLR	AUTOON		; выключить AUTO-режим
	CLR	LYGIS		;ПРИЗНАК РАБОТЫ МОНИТОРА

	.BJSR	SETCRT
	MOV	#OK,R1		;ВЫВОД OK
	MOV	#3,R2
	CALL	ISVEIL
	CALL	CURON
PRGLIN:	TST	AUTOON
	BNE	AUNEXT		; AUTO включён => сразу вывести номер следующей строки =>
NEXTL:	CALL	IVEIL		;ВВОД СТРОКИ
;
; --------------------------
; ...АНАЛИЗ СТРОКИ...
; --------------------------
;
; ANALIZ - разбор введённой строки: если строка пуста/недействительна (INBF1
; вернул CLC) - вернуться за новой строкой. Иначе ASCCOD классифицирует начало
; строки и, судя по паре следующих BR, определяет, что это - номер строки
; программы (редактирование/вставка строки, BR PRGLIN - продолжить цикл ввода)
; или директива монитора (BR COMAND - выполнить команду). Способ возврата
; результата через JSR R1,ASCCOD с двумя BR сразу за вызовом - тот же приём,
; что и TRAP-обработчики (сдвиг адреса возврата, чтобы "выбрать" одну из веток).
ANALIZ::
	CALL	INBF1
	BCC	NEXTL		; строка не введена/отменена => ждать заново =>
	MOV	#BUF,R3
2$:	JSR	R1,ASCCOD	; классифицировать строку (номер программы / команда)
	BR	COMAND
	BR	PRGLIN
;
; AUNEXT - AUTO-режим: вычислить номер следующей строки (CURLIN+AUINC).
; При переполнении (BCS) - выключить AUTO; иначе перейти к её вводу (EDAUIN).
AUNEXT:	MOV	CURLIN,R5
	ADD	AUINC,R5
	BCS	AUTOCL		; переполнение номера строки => выключить AUTO =>
	JMP	EDAUIN

; COMAND - выполнить директиву монитора. R5 - номер директивы (от ASCCOD).
; Если он в диапазоне таблицы AOPMON (командные глаголы монитора: NEW, LIST,
; RUN и т.п.) - перейти по AOPSUB(R5) (общая с компилятором таблица адресов
; обработчиков операторов/команд); иначе (R5 вне диапазона AOPMON, т.е. это
; обычный оператор языка) - передать на выполнение как прямой оператор (STATM).
COMAND: CALL	CUROFF
	MOV	SP,R0
	CMP	R5,#AOPMON-AOPSUB
	BLT	1$		; команда монитора => обработчик из AOPSUB/AOPMON =>
	JMP	@AOPSUB(R5)
1$:	JMP	STATM		; обычный оператор => выполнить как прямой оператор =>

TSTBRK::

RTIO::	RTI
ILCDO::	TRAP	51.

; =============================
; ***ОБЛАСТЬ ДАННЫХ МОНИТОРА***
; =============================

BASVU:	.BYTE	FF			;НАЧАЛЬНОЕ СООБЩЕНИЕ
	.KOI87	< БЕЙСИК >

	.KOI87	<УК-НЦ>

	.KOI87	< ДИСКОВЫЙ>

	.BYTE	LF
	.KOI87	< ВИЛЬНЮС, 1988.09.28>

	.BYTE	LF
	.BYTE	LF
BASVEND:

WSTOP::
	.BYTE	12
	.KOI87	<СТОП>
	.BYTE	12

ATLINE: .KOI87	< В СТРОКЕ >

OK:
	.ASCII	/Ok/<12>
LC1:	.BYTE	33,'Y,'7,' ,200
	.EVEN

;--------------------------------
;

; ENDPRG - конец выполнения программы (переход сюда из шитого кода при END
; или после последней строки). Закрывает все файлы (CLOALL). LYGIS=-1 в
; обычном RUN, поэтому INC LYGIS даёт 0 (BEQ-путь: не переходит на END1) -
; в этом случае снимаются точки останова STEP и сбрасывается стек
; интерпретатора (SEPAP; см. её определение ниже), сбрасывается адрес точки
; останова (ADRHLT) и выводится номер последней строки (TRTOPL). Если же
; LYGIS был другим особым значением (напр. #200 - похоже, режим STEP), INC
; даёт ненулевой результат и эти действия пропускаются (END1) - видимо, тот
; режим сам отвечает за собственное завершение. В обоих случаях в итоге -
; возврат в главный цикл монитора (STAR).
ENDPRG::.BJSR	CLOALL
	INC	LYGIS
	BNE	END1		; не обычный RUN (LYGIS был не -1) => пропустить сброс =>
	JSR	R2,SEPAP	; снять точки останова STEP, сбросить стек интерпретатора
	CLR	ADRHLT
	CALL	TRTOPL		; вывести номер последней выполненной строки
END1:
	JMP	STAR		; вернуться в главный цикл монитора
;
; HALT - оператор STOP (переход сюда из шитого кода, R4 - адрес продолжения
; в коде программы). Сохраняет R4 в SAVJMP (чтобы CONT мог продолжить с этого
; места) и выводит сообщение "СТОП". Если R4 указывает за пределы кода
; программы (выше STRREG - начала области строк/переменных) - это ошибочное
; состояние, SAVJMP сбрасывается и выдаётся ошибка (3$: MONERR). Иначе R4
; запоминается как ADRHLT (адрес останова), снимаются точки останова STEP и
; сбрасывается стек интерпретатора (SEPAP/TRTOPL) и печатается номер текущей
; строки (LNUM). Затем (JSR R0,SETST) регистрируется точка останова в
; таблице строк - точный смысл вызова SETST здесь (после двойного
; `CMP -(R4),-(R4)`, судя по всему - просто отступ R4 на 4 байта назад без
; иного эффекта) не выяснен до конца. Возврат - в главный цикл монитора
; (через END1).
HALT::
	.BJSR	SETCRT
	MOV	R4,SAVJMP	; запомнить точку продолжения для CONT
	MOV	#WSTOP,R1
	MOV	#5,R2
	CALL	ISVEIL		; вывести "СТОП"
	CMP	R4,STRREG
	BHI	3$		; R4 вне кода программы => ошибка =>
	MOV	R4,ADRHLT	; запомнить адрес останова
2$:	JSR	R2,SEPAP	; снять точки останова STEP, сбросить стек интерпретатора
	CALL	TRTOPL
	CALL	LNUM		; вывести номер текущей строки
	CMP	-(R4),-(R4)	; сдвинуть R4 на 4 байта назад (см. коммент выше)
	JSR	R0,SETST
	BR	1$
	CLR	ADRHLT

1$:	CLR	SAVJMP
	BR	END1		; вернуться в главный цикл монитора
3$:	CLR	SAVJMP
	JMP	MONERR		; ошибка: R4 вне кода программы

; TRTOPL - нормализация состояния трассировки: если TRFLAG отрицателен
; (особое состояние - номер текущей строки уже выведен, см. TRUN в JMP.MAC) -
; снять это особое состояние (сделать снова положительным/включённым).
TRTOPL::TST	TRFLAG
	BPL	1$		; TRFLAG>=0 (выключена или обычное "включена") - ничего не делать =>
	NEG	TRFLAG		; снять особое состояние
1$:	RETURN
;
; LNUM - найти и вывести номер текущей строки программы (по адресу в R4).
; AGAUD ищет в таблице строк (TABTOP) запись, содержащую R4, возвращая номер
; строки (слово по смещению 2 от начала записи) в R5.
LNUM::	CALL	AGAUD
	MOV	2(0),R5		; R5 = номер строки из найденной записи
; ATLIN1 - вывести " В СТРОКЕ " и сам номер строки (R5) через TRAP 114.
ATLIN1::MOV	#ATLINE,R1
	MOV	#12,R2
	CALL	ISVEIL		; вывести текст " В СТРОКЕ "
	MOV	R5,R2
	TRAP	114		; вывести число R5
	MOV	#12,R0
	CALL	ISV		; перевод строки
	RETURN
;
; AGAUD - найти в таблице строк (TABTOP..FCB, записи по 3 слова) запись,
; содержащую адрес R4, вернуть в R4 позицию внутри неё (слово2 = номер строки).
AGAUD:: MOV	TABTOP,R0
3$:	CMP	(R0)+,R4	; слово0 записи < R4?
	BLO	4$		; да - запись найдена =>
	CMP	(R0)+,(R0)+	; пропустить слово1 и слово2 записи
	CMP	R0,FCB		; достигнут конец таблицы строк?
	BLO	3$		; нет - перейти к следующей записи =>
	TST	(R0)+		; конец таблицы - пропустить ещё слово (выравнивание?)
4$:	MOV	R0,R4
	RETURN
;
; ASCCOD - разбор введённой строки (R3 -> BUF). Возврат через TRAP-приём
; сдвига адреса (ANALIZ: JSR R1,ASCCOD / BR COMAND / BR PRGLIN): 0-пропуск
; => COMAND (директива монитора), 1-пропуск => PRGLIN (строка программы).
; TRAP 110 разбирает ведущий номер строки; если есть - TRAP 111 ищет/вставляет
; запись в таблицу TABTOP (растёт вниз, записи по 3 слова, см. AGAUD). Затем
; TRAP 113 проверяет, не ключевое ли слово монитора (OPRNAM); если нет -
; текст дописывается как строка программы в область TXEND.
ASCCOD::
	MOV	#BUF,R3
	TRAP	110		; разобрать ведущий номер строки (если есть) -> R5
	BR	10$		;БЕЗ НОМЕРА	; номера нет => прямая команда =>
	CALL	CLRCOD
	MOV	R5,CURLIN	; запомнить номер редактируемой строки
	TRAP	111		; найти строку с номером R5 в таблице TABTOP
	BR	5$		; найдена => R4 -> существующая запись =>
	CMPB	@R3,#12		; не найдена: тело строки пустое (только LF)?
	BEQ	7$		; да - нечего сохранять/удалять => выйти =>
	MOV	TABTOP,R0
	MOV	R0,R2
	SUB	#6,R2		; освободить место под новую 3-словную запись
	CMP	R2,TXEND
	BLOS	MEMFUL		; таблица упёрлась в текст программы => ошибка памяти
	MOV	R2,TABTOP	; сдвинуть верх таблицы строк
	MOV	R2,LENT
	MOV	R2,LIMIT
	MOV	R2,CIKL
17$:	MOV	(R0)+,(R2)+	; сдвинуть существующие записи на освободившееся место
	CMP	R0,R4
	BLOS	17$		; пока не дошли до места вставки (R4 от TRAP111) =>
	MOV	R5,@R4		; записать номер новой строки в новую запись
5$:	MOV	R4,R5		; R5 = адрес записи строки (новой или существующей)
10$:	TRAP	112		; пропустить пробелы перед телом строки
; ОПОЗНАНИЕ ОПЕРАТОРА

	CMPB	@R3,#12		; тело строки (после номера) пустое?
	BNE	16$		; нет, есть текст => разобрать как оператор =>
	TST	R5		; да, пусто: номер строки был указан?
	BEQ	7$		; не было (прямой режим, пустой ввод) => ничего не делать =>
	CALL	DEL		; был - строка существовала => удалить её из таблицы
	BR	7$
16$:	MOV	R5,R2
	TRAP	113		; ключевое слово - директива монитора (таблица OPRNAM)?
	.WORD	OPRNAM
	.BYTE	2
	.BYTE	AOPEND-AOPSUB-2
	CLR	R5
25$:	TST	R2		; директива монитора опознана?
	BEQ	8$		; да => выйти с 0-пропуском (это COMAND) =>
	MOV	TXEND,R0	; нет - это строка программы: R0 -> конец области текста
	SUB	R3,@SP
	ADD	R0,@SP
	CMP	@SP,TABTOP
	BHIS	1$		; область текста наехала бы на таблицу строк => ошибка =>
	MOV	R0,-(R2)	; сохранить адрес текста строки в записи таблицы
	MOVB	R5,(R0)+	; ? (служебный байт перед текстом строки)
2$:	MOVB	(R3)+,(R0)	; скопировать текст строки посимвольно
	CMPB	(R0)+,#12	;BUTINA PAGAL 12 DEL LOAD	; до символа LF
	BNE	2$
	MOV	R0,TXEND	; новый конец области текста
	INC	R0
	BIC	#1,R0		; выровнять по слову
	MOV	R0,ENDCOD
7$:	TST	(R1)+		; 1-пропуск: строка программы сохранена, вернуться за следующей
8$:	RTS	R1
;
1$:	MOV	R2,R4
	CALL	DEL
	TRAP	7
;
; DEL - удалить из таблицы строк (TABTOP) 3-словную запись R4, сдвинув
; более ранние записи на 6 байт вверх по памяти (таблица растёт вниз).
DEL:	MOV	R4,R0
DELINT:	TST	(R4)+		; сдвинуть R4 на слово вперёд (к следующей записи)
	CMP	-(R0),-(R0)	; сдвинуть R0 на 2 слова назад
20$:	CMP	R0,TABTOP
	BLOS	21$		; дошли до начала таблицы => готово =>
	MOV	-(R0),-(R4)	; сдвинуть очередное слово более ранней записи вверх
	BR	20$
21$:	MOV	R4,TABTOP	; новая (уменьшенная) вершина таблицы строк
	RETURN
;
; CLRBUF - отвести системный буфер (FCB) и буфер очереди клавиатуры под
; HIMEM, очередь очистить. Закомментированный MAXFIL/SOB - неиспользуемая
; поддержка нескольких буферов (ср. однофайловая сборка в JMP.MAC OPEN).
CLRBUF::MOV	HIMEM,FCB
;	MOV	MAXFIL,R1
;	BEQ	2$
1$:	SUB	#422,FCB	; отвести системный буфер (FCB) под HIMEM
	CLR	@FCB
;	SOB	R1,1$
2$:	MOV	FCB,DFCB	; DFCB = граница системного буфера
	SUB	#400,FCB	; отвести буфер очереди клавиатуры ниже него
	MOV	FCB,FIRST	; очередь клавиатуры пуста: FIRST=LAST=начало буфера
	MOV	FCB,LAST
	RETURN
MEMFUL:	TRAP	7

;
; CLRTXT - команда NEW: сброс буферов, вывод стартового баннера, затем
; CLRTX1 - опустошение таблицы строк (TABTOP=FCB) и текста (TXEND=TEXT).
; PFACT (адрес аргументов текущей DEF FN) тоже сбрасывается.
CLRTXT::CALL	CLRBUF
	MOV	#BASVU,R1	;ВЫВОД НАЧАЛЬНОГО СООБЩЕНИЯ
	MOV	#BASVEND-BASVU,R2
	CALL	ISVEIL
CLRTX1::MOV	FCB,TABTOP	;	опустошить таблицу строк программы
	MOV	#TEXT,TXEND	; опустошить область текста программы
	CLR	PFACT
;
; CLRCOD - сброс состояния скомпилированного кода (перед новым редактированием/
; компиляцией, не трогая уже введённый текст). Опустошает стек кадров FOR/GOSUB
; (LENT/LIMIT/CIKL=TABTOP), выставляет ENDCOD сразу за текстом (выровняв по
; слову), запрещает выполнение (`MOV @PC,ERRS` - самоадрес PC как заведомо не
; равный никакому реальному коду ошибки/флагу - трюк вместо константы), и
; обнуляет STRREG (счётчик скомпилированных строк).
CLRCOD::CALL	WRESET
;	CLR	ONERFL
	MOV	TABTOP,LENT
	MOV	TABTOP,LIMIT
	MOV	TABTOP,CIKL
	MOV	TXEND,ENDCOD
	INC	ENDCOD
	BIC	#1,ENDCOD	; выровнять ENDCOD по слову
	MOV	@PC,ERRS	;ЗАПРЕТИТЬ ВЫПОЛНЕНИЕ РАБОЧЕЙ ПРОГРАММ
	CLR	STRREG
	RETURN
;
; WRESET - откатить векторы прерываний, подменённые программой, по цепочке
; VCTNMB. Формат узла цепочки не выяснен до конца.
WRESET::MOV	R0,-(SP)
	MOV	R1,-(SP)
	MFPS	-(SP)
	MTPS	#340		; запретить прерывания
	CALL	NOSTOP		; запретить обработку CTRL/C
	MOV	#VCTNMB,R0
2$:	MOV	@R0,R0		; R0 = очередной узел цепочки
	BEQ	3$		; цепочка пуста => готово =>
	.BJSR	TSTVCT		; проверить, что вектор действителен
	BCS	1$		; недействителен => ошибка =>
	MOV	@R0,R1
	MOV	-(R1),@R0	; восстановить исходное значение вектора
	TST	-(R1)
	MOV	R1,R0		; перейти к следующему узлу
	BR	2$
3$:	CLR	@#VCTNMB	; цепочка обработана - очистить список
	CALL	STOPEN		; снова разрешить CTRL/C
	MTPS	(SP)+
	MOV	(SP)+,R1
	MOV	(SP)+,R0
	RETURN
1$:	CLR	@#VCTNMB
	TRAP	51.		; ошибка: недействительный вектор

; STRMEM - отвести область строк (FREBEG..FREBEG+STRSIZ) сразу за кодом
; (ENDCOD), требуемого размера STRSIZ; не помещается перед стеком кадров
; (LENT) - ошибка памяти (MEMFUL). ENDCOD и STRREG сдвигаются за неё.
STRMEM::MOV	ENDCOD,R1
	MOV	R1,FREBEG	; начало области строк - сразу за кодом
	ADD	STRSIZ,R1
	MOV	STRSIZ,FRELEN	; размер свободной области строк
	CMP	R1,LENT
	BHI	MEMFUL		; наехала на стек кадров => ошибка памяти =>
	MOV	R1,ENDCOD	; код теперь включает область строк
	MOV	FREBEG,STRREG
NOSTEP:	RETURN
;
; STEP - выполнить один оператор и снова остановиться. Техника "временной
; точки останова": находит адрес следующего оператора (KODTST/HCOR/NEXPAP
; ниже) и подменяет там код переходом на STPEND.
STEP::	TST	LYGIS
	BNE	NOSTEP		; программа не выполняется => не при чем =>

	MOV	R1,CURS
	TST	ERRS
	BNE	1$
	MOV	#STACK,SP
	NEG	TRFLAG
	MOV	ADRHLT,R4
	BNE	TRIN		; уже стояли на останове => найти следующий оператор =>
	CALL	NOSTOP
	MOV	FCB,R4
	TST	(R4)+
	BR	STP2
1$:	TRAP	17.
TRIN::
	CALL	NOSTOP		; запретить CTRL/C на время поиска
	CALL	AGAUD		; найти запись строки, содержащую R4 (текущий адрес)
STP2:	CLR	AUTOON		; выключить AUTO-режим
	CLR	NUMBER		; сбросить текущий номер строки
	CMP	-(R4),-(R4)	; сдвинуть R4 на 4 байта назад (см. AGAUD/DEL)
	JSR	R0,SETST	; зарегистрировать позицию (0/1-сдвиг возврата)
	BR	50$		; 0-сдвиг => продолжить поиск следующего оператора =>
	CALL	STOPEN		; 1-сдвиг => разрешить CTRL/C
	JMP 	STAR		; и вернуться в главный цикл монитора
; 50$..22$ - классифицировать текущий оператор (KODTST): GOTO/GOSUB/RETURN/
; RESTORE => 3$, IF/ON => 4$ (через IFGAUD), иначе обычный оператор. Находит
; целевую строку перехода и ставит на неё останов (REPA/HCOR). Разбор
; операндов через TRAP 110/111 понятен в общих чертах, детали не выяснены.
50$:	CMP	(4)+,(4)+	; пропустить 4 байта (заголовок оператора)
	MOV	R4,R2		; R2 = начало кода оператора
	MOV	R4,R0
	MOV	-(0),R0		; R0 = слово опкода оператора (перед R4)
	JSR	R5,KODTST	; классифицировать опкод
	BR	3$		; GOTO/GOSUB/RETURN/RESTORE =>
	BR	4$		; IF/ON =>
	CMPB	#40,@R0		; обычный оператор: это FOR?
	BNE	21$
	JSR	R5,NEXPAP	; FOR - обработать через NEXPAP (см. ниже)
	MOV	R2,R4
21$:	SUB	#6,R4		; точка останова - сразу после заголовка оператора
	BR	32$
4$:	MOV	R0,R3		; R3 -> текст оператора IF/ON (для поиска номеров строк)
	INC	R3
41$:	CMPB	(3)+,#12	; конец строки текста оператора?
	BEQ	45$		; да - завершить =>
42$:	JSR	R2,IFGAUD	; найти следующий символ-разделитель/номер строки
	BR	45$		; конец =>
	BR	41$		; не найдено - следующий символ =>
	CMP	#4,R5
	BNE	47$
	JSR	R5,NEXPAP	; спецсимвол - через NEXPAP =>
	BR	42$
47$:	CMP	#6,R5
	BEQ	42$
	MOV	R5,R0
48$:	TRAP	110		; разобрать номер строки-цели
	BR	43$
	TRAP	111		; найти её в таблице строк
	BR	44$
	BR	42$
44$:	JSR	R5,HCOR		; поставить точку останова на найденной строке
	TRAP	112		; пропустить пробелы
	CMPB	#',,@R3		; следующий операнд через запятую (ON ... GOTO n1,n2,...)?
	BNE	42$
	INC	R3
	BR	48$
45$:	MOV	R2,R4
	BR	21$
43$:	CMP	#2,R0
	BNE	42$
	JSR	R5,REPA		; строка не найдена - попробовать место возврата GOSUB
	BR	42$
	BR	44$
3$:	CMPB	#74,@R0	;RESTORE
	BEQ	21$		; RESTORE без разбора операнда - точка останова сразу за ним =>
	INC	R0
	MOV	R0,R3
	TRAP	110		; разобрать номер строки-цели (GOTO/GOSUB/RETURN)
	BR	31$
	TRAP	111		; найти её в таблице строк
	BR	32$
	NOP
31$:	JSR	R5,REPA		; не найдена - через REPA (место возврата GOSUB)
	BR	37$
32$:	JSR	R5,HCOR		; найдена - поставить точку останова
37$:	MOV	R2,R4
	MOV	SP,PNTSAV
	CALL	EILUTE
	TST	TRFLAG
	BLE	2$		; трассировка выключена => без скобок =>
	MOVB	#133,R0
	CALL	ISV		; вывести "["
	BIS	#20000,R2
	CALL	ISVEIL
	MOVB	#135,R0
	CALL	ISV		; вывести "]"
	BR	22$
2$:
	MOV	#12,R0
	CALL	ISV		; перевод строки
	CALL	ISVEIL
22$:	MOV	-(4),R4
	CALL	STOPEN		; разрешить CTRL/C
	JMP	VYKDYT		; вернуться в интерпретатор (выполнить один оператор)
;
; REPA - помощник STEP: если есть активный GOSUB, найти его точку возврата
; в таблице строк (AGAUD), чтобы туда тоже можно было поставить останов.
REPA:	TST	(SP)+
	CMP	LENT,LIMIT
	BEQ	1$		; нет активных GOSUB => вернуться как есть =>
	MOV	@LIMIT,R4	; R4 = адрес возврата ближайшего активного GOSUB
	CALL	AGAUD		; найти его запись в таблице строк
	CMP	-(4),-(4)
	TST	(5)+		; 1-сдвиг адреса возврата
1$:	MOV	R5,PC
;
; HCOR - помощник STEP: ставит временную точку останова на строке R4 (если
; она действительна и не равна текущему оператору) - сохраняет исходное
; слово кода на стеке и подменяет его переходом на STPEND.
HCOR:	TST	(SP)+
	JSR	R0,SETST	; проверить/зарегистрировать строку
	BR	2$		; строка действительна => поставить точку останова =>
	BR	1$		; иначе => выйти без установки =>
2$:	CMP	(4)+,(4)+	; пропустить служебные слова записи (см. AGAUD)
	CMP	R4,R2
	BEQ	1$		; цель = текущий оператор => не ставить =>
	CMP	R4,TABTOP
	BLO	1$		; цель вне таблицы строк => не ставить =>
	CMP	-(4),-(4)	; сдвинуть R4 на 4 байта назад
	MOV	@R4,R4		; R4 = реальный адрес кода строки-цели
	MOV	R4,-(SP)	; сохранить адрес для восстановления в STPEND
	MOV	@R4,-(SP)	; сохранить подменяемое слово кода
	INC	NUMBER		; отметить, что точка останова поставлена
	MOV	#STPEND,@R4	; подменить код переходом на STPEND
1$:	MOV	R5,PC
;
; NEXPAP - помощник STEP: поставить точку останова (HCOR) на строке каждого
; активного FOR (стек CIKL..LIMIT). AUTOON временно занят как флаг реентрантности
; и хранилище адреса возврата. Размер кадра FOR (ROL R0/BCS) не выяснен до конца.
NEXPAP:	TST	AUTOON
	BEQ	1$		; не в процессе обхода => начать =>
	RTS	R5		; уже внутри обхода (реентрантный вызов) => просто выйти
1$:	TST	(SP)+
	MOV	R5,AUTOON	; сохранить адрес возврата (и флаг "идёт обход")
	MOV	CIKL,R1		; R1 -> вершина стека кадров
3$:	CMP	R1,LIMIT
	BHIS	2$		; вышли за пределы кадров FOR (дошли до GOSUB) => готово =>
	MOV	2(1),R4		; поле кадра -> адрес строки цикла
	CALL	AGAUD		; найти её запись в таблице строк
	CMP	-(4),-(4)
	JSR	R5,HCOR		; поставить точку останова на этой строке
	MOV	@R1,R0		; слово кадра (флаг/тип?)
	ADD	#10,R1		; перейти к следующему кадру (мин. размер)
	MOV	-(0),R0
	ROL	R0		; проверить бит в слове кадра
;
	BCS	3$		; бит установлен => кадр такого размера =>
	ADD	#14,R1		; иначе кадр больше - доп. смещение
	BR	3$
2$:	MOV	AUTOON,PC	; вернуться по сохранённому адресу
;
; STPEND - сюда попадает выполнение при срабатывании точки останова STEP.
; Снимает все точки останова (SEPAP). При включённой трассировке (TRON) -
; не останавливаться, искать следующую точку (TRIN); иначе - остановиться,
; как при STOP (ADRHLT, вернуться в STAR).
STPEND::
	CALL	NOSTOP
	JSR	R2,SEPAP	; снять все точки останова, восстановить код
	TST	-(R4)		; поправить R4 (сдвинуть на слово назад)
	TST	TRFLAG
	BLE	1$		; трассировка выключена => настоящая остановка =>
	JMP	TRIN		; включена => искать следующую точку останова =>
1$:	MOV	R4,ADRHLT
	NEG	TRFLAG
	CALL	STOPEN
	JMP	STAR

; SEPAP - общий сброс выполнения: снимает точки останова STEP (пары
; адрес/слово из стека, по счётчику NUMBER, до отметки PNTSAV) и сбрасывает
; стек интерпретатора. Вызывается при остановке/завершении программы
; (STOP, END, ошибка, CTRL/C), не только после STEP.
SEPAP::	TST	(SP)+
	INC	ERRS		; временно запретить выполнение
	TST	PNTSAV
	BEQ	5$		; точек останова не было (обычный сброс) =>
	MOV	PNTSAV,SP	; откатить стек к отметке начала сканирования STEP
2$:	DEC	NUMBER
	BLT	5$
	MOV	(SP)+,@(SP)+	; восстановить очередное подменённое слово кода
	BR	2$
5$:	CLR	PNTSAV
	MOV	#STACK,SP	; сбросить стек интерпретатора к началу

	CLR	ERRS		; снова разрешить выполнение
	CLR	NUMBER
	MOV	R2,PC
;
; NEW - команда монитора: проверить конец строки (лишних аргументов нет),
; сбросить стек интерпретатора, закрыть файлы, очистить программу (CLRTXT,
; выводит стартовый баннер) и экран (ISVSS), вернуться в монитор.
NEW::	TRAP	106		; конец оператора (аргументов быть не должно)
	MOV	#STACK,SP	; сбросить стек интерпретатора
	.BJSR	CLOALL		; закрыть все файлы
	CALL	CLRTXT		; очистить программу и таблицу строк

	CALL	ISVSS		; очистить экран

	JMP	MONIT
;
; LLIST/LIST - вывод текста программы (LLIST - на печать, IODEV=-1). LARG
; разбирает необязательный диапазон номеров строк (R4=начало, R0=конец в
; таблице строк; литовский коммент "PIRMAS ARGUMENTAS - R4, ANTRAS - R0" =
; "первый аргумент - R4, второй - R0"). Цикл LS3..8$ собирает и
; печатает каждую строку (EILUTE - как в $SAVE, JMP.MAC), пока R4 не выйдет
; за границу диапазона (@SP). Закомментированный код (LS7/LS8/LS9, литовское
; "PUSLAPIAVIMAS" = "постраничный вывод") - неиспользуемая в этой сборке
; постраничная разбивка листинга (пауза с ожиданием клавиши между страницами).
LLIST::	MOV	#-1,IODEV	; вывод на печать
;
LIST::	MOV	R5,-(SP)
	CALL	LARG		; первый аргумент - R4, второй - R0
;	CLR	-(SP)
	INC	LYGIS		; занять LYGIS на время листинга
	CMP	R4,R0
	BLO	LS66	;PRIE PUSLAPIAVIMO LS6 (к постраничному выводу)	; диапазон пуст => сразу выйти =>
LS1:	MOV	R4,-(SP)	; сохранить начало диапазона
LS2:	MOV	R0,-(SP)	; сохранить конец диапазона
	CALL	CUROFF
;	CLR	-(SP)
LS3:	CALL	EILUTE		; собрать и напечатать текущую строку
;	ADD	R2,@SP
;	CMP	@SP,#1340
;	BGT	LS7
LS4:	MOV	#5000,R2
	MOV	2(R4),CURLIN	; CURLIN = номер текущей строки (из записи таблицы)
	CALL	ISVETO
;11$:	BIT	#37,@SP
;	BEQ	8$
;	INC	@SP
;	BR	11$
8$:	CMP	-(R4),-(R4)	; перейти к следующей записи таблицы строк
	CMP	R4,@SP	;2(SP) PRIE PUSLAPIAVIMO (для постраничного вывода)
	BHIS	LS3		; ещё в пределах диапазона => следующая строка =>
;	TST	IODEV
;	BEQ	LS8
	CLR	IODEV		; сбросить вывод на печать
LS6:	CMP	(SP)+,(SP)+	;TST PRIE  PUSLAPIAVIMO (проверка для постраничного вывода)	; снять со стека границы диапазона
;	BNE	LS6
LS66:	MOV	#5007,@#BUF	; сбросить буфер ввода
	JMP	STAR
;LS7:	TST	IODEV
;	BMI	LS4
;	TST	(R4)+
;LS8:	MOV	R4,@SP
;LS9:	CALL	CURON
;	CALL	IVEIL
;	CMPB	BUF,#12
;	BEQ	3$
;	CLR	LYGIS
;44$:	TST	(SP)+

;	BNE	44$
;	JMP	ANALIZ
;3$:	CMP	(SP),2(SP)
;	BLO	LS9
;	MOV	(SP)+,R4
;	MOV	(SP)+,R0
;	BR	LS1
;LISTBC:	MOV	6(SP),R4
;	BEQ	LS9
;	TST	(SP)+
;	MOV	(SP)+,R0
;	TST	(SP)+
;	BR	LS2
;
; LARG - разбор необязательного диапазона строк "[номер1][-[номер2]]" для
; LIST/LLIST. Возвращает R4=начало, R0=конец диапазона в таблице строк.
LARG:	CLR	-(SP)		;PIRMAS ARGUMENTAS (первый аргумент)
	CALL	ARGUM		;ПРИЗНАК НАЛИЧИЯ ПЕРВОГО АРГУМЕНТА
	BEQ	1$		; первого аргумента нет =>
	INC	(SP)		; отметить: первый аргумент есть (флаг=1)
	TRAP	111		; найти номер строки в таблице
	BR	11$		; найден точно =>
	TST	4(SP)
	BEQ	111$		; таблица строк пуста => ошибка =>
	NEG	(SP)		; не найден точно (взята ближайшая следующая): флаг=-1
11$:	MOV	R4,-(SP)	; (SP)-PIRMOS EILUTES ADRESAS RYSIU LENT. ((SP) - адрес первой строки в таблице)
	CMPB	#'-,(R3)	;AR YRA MINUSAS ? (есть ли дефис-разделитель?)
	BNE	4$		; дефиса нет => один аргумент/без аргумента =>
	INC	R3
	CALL	ARGUM		;ANTRAS ARGUMENTAS (второй аргумент)
	BEQ	3$		; после "-" второго числа нет => до конца (TABTOP) =>
	TRAP	111		; найти второй номер строки
	BR	2$		; найден точно =>
	TST	6(SP)
	BEQ	111$		; таблица строк пуста => ошибка =>
	TST	(R4)+		;ARGUMENTAS NURODYTAS KLAIDINGAI - (аргумент указан неточно -)	; строки нет, взята ближайшая следующая
31$:	CMP	(R4)+,(R4)+	;PASTUMIAM RODYKLE RYSIU LENTELEJE (сдвигаем указатель в таблице)	; выровнять указатель (см. AGAUD)
2$:	MOV	R4,R0		; R0 = конец диапазона
	MOV	(SP)+,R4	; R4 = начало диапазона (сохранённое в 11$)
	TST	(SP)+		; снять флаг первого аргумента
	MOV	(SP)+,(SP)	; вернуть на место R5, сохранённый вызывающим (LIST)
	TRAP	106		; проверить конец оператора (лишних аргументов нет)
	RETURN
111$:	TRAP	8.		; ошибка: аргумент вне программы

1$:	MOV	FCB,R4		;PIRMO ARGUMENTO NERA => JIS = PIRMOS EILUTES (первого аргумента нет => он = первой строки)
	TST	-(R4)		; нет первого аргумента => начало = первая строка программы
	BR	11$
4$:	TST	2(SP)		; проверить флаг первого аргумента
	BGT	2$		; найден точно => диапазон из одной строки =>
	BLT	31$		; не найден точно => выровнять указатель =>
3$:	MOV	TABTOP,R4	; аргументов нет вовсе => конец = TABTOP (весь текст)
	BR	31$
;
; ARGUM - разобрать один аргумент-номер строки (для LARG): "." значит текущая
; строка (CURLIN), иначе - числовой литерал через TRAP 110. Флаг "аргумент
; есть/нет", проверяемый вызывающим (BEQ сразу после CALL ARGUM), судя по
; всему, доносится из TRAP 110 через флаги процессора (RETURN их не меняет) -
; точный механизм не выяснен до конца.
ARGUM:	TRAP	112		; пропустить пробелы
	CMPB	#'.,(R3)	; "." - сокращение для текущей строки?
	BNE	2$
	MOV	CURLIN,R5
	INC	R3

	RETURN
2$:	TRAP	110		; разобрать числовой номер строки -> R5
	CLR	R4
	RETURN
;
; EILUTE - собрать в BUF читаемое представление строки программы (запись R4
; в таблице строк): десятичный номер строки (IUNPCK - см. его определение
; ниже, формирует число в текст) и её текст (используется LIST/$SAVE).
; Первый байт текста - код оператора-заголовка (через AOPNAM, если не 0);
; остальное копируется как есть до конца строки. Какое именно поле записи
; (word0 через `@R4` или `-(R4)`) - номер, а какое - адрес текста, не
; выяснено до конца (см. также IUNPCK - переводит ЧИСЛО в десятичный текст).
EILUTE::
	MOV	@R4,R5		; R5 = поле записи (номер строки?)
	CALL	IUNPCK		; сформировать его как десятичный текст в BUF
	MOV	R5,R3
	MOV	-(R4),R5
	MOVB	(R5)+,R1	; первый байт: код оператора-заголовка строки?
	BEQ	1$		; нет заголовка =>
	MOV	AOPNAM(R1),R1	; имя оператора из таблицы AOPNAM
	MOV	#40,R0
	CALL	INBUF		; вывести имя оператора в BUF
1$:	MOV	R5,R1
	MOV	#12,R0		; до символа LF
	CALL	INBUF		; вывести остаток текста строки в BUF
	MOV	#BUF,R1
	RETURN
;
; STATM - выполнить оператор прямого режима (введённый без номера строки,
; неопознанный как команда монитора). Компилирует его тем же обработчиком,
; что и COMP.MAC (AOPSUB(R5)), в scratch-область сразу за кодом программы
; (ENDCOD), дописывает переход на STAR как терминатор и запускает на
; выполнение (VYK1) - после чего управление само вернётся в монитор.
STATM:	MOV	#400,LYGIS	; отметить: выполняется оператор прямого режима
	TST	STRREG
	BNE	5$
	CALL	STRMEM		; область строк ещё не отведена - отвести
5$:	MOV	ENDCOD,R1	; R1 -> куда компилировать (сразу за кодом программы)
	MOV	#-1,NUMBER
	CALL	@AOPSUB(R5)	; скомпилировать оператор
	MOV	#STAR,(R1)+	; терминатор: после выполнения - назад в монитор
	MOV	ENDCOD,R4	; R4 -> начало скомпилированного оператора
	CMP	R1,CIKL
	BHIS	MEMORY		; скомпилированный код наехал на стек кадров => ошибка =>
	NEG	LYGIS		; отметить "выполняется"
	JMP	VYK1		; выполнить

; MEMORY - нехватка места из STATM (скомпилированный оператор прямого режима
; не поместился до CIKL). Сдвигает TABTOP на 6 байт за раз, пока R1 не
; окажется в пределах (возможно, за счёт отбрасывания записей таблицы строк -
; эффект на целостность программы не выяснен до конца), затем всё равно
; завершает с ошибкой памяти через TXTSV.
MEMORY::
	CLR	LYGIS
2$:	CMP	R1,TABTOP
	BLOS	TXTSV		; в пределах => завершить с ошибкой памяти =>
	ADD	#6,TABTOP	; освободить ещё 6 байт за счёт таблицы строк
	BR	2$

; SET1 - вызывается из SETST, когда R4 указывает на запись в таблице строк
; (R4>=TABTOP), а не прямо на код: проверяет, не REM(050)/'(002)/DATA(0100)
; ли начинается строка (эти операторы, видимо, нельзя использовать как точку
; останова/позицию - весь их текст не является обычным кодом), и если да -
; дополнительно отступает R4 на 4 байта (1$). Точная связь с 0/1-пропуском
; возврата SETST (см. ниже) и итоговый смысл не выяснены до конца.
SET1:
	CMPB	@-(4),#50	;REM
	BEQ	1$		; строка начинается с REM =>
	CMPB	@0(4),#2	;'
	BEQ	1$		; или с "'" (комментарий) =>
	CMPB	@0(4),#100	;DATA
	BNE	SET2		; и не DATA => обычный случай =>
1$:	CMP	-(4),-(4)	; REM/'/DATA => доп. отступ R4 на 4 байта

; SETST - помощник HALT/HCOR/ASCCOD, нормализует позицию R4 (0/1-пропуск
; возврата - тот же TRAP-приём). Если R4 указывает в таблицу строк (>= TABTOP) -
; особая обработка REM/'/DATA (SET1); иначе (SET2) просто отступает на 2 байта.
SETST::
	CMP	R4,TABTOP
	BHIS	SET1		; R4 в таблице строк => спец. обработка =>
	TST	(0)+		; 1-пропуск возврата
SET2:
	TST	-(4)		; отступить R4 на 2 байта назад
	RTS	R0

; TXTSV - отменить компиляцию оператора прямого режима (CLRCOD) и выдать
; ошибку "недостаточно памяти" (TRAP 7).
TXTSV:
	CALL	CLRCOD
	TRAP	7

; VYK2 - возобновить выполнение после останова (CONT/STEP): сбросить
; состояние останова, и если включена трассировка - сразу заново поставить
; точку останова (TRIN), иначе просто продолжить выполнение (VYKDYT).
VYK2::
	CLR	ADRHLT
	CLR	ERRS
	CLR	AUTOON
	CLR	NUMBER
	TST	TRFLAG
	BEQ	VYKDYT		; трассировка выключена => просто продолжить =>
	JMP	TRIN		; включена => заново поставить точку останова =>
; VYKDYT - начать/продолжить обычное (не пошаговое) выполнение: LYGIS=-1
; (программа выполняется). VYK1 - общий вход в интерпретатор (RUN тоже сюда
; попадает): очистить список временных строк (TMPSP) и перейти в шитый код.
VYKDYT::
	CLR	SAVJMP
	MOV	#-1,LYGIS	; отметить: программа выполняется (обычный режим)
	CALL	CUROFF
VYK1:
	CLR	TMPSP		; список временных строк пуст

	JMP	@(R4)+		; войти в шитый код с адреса R4

PRGFUL:	TRAP	17.		; ошибка: нечего продолжать (CAN'T CONTINUE)

; CONT - команда монитора: продолжить программу с точки останова (ADRHLT).
; Если выполнение запрещено (ERRS, напр. после ошибки/редактирования) или
; нет точки останова (ADRHLT=0) - продолжать нечего.
CONT::	TRAP	106		; конец оператора (аргументов быть не должно)
	TST	ERRS
	BNE	PRGFUL		; выполнение запрещено => ошибка =>
	MOV	ADRHLT,R4
	BEQ	KL11		; нет точки останова => в монитор без эффекта =>
	BR	VYK2		; продолжить с ADRHLT =>

; BC - точка входа извне (не вызывается из этого файла, вероятно, из
; обработчика особой клавиши в IO.MAC): отбрасывает часть стека (7 слов) и
; входит в редактирование строки BUF с начала (общий хвост EDIT, см. E4
; ниже). Закомментированный код (LISTBC) - неиспользуемая альтернатива.
; Что именно вызывает BC и когда - не выяснено до конца.
BC::	ADD	#16,SP		; отбросить 7 слов стека
;	TST	LYGIS
;	BGT	1$
	CLR	R2
	MOV	#BUF,R3
	MOV	R3,R1
	BR	E4		; => войти в редактирование строки (см. EDIT)
;1$:	JMP	LISTBC

; DELETE - команда монитора: удалить диапазон строк "[номер1][-[номер2]]".
; LARG разбирает диапазон (R4=начало,R0=конец), CLRCOD сбрасывает
; скомпилированное состояние, DELINT (общий код с DEL) удаляет весь
; диапазон разом, сдвигая таблицу строк.
DELETE::CLR	-(SP)		; доп. слово для проверок LARG (4(SP)/6(SP))
	CALL	LARG		; разобрать диапазон номеров строк
	CALL	CLRCOD
	CALL	DELINT		; удалить диапазон [R4..R0) из таблицы строк
KL11:	JMP	STAR

; EDAUIN - в AUTO-режиме (AUNEXT) подготовить ввод очередной строки с
; вычисленным номером. Если строка с таким номером уже существует - зайти в
; её редактирование как EDIT (E6 - общий код с EDIT). Иначе - подготовить
; пустой буфер BUF для ввода новой строки (общий хвост с EDIT - EDEND).
EDAUIN:	TRAP	111		; найти строку с номером R5 в таблице
	BR	E6		; найдена => редактировать её (см. EDIT) =>
	CALL	IUNPCK		; номер строки (R5) -> десятичный текст в BUF
	CALL	ISVEIL		; вывести приглашение (номер строки)
	MOV	R1,R2
	SUB	#BUF,R2		; R2 = текущая длина введённого (0)
	MOV	R1,R3
	BR	EDEND		; => завершить подготовку ввода (см. EDIT)
;
; EDIT - команда монитора: отредактировать строку (по умолчанию - текущую,
; или указанную числом). Находит её (TRAP 111), собирает читаемый текст в
; BUF (E6, тот же приём, что и EILUTE), затем передаёт готовый BUF в IVEIL для
; интерактивного редактирования, подменив адрес возврата на ANALIZ (EDEND) -
; после правки текст пройдёт через обычный разбор строки, как при вводе
; заново. E4/EDAUIN используют этот же хвост для набора пустой новой строки.
EDIT:	CLR	R2
	MOV	CURLIN,R0	; по умолчанию - текущая строка
	TRAP	110		; разобрать номер строки, если указан

	MOV	R0,R5
E0:	TRAP	106		; конец оператора (лишних аргументов нет)
	TRAP	111		; найти строку с номером R5
	BR	E6		; найдена =>
	TRAP	8.		; не найдена => ошибка
E6:	CALL	IUNPCK		; номер строки (R5) -> десятичный текст в BUF
	MOV	-(R4),R4
	MOV	R5,R3
	MOVB	(R4)+,R1	; первый байт: код оператора-заголовка?
	BEQ	1$
	MOV	AOPNAM(R1),R1	; имя оператора из AOPNAM
	MOV	#40,R0
	CALL	INBUF		; вывести имя оператора в BUF
1$:	MOV	R4,R1
E4:	MOV	#12,R0		; до LF
	CALL	INBUF		; скопировать остаток текста строки в BUF
	MOV	#BUF,R1
	DEC	R3
	DEC	R2
	BEQ	5$
	MOV	R2,R0
	CALL	ISVEIL		; вывести текст строки на экран
	MOV	R0,R2
5$:	MOV	R3,R1
EDEND:	MOV	#ANALIZ,-(SP)	; после редактирования - сразу на разбор строки

	JMP	IVEIL		; редактировать BUF интерактивно

; INBUF - скопировать байты из (R1) в (R3)+ до байта, равного R0, считая
; скопированное в R2.
INBUF:	MOVB	(1),(3)+	; скопировать байт из (R1) в (R3)+
	INC	R2		; посчитать скопированный байт
	CMPB	(1)+,R0		; это был байт-терминатор (R0)? заодно продвинуть R1
	BNE	INBUF		; нет => следующий байт =>
	RETURN

; AUTO - команда монитора: "AUTO [начало][,шаг]" (по умолчанию 10,10).
; Разбирает необязательные начало (R2) и шаг (R5), включает AUTOON (флаг
; через самоадрес PC, как в CLRCOD/ERRS), CURLIN/AUINC = начало/шаг, и
; переходит к вводу первой строки (EDAUIN).
AUTO::	CALL	CURON
	CLR	R2
	CMPB	#',,@R3		; сразу запятая (начало не указано)?
	BEQ	2$
	MOV	#12,R2		; значение по умолчанию (10) на случай отсутствия аргумента
	CALL	ARGUM		; разобрать начальный номер строки
	BEQ	2$		; не указан => оставить по умолчанию =>
	MOV	R5,R2		; указан => R2 = начальный номер
2$:	TRAP	112		; пропустить пробелы
	MOV	#12,R5		; шаг по умолчанию (10)
	CMPB	#',,@R3		; есть "," (указан шаг)?
	BNE	4$		; нет => оставить шаг по умолчанию =>
3$:	MOV	AUINC,R0	; запасное значение - текущий AUINC
	INC	R3		; пропустить ","
	TRAP	110		; разобрать шаг
	MOV	R0,R5
	TST	R5
	BEQ	ILCALL		; шаг = 0 => ошибка =>
4$:	TRAP	106		; конец оператора
	MOV	@PC,AUTOON	; включить AUTO-режим (ненулевой флаг)
	MOV	R2,CURLIN	; текущая строка = начало
	MOV	R5,AUINC	; запомнить шаг
	MOV	R2,R5		; R5 = номер первой строки для ввода
	BR	EDAUIN		; => подготовить ввод первой строки
;

; ISGUNP - преобразовать знаковое целое R5 в десятичную строку в BUFOUT
; (ведущий пробел или "-" для отрицательных), используя I1 (общий код с
; IUNPCK, разбор числа в цифры) для самих цифр.
ISGUNP::MOV	#BUFOUT,R3
	MOVB	#40,(R3)+	; зарезервировать место под знак (пробел по умолчанию)
	TST	R5
	BPL	1$		; число неотрицательное => оставить пробел =>
	MOVB	#'-,-1(R3)	; отрицательное => заменить на "-"
	NEG	R5
1$:	CALL	I1		; перевести |R5| в цифры
	DEC	R1
	INC	R2
	RETURN
;
; IUNPCK/I1 - перевести беззнаковое число R5 в десятичную строку. IUNPCK
; пишет в BUF, I1 - в буфер, на который указывает R3 (у вызывающего). Цифры
; извлекаются старшими разрядами вперёд через удвоение R2 (поиск ближайшей
; сверху степени двойки/проверка кратности 10) и обратное деление вычитанием
; (2$..4$ - двоичный поиск разряда, 3$ - переход к следующему разряду,
; сравнение с #12 (10) отделяет разряды), цифры пишутся в обратном порядке
; во временное поле в конце буфера, затем (6$) копируются на исходное место
; R3. На выходе: R1 = адрес начала результата, R2 = длина строки.
IUNPCK::
	MOV	#BUF,R3
I1::	MOV	R3,-(SP)	; сохранить исходный адрес назначения
	ADD	#5,R3		; R3 -> конец временного поля цифр (6 байт)
	MOVB	#40,(R3)	; терминатор временного поля
1$:	MOV	#5,R2		; начать поиск очередного разряда
	CLR	R1		; R1 = извлечённая цифра
2$:	ASL	R2
	BCS	4$		; переполнение при удвоении => остановиться =>
	CMP	R2,R5
	BLOS	2$		; ещё не больше остатка R5 => удваивать дальше =>
3$:	CMP	R2,#12		; дошли до самого младшего разряда (10)?
	BEQ	5$		; да - цифра готова =>
	CLC
4$:	ROR	R2		; уменьшить пробуемый разряд вдвое
	ASL	R1		; сдвинуть накопленную цифру (двоичный поиск)
	CMP	R2,R5
	BHI	3$		; разряд больше остатка => не подходит =>
	SUB	R2,R5		; вычесть разряд из остатка
	INC	R1		; учесть его в цифре
	BR	3$
5$:	ADD	#60,R5		; остаток (сама цифра 0-9) -> код символа
	MOVB	R5,-(R3)	; записать цифру во временное поле (с конца)
	MOV	R1,R5		; R5 = остаток для следующего (более младшего) разряда
	BNE	1$		; ещё есть разряды => следующий =>
	MOV	@SP,R5		; R5 = исходный адрес назначения
	MOV	R5,R1		; R1 = он же (результат для вызывающего)
	CLR	R2		; R2 = счётчик скопированных цифр
	ADD	#6,@SP		; конец временного поля - для условия цикла копирования
6$:	MOVB	(R3)+,(R5)+	; скопировать цифру на место назначения
	INC	R2
	CMP	R3,@SP
	BNE	6$		; ещё не дошли до конца временного поля =>
	TST	(SP)+
	RETURN
;
; GRBCOL - "сборка мусора": уплотнить разбросанный по памяти текст строк
; программы обратно в один сплошной блок с начала TEXT (после правок/удалений
; текст фрагментирован). Каждый проход (1$) ищет запись с наименьшим ещё не
; обработанным адресом текста (R4 - растущий порог, выбор по возрастанию -
; примитивная O(n^2) сортировка выборкой), переносит её текст в новую
; уплотнённую область и обновляет адрес текста в записи (`MOV R1,@R5`).
; Останавливается, когда очередной проход не находит записей (6$), после чего
; TXEND/ENDCOD выставляются на новый конец текста. Точная раскладка полей
; записи (шаг сканирования -4, а не -6, как при вставке в ASCCOD) не выяснена
; до конца.
GRBCOL::CLR	R4
	MOV	#TEXT,R1	; R1 -> новая уплотнённая область текста
	CALL	NOSTOP
1$:	MOV	#-1,R3		; сентинел "не найдено"
	MOV	FCB,R2
	CMP	-(R2),-(R2)
2$:	CMP	@R2,R4		; поле записи > текущего порога?
	BLOS	3$		; нет => пропустить =>
	MOV	@R2,R3		; да - кандидат (пока наименьший из увиденных)
	MOV	R2,R5		; запомнить адрес этой записи

3$:	CMP	-(R2),-(R2)	; перейти к предыдущей записи
	CMP	R2,TABTOP
	BLO	4$		; дошли до начала таблицы => проход завершён =>
	CMP	-(R2),R3	; поле записи меньше текущего кандидата R3?
	BLO	2$		; да - лучший кандидат => полное сравнение =>
	BR	3$		; нет => пропустить, к следующей записи =>
4$:	CMP	R3,#-1
	BEQ	6$		; в этом проходе ничего не найдено => готово =>
	MOV	R1,@R5		; обновить адрес текста в записи на новый (уплотнённый)
	MOV	R3,R4		; новый порог для следующего прохода
	MOVB	(R3)+,(R1)+	; скопировать первый байт текста строки
5$:	MOVB	(R3)+,@R1	; скопировать байт текста
	CMPB	(R1)+,#12	; это был LF (конец строки)?
	BNE	5$		; нет => следующий байт =>
	BR	1$		; да => следующий проход (следующая строка) =>
6$:	MOV	R1,TXEND	; новый конец текста
	INC	R1
	BIC	#1,R1		; выровнять по слову
	MOV	R1,ENDCOD
	CALL	STOPEN
	RETURN
;
ILCALL:	TRAP	5		; ошибка ILLEGAL FUNCTION CALL

; RENUM - команда монитора: перенумеровать строки программы. Сначала
; уплотняет текст (GRBCOL), затем разбирает необязательные аргументы
; "[новый_начальный][,старый_начальный][,шаг]".
RENUM::	CALL	CLRCOD
	MOV	R3,R0
	CALL	GRBCOL		; уплотнить текст перед перенумерацией
	MOV	R0,R3
	CLR	R2
; Разбор аргументов "[новый_начальный][,старый_начальный][,шаг]" (умолчания
; всюду 10): @SP=новый начальный номер, R2=старый начальный, R0=шаг.
	MOV	#12,R0		; шаг по умолчанию
	MOV	#12,-(SP)	; новый начальный номер по умолчанию
	CMPB	#',,@R3
	BEQ	1$
	CALL	ARGUM		; разобрать новый начальный номер
	BEQ	3$
	MOV	R5,@SP
	TRAP	112
	CMPB	#',,@R3
	BNE	3$
1$:	INC	R3		;2 ARG. TIKRINIMAS (проверка 2-го аргумента)
	TRAP	112
	CMPB	#',,@R3
	BEQ	5$		;2 ARG. PRALEISTAS (2-й аргумент пропущен)
	CALL	ARGUM		; разобрать старый начальный номер
	BEQ	3$
	MOV	R5,R2
	TRAP	112
	CMPB	#',,@R3
	BNE	3$
5$:	INC	R3
	TRAP	110		; разобрать шаг
	BR	3$
	MOV	R5,R0
	BEQ	ILCALL		; шаг = 0 => ошибка =>
3$:	TRAP	106		; конец оператора
;	ARGUMENTAI ISANALIZUOTI (аргументы разобраны)
;	@SP /NEW/,  R2/OLD/,  R0/INC/

; Найти первую переименовываемую строку (номер R2); если её нет - выйти.
	MOV	R2,R5		;НАЙТИ ПЕРВУЮ СТРОКУ
	TRAP	111
	BR	8$
	CMP	R4,TABTOP
	BHIS	8$
	JMP	STAR		;ПЕРВОЙ НЕТ - КОНЕЦ
;---В ТРЕТЬЕМ СЛОВЕ ПОМЕСТИТЬ НОВЫЕ НОМЕРА
; 8$..10$ - пройти все строки от найденной до конца таблицы, записывая в
; третье слово каждой записи её НОВЫЙ номер (@SP, увеличиваемый на шаг R0
; каждый раз), не трогая ещё сам номер строки - для последующего
; переприсвоения ссылок в тексте (ниже) по старым номерам.
8$:	MOV	R4,R2		;ЗАПОМНИТЬ АДРЕС НАЧАЛА
	MOV	R4,R1
	TST	-(R1)
9$:	MOV	@SP,-(R1)	;ТРЕТЬЕ СЛОВО = НОВЫЙ НОМЕР
	MOV	@R1,R5
	TRAP	111
	BR	13$
	BR	14$
13$:	CMP	R4,R2
	BHI	ILCALL		;ТАКАЯ СТРОКА ЕСТЬ ВЫШЕ (уже есть такая строка выше - конфликт номеров)
14$:	CMP	R1,TABTOP
	BLOS	10$		; дошли до конца таблицы => готово =>
	ADD	R0,@SP		; следующий новый номер = текущий + шаг
	BCS	ILCALL		;ПРЕВЫШЕНИЕ 65535 (переполнение)
	CMP	-(R1),-(R1)
	BR	9$
10$:	TST	(SP)+
;---ПЕРЕНУМЕРОВАТЬ ссылки В ТЕКСТЕ
; 38$..23$ - пройти весь текст программы (R1..FCB), для каждого оператора
; классифицировать его KODTST (как в STEP): простые ссылки на номер строки
; (GOTO/GOSUB/RETURN/RESTORE, 12$) разбираются через TRAP 110/RENPAP, ссылки
; внутри текста (IF/ON, 24$, через IFGAUD) - через тот же RENPAP по каждому
; найденному номеру строки, разделённому запятыми (ON...GOTO n1,n2,...).
; RENPAP (ниже) заменяет старый номер строки на новый (из третьего слова
; записи, проставленного выше).
38$:	CMP	R1,FCB
	BEQ	30$		;TEKSTO ANALIZE BAIGTA (разбор текста завершён)
	TST	(R1)+
	MOV	@R1,R0
	JSR	R5,KODTST
	BR	12$		;ПРОСТЫЕ ССЫЛКИ (GOTO И Т.П.)
	BR	24$		;СЛОВНЫЕ ССЫЛКИ (IF/ON)
15$:	CMP	(R1)+,(R1)+	;НЕТ ССЫЛОК - ИДТИ ДАЛЬШЕ (нет ссылок - к следующему оператору)
	BR	38$
12$:	INC	R0
	MOV	R0,R3
	TRAP	110
	BR	15$
	CLR	-(SP)
	CALL	RENPAP		; заменить номер строки на новый
	BR	23$
	BR	23$
24$:	CLR	-(SP)
	MOV	R0,R3
20$:	CMPB	(3)+,#12
	BEQ	23$
22$:	JSR	R2,IFGAUD
	BR	23$
	BR	20$
29$:	MOV	R3,R0
	TRAP	110
	BR	22$
	CALL	RENPAP		; заменить номер строки на новый
	BR	28$
28$:	TRAP	112
	CMPB	#',,@R3
	BNE	22$

	INC	R3
	BR	29$
23$:	CLR	(SP)+
	BR	15$
;---ПЕРЕНУМЕРАЦИЯ В ТАБЛИЦЕ СВЯЗИ
; 30$..37$ - перенести новые номера (третье слово) в поле номера строки, затем
; пузырьковой сортировкой (33$..37$, обмен соседних 3-словных записей)
; восстановить упорядоченность таблицы по номеру строки (шаг мог сделать её
; немонотонной, если строки шли не по порядку).
30$:	TST	(R2)+
31$:	MOV	R2,R0			;SIUNCIAM NEW NR. OF LINE (переносим новый номер строки)
	CMP	-(R2),-(R2)
	MOV	-(R2),-(R0)
	CMP	R2,TABTOP
	BNE	31$
;	SUTVARKOM RL MONOTONISKUMA (восстанавливаем монотонность номеров строк)
;	R0/@MAX EIL NR (R0 -> запись с максимальным номером строки)
	CLR	R3
36$:	MOV	R0,R4
33$:	ADD	#6,R4
	CMP	R4,FCB
	BHI	34$		;BAIGTA (завершено)
35$:	CMP	(R0)+,(R4)+
	BLO	32$
	CMP	R4,FCB
	BEQ	34$
	CMP	-(R0),-(R4)
	MOV	R4,R0
	BR	33$
32$:	TST	R3
	BNE	37$
	MOV	R4,R3
37$:	MOV	-(R4),-(SP)	; поменять местами соседние записи (3 слова)
	MOV	-(R4),-(SP)
	MOV	-(R4),-(SP)
	SUB	#6,R0
	MOV	(R0)+,(R4)+
	MOV	(R0)+,(R4)+
	MOV	(R0)+,(R4)+
	MOV	R0,R4
	SUB	#6,R0
	MOV	(SP)+,(R0)+
	MOV	(SP)+,(R0)+
	MOV	(SP)+,(R0)+
	SUB	#10,R0
	TST	-(R4)
	CMP	R0,TABTOP
	BHI	35$
	MOV	R3,R0
	TST	-(R0)
	CLR	R3
	BR	36$
34$:	JMP	STAR		; готово, вернуться в монитор
RENPAP:	MOV	R2,-(SP)
	MOV	R1,-(SP)
	MOV	R3,-(SP)
	TRAP	112
	SUB	R0,@SP
	INC	@SP		;R3/SK. ILGIS +1/
	TRAP	111
	BR	3$

; Продолжение RENPAP: R4 - найденная (TRAP 111) запись строки-цели ссылки.
; Не найдена => ошибка (TRAP 10). Найдена => переписать старый номер в
; тексте на новый (короче/равно - на месте, длиннее - освободив место).
; Раскладка стекового кадра (2(SP)/4(SP)/6(SP)/10(SP)) не выяснена до конца.
	CMP	R1,R2
	BHI	1$
	MOV	-2(R1),NUMBER	; для сообщения об ошибке - номер строки из соседней записи
	BR	2$
1$:	MOV	2(R1),NUMBER	; для сообщения об ошибке
2$:	MOV	#200,LYGIS	; отметить: разбор в процессе (для ошибки)
	TRAP	10		; ошибка: строка с таким номером не существует
22$:	TST	(SP)+		; отбросить лишнее слово со стека
	BR	21$		; => восстановить регистры и выйти =>
3$:	CMP	R4,R2		; найденная запись за пределами диапазона перенумерации?
	BHI	22$		; да => выйти без замены =>
	MOV	-4(R4),R5	; R5 = новый номер строки (третье слово записи)
	CALL	IUNPCK		; сформировать его как десятичный текст в BUF
	SUB	R2,@SP		; разница длины: старое поле минус длина нового числа
	BLT	8$		; новое число длиннее => нужно освободить место =>
4$:	DEC	R2		; ещё осталось скопировать цифр?
	BEQ	5$		;EIL. NR. SUVESTI (номер строки внесён)
	MOVB	(R1)+,(R0)+	; скопировать цифру нового номера на место старого
	BR	4$		; следующая цифра =>
5$:	DEC	@SP
	BLT	6$
	MOVB	#40,(R0)+	; забить остаток места (короче старого) пробелом
	BR	5$
6$:	MOV	R0,@SP
7$:	MOV	(SP)+,R3
21$:	MOV	(SP)+,R1
	MOV	(SP)+,R2
	CLR	LYGIS
	RTS	PC
8$:	TST	10(SP)
	BNE	13$		; уже пробовали сжимать текст => другой путь =>
	MOV	R0,R4
9$:	CMPB	(R4)+,#12	; найти конец текущей строки (LF)
	BNE	9$
	SUB	@2(SP),R4
	SUB	@SP,R4
	ADD	TXEND,R4	; R4 = во сколько вырастет TXEND, если сдвинуть текст
	CMP	TABTOP,R4
	BHIS	15$		;OK (места достаточно)
	SUB	TXEND,R4		;NE OK (не хватает)
	MOV	R4,-(SP)
	MOV	R3,-(SP)
	CALL	GRBCOL		; уплотнить текст программы, чтобы найти место
	MOV	(SP)+,R3
	MOV	(SP)+,R4
	ADD	TXEND,R4
	CMP	TABTOP,R4
	BHI	15$		;GERAI (хорошо, теперь хватает)
10$:	CMP	2(SP),4(SP)
	BHI	11$
	MOV	-2(R1),NUMBER	; для сообщения об ошибке
	BR	12$
11$:	MOV	2(R1),NUMBER
12$:	MOV	#200,LYGIS
	TRAP	7		; ошибка: недостаточно памяти
	ADD	#2,6(SP)
	BR	22$

; 13$..20$ - вставить более длинный номер строки: 13$/14$ сдвигает остаток
; текста программы, открывая зазор в R0; 15$/16$ (места и так хватало)
; переносит хвост строки в TXEND. Оба сходятся в 17$: копируют цифры нового
; номера (BUF) на освободившееся место, дописывают хвост (20$), обновляют
; TXEND. Обмен регистров между путями на стыке (17$) не выяснен до конца.
13$:	MOV	@SP,R2
	NEG	R2		; R2 = недостающее количество байт
	ADD	TXEND,R2
	CMP	TABTOP,R2
	BLO	10$		;NETILPS (не влезает, даже после GRBCOL) => ошибка =>
	MOV	TXEND,R4
14$:	MOVB	-(R4),-(R2)	; сдвинуть остаток текста программы, открывая зазор
	CMP	R4,R0
	BNE	14$
	MOV	R0,R1
	SUB	@SP,R1
	BR	17$
15$:	MOV	@2(SP),R1	; R1 -> начало хвоста этой строки (после старого номера)
	MOV	TXEND,R4
	MOV	R4,@2(SP)
16$:	MOVB	(R1)+,(R4)+	; перенести хвост строки в конец текста
	CMP	R1,R0
	BNE	16$
17$:	MOV	#BUF,R2		; R2 -> цифры нового номера (сформированы IUNPCK выше)
18$:	CMPB	@R2,#40		; конец числа (пробел-разделитель)?
	BEQ	19$
	MOVB	(R2)+,(R4)+	; скопировать цифру нового номера в освободившееся место
	INC	R1
	BR	18$
19$:	ADD	@SP,R1
	MOV	R4,@SP
20$:	MOVB	@R1,(R4)+	; дописать остаток текста строки
	CMPB	(R1)+,#12	; до LF
	BNE	20$
	MOV	R4,TXEND	; новый конец текста
	INC	10(SP)		; отметить "уже пробовали освобождать место" (см. 8$)
	BR	7$
;
; KODTST - классифицировать опкод оператора @R0 (JSR R5,KODTST, возврат по
; 0/1/2-пропуску R5, как в STEP/RENUM): GOSUB/GOTO/RETURN/RESTORE => 0-пропуск
; (простые ссылки); IF/ON => 1-пропуск (словные ссылки); иначе => 2-пропуск
; (обычный оператор).
KODTST::CMPB	#20,@R0		;GOSUB
	BEQ	12$
	CMPB	#22,@R0		;GOTO
	BEQ	12$
	CMPB	#52,@R0		;RETURN
	BEQ	12$
	CMPB	#74,@R0		;RESTORE
	BEQ	12$		; одна из четырёх => 0-пропуск =>
	TST	(5)+		; иначе 1-й пропуск (на случай IF/ON)
	CMPB	#24,@R0		;IF
	BEQ	12$
	CMPB	#72,@R0		;ON
	BEQ	12$		; IF/ON => итог 1-пропуск =>
	TST	(5)+		; иначе ещё пропуск (итог 2-пропуск)
12$:	RTS	R5
;
; IFGAUD - найти в тексте оператора (R3) следующий номер строки-ссылки,
; пропуская строковые литералы (кавычки) и распознавая зарезервированные
; слова (TRAP 113/RWREN, видимо ключевые слова типа THEN/ELSE). Возврат по
; 0/1-пропуску R2 (JSR R2,IFGAUD): 0-пропуск - конец/останов, 1-пропуск -
; продолжить сканирование со следующего символа.
IFGAUD::TRAP	102		; классифицировать символ @R3 (буква/цифра/иначе)
	BR	25$		; цифра =>
	BR	21$		;RAIDE (буква) =>
	BR	20$		; иначе (пропустить символ) =>
25$:	CMPB	@R3,#47		; символ - "'" (комментарий)?
	BEQ	23$		; да => конец сканирования =>
	CMPB	@R3,#42		; символ - kавычка (строковый литерал)?
	BNE	20$		; нет => пропустить символ =>

26$:	INC	R3		; да => дойти до закрывающей кавычки или LF
	CMPB	@R3,#12
	BEQ	23$		; строка не закрыта (конец текста) => остановиться =>
	CMPB	@R3,#42
	BNE	26$
	BR	20$		; кавычка закрыта => пропустить строку, продолжить =>
21$:	TRAP	113		; слово - зарезервированное (таблица RWREN)?
	.WORD	RWREN
	.BYTE	2
	.BYTE	16
	BR	20$		; нет => пропустить слово, продолжить =>
	TST	R5		; да - зарезервированное: есть ли что искать дальше?
	BEQ	23$		; нет => остановиться =>
	TST	(2)+		; есть => 1-й пропуск (продолжить)
20$:	TST	(2)+		; пропустить символ и продолжить (1-пропуск)
23$:	RTS	R2
;
;
;MAXFL:	CMPB	(R3)+,#'=
