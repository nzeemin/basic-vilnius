	.INCLUDE /GENUKD.MAC/
	.SBTTL	EXECUTION MINIMAL
	.ENABLE	LC

	.MACRO	.BJSR	ADR
	.IF EQ,MASINA-BK0011
		MOV	#PAG2,-(SP)
		MOV	#ADR,-(SP)
		.BJSR0
	.IFF
		CALL	ADR
	.ENDC
	.ENDM

	.GLOBL	BRKO,CLOALL,FNDBUF,FILINP,ISV,TMPSP,NEWTMP
	.GLOBL	TXEND,LYGIS,STRREG,STRSIZ,CURON,CUROFF,STACK
	.GLOBL	TRFLAG,TRIN,LIMIT,SAVJMP
	.GLOBL	ADRHLT,STAR,ENDCOD,LENT,CIKL,IVEIL
	.GLOBL	ISVTO,ISVETO,FCB,EGO,ISGUNP
	.GLOBL	NAMEW,NAMER,RD.,WR.,FR.,ADRR,ADRW,LENW,FER.
	.GLOBL	BUF,TABTOP,BUFOUT,FREBEG,FRELEN,NUMBER
	.GLOBL	DATINP,DATPTR,IODEV,MAG				;MAXFIL
	.GLOBL	WRITE,COPOUT,CISLO,TSTFRE
	.GLOBL	EILUTE,LRUN,CLRTX1,ASCCOD,TEXT,ERRS,GRBCOL
	.GLOBL	CLRBUF,CLRCOD,LPTPOS,PFACT			;SIGNAL
	.GLOBL	VCTNMB						;ONERFL

	.GLOBL	CSCR,RSCR

	.GLOBL	ENDPRG

	.GLOBL	ADR,RI,IR

	.GLOBL	RT11,SYSPTR
	.GLOBL	MAGNIT

	.GLOBL	TABX,TABY,INBF0
	.GLOBL	NIM,LN,LL,EBUF,CURS,LOK
	.GLOBL	SETWDT,MIDLE
	.GLOBL	CRTGRP

;---------------------------------------------
; ICMP – сравнение двух 16-битных целых на стеке.
; Снимает два слова, вычитает второе из первого, флаги для условного перехода.
ICMP::	SUB	(SP)+,(SP)+	; (первое) - (второе), оба удаляются
	JMP	@(R4)+		; возврат, флаги установлены

; NEXCMP – подготовка к сравнению вещественных чисел в цикле.
; Сохраняет текущие значения стека в буфер, затем помещает параметры для SCMP.
NEXCMP::MOV	CIKL,R1		; адрес структуры цикла
	MOV	(R1)+,R0	; адрес буфера
	MOV	SP,R2		; текущий стек
	MOV	(R2)+,(R0)+	; скопировать два слова в буфер
	MOV	(R2),(R0)+
NCMP:	TST	(R1)+		; пропустить слово (счётчик?)
	MOV	(R1)+,-(SP)	; поместить два слова (параметры сравнения) на стек
	MOV	(R1)+,-(SP)
; затем падение в SCMP

; SCMP – сравнение двух чисел float на стеке.
; Вход: на стеке два числа (по два слова): старшее1, младшее1, старшее2, младшее2.
; Результат: R0 = 0 (равны), >0 (первое больше), <0 (первое меньше).
SCMP::	MOV	@PC,R0		; загрузить константу (обычно 0)
	MOV	4(SP),R1	; старшее слово первого числа
	BGE	1$		; положительное -> 1$
	ASL	R0		; отрицательное – установить младший бит R0
	MOV	(SP)+,R2	; снять адрес возврата (или младшее слово?)
	BLT	2$
	BR	4$
1$:	MOV	(SP)+,R2	; снять адрес возврата
	BLT	5$
2$:	CMP	R1,R2		; сравнить старшие слова
	BNE	3$
	CMP	4(SP),@SP	; сравнить младшие слова
	BNE	3$
	CLR	R0		; равны
3$:	ROR	R0		; знак в старший бит
	BCS	5$
4$:	NEG	R0		; отрицательный результат
5$:	ADD	#6,SP		; очистить стек (удалить числа)
	TST	R0
	JMP	@(R4)+		; возврат

; $CMP – сравнение двух строк.
; Вход: на стеке (длина1, адрес1, длина2, адрес2).
; Результат: R2 = 0 (равны), >0 (первая больше), <0 (первая меньше).
$CMP::	CALL	CLRTMP		; инициализация временной области
	MOV	(SP)+,R2	; длина первой строки
	MOV	(SP)+,R3	; адрес первой строки
	CALL	CLRTMP
	MOV	(SP)+,R1	; длина второй строки
	MOV	(SP)+,R0	; адрес второй строки
	SUB	R1,R2		; разница длин
	BPL	1$
	ADD	R2,R1		; выравнивание длин
1$:	DEC	R1		; счётчик
	BMI	2$
	CMPB	(R0)+,(R3)+	; побайтовое сравнение
	BEQ	1$
	JMP	@(R4)+		; возврат (флаги установлены)
2$:	NEG	R2		; строки равны – вернуть отрицательную разницу длин
	JMP	@(R4)+

;
SUM2::	.WORD	0
;
EQ::	BEQ	TRUE
FALSE::	CLR	-(SP)
	JMP	@(R4)+
;
NE::	BNE	TRUE
	BR	FALSE
;
LE::	BLE	TRUE
	BR	FALSE
;
GE::	BGE	TRUE
	BR	FALSE
;
LT::	BLT	TRUE
	BR	FALSE
;
GT::	BLE	FALSE
TRUE::	MOV	#-1,-(SP)
	JMP	@(R4)+

;----------------------------------------
IFT::	TST	(SP)+
	BNE	JMP
	BR	NJMP
;
IFF::	TST	(SP)+
	BEQ	JMP
	BR	NJMP

;
; NEXJMP - завершение шага цикла FOR (вещественный счётчик): проверяет,
; вышел ли счётчик за предел, и либо прыгает назад к телу цикла (R4 = адрес
; из блока цикла), либо снимает блок цикла с CIKL и продолжает выполнение
; после цикла (R4 не трогается - уже указывает на следующую по тексту
; инструкцию). R0 на входе - результат сравнения счётчика с пределом
; (от SCMP, см. NEXCMP), знак шага - в блоке цикла по смещению 12.
NEXJMP::
	MFPS	R2		; сохранить регистр состояния процессора
	MTPS	#340		; поднять приоритет (запретить прерывания на время проверки)
	MOV	CIKL,R1		; R1 = блок текущего цикла		;---STOP---
	TST	12(R1)		; шаг отрицательный (счёт вниз)?
	BMI	2$		; да =>
	TST	R0		; шаг положительный - счётчик больше предела?
	BGT	3$		; да - цикл закончен =>
1$:
	MOV	2(R1),R4	; цикл продолжается - R4 = адрес возврата к телу цикла
	BR	4$		;-------+22
2$:
	TST	R0		; шаг отрицательный - счётчик всё ещё >= предела?
	BGE	1$		; да - цикл продолжается =>
3$:	ADD	#14,CIKL	; цикл закончен - снять блок цикла (переход к внешнему)
4$:
	MTPS	R2		; восстановить регистр состояния процессора
	JMP	@(R4)+		; перейти к следующей инструкции (диспетчер шитого кода)

; JSR - оператор GOSUB. Заводит новый кадр возврата на том же стеке
; кадров, что используют циклы FOR (CIKL/LIMIT - связный список кадров,
; растущий вниз к ENDCOD): в кадре - ссылка на предыдущий LIMIT (для RTS/
; RTSTO при выходе) и адрес возврата (следующая инструкция после JSR).
; Затем проваливается в JMP - переход по адресу, записанному в коде сразу
; после опкода JSR (адрес вызываемой строки/подпрограммы).
JSR::
	MFPS	R1		; сохранить регистр состояния процессора
	MTPS	#340		; запретить прерывания
	MOV	CIKL,R0		; R0 = вершина стека кадров
	TST	-(R0)		; освободить слово под ссылку на предыдущий LIMIT
	CMP	R0,ENDCOD	; переполнение стека (кадры уткнулись в код программы)?
	BLOS	STCKER		; да - ошибка =>
	MOV	LIMIT,@R0	; сохранить старый LIMIT (для возврата)
	MOV	R4,-(R0)	; сохранить адрес возврата (после JSR)
	MOV	R0,LIMIT	; LIMIT = новый кадр
SUB:	MOV	R0,CIKL		; CIKL = новый кадр (тот же, что и LIMIT)
	MTPS	R1		; восстановить регистр состояния процессора
; JMP - оператор GOTO (и общий хвост JSR/RTSTO: перейти по адресу из кода).
JMP::
	MOV	@R4,R4		; R4 = адрес перехода (операнд сразу после опкода)	;---STOP---
	JMP	@(R4)+		; перейти (диспетчер шитого кода)		;--------+2

; RTSTO - RETURN <номер строки>: снять кадр GOSUB/FOR, но не возвращаться
; по сохранённому адресу, а перейти по номеру строки (как JMP - см. COMP.MAC RET::).
RTSTO::
	MFPS	R1
	MTPS	#340
	MOV	LIMIT,R0	; R0 = текущий кадр
	CMP	R0,LENT		; кадров не осталось (RETURN без GOSUB)?
	BHIS	RETERR		; да - ошибка =>
	TST	(R0)+		; пропустить сохранённый адрес возврата (не нужен)
	MOV	(R0)+,LIMIT	; восстановить LIMIT из кадра (снять кадр)
	BR	SUB		; => CIKL=R0, и в JMP - перейти по номеру строки
RETERR:
	TRAP	3		; ошибка "RETURN без GOSUB"

; RTS - обычный RETURN: снять кадр и перейти на сохранённый адрес возврата.
RTS::
	MFPS	R1

	MTPS	#340
	MOV	LIMIT,R0	; R0 = текущий кадр		;---STOP---
	CMP	R0,LENT		; кадров не осталось (RETURN без GOSUB)?
	BHIS	RETERR		; да - ошибка =>
	MOV	(R0)+,R4	; R4 = сохранённый адрес возврата
	MOV	(R0)+,LIMIT	; восстановить LIMIT (снять кадр)		;-------+14
	MOV	R0,CIKL
	MTPS	R1
; NJMP - пропустить одно инлайн-слово в коде и перейти дальше (используется
; здесь для RETURN, и в IFT/IFF - при ложном условии, чтобы пропустить цель).
NJMP:
	TST	(R4)+
	JMP	@(R4)+		;-------+26
;
; ONJMP - оператор ON выражение GOTO строка,строка,... (см. COMP.MAC/ON::).
; R0 (со стека) - значение выражения (1-based индекс). Список целей и их
; количество записаны в коде сразу после опкода (см. также ONJSR).
ONJMP::	MOV	(SP)+,R0	; R0 = значение выражения-селектора
	BEQ	ONSKIP		; 0 - не переходить никуда (просто продолжить) =>
	BIT	#177400,R0	; отрицательное или слишком большое?
	BNE	ONERR		; да - ошибка =>
	CMP	R0,@R4		; в пределах числа целей (записано в коде)?
	BLE	JUMP		; да - перейти на нужную цель =>
ONSKIP:
	MOV	(R4)+,R0	; вне диапазона - R0 = число целей, пропустить их все
	ASL	R0
	ADD	R0,R4
	JMP	@(R4)+		; продолжить после списка целей
ONERR:
	TRAP	5		; ошибка - недопустимое значение выражения ON

; ONJSR - оператор ON выражение GOSUB строка,строка,... Как ONJMP, но перед
; переходом заводит кадр возврата (как JSR) с адресом сразу после списка
; целей - GOSUB-выбор одной из нескольких строк.
ONJSR::
	MOV	(SP)+,R0	; R0 = значение выражения-селектора
	BEQ	ONSKIP		; 0 - никуда не переходить =>
	BIT	#177400,R0	; отрицательное или слишком большое?
	BNE	ONERR		; да - ошибка =>
	CMP	R0,@R4		; в пределах числа целей?
	BGT	ONSKIP		; нет - вне диапазона, просто продолжить =>
	MOV	@R4,R1		; R1 = число целей
	ASL	R1
	ADD	R4,R1		; R1 = адрес сразу после списка целей (адрес возврата)
	MFPS	R3		; сохранить регистр состояния процессора
	MTPS	#340		; запретить прерывания
	MOV	CIKL,R2		; завести кадр возврата (как в JSR)
	TST	-(R2)
	CMP	R2,ENDCOD	; переполнение стека кадров?
	BLOS	STCKER		; да - ошибка =>
	MOV	LIMIT,@R2	; сохранить старый LIMIT
	MOV	R1,-(R2)	; сохранить адрес возврата (после списка целей)
	MOV	R2,CIKL
	MOV	R2,LIMIT
	MTPS	R3		; восстановить регистр состояния процессора
; JUMP - общий хвост ONJMP/ONJSR: R0 - индекс выбранной цели (1-based),
; сдвинуть R4 к её слову в списке и передать в JMP (там @R4,R4 её прочитает).
JUMP:
	ASL	R0
	ADD	R0,R4
	BR	JMP
STCKER:
	TRAP	7		; ошибка - переполнение стека кадров (FOR/GOSUB)

; SFNRET/IFNRET - возврат из DEF FN: строковый результат (2 слова - длина
; и адрес) / числовой результат (1 слово). Снимают кадр параметров функции
; (PFACT - см. TRAP 121/DEF FN в TRAP.MAC), сдвигают значение результата на
; освободившееся место в стеке и возвращаются к вызвавшему коду.
SFNRET::MOV	#2,R1		; результат - 2 слова (строка: длина+адрес)
	BR	RETFN

;
IFNRET::MOV	#1,R1		; результат - 1 слово (число)
;
RETFN:	MOV	PFACT,R0	; R0 = кадр параметров текущего вызова DEF FN
;
; Подрезать список временных строк (TMPSP) до границы этого вызова -
; временные строки, созданные внутри функции, больше не нужны. Список
; хранится компактно (упакованный адрес записи в байте); идём по записям,
; пока их адрес не окажется ниже R0 (границы кадра функции), и обрезаем
; список на этом месте.
	MOV	#TMPSP,R3
11$:	MOVB	1(3),R3		; следующая запись списка (упакованный адрес, байт)
	BEQ	12$		; конец списка =>
	BIC	#177400,R3	; убрать мусор в старших битах байта
	ASR	R3		; распаковать в настоящий адрес записи
	CMP	R3,R0		; эта запись внутри текущего вызова функции (>= R0)?
	BLO	11$		; нет, ещё старее - продолжить =>
	ASL	R3		; да - упаковать обратно
12$:	MOVB	R3,TMPSP+1	; обрезать список на этой записи
;
	MOV	(R0)+,PFACT	; восстановить PFACT вызывающего (снять кадр)
	MOV	R1,R2
	ASL	R2
	ADD	SP,R2		; R2 = адрес результата на стеке (перед снятыми параметрами)
1$:	MOV	-(2),-(0)	; сдвинуть слова результата на место параметров
	SOB	R1,1$
	MOV	R0,SP		; SP = после результата - параметры/локальные сняты
	MOV	@R4,R0		; R0 = сохранённый контекст вызова (см. FNCALL/FNST)
	MOV	@R0,R4		; восстановить R4 - продолжить с места вызова функции
	BIT	#20000,-4(0)	; результат - новая строка, требующая регистрации?
	BEQ	2$
	JMP	NEWTMP		; да - зарегистрировать как временную и продолжить
2$:	JMP	@(4)+		; продолжить (диспетчер шитого кода)
;
; DFN - опкод, которым начинается тело DEF FN в основном потоке кода
; (см. COMP.MAC DEF::). При обычном, "сквозном" выполнении программы (не
; через вызов функции) нужно перепрыгнуть через тело функции, попутно
; регистрируя, где оно начинается, чтобы FNCALL мог его найти.
DFN::	MOV	(4)+,R0		; R0 = адрес продолжения программы (после тела функции)
	MOV	(4)+,R1		; R1 = адрес ячейки переменной-функции в таблице переменных
	MOV	R4,@R1		; записать туда адрес начала тела функции (сразу за этими операндами)
	MOV	R0,R4		; перепрыгнуть через тело функции
	JMP	@(4)+		; продолжить (диспетчер шитого кода)
;
; FNST - подготовка вызова DEF FN (см. USR:: в TRAP.MAC): запомнить текущий
; PFACT (для вложенных/повторных вызовов) и место в стеке, где он сохранён,
; - FNCALL восстановит его оттуда после разбора аргументов.
FNST::	MOV	PFACT,-(SP)	; сохранить PFACT вызывающего уровня
	MOV	SP,PFACT+2	; запомнить, где именно он сохранён на стеке
	JMP	@(4)+		; продолжить (диспетчер шитого кода)
;
; FNCALL - собственно вызов DEF FN (см. COMP.MAC USR::/7$). В коде сразу
; после опкода: адрес ячейки переменной-функции, затем список типов
; переданных аргументов. Тело функции (записанное DFN::) начинается со
; своего списка типов формальных параметров - они должны совпасть.
FNCALL::MOV	(4)+,R0		; R0 = адрес ячейки переменной-функции
	MOV	(0)+,R2		; R2 = адрес тела функции (записан туда через DFN::)
	BEQ	2$		; тело не зарегистрировано (DEF FN не выполнялся) =>
	MOV	@R4,R1		; R1 = число переданных аргументов
	INC	R1
1$:	CMP	(4)+,(2)+	; тип переданного аргумента = тип формального параметра?
	BNE	3$		; нет - ошибка =>
	SOB	R1,1$		; да - проверить следующий
	MOV	R4,@R0		; запомнить место возврата (после списков типов)
	MOV	R2,R4		; перейти к исполняемому телу функции (после списка параметров)
	MOV	PFACT+2,PFACT	; PFACT = адрес аргументов на стеке (см. FNST) - для $PAR/SPAR/IPAR
	JMP	@(4)+		; выполнить тело функции
2$:	TRAP	18.		; ошибка - функция не определена (нет DEF FN)
3$:	TRAP	5		; ошибка - несоответствие типов аргументов

;-----------------------------------------
; Обращение к параметру DEF FN внутри тела функции (см. PARMOV/TRAP 121 в
; TRAP.MAC). PFACT - адрес аргументов текущего вызова на стеке (см. FNCALL).
; В коде сразу после опкода - смещение нужного параметра от PFACT.
;
; APAR - строковый параметр: нужен его АДРЕС (как у обычной строковой
; переменной), а не значение - оставить на стеке PFACT-смещение.
APAR::	MOV	PFACT,-(SP)	; положить PFACT на стек
	SUB	(4)+,@SP	; вычесть смещение - адрес параметра
	JMP	@(4)+		; продолжить (диспетчер шитого кода)

;
; SPAR/IPAR - числовой параметр (вещественный/целый): скопировать его
; значение (2 или 1 слово) на стек выражения.
SPAR::	MOV	#2,R1		; вещественное - 2 слова
	BR	PARAM
;
IPAR::	MOV	#1,R1		; целое - 1 слово
;
PARAM:	MOV	PFACT,R0	; R0 = адрес аргументов текущего вызова
	SUB	(4)+,R0		; R0 -= смещение - адрес значения параметра
1$:	MOV	-(0),-(SP)	; скопировать слово значения на стек выражения
	SOB	R1,1$
	JMP	@(4)+		; продолжить (диспетчер шитого кода)
;
; SCONST - вещественная константа: в коде сразу после опкода - два слова
; числа (см. OPER/TRAP.MAC), оба переносятся на стек выражения (падает в ICONST).
; ICONST - целая константа: одно слово значения на стек.
SCONST::MOV	(R4)+,-(SP)	; переложить старшее слово вещественного числа
ICONST::MOV	(R4)+,-(SP)	; переложить значение (целое) или младшее слово (вещественное)
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
;
; Чтение значения переменной на стек выражения (см. AKINPP/AXKINP в T103,
; COMP.MAC). S* - вещественная (2 слова), I* - целая (1 слово); *VAR - адрес
; берётся из кода (простая переменная), *XVAR - адрес уже на стеке
; (вычислен опкодом индексации ARRAY/ARR10 для элемента массива).
;
; SXVAR - вещественный элемент массива: адрес со стека, затем как SVAR1.
SXVAR::	MOV	(SP)+,R1	; R1 = адрес значения (со стека)
	BR	SVAR1
;
; SVAR - простая вещественная переменная: адрес из кода.
SVAR::	MOV	(R4)+,R1	; R1 = адрес значения (из кода)
SVAR1:	MOV	2(R1),-(SP)	; переложить старшее слово числа
	MOV	@R1,-(SP)	; переложить младшее слово числа
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
;
; IXVAR - целый элемент массива: адрес со стека, значение - одно слово.
IXVAR::	MOV	@(SP)+,-(SP)	; снять адрес, положить значение по этому адресу
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
;
; IVAR - простая целая переменная: адрес из кода, значение - одно слово.
IVAR::	MOV	@(R4)+,-(SP)	; значение по адресу из кода
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
;
; Опкоды присваивания LET (см. AMOV в COMP.MAC): $* - строка, S* - вещественное
; (2 слова), I* - целое (1 слово); *MOV - адрес цели из кода (простая
; переменная), *XMOV - адрес цели со стека (элемент массива, уже вычислен).
;
; $XMOV - строка в элемент массива: записать новый дескриптор строки
; (длина - байт, адрес - 2 байта) по вычисленному адресу элемента.
$XMOV::	CLR	TMPSP		; сбросить список временных строк
	MOV	(SP)+,R0	; R0 = длина новой строки
	MOV	(SP)+,R1	; R1 = адрес новой строки
	MOV	(SP)+,R2	; R2 = адрес дескриптора элемента массива (цель)
	MOVB	R0,(R2)+	; записать длину (байт)
	MOVB	R1,(R2)+	; записать младший байт адреса
	SWAB	R1
	MOVB	R1,(R2)+	; записать старший байт адреса
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
;
; SXMOV - вещественное в элемент массива: адрес цели - третье слово на
; стеке (под значением), само значение (2 слова) - выше.
SXMOV::	MOV	4(SP),R1	; R1 = адрес цели (не снимая пока со стека)
XMOV::	MOV	(SP)+,(R1)+	; переложить первое слово значения по адресу
	MOV	(SP)+,@R1	; переложить второе слово значения
SPJ:	TST	(SP)+		; снять теперь ненужный адрес цели со стека
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
;
;
; IXMOV - целое в элемент массива: значение и адрес цели - по одному слову
; на стеке (значение сверху, адрес под ним).
IXMOV::	MOV	(SP)+,@(SP)+	; снять значение и адрес, записать по адресу
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
;
; $MOV - строка в простую переменную: адрес из кода, как SMOV/MOVS
; (перезаписывает 3-байтный дескриптор целиком, как обычное 2-словное значение).
$MOV::	CALL	CLRTSP		; сбросить учёт временных строк перед перезаписью
SMOV::	MOV	(R4)+,R1	; R1 = адрес цели (простая переменная, из кода)
MOVS:	MOV	(SP)+,(R1)+	; переложить первое слово значения
	MOV	(SP)+,@R1	; переложить второе слово значения
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
;
; IMOV - целое в простую переменную: адрес из кода, значение - одно слово.
IMOV::	MOV	(SP)+,@(R4)+
	JMP	@(R4)+
;
; MIDMOV - присваивание LET MID$(строка,поз[,длина])=выражение (см. LMID/
; STR/STR2 в TRAP.MAC, COMP.MAC LET). Копирует min(длина_нового_текста,
; ограничение_длины_MID$) байт из правой части в целевую строку начиная с
; заданной позиции, не меняя общую длину/адрес целевой строки.
MIDMOV::CALL	CLRTSP		; сбросить учёт временных строк
	MOV	(SP)+,R3	; R3 = длина новой (правой части) строки
	MOV	(SP)+,R2	; R2 = адрес новой строки
	CLR	R1
	BISB	(SP)+,R1	; R1 = ограничение длины из MID$(...,длина)
	MOV	(SP)+,R0	; R0 = адрес назначения (позиция внутри целевой строки)
	CMP	R3,R1		; новая строка длиннее ограничения MID$?
	BLE	1$		; нет =>
	MOV	R1,R3		; да - скопировать не больше ограничения
1$:	DEC	R3
	BMI	3$		; скопировано нужное число байт =>
	MOVB	(R2)+,(R0)+	; скопировать очередной байт
	BR	1$
3$:	JMP	@(R4)+		; продолжить (диспетчер шитого кода)

;----------------------------------------------
; FORSNG/FORINT - вход в цикл FOR (см. COMP.MAC FOR::/AFOR): заводит блок
; цикла на том же стеке кадров, что JSR (CIKL, растёт вниз к ENDCOD). Блок
; хранит шаг, предел и служебные слова из кода (адрес возврата к телу цикла
; и признак знака шага - см. их использование в NEXJMP/NEXCMP). FORSNG
; дополнительно снимает со стека шаг (вещественный, 2 слова) перед общей
; частью FORMOV; у FORINT шаг/предел укладываются в те же 2 слова FORMOV.
FORSNG::
	MFPS	R3		; сохранить регистр состояния процессора
	MTPS	#340		; запретить прерывания
	MOV	CIKL,R0		; R0 = вершина стека кадров
	MOV	(SP)+,-(R0)	; шаг (вещественный) - старшее слово
	MOV	(SP)+,-(R0)	; шаг - младшее слово
	BR	FORMOV
FORINT::
	MFPS	R3
	MTPS	#340
	MOV	CIKL,R0
FORMOV:
	MOV	(SP)+,-(R0)	; предел цикла (или шаг для FORINT) - со стека
	MOV	(SP)+,-(R0)
	MOV	(R4)+,-(R0)	; служебное слово из кода (адрес тела цикла - см. NEXJMP)
	MOV	(R4)+,-(R0)	; служебное слово из кода
	CMP	R0,ENDCOD	; переполнение стека кадров (уткнулись в код программы)?
	BLO	ERR7		; да - ошибка =>
	MOV	R0,CIKL		; зафиксировать новый блок цикла
JEN3:
	MTPS	R3		; восстановить регистр состояния процессора
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
ERR7:
	TRAP	7		; ошибка - переполнение стека кадров

; LIT - вывести строку (значение уже вычислено и лежит на стеке - см.
; PRINT в COMP.MAC: TRAP 122 компилирует строковое выражение/литерал, LIT
; его печатает). На стеке: длина, затем адрес.
LIT::
	CALL	CLRTSP		; сбросить учёт временных строк
	MOV	(SP)+,R2	; R2 = длина строки
	BEQ	SPJ		; пустая строка - нечего выводить, снять адрес и продолжить =>
	BR	OUT2		; вывести R2 байт по адресу (ещё на стеке)

; NXSKIP - первый опкод NEXT [переменная] (см. COMP.MAC NEXT::). Т.к. NEXT
; без переменной или NEXT конкретной переменной может закрывать сразу
; несколько вложенных незакрытых циклов, здесь ищется нужный блок цикла на
; стеке кадров (начиная с CIKL, наружу), пропуская чужие/попавшиеся между
; ними кадры GOSUB. Когда блок найден - выполнение просто продолжается
; (JEN3): сам шаг/проверку цикла делают следующие в коде NEXCMP+NEXJMP/NEXJMP.
NXSKIP::
	MFPS	R3		; сохранить регистр состояния процессора
	MTPS	#340		; запретить прерывания
	MOV	CIKL,R1		; R1 = самый внутренний блок цикла/кадр
	MOV	(R4)+,R0	; R0 = адрес переменной из NEXT (0, если без переменной)
	BNE	1$		; переменная указана =>
	MOV	@R1,R0		; без переменной - взять переменную самого внутреннего цикла
1$:	CMP	R1,LIMIT	; кадры кончились (цикл не найден)?
	BHIS	3$		; да - ошибка =>

	CMP	R0,(R1)+	; переменная этого блока совпадает с искомой?
	BEQ	JEN3		; да - нашли нужный цикл, продолжить =>
	MOV	-(R1),R2	; нет - R2 = переменная этого блока (не совпала)
	ADD	#10,R1		; пропустить блок цикла целиком
	TST	-(R2)		; это блок цикла (не кадр GOSUB)?
	BMI	10$		; да =>
	CMP	(1)+,(1)+	; нет (кадр GOSUB) - пропустить его дополнительные слова
10$:	MOV	R1,CIKL		; перейти к следующему (внешнему) кадру
	BR	1$
3$:	TRAP	1		; ошибка - NEXT без соответствующего FOR
;
; NEXSNG - шаг цикла FOR с вещественным счётчиком: сложить счётчик (R0 -
; его адрес, унаследован от NXSKIP) с шагом (в блоке цикла, R1) через ADR
; (FLOATS.MAC). Само сложение и запись результата, видимо, довершает уже
; исполняемый по возврату из ADR код (см. падение в NEXCMP/NEXJMP далее в
; байт-коде); проверка -2(R0) здесь не до конца ясна.
NEXSNG::
	TST	-2(0)		; (условие не выяснено до конца)
	BMI	1$
	MOV	2(0),-(SP)	; переложить старшее слово счётчика
	MOV	@R0,-(SP)	; переложить младшее слово счётчика
	ADD	#6,R1
	MOV	(1)+,-(SP)	; переложить старшее слово шага (из блока цикла)
	MOV	(1)+,-(SP)	; переложить младшее слово шага
	JMP	ADR		; сложить (FLOATS.MAC) - оттуда вернётся в код после NEXSNG
1$:	CMP	(R4)+,(R4)+
;
; NEXINT - шаг цикла FOR с целым счётчиком: сам делает всё - прибавляет
; шаг, проверяет переполнение и предел, и либо прыгает назад к телу цикла,
; либо снимает блок цикла (меньшего размера, чем у JSR/FORSNG) и продолжает.
NEXINT::
	CMP	(R1)+,(R1)+	; пропустить служебные слова блока (к шагу)	;---STOP---
	MOV	@R1,R2		; R2 = шаг
	ADD	@R0,R2		; R2 = счётчик + шаг
	BVS	4$		; переполнение =>
	MOV	R2,@R0		; записать новое значение счётчика
	TST	@R1		; шаг отрицательный?
	BMI	2$		; да =>
	CMP	R2,-(R1)	; шаг положительный - счётчик больше предела?
	BGT	3$		; да - цикл закончен =>
1$:	MOV	-(R1),R4	; цикл продолжается - R4 = адрес возврата к телу цикла
	JMP	@(R4)+		;-------+24
2$:	CMP	R2,-(R1)	; шаг отрицательный - счётчик всё ещё >= предела?
	BGE	1$		; да - цикл продолжается =>
3$:	ADD	#10,CIKL	; цикл закончен - снять блок цикла
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
4$:	TRAP	6		; ошибка - переполнение при вычислении шага

;
; NEWLIN - вывести перевод строки (после PRINT без ';'/',' в конце - см.
; COMP.MAC PRINT/ENDTXT).
NEWLIN::MOV	#12,R0		; #12 = LF (перевод строки)
	BR	JEND
;
; JCLS - оператор CLS (очистить экран): в графическом режиме - через
; графический очиститель, иначе - вывод символа "очистить экран" (#14, FF).
JCLS::
	TST	CRTGRP		; сейчас графический режим?
	BEQ	1$		; нет =>
	JMP	GRPCLS		; да - графическая очистка экрана

1$:
	MOV	#14,R0		; #14 = FF (очистить экран)
; JEND - общий хвост NEWLIN/JCLS: вывести символ R0. SAVJMP на время вывода
; запоминает текущую позицию в коде (используется ERROR::/RUNERR, если во
; время вывода произойдёт ошибка с обработчиком ON TRAP).
JEND:	MOV	R4,SAVJMP
	.BJSR	ISVTO		; вывести символ R0 на экран
JEN2:	CLR	SAVJMP
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
;
; SOUTSP/IOUTSP - вывод числа оператором PRINT по его типу (см. AOUTSP в
; COMP.MAC PRINT): вещественное форматируется через EGO (FLOATS.MAC,
; готовит для UNPCK), целое - через ISGUNP; оба оставляют готовую строку
; (адрес,длина) для общего вывода в OUT2/OUT1. OUT2 - общий вход и для LIT
; (уже вычисленное строковое значение, длина в R2 своя).
SOUTSP::
	CALL	EGO		; сформировать текст вещественного числа
OUT:	MOV	(SP)+,R2	; R2 = длина текста

OUT2:	MOV	(SP)+,R1	; R1 = адрес текста
	BR	OUT1
;
IOUTSP::
	MOV	(SP)+,R5	; R5 = целое значение
	.BJSR	ISGUNP		; сформировать текст целого числа
OUT1:	MOV	R4,SAVJMP	; запомнить позицию в коде (см. JEND) на время вывода
	.BJSR	ISVETO		; вывести R2 байт текста по адресу R1
	BR	JEN2		; сбросить SAVJMP, продолжить

;
; ZONA - оператор PRINT: запятая-разделитель, переход к следующей зоне
; печати (ширина зоны - 16. столбцов). Определяет текущий столбец по
; устройству вывода (экран - TABX, принтер - LPTPOS, иное - 0), затем
; считает, сколько пробелов до начала следующей зоны (если ровно на
; границе - переходит к следующей зоне целиком, не остаётся на месте).
ZONA::
	MOV	@#IODEV,R3	; R3 = текущее устройство вывода
	BLT	3$		; принтер =>
	BGT	4$		; иное устройство =>
	MOV	@#TABX,-(SP)	; экран - текущий столбец курсора
	BR	41$
3$:
	MOV	@#LPTPOS,-(SP)	; принтер - текущая позиция на строке
	BR	41$
4$:	CLR	-(SP)		; иное устройство - считать столбец нулевым
41$:	SUB	#20,@SP		; вычесть ширину зоны
	BGT	41$		; ещё не дошли до следующей зоны - повторить =>
	BEQ	42$		; ровно на границе зоны =>
	NEG	@SP		; не на границе - число пробелов до неё
	BR	SPC1
42$:	MOV	#20,@SP		; на границе - перейти к следующей зоне целиком
	BR	SPC1
;
; SPC(n) - вывести n пробелов от текущей позиции.
SPC::	CALL	TIKR		; проверить, что аргумент - число 0..255
	BR	SPC1
;
; TAB(n) - перейти на столбец n: превратить n в число пробелов до этого
; столбца (текущая позиция берётся по устройству - экран/принтер), затем
; общий хвост SPC1.
TAB::	CALL	TIKR		; проверить, что аргумент - число 0..255
	MOV	@#IODEV,R3	; текущее устройство вывода
	BEQ	1$		; экран =>
	BGT	SPC1		; иное устройство - столбец = число пробелов как есть =>
	MOV	@#LPTPOS,R1	; принтер - текущая позиция на строке
	BR	3$

1$:	MOV	@#TABX,R1	; экран - текущий столбец курсора
	SUB	@#MIDLE,R1	; поправка на левую границу
3$:	SUB	R1,@SP		; число пробелов = нужный столбец - текущий
; SPC1 - вывести @SP пробелов (снимает счётчик со стека).
SPC1:	MOV	#40,R0		; #40 = пробел
1$:	DEC	@SP
	BLT	2$		; вывели нужное число пробелов =>
	.BJSR	ISVTO		; вывести пробел
	BR	1$
2$:	TST	(SP)+		; снять счётчик со стека
	JMP	@(4)+		; продолжить (диспетчер шитого кода)
;
; TIKR - проверить, что аргумент SPC/TAB умещается в байт (0..255),
; иначе ошибка "недопустимый аргумент функции".
TIKR:	TSTB	3(SP)		; старший байт аргумента (под адресом возврата) пуст?
	BNE	BADARG		; нет - вне диапазона =>
	RETURN
BADARG:	TRAP	5		; ошибка - недопустимый аргумент

; AT(строка,столбец) - позиционирующая функция PRINT: поставить курсор на
; экране в заданную строку/столбец. На устройствах, отличных от экрана,
; ведёт себя как TAB(строка) (второй аргумент не имеет смысла).
AT::	CALL	TIKR		; проверить первый аргумент (строка) - число 0..255
	MOV	(SP)+,R2	; R2 = строка
	TST	IODEV		; вывод на экран?
	BNE	TAB		; нет - как TAB(строка) =>
	CALL	TIKR		; проверить второй аргумент (столбец) - число 0..255
	CMP	R2,#LN		; строка вне числа строк экрана?
	BGT	BADARG		; да - ошибка =>
	CMP	@SP,LL		; столбец вне длины строки экрана?
	BGE	BADARG		; да - ошибка =>
	MOV	#EBUF,R1	; R1 = начало экранного буфера
	ADD	@SP,R1		; + смещение по столбцу
	MOV	(SP)+,TABX	; запомнить новый текущий столбец
	MOV	R2,TABY		; запомнить новую текущую строку
	BEQ	4$		; строка 0 - вычислять смещение по строкам не нужно =>
3$:	ADD	LL,R1		; + длина строки экрана
	SOB	R2,3$		; повторить по числу строк
4$:	MOV	R1,CURS		; CURS = адрес курсора в экранном буфере
	CALL	CSCR		; вычислить экранные координаты курсора
	CALL	LOK		; установить курсор
	CALL	RSCR		; восстановить (перерисовать) экран
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)

;
; POS(n)/LOCX - текущий столбец курсора. Аргумент функции POS(n) не
; используется - только снимается со стека (SLOCX/ILOCX - варианты входа
; по типу аргумента, "лишний" для строкового снимаются дважды).
SLOCX::	TST	(SP)+		; снять (неиспользуемый) аргумент
ILOCX::	TST	(SP)+		; снять (неиспользуемый) аргумент
LOCX::
	MOV	TABX,-(SP)	; вернуть текущий столбец
	JMP	@(4)+		; продолжить (диспетчер шитого кода)
;
; CSRLIN/LOCY - текущая строка курсора (аналогично LOCX).
SLOCY::	TST	(SP)+		; снять (неиспользуемый) аргумент
ILOCY::	TST	(SP)+		; снять (неиспользуемый) аргумент
LOCY::
	MOV	TABY,-(SP)	; вернуть текущую строку
	JMP	@(4)+		; продолжить (диспетчер шитого кода)
;
; LOC - необязательный третий аргумент LOCATE (видимость курсора):
; 0 - выключить курсор, иначе - включить (см. COMP.MAC LOCATE::/опкод LOC).
LOC::	TST	(SP)+		; снять аргумент, проверить его
	BNE	1$		; ненулевой (включить курсор) =>
	.BJSR	CUROFF		; выключить курсор
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
1$:	.BJSR	CURON		; включить курсор
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)

;-----------------------------------------------
; GETLIT - оператор INPUT со своим приглашением (см. COMP.MAC INPUT::):
; приглашение уже выведено (опкодом LIT), стандартное "? " печатать не
; нужно - входит в общий код GET (ниже) сразу после его собственного
; MOV R4,SAVJMP (SAVJMP отводится назад на длину этого опкода).
GETLIT::MOV	R4,SAVJMP
	SUB	#10,SAVJMP	; поправить SAVJMP на начало этого опкода (см. GET)
	BR	G01		; => общий код ввода (без вывода "? ")
;
; RESTV - оператор RESTORE без номера строки: восстановить указатель DATA
; на адрес, записанный в коде (пропатчен при компиляции - см. ENDTXT/AUTOON
; в COMP.MAC, обрабатывает и случай "DATA не найден" - там пишется 0).
RESTV::	MOV	(4)+,DATPTR	; DATPTR = адрес, вписанный компилятором
	JMP	@(4)+		; продолжить (диспетчер шитого кода)
;
; READV - оператор READ: взять текст очередного значения из цепочки DATA
; (DATPTR) и разобрать его как INPUT (общий код GET, точка входа G1).
READV::	MOV	DATPTR,R3	; R3 = адрес текста очередного значения DATA
	BNE	1$		; данные ещё есть =>
	TRAP	4		; данные кончились - ошибка "Out of DATA"
1$:	MOV	#-1,DATINP	; отметить: это READ, а не INPUT (см. ERROR::/RUNERR)
	MOV	R4,SAVJMP	; запомнить позицию в коде
	MOV	(4)+,-(SP)	; переложить операнд (ссылку на список переменных)
	BR	G1		; => общий код разбора значения (без запроса ввода)
;

; GET - общий разбор значений для операторов INPUT/READ (READV/GETLIT
; входят сюда с разных точек - см. выше). В коде после опкода - список
; переменных (см. COMP.MAC INPUT::/INPENT: адрес каждой переменной, для
; массивов - опкод GETARR). Общая схема:
;   G01/G00 - вывести "?" и приглашение (для интерактивного INPUT), считать
;             строку ввода (INBF0); READ/GETLIT входят без этого.
;   G1      - цикл по списку переменных: пропустить разделяющую запятую.
;   G30     - определить тип цели (обычная/массив) и её тип значения по
;             флагу в скомпилированном коде (BIT #20000 - строка? =>G20).
;   G20     - строковое значение: скопировать текст (с учётом кавычек) в
;             новую строку (через TSTFRE) и сохранить как значение цели.
;   G3/CISLO/TOSNG/TOINT/G32 - числовое значение: разобрать число (CISLO),
;             привести к вещественному/целому (TOSNG/TOINT) и сохранить.
;   G40     - после значения: запятая - следующая переменная; конец строки/
;             DATA - готово (G1/G6); иначе ошибка G4 ("Redo from start"),
;             которая через SAVJMP перезапускает весь оператор заново.
;   G6/G66  - завершение: для READ - сохранить новую позицию в DATPTR; для
;             интерактивного INPUT - выключить курсор.
GET::	MOV	R4,SAVJMP	; запомнить начало оператора (для повтора при ошибке)
G01:	MOV	(R4)+,-(SP)	; сохранить конец списка переменных (операнд из кода)
	MOV	IODEV,DATINP	; DATINP = устройство ввода (0 - клавиатура)
	BNE	G03		; ввод не с клавиатуры (файл) =>
	MOV	#'?,R0
	BR	G00
G13:	TSTB	IODEV+1
	BNE	1$
	CMPB	@R3,#12		; конец введённой строки, а переменных ещё много?
	BEQ	G02		; да - запросить продолжение ввода =>
1$:	CMP	@R4,LENT
	BHIS	G30
	MOV	R3,-(SP)
	TST	(4)+
	JMP	@(4)+
G03:	CALL	FILINP		; чтение значения из файла
	CMP	R1,#BUF
	BNE	G04
	TRAP	55.
G02:	MOV	DATINP,R0
	BEQ	1$
	BPL	G03
	TRAP	4
1$:	MOV	#'?,R0
	CALL	ISV
G00:	CALL	ISV		; вывести "?"
	.BJSR	CURON		; включить курсор
	CALL	INBF0		; считать строку ввода с клавиатуры
	BCC	G5
G04:	MOV	#BUF,R3		; R3 = введённый текст
	TRAP	112		; пропуск пробелов
	CMPB	@R3,#12		; пустая строка?
	BNE	G1
	TST	IODEV
	BLE	G5
	MOVB	@R3,IODEV+1
; Цикл по списку переменных.
G1:	CMP	R4,@SP		; список переменных кончился?
	BEQ	G6		; да - завершить =>
	TRAP	112		; пропуск пробелов
	CMPB	@R3,#',	; в тексте ожидается запятая (после предыдущего значения)?
	BNE	G13		; нет =>
	CMP	(R4)+,LENT
	BHIS	G12
	MOV	-(R4),R4
G12:	INC	R3		; съесть запятую
	BR	G1
; G20 - строковое значение: скопировать текст (в кавычках - до закрывающей
; кавычки, иначе - до запятой/конца строки) в новую строку.
G20:	MOV	#',,-(SP)	; разделитель по умолчанию - запятая
	MOV	R1,-(SP)
	CLR	R1		; R1 = длина считываемого текста
	MOV	R3,-(SP)	; запомнить начало текста значения
	CMPB	@R3,#'"		; значение в кавычках?
	BNE	22$
21$:	MOVB	(R3)+,4(SP)	; да - разделитель теперь кавычка
	INC	(SP)
22$:	CMPB	@R3,#12		; конец строки текста?
	BEQ	24$
	CMPB	(3)+,4(SP)	; дошли до разделителя (кавычки/запятой)?
	BEQ	24$
	INC	R1		; нет - ещё один символ значения
	BR	22$
24$:	MOV	R0,R5
	MOV	@SP,-(SP)
	MOV	R3,2(SP)
	BIT	#177400,R1	; длина строки в допустимых пределах?
	BNE	28$		; нет - ошибка =>
	CLR	-(SP)
	MOV	R1,-(SP)
	CALL	TSTFRE		; выделить память под новую строку
	MOV	(SP)+,R1
	MOV	(SP)+,R2
	MOV	(SP)+,R3
	MOV	R1,R0
	BEQ	26$
	MOV	R2,-(SP)
25$:	MOVB	(3)+,(2)+	; скопировать текст значения в новую строку
	SOB	R1,25$
	MOV	(SP)+,R2
26$:	MOV	(SP)+,R3
	MOV	(SP)+,R1
	MOVB	R0,(R1)+	; записать дескриптор строки в переменную
	TSTB	R5
	BMI	27$
	CLRB	(R1)+
27$:	MOVB	R2,(R1)+
	SWAB	R2
	MOVB	R2,(R1)+
	CLRB	IODEV+1
	CMP	(SP)+,#',	; значение оканчивалось запятой?
	BEQ	G1		; да - к следующей переменной =>
	BR	G40
28$:	TRAP	15.		; ошибка - слишком длинная строка
; G30 - определить тип цели (см. GETARR::/AKINPP): проверить флаг типа,
; строковая цель - в G20, иначе - разобрать число (CISLO) и уточнить тип
; по результату (в G32/G41).
G30:	MOV	(R4)+,R1	; R1 = адрес цели
	MOV	R1,R0
G3:	MOV	-(R0),R0	; R0 = флаги цели (перед адресом значения)
	BIT	#20000,R0	; строковый тип?
	BNE	G20		; да =>
	MOV	R4,-(SP)
	MOV	R1,-(SP)
	CALL	CISLO		; нет - разобрать число
	BR	G41
	BR	G41
	BR	G41
; G32 - привести разобранное число к типу цели (вещественное/целое) и
; сохранить (через SXMOV/IXMOV - опкоды присваивания массиву, см. JMIN).
G32:
	BIT	#40000,R0	; цель вещественная?
	BNE	32$		; нет (целая) =>
31$:	JSR	R4,TOSNG	; привести к вещественному
	.WORD	IR,SXMOV,G33
32$:	JSR	R4,TOINT	; привести к целому
	.WORD	RI,IXMOV,G33
G5:	MOV	@SP,R4
; Завершение оператора: для READ - запомнить новую позицию в DATPTR, для
; интерактивного INPUT - выключить курсор.
G6:	CLR	SAVJMP
	TST	DATINP
	BEQ	1$
	BPL	G66
	MOV	R3,DATPTR	; READ - сохранить позицию для следующего READ
	BR	G66
1$:
	.BJSR	CUROFF		; INPUT - выключить курсор
G66:	TST	(SP)+
	JMP	@(4)+		; продолжить (диспетчер шитого кода)
G33:	MOV	(SP)+,R4
; После значения - запятая (следующая переменная) или конец строки/DATA
; (готово); иначе - ошибка "Redo from start" (G4), перезапуск оператора.
G40:	TRAP	112		; пропуск пробелов
	CMPB	@R3,#',	; запятая?
	BEQ	G12		; да - к следующей переменной =>
	CMPB	@R3,#12		; конец строки?
	BEQ	G1		; да =>
	TST	DATINP
	BGT	G1
G4:	TRAP	13.		; ошибка - лишние символы после значения
	TST	(SP)+
	MOV	SAVJMP,R4	; перезапустить оператор с начала (см. GET::/GETLIT::)
	JMP	@-2(R4)
; Число только что разобрано (из CISLO) - определить его фактический тип.
G41:	TSTB	IODEV+1		; флаг от разбора строки (см. G04) установлен?
	BEQ	1$		; нет =>
	CLR	R5
	MOV	#-1,R4
	CLRB	IODEV+1		; сбросить флаг
	BR	G32		; => привести/сохранить разобранное значение
1$:	CMP	(SP)+,(SP)+	; снять сохранённые R4/R1 (число не разобралось)
	BR	G4		; ошибка "Redo from start"
;
; GETARR - вариант входа в GET для цели-элемента массива (см. TRAP 103/
; AKINPP): R1/R3 подготовлены компилятором, R0 - флаги типа элемента
; (перечитываются из кода) - дальше как для обычной переменной (G3).
GETARR::MOV	(SP)+,R1	; R1 = адрес значения элемента массива
	MOV	(SP)+,R3	; R3 = позиция в тексте
	MOV	-6(R4),R0	; R0 = флаги типа элемента
	BR	G3		; => общий разбор значения (как для обычной переменной)

;
; TOINT/TOSNG - привести значение, разобранное CISLO (в GET::/G3), к типу
; цели. Вызываются как JSR R4,TOxxx с тремя словами-операндами сразу после
; вызова: [подпрограмма преобразования типа - IR/RI], [опкод присваивания -
; SXMOV/IXMOV], [точка продолжения - G33]. R4 после вызова указывает на эти
; слова; переход "JMP @(R4)+" каждый раз читает очередное слово и прыгает
; по нему, доводя цепочку до G33 (преобразование и присваивание сами
; дочитывают и передают R4 дальше таким же образом - шитый код).
; R2 (от CISLO) - 0, если число вещественное (из PACK), иначе - целое (из &).
TOINT::	MOV	(SP)+,R2	; R2 = признак типа разобранного числа
	BEQ	FROMS		; вещественное - нужно преобразовать (RI) =>
	MOV	R5,@(SP)+	; уже целое - записать значение прямо по адресу
	BR	G33		; (без преобразования и без IXMOV) - готово
TOSNG:	MOV	(SP)+,R2	; R2 = признак типа разобранного числа
;
	BEQ	NOCONV		; вещественное - преобразование не нужно =>
1$:	TST	-(R4)
FROMI:	MOV	R5,-(SP)	; целое - положить значение для преобразования (IR)
NOCONV:	TST	(R4)+		; пропустить слово подпрограммы преобразования
FROMS:	JMP	@(R4)+		; выполнить преобразование/присваивание (шитый код)

;-------------------------------------------------
; NEG - смена знака вещественного числа: старшее слово содержит бит знака
; (см. FLOATS.MAC) - переключить его сложением 100000 (не трогать, если
; число - ноль, у нуля отдельного знака нет).
NEG::	TST	@SP		; число - ноль?
	BEQ	1$		; да - знак не менять =>
	ADD	#100000,@SP	; переключить бит знака старшего слова
1$:	JMP	@(R4)+		; продолжить (диспетчер шитого кода)

;
; IABS/INEG - модуль/смена знака целого числа.
IABS::	TST	@SP		; уже неотрицательное?
	BPL	J1		; да - готово =>
;
INEG::	NEG	@SP		; сменить знак (дополнение до двух)
J1:	JMP	@(4)+		; продолжить (диспетчер шитого кода)
;
; ISGN - знак целого числа: -1/0/1.
ISGN::	MOV	#1,R0		; по умолчанию - положительное
	TST	@SP
	BEQ	2$		; ноль - оставить как есть (SGN(0)=0) =>
	BPL	1$		; положительное - оставить R0=1 =>
	NEG	R0		; отрицательное - R0=-1
1$:	MOV	R0,@SP		; записать результат
2$:	JMP	@(4)+		; продолжить (диспетчер шитого кода)

;
; SUM/SKIRT/SAND - целочисленные +,-,* (см. APLMI/ADGDL в TRAP.MAC).
SUM::	ADD	(SP)+,@SP	; сложить два верхних числа на стеке
SUMPAB:	BVS	OVF		; переполнение? =>
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
OVF:	TRAP	6		; ошибка переполнения
;
SKIRT::	SUB	(SP)+,@SP	; вычесть верхнее число из следующего
	BR	SUMPAB		; => проверка переполнения и продолжение
;
SAND::	MOV	(SP)+,R1	; R1 = первый множитель
	MUL	@SP,R1		; R1 *= второй множитель
	BCS	OVF		; результат не влезает в слово - переполнение =>
	MOV	R1,@SP		; записать результат
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)

; IDIV - оператор \ (целочисленное деление, частное). R0:R1 - 32-битное
; знаковое расширение делимого (SXT), делится на R2.
IDIV::	MOV	(SP)+,R2	; R2 = делитель
	MOV	@SP,R1		; R1 = делимое
	SXT	R0		; R0 = знаковое расширение (0 или -1)
	DIV	R2,R0		; R0:R1 / R2 -> частное в R0, остаток в R1
	BCS	DIVNUL		; деление на 0 или переполнение =>
	MOV	R0,@SP		; результат - частное
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)

; MOD - оператор MOD (остаток от деления). Как IDIV, но результат - остаток.
MOD::	MOV	(SP)+,R2	; R2 = делитель
	MOV	@SP,R1		; R1 = делимое
	SXT	R0		; R0 = знаковое расширение (0 или -1)
	DIV	R2,R0		; R0:R1 / R2 -> частное в R0, остаток в R1
	BCS	DIVNUL		; деление на 0 или переполнение =>
	MOV	R1,@SP		; результат - остаток
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)

DIVNUL:	TRAP	11.		; ошибка - деление на ноль

; Логические операторы NOT/OR/AND/EQV/XOR/IMP. Значения истины - 0/-1
; (все биты сброшены/установлены), поэтому побитовые операции дают верный
; логический результат напрямую.
NOT::	COM	@SP		; побитовое НЕ (-1<->0)
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
OR::	BIS	(SP)+,@SP	; побитовое ИЛИ
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
; AND через тождество Де Моргана: A И B = A И НЕ(НЕ B).
AND::	COM	@SP		; НЕ B
	BIC	(SP)+,@SP	; A И НЕ(НЕ B) = A И B
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
; EQV (равнозначность) = НЕ(A ИСКЛ.ИЛИ B) = A ИСКЛ.ИЛИ (НЕ B).
EQV::	COM	@SP		; НЕ B
XOR::	MOV	(SP)+,R0	; (независимая точка входа для XOR: просто A,B)
	XOR	R0,@SP		; A ИСКЛ.ИЛИ B (или A ИСКЛ.ИЛИ НЕ B - для EQV)
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
; IMP (импликация) A->B = (НЕ A) ИЛИ B.
IMP::	COM	2(SP)		; НЕ A (второе слово на стеке, B - на вершине)
	BIS	(SP)+,@SP	; (НЕ A) ИЛИ B
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
;
;------------------------------------------------
; Ошибки массивов: AR9 - несовпадение числа индексов с числом измерений;
; AR10 - повторный DIM того же массива; ARR12 - обращение к массиву без
; DIM в прямом режиме; AR5 - индекс вне диапазона; AR7 - не хватает памяти.
AR9:	TRAP	9.
AR10:	TRAP	10.

ARR12:	TRAP	12.
;
; INDEX - вычислить адрес элемента ранее описанного массива (обычный
; доступ A(i,j,...)). В коде после опкода: адрес записи массива (в таблице
; переменных) и число индексов. Запись массива: [флаг DIM][число измерений]
; [размер измерения 1]...[размер измерения N][данные...]. Если массив ещё
; не был явно объявлен (DIM) - в прямом режиме ошибка, при компиляции
; программы разрешается неявное объявление (авто-DIM(10), см. ARR10/ARRAY).
; Адрес элемента считается по индексам построчно (со сдвигом по каждому
; следующему измерению), с проверкой каждого индекса на диапазон.
INDEX::	MOV	(R4)+,R1	; R1 = адрес записи массива
	MOV	(R1)+,R0	; R0 = флаг "уже объявлен через DIM"
	BNE	1$		; объявлен =>
	TSTB	LYGIS		; идёт выполнение программы (не прямой режим)?
	BEQ	ARR12		; нет - ошибка "массив не объявлен" =>
	MOV	ENDCOD,R0	; неявный DIM: R0 = текущий конец занятой памяти
	CMP	R0,CIKL		; хватает места под служебные слова?
	BHIS	AR7		; нет =>
	MOV	#11.,@R0	; отметить неявное измерение (по умолчанию 1)
	MOVB	#1,@R1		; отметить массив как объявленный
1$:	MOV	(R4)+,R3	; R3 = число индексов в обращении
	CMPB	R3,@R1		; совпадает с числом измерений массива?
	BNE	AR9		; нет - ошибка =>
	CLR	R1		; R1 = накопленное смещение
2$:	CMP	@SP,(R0)+	; очередной индекс (со стека) в пределах размера измерения?
	BHIS	AR9		; нет - ошибка =>
	ADD	(SP)+,R1	; учесть индекс в смещении
	DEC	R3
	BLE	3$		; последнее измерение обработано =>
	MOV	@R0,R2		; R2 = размер следующего измерения
	MUL	R2,R1		; сместить накопленное смещение на его размер
	BR	2$
3$:
	TST	(0)+
	MOV	-4(R4),R3
	MOVB	3(R3),R2	; R2 = размер элемента (в словах, по типу)
	MUL	R2,R1		; смещение в словах
	ADD	R1,R0		; R0 = адрес элемента
	MOV	R0,-(SP)	; вернуть его на стек
	TST	(R3)+
	BEQ	4$
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
4$:	CMP	-(R4),-(R4)
;
; ARR10 - неявный DIM с размером по умолчанию 10 для каждого измерения
; (BASIC допускает A(5) без предварительного DIM A(10)).
ARR10::	MOV	#10.,-(SP)	; размер измерения по умолчанию
;
; ARRAY - оператор DIM: описать массив (число измерений и их размеры - в
; коде и/или на стеке), выделить под него память (в конце занятой области,
; ENDCOD растёт), обнулить данные.
ARRAY:: MOV	(R4)+,R1	; R1 = адрес записи массива
	TST	(R1)+		; уже объявлен?
	BNE	AR10		; да - повторный DIM, ошибка =>
	MOV	(R4)+,R3	; R3 = число измерений
	MOVB	R3,(R1)+	; записать число измерений
	MOV	ENDCOD,R0	; R0 = начало данных массива (текущий конец памяти)
12$:	MOV	R3,R2
	ASL	R2
	ADD	R0,R2
	CMP	R2,CIKL		; хватает места под слова размеров измерений?
	BHIS	AR7		; нет =>
14$:	MOVB	@R1,R1		; R1 = тип элемента (байт)
; Записать размер каждого измерения (со стека) и накопить общее число
; элементов (R1) перемножением.
1$:
	MOV	(SP)+,R2	; R2 = размер очередного измерения (со стека)
	BLT	AR5		; отрицательный - ошибка =>
	INC	R2		; (индексы 0..N, значит N+1 элементов)
	BVS	AR7
	MOV	R2,(R0)+	; записать размер измерения
	MUL	R2,R1		; накопить общее число элементов

	BCS	AR7		; переполнение =>
	SOB	R3,1$
;
	INC	R1		; выровнять размер данных под слово
	BIC	#1,R1
	MOV	R1,(0)+		; записать общий размер данных массива
	ADD	R1,R0		; R0 = конец данных массива
	BCS	AR7		; переполнение =>
	CMP	R0,CIKL		; хватает памяти под сами данные?
	BHI	AR7		; нет =>
	MOV	ENDCOD,@-4(4)	; запомнить старую границу (для undo при ошибке?)
	MOV	R0,ENDCOD	; зафиксировать новую границу занятой памяти
	ASR	R1
3$:	CLR	-(R0)		; обнулить данные массива
	SOB	R1,3$
4$:	CMP	R4,STRREG	; ??? (проверка относительно области строк)
	BHI	5$
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
5$:
; ASTAR - опкод конца оператора без явного продолжения (обычно после ARRAY
; DIM в конце текста): вернуться в главный цикл монитора.
ASTAR::
	JMP	@#STAR
;
AR5:	TRAP	5		; ошибка - индекс вне диапазона
AR7:	TRAP	7		; ошибка - не хватает памяти
;
; DAUG - вспомогательное умножение (R1 *= R2), используется как обычная
; подпрограмма (не шитый код - явный RETURN), в частности из INDEX/ARRAY.
DAUG2:
DAUG::	MUL	R2,R1
	RETURN
;
;
; CLRTSP/CLRTMP - сброс учёта временных строк (см. TMPSP), используются
; перед операциями, которые могут создать временные строковые значения.
CLRTSP::CLR	TMPSP
	BR	TMPCLR
CLRTMP::MOVB	3(SP),TMPSP+1
TMPCLR:	CLRB	3(SP)
	RETURN
;
	.END
