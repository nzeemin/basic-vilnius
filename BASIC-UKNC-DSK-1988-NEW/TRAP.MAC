
	.INCLUDE /GENUKD.MAC/
	.SBTTL	TRAPLIB
	.ENABLE	LC

	.MACRO	.BJSR	N
	.IF EQ,MASINA-BK0011
		MOV	#PAG1,-(SP)
		MOV	#N,-(SP)
		EMT	54
	.IFF
		CALL	N
	.ENDC
	.ENDM
;
	.GLOBL	IFRE,$FRE,SLOCX,ILOCX,SLOCY,ILOCY
	.GLOBL	FRE,SFRE,PEEK,LEN,INP,LOCX,LOCY,EOF,INSTR
	.GLOBL	ASC,VAL,SUM,SKIRT,SAND,POINT,INSTR2
	.GLOBL	LPOS,ILPOS,SLPOS
	.GLOBL	PI,$CONST
	.GLOBL	ABS,IABS,ISGN
	.GLOBL	ISVEIL,NUMBER,ATLIN1,LNUM,ISV
	.GLOBL	SEPAP,$VAR,SVAR,IVAR,SCONST,ICONST
	.GLOBL	INEG,NEG,ADRHLT,AFUN,STOPEN,NOSTOP
	.GLOBL	TABTOP,LENT,SETW,LYGIS,ERRS,SETST,DATINP,SAVJMP,CLRCOD
	.GLOBL	INDEX,ARRAY,ARR10,$USR,ISTR,SSTR,BIN,OCT,HEX
	.GLOBL	SXVAR,IXVAR,$XVAR,SCMP,ICMP,$CMP,NOT,ADLOG,ADDRBR
	.GLOBL	MOD,IDIV,BUFOUT,TRTOPL
	.GLOBL	FCB,INKEY,NEWSTR,CURLIN,STRREG,I1,TYPE,CIKL,STACK,LIMIT
	.GLOBL	STR,STR2,IODEV,CONCAT,CHR,ALLSM,ALLSK	;SIGNAL
	.GLOBL	FNST,FNCALL,$PAR,SPAR,IPAR,APAR,PFACT	;APRL
	.GLOBL	EQ,GT,LT,GE,LE,NE
	.GLOBL	IMP,EQV,XOR,OR,AND
	.GLOBL	ADR,SUB,DVR,MLR
	.GLOBL	RAN,ROTG,ROTI,RI,IR,SGN
	.GLOBL	SQRG,SING,KOS,TANG,ATANG,EXPG,ALNG,INT,SVD1
	.GLOBL	CISLO,ATCONV
	.GLOBL	SETCRT

; TRAP – обработчик программных прерываний (инструкции TRAP).
; Используется для вызова встроенных функций и операторов языка BASIC.
; Вектор прерывания (34) устанавливается в MONIT.MAC.
; При вызове TRAP процессор сохраняет в стеке: PSW, затем PC (адрес следующей инструкции).
; В нашем случае после TRAP обычно следует слово с номером функции.
TRAP::	MOV	R0,-(SP)	; сохранить R0
	MOV	R2,-(SP)	; сохранить R2
	MOV	4(SP),R0	; R0 = адрес инструкции после TRAP
	MOV	-2(R0),R2	; R2 = код инструкции TRAP
	BIC	#177400,R2	; оставить младшие 8 бит - номер TRAP
	SUB	#100,R2		; вычесть 64.
	BLT	ERROR		; если номер < 100, то этот TRAP сообщает об ошибке
	ASL	R2		; умножить на 2
	CALL	@ATRAP(R2)	; вызвать подпрограмму из таблицы ATRAP
	MOV	R0,4(SP)	; записать (возможно изменённый Tnnn) R0 как адрес возврата -
				; так Tnnn может пропустить N слов кода после TRAP N у вызывающего
TREND:	MOV	(SP)+,R2	; восстановить R2
	MOV	(SP)+,R0	; восстановить R0
	RTI			; возврат из прерывания (восстанавливает PSW и PC)
;
; Общий обработчик ошибок: вывести сообщение (по коду в R2/R5, см. MSTYPE)
; и решить, куда вернуть управление - в монитор (MONERR/COMERR), обратно в
; программу для повтора INPUT (GETERR), к обработчику ON TRAP (RUNERR), или
; после ошибки прямо в тексте программы, набранном в режиме редактирования.
ERROR::
	CLR	IODEV		; вывод сообщения - на экран (не на устройство программы)
	MOV	R2,R5		; R5 = код ошибки
	ADD	#100,R5
	.BJSR	SETCRT

	CALL	MSTYPE		; вывести текст сообщения об ошибке
	TST	LYGIS
	BEQ	MONERR		; LYGIS=0 - прямой режим (программа не выполняется) =>
	BMI	RUNERR		; LYGIS<0 - ошибка во время выполнения программы =>
	TSTB	LYGIS
	BEQ	MONERR
; LYGIS>0: ошибка при разборе/компиляции строки, введённой в редакторе текста
; программы (не RUN) - оборвать компиляцию этой строки и остаться в редакторе.
	CALL	CLRCOD		; отбросить частично скомпилированный код строки
	MOV	NUMBER,R5
	MOV	R5,CURLIN
	CALL	ATLIN1
	TSTB	LYGIS
	BMI	TREND		; => вернуться как обычно (RTI)
	BR	COMERR

; Ошибка во время выполнения программы (LYGIS<0). Если для этого кода ошибки
; зарегистрирован обработчик ON TRAP(код) GOSUB (см. COMP.MAC/ON::) - перейти
; на него; иначе (или если ошибка 13 - "Redo from start" не в INPUT) обычная
; обработка ошибки.
RUNERR:	CMPB	R2,#13.		; ошибка 13 (несоответствие типа при вводе)?
	BNE	10$
	TST	DATINP		; идёт INPUT (а не READ)?
	BEQ	GETERR		; да - вернуться и повторить ввод =>
10$:	TST	SAVJMP		; зарегистрирован обработчик ON TRAP?
	BEQ	1$		; нет =>
	MOV	SAVJMP,R4	; да - R4 = адрес строки-обработчика
	CLR	SAVJMP		; сработает один раз
1$:	CMP	R4,STRREG	; адрес обработчика в пределах программы?
	BHI	MONERR		; нет - в монитор =>
	JSR	R2,SEPAP
	CALL	NOSTOP		; снять флаг STOP (можно продолжать)
	CALL	LNUM
	MOV	R2,CURLIN
	CALL	TRTOPL		; найти начало строки-обработчика в тексте программы
	CMP	-(4),-(4)
	JSR	R0,SETST	; разрешить/найти адрес кода этой строки
	BR	2$		; строка уже скомпилирована - использовать её адрес =>
	CLR	ADRHLT		; ещё не скомпилирована - запуститься с начала после компиляции
	BR	3$
2$:	MOV	@R4,ADRHLT	; ADRHLT = куда передать управление (на обработчик ON TRAP)
3$:	CLR	LYGIS
	CALL	STOPEN		; разрешить последующий CONT
	BR	COMERR

; Ошибка в прямом режиме (не в программе): вывести перевод строки и вернуться
; в основной цикл монитора (приглашение OK).
MONERR::MOV	#12,R0		; #12 = LF (перевод строки)
	CALL	ISV		; вывести символ
COMERR:	MOV	#STACK,SP	; сбросить стек
COMER2:	JMP	SETW		; в основной цикл монитора

; Ошибка при INPUT: вывести перевод строки и вернуться в прерванную
; программу (не сбрасывая её), чтобы повторить ввод.
GETERR:	MOV	#12,R0		; #12 = LF (перевод строки)
	CALL	ISV		; вывести символ
	BR	TREND		; вернуться в программу (см. TRAP::)
;
; Слово "ОШИБКА" на КОИ8-Р (кириллица, старший бит установлен - см. .KOI87 ниже),
; байт 7 - завершающий разделитель, как в таблице MESS.
ERR:	.BYTE	'O+200,'[+200,'I+200,'B+200,'K+200,'A+200,' ,7
	.EVEN
;
; Таблица адресов обработчика TRAP
ATRAP::	.WORD	T100		; парсинг выражения
	.WORD	T101		; сравнение символа со списком вариантов
	.WORD	T102		; классификация символа: буква/цифра/иначе
	.WORD	T103		; ссылка на переменную/элемент массива
	.WORD	T104		; поиск/создание переменной в таблице
	.WORD	T105		; разбор имени (+суффикс типа, встроенная функция?)
	.WORD	T106		; конец оператора
	.WORD	T107		; список переменных через запятую (DIM, NEXT)
	.WORD	T110		; разбор номера строки
	.WORD	T111		; поиск номера строки в таблице строк программы
	.WORD	T112		; пропуск пробелов
	.WORD	T113		; сравнение с ключевым словом (со списком слов)
	.WORD	T114
	.WORD	T115		; разбор строкового аргумента (имя файла и т.п.)
	.WORD	T116		; необязательный аргумент через запятую
	.WORD	T117		; разбор цифр (с одной десятичной точкой)
	.WORD	T120		; строковый литерал в кавычках?
	.WORD	T121		; параметр DEF FN (если имя совпадает)?
	.WORD	T122		; строковый литерал в кавычках (PRINT)?
	.WORD	T123		; три целых выражения через запятую
	.WORD	T124		; два целых выражения через запятую
	.WORD	T125		; одно целое выражение
	.WORD	T126		; обязательная запятая
	.WORD	T127		; (
	.WORD	T130		; )
;
RWMOD:	.ASCII	/MOD /
RWLOG:	.ASCII	/NOT IMP EQV XOR OR AND /
FUN:	.ASCII	/PI POINT INP PEEK /
	.ASCII	/RND SQR SIN COS TAN ATN /
	.ASCII	/EXP LOG INT FIX ABS SGN /
	.ASCII	/CSNG CINT /
	.ASCII	/EOF CSRLIN POS LPOS FRE LEN ASC VAL /
	.ASCII	/INSTR VARPTR /
	.ASCII	/USR FN /
SFUN:	.ASCII	/INKEY MID STRING STR CHR BIN OCT HEX /
RELAT:	.BYTE	'=,'>,'<,0
PLMI::	.BYTE	'+,'-,0
; Символы для TRAP 101: PRSPEC - спецсимволы, с которых может начинаться
; элемент PRINT (кавычка строки, число); DGDL - '/','*' (деление/умножение);
; TYPCHR - суффиксы типа в конце имени: $ (строка), ! (вещественное), % (целое).
PRSPEC::.BYTE	'"
	.BYTE	'&,'.,'(,0
DGDL:	.BYTE	'/,'*,0
TYPCHR::.BYTE	'$,'!,'%,0
	.EVEN
;
ADDRBR::.WORD	EQ,GT,LT,GE,LE,NE,0
;
ADLOG::	.WORD	IMP,EQV,XOR,OR,AND
;
; Разбор выражений методом рекурсивного спуска по уровням приоритета
; (каждый уровень вызывает следующий, более высокий по приоритету):
;   T100  - NOT, затем AND/OR/XOR/IMP/EQV (логика)
;   SANT  - отношения =,<>,<,>,<=,>= (даёт целое 0/-1)
;   SUDAT - сложение/вычитание +,-
;   LIEK  - MOD
;   SDAL  - целочисленное деление \
;   DAUG  - унарный знак, умножение/деление *,/
;   LAIPS - возведение в степень ^
;   OPER  - первичное выражение: число, строка, переменная, (выражение), функция
;
; TRAP 100 - вычислить выражение (верхний уровень, логические операции).
T100:
	CMP	SP,#500
	BLO	5$
	MOV	#-1,R5
1$:	MOV	R5,-(SP)
	CALL	SANT		; уровень отношений
	TRAP	113		; ключевое слово AND/OR/XOR/IMP/EQV?
	.WORD	RWLOG+4
	.BYTE	3,10
	BR	4$		; нет - выражение окончено =>
	CALL	CINT
2$:	CMP	R5,@SP
	BGT	1$
	MOV	(SP)+,R2
	MOV	ADLOG(R2),(R1)+
	BR	2$
3$:	CALL	CINT
	MOV	ADLOG(R2),(R1)+	; опкод логической операции (см. ADLOG)

4$:	MOV	(SP)+,R2
	BGE	3$
	RETURN
5$:	TRAP	16.		; переполнение стека компилятора (слишком сложное выражение)
;
; SANT - уровень отношений: сравнение (=,<>,<,>,<=,>=) двух сумм (SUDAT).
SANT:	TRAP	112		; пропуск пробелов
	CLR	-(SP)
	TRAP	113		; ведущее NOT?
	.WORD	RWLOG,3
	INC	@SP
	TRAP	115		; строковое сравнение целиком (спец. случай)?
	BR	1$		; нет - обычное выражение =>
	CALL	LYGOP
	BCS	10$
	TRAP	115
10$:	TRAP	13.
	MOV	#$CMP,(R1)+	; опкод $CMP (сравнение строк)
	BR	7$
1$:	CALL	SUDAT		; левый операнд - сумма
2$:	CALL	LYGOP		; есть ли знак отношения (=,<>,<,>,<=,>=)?
	BMI	8$		; нет =>
	MOV	R2,-(SP)
	MOV	TYPE,-(SP)
	CALL	CSNG
	MOV	R1,-(SP)
	CALL	SUDAT		; правый операнд - сумма
	MOV	(SP)+,R4
	TST	(SP)+
	BEQ	4$
	TST	TYPE
	BEQ	5$
	CALL	SUSP
	MOV	#ICMP,(R1)+	; опкод ICMP (сравнение целых)
	BR	6$
4$:	CALL	CSNG
5$:	MOV	#SCMP,(R1)+	; опкод SCMP (сравнение вещественных)
6$:	MOV	(SP)+,R2
7$:	MOV	#1,TYPE
	MOV	ADDRBR (R2),(R1)+	; опкод конкретного отношения (см. ADDRBR)
	BR	2$
8$:	TST	(SP)+
	BNE	9$		; было ведущее NOT =>
	CALL	CINT
	MOV	#NOT,(R1)+	; опкод NOT
9$:	RETURN
;
; LYGOP - разобрать знак отношения (=,<>,<,>,<=,>=), индекс в R2 (см. ADDRBR).
; Пробует один символ (=,>,<) через RELAT; если это начало двухсимвольного
; знака (<=,>=,<>) - смотрит второй символ тем же способом и объединяет оба
; совпадения в итоговый индекс R2. Если первого символа не нашлось - R4
; получает отрицательное значение (COM отрицательного -2), сообщая
; вызывающему (SANT: BMI), что знака отношения нет.
LYGOP:	TRAP	101		; первый символ - один из =,>,<?
	.WORD	RELAT
	BR	1$		; нет =>
	MOV	R4,R2		; да - R2 = индекс первого символа
	TRAP	101		; второй символ - тоже один из =,>,<?
	.WORD	RELAT
	RETURN			; нет - однознаковое отношение (R2 уже готов)
	CMP	R4,R2		; да - совпал с тем же символом (напр. "<<")?
	BEQ	2$		; да - недопустимо =>
	CMP	(R4)+,(R4)+
	ADD	R4,R2		; объединить оба индекса в итоговый (двухсимвольный знак)
	RETURN
1$:	COM	R4		; символа отношения нет - R4 положительный (см. SANT: BMI)
	RETURN
2$:	TRAP	2		; ошибка синтаксиса
;
; SUDAT - уровень сложения/вычитания: сумма слагаемых уровня LIEK (MOD).
SUDAT:	CALL	LIEK
3$:	TRAP	101		; следующий символ '+' или '-'?
	.WORD	PLMI
	RETURN			; нет - выражение окончено
	MOV	TYPE,-(SP)
	MOV	R4,-(SP)
	CALL	CSNG
	MOV	R1,-(SP)
	CALL	LIEK
	MOV	(SP)+,R4
	MOV	(SP)+,R2
	TST	(SP)+
	BEQ	1$
	TST	TYPE
	BEQ	2$
	CALL	SUSP
	CMP	(R2)+,(R2)+
	BR	2$
1$:	CALL	CSNG
2$:	MOV	APLMI(R2),(R1)+	; опкод сложения/вычитания (см. APLMI)
	BR	3$
;
; LIEK - оператор MOD (остаток от деления целых).
LIEK:	CALL	SDAL
1$:	TRAP	113		; ключевое слово MOD?
	.WORD	RWMOD
	.WORD	3
	RETURN			; нет =>
	CALL	CINT
	CALL	SDAL
	CALL	CINT
	MOV	#MOD,(R1)+	; опкод MOD
	BR	1$
;
; SDAL - оператор \ (целочисленное деление).
SDAL:	CALL	DAUG
1$:	TRAP	112		; пропуск пробелов
	CMPB	@R3,#'\	; символ '\'?
	BNE	D3		; нет =>
	INC	R3
	CALL	CINT
	CALL	DAUG1
	CALL	CINT
	MOV	#IDIV,(R1)+	; опкод IDIV
	BR	1$
;
; DAUG - унарный знак и умножение/деление *,/ (уровень LAIPS - возведение в степень).
DAUG:	CLR	-(SP)
	TRAP	101		; ведущий '+' или '-'?
	.WORD	PLMI
	BR	DAUG2		; нет =>
	MOV	R4,@SP
	BR	DAUG2
DAUG1:	CLR	-(SP)

DAUG2:	CALL	LAIPS
	TST	(SP)+
	BEQ	D2
	TST	TYPE
	BEQ	D1
	MOV	#INEG,(R1)+	; опкод INEG (смена знака, целое)
	BR	D2
D1:	MOV	#NEG,(R1)+	; опкод NEG (смена знака, вещественное)
D2:	TRAP	101		; символ '*' или '/'?
	.WORD	DGDL
D3:	RETURN			; нет =>
	MOV	TYPE,-(SP)
	MOV	R4,-(SP)
	CALL	CSNG
	MOV	R1,-(SP)
	CALL	LAIPS
	MOV	(SP)+,R4
	MOV	(SP)+,R2
	BEQ	1$
	TST	@SP
	BEQ	1$
	TST	TYPE
	BEQ	2$
	CALL	SUSP
	TST	(R2)+
	BR	2$
1$:	CALL	CSNG
2$:	MOV	ADGDL(R2),(R1)+	; опкод умножения/деления (см. ADGDL)
	TST	(SP)+
	BR	D2
;
; LAIPS - оператор ^ (возведение в степень).
LAIPS:	CALL	OPER
1$:	TRAP	112		; пропуск пробелов
	CMPB	(R3),#'^	; символ '^'?
	BNE	D3		; нет =>
	INC	R3
	CALL	CSNG
	CALL	OPER
	MOV	TYPE,R5
	ASL	R5
	MOV	APOW(R5),(R1)+	; опкод ROTG/ROTI (степень: вещественная/целая)
	CLR	TYPE
	BR	1$
;
APOW:	.WORD	ROTG,ROTI
;
; Скопировать компилированный код второго операнда (R4..R1) на место после
; первого - используется, когда порядок операндов при компиляции нужно
; поменять местами (напр. привести тип уже скомпилированного левого операнда).
SUSP:	MOV	R4,R5
	TST	-(R5)
3$:	MOV	(R4)+,(R5)+
	CMP	R4,R1
	BLO	3$
	TST	-(R1)
	RETURN
;
; OPER - первичное выражение: число (CISLO), строка, переменная, функция,
; (выражение в скобках, см. OP2).
; CISLO сама выбирает, куда вернуться (см. её комментарий в COMP.MAC):
; ни число/буква/'(' - ошибка; буква - переход на 3$ (разбор имени); '(' -
; переход на 2$ (выражение в скобках); число распознано - выполнение
; продолжается со следующей строки (R4=1 для &-чисел, R5=значение; R4=0
; и на стеке два слова от PACK - для обычных вещественных чисел).
OPER:
	CALL	CISLO		; попытаться разобрать число
	TRAP	24.	;SPEC	; ни число, ни имя, ни '(' - нет операнда

	BR	3$	;RAIDE	; это имя (переменная/функция) =>
	BR	2$	; (	; это выражение в скобках =>
	MOV	R4,TYPE		; число распознано: R4=1 - целое (&-число), 0 - вещественное
	BNE	13$		; целое =>
	MOV	#SCONST,(R1)+	; вещественное - опкод SCONST (константа-float)
	MOV	2(SP),(R1)+	; записать в код старшее слово числа (с стека PACK)
	MOV	(SP)+,(R1)+	; и младшее слово
	TST	(SP)+
	RETURN
13$:	MOV	#ICONST,(R1)+	; опкод ICONST (целая константа)
	MOV	R5,(R1)+	; значение
	RETURN
2$:
	JMP	OP2		; => разбор "(выражение)"
; Имя разобрано TRAP 105. Если это встроенная функция (таблица FUN/SFUN) -
; переход на 31$; иначе - обычная переменная/элемент массива (TRAP 103).
3$:
	TRAP	105		; разобрать имя (+ тип), сравнить со списком встроенных функций
	BR	31$		; совпало с именем функции =>
	TRAP	13.
	TRAP	13.
	TRAP	121		; обычная переменная - проверки типа/массива
	TRAP	103		; скомпилировать ссылку на переменную/элемент массива
30$:	RETURN
31$:				; R5 - индекс совпавшей функции
	CMP	R5,#66	;-2 BE INSTR
	BLT	4$		; простая встроенная функция одного аргумента =>
	BEQ	34$	;TIK SU VARPTR	; это VARPTR =>
	CALL	USR	;USR IR FN	; USR(n) или FN имя(...)
	BMI	32$
	RETURN
32$:	TRAP	13.
;
; VARPTR(переменная) - вернуть адрес переменной как целую константу.
;----------TIK SU VARPTR------------
33$:	TRAP	5		; ошибка - переменная не указана
34$:	TRAP	127		; (
	CLR	R4
	TRAP	107		; разобрать имя переменной (одну)
	NOP
	TST	R5
	BEQ	33$		; имя не разобрано =>
	MOV	#1,TYPE
	TSTB	R5
	BMI	36$		; элемент массива (адрес уже готов) =>
	MOV	#ICONST,(1)+	; обычная переменная - опкод ICONST
	MOV	R4,(1)+		; значение - её адрес
36$:	JMP	OP3		; => проверить закрывающую ')'
;------------------------------------
;
; Компиляция вызова встроенной функции (не USR/FN, не VARPTR): в зависимости
; от того, какая именно функция (число R5 - её индекс/код в таблице), разбирает
; аргумент(ы) в скобках - число, строку или комбинацию (особый случай INSTR,
; у которой три параметра). Точные границы диапазонов R5 ниже привязаны
; к порядку функций в таблицах FUN/SFUN (см. AFUN и .ASCII FUN/SFUN выше).
4$:	MOV	R5,-(SP)	; сохранить индекс функции
	BEQ	6$		; индекс 0 (PI) - без аргументов и без скобок =>
	CMP	R5,#44
	BLT	5$
	CMP	R5,#56
	BGE	40$
	INC	TYPE
	CMP	R5,#44
	BEQ	6$
	CMPB	@R3,#'(

	BNE	6$
	SUB	#60,R5
	ADD	R5,@SP
40$:	ADD	#22,@SP
	TRAP	127		; (
	CMP	@SP,#70
	BGT	42$
41$:	TRAP	100
	MOV	TYPE,R5
	MOV	#1,TYPE
	ASL	R5
	ADD	@SP,R5
	BR	46$
; INSTR([начало,] строка1, строка2) - особый случай: 2 или 3 аргумента,
; первый необязательный числовой (позиция начала поиска), остальные строковые.
42$:	TRAP	122		; аргумент - строка?
	BR	47$		; нет (число - это необязательное "начало") =>
	CLR	TYPE
	CMP	@SP,#104
	BEQ	45$
;
;---------TIK SU INSTR--------
	BLT	44$
	TRAP	126		; обязательная запятая перед вторым аргументом
	TRAP	115		; второй аргумент - строка
43$:	TRAP	13.
	CLR	TYPE
;------------------------------
44$:	INC	TYPE
45$:	MOV	@SP,R5
46$:	TRAP	130		; )
	BR	6$
47$:	ADD	#2,@SP
	CMP	@SP,#74
	BEQ	41$
	CMP	@SP,#110
	BNE	43$	;BE INSTR 32$
;
;----------TIK SU INSTR-----------
	TRAP	125		; INSTR(начало, ...) - позиция начала поиска
	TRAP	126		; обязательная запятая
	BR	42$		; => разобрать первую строку как обычно
;---------------------------------
48$:	TRAP	124
	BR	45$
49$:	TRAP	125
	BR	45$
5$:	TRAP	127		; (
	CMP	R5,#6
	BLT	48$
	BEQ	49$
	TRAP	100
	TRAP	130		; )
	MOV	(SP),R5
	CMP	R5,#26
	BLE	52$
	MOV	TYPE,R4
	ASL	R4
	CMP	R5,#36

	BGT	7$	;CSNG,CINT
	BNE	51$
	TST	(R4)+	;SGN
50$:	ADD	R4,R5
	BR	6$
51$:	CMP	R5,#34
	BEQ	50$	;ABS
	TST	R4	;INT,FIX
	BNE	60$
52$:	CALL	CSNG
6$:	MOV	AFUN(R5),(R1)+
60$:	TST	(SP)+
	RETURN
7$:	SUB	#40,R5
	CALL	@ATCONV(R5)
	BR	60$

; OP2 - "(выражение)": разобрать вложенное выражение целиком и проверить ')'.
OP2:	TRAP	100		; разобрать выражение внутри скобок
;
; TRAP 130 - проверить закрывающую скобку ')' (совпадает с точкой возврата OP2/OPER).
T130:
OP3:	CMPB	(R3)+,#')	; ')' на месте?
	BEQ	SKLUZ		; да - пропустить пробелы и вернуться =>
OP4:	TRAP	2		; нет - ошибка синтаксиса
;
; TRAP 127 - проверить открывающую скобку '('.
T127:
	TRAP	112		; пропуск пробелов
	CMPB	(R3)+,#'(	; '(' на месте?
	BNE	OP4		; нет - ошибка синтаксиса
SKLUZ:	TRAP	112		; пропуск пробелов
	RETURN
;
; CINT - привести тип текущего выражения (TYPE) к целому.
; TYPE - тип текущего компилируемого выражения: 0 - вещественное, ненулевое -
; целое. CINT/CSNG приводят его к нужному типу, вставляя опкод преобразования
; RI/IR в код только если тип фактически меняется.
CINT::	TST	TYPE
	BNE	1$		; уже целое =>
	MOV	#RI,(R1)+	; вещественное - вставить опкод RI (вещ.->цел.)
	INC	TYPE
1$:	RETURN
;
; CSNG - привести тип текущего выражения (TYPE) к вещественному.
CSNG::	TST	TYPE
	BEQ	1$		; уже вещественное =>
	MOV	#IR,(R1)+	; целое - вставить опкод IR (цел.->вещ.)
	CLR	TYPE
1$:	RETURN

;
; TRAP 101 - сравнить текущий символ с коротким списком однобайтовых
; вариантов. Операнд после TRAP: адрес таблицы байт-символов, оканчивающейся
; нулевым байтом (см. PLMI, RELAT, DGDL, TYPCHR, PRSPEC, TYPBOH и др.).
; При совпадении символ съедается (R3++), пропускается слово после TRAP у
; вызывающего, и R4 = номер совпавшего варианта*2 (0,2,4,...). Если совпадения
; нет - слово не пропускается, R4 = -2.
T101:	TRAP	112		; пропуск пробелов
	MOV	(R0)+,R2	; R2 = адрес таблицы символов (операнд после TRAP)
	MOV	#-2,R4		; R4 = -2 (пока ничего не совпало)
1$:	TSTB	@R2		; конец таблицы (нулевой байт)?
	BEQ	2$		; да - совпадения нет =>
	ADD	#2,R4		; R4 += 2 (номер очередного варианта)
	CMPB	(R2)+,@R3	; совпадает с текущим символом?
	BNE	1$		; нет - проверить следующий вариант =>
	INC	R3		; да - съесть символ
	TST	(R0)+		; пропустить слово-операнд у вызывающего (см. TRAP::)
2$:	RETURN
;
; MZ - текущий символ строчная буква (a-z): сделать заглавной (снять бит
; регистра) и заново классифицировать через T102.
MZ:	BICB	#40,@R3
; TRAP 102 - классифицировать текущий символ (не сдвигая R3): буква (A-Z,
; a-z) - пропустить 1 слово у вызывающего; цифра (0-9) - пропустить 2 слова;
; иначе - не пропускать ничего. См. использование в CISLO, T110, T117 и др.
T102:
	MOVB	@R3,R4
	CMPB	R4,#172		; > 'z' ?
	BHI	2$		; да - не буква/цифра =>
	CMPB	R4,#140		; > '`' (т.е. 'a'..'z') ?
	BHI	MZ		; да - строчная буква =>
	CMPB	R4,#132		; > 'Z' (т.е. '['..'`') ?
	BHI	2$		; да - не буква/цифра =>
	CMPB	R4,#100		; > '@' (т.е. 'A'..'Z') ?
	BHI	1$		; да - заглавная буква =>
	CMPB	R4,#71		; > '9' (т.е. ':'..'@') ?
	BHI	2$		; да - не буква/цифра =>
	CMPB	R4,#60		; < '0' ?
	BLO	2$		; да - не буква/цифра =>
	TST	(R0)+		; иначе '0'..'9' - цифра: пропустить ещё слово
1$:	TST	(R0)+		; буква (или продолжение случая с цифрой): пропустить слово
2$:	RETURN

;
; TRAP 103 - скомпилировать ссылку на переменную или элемент массива
; (имя уже разобрано вызывающим, напр. TRAP 105/107). Если за именем следует
; '(' - разбирает список индексов через запятую (TRAP 125 - целые выражения)
; и компилирует обращение к элементу массива; иначе - к простой переменной.
; TRAP 104 заводит/находит имя в таблице переменных программы.
T103:
	TRAP	112		; пропуск пробелов
	CLR	R2		; R2 = число индексов (0 - не массив)
	CMPB	@R3,#'(		; '(' - есть индексы (элемент массива)?
	BNE	2$		; нет - простая переменная =>
	TST	(R4)+
	INC	R3		; съесть '('
	MOV	TYPE,-(SP)
	MOV	R5,-(SP)
	MOV	R4,-(SP)
; Разбор списка индексов через запятую.
	TRAP	125		; индекс - целое выражение
6$:	TRAP	116		; есть ли ещё один индекс (,индекс)?
	BR	1$		; нет =>
	INC	R2		; да - ещё один индекс
	CALL	CINT
	BR	6$
1$:	MOV	(SP)+,R4
	MOV	(SP)+,R5
	MOV	(SP)+,TYPE
	TRAP	130		; )
	BR	8$
2$:	TST	R4
	BEQ	7$		; простая переменная =>
8$:	INC	R2
	BIS	#200,R5		; отметить: это элемент массива
	BIC	#100000,R5
	BR	4$
7$:				; простая переменная - выбрать опкод по типу (TYPE)
	MOVB	TYPE,R4
	INC	R4
	ASL	R4
	BEQ	4$
	TST	(R4)+
4$:	MOV	AKINPP(R4),(R1)+	; опкод ссылки на переменную/массив (см. AKINPP)
	TRAP	104		; найти/завести переменную в таблице переменных
	MOV	R4,(R1)+	; адрес переменной
	TSTB	R5
	BPL	3$		; не массив - готово =>
	MOV	R2,(R1)+	; массив - записать число индексов
	MOV	TYPE,R2
	INC	R2

	ASL	R2
9$:
	MOV	AXKINP(R2),(R1)+	; доп. опкод вычисления адреса элемента (по типу)
3$:	RETURN
;
AKINPP:	.WORD	$VAR,	INDEX
	.WORD			SVAR,	IVAR
	.WORD	ARR10,	ARRAY
;
AXKINP:	.WORD	$XVAR,SXVAR,IXVAR

;
; TRAP 104 - найти переменную с именем R5 (упаковано в слово) в таблице
; переменных программы (от LENT до TABTOP); если не найдена и идёт
; компиляция - завести новую запись (расширить таблицу, LENT растёт вверх
; к TABTOP). R4 на выходе - адрес найденной/созданной записи (слова со
; значением, сразу после слова имени).
T104:	MOV	LENT,R4
1$:	CMP	R4,TABTOP	; конец таблицы?
	BHIS	2$		; да - не найдена =>
	CMP	R5,@R4		; имя совпадает?
	BEQ	3$		; да - найдена =>
	TST	(R4)+		; нет - к следующей записи: пропустить имя+флаги
	BMI	11$		; запись массива (доп. слово размера) =>
10$:	TST	(R4)+
11$:	TST	(R4)+
	BR	1$
2$:	TST	LYGIS
	BMI	50$		; выполняется программа (не компиляция) - создавать нельзя =>
	MOV	LENT,R4
	CMP	-(4),-(4)	; зарезервировать место под имя+значение (и, для массива, флаги)
	TST	R5
	BMI	20$		; массив =>
	TST	-(4)		; скаляр - ещё одно слово (флаги)
20$:	CMP	R4,R1		; хватает памяти (не залезли на буфер кода)?
	BLOS	4$		; нет =>
	MOV	R4,LENT		; да - зафиксировать новый конец таблицы переменных
	MOV	R4,LIMIT
	MOV	R4,CIKL
	MOV	R4,R2
	MOV	R5,(2)+		; записать имя
	BMI	33$		; массив =>
30$:	CLR	(R2)+		; скаляр - обнулить слово флагов
33$:	CLR	(R2)+		; обнулить слово значения
	TSTB	R5		; имя строковое ($ в конце)?
	BPL	3$		; нет =>
	MOVB	#2,-(R2)	; да - отметить тип "строка" в слове флагов
	TST	TYPE
	BGT	3$
	BMI	35$
	INCB	@R2
35$:	INCB	@R2
3$:	TST	(4)+		; R4 -> слово значения (после имени)
	RETURN
50$:	CLR	R4		; не найдена, создать нельзя - R4=0
	RETURN
4$:	TRAP	7		; не хватает памяти под переменные

;
; TRAP 105 - разобрать идентификатор: имя переменной/функции, необязательный
; суффикс типа ($ строка, ! вещественное, % целое). Сначала проверяет, не
; совпадает ли имя со встроенной функцией (таблицы FUN/SFUN): если да, R5 -
; индекс функции (FUN - числовые/общие функции, SFUN - строковые, требуют
; после имени '$'), возврат сразу. Иначе - обычная переменная: R5 = имя,
; упакованное в слово (первые символы + признак типа), TYPE - тип по суффиксу.
; Граница между FUN и SFUN в индексе (74) и число слов в .BYTE 6,112
; жёстко привязаны к порядку и числу имён в таблицах FUN/SFUN выше.
T105:	MOV	R3,-(SP)	; запомнить начало имени
	CLR	TYPE
	TRAP	102		; первый символ - буква?
	TRAP	5		; нет (и не цифра) - ошибка "ожидалось имя"
	BR	10$		; буква =>

	TRAP	5		; цифра первой в имени - тоже ошибка
10$:	TRAP	113		; сравнить с именами встроенных функций (FUN)
	.WORD	FUN
	.BYTE	6,112		;110,106
	BR	2$		; не встроенная функция - обычная переменная =>
	TST	(SP)+		; встроенная функция - имя уже съедено, старая позиция не нужна
	CMP	R5,#74		;72,70	; индекс в диапазоне SFUN (строковые функции)?
	BLT	1$		; нет, обычная (FUN) - готово =>
	SUB	#74,R5		;72,70	; да - индекс внутри SFUN
	CMPB	(R3)+,#'$	; после имени обязателен '$'
	BEQ	6$
	TRAP	13.
; Обычная переменная: упаковать первые символы имени в R5, TYPE - по суффиксу.
2$:	MOV	(SP)+,R3	; вернуться к началу имени
	CMP	(R0)+,(R0)+
	CLR	R5		;MOV	#20000,R5	TRACE
	BISB	(R3)+,R5	; R5 = первый символ имени
	BIC	#100,R5
	SWAB	R5
	TRAP	102		; следующий символ - буква/цифра?
	BR	4$		; нет - имя из одного символа =>
	NOP			;CLRB	R5		TRACE
	BISB	(R3),R5		; R5 |= второй символ имени (в младший байт)
	BIC	#100,R5
3$:	INC	R3
	TRAP	102		; ещё символ буква/цифра?
	BR	4$		; нет - конец имени =>
	BR	3$		; да - пропустить (учитываются только первые 2 символа)
	BR	3$
4$:	TRAP	101		; суффикс типа: $, ! или %?
	.WORD	TYPCHR
	BR	6$	;8$	SU DEFTYP	; нет суффикса - тип по умолчанию (вещественный) =>
9$:	ADD	R4,PC		; переход по тому, какой суффикс совпал
	BR	5$	;$		; '$' - строка =>
	BR	6$			; '!' - вещественное (как по умолчанию) =>
	BIS	#140000,R5	;%	; '%' - целое: отметить в упакованном имени
	INC	TYPE
6$:	TST	(R0)+
1$:	RETURN
;8$:	MOV	R5,R4
;	CLRB	R4
;	SWAB	R4
;	MOVB	APRL-1(R4),R4
;	BR	9$
5$:	BIS	#20000,R5
	DEC	TYPE
	RETURN

APLMI::	.WORD	ADR,SUB,SUM,SKIRT
ADGDL::	.WORD	DVR,MLR,SAND
AFUN::	.WORD	PI,POINT,INP,PEEK,RAN,SQRG,SING,KOS,TANG,ATANG,EXPG
	.WORD	ALNG,INT,SVD1
	.WORD	ABS,IABS,SGN,ISGN
	.WORD	EOF,LOCY,LOCX,LPOS,FRE
	.WORD	SLOCY,ILOCY,SLOCX,ILOCX
	.WORD	SLPOS,ILPOS,$FRE,SFRE,IFRE
	.WORD	LEN,ASC,VAL,INSTR2,INSTR
;
; TRAP 106 - проверить конец оператора: после пропуска пробелов текущий
; символ должен быть концом строки (LF) или началом комментария ('), иначе
; ошибка синтаксиса ("Лишние данные"/непредвиденный символ в конце оператора).
T106:
	TRAP	112		; пропуск пробелов
	TST	4(SP)
	BEQ	2$
	CMPB	@R3,#12		; конец строки (LF)?
	BEQ	2$
	CMPB	@R3,#''		; символ комментария '?
	BNE	1$		; ни то, ни другое - ошибка =>
2$:	RETURN
1$:	TRAP	2
;
; TRAP 107 - разбор списка переменных через запятую (DIM, NEXT).
; R4 - счётчик/лимит от вызывающего кода. Каждая переменная компилируется через TRAP 103.
T107:
	MOV	R4,R2		; R2 = сохранённый лимит/счётчик от вызывающего
	TRAP	112		; пропуск пробелов
	TRAP	102		; первый символ буква?
	TRAP	2		; нет (и не цифра) - ошибка "ожидалось имя"
	BR	2$		; буква - разобрать имя =>
3$:	TRAP	2		; цифра первой в имени - тоже ошибка
1$:	SUB	#2,R5		; (цикл продолжения списка) R5 -= 2
	BNE	3$
	RETURN
2$:	TRAP	105		; разобрать имя переменной
	TRAP	2		; имя совпало со встроенной функцией - ошибка (не может быть переменной)
	BR	1$		; имя переменной разобрано => к продолжению списка
; Ниже - код, недостижимый от TRAP 105 выше (у него только 2 варианта
; возврата, оба уже обработаны); похоже на неиспользуемый/устаревший фрагмент.
	TST	-(R0)
	TST	(R0)+
	TRAP	121
	BR	5$
	CMP	-(1),-(1)
	MOV	#APAR,(1)+
	MOV	-6(4),(1)+
	NEGB	R5
	RETURN
5$:	MOV	R2,R4		; R4 = лимит (передаётся в TRAP 103 как параметр)
	TRAP	103		; скомпилировать ссылку на переменную/элемент массива
	TSTB	R5
	BMI	4$		; элемент массива =>
	TST	-(R1)		; обычная переменная - убрать лишнее записанное слово
4$:	TST	-(R1)
	RETURN
;
; TRAP 110 - разбор номера строки (для GOTO/GOSUB/RUN/RESTORE и т.п.).
; Накапливает цифры в R5 (R5 = R5*10 + цифра), проверяет переполнение (>14631 - максимум).
; Через возврат-со-сдвигом R0 сообщает вызывающему коду, был ли номер строки указан.
T110:	CLR	R5
	TRAP	112		; пропуск пробелов
	TRAP	102		; первый символ буква/цифра/иначе?
	RETURN			; не буква, не цифра - номера нет
	RETURN			; буква - тоже не номер (это идентификатор)
1$:	SUB	#60,R4		; цифра - значение цифры
	INC	R3		; съесть символ
	ASL	R5		; R5 = R5*10 + цифра (через сдвиги: *8 + *2)
	ADD	R5,R4
	ASL	R5
	ASL	R5
	ADD	R4,R5
	BCS	2$		; переполнение =>
	TRAP	102		; следующий символ буква/цифра/иначе?
	BR	3$		; не буква, не цифра - число кончилось =>
	BR	3$		; буква - тоже конец числа =>
	CMP	R5,#14631	; цифра - в пределах максимального номера строки?

	BLOS	1$		; да - продолжить накопление =>
2$:
	MOV	16(SP),R4	;12?!
	TRAP	6		; ошибка - слишком большой номер строки
3$:	TST	(R0)+		; хотя бы одна цифра была - номер строки получен
	RETURN
;
; TRAP 111 - поиск номера строки R5 в таблице строк программы (FCB..TABTOP).
; Используется вслед за TRAP 110, чтобы проверить, что строка с таким номером существует.
T111:
	MOV	FCB,R4		; начать с последней строки программы (FCB)
	TST	-(R4)
1$:	CMP	R4,TABTOP	; вышли за начало таблицы строк?
	BLO	2$		; да - не найдена =>
	CMP	R5,(R4)		; номер строки этой записи совпадает?
	BEQ	3$		; да - найдена, вернуться без пропуска слова =>
	BLO	2$		; уже прошли нужный номер (строки не существует) =>
	SUB	#6,R4		; нет - к предыдущей строке (запись - 3 слова)
	BR	1$
2$:	TST	(R0)+		; не найдена - пропустить слово у вызывающего
3$:	RETURN

;
; TRAP 112 - пропустить пробелы (код 40 = пробел).
T112:	CMPB	(R3)+,#40	; пробел?
	BEQ	T112		; да - следующий символ =>
	DEC	R3		; не пробел - вернуть символ назад
	RETURN
;
; TRAP 113 - сравнение текущего слова во входном тексте со списком ключевых слов.
; Операнд после TRAP: адрес таблицы строк-ключевых слов (см. .T 113 / .WORD tbl / .BYTE n,default).
; При совпадении с i-м словом или при отсутствии совпадения (default) выбирает,
; на сколько слов вперёд возобновить выполнение после TRAP (через сдвиг R0) -
; так реализован разбор конструкций вида THEN/GOTO, TO/STEP и т.п.
; Таблица - строка слов через пробел, как в COMP.MAC (RWIF, RWFOR и т.п.).
; R1 (сохраняется/восстанавливается - в остальном коде это указатель на код!)
; используется здесь как рабочий регистр: отслеживает самое длинное из
; совпавших слов (на случай, когда одно слово - префикс другого в таблице).
T113:	MOV	R1,-(SP)	; сохранить R1 (используется ниже как рабочий регистр)
	MOV	R3,-(SP)	; сохранить начальную позицию в тексте
	MOV	#-1,-(SP)
	CLR	R1
	CLR	R5		; R5 = номер текущего слова в таблице
	MOV	(R0)+,R2	; R2 = адрес таблицы слов (операнд после TRAP)
	TRAP	102		; классифицировать первый символ
	TRAP	112
	BR	1$
	BR	14$		; не буква/цифра - сразу нет совпадения =>
1$:	CLRB	@SP
2$:	CMPB	(R3),(R2)+
	BNE	3$
	INC	R3
	INCB	@SP
	CMPB	@R2,#40		; конец слова в таблице (пробел)?
	BEQ	6$
	TRAP	102
	BR	3$
	BR	2$
3$:	DECB	@SP
	BLE	4$
	CMP	R1,R3
	BHI	4$
	BEQ	7$
	MOV	R3,R1		; запомнить более длинное совпадение
	MOVB	R5,1(SP)
4$:	MOV	2(SP),R3
	CMPB	R5,1(R0)
	BEQ	11$
5$:	CMPB	(R2)+,#40	; пропустить оставшуюся часть слова в таблице
	BNE	5$

	TST	(R5)+		; следующее слово таблицы
	BR	1$
7$:	MOV	#-1,@SP
	BR	4$
11$:	MOVB	1(SP),R5	; R5 = номер найденного (самого длинного) совпадения
	BMI	14$		; совпадений не было =>
	CMPB	@R0,#3
	BGE	14$
	MOV	R1,R3		; R3 = позиция сразу после совпавшего слова
6$:	TRAP	112		; пропуск пробелов после ключевого слова
	TST	(R0)+		; совпадение найдено - пропустить слово у вызывающего
14$:	TST	(R0)+		; операнд-счётчик после TRAP (см. .BYTE n,default) - пропустить
	CMP	(SP)+,(SP)+
	MOV	(SP)+,R1	; восстановить R1
	RETURN

;
; TRAP 114 - прочитать строку, введённую пользователем, в буфер BUFOUT
; (используется монитором - MONIT.MAC - для ввода строки программы/команды).
T114:	MOV	#BUFOUT,R3	; R3 = буфер для ввода строки
	CALL	I1		; прочитать строку с клавиатуры (полноэкранный редактор, IO.MAC)
	CALL	ISVEIL		; обновить/восстановить экран
	RETURN

;
; TRAP 115 - разобрать строковое выражение (аналог TRAP 100, но для строк):
; строковый литерал в кавычках (TRAP 120), строковая переменная/функция
; (TRAP 105 - совпадение со встроенной функцией через SIMUSR/SIMFUN, иначе
; обычная переменная), с последующей необязательной конкатенацией через '+'
; (опкод CONCAT). Используется для имён файлов, правой части LET для строк,
; тела строкового DEF FN и т.п. R2 отслеживает, нужна ли новая память под
; результат (NEWSTR) - если строка не просто копия существующей переменной.
T115:
	CMP	SP,#500
	BHIS	2$
	TRAP	16.		; переполнение стека компилятора
2$:	TRAP	112		; пропуск пробелов
	CLR	R2
	MOV	R3,-(SP)	; запомнить позицию (на случай неудачи - NOT$)
	TRAP	102		; классифицировать первый символ
	BR	1$		; не буква/цифра =>
	BR	6$		; буква =>
	BR	NOT$		; цифра - не может начинать строку =>
1$:	TRAP	120		; это строковый литерал в кавычках?
	BR	NOT$		; нет - не строковое выражение =>
	BR	S10		; да (уже скомпилирован) - к проверке конкатенации =>
6$:	TRAP	105		; разобрать имя (переменная или встроенная функция)
	BR	SIMUSR		; совпало со встроенной функцией (числовой/USR/FN группы) =>
	BR	SIMFUN		; иначе - переменная или строковая функция (SFUN) =>
	BR	8$
	BR	NOT$
8$:	TRAP	121
	TRAP	103		; скомпилировать ссылку на строковую переменную
	DEC	R2
; Проверка конкатенации: "выражение + выражение + ...".
S10:	TRAP	112		; пропуск пробелов
	TST	(SP)+
	CMPB	(R3),#'+	; символ '+' - конкатенация?
	BNE	2$		; нет - готово =>
	TST	R2
	BGT	3$
4$:	INC	R2
	BLE	4$
	MOV	#NEWSTR,(1)+	; первому операнду нужна новая память под результат
3$:	INC	R3		; съесть '+'
	TRAP	115		; разобрать следующее слагаемое (рекурсивно)
	TRAP	13.
	TST	R4
	BGT	1$
	MOV	#NEWSTR,(R1)+
1$:	MOV	#CONCAT,(R1)+	; опкод CONCAT (сложить строки)
2$:	TST	(R0)+		; строковое выражение успешно разобрано
	MOV	R2,R4
	RETURN

; Совпадение TRAP 105 со встроенной функцией из "числового" диапазона FUN:
; допустимо только если это на самом деле USR$/FN$ (строковый USR/FN);
; любая другая (числовая) встроенная функция здесь не может стоять.
SIMUSR:
	CMP	R5,#70	;USR$
	BLT	NOT$		; обычная числовая функция - недопустима =>
	MOV	R1,-(SP)
	CALL	USR
	BMI	S2
	MOV	(SP)+,R1
NOT$:	MOV	(SP)+,R3	; не строковое выражение - откатить позицию
	RETURN
S2:	TST	(SP)+
	INC	R2
	BR	S10
;
; Совпадение со строковой функцией (SFUN: INKEY,MID$,STRING$,STR$,CHR$,
; BIN$,OCT$,HEX$) - разобрать её аргументы. MID$ в правой части выражения
; (не как цель присваивания - см. LMID/COMP.MAC LET) обрабатывается здесь.
; Диспетчер строковых функций по индексу R5 (из таблицы SFUN, уже поделенному
; на 2 через ASR): 0=INKEY$, 1=MID$, 2=STRING$, 3=STR$, 4=CHR$, 5=BIN$,
; 6=OCT$, 7=HEX$. Каждая ветка вычитает своё смещение и проверяет остаток,
; чтобы определить, какая именно функция вызвана (S30/S40/S20 - общий код
; для похожих групп функций).
SIMFUN:	ASR	R5	;MID$
	BEQ	10$		; 0 - INKEY$ (без аргументов) =>
	TRAP	127		; ( - у остальных функций аргументы в скобках
	DEC	R5
	BNE	S30		; не MID$ (1) =>
	TRAP	115		; MID$(строка, ...) - первый аргумент строковый
	TRAP	13.
	MOV	R4,R2
1$:	CALL	MIDEND		; общий разбор позиции[,длины]) - см. LMID
	BR	S10
;
10$:	MOV	#INKEY,(R1)+	;INKEY$
	BR	S10
;
; CHR$(код)/BIN$(число)/OCT$(число)/HEX$(число) - один числовой аргумент,
; опкод по конкретной функции (см. ASFINT).
S20:	DEC	R5	;CHR$,BIN$,OCT$,HEX$
	ASL	R5
	MOV	R5,-(SP)	; запомнить индекс функции
21$:	TRAP	125		; аргумент - целое выражение
	MOV	(SP)+,R5
	MOV	ASFINT(R5),(R1)+	; опкод CHR/BIN/OCT/HEX
	BR	S33
;
; STRING$(число,строка_или_код) - строка из повторов символа.
S30:	DEC	R5	;STRING$
	BNE	S40		; не STRING$ (2) =>
	TRAP	125		; число повторов - целое выражение
	TRAP	126		; обязательная запятая
	TRAP	122		; второй аргумент - строка (берётся первый символ)?
	BR	31$		; нет, это код символа =>
	MOV	#ALLSM,(R1)+	; опкод ALLSM (повторить первый символ строки)
	BR	S32
31$:	TRAP	125		; код символа - целое выражение
	MOV	#ALLSK,(R1)+	; опкод ALLSK (повторить символ с данным кодом)
S32:	INC	R2
S33:	TRAP	130		; )
	BR	S10
;
; STR$(число) - преобразовать число в строку (по типу - SSTR/ISTR).
S40:	DEC	R5	;STR$
	BNE	S20		; не STR$ (3) - CHR$/BIN$/OCT$/HEX$ =>

	TRAP	100		; аргумент - выражение (любого числового типа)
	MOV	TYPE,R4
	ASL	R4
	MOV	ASTR(R4),(R1)+	; опкод SSTR (вещественное) или ISTR (целое)
	BR	S33
;
ASTR:	.WORD	SSTR,	ISTR	; STR$: вещественное -> строка / целое -> строка
ASFINT:	.WORD	CHR,	BIN,	OCT,	HEX	; CHR$/BIN$/OCT$/HEX$
;
; LMID - разбор "MID$(строка,позиция[,длина])" - и как цель присваивания
; (LET MID$(...)=...), и как вызов справа в выражении (TRAP 115/SIMFUN).
; TRAP 107 не пользуется механизмом пропуска слов (не трогает R0), поэтому
; "TRAP 13." ниже фактически недостижим (оставлен от более старой версии).
LMID::	TRAP	127		; (
	CLR	R4
	TRAP	107		; разобрать имя строковой переменной
	BR	10$
	TRAP	13.
10$:	TST	(R1)+		; пропустить слово только что записанной ссылки на переменную
	TSTB	R5		; переменная была элементом массива?
	BMI	MIDEND		; да =>
	TST	(R1)+		; нет (скаляр) - пропустить ещё одно слово ссылки
MIDEND:	MOV	R5,-(SP)
	TRAP	126		; обязательная запятая
	TRAP	125		; позиция - целое выражение
	TRAP	116		; есть ли ",длина"?
	BR	11$		; нет =>
	CALL	CINT
	MOV	#STR,(R1)+	; опкод STR (MID$ с указанной длиной)
	BR	12$
11$:	MOV	#STR2,(R1)+	; опкод STR2 (MID$ до конца строки)
12$:	TRAP	130		; )
	MOV	(SP)+,R5
	RETURN
;
; USR/USR$(аргумент) - вызов машинного подпроцесса, или FN имя(аргументы) -
; вызов пользовательской функции (DEF FN). R5 на входе - индекс из T105,
; используется здесь только чтобы отличить USR от FN (72 - индекс FN).
USR:	TRAP	112		; пропуск пробелов
	CLR	R2		; номер USR по умолчанию - 0
	TRAP	102		; символ после USR/FN: буква/цифра/иначе?
	BR	1$		; не буква/цифра (напр. сразу '(') =>
	BR	4$		; буква - это "FN имя(...)" =>
	MOVB	(R3)+,R2	; цифра - номер подпроцесса USR<n>
	SUB	#'0,R2
	ASL	R2
; USR[n](аргумент) - вызов машинного подпроцесса с одним числовым или
; строковым аргументом.
1$:	CMP	R5,#72	;-2(4) VARPTR,INSTR	; это на самом деле FN без имени?
	BEQ	SYNERR			; да - ошибка синтаксиса
	TRAP	127		; (
	TRAP	122		; аргумент - строковый литерал?
	BR	2$		; нет =>
	TST	R4
	BGT	3$
	MOV	#NEWSTR,(1)+	; строке нужна новая память
	BR	3$
2$:	TRAP	100		; аргумент - числовое выражение
3$:	MOV	#$USR,(R1)+	; опкод $USR
	MOV	R2,(R1)+	; номер подпроцесса
	TRAP	130		; )
	MOV	TYPE,(R1)+	; тип аргумента
	RETURN
; FN имя(аргументы) - вызов пользовательской функции (см. DEF FN, COMP.MAC).
4$:	CMP	R5,#72	;-2(4)	; действительно ключевое слово FN?
	BNE	SYNERR
	TRAP	105		; разобрать имя функции

	TRAP	2
	TRAP	2
	NOP
	BIS	#100,R5
	BIC	#100000,R5
	MOV	TYPE,-(SP)
	MOV	#-1,TYPE
	TRAP	104		; найти функцию по имени в таблице переменных
	MOV	R4,-(SP)	; адрес записи функции
	MOV	#FNST,(1)+	; опкод FNST (подготовка вызова функции)
	TRAP	112		; пропуск пробелов
	CMPB	@R3,#'(		; есть ли список аргументов?
	BNE	7$		; нет - функция без аргументов =>
; Разбор списка аргументов через запятую (каждый - строка или число).
40$:	INC	R3		; съесть '(' или ','
	TRAP	122		; аргумент - строковый литерал?
	BR	41$		; нет =>
	MOV	#-1,-(SP)	; строка - отметить тип
	TST	R4
	BGT	5$
	MOV	#NEWSTR,(R1)+	; строке нужна новая память
	BR	5$
41$:	TRAP	100		; число - выражение
	MOV	TYPE,-(SP)	; запомнить тип аргумента
5$:	INC	R2		; счётчик аргументов
	CMPB	@R3,#',		; ещё аргумент?
	BEQ	40$		; да =>
6$:	TRAP	130		; )
7$:	MOV	#FNCALL,(1)+	; опкод FNCALL
	MOV	R1,R4
	TST	(1)+
	MOV	R2,(1)+		; число аргументов
	BEQ	9$		; аргументов нет =>
; Скопировать в код запомненные типы аргументов (см. цикл выше).
8$:	MOV	(SP)+,(R1)+
	SOB	R2,8$
9$:	MOV	(SP)+,@R4
	MOV	(SP)+,TYPE
	RETURN

;
; TRAP 116 - необязательный аргумент вида ",выражение". Если после запятой
; сразу другая запятая или конец строки - запятая была разделителем без
; значения, позиция откатывается; иначе разбирает выражение (TRAP 100) и
; пропускает слово у вызывающего.
T116:
	TRAP	112		; пропуск пробелов
	CMPB	@R3,#',		; запятая?
	BNE	2$		; нет - аргумента нет =>
	MOV	R3,-(SP)	; да - запомнить позицию запятой
	INC	R3		; съесть запятую
	TRAP	112		; пропуск пробелов
	CMPB	@R3,#',		; сразу ещё запятая (значения нет)?
	BEQ	1$
	CMPB	@R3,#12		; или конец строки (значения нет)?
	BEQ	1$
	TRAP	100		; значение есть - выражение
	TST	(R0)+		; пропустить слово у вызывающего
	TST	(SP)+
	RETURN
1$:	MOV	(SP)+,R3	; значения не было - вернуть позицию к запятой
2$:	RETURN

;
; TRAP 117 - пропустить цифры, допуская одну десятичную точку (не сдвигая
; отдельно R3 для не-цифр - используется в CISLO для сканирования мантиссы
; и порядка числа). R2 считает точки; больше одной - ошибка.
T117:	CLR	R2

1$:	TRAP	102		; классифицировать символ: буква/цифра/иначе
	BR	3$		; не буква/цифра =>
	BR	4$		; буква =>
2$:	INC	R3		; цифра - съесть её
	BR	1$
3$:	CMPB	R4,#'.		; это точка?
	BNE	4$		; нет =>
	INC	R2		; да - учесть точку
	BR	2$		; и съесть её тоже
4$:	DEC	R2		; конец числа - было не больше одной точки?
	BGT	SYNERR		; больше одной точки - ошибка =>
	RETURN
SYNERR:	TRAP	2

;
; TRAP 120 - строковый литерал в кавычках. Если есть - опкод $CONST
; (адрес текста в исходной строке + длина), TYPE=-1 (строка), пропустить
; слово у вызывающего; если нет открывающей кавычки - вернуться без изменений.
T120:
	CMPB	@R3,#'"		; открывающая кавычка?
	BNE	1$		; нет =>
3$:	INC	R3		; съесть кавычку
	MOV	#$CONST,(R1)+	; опкод $CONST
	MOV	R3,(R1)+	; адрес текста строки (прямо в исходном тексте программы)
	CLR	R4		; R4 = длина строки
4$:	CMPB	@R3,#12		; конец строки (LF, кавычку не закрыли)?
	BEQ	5$
	CMPB	(R3)+,#'"	; закрывающая кавычка?
	BEQ	5$
	INC	R4		; нет - ещё один символ строки
	BR	4$
5$:	MOV	R4,(R1)+	; записать длину строки
	TST	(R0)+		; литерал найден - пропустить слово у вызывающего
	MOV	#-1,TYPE	; TYPE = строка
1$:	RETURN

;
; TRAP 121 - если сейчас компилируется тело DEF FN (PFACT указывает на
; список сохранённых параметров - см. DEF::/COMP.MAC), проверить, не
; совпадает ли имя R5 с одним из параметров функции; если да - скомпилировать
; обращение к параметру (опкод из PARMOV по типу) вместо обычной переменной.
T121:	CLR	R4
	MOV	PFACT,R2	; идёт компиляция DEF FN?
	BEQ	4$		; нет =>
1$:	TST	(2)+
	BEQ	4$		; конец списка параметров - не найден =>
	TST	(2)+
	CMP	(2)+,R5		; имя параметра совпадает?
	BNE	1$		; нет - следующий параметр =>
	MOV	TYPE,R4
	INC	R4
	ASL	R4
3$:	MOV	PARMOV(R4),(1)+	; опкод обращения к параметру (по типу)
	MOV	(2),(1)+
	TST	(0)+		; параметр найден - пропустить слово у вызывающего
	MOV	R2,R4
4$:	RETURN
;
PARMOV:	.WORD	$PAR,SPAR,IPAR	; обращение к параметру: строка/вещественное/целое

;
; TRAP 122 - проверить/скомпилировать строковое выражение (не обязательно
; только литерал - через TRAP 115: переменная, функция, конкатенация тоже
; подходят). Неудача - позиция восстанавливается, ничего не пропускается.
; Удача - строка скомпилирована; здесь же проверяется идущий следом знак
; отношения (=,<,>) - совпадение даёт дополнительный пропуск слова у
; вызывающего (см. CMP (SP)+,(R0)+ ниже).
T122:
	MOV	R3,-(SP)	; запомнить позицию на случай неудачи
	TRAP	115		; это строковое выражение?
	BR	1$		; нет =>
	TRAP	101		; да - за ним сразу знак отношения?
	.WORD	RELAT

	BR	2$		; да =>
1$:	MOV	(SP)+,R3	; нет (или не строка) - вернуть позицию
	RETURN
2$:	CMP	(SP)+,(R0)+	; отбросить сохранённую позицию, доп. пропуск слова
	RETURN

;
; TRAP 123/124/125 - разбор 3/2/1 целых выражений через запятую (без скобок).
; T123 = T125+запятая+T125+запятая+T125 (три); T124 = два (вход с T124
; пропускает первую пару); T125 = одно (вход с T125 пропускает обе первые).
; См. использование: POKE (T124), OUT (T123), SCREEN/PSET/WIDTH и т.п. (T125).
T123:
	TRAP	125		; первое целое выражение
	TRAP	126		; обязательная запятая
T124:
	TRAP	125		; (при входе с T124: первое) целое выражение
	TRAP	126		; обязательная запятая
T125:
	TRAP	100		; (при входе с T125: единственное) выражение
	CALL	CINT		; привести к целому
	RETURN

;
; TRAP 126 - обязательная запятая (иначе ошибка синтаксиса).
T126:
	TRAP	112		; пропуск пробелов
	CMPB	(R3)+,#',	; запятая?
	BNE	1$		; нет - ошибка =>
	TRAP	112		; да - пропуск пробелов после неё
	RETURN
1$:	TRAP	2

;
; .KOI8 <строка> - каждый символ с установленным старшим битом (для вывода
; на экран как атрибут/КОИ-8 код), без завершающего байта.
.MACRO	.KOI8	STRING
	.IRPC	A,<STRING>
	.BYTE	200+''A
	.ENDM
.ENDM
;
; .KOI87 <строка> - как .KOI8, но управляющие символы (код < 0100) оставляет
; как есть (не добавляет старший бит), и дописывает завершающий байт 7 -
; так собрана таблица сообщений об ошибках MESS ниже (одно сообщение на
; макрос, байт 7 - разделитель между сообщениями).
.MACRO	.KOI87	STRING
	.IRPC	A,<STRING>
    .IF LT,''A-100
	.BYTE	''A
    .IFF
	.BYTE	200+''A
    .ENDC
	.ENDM
	.BYTE	7
.ENDM

; MSTYPE - вывести текст сообщения об ошибке номер R5 (из таблицы MESS,
; сообщения разделены байтом 7). Некоторые коды (52-59) отображаются на
; более ранние сообщения (52-59 -> 26-33) - переиспользование текста ошибки.
MSTYPE:	MOV	R5,-(SP)
	MOV	#MESS,R1	; R1 = начало таблицы сообщений
	MOV	#3400,R2
	CMP	R5,#26.
	BLT	1$		; код < 26 - использовать как есть =>
	CMP	R5,#59.
	BGT	2$		; код > 59 - тоже как есть (без пропуска цикла) =>
	CMP	R5,#52.
	BLT	2$		; код 26-51 - тоже как есть =>
	SUB	#26.,R5		; код 52-59 - переадресовать на сообщение (код-26)
1$:
	CMPB	(1)+,#7		; пропустить сообщения по одному до нужного номера
	BNE	1$
	SOB	R5,1$

2$:
	CALL	ISVEIL		; вывести текст сообщения (до байта 7)
	MOV	(SP)+,R2
	RETURN

;
; Таблица текстов сообщений об ошибках, по одному на код (см. MSTYPE).
MESS:	.KOI87	<Ошибка>
;
	.ASCII	/NEXT /
	.KOI8	<без>
	.ASCII	/ FOR/<7>
;
	.KOI87	<Синтаксическая ошибка>
;
	.ASCII	/RETURN /
	.KOI8	<без>
	.ASCII	/ GOSUB/<7>
;
	.KOI8	<Кончились>
	.ASCII	/ DATA/<7>
;
	.KOI87	<Неправильный вызов функции>
	.KOI87	<Переполнение>
	.KOI87	<Нет больше памяти>
	.KOI87	<Неопределенный номер строки>
	.KOI87	<Несоответствие индекса>
	.KOI87	<Повторное определение массива>
	.KOI87	<Деление на ноль>
	.KOI87	<Невозможно выполнить>
	.KOI87	<Ошибка типов>
	.KOI87	<Кончилась память строк>
	.KOI87	<Слишком длинная строка>
	.KOI87	<Слишком длинное выражение>
	.KOI87	<Продолжение невозможно>
	.KOI87	<Неопределенная функция>
	.KOI87	<Ошибка ввода/вывода>
.REPT 4
	.BYTE	7
.ENDR
	.KOI87	<Отсутствует операнд>
	.KOI87	<Переполнение буфера ввода>
	.KOI87	<Недопустимое обращение к файлу>
	.KOI87	<Файл не найден>
	.KOI87	<Файл не открыт>
	.KOI87	<Конец файла>
	.KOI87	<Неправильное имя файла>
	.KOI87	<Строка без номера>
	.BYTE	7
	.KOI87	<Файл не открыт>
	.EVEN
;
	.END
