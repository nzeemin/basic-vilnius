
	.SBTTL	DISK

;==========================
; *** ОБРАЩЕНИЕ К RT-11 ***
;==========================

.GLOBL	DEVEXT,PARAM,BUFFIL,ASCFLG,ISVARD,INCNMB
.GLOBL	ENDFLG,BUFCNT,BLKCNT,FILTYP,IUNPCK,BUF
.GLOBL	KOMDEV,RER.,FER.,NER.,SER.,MER.,ERRBYT
.GLOBL	NAMEW,NAMER,ADRW,ADRR,LENW,LENR,AVPK,SAUG

.MCALL	.CSIGEN,.READW,.WRITW,.CLOSE,.PURGE,.TTINR,.TTYIN

	JSW==44
	SYSPTR==54
	CATSGM=256
	USRLOC==266

;----------------------------
; *** ДРАЙВЕР  ИНТЕРФЕЙСА ***
;----------------------------
; R1 - АДРЕС БЛОКА ПАРАМЕТРОВ
;----------------------------

; RT11:: - точка входа для любой операции обмена с RT-11 (открыть/читать/
; писать/список файлов). R1 -> блок параметров вызывающего (AVPK-подобный).
; Запрещает прерывания (MTPS #0, старое PS сохранено на стеке) и временно
; подменяет 4 слова низкой памяти (адреса 4,6,10,12 - похоже, системные
; векторы) и переменные AVPK/AVPK+2 значениями из таблицы SAUG - видимо,
; переключение на "чужой" (RT-11-совместимый) набор системных векторов на
; время вызова монитора; старые значения сохраняются на стеке и восстанавливаются
; в MEND. Точное назначение этих 4 векторов не выяснено до конца.
; Затем сбрасывает CATSGM (сегмент каталога) в системной странице (SYSPTR) -
; видимо, чтобы каталог перечитывался заново, и обнуляет байт ошибки (@R1).
; Копирует имя файла из блока вызывающего (NAMEW) в рабочую область (NAMER),
; уплотняет его (убирает внутренние пробелы через CMPB.../MOVB -1(R0)), длина
; зависит от ASCFLG (13/5 байт для ASCII-имени, иначе 20/12 - видимо, разные
; форматы: короткое "CAS:"-имя или полное RT-11 ФАЙЛ.РАСШ). Далее ищет символ
; команды (1(R1)) в таблице KOMDEV, чтобы определить тип операции (чтение/
; запись/список), и переходит по вычисленному индексу в таблицу DLENT.
RT11::
	CLC
	MFPS	-(SP)
	MTPS	#0		; запретить прерывания


	MOV	R0,-(SP)
	MOV	R2,-(SP)
	MOV	R3,-(SP)
	MOV	R5,-(SP)

	MOV	#4,R0
	MOV	R0,R2		; R2 = 4 (адрес первого подменяемого вектора)
	MOV	#SAUG+4,R3	; R3 -> таблица новых значений (SAUG)
4$:	MOV	@R2,-(SP)	; сохранить старое значение вектора
	MOV	(R3)+,(R2)+	; записать новое значение из SAUG
	SOB	R0,4$
	MOV	@#AVPK,-(SP)	; сохранить старый AVPK
	MOV	(R3)+,@#AVPK	; и подменить новым из SAUG
	MOV	@#AVPK+2,-(SP)
	MOV	(R3)+,@#AVPK+2

	MOV	@#SYSPTR,R0
	CLR	CATSGM(R0)	; сбросить кэш сегмента каталога
	CLRB	@R1		; обнулить байт кода ошибки в блоке вызывающего
	MOV	R1,R2		;
	TSTB	@#ASCFLG	;
	BEQ	20$		;
	ADD	#13,R2		;	ASCII-режим: короткое имя ("CAS:" и т.п.)
	MOV	#5,R5		;
	BR	21$		;
20$:	MOV	#20,R5		;	обычный режим: полное имя ФАЙЛ.РАСШ
21$:	MOV	R2,R3		;

	ADD	#NAMEW,R2	;	R2 -> исходное имя в блоке вызывающего
	ADD	#NAMER,R3	;	R3 -> рабочая копия имени
10$:	MOVB	(R2)+,(R3)+	;	скопировать имя
	SOB	R5,10$		;

	SUB	#20,R2		;MOV	R1,R2
				;ADD	#NAMEW,R2
	MOV	R2,R3
	MOV	R2,R0
	MOV	#12,R5
1$:	CMPB	(R0)+,#40	; пробел?
	BEQ	2$
	MOVB	-1(R0),(R2)+	; не пробел - переписать байт, сжимая имя
2$:	SOB	R5,1$
	CLRB	(R2)+		; терминатор уплотнённого имени

	MOV	#KOMDEV,R0
3$:	TSTB	@R0		; таблица KOMDEV кончилась, символ команды не найден?
	BEQ	MER2		; да => ошибка =>
	CMPB	1(R1),(R0)+	; символ команды совпал с элементом таблицы?
	BNE	3$
	SUB	#KOMDEV+1,R0
	BIC	#1,R0		; R0 = индекс операции (в словах) в таблице DLENT

	JMP	@DLENT(R0)	; перейти к обработчику: чтение / запись / список файлов
DLENT:	.WORD	MRD,MWR,FILES

;---------
; FILES - реализация оператора FILES (список файлов на устройстве). Читает
; сегменты каталога RT-11 блоками (BLKCNT начинается с 6 - первый блок
; каталога) и для каждой записи каталога выводит имя файла (через F6$-F13$,
; вычисляемый переход по типу/позиции слова записи). ASCFLG здесь используется
; как флаг "устройство уже открыто для каталога" (COM переключает его, чтобы
; при повторном входе не переоткрывать); поэтому при первом входе (ASCFLG=0)
; дописывается "DK:" по умолчанию, если в имени не было ":" явного устройства,
; и открывается канал каталога через .CSIGEN.
FILES:
	MOV	@#BUFCNT,R2
	CLR	R5
	TSTB	@#ASCFLG
	BNE	F4$		; устройство каталога уже открыто => продолжить разбор =>

	MOV	R3,R0
1$:	TSTB	@R0
	BEQ	2$
	CMPB	(R0)+,#':
	BNE	1$		; ищем ":" в имени устройства
	CLRB	@R0
	BR	3$
2$:	MOV	#"DK,@R3		; ":" не найден => устройство по умолчанию "DK:"
	MOV	#':,2(3)

3$:
	MOV	#6,@#BLKCNT	; первый блок каталога RT-11 - блок 6
	COM	@#ASCFLG	; пометить устройство каталога как открытое

	.CSIGEN	#200,#DEVEXT,R3	; открыть канал для чтения каталога
	BCS	MER2
	TST	(SP)+

; F5$ - прочитать очередной блок сегмента каталога (или завершить список,
; если ENDFLG указывает на последний прочитанный сегмент).
F5$:	TSTB	@#ENDFLG
	BNE	1$		; ещё есть сегменты => прочитать блок =>

	MOV	R1,R5
	ADD	#NAMER,R5

	MOV	#6,R0
2$:	MOV	#"  ,(R5)+	; вывести 6 пробелов (имя не найдено/список пуст)
	SOB	R0,2$
	MOV	#<'A*400>+33,@R5	; специальный маркер конца
	JMP	MREND

1$:	MOV	#BUFFIL,R2
	.READW	#PARAM,#3,R2,#400,@#BLKCNT	; прочитать блок сегмента каталога
	BCS	MER2

	TST	(2)+			; пропустить слово 0 (число сегментов)
	MOVB	@R2,@#ENDFLG		; байт: номер следующего сегмента (0=последний)
	CMP	(R2)+,(R2)+		; пропустить слово 1 (следующий сегмент) и слово 2
	MOV	(R2)+,@#INCNMB		; слово 3: длина записи каталога (в словах)
	TST	(R2)+			; пропустить слово 4 (номер начального блока файлов)

; F4$/F8$/F6$/F9$/F10$ - цикл по записям текущего сегмента каталога: F4$
; вычисляет длину одной записи в словах (INCNMB/2+7), F8$ проверяет, не
; кончился ли буфер блока (при необходимости читает следующий блок сегмента),
; F6$ по слову статуса записи выбирает через вычисляемый переход (ADD R0,PC),
; какой из обработчиков F10$/F11$/F12$/F13$ применить к текущему слову записи,
; F9$/F10$ продвигают R2 к следующему слову и повторяют, пока не разобрана вся
; запись (SOB R3,F8$), затем читают следующую запись (снова с F4$).
F4$:	MOV	@#INCNMB,R3	; R3 = длина записи (в байтах, из каталога)
	ASR	R3		; -> в словах
	ADD	#7,R3		; + 7 фиксированных слов заголовка записи
	BR	F8$

MER2:	JMP	MER

; F11$ - обработчик одного из слов записи каталога RT-11 внутри цикла FILES
; (выбирается вычисляемым переходом ADD R0,PC в F6$ по типу/позиции слова).
; Судя по всему - первое слово имени файла: если R5=0 (эту запись решили не
; выводить, см. F7$) - пропустить (F10$). Иначе слово из потока (R2)+
; трактуется как индекс*2 и передаётся в IUNPCK (внешняя подпрограмма) вместе
; с копией R2 - похоже, IUNPCK по этому индексу возвращает в R5 длину
; "распакованного" имени в BUF (точный формат вызова IUNPCK не выяснен до
; конца). Далее из NAMER+17 вычитается эта длина, чтобы найти начало значащих
; символов в BUF, и они копируются в выходной буфер (@5, начиная с байта-длины
; #11), останавливаясь на первом пробеле (обрезка справа).
F11$:	TST	R5
	BEQ	F10$		; запись не выводится => пропустить слово =>
	MOV	R3,-(SP)
	MOV	R1,-(SP)

	MOV	R5,-(SP)
	MOV	(R2)+,R5	; R5 = слово-индекс из записи каталога
	ASL	R5		; индекс -> смещение слова
	MOV	R2,-(SP)
	CALL	IUNPCK		; получить длину распакованного имени (в R5?)
	MOV	(SP)+,R2
	MOV	(SP)+,R5

	MOV	@SP,R1
	ADD	#NAMER+17,R1
	SUB	R5,R1		; R1 -> начало значащих символов имени в BUF
	MOV	#BUF,R3
	MOVB	#11,(5)+	; байт-длина RT-11-имени в выходной записи

1$:	MOVB	@R3,(5)+	; скопировать символ имени в вывод
	CMPB	#' ,@R3
	BEQ	2$		; пробел => конец значащих символов =>
	INC	R3
2$:	SOB	R1,1$

	MOV	(SP)+,R1
	MOV	(SP)+,R3
	BR	F9$

; F12$ - слово-расширение имени файла: если запись выводится (R5<>0),
; вывести "." и распаковать слово RADIX-50 через RASC.
F12$:	TST	R5
	BEQ	F10$		; запись не выводится => пропустить =>
	MOVB	#'.,(R5)+
	CALL	RASC
	BR	F9$

; F7$ - слово статуса записи (первое слово): бит 2000(окт.) - признак
; "обычный файл" (не пустой/защищённый промежуток). Если бит не установлен -
; запись не выводится (R5 остаётся 0, см. TST R5 в F11$/F12$/F13$); если
; установлен - R5 указывает на позицию вывода имени в NAMER блока вызывающего.
F7$:	BIT	#2000,(2)+
	BEQ	F9$		; не обычный файл (пустой/защищённый участок) =>
	MOV	R1,R5		; запись выводится - R5 -> буфер вывода имени
	ADD	#NAMER,R5
	BR	F9$

; F13$ - слово имени файла (2-е и 3-е слова, без "."): если запись выводится,
; распаковать RADIX-50 через RASC.
F13$:	TST	R5
	BEQ	F10$		; не выводится => пропустить =>
	CALL	RASC
	BR	F9$

; F8$ - проверка конца буфера текущего блока сегмента каталога; при
; необходимости читает следующий блок того же сегмента (BLKCNT инкрементируется
; по одному на каждый блок каталога сегмента; чётность используется как
; признак второго блока сегмента - см. BIT #1).
F8$:	CMP	R2,#BUFFIL+1000
	BLO	F6$		; в буфере ещё есть данные =>

	MOV	#BUFFIL,R2
	INC	@#BLKCNT
	BIT	#1,@#BLKCNT
	BEQ	MER2		; вышли за пределы сегмента (2 блока) - ошибка =>

	.READW	#PARAM,#3,R2,#400,@#BLKCNT	; прочитать второй блок сегмента
	BCS	MER2

; F6$ - диспетчер слова текущей записи каталога: R0 = (номер слова в записи,
; считая с конца, дважды) минус INCNMB (длина доп. полей записи) - определяет,
; какое это слово (статус / имя-1 / имя-2 / имя-3 / доп. поле). Отрицательный
; результат (BMI) - слово вне основного набора => пропустить (F10$). Иначе
; переход по таблице: F10$,F10$ (пропустить), F11$ (имя-1, спец. формат),
; F12$ (имя-2 - выводится с "."), F13$,F13$ (имя-3 и ещё одно поле).
; После таблицы (если R3 не попал в переход выше) - проверка конца сегмента:
; слово записи = 4000(окт.) - маркер конца сегмента; если да - вычисляется
; номер блока следующего сегмента (ENDFLG) и переход к чтению нового сегмента
; (F5$); иначе - это статус-слово обычной записи (F7$).
F6$:	MOV	R3,R0
	DEC	R0
	ASL	R0
	SUB	@#INCNMB,R0
	BMI	F10$		; слово вне таблицы обработчиков => пропустить =>

	ADD	R0,PC		; вычисляемый переход по типу слова записи
	BR	F10$
	BR	F10$
	BR	F11$
	BR	F12$
	BR	F13$
	BR	F13$

	CMP	@R2,#4000	; маркер конца сегмента каталога?
	BNE	F7$		; нет => это статус-слово обычной записи =>
	MOVB	@#ENDFLG,R0	; да => вычислить номер блока следующего сегмента
	DEC	R0
	ASL	R0
	ADD	#6,R0
	MOV	R0,@#BLKCNT
	JMP	F5$		; => прочитать следующий сегмент каталога

F10$:	TST	(R2)+		; пропустить текущее слово записи, не обрабатывая

F9$:	SOB	R3,F8$		; ещё есть слова в записи => продолжить =>
	TST	R5		; запись была выведена (R5<>0)?
	BEQ	F4$		; нет => перейти к следующей записи =>
	MOVB	#NER.,@R1	; да => вернуть найденное имя (код "нет ошибки")
	MOV	R2,@#BUFCNT
	JMP	MEND

;-----
; MRD - чтение из файла (первый вызов на файл открывает его через .CSIGEN).
; ASCTST решает режим; ASCII-чтение делегируется в ASCRD (2$). Для бинарного
; режима (1$): читает первый блок в BUFFIL, слово 0 - адрес назначения (бит 0
; служит флагом - если установлен, вместо ADRW(R1) берётся адрес из самого
; блока, т.е. "самоадресующийся" блок, иначе используется ADRW(R1) вызывающего);
; слово 1 (после CLC/ROR - похоже, снятие того же флагового бита сдвигом) -
; длина данных в словах; если длина 0 - выход (MREND1). Проверяет, что длина не
; превышает LENW(R1) (иначе MMER - "MEMORY ERROR"), копирует первый блок данных
; в приёмник, при необходимости читает и копирует хвост вторым .READW.
; MMER/MFER/MER - точки входа с разным кодом ошибки (MER./FER./RER.), сходятся
; в MER0: закрывают файл (.PURGE) и завершают с флагом переноса (код ошибки).
MRD:

	CALL	ASCTST
	BCS	2$		; ASCII-режим => делегировать в ASCRD =>
	.CSIGEN	#200,#DEVEXT,R3	; открыть файл через RT-11 CSI
	BCS	MFER
	TST	(SP)+

	.READW	#PARAM,#3,#BUFFIL,#400,#0	; прочитать первый блок файла
	BCS	MER

	TSTB	@#ASCFLG
	BEQ	1$
2$:	JMP	ASCRD		; => чтение в ASCII-режиме
1$:	MOV	#BUFFIL,R2
				;CLC
				;ROR	@R2
	MOV	ADRW(R1),R3	; R3 = адрес приёмника по умолчанию
	BIT	#1,R3
	BEQ	4$		; бит 0 адреса приёмника не установлен => как есть
	MOV	@R2,R3		; установлен => адрес приёмника берётся из блока
4$:	MOV	(R2)+,ADRR(R1)	; запомнить фактический адрес чтения
				;ASL	R3
	CLC
	ROR	@R2		; снять флаговый бит из длины (слово 1 блока)
	BEQ	MREND1		; длина 0 - данных нет =>

	CMP	@R2,LENW(R1)	; длина данных превышает буфер приёмника?
	BHI	MMER		; да => ошибка =>
	MOV	(R2)+,R5	; R5 = длина данных (слов)
	MOV	R5,LENR(R1)	; запомнить фактическую длину

	MOV	#774/2,R0	; макс. слов данных в первом блоке (после заголовка)
	CMP	R0,R5
	BLO	7$
	MOV	R5,R0		; данные умещаются целиком в первом блоке
	CLR	R5		; хвоста нет
	BR	8$
7$:	SUB	R0,R5		; R5 = остаток (хвост) для второго чтения

8$:	MOV	(R2)+,(R3)+	; скопировать данные первого блока в приёмник
	SOB	R0,8$

	TST	R5
	BEQ	MREND		; хвоста нет - готово =>

	.READW	#PARAM,#3,R3,R5,#1	; дочитать хвост данных прямо в приёмник
	BCS	MER
MREND1:	BR	MREND
MMER:
	MOVB	#MER.,@R1	; ошибка: данные не помещаются в буфер приёмника
	BR	MER0
MFER:
	MOVB	#FER.,@R1	; ошибка открытия файла
	BR	MER0
MER:
	MOVB	#RER.,@R1	; ошибка чтения/записи блока
MER0:	.PURGE	#0
	.PURGE	#3

	CLR	@#ASCFLG
	BIS	#1,24(SP)	;SEC		; выставить флаг переноса (код ошибки) в PS
	BR	MEND

;-----
; MWR - запись в файл (не первый вызов на файл открывает его, .CSIGEN делает
; фактическое открытие/создание через "[-1]=" опцию RT-11 - см. OPWR). Сначала
; ASCTST решает ASCII или бинарный режим; ASCII-запись целиком делегируется в
; ASCWR (5$). Для бинарного режима (3$): копирует ADRW(R1)/LENW(R1) (адрес и
; длину данных в словах) в блок параметров BUFFIL, дублирует данные во второе
; слово буфера (ASL - переводит длину в байты), затем одним .WRITW пишет первый
; блок (заголовок + до 774/2 слов данных), а остаток данных (R5 - хвост) - вторым
; .WRITW напрямую из R3 (продолжение исходного буфера), если он не поместился.
MWR:
	CALL	ASCTST
	BCS	5$		; ASCII-режим => делегировать в ASCWR =>
	CLRB	@R2		; обнулить конец имени файла (после ASCTST R2->имя)

	MOV	#OPWR,R0
	MOV	#OPEND-OPWR,R5
	DEC	R2
6$:	MOVB	(R0)+,(R2)+	; дописать "[-1]=" к имени файла (см. OPWR ниже)
	SOB	R5,6$

	.CSIGEN	#200,#DEVEXT,R3	; открыть/создать файл через RT-11 CSI
	BCS	MER
	TST	(SP)+

	TSTB	@#ASCFLG
	BEQ	3$
5$:	JMP	ASCWR		; => запись в ASCII-режиме
3$:	MOV	#BUFFIL,R2
	MOV	ADRW(R1),@R2	; адрес данных в первое слово буфера блока
				;ASL	@R2
	MOV	(R2)+,R3	; R3 = тот же адрес данных (источник копирования)
	MOV	LENW(R1),@R2	; длина (в словах) во второе слово буфера
	BEQ	MEND		; длина 0 - писать нечего =>
	MOV	@R2,R5		; R5 = длина в словах
	ASL	(R2)+		; удвоить в буфере (слова -> байты), R2 -> данные
	MOV	#774/2,R0	; макс. слов данных в первом блоке (после заголовка)
	CMP	R0,R5
	BLO	2$
	MOV	R5,R0		; данные умещаются целиком в первый блок
	CLR	R5		; хвоста не будет
	BR	1$
2$:	SUB	R0,R5		; R5 = остаток (хвост), не поместившийся в первый блок
1$:	MOV	R0,-(SP)
4$:	MOV	(R3)+,(R2)+	; скопировать данные первого блока в буфер
	SOB	R0,4$
	MOV	(SP)+,R2
	ADD	#2,R2

	.WRITW	#PARAM,#0,#BUFFIL,R2,#0	; записать первый блок (заголовок+данные)
	BCS	MER
	TST	R5
	BEQ	MWEND		; хвоста нет - готово =>
	.WRITW	#PARAM,#0,R3,R5,#1	; записать хвост данных отдельным блоком
	BCS	MER

MWEND:	.CLOSE	#0
	BCS	MER
	BR	MENDRW
MREND:	.PURGE	#3
MENDRW:	CLR	@#ASCFLG
MENDA:

	CLRB	@R1
; MEND - общий выход из RT-11-обмена (MRD/MWR/FILES сюда попадают по завершении).
; Проверяет клавиатуру (не блокируя выполнение диска): CTRL/Q (021) - "холостой"
; символ, просто съедается ожиданием следующего (2$: цикл .TTINR, пока не появится
; символ - т.е. CTRL/Q используется как "продолжить"/quench паузы); CTRL/P (020) -
; прерывание операции, выставляет код ошибки SER. и флаг переноса (имитация SEC
; через установку бита в сохранённом PS на стеке, 24(SP)). Далее восстанавливает
; регистры AVPK и R0-R5, сохранённые в начале RT11::/входа блока, и возвращается.
MEND:
	.TTINR			; неблокирующее чтение символа с клавиатуры
	BCS	4$		; нет символа => пропустить проверки =>
	CMPB	R0,#21		;CTRL/Q
	BNE	5$
2$:	.TTINR			; CTRL/Q - ждать следующий символ (съесть паузу)
	BCS	2$
5$:
	CMPB	R0,#20		;CTRL/P
	BNE	4$
	MOVB	#SER.,@R1	; CTRL/P - прервать операцию, код ошибки SER.
	BIS	#1,24(SP)	;SEC		; выставить флаг переноса в сохранённом PS
4$:
	MOV	(SP)+,@#AVPK+2	; восстановить AVPK
	MOV	(SP)+,@#AVPK
	MOV	#4,R0
	MOV	#14,R2
1$:	MOV	(SP)+,-(R2)	; восстановить блок из 4 слов (см. начало RT11::)
	SOB	R0,1$

	MOV	(SP)+,R5
	MOV	(SP)+,R3
	MOV	(SP)+,R2
	MOV	(SP)+,R0
	MTPS	(SP)+		; восстановить PS (в т.ч. флаг переноса - код ошибки)
	RETURN

OPWR:	.ASCIZ	/[-1]=/
OPEND:
	.EVEN

;-------
; ASCRD - чтение строки из буфера блока для ASCII-файла (вызывается из MRD,
; когда ASCFLG установлен). Если ENDFLG уже взведён (конец файла достигнут
; ранее) - сразу выходит без чтения (8$). Иначе копирует запрошенное число
; байт (LENW слов * 2, ASL) из BUFFIL (R5, BUFCNT) в приёмник ADRW(R1); длина
; и адрес фактически прочитанного запоминаются в ADRR/LENR. Если запрошена
; длина 1 слово - тоже сразу выход (8$), видимо особый случай "прочитать 1 байт".
; На каждом байте (4$) проверяется признак конца текста: если байт по текущему
; адресу буфера нулевой - значит достигнут конец считанных данных блока,
; вставляется ^Z (#32... фактически 032 в источнике другого места, здесь #32
; десятичное = маркер) и запоминается в ENDFLG. При исчерпании блока (R5 дошёл
; до BUFFIL+1000) читается следующий блок с диска (BLKCNT увеличивается).
ASCRD:
	TSTB	@#ENDFLG
	BEQ	7$
8$:	BR	MREND		; конец файла уже был - выйти без чтения =>
7$:
	MOV	ADRW(R1),R2
	MOV	LENW(R1),R3
	MOV	R2,ADRR(R1)	;
	MOV	R3,LENR(R1)	;
	CMP	R3,#1
	BEQ	8$		; запрошено только 1 слово - особый случай, выйти =>
				;ASL	R2
	ASL	R3		; слова -> байты
	MOV	@#BUFCNT,R5

4$:	TSTB	@R5		; байт в буфере блока пуст (конец считанных данных)?
	BNE	1$
	MOVB	#32,@R5		; вставить маркер конца
	MOVB	@R5,@#ENDFLG	; и запомнить его в ENDFLG (признак EOF)
1$:

5$:	MOVB	(R5)+,(R2)+	; скопировать байт в приёмник

3$:	CMP	R5,#BUFFIL+1000	; буфер блока исчерпан?

	BLO	2$
	INC	@#BLKCNT
	MOV	#BUFFIL,R5
	.READW	#PARAM,#3,R5,#400,@#BLKCNT	; да => прочитать следующий блок
	BCC	2$
	TSTB	@#ERRBYT
	BNE	MAER
	CLRB	@R5

2$:
	SOB	R3,4$
6$:	MOV	R5,@#BUFCNT
MEND1:	BR	MENDA

MAER:
	MOVB	#RER.,@R1
	MOVB	#RER.,1(R1)
	BR	MEND

;-------
; ASCWR - запись строки в буфер блока для ASCII-файла (вызывается из MWR, когда
; ASCFLG установлен). R2 -> исходная строка (ADRW), R3 = длина в словах (LENW,
; удваивается ASL для получения счётчика байт). R5 -> текущая позиция в BUFFIL.
; Копирует байты по одному, пока не встретит пробел (#32) в источнике - это,
; по-видимому, признак конца значащих данных в поле фиксированной длины: с этого
; места буфер до конца блока забивается нулями (2$), а R3 принудительно
; выставляется в 1, чтобы внешний цикл сразу вышел после сброса блока на диск.
; При заполнении блока (R5 достиг BUFFIL+1000) блок сбрасывается на диск (3$)
; и BLKCNT увеличивается, копирование продолжается со следующего блока.
ASCWR:
	TSTB	@#ASCFLG
	BEQ	MWEND

	MOV	ADRW(R1),R2
	MOV	LENW(R1),R3
				;ASL	R2
	ASL	R3		; слова -> байты
	MOV	@#BUFCNT,R5

1$:	CMPB	@R2,#32		; текущий байт источника - пробел (конец данных)?
	BEQ	2$		; да => зафиксировать конец и обнулить остаток блока =>

7$:	MOVB	(R2)+,(R5)+	; скопировать байт
5$:	CMP	R5,#BUFFIL+1000	; буфер блока заполнен?
	BLO	6$
	BR	3$		; да => сбросить блок на диск =>

2$:	CLRB	(R5)+		; забить остаток блока нулями
	CMP	R5,#BUFFIL+1000
	BLO	2$
	MOV	#1,R3		; заставить SOB ниже выйти после сброса блока

3$:	MOV	#BUFFIL,R5
	.WRITW	#PARAM,#0,R5,#400,@#BLKCNT	; записать текущий блок на диск
	BCS	MAER
	INC	@#BLKCNT

6$:	SOB	R3,1$
	MOV	R5,@#BUFCNT
	BR	MEND1

;-----------------
; R3 -> FIL. NAM.

; ASCTST - определяет, нужно ли трактовать файл как ASCII-текст (построчный
; ввод/вывод через ASCRD/ASCWR) или как двоичный блочный (обычный MRD/MWR).
; R3 -> имя файла (для поиска расширения). Если ASCFLG уже установлен (файл
; уже открыт как ASCII в этом сеансе обмена) - переходит сразу к проверке 2$.
; Иначе ищет "." в имени и сравнивает расширение с таблицей FILTYP через
; TRAP 113 (многосимвольный поиск ключевого слова); совпадение => 3$: включить
; ASCFLG и сбросить счётчики блока/буфера (начать файл заново как ASCII).
; НЕ совпадение (BR 1$) => выйти с CLC (не ASCII, обычное чтение/запись).
ASCTST:
	MOV	R2,-(SP)
	MOV	R3,-(SP)
	MOV	R4,-(SP)
	TSTB	@#ASCFLG
	BNE	2$		; ASCFLG уже взведён => пропустить поиск расширения
5$:	CMPB	(R3)+,#'.
	BNE	5$		; ищем точку в имени файла
	TRAP	113		; ключевое слово (расширение) есть в таблице FILTYP?
	.WORD	FILTYP
	.BYTE	3,2
	BR	3$		; совпадение => включить ASCII-режим =>
	BR	1$		; не совпадение => выйти, обычный режим =>

3$:	COMB	@#ASCFLG	; включить ASCII-режим
	CLR	@#BLKCNT	; сбросить номер блока
	MOV	#BUFFIL,@#BUFCNT	; сбросить указатель в буфере блока

1$:	MOV	(SP)+,R4
	MOV	(SP)+,R3
	MOV	(SP)+,R2
	CLC			; выход: не ASCII (или расширение не распознано)
	RETURN

2$:	CMP	LENW(R1),#200	; ASCFLG уже был взведён - длина запроса >= 200(окт.)?
	BHIS	4$		; да - оставить ASCFLG как есть (текстовый режим) =>
	CLRB	@#ASCFLG	; маленький запрос - выключить ASCII-режим

4$:	MOV	(SP)+,R4
	MOV	(SP)+,R3
	MOV	(SP)+,R2
	SEC			; выход: ASCII-режим (или только что выключен по размеру)
	RETURN
;
	.EVEN

;--------------------------
; *** RADIX50 ->  ASCII ***
;--------------------------
;IN:  R2 -> RADIX (WORD)
;     R5 -> BUF (3 BYTES)
;OUT: R2=R2+2
;     R5=R5+3
;--------------------------

; RASC - распаковка слова RADIX-50 (3 символа, упакованные по base-50) в 3 байта
; ASCII. R5 указывает на конец буфера (запись идёт в обратном порядке, -(R5)).
; Символ 0=пробел, 1-32(окт., 1-26 дес.)=A-Z, 33-35(окт., 27-29 дес.)="$.*"
; (спецсимволы, "*" - неиспользуемый слот RADIX-50), 36-47(окт., 30-39 дес.)=0-9.
RASC::
	MOV	R0,-(SP)
	MOV	R1,-(SP)
	MOV	(R2)+,R1	; R1 = упакованное слово RADIX-50, R2 -> следующее слово
	MOV	R2,-(SP)
	MOV	R3,-(SP)

	MOV	#3,R0		; счётчик: 3 символа на слово
	ADD	R0,R5		; R5 сразу сдвигается на конец 3-байтового поля
	MOV	R5,-(SP)
	MOV	#50,R2		; делитель (основание системы RADIX-50)

1$:	TST	R1
	BMI	6$		; R1 отрицательное (>32767 беззнаково)?

	CALL	DAL1		; R3 = R1 mod 50, R1 = R1 div 50
	BR	7$

6$:	TST	-(SP)		; R1 отрицательное - деление в два приёма, чтобы
	ADD	#100000,R1	;X=A+32767.	; избежать переполнения знакового деления
	CALL	DAL1
	MOV	R1,-(SP)	;X\50
	ADD	#10,R3		;Y=X!50+32767!50+1
	MOV	R3,-(SP)
	MOV	R3,R1
	CALL	DAL1
	MOV	(SP)+,R1	;Y
	MOV	R3,2(SP)	;A!50=Y!50
	SUB	R3,R1		;Z=Y-A!50
	CALL	DAL1
	ADD	(SP)+,R1
	ADD	#819.,R1	;A\50=Z\50+X\50+32767.\50
	MOV	(SP)+,R3	;A!50

7$:	TST	R3		; R3 = остаток (значение символа 0..47 окт.)
	BEQ	2$		; 0 => пробел
	SUB	#33,R3		; 33..35(окт.) - спецсимволы; иначе буква или цифра
	BLO	4$		; <33(окт., т.е. 1-26 дес.) => буква A-Z
	CMP	R3,#2
	BHI	5$		; >35(окт.) => цифра 0-9
	MOVB	LENT(R3),R3	; спецсимвол из таблицы LENT ("$.*")
	BR	3$

4$:	ADD	#73,R3		; -27+73+40(ниже) = смещение до 'A'
2$:	ADD	#40,R3		; + код пробела (или довершение смещения буквы)
	BR	3$
5$:	ADD	#55,R3		; смещение до цифры '0'

3$:	MOVB	R3,-(R5)	; записать символ, двигаясь к началу поля
	SOB	R0,1$		; повторить для всех 3 символов

	MOV	(SP)+,R5
	MOV	(SP)+,R3
	MOV	(SP)+,R2
	MOV	(SP)+,R1
	MOV	(SP)+,R0
	RETURN
LENT:	.ASCII	/$.*/		; спецсимволы RADIX-50 (индексы 0,1,2 = "$",".","*")
	.EVEN
; DAL1 - беззнаковое деление R1 на R2 (используется как R1/50). R3=остаток, R1=частное.
DAL1:	MOV	R0,-(SP)
	TST	R1
	SXT	R0		; расширить знак R1 в R0:R1 для 32-битного DIV
	DIV	R2,R0		; R0 = частное, R1 = остаток (после DIV R0:R1 / R2)
	MOV	R1,R3		; R3 = остаток
	MOV	R0,R1		; R1 = частное (для следующей итерации)
	MOV	(SP)+,R0
	RETURN

	.END
