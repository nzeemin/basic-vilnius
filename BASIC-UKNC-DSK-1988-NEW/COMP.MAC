	.INCLUDE /GENUKD.MAC/
	.SBTTL	COMPILER
	.ENABLE	LC

; Синтаксический анализатор и полу-компилятор языка BASIC.
; Преобразует исходный текст программы во внутренний промежуточный код.

;==================
; МАКРООПРЕДЕЛЕНИЯ
;==================

.MACRO	.BJMP	ADR
    .IF EQ,MASINA-BK0011
	MOV	#PAG1,-(SP)
	MOV	#ADR,-(SP)
	EMT	56
    .IFF
	JMP	ADR
    .ENDC
.ENDM
.MACRO	.BJSR	ADR
    .IF EQ,MASINA-BK0011
	MOV	#PAG1,-(SP)
	MOV	#ADR,-(SP)
	EMT	54
    .IFF
	CALL	ADR
    .ENDC
.ENDM

.MACRO	.BJSRA	ADR
    .IF EQ,MASINA-BK0011
	MOV	#PAG1,-(SP)
	MOV	ADR,-(SP)
	EMT	54
    .IFF
	CALL	@ADR
    .ENDC
.ENDM

.MACRO	.T	N
    .IF EQ,MASINA-BK0011
	JSR	R0,T'N
    .IFF
	TRAP	N
    .ENDC
.ENDM


;=========
; ТАБЛИЦЫ
;=========

OPRNAM::.ASCII	/  /	;ТАБЛИЦА ИМЕН ОПЕРАТОРОВ
	.ASCII	/' /
	.ASCII	/DIM /
	.ASCII	/LINE /
	.ASCII	/CIRCLE /
	.ASCII	/DEF /
	.ASCII	/TROFF /
OPFOR:	.ASCII	/FOR /
	.ASCII	/GOSUB /
	.ASCII	/GOTO /
	.ASCII	/IF /
	.ASCII	/INPUT /
	.ASCII	/LET /
	.ASCII	/OPEN /
	.ASCII	/? /
	.ASCII	/CLOSE /
	.ASCII	/NEXT /
	.ASCII	/PAINT /
	.ASCII	/PRINT /
	.ASCII	/DRAW /
	.ASCII	/REM /
	.ASCII	/RETURN /
	.ASCII	/_ /
	.ASCII	/CALL /
	.ASCII	/READ /
	.ASCII	/POKE /
	.ASCII	/OUT /
	.ASCII	/STOP /
	.ASCII	/LPRINT /
	.ASCII	/ON /
	.ASCII	/RESTORE /
	.ASCII	/END /
	.ASCII	/DATA /
	.ASCII	/LOCATE /
	.ASCII	/CLEAR /
	.ASCII	/TRON /
	.ASCII	/KEY /
	.ASCII	/BEEP /
	.ASCII	/CLS /
	.ASCII	/COLOR /
	.ASCII	/PSET /
	.ASCII	/PRESET /
	.ASCII	/CLOAD /
	.ASCII	/BLOAD /
	.ASCII	/SAVE /
	.ASCII	/CSAVE /
	.ASCII	/BSAVE /
	.ASCII	/LOAD /
	.ASCII	/MERGE /
	.ASCII	/FILES /
	.ASCII	/SCREEN /
	.ASCII	/WIDTH /
	.ASCII	/TRAP /

	.ASCII	/NEW /
	.ASCII	/AUTO /
	.ASCII	/LIST /
	.ASCII	/DELETE /
	.ASCII	/LLIST /
	.ASCII	/RENUM /
	.ASCII	/CONT /
	.ASCII	/RUN /
	.ASCII	/SYSTEM /
;	.ASCII	/MOTOR /
;	.ASCII	/ERASE /
;	.ASCII	/SWAP /
;	.ASCII	/MAXFILES /
	.EVEN
;
;	ТАБЛИЦА АДРЕСОВ ИМЕН ОПЕРАТОРОВ
;
AOPNAM::
.WORD	OPRNAM,OPRNAM+2,OPRNAM+4,OPRNAM+10,OPRNAM+15		;-CIRCLE
.WORD	OPRNAM+24,OPRNAM+30,OPRNAM+36,OPRNAM+42,OPRNAM+50	;-GOTO
.WORD	OPRNAM+55,OPRNAM+60,OPRNAM+66,OPRNAM+72			;-OPEN
.WORD	OPRNAM+77,OPRNAM+101,OPRNAM+107,OPRNAM+114		;-PAINT
.WORD	OPRNAM+122,OPRNAM+130,OPRNAM+135,OPRNAM+141,OPRNAM+150	;-_
.WORD	OPRNAM+152,OPRNAM+157,OPRNAM+164,OPRNAM+171,OPRNAM+175	;-STOP
.WORD	OPRNAM+202,OPRNAM+211					;-ON
.WORD	OPRNAM+214,OPRNAM+224,OPRNAM+230			;-DATA
.WORD	OPRNAM+235,OPRNAM+244,OPRNAM+252,OPRNAM+257		;-KEY
.WORD	OPRNAM+263,OPRNAM+270,OPRNAM+274			;-COLOR
.WORD	OPRNAM+302,OPRNAM+307,OPRNAM+316,OPRNAM+324		;-BLOAD
.WORD	OPRNAM+332,OPRNAM+337,OPRNAM+345,OPRNAM+353,OPRNAM+360	;-MERGE
.WORD	OPRNAM+366,OPRNAM+374,OPRNAM+403,OPRNAM+411		;-TRAP

.WORD	OPRNAM+416,OPRNAM+422,OPRNAM+427,OPRNAM+434		;-DELETE
.WORD	OPRNAM+443,OPRNAM+451,OPRNAM+457,OPRNAM+464,OPRNAM+470	;-SYSTEM
;.WORD	OPRNAM+477,OPRNAM+507,OPRNAM+515,OPRNAM+520
;
;	ТАБЛИЦА АДРЕСОВ ПРОГРАММ КОМПИЛЯЦИИ
;
AOPSUB::.WORD	LET,REM,DIM,LINE,CIRCLE,DEF,TROFF,FOR,GOSUB
	.WORD	GO,IF,INPUT,LET,OPEN,PRINT,CLOSE
	.WORD	NEXT,PAINT,PRINT,DRAW,REM,RET

	.WORD	KL2,KL2
	.WORD	READ,POKE,OUT,STOP,LPRINT,ON
	.WORD	RESTOR,END,DATA,LOCATE,CLEAR,TRON

	.WORD	KEY
	.WORD	BEEP,CLS,COLOR,PSET,PRESET
	.WORD	CLOAD,BLOAD,SAVE,CSAVE,BSAVE,LOAD,MERGE,FIND
	.WORD	SCREEN

	.WORD	WIDTH
	.WORD	TRAP
;
;
;	ТАБЛИЦА АДРЕСОВ ПРОГРАММ НЕПОСРЕДСТВЕННОГО ВЫПОЛНЕНИЯ
;
AOPMON::
	.WORD	NEW,AUTO,LIST,DELETE,LLIST,RENUM,CONT,RUN
	.WORD	ADDRMN
;	.WORD	MOTOR,ERASE,SWAP,MAXFILES
;
AOPEND::
.GLOBL	ZONA,LIT,TAB,AT,LOCX,LOCY,LOC,GETARR,LMID,ERRS,SPC
.GLOBL	IOUTSP,SOUTSP,IFT,IFF,FORINT,PNTSAV,STACK
.GLOBL	NXSKIP,NEXINT,NEXSNG,NEXCMP,NEXJMP,LIMIT,AUTOON
.GLOBL	HALT,NUMBER,SMOV,IMOV,$MOV,JMP,JSR,RTS,RTSTO,BEEP0
.GLOBL	SCONST,ICONST,SXMOV,IXMOV,$XMOV,FCB,DATPTR

.GLOBL	GET,GETLIT,CLR,CLRSTR,CLRMEM,ENDCOD,TRUN,TREND,ADRHLT
.GLOBL	SVAR,IVAR,TYPE,CINT,CSNG,READV,PFACT,ASTAR
.GLOBL	ENDPRG,LENT,TABTOP,NEWLIN,LYGIS,POKJMP,OUTJMP
.GLOBL	NEW,AUTO,LIST,DELETE,LLIST,RENUM,CONT,RUN,ADDRMN
.GLOBL	ONTRG$,SREG,RREG
.GLOBL	PACK,KL12,SAVJMP,START

.GLOBL	$WIDTH,$MIDLE,$WDMD

.GLOBL	COL3,COLBOX,COLG,COLPAP,COLCHR
.GLOBL	CCHR,CPAP

.GLOBL	JCLS
.GLOBL	TRUE,FALSE
.GLOBL	USRTAB,$DEFUS,STRSIZ
.GLOBL	AOPSUB,AOPMON,OPRNAM,MIDMOV,NEWSTR
.GLOBL	ONJSR,ONJMP,OPINP,OPOUT,CLOFIL,DEVICE,CLRDEV,DEVLP
.GLOBL	INIPRP,DFN,IFNRET,SFNRET,DATBEG,RESTV
;.GLOBL	SWPR,SWPI,SWSSI,SWSIS,SWSII
;.GLOBL	$ERASE,APRL
;.GLOBL	MTONV,MTOFFV
.GLOBL	$BLOAD,$BL0,$BSAVE,$FIND,$SAVE,$CSAVE,$LOAD,$CLOAD,$MERGE
;.GLOBL	$LCOP


.GLOBL	$KEY

.GLOBL	SETST,PRSPEC,TYPCHR,PLMI

.GLOBL	FORSNG

;============
; КОМПИЛЯТОР
;============

; RUN [номер] - оператор монитора. Необязательный номер строки - откуда
; начать выполнение (по умолчанию с начала программы). Перед компиляцией
; закрывает файлы, затем вызывает LRUN.
RUN::
	MOV	FCB,R2
	TRAP	110		; необязательный числовой аргумент; если есть - пропустить след. слово
	MOV	-(R2),R5	; аргумента нет => R5 из FCB (по умолчанию)
	TRAP	106		; конец оператора
	MOV	R5,-(SP)
	.BJSR	CLOALL		; закрыть файлы (аргумент R5 - см. выше)
	MOV	(SP)+,R5
;
; LRUN - собственно компиляция всей программы в промежуточный код:
;   1. Проверить, что программа не пуста.
;   2. Если задан стартовый номер строки - найти и разрешить ссылку на неё.
;   3. Сбросить состояние компилятора (DATA/RESTORE-цепочки, графика, стек).
;   4. COMPIL - построчно скомпилировать текст программы, вызывая для
;      каждого оператора его подпрограмму компиляции через таблицу AOPSUB.
;   5. ENDTXT - эпилог: дописать ENDPRG, перенести тексты DATA-строк в код,
;      разрешить накопленные ссылки RESTORE-без-номера-строки и запуститься.
LRUN::
	CMP	TABTOP,FCB
	BEQ	KL1		; программа пуста => в основной цикл монитора
	TRAP	111		; искать номер строки R5 (см. RUN/RESTORE) в таблице строк
	BR	1$		; строка найдена => разрешить ссылку на неё
	TRAP	8.		; строка не найдена (сюда TRAP 111 попадает пропуском слова)
1$:	JSR	R0,SETST	; попытаться сразу разрешить ссылку на строку запуска
	BR	4$		; строка уже скомпилирована => запускать с неё
	BR	KL1		; строка ещё не скомпилирована => в основной цикл монитора
4$:	CALL	CURON		; включить курсор
	MOV	#DATBEG,DATPTR	; DATPTR = адрес ячейки DATBEG (начало цепочки DATA, пока пуста)
	CLR	AUTOON		; очистить цепочку RESTORE-без-номера-строки

	CLR	DATBEG		; цепочка DATA пуста
	CALL	CLRCOD		; очистить буфер скомпилированного кода
	MOV	#1,LYGIS	; LYGIS=1 - идёт компиляция программы
	MOV	R4,ADRHLT	; запомнить адрес возврата на случай останова
	CALL	GRBCOL		; уплотнить текст программы (MONIT.MAC); ВАЖНО: заодно
				; возвращает R1 = ENDCOD - это и есть начальное
				; значение указателя записи кода для всей компиляции
	MOV	TABTOP,R0
; Обнулить служебные слова (адрес перехода) каждой строки программы
; перед компиляцией - используются ниже как цепочка forward-ссылок.
3$:	CLR	(R0)+
	CMP	(R0)+,(R0)+
	CMP	R0,FCB
	BLO	3$
	CLR	PFACT		; сбросить состояние разбора выражений
	MOV	#STACK,SP	; свой стек на время компиляции

; Главный цикл компиляции: по одной компилируемой строке программы за проход.
COMPIL:
	CMP	R0,TABTOP
	BLOS	ENDTXT		; строки кончились => эпилог
	MOV	-(R0),NUMBER	; NUMBER = номер текущей строки
	MOV	-(R0),R3	; R3 = адрес текста строки
	TST	-(R0)
	MOV	R0,R5
; Разрешить цепочку GOTO/GOSUB-ссылок, ожидавших именно эту строку
; (см. SETST/TO): пройти по цепочке и записать всем текущий адрес кода (R1).
1$:	MOV	@R5,R2
	MOV	R1,@R5
	MOV	R2,R5
	BNE	1$
	MOVB	(R3)+,R2	; R2 = код оператора (индекс в AOPSUB)
	CMP	R2,#AOPMON-AOPSUB
	BGE	KL12		; код относится к AOPMON (монитор) => недопустим в тексте программы
	CALL	@AOPSUB(R2)	; вызвать программу компиляции оператора
	CMP	R1,LENT
	BLOS	COMPIL		; памяти хватает => к следующему оператору
MEM1:
	JMP	MEMORY		; нет памяти => ошибка "Memory full"

KL1:	JMP	STAR		; программа пуста => в основной цикл монитора
KL12::	TRAP	12.		; недопустимый оператор (монитора) в тексте программы

; Эпилог компиляции: программа кончилась без END/STOP - дописать ENDPRG,
; затем переписать текст всех DATA-строк в скомпилированный код (как quoted-строки,
; чтобы READ мог брать их без повторного разбора) и разрешить накопленные ссылки
; RESTORE-без-номера-строки (цепочка AUTOON) на ближайшие DATA-операторы.
ENDTXT:
	CMP	-2(R1),#ENDPRG
	BEQ	2$
	CMP	-2(R1),#HALT
	BEQ	2$
	MOV	#ENDPRG,(R1)+	; в конце нет END/HALT => дописать ENDPRG
2$:	MOV	DATBEG,R0	; R0 = начало цепочки DATA-строк (адреса в исходном тексте)
	BEQ	11$		; цепочка пуста => пропустить копирование DATA
	MOV	R1,DATBEG	; DATBEG теперь - куда скопированы DATA-строки в коде
1$:	MOV	2(0),R3		; R3 = адрес текста очередной DATA-строки
	INC	R3
	MOV	@R0,R2		; R2 = адрес следующего звена цепочки
	MOV	R1,@R0		; пропатчить звено на новое место в коде (R1)
13$:	CMP	LENT,R1
	BLOS	MEM1		; не хватает памяти => ошибка
	CMPB	@R3,#12		; конец строки текста (LF)?
	BEQ	3$
	MOVB	(3)+,(1)+	; скопировать очередной символ DATA-строки
	BR	13$
3$:	CMP	R0,DATPTR	; это последнее звено цепочки?

	BEQ	4$
	MOVB	#54,(1)+	; нет - вставить разделитель между DATA-строками
	MOV	R2,R0		; => к следующему звену
	BR	1$
4$:	MOVB	@R3,(1)+	; последнее звено - скопировать завершающий символ (LF)
11$:	MOV	DATBEG,DATPTR
; Разрешение цепочки AUTOON: для каждого RESTORE-без-номера ищем ближайший
; предшествующий DATA (опкод #100) в таблице строк программы.
	MOV	AUTOON,R0
	BEQ	10$		; цепочка пуста => пропустить
7$:	MOV	@R0,R4		; R4 = позиция в тексте программы, откуда искать DATA
5$:	CMPB	@(4),#100	; это оператор DATA? ;DATA
	BEQ	6$
	SUB	#6,R4		; нет - к предыдущему оператору
	CMP	R4,TABTOP
	BHI	5$
	CLR	@R0		; DATA не найден - очистить ссылку
	BR	8$
6$:	MOV	-(4),@R0	; DATA найден - записать его адрес в ссылку RESTORE
8$:	MOV	-(0),R4		; R4 = предыдущее звено цепочки AUTOON
	MOV	#RESTV,@R0	; восстановить опкод RESTV на месте ссылки
	MOV	R4,R0
	BNE	7$		; => обработать следующее звено
10$:	INC	R1
	BIC	#1,R1
	MOV	R1,ENDCOD
	CALL	STRMEM
	MOV	@ADRHLT,R4
	DEC	LYGIS
	JMP	VYK2

;---------------------------

; Оператор LPRINT
LPRINT::MOV	#DEVLP,(R1)	; записать адрес обработчика DEVLP (принтер)
	MOV	(R1)+,-(SP)	; сохранить его на стеке, продвинуть R1
	BR	PRI		; => к общему коду PRINT (без объявления устройства)

; Оператор PRINT [#файл,] [элемент [;|, элемент]...] [;|,]
; Элемент - строковый литерал, выражение, TAB(n)/SPC(n), либо позиционирующая
; функция AT/TAB/SPC (см. AFNPOZ). ';' печатает элементы подряд без пробела,
; ',' переходит к следующей зоне печати; висящий разделитель в конце
; подавляет перевод строки после PRINT (флаг на стеке).
PRINT::	JSR	R2,TSTFLN	; необязательный номер файла (PRINT #n,...)
PRI:	CLR	-(SP)		; флаг "подавить перевод строки" (0 - не подавлять)
PR:	TRAP	122		; это строковое выражение (не обязательно только литерал)?
	BR	10$		; нет =>
	MOV	#LIT,(R1)+	; литерал есть - опкод LIT (вывести как есть)
	CLR	@SP
	BR	PR		; => к следующему элементу
10$:	TRAP	112		; пропуск пробелов
	TRAP	102		; классифицировать след. символ: буква/цифра/иначе
	BR	59$		; не буква и не цифра =>
	BR	1$		; буква =>
2$:	TRAP	100		; цифра (или после разбора спец.случаев) - выражение
	CLR	@SP
	MOV	TYPE,R4
	ASL	R4
	MOV	AOUTSP(R4),(R1)+	; опкод вывода по типу (строка/число)
	BR	PR		; => к следующему элементу
1$:	MOV	R3,R2		; запомнить позицию - вдруг это не ключевое слово
	.T	113		; сравнить с TAB/SPC (таблица RWPRIN)
	.WORD	RWPRIN,4003
	BR	2$		; не TAB/SPC - обычное выражение =>
	SUB	#4,R5

	BLT	77$
	CLR	@SP
	TRAP	127		; (
	MOV	R5,R2		; R2 - какая функция: TAB или SPC
	TRAP	125		; аргумент - целое выражение
	TST	R2
	BNE	5$
	TRAP	126		; обязательная запятая
	TRAP	125		; второй аргумент - целое выражение
5$:	TRAP	130		; )
	MOV	AFNPOZ(R2),(R1)+	; опкод AT/TAB/SPC (см. таблицу выше)
	BR	PR		; => к следующему элементу
59$:				; символ не буква и не цифра
	.T	101		; это один из спецсимволов PRSPEC?
	.WORD	PRSPEC
	BR	58$		; нет =>
	BR	57$		; да - но пока не используется дальше =>
58$:
	.T	101		; это унарный '+'/'-' (таблица PLMI)?
	.WORD	PLMI
	BR	6$		; нет =>
57$:	DEC	R3		; да - откатить позицию, разобрать как разделитель
	BR	2$
6$:	CMPB	@R3,#';	; ';' - выражение начинается со знака числа =>
	BEQ	7$
	CMPB	@R3,#',
	BNE	8$
	MOV	#ZONA,(R1)+	; ',' - опкод ZONA (переход к следующей зоне печати)
7$:	INC	@SP		; отметить: печать закончилась разделителем
	INC	R3
	BR	PR		; => к следующему элементу
77$:	MOV	R2,R3		; не TAB/SPC - вернуть позицию
	CMP	R5,#-2
	BEQ	2$		; => разобрать как обычное выражение
8$:	TRAP	106		; конец оператора
	TST	(SP)+		; был ли последний элемент с разделителем в конце?
	BNE	88$
	MOV	#NEWLIN,(R1)+
88$:	JSR	R2,TSTFIL
; Оператор REM
REM::	RETURN
;
AFNPOZ:	.WORD	AT,TAB,SPC	; обработчики позиционирующих функций PRINT: AT,TAB,SPC
AOUTSP:	.WORD	SOUTSP,IOUTSP	; обработчики вывода по типу (строка/число)
;
; Оператор LOCATE X[,Y[,курсор]]. Собирает цепочку опкодов из LOCX/LOCY/AT/LOC
; в зависимости от того, какие координаты указаны, а какие пропущены.
LOCATE::
	CMPB	@R3,#',		; первый символ ',' - X пропущен?
	BEQ	1$		; X пропущен =>
	TRAP	125		; X указан - целое выражение
11$:	TRAP	116		; есть ли ",Y"?
	BR	2$		; Y нет =>
	.BJSR	CINT		; Y есть - целое выражение
21$:	MOV	#AT,(R1)+	; записать опкод AT (координаты заданы)
	TRAP	116		; есть ли третий аргумент (,курсор)?
	BR	3$		; нет =>
	.BJSR	CINT		; есть - целое выражение
	MOV	#LOC,(R1)+	; записать опкод LOC (с параметром курсора)
	BR	CEND1
;

1$:	MOV	#LOCX,(R1)+	; опкод LOCX - X пропущен, координата не меняется
	BR	11$		; => проверить Y, как в обычном случае
2$:	MOV	#LOCY,(R1)+	; опкод LOCY - Y пропущен, координата не меняется
	CMPB	(R3),#',
	BNE	21$
	INC	R3
	CMPB	(R3),#',
	BEQ	21$
	TRAP	24.		; ошибка - параметр пропущен между запятыми
3$:	CMPB	(R3),#',
	BNE	CEND1
	TRAP	24.		; ошибка - лишняя запятая в конце
;
; Оператор LET
; Оператор LET переменная[(индекс)]=выражение, а также LET MID$(строка,поз[,длина])=выражение.
LET::	CLR	R2		; R2 - выбор ячейки в таблице AMOV (вид цели присваивания)
	CLR	R4
	TRAP	107		; разобрать имя цели (переменная/массив)
	BR	10$
	CMP	(R2)+,(R2)+
	TST	TYPE
	BEQ	1$
11$:	TST	(R2)+
1$:	TSTB	R5
	BMI	15$		; цель - элемент массива =>
	MOV	R4,-(SP)	; обычная переменная - запомнить её адрес
	BR	2$
10$:	TST	R5
	BNE	11$
	.BJSR	LMID		; частный случай - цель это MID$(строка,поз[,длина])
15$:	NEG	R2
2$:	TRAP	112		; пропуск пробелов
	CMPB	(R3)+,#'=	; '=' ?
	BNE	5$
21$:	BIT	#20000,R5	; цель строкового типа?
	BEQ	22$
	TRAP	115		; разобрать правую часть - строковое выражение
	TRAP	13.
	TST	R4
	BGT	33$
	BMI	3$
	TST	R2
	BEQ	33$
3$:	MOV	#NEWSTR,(1)+	; строке нужна новая память - опкод NEWSTR
	BR	33$
22$:	TRAP	100		; правая часть - числовое выражение
	MOV	R2,R4
	BPL	20$
	NEG	R4
20$:	.BJSRA	ATCONV-4(R4)	; привести к типу цели (CINT/CSNG)
33$:
	MOV	AMOV(R2),(R1)+	; опкод присваивания по виду цели (см. AMOV)
	TST	R2
	BLE	CEND1
	MOV	(SP)+,(R1)+	; адрес переменной (для скалярных целей)
	BR	CEND1
5$:	TRAP	2
;
; Опкоды присваивания LET по виду цели (индекс R2, см. LET): элемент целого
; массива, элемент вещ. массива, элемент строк. массива, MID$(...), обычная
; строка, вещественная переменная, целая переменная.
	.WORD				IXMOV		;-6

	.WORD			SXMOV			;-4
	.WORD		$XMOV				;-2
AMOV:	.WORD	MIDMOV					; 0
	.WORD		$MOV				;+2
	.WORD			SMOV			;+4
	.WORD				IMOV		;+6
ATCONV::.WORD			CSNG,	CINT	; приведение типа: к вещественному / к целому
;
; Оператор RETURN
RET::	TRAP	110		; необязательный номер строки (RETURN <line>)
	BR	1$		; номера нет => обычный RETURN
	MOV	#RTSTO,(R1)+	; номер есть - обработчик RTSTO (вернуться и перейти на строку)
	BR	TO1		; => проверить строку и разрешить ссылку (как для GOTO)
1$:	MOV	#RTS,(R1)+	; обработчик RTS (обычный возврат из GOSUB)
	CALL	TSTLYG
CEND1:	TRAP	106		; конец оператора
	RETURN
;
; Оператор GOSUB
GOSUB::	MOV	#JSR,(R1)+	; записать адрес обработчика JSR (переход с сохранением адреса возврата)
	BR	TO		; => к общему разбору номера строки
;
; Оператор GOTO
GO::	MOV	#JMP,(R1)+	; записать адрес обработчика JMP (безусловный переход)
;
; Общий разбор "GOTO/GOSUB <номер строки>".
TO:	TRAP	110		; разобрать номер строки в R5; если цифр нет - не пропускать след. слово
; Точка входа для нереализованных операторов "'" и "_" (см. AOPSUB) - сразу ошибка синтаксиса.
; Также служит целью TRAP 110 выше, если номер строки не был указан.
KL2:	TRAP	2		; ошибка синтаксиса (нет номера строки)
TO1:	TRAP	106		; конец оператора (или ':' / комментарий)
	TRAP	111		; искать номер строки R5 в таблице строк программы
	BR	2$		; строка найдена => продолжить
	TRAP	8.		; строка не найдена (сюда TRAP 111 попадает пропуском слова)
2$:	CALL	TSTLYG
	JSR	R0,SETST	; попытаться сразу разрешить ссылку на строку
	BR	5$		; строка уже скомпилирована => пропатчить переход на неё
	MOV	#TOTO1,(1)+	; строка ещё не скомпилирована - отложенная ссылка (заплатка потом)
	RETURN
5$:	MOV	@R4,@R1		; записать текущий адрес перехода в цепочку по адресу R4
	CMP	4(R4),NUMBER
	BLOS	1$
	MOV	R1,@R4
1$:	TST	(R1)+
	RETURN
TOTO1:	.WORD	ENDPRG
;
; Проверка после GOTO/GOSUB/RETURN на номер вне программы: если идёт
; выполнение в прямом режиме (не компиляция) и нет отложенных ошибок -
; сбросить адрес останова; иначе (были ошибки) - TRAP 17.
TSTLYG:	TSTB	LYGIS
	BNE	1$		; идёт компиляция программы =>
	TST	ERRS
	BNE	2$		; есть отложенные ошибки =>
	CLR	ADRHLT
1$:	RETURN
2$:	TRAP	17.
;
; Общая таблица текстов ключевых слов для TRAP 101/113 (проверка ключевых
; слов при компиляции разных операторов): RETURN/NEXT/RESTORE (для TSTLYG-
; подобных проверок), THEN/ELSE (IF), TO/STEP (FOR), AS (OPEN), USR/FN (DEF) и т.д.
RWREN::	.ASCII	/REM /
	.ASCII	/RETURN /
	.ASCII	/NEXT /
	.ASCII	/RESTORE /
RWON:	.ASCII	/GOSUB /
RWIF:	.ASCII	/GOTO /
	.ASCII	/THEN /
	.ASCII	/ELSE /

RWPRIN:	.ASCII	/EL /
	.ASCII	/ATN /
	.ASCII	/AT /
	.ASCII	/TAB /
	.ASCII	/SPC /
RWFOR:	.ASCII	/TO /
	.ASCII	/STEP /
RWOPEN:	.ASCII	/OUTPUT INPUT /
	.ASCII	/AS /
RWDEF:	.ASCII	/USR /
	.ASCII	/FN /
;	.ASCII	/STR /
;	.ASCII	/SNG /
;.IFF
;	.ASCII	/DBL /
;.IFTF
;	.ASCII	/INT /

;RWKEY:	.ASCII	/LIST /

RWMOT:	.ASCII	/ON /

RWTRAP:	.ASCII	/OFF /


RWON1:	.ASCII	/TRAP /

RWLINE:	.ASCII	/BF B /
	.EVEN
;
; Оператор IF выражение THEN {номер строки|оператор} [ELSE {номер строки|оператор}]
IF::	TRAP	100		; условие - целое выражение
	.BJSR	CINT		; Целое выражение
	.T	113		; обязательно THEN или GOTO
	.WORD	RWIF,1002
	TRAP	2		; ни THEN, ни GOTO - ошибка синтаксиса
	TRAP	102		; классифицировать следующий символ: цифра/буква/иначе
	BR	6$		; буква (начало оператора) =>
	BR	6$		; не буква и не цифра =>
	MOV	#IFT,(R1)+	; цифра - THEN <НОМЕР СТРОКИ>: опкод IFT
	MOV	R0,-(SP)
	CLR	R0
	CALL	TO		; разобрать и разрешить номер строки (как GOTO)
	CLR	-(SP)
	BR	5$
6$:	MOV	#IFF,(R1)+	; THEN <ОПЕРАТОР>: опкод IFF
	MOV	R0,-(SP)
	MOV	R1,-(SP)
	.T	113
	.WORD	OPRNAM
	.BYTE	2,AOPMON-AOPSUB-2
	CLR	R5
	TST	(R1)+
	CLR	R0
	CALL	@AOPSUB(R5)	; скомпилировать оператор после THEN
	CLR	R2
5$:
	.T	113		; необязательное ключевое слово ELSE

	.WORD	RWIF+12,2	;ELSE?
	BR	62$		; ELSE нет =>
	TRAP	102		; ELSE есть - классифицировать следующий символ
	BR	50$		; буква (начало оператора) =>
	BR	50$		; не буква и не цифра =>
	MOV	#22,R5		; цифра - ELSE <НОМЕР СТРОКИ>: код оператора GOTO
	BR	55$
50$:
	.T	113
	.WORD	OPRNAM
	.BYTE	2,AOPMON-AOPSUB-2
	CLR	R5
55$:	TST	@SP
	BEQ	4$		; ветка THEN была номером строки (без перехода после) =>
	MOV	#JMP,(R1)+	; ветка THEN была оператором - вставить переход через ELSE
	MOV	R1,R2
	TST	(R1)+
	MOV	R1,@(SP)+
	MOV	R2,-(SP)
4$:	CALL	@AOPSUB(R5)	; скомпилировать ветку ELSE (GOTO номера строки или оператор)
62$:	MOV	(SP)+,R0
	BEQ	7$
	MOV	R1,@R0		; пропатчить переход JMP (обход ветки ELSE) на конец IF
7$:	MOV	(SP)+,R0
	BR	CEND0
;
;
; Оператор FOR
; Оператор FOR var=нач TO кон [STEP шаг]
FOR::	CLR	R4		; лимит для TRAP 107 = 0 (ожидается ровно одна переменная)
	TRAP	107		; разобрать имя переменной цикла
	TRAP	13.
	TSTB	R5
	BMI	SYNERR
	TRAP	112		; пропуск пробелов
	CMPB	(R3)+,#'=	; '=' ?
	BNE	SYNERR
	MOV	R4,-(SP)	; запомнить адрес переменной цикла
	MOV	TYPE,R2
	ASL	R2
	TRAP	100		; начальное значение - выражение
	.BJSRA	ATCONV(R2)	; привести к типу переменной цикла
	MOV	AMOV+4(R2),(R1)+	; записать опкод присваивания начального значения
	MOV	@SP,(R1)+
	.T	113		; ключевое слово TO обязательно
	.WORD	RWFOR,2
	TRAP	2
	TRAP	100		; конечное значение - выражение
10$:	.BJSRA	ATCONV(R2)	; привести к типу переменной цикла
	.T	113		; необязательное ключевое слово STEP
	.WORD	RWFOR+3,2
	BR	F2$		; STEP нет => значение шага по умолчанию
	TRAP	100		; шаг указан - выражение
	.BJSRA	ATCONV(R2)	; привести к типу переменной цикла
F1$:	MOV	AFOR(R2),(R1)+	; опкод цикла: FORSNG или FORINT (по типу переменной)
	MOV	#ASTAR+2,(R1)+
	MOV	(SP)+,(R1)+	; адрес переменной цикла
	TSTB	LYGIS
	BEQ	CEND
	MOV	R1,-4(R1)
CEND0:	BR	CEND
F2$:	TST	R2
	BNE	3$		; тип - целое (INT) =>
	MOV	#SCONST,(1)+	; шаг по умолчанию 1 (вещественный)
	CLR	(R1)+
	MOV	#40200,(R1)+
	BR	F1$
3$:	MOV	#ICONST,(R1)+	; шаг по умолчанию 1 (целое)
	MOV	#1,(R1)+
	BR	F1$
SYNERR:	TRAP	2
;
AFOR:	.WORD	FORSNG,FORINT	; обработчики цикла: вещественный / целый счётчик
;
; Оператор NEXT [переменная[,переменная...]]
NEXT::	MOV	#NXSKIP,(R1)+	; записать опкод NXSKIP (заглушка/точка перехода)
	CLR	R4		; по умолчанию R4=0 - переменная не указана (NEXT без имени)
	CLR	R2		; по умолчанию тип - вещественный
	CMPB	@R3,#12		; конец строки сразу после NEXT (без переменной)?
	BEQ	1$		; да =>
	TRAP	107		; разобрать имя переменной цикла
	TRAP	13.
	TSTB	R5
	BMI	SYNERR
	MOV	TYPE,R2
	ASL	R2
1$:	MOV	R4,(1)+		; адрес переменной цикла (или 0, если не указана)
	MOV	ANXADD(R2),(R1)+	; опкод NEXTSNG/NEXINT по типу переменной
	TST	R2
	BNE	2$		; тип - целое (INT) =>
	MOV	#NEXCMP,(R1)+	; вещественный - доп. опкоды сравнения и перехода
	MOV	#NEXJMP,(R1)+
2$:	TRAP	112		; пропуск пробелов
	CMPB	(R3)+,#',	; ',' ?
	BEQ	NEXT		; ещё переменная => разобрать её как отдельный NEXT
	DEC	R3
	BR	CEND
;
ANXADD:	.WORD	NEXSNG,NEXINT	; обработчики NEXT: вещественный / целый счётчик
;
; Оператор STOP
STOP::	MOV	#HALT,(R1)+	; записать в код адрес обработчика HALT
	BR	CEND		; => к общему эпилогу
;
; Оператор END
END::	MOV	#ENDPRG,(R1)+	; записать адрес обработчика ENDPRG
	BR	CEND		; => к общему эпилогу
;
; Оператор TRON
TRON::	MOV	#TRUN,(R1)+	; записать адрес обработчика TRUN (включить трассировку)
	BR	CEND		; => к общему эпилогу
;
; Оператор TROFF
TROFF::	MOV	#TREND,(R1)+	; записать адрес обработчика TREND (выключить трассировку)
CEND:	TRAP	106		; проверить конец оператора/строки
	RETURN			; вернуться в компилятор
;
; Оператор DATA
DATA::	MOV	R0,@DATPTR	; вписать адрес этого DATA в конец цепочки (в предыдущее звено)
	MOV	R0,DATPTR	; DATPTR теперь указывает на текущий DATA (новый конец цепочки)
	RETURN

; Оператор RESTORE
RESTOR::TSTB	LYGIS
	BEQ	3$		; не идёт компиляция программы (прямой режим) =>
	MOV	AUTOON,(1)+	; вписать это RESTORE в цепочку AUTOON (форв.ссылка, как DATA/DATPTR)
	MOV	R1,AUTOON	; AUTOON теперь указывает на текущее RESTORE
	TRAP 	110		; необязательный номер строки (RESTORE <line>)
	BR	1$		; номера нет => (восстановить к самому началу)
	TRAP	111		; номер есть - искать строку в таблице строк программы
	BR	2$		; строка найдена =>
	TRAP	8.		; строка не найдена
1$:	MOV	FCB,R4
	TST	-(4)
2$:	TST	-(4)
	MOV	R4,(1)+
	BR	CEND
3$:	TST	ERRS
	BNE	5$
	MOV	#RESTV,(R1)+	; обработчик RESTV (восстановить указатель DATA)
	MOV	DATBEG,(R1)+	; по умолчанию - начало цепочки DATA
	TRAP	110		; необязательный номер строки (RESTORE <line>)
	BR	CEND		; номера нет => конец оператора (восстановить в начало)
	TRAP	111		; номер есть - искать строку в таблице строк программы
	BR	4$		; строка найдена =>
	TRAP	8.		; строка не найдена
4$:	MOV	-4(R4),-2(R1)	; заменить аргумент RESTV на найденную строку
	BR	CEND
5$:	TRAP	4
;
; Оператор READ
; Оператор READ переменная[,переменная...]. Читает значения из DATA,
; список переменных разбирает так же, как INPUT (см. INPENT ниже).
READ::
	MOV	#READV,(1)+	; опкод READV (взять очередное значение из DATA)
	CLR	-(SP)
	BR	INPENT		; => общий разбор списка переменных (см. INPUT)
;
; Оператор INPUT
; Оператор INPUT [#файл,]["приглашение";]переменная[,переменная...]
INPUT::
	MOV	#RETCRT,(1)+	; опкод RETCRT (перевод строки перед вводом)
	TRAP	120		; есть ли строковый литерал-приглашение в кавычках?
	BR	10$		; нет =>
	MOV	#LIT,(R1)+	; есть - опкод LIT (вывести текст приглашения)
	TRAP	112		; пропуск пробелов
	CMPB	(R3)+,#';	; после приглашения обязательна ';'
	BNE	SYNERR
	TRAP	112		; пропуск пробелов
	CLR	-(SP)
	TSTB	LYGIS
	BEQ	11$		; не идёт компиляция программы (прямой режим) =>
	MOV	#GETLIT,(R1)+	; ввод без стандартного "? " (своё приглашение уже выведено)
	BR	INPENT
10$:	JSR	R2,TSTFLN	; нет приглашения - проверить номер файла (INPUT #n,...)
11$:	MOV	#GET,(R1)+	; обычный ввод со стандартным приглашением "? "
INPENT:	MOV	R1,-(SP)
	TST	(R1)+
; Разбор списка переменных через запятую.
1$:	CLR	R4
	MOV	R1,-(SP)	; место под ссылку на текущую переменную
	TST	(R1)+
	TRAP	107		; разобрать имя переменной (одну)
	NOP
	TSTB	R5
	BMI	2$		; переменная с индексом (массив) =>

	TST	R5
	BEQ	4$		; имя не разобрано - ошибка
	MOV	R4,@(SP)+	; обычная переменная - записать её адрес
3$:	TRAP	112		; пропуск пробелов
	CMPB	(R3)+,#',	; ',' ?
	BEQ	1$		; ещё переменная => разобрать следующую
	MOV	R1,@(SP)+
	DEC	R3
	JSR	R2,TSTFIL
	BR	CEND
2$:	MOV	#GETARR,(R1)+	; элемент массива - опкод GETARR
	MOV	R1,@(SP)+
	BR	3$
4$:	TRAP	2
;
; Оператор CLEAR
CLEAR::	CMPB	@R3,#12		; CLEAR без аргументов (конец строки)?
	BEQ	1$
	CMPB	@R3,#',		; CLEAR ,... (первый аргумент опущен)?
	BNE	3$
	MOV	#IVAR,(R1)+	; переменная STRSIZ как есть (без выражения)
	MOV	#STRSIZ,(R1)+
	BR	4$
3$:	TRAP	125		; CLEAR <размер строк>[,...] - целое выражение
4$:	TRAP	116		; есть ли ",<размер памяти>"?
	BR	2$
	.BJSR	CINT		; Целое выражение
	MOV	#CLRMEM,(R1)+	; CLEAR со вторым аргументом - обработчик CLRMEM
	BR	CEND
2$:	MOV	#CLRSTR,(R1)+	; CLEAR с одним аргументом - обработчик CLRSTR
	BR	CEND
1$:	MOV	#CLR,(R1)+	; CLEAR без аргументов - полный сброс (обработчик CLR)
	BR	CEND2
;
; Оператор DIM
DIM::
	MOV	#10,R4		; лимит для TRAP 107 (макс. число измерений массива)
	TRAP	107		; разобрать имя массива и список размерностей (через запятую)
	NOP
1$:	TST	R5
	BEQ	4$		; TRAP 107 не смог разобрать имя => ошибка
	TRAP	112		; пропуск пробелов
	CMPB	(R3)+,#',	; ',' ?
	BNE	2$		; не запятая => один массив описан, конец
	TSTB	LYGIS
	BNE	DIM		; компиляция программы => разобрать следующий массив (снова DIM)
	TRAP	12.		; прямой режим - несколько массивов через запятую недопустимы
2$:	DEC	R3
	BR	CEND2
4$:	TRAP	2
;
; Оператор POKE
; Оператор POKE адрес,значение
POKE::	TRAP	124		; два целых выражения через запятую: адрес,значение
;
	MOV	#POKJMP,(R1)+	; опкод POKJMP
	BR	CEND2
;
; Оператор OUT порт,значение,маска
OUT::	TRAP	123		; три целых выражения через запятую (см. TRAP 124 у POKE)
	MOV	#OUTJMP,(R1)+	; опкод OUTJMP
CEND2:	TRAP	106		; конец оператора
	RETURN

; Оператор COLOR цвет[,фон[,рамка]]. Как LOCATE - цепочка опкодов COLCHR/COLPAP/
; COLBOX/COL3 в зависимости от того, сколько параметров задано.
COLOR::	CMPB	@R3,#',		; первый символ ',' - цвет символа пропущен?
	BEQ	10$		; пропущен =>
	TRAP	125		; цвет символа - целое выражение
1$:	TRAP	116		; есть ли ",фон"?
	BR	20$		; нет =>
	.BJSR	CINT		; Целое выражение
2$:	TRAP	116		; есть ли ",рамка"?
	BR	30$		; нет =>
	.BJSR	CINT		; Целое выражение
3$:	MOV	#COL3,(1)+	; записать опкод COL3 (все три параметра)
	BR	CEND2
10$:	MOV	#COLCHR,(1)+	; опкод COLCHR - цвет символа пропущен
	BR	1$		; => проверить фон, как в обычном случае
20$:	MOV	#COLPAP,(1)+	; опкод COLPAP - фон пропущен
	CMPB	@R3,#',
	BNE	2$
	INC	R3
	BR	2$
30$:	MOV	#COLBOX,(1)+	; опкод COLBOX - рамка пропущена
	BR	3$

; Оператор BEEP
BEEP::	MOV	#BEEP0,(R1)+	; записать адрес обработчика BEEP0
	BR	CEND2		; => к общему эпилогу

; Оператор CLS
CLS::	MOV	#JCLS,(R1)+	; записать адрес обработчика JCLS (очистка экрана)
	BR	CEND2		; => к общему эпилогу

; Оператор PSET
; Оператор PSET(x,y)[,цвет]
PSET::	CLR	R2		; R2 = смещение SET в таблице APOINT
	BR	PNT
; Оператор PRESET(x,y)[,цвет]
PRESET::MOV	#2,R2		; R2 = смещение RESET в таблице APOINT
PNT:	CALL	KOORD		; парсим координаты точки
	TRAP	116		; есть ли ",цвет"?
	BR	6$		; нет =>
	.BJSR	CINT		; цвет указан - привести к целому
	MOV	#SPFORM,(R1)+	; записать опкоды: точка явным цветом (SPFORM,SPSET,SET)
	MOV	#SPSET,(R1)+
	MOV	#SET,(R1)+
	BR	7$
6$:	MOV	#RSP,(R1)+	; цвет не указан - точка цветом пера/фона (RSP,SPSET,SET/RESET)
	MOV	#SPSET,(R1)+
	MOV	APOINT(R2),(R1)+	; SET для PSET, RESET для PRESET
7$:	TRAP	106		; конец оператора
	RETURN
APOINT:	.WORD	SET,RESET	; обработчики: PSET=SET (зажечь точку), PRESET=RESET (погасить)

; Оператор LINE
; Оператор LINE [(x1,y1)]-(x2,y2)[,цвет][,B|BF]
LINE::	CMPB	(R3),#'-
	BEQ	1$		; сразу '-' - первая точка не указана =>
	CALL	KOORD		; парсим координаты точки
	BR	2$
1$:	MOV	#CURCOR,(R1)+	; первая точка не указана - опкод CURCOR (текущая позиция)
2$:	CMPB	(R3)+,#'-	; Минус между парами координат ?
	BNE	SYNER3
	TRAP	112		; пропуск пробелов
	CALL	KOORD		; парсим координаты точки

	TST	R4		; вторая точка задана как STEP(...)?
	BEQ	4$
	MOV	#LSTP,-2(R1)	; заменить опкод на LSTP (координаты относительные)
4$:
	CALL	SPL		; необязательный цвет
	CMP	-2(1),#RSP
	BNE	5$		; цвет указан явно =>
	MOV	#SPFORM,(1)+	; цвет не указан - дописать SPFORM (выровнять формат данных)
5$:
	MOV #SPSET,(R1)+
	CMPB	@R3,#',		; есть ли ",B" или ",BF"?
	BEQ	10$
	TST	R2		; запятая после цвета была без значения (см. SPL)?
	BEQ	L7
	TRAP	24.		; ошибка - параметр пропущен между запятыми
10$:	INC	R3
	.T	113		; сравнить с B / BF
	.WORD	RWLINE
	.BYTE	2,2
SYNER3:	TRAP	2		; ни B, ни BF, ни просто конец - ошибка синтаксиса
	ADD	R5,PC		; переход по индексу совпадения (R5 от TRAP 113)
	BR	L8		; B (прямоугольник контуром) =>
	MOV	#RECSET,(R1)+	; BF (закрашенный прямоугольник) - опкод RECSET
	BR	L9
L7:	MOV	#LSET,(R1)+	; ни B, ни BF - обычная линия, опкод LSET
	BR	L9
L8:	MOV	#BOXSET,(R1)+	; B - опкод BOXSET (прямоугольник контуром)
L9:

	TRAP	106		; конец оператора
	RETURN

; Парсинг координат точки (x,y) или STEP(x,y) - перед ними может быть '@'/STEP.
; R4 на выходе ненулевой, если координаты относительные (был '@' или STEP).
KOORD:	CLR	-(SP)
	CMPB	(R3)+,#'@	; символ '@' перед координатами?
	BEQ	1$
	DEC	R3
	.T	113		; или ключевое слово STEP?
	.WORD	RWFOR+3
	.BYTE	2,0
	BR	3$
1$:	INC	@SP		; запомнить признак "координаты относительные"
3$:	TRAP	127		; (
	TRAP	124		; два целых выражения через запятую: x,y
	TRAP	130		; )
	MOV	(SP)+,R4
	BEQ	8$
	MOV	#STP,(R1)+
8$:	RETURN

; Оператор FIND
FIND::	CLR	R2		; R2 = смещение $FIND в таблице AFILE
	BR	DR		; => общая обработка файловых операторов

; Оператор SAVE
SAVE::	MOV	#4,R2		; R2 = смещение $SAVE в таблице AFILE
	BR	DR		; => общая обработка файловых операторов

; Оператор CSAVE
CSAVE::	MOV	#6,R2		; R2 = смещение $CSAVE в таблице AFILE
	BR	DR		; => общая обработка файловых операторов

; Оператор LOAD
LOAD::	MOV	#10,R2		; R2 = смещение $LOAD в таблице AFILE
	BR	MR		; => резервирование аргумента, затем DR

; Оператор CLOAD
CLOAD::	MOV	#12,R2		; R2 = смещение $CLOAD в таблице AFILE
	BR	MR		; => резервирование аргумента, затем DR

; Оператор MERGE
MERGE::	MOV	#14,R2		; R2 = смещение $MERGE в таблице AFILE
MR:	MOV	R1,-(SP)	; запомнить место под аргумент в коде
	TST	(R1)+		; зарезервировать слово в коде под аргумент
	BR	DR		; => общая обработка файловых операторов

; Оператор DRAW
DRAW::	MOV	#2,R2		; R2 = смещение $DRAW в таблице AFILE

; Общая обработка файловых операторов (FIND/SAVE/CSAVE/LOAD/CLOAD/MERGE/DRAW):
; R2 - смещение нужного обработчика в таблице AFILE.
DR:	TRAP	115		; разбор аргумента (имя файла/строка)
	BR	2$
	CMP	R2,#10
	BLT	1$
	CALL	TSTRUN
	MOV	-(R1),@(SP)+
1$:	TRAP	106		; конец оператора
	MOV	AFILE(R2),(R1)+	; записать адрес выбранного обработчика
	RETURN
2$:
	TST	R2
	BNE	B1
	MOV	#SCONST,(R1)+
	CLR	(R1)+
	CLR	(R1)+
	BR	1$
;
AFILE:	.WORD	$FIND,$DRAW,$SAVE,$CSAVE,$LOAD,$CLOAD,$MERGE
;
; Оператор BSAVE "файл",адрес,длина
BSAVE::	TRAP	115		; разобрать имя файла
B1:	TRAP	13.
	TRAP	126		; обязательная запятая
	TRAP	124		; два целых выражения через запятую: адрес,длина
	MOV	#$BSAVE,R2
	BR	BEND
;
; Оператор BLOAD "файл"[,адрес][,R]
BLOAD::	MOV	R1,-(SP)	; место под адрес имени файла
	TST	(R1)+
	TRAP	115		; разобрать имя файла
	TRAP	13.
	CLR	R2
	CALL	TSTRUN		; необязательный флаг ,R (запустить после загрузки)
	MOV	-(R1),@(SP)+	; записать адрес имени файла
	TRAP	116		; есть ли ",адрес"?
	BR	1$		; нет =>
	TST	(R2)+
	.BJSR	CINT		; Целое выражение
1$:
	TST	R2
	BNE	2$		; адрес указан =>
	MOV	#$BL0,(R1)+	; адрес не указан - опкод $BL0 (загрузить по адресу из файла)
2$:	MOV	#$BLOAD,R2

BEND:
	MOV	R2,(R1)+	; записать выбранный опкод (см. вызовы выше)
	TRAP	106		; конец оператора
	RETURN
;
; Проверить необязательный флаг ",R"/",r" (запустить после BLOAD).
; Записывает опкод TRUE/FALSE.
TSTRUN:	CMPB	@R3,#',
	BNE	2$		; запятой нет =>
	MOV	R3,-(SP)
	INC	R3
	.T	101		; сравнить с 'R'/'r'
	.WORD	RDRM
	BR	1$		; не совпало =>
	TST	(SP)+
	MOV	#TRUE,(R1)+	; флаг R указан
	RETURN
1$:	MOV	(SP)+,R3	; не 'R' - откатить позицию (это не флаг, а другой аргумент)
2$:	MOV	#FALSE,(R1)+	; флаг не указан
	RETURN
;
RDRM:	.BYTE	'R,'r,0
.EVEN

; Оператор PAINT
; Оператор PAINT(x,y)[,цвет_заливки[,цвет_границы]]
PAINT::	CALL	KOORD		; парсим координаты точки
	CALL	SPL		; необязательный цвет заливки
	CALL	SPL		; необязательный цвет границы
	CMP	-(R1),#RSP
	BNE	10$		; цвет границы указан явно =>
	MOV	#VIDSP,@R1	; не указан - использовать цвет пера по умолчанию (VIDSP)
10$:	TST	(R1)+
	TRAP	106		; конец оператора
	TST	R2		; была запятая без значения после неё (см. SPL)?
	BEQ	5$
	TRAP	24.		; ошибка - параметр пропущен между запятыми
5$:	MOV	#$PAINT,(R1)+
	RETURN

; Разобрать один необязательный ",цвет". R2 остаётся ненулевым, если после
; запятой значения не было (используется PAINT для проверки TRAP 24 выше).
SPL:	CLR	R2
	TRAP	116		; есть ли ",цвет"?
	BR	1$		; нет =>
	.BJSR	CINT		; Целое выражение
	MOV	#SPFORM,(R1)+	; цвет указан явно - опкод SPFORM
	BR	2$
1$:	MOV	#RSP,(R1)+	; цвет не указан - опкод RSP (значение по умолчанию)
	CMPB	@R3,#',
	BNE	2$
	INC	R3		; запятая есть, но значения после неё нет
	MOV	PC,R2		; R2 = ненулевой признак этой ситуации
2$:	RETURN

; Оператор KEY
; Оператор KEY номер,"текст" (назначить надпись функциональной клавише).
; KEY LIST/ON/OFF (см. закомментированный код ниже) не реализованы.
KEY::
;	.T	113
;	.WORD	RWKEY
;	.BYTE	2,4
;	BR	3$
;	MOV	KEYTAB(R5),(R1)+
;	BR	KEY4
3$:	TRAP	125		; номер клавиши - целое выражение

	CMPB	(R3)+,#',	; обязательная запятая
	BNE	SYNER4
	TRAP	115		; текст надписи - строковое выражение
KEY3:	TRAP	13.
	MOV	#$KEY,(R1)+	; опкод $KEY
KEY4:	TRAP	106		; конец оператора
	RETURN
;KEYTAB::.WORD	KEYISV,KEYON,KEYOFF
;
	TRAP	2		; недостижимо (осталось от отключенного кода выше)

; Оператор CIRCLE
; Оператор CIRCLE(x,y),радиус[,цвет][,нач_угол,кон_угол][,соотн.сторон]
CIRCLE::
	CALL	KOORD		; парсим координаты точки
	TRAP	116		; обязательная ",радиус" (иначе ошибка ниже)
SYNER4:	TRAP	2		; запятая/радиус отсутствуют - ошибка синтаксиса
	.BJSR	CINT		; радиус - привести к целому
	CALL	SPL		; необязательный цвет
	TRAP	116		; есть ли ",начальный_угол"?
	BR	1$		; нет =>
	.BJSR	CSNG		; угол указан - привести к вещественному
	MOV	#ANG1,(R1)+	; опкод ANG1 (начальный угол задан)
	CLR	R2
	BR	2$
1$:	MOV	#ANG01,(R1)+	; опкод ANG01 (начальный угол по умолчанию)
	CMPB	@R3,#',
	BNE	2$
	INC	R3		; запятая есть, но угла после неё нет
	MOV	PC,R2		; R2 = ненулевой признак ошибки (см. TRAP 24 ниже)
2$:	TRAP	116		; есть ли ",конечный_угол"?
	BR	3$		; нет =>
	.BJSR	CSNG		; угол указан - привести к вещественному
	MOV	#ANG2,(R1)+	; опкод ANG2 (конечный угол задан)
	CLR	R2
	BR	4$
3$:	MOV	#ANG02,(R1)+	; опкод ANG02 (конечный угол по умолчанию)
	CMPB	@R3,#',
	BNE	4$
	INC	R3		; запятая есть, но угла после неё нет
	MOV	PC,R2		; R2 = ненулевой признак ошибки
4$:	TRAP	116		; есть ли ",соотношение сторон"?
	BR	10$		; нет =>
	MOV	TYPE,R4
	ASL	R4
	MOV	7$(R4),(R1)+	; опкод ASPSNG/ASPINT по типу выражения
	CLR	R2
	BR	6$
10$:	MOV	#ASP0,(R1)+	; соотношение сторон по умолчанию - опкод ASP0
	CMPB	@R3,#',
	BNE	6$
	INC	R3		; запятая есть, но значения после неё нет
	MOV	PC,R2		; R2 = ненулевой признак ошибки
6$:	TRAP	106		; конец оператора
	TST	R2		; была ли где-то запятая без значения после неё?
	BEQ	8$
	TRAP	24.		; ошибка - параметр пропущен между запятыми

8$:	MOV	#$ARC,(R1)+
	RETURN
7$:	.WORD	ASPSNG,ASPINT	; обработчики соотношения сторон: вещественное/целое

; Оператор DEF
; Оператор DEF. Две формы:
;   DEF USR[n]=адрес        - задать адрес машинного подпроцесса USR(n)
;   DEF FN имя[(парам,...)]=выражение - определить пользовательскую функцию
DEF::
	.T	113		; ключевое слово USR?
	.WORD	RWDEF
	.BYTE	3,2	;12 SU DEFTYP
DEFERR:	TRAP	2		; ошибка синтаксиса
DEFUSR:	TRAP	112		; пропуск пробелов
	TRAP	102		; классифицировать след. символ: буква/цифра/иначе
	BR	1$		; не буква и не цифра (просто USR=...) =>
	BR	DEFFN		; буква (это на самом деле DEF FN) =>
	MOVB	(R3)+,R2	; цифра - номер USR-подпроцесса (0-9)
	SUB	#'0,R2
	ASL	R2
2$:	TST	R5
	BNE	DEFERR
	ADD	#USRTAB,R2	; R2 = адрес нужной ячейки в таблице USRTAB
	TRAP	112		; пропуск пробелов
	CMPB	(R3)+,#'=	; '=' ?
	BNE	DEFERR
	TRAP	125		; адрес подпроцесса - целое выражение
	MOV	#$DEFUS,(R1)+	; опкод $DEFUS (записать адрес в USRTAB)
	TRAP	106		; конец оператора
	MOV	R2,(R1)+
	RETURN
1$:	CLR	R2		; номер по умолчанию - USR0
	BR	2$
;
; DEF FN имя[(парам,...)]=выражение.
DEFFN:	TST	R5		;SUB #2 SU DEFTYP
	BEQ	DEFERR		;BMI	SU DEFTYP
;	BGT	DEFTYP		;	SU DEFTYP
	TSTB	LYGIS
	BNE	11$		; идёт компиляция программы =>
	TRAP	12.		; DEF FN допустим только в тексте программы
11$:	MOV	#DFN,(R1)+	; опкод DFN (точка входа функции при вызове)
	MOV	R0,-(SP)
	MOV	R1,-(SP)
	TST	(R1)+
	TRAP	105		; разобрать имя функции (с типом $/%/!)
	TRAP	2
	TRAP	2
	NOP
	BIS	#100,R5
	BIC	#100000,R5
	MOV	TYPE,R0		; R0 = тип функции (по суффиксу имени)
	CLR	TYPE
	TRAP	104		; завести имя функции в таблицу переменных
	MOV	R4,(R1)+
	TST	(R4)+
	MOV	R4,-(SP)
	CLR	R2		; R2 = счётчик параметров
	CLR	-(SP)
	CMPB	@R3,#'(		; есть ли список параметров в скобках?
	BNE	6$
; Разбор списка формальных параметров через запятую.
1$:	INC	R3

	TRAP	102
	TRAP	2
	BR	3$
2$:	TRAP	2
3$:	TRAP	105		; разобрать имя параметра (с типом)
	TRAP	2
	TRAP	2
	NOP
	MOV	@SP,R4
	MOV	R5,-(SP)
	BMI	5$
4$:	TST	(R4)+
5$:	TST	(R4)+
	MOV	TYPE,-(SP)
	MOV	R4,-(SP)
	INC	R2		; ещё один параметр
	TRAP	112		; пропуск пробелов
	CMPB	@R3,#',		; ',' ?
	BEQ	1$		; ещё параметр => разобрать следующий
	TRAP	130		; )
6$:	MOV	R2,(R1)+	; число параметров
	CMPB	(R3)+,#'=
	BNE	2$		; нет '=' - ошибка синтаксиса
	MOV	SP,PFACT
	MOV	R1,-(SP)
	ASL	R2
	ADD	R2,R1		; зарезервировать место в коде под аргументы
	TST	R0
	BPL	7$		; тип функции числовой =>
	TRAP	115		; строковый тип - тело функции: строковое выражение
	TRAP	13.
	CLR	R0
	TST	R4
	BGT	8$
	MOV	#NEWSTR,(1)+	; результату нужна новая память под строку
	BR	8$
7$:	TRAP	100		; тело функции - числовое выражение
	ASL	R0
	.BJSRA	ATCONV(R0)	; привести к типу функции
8$:	CLR	PFACT
	MOV	(SP)+,R4
; Скопировать сохранённые (тип,адрес) каждого параметра в зарезервированное
; в коде место (см. ASL R2/ADD R2,R1 выше).
9$:	TST	(SP)+
	BEQ	10$
	MOV	(SP)+,(R4)+
	TST	(SP)+
	BR	9$
10$:	MOV	ARET(R0),(R1)+	; опкод возврата: SFNRET (строка) / IFNRET (число)
	MOV	(SP)+,(R1)+
	MOV	R1,@(SP)+
	MOV	(SP)+,R0
	TRAP	106		; конец оператора
	RETURN
ARET:	.WORD	SFNRET,IFNRET	; возврат из DEF FN: строковый / числовой результат
;
;
; Оператор ON
; Оператор ON: две формы - "ON TRAP(код) GOSUB строка" (обработчик ошибки)
; и "ON выражение GOTO/GOSUB строка[,строка...]" (переход по номеру варианта).
ON::	.T	113		; ключевое слово TRAP?
	.WORD	RWON1
	.BYTE	3,0
	BR	2$		; не TRAP => обычная форма ON выражение GOTO/GOSUB

	TSTB	LYGIS		;ON TRAP
	BNE	3$		; идёт компиляция программы =>
	TRAP	12.		; ON TRAP допустим только в тексте программы
3$:	CALL	PAR		; разобрать (код ошибки) в скобках
	.T	113		; обязательно ключевое слово GOSUB
	.WORD	RWON
	.BYTE	3,0
	TRAP	2
; Собрать в код небольшой машинный код-переходник: сохранить регистры,
; вызвать обработчик через GOSUB на нужную строку, восстановить регистры.
	MOV	#ONTRG$,(R1)+
	MOV	R1,-(SP)
	TST	(R1)+		;APEJIMUI
	CLR	(R1)+		;SARASUI
	CLR	(R1)+		;VEKT. SAUGOJIMUI
	MOV	#4537,(R1)+
	MOV	#SREG,(R1)+
	MOV	#12704,(R1)+
	TST	(R1)+
	MOV	#5037,(R1)+
	MOV	#SAVJMP,(R1)+
	MOV	#134,(R1)+
	MOV	R1,-10(R1)
	CALL	GOSUB		; разобрать и скомпилировать строку-обработчик (как GOSUB)
	TST	(R1)+
	MOV	R1,-2(R1)
	MOV	#4537,(R1)+
	MOV	#RREG,(R1)+
	MOV	#2,(R1)+
	MOV	R1,@(SP)+
	RETURN

2$:	TRAP	100		; выражение-индекс варианта
	.BJSR	CINT		; Целое выражение
	.T	113		; обязательно GOTO или GOSUB
	.WORD	RWON
	.BYTE	3,2
	TRAP	2		; ни GOTO, ни GOSUB - ошибка синтаксиса
	MOV	ADRON(R5),(R1)+	; опкод ONJMP или ONJSR (по GOTO/GOSUB)
	MOV	R0,-(SP)
	CLR	R0
	CLR	R2		; R2 = счётчик перечисленных строк
	MOV	R1,-(SP)
	TST	(R1)+		; зарезервировать слово под счётчик строк
1$:	CALL	TO		; разобрать и разрешить очередной номер строки (как GOTO)
	INC	R2
	TRAP	112		; пропуск пробелов
	CMPB	(R3)+,#',	; ',' ?
	BEQ	1$		; ещё строка => разобрать следующую
	DEC	R3
	MOV	R2,@(SP)+	; записать итоговое число строк
	MOV	(SP)+,R0
	TRAP	106		; конец оператора
	RETURN

ADRON:	.WORD	ONJSR,ONJMP	; опкоды: ON...GOSUB / ON...GOTO

PAR:	TRAP	127		; (
	TRAP	100
	TRAP	130		; )
	.BJSR	CINT		; Целое выражение
	RETURN

; Оператор TRAP
; Оператор TRAP(код) OFF - отключить перехват ошибки с данным кодом
; (парный к ON TRAP(код) GOSUB строка - см. ON::).
TRAP:
	CALL	PAR		; разобрать (код ошибки) в скобках
	.T	113		; обязательно ключевое слово OFF
	.WORD	RWTRAP
	.BYTE	3,0
	TRAP	2		; не OFF - ошибка синтаксиса
	MOV	#TRPOF$,(R1)+	; опкод TRPOF$ (отключить перехват)
	RETURN

; Оператор OPEN
; Оператор OPEN "файл" [FOR OUTPUT|INPUT] [AS #n - не реализовано]
OPEN::	TRAP	115		; разобрать имя файла
	TRAP	56.		; ошибка при разборе имени
	CLR	R2		; по умолчанию - OUTPUT
	.T	113		; необязательное ключевое слово FOR
	.WORD	OPFOR
	.BYTE	3,0
	BR	1$		; FOR нет - используем режим по умолчанию =>
	.T	113		; обязательно OUTPUT или INPUT
	.WORD	RWOPEN
	.BYTE	6,2
	TRAP	2		; ни OUTPUT, ни INPUT - ошибка синтаксиса
	MOV	R5,R2		; R2 - выбранный режим (индекс в таблице OP)
1$:
;	.T	113
;	.WORD	RWOPEN+13.
;	.BYTE	2,0
;	BR	2$
;	CALL	FILNUM
;	BR	3$
;2$:	MOV	#ICONST,(R1)+
;	MOV	#1,(R1)+
;
3$:	TRAP	106		; конец оператора
	MOV	OP(R2),(R1)+	; опкод OPOUT или OPINP
	RETURN
;
OP:	.WORD	OPOUT,OPINP	; обработчики: открыть на запись / на чтение
;
; Оператор CLOSE
CLOSE::
;	CLR	R2
;	CMPB	@R3,#12
;	BEQ	2$
;1$:	CALL	FILNUM
;	INC	R2
;	CMPB	(R3)+,#',
;	BEQ	1$
;	DEC	R3
;
2$:	TRAP	106		; конец оператора
	MOV	#CLOFIL,(R1)+	; записать адрес обработчика CLOFIL (закрыть файл)
;	MOV	R2,(R1)+
	RETURN
;
;FILNUM:	TRAP	112	; пропустить разделители
;	CMPB	@R3,#'#		; '#' ?
;	BNE	1$
;	INC	R3
;1$:
;	TRAP	100
;	.BJSR	CINT		; Целое выражение
;	RETURN
;
; Вызывается как JSR R2,TSTFLN (адрес возврата в R2). Проверяет необязательный
; "#файл," перед списком PRINT/INPUT. Флаг на стеке: 0 - файла нет,
; ненулевой - файл указан (используется затем в TSTFIL).
TSTFLN:	CLR	@SP
	CMPB	@R3,#'#		; символ '#' - есть номер файла?
	BNE	1$		; нет =>
	DEC	@SP		; есть - отметить флаг
	INC	R3		; пропустить '#'
;	CALL	FILNUM
;	TRAP	126
	MOV	#DEVICE,(R1)+	; опкод DEVICE (выбрать устройство по номеру файла)
1$:	MOV	R2,PC		; вернуться (JSR R2 - адрес возврата в R2)
;1$:	MOV	#INIPRP,(1)+	;PRINT SKAITIKLIS...
;	MOV	R2,PC
;
; Парная к TSTFLN, вызывается после разбора списка PRINT/INPUT (тоже JSR R2).
; Если был указан файл (см. флаг TSTFLN) - вернуть устройство к обычному.
TSTFIL:	TST	(SP)+		; снять флаг, оставленный PRI/INPENT
	TST	@SP		; флаг файла от TSTFLN
	BEQ	1$		; файла не было =>
	MOV	#CLRDEV,(R1)+	; файл был - опкод CLRDEV (сброс устройства)
1$:	RTS	R2		; вернуться (JSR R2)


; Оператор SCREEN
SCREEN::
	TRAP	125		; целое выражение - номер режима экрана
	MOV	#SMODE,(1)+	; записать адрес обработчика SMODE
	TRAP	106		; конец оператора
	RETURN

; Оператор WIDTH [ширина_экрана][,ширина_устройства]. R2 накапливает, какие
; из двух необязательных параметров заданы, и выбирает опкод из AWDT:
; ни один параметр не даёт R2=2 ($MIDLE - WIDTH ,ширина_устройства, экран
; не меняется); только ширина экрана даёт R2=4 ($WIDTH); оба - R2=6 ($WDMD).
; См. реализацию опкодов в JMP.MAC.
WIDTH::	CLR	R2
	CMPB	@R3,#',		; первый параметр (ширина экрана) пропущен?
	BEQ	1$		; да =>
	TRAP	125		; нет - целое выражение
	CMP	(2)+,(2)+	; R2 += 4 (первый параметр учтён)
1$:	TRAP	116		; есть ли второй параметр (,ширина устройства)?
	BR	2$		; нет =>
	TST	(2)+		; есть - R2 += 2
	.BJSR	CINT		; Целое выражение
2$:	MOV	AWDT-2(2),(1)+	; опкод по тому, какие параметры заданы
	TRAP	106		; конец оператора
	RETURN
;
AWDT:	.WORD	$MIDLE,	$WIDTH,	$WDMD	; опкоды WIDTH: устройство / экран / оба (см. JMP.MAC)
;
;LCOPY::	MOV	#$LCOP,(R1)+
;	TRAP	106		; конец оператора
;	RETURN
;
;

; Разбор числового литерала в исходном тексте (компилятор вызывает CALL CISLO
; с адресом возврата, к которому прибавлено смещение-селектор - управление
; возвращается не всегда по адресу сразу после CALL, а со сдвигом, подобно
; механизму TRAP/ATRAP, только вручную через R2 вместо R0).
; Распознаёт: &B/&O/&H-числа (через BOHPAP), числа с ведущей точкой, обычные
; десятичные числа со знаком и необязательной экспонентой (E/D). В конце
; разобранное число упаковывается в float через FLOATS.MAC/PACK.
CISLO::	MOV	(SP)+,R2	; R2 = адрес возврата (снят со стека)
	TST	(R2)+		; пропустить одно слово по адресу возврата
	.T	101		; первый символ - один из спецсимволов SPECHR?
	.WORD	SPECHR
	BR	1$		; нет =>
	ADD	R4,PC		; да - переход по индексу совпадения (& / . / ()
	BR	10$		; '&' =>
	BR	13$		; '.' =>
	TST	(R2)+		; '(' - это не число вовсе, пропустить ещё слово
	MOV	R2,PC		; и вернуться (через изменённый адрес в R2)
10$:	CALL	BOHPAP		; '&' - число в двоичной/восьмеричной/16-ричной системе
12$:	MOV	#1,R4
15$:	CMP	(R2)+,(R2)+	; пропустить ещё два слова по адресу возврата
	MOV	R2,PC		; вернуться
1$:	TRAP	102		; классифицировать первый символ: буква/цифра/иначе
	BR	16$		; не буква и не цифра =>
	MOV	R2,PC		; буква - это не число, вернуться как есть
	BR	2$		; цифра - разобрать как обычное число =>
16$:	TST	LYGIS
	BMI	2$
	TST	-(R2)
	MOV	R2,PC
13$:	DEC	R3		; '.' - вернуть символ точки, разобрать с неё
2$:	MOV	R3,-(SP)	; запомнить начало числа в тексте
	CLR	-(SP)		; флаг знака мантиссы
	.T	101		; необязательный ведущий '+'/'-' (таблица PLMI)
	NEG	R4
	MOV	R4,@SP
	TRAP	117		; разобрать цифры мантиссы (с одной точкой максимум)
	.T	101		; необязательная буква экспоненты (E/D, таблица TYPCHR+1)
	.WORD	TYPCHR+1
	NEG	R4
	TST	R4
	BLE	20$		; буквы экспоненты нет =>
	MOV	(SP)+,R4
	BMI	21$
	INC	@SP
21$:	MOV	(SP)+,R3
	MOV	R4,-(SP)
	TRAP	110		; разобрать десятичные цифры порядка экспоненты
	CLR	R5
	TRAP	117
	INC	R3
	TST	R5
	BMI	24$
	TST	(SP)+
	BLE	12$
26$:	NEG	R5
	BMI	12$
	BR	27$
24$:	TST	(SP)+
	BGT	26$
27$:	TRAP	6		; переполнение порядка экспоненты
20$:	MOV	R4,R5
	TST	(SP)+
	MOV	@SP,R3		; R3 = начало текста числа (для PACK)
	MOV	#500,-(SP)
	CALL	PACK		; упаковать разобранный текст числа в float
	CLR	R4
	TST	R5
	BNE	15$
	INC	R3
	BR	15$

; Разбор числа вида &B.../&O.../&H... (после '&'): следующая буква выбирает
; систему счисления (B/O/H), дальше цифры разбирает CBIN/COCT/CHEX.
BOHPAP::TRAP	102		; классифицировать символ после '&'
	BR	14$		; не буква =>
	BR	11$		; буква =>
14$:	MOV	6(SP),R4
	TRAP	2		; ни B, ни O, ни H - ошибка синтаксиса
11$:	.T	101		; сравнить с B/O/H (таблица TYPBOH)
	.WORD	TYPBOH
	BR	14$		; не совпало =>
	CALL	@ABOH(R4)	; совпало - разобрать цифры в нужной системе счисления
	RETURN

; Шестнадцатеричные цифры в R5. Возврат через C1, если символ не hex-цифра;
; ошибка (TRAP 6, переполнение) если значение не влезает в 16 бит.
CHEX:	CLR	R5
6$:	TRAP	102		; классифицировать очередной символ
	BR	C1		; не буква и не цифра - конец числа =>
	BR	7$		; буква =>
	SUB	#77,R4		; цифра '0'-'9' в двоичное значение
8$:	ADD	#15.,R4
	INC	R3
	CMP	R5,#10000
	BHIS	C3		; переполнение =>
	ASL	R5		; R5 = R5*16 + цифра
	ROL	R5
	ROL	R5
	ROL	R5
	BIS	R4,R5
	BR	6$
7$:	SUB	#'F,R4		; буква - проверить, что 'A'-'F'
	BLE	8$
C1:	RETURN
;
; Восьмеричные цифры в R5.
COCT:	CLR	R5
5$:	MOVB	@R3,R4
	SUB	#60,R4		; символ в двоичное значение цифры
	BIT	#177770,R4	; не '0'-'7' - конец числа =>
	BNE	C1
	INC	R3
	ASL	R5		; R5 = R5*8 + цифра
	BCS	C3		; переполнение =>
	ROL	R5
	BCS	C3
	ROL	R5
	BCS	C3
	BIS	R4,R5
	BR	5$
;
; Двоичные цифры в R5.
CBIN:	CLR	R5
2$:	MOVB	@R3,R4
	SUB	#60,R4

	ROR	R4		; проверить, что цифра 0 или 1
	BNE	C1		; не 0/1 - конец числа =>
	INC	R3
	ROL	R5		; R5 = R5*2 + цифра
	BCC	2$
C3:	TRAP	6		; переполнение - число не влезает в 16 бит
;
ABOH:	.WORD	CBIN,COCT,CHEX	; разбор цифр по системе счисления: B/O/H
SPECHR:	.BYTE	'&,'.,'(,0	; спецсимволы, с которых может начинаться число: &,.,(
TYPBOH:	.BYTE	'B,'O,'H,0	; буквы системы счисления после '&'

.EVEN
	.END

