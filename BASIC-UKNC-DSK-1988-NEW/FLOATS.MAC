
	.ENABLE	LC
	.GLOBL	SAVJMP,BUFOUT
	.GLOBL	SCMP,RNDSAV,III

; PACK – преобразование строки в число с плавающей точкой (float).
; Вход: стек содержит адрес возврата, затем адрес начала строки и длину строки.
; Выход: на стеке два слова: полученное число (старшее, младшее).
; Регистры R0,R1,R2,R4,R5 сохраняются и восстанавливаются.
; Алгоритм:
;   1. Разбор знака, целой части, десятичной точки, дробной части, экспоненты (E).
;   2. Накопление мантиссы (24 бита) в R0,R1 с помощью умножения на 5 и добавления цифр.
;   3. Учёт десятичной экспоненты (положение точки и явная экспонента E) в счётчике R5.
;   4. Масштабирование полученного целого числа (в R0,R1) до числа в диапазоне [1,2) путём сдвигов
;      (умножение/деление на 2) с соответствующей коррекцией экспоненты (R2) для формата float.
;   5. Упаковка в формат: знак (из временного слова на стеке), экспонента (R2), мантисса (R0,R1).
;   6. Результат помещается на стек, стек очищается.
;
PACK::	MOV	4(SP),R3	; R3 = длина строки
	MOV	(SP)+,2(SP)	; снять адрес возврата и сохранить его в 2(SP)
	ADD	R3,(SP)		; теперь (SP) = адрес строки + R3 = адрес конца строки
	MOV	R5,-(SP)	; сохранить R5
	MOV	R4,-(SP)	; сохранить R4
	MOV	R2,-(SP)	; сохранить R2
	MOV	R1,-(SP)	; сохранить R1
	MOV	R0,-(SP)	; сохранить R0
	CLR	-(SP)		; слово для флага знака числа (0 – положительное, 1 – отрицательное)
	MOV	#-9.,R5		; R5 = -11 (счётчик десятичной экспоненты; начальное значение -9. означает, что дробная часть ещё не начата)
	MOV	#41,R2		; R2 = 41 (счётчик для нормализации; позже будет экспонентой формата float)
	CLR	R0		; обнулить старшую часть мантиссы (24 бита в R0,R1)
	CLR	R1
	CMPB	@R3,#53		; первый символ '+'?
	BEQ	PLUS
	CMPB	@R3,#55		; первый символ '-'?
	BNE	SEK1		; если не знак, перейти к разбору цифр
	INC	(SP)		; запомнить, что число отрицательное (флаг на стеке)
PLUS:	INC	R3		; пропустить знак
SEK1:	CLR	-(SP)		; слово для флага десятичной точки (0 – ещё не встречена)
SEK:	MOVB	(R3)+,R4	; взять очередной символ в R4
	CMP	R3,16(SP)	; проверить, не вышли ли за конец строки (16(SP) – адрес конца, сохранённый ранее)
	BHI	EIL		; если конец, перейти к обработке завершения
	SUB	#60,R4		; преобразовать символ цифры в 0-9
	BLT	TASKAS		; если результат < 0, то не цифра – возможно, точка или экспонента
	BNE	SKAIT		; если не ноль, то это цифра 1-9
	CMP	R5,#-9.		; если цифра 0 и счётчик ещё не начинал (R5 = -9.), то ведущий ноль – пропустить
	BEQ	SEK
SKAIT:	CMP	R4,#9.		; проверить, что цифра не больше 9
	BGT	EIL
	INC	R5		; увеличить счётчик цифр (изначально -9., после первого ненулевого станет -8., и т.д.)
	BGT	SEK		; если R5 стал > 0, то это целая часть, больше не нужно накапливать?
	CALL	DAUG5		; умножить текущую мантиссу на 5
	ASL	R1		; сдвинуть влево на 1 (умножение на 2)
	ROL	R0
	ADD	R4,R1		; добавить очередную цифру
	ADC	R0
	BR	SEK
; Обработка символов, не являющихся цифрами: точка или 'E'
TASKAS:	CMP	R4,#-2		; ?? вероятно, обрабатывается десятичная точка
	BNE	EIL		; если не точка (или не специальный символ), то ошибка
	TST	(SP)		; проверить флаг десятичной точки (уже была?)
	BNE	EI2		; если уже была, то ошибка
	MOV	R3,(SP)		; иначе запомнить позицию точки (R3) в слове на стеке
	INC	(SP)		; установить флаг (ненулевое значение)
	BR	SEK		; продолжить
; Обработка ошибок
PEPERP:	TRAP	6		; переполнение или недопустимый символ
;
PKEISN:	CLR	R1
	CLR	R0
	BR	GALAS		; вернуть 0
;
EIL:	TST	(SP)		; проверка на наличие экспоненты?
	BEQ	NERTSK
EI2:	SUB	R3,(SP)		; вычислить длину экспоненты? (непонятно)
NERTSK:	MOV	R5,-(SP)	; сохранить R5
	BGE	GERAS
	CLR	(SP)
GERAS:	CLR	R5
	CMP	R3,20(SP)	; проверка на наличие символа 'E' или 'e'
	BHI	ENDSK
	BICB	#40,R4		; преобразовать букву в верхний регистр
	CMPB	R4,#25		; 'E' - 'A' = 5? Не точно
	BNE	ENDSK
	CMPB	@R3,#100	; проверка на знак экспоненты?
	BGT	ENDSK
	BICB	#40,-1(R3)	; преобразовать предыдущий символ
	CMPB	(R3)+,#53	; проверить '+'
	BEQ	PLIUS
	CMPB	-(R3),#55	; проверить '-'
	BNE	PLIUS
	INCB	5(SP)		; запомнить знак экспоненты
	INC	R3
PLIUS:	MOVB	(R3)+,R4
	CMP	R3,20(SP)
	BHI	ENDE
	SUB	#60,R4
	BLT	ENDE
	CMPB	R4,#11
	BGT	ENDE
	ASL	R5		; накопление экспоненты (умножение на 10)
	ADD	R5,R4
	ASL	R5
	ASL	R5
	ADD	R4,R5
	CMP	R5,#100
	BLOS	PLIUS
	TST	(SP)+
	TSTB	3(SP)
	BEQ	PEPERP
	BR	PKEISN
;
ENDE:	TSTB	5(SP)
	BEQ	ENDSK
	NEG	R5		; если экспонента отрицательная, изменить знак
ENDSK:	ADD	(SP)+,R5	; добавить экспоненту к счётчику R5
	TST	R0
	BNE	YRA
	TST	R1
	BEQ	GALAS
YRA:	ADD	(SP),R5		; добавить флаг десятичной точки (сдвиг)
	BLT	NEIG
	BEQ	PNULIS
; Масштабирование мантиссы (R0,R1) в диапазон [1,2) с учётом экспоненты R5
TEIG:	CMP	R0,#31462	; проверка, не слишком ли велико число (порог для умножения)
	BHI	DID
	CALL	DAUG5		; умножить на 5 (увеличить мантиссу)
	INC	R2		; увеличить экспоненту (компенсация)
ATGAL:	DEC	R5		; уменьшить счётчик десятичной экспоненты
	BGT	TEIG
	BR	PNULIS
DID:	CALL	DG5DL8		; умножить на 5/8 (масштабирование вниз)
	ADD	#3,R2		; скорректировать экспоненту
	BR	ATGAL
;
NEIG:	TST	R0
	BLT	DICKIS
MAZGIS:	DEC	R2		; уменьшить экспоненту
	ASL	R1		; сдвинуть мантиссу влево (умножение на 2)
	ROL	R0
	BPL	MAZGIS
DICKIS:	CALL	DG4DL5		; умножить на 4/5 (масштабирование вниз)
	SUB	#3,R2
	INC	R5
	BLT	NEIG
; Нормализация мантиссы до диапазона [1,2) (старший бит должен быть 1)
PNULIS:	DEC	R2
	ASL	R1
	ROL	R0
	BCC	PNULIS		; сдвигать, пока не появится единица в старшем бите
	ADD	#200,R2		; добавить смещение экспоненты (128)
	BLE	PKEISN		; если экспонента <=0, то число 0
	CMP	R2,#377
	BGT	PEPERP		; переполнение
; Упаковка в формат float
	CLRB	R1
	BISB	R0,R1		; младший байт R1 = старший байт R0 (часть мантиссы)
	SWAB	R1
	CLRB	R0
	BISB	R2,R0		; R0 = экспонента + старший байт мантиссы
	SWAB	R0
	ROR	2(SP)		; извлечь знак числа (из временного слова на стеке)
	ROR	R0		; вставить знак в старший бит R0
	ROR	R1
	ADC	R1		; коррекция округления
	ADC	R0
	BVS	PEPERP
	BCS	PEPERP
GALAS:	DEC	R3
	CMP	(SP)+,(SP)+	; очистить стек от временных слов
	MOV	14(SP),R5
	MOV	R1,14(SP)	; поместить младшее слово результата в стек
	MOV	R0,12(SP)	; поместить старшее слово результата в стек
	MOV	(SP)+,R0	; восстанавливаем регистры
	MOV	(SP)+,R1
	MOV	(SP)+,R2
	MOV	(SP)+,R4
	RTS	R5		; возврат (R5 – сохранённый адрес возврата)

DG5DL8:	CMP	R0,#146314	; проверка на переполнение (граница 1.0?)
	BLO	DAL4
	CALL	DALYT2		; разделить на 2
	INC	R2
DAL4:	MOV	R0,-(SP)
	MOV	R1,-(SP)
	CALL	DL4		; разделить на 4
	BR	PRIDET
;
DAUG5:	MOV	R0,-(SP)	; умножение на 5: (x*4 + x)
	MOV	R1,-(SP)
	ASL	R1
	ROL	R0
	ASL	R1
	ROL	R0		; умножили на 4
PRIDET:	ADD	(SP)+,R1	; добавить исходное x
	ADC	R0
	ADD	(SP)+,R0
	RETURN

; DG4DL5 – умножение 24-битного числа (R1:R0) на 4/5 (0.8)
; путём многократного деления на 2 и сложения с исходным значением.
; Используется для извлечения десятичных цифр при выводе чисел.
; Вход: R0 – старшее слово, R1 – младшее слово (24-битное число).
; Выход: результат в R0,R1; R4 разрушается.
DG4DL5:	MOV	#10,R4		; счётчик итераций = 10
	CALL	DALYT2		; разделить число на 2 (сдвиг вправо)
	MOV	R1,-(SP)	; сохранить младшее слово (исходное/2)
	MOV	R0,-(SP)	; сохранить старшее слово (исходное/2)
IRDAR:	CALL	DL4		; разделить текущее число на 4 (два сдвига)
DARSYK:	CALL	DALYT2		; разделить на 2 (теперь всего деление на 8 от исходного)
	ADD	2(SP),R1	; прибавить сохранённое (исходное/2) к текущему
	ADC	R0
	ADD	@SP,R0		; прибавить старшее слово (исходное/2)
	NEG	R4		; изменить знак счётчика (управление циклами)
	BLT	DARSYK		; если R4 отрицательный, повторить внутренний цикл
	DEC	R4		; иначе уменьшить счётчик
	BGT	IRDAR		; если ещё не 0, повторить внешний цикл
	CMP	(SP)+,(SP)+	; очистить стек (два слова)
	RETURN

; Подпрограмма DL4: беззнаковое деление 24-битного числа (R0:R1) на 4.
; Реализована через два вызова DALYT2 (деление на 2 дважды).
DL4:	CALL	DALYT2
DALYT2:	CLC
	ROR	R0
	ROR	R1
	RETURN

; EGO - подготовка к вызову UNPCK для форматного вывода числа.
; На входе: (SP) - адрес возврата
;           (SP+2)(SP+4) - число с плавающей точкой (старшее слово, младшее слово)
; На выходе: число преобразовано в строку в буфере BUFOUT.
;
EGO::	MOV	(SP)+,R3	; снимаем адрес возврата (сохраняем в R3)
	MOV	(SP)+,R0	; снимаем старшее слово числа в R0
	MOV	(SP),R1		; берём младшее слово числа (не снимая) в R1
	MOV	#BUFOUT,(SP)	; заменяем младшее слово числа на адрес буфера вывода
	MOV	#20,-(SP)	; помещаем длину буфера (20) на стек
	MOV	#7,-(SP)	; помещаем максимальное количество цифр целой части (7) на стек
	MOV	R3,-(SP)	; помещаем адрес возврата на стек (будет использован как адрес возврата из UNPCK)

; UNPCK - преобразование 32-битного числа с плавающей точкой (DEC float) в строку
; На входе: число в R0 (старшее слово) и R1 (младшее слово).
; На стеке: (SP+12) - длина буфера
;           (SP+10) - указатель на начало буфера
; Регистры: R4,R5 - рабочие, R2,R3 - временные.
; На выходе: строка записана в буфер, начиная с адреса, который был в (SP+10).
;
UNPCK::
	MOV	#7,R3		; R3 = 7 (максимальное количество цифр целой части)
	MOV	R4,SAVJMP	; сохраняем R4 в глобальной переменной (используется для возврата)
	MOV	R5,-(SP)	; сохраняем R5 на стеке
	MOV	R3,-(SP)	; сохраняем R3 (7) на стеке
	CLR	R2		; обнуляем R2 (счётчик экспоненты)
	CLR	R5		; обнуляем R5 (счётчик знаков после запятой)
	MOV	12(SP),R4	; R4 = длина буфера (или указатель на конец)
	ADD	R4,10(SP)	; (SP+10) = начало буфера + длина - конец буфера
;
; Извлечение компонент числа: знак, экспонента, мантисса.
; Исходное число хранится в R0 (старшее слово) и R1 (младшее слово).
; После обработки R2 будет содержать истинную экспоненту (со знаком),
; а R0 и R1 - мантиссу (R0 - старшие 16 бит, R1 - младшие 16 бит).
	ROL	R0		; сдвигаем старшее слово, чтобы извлечь знак
	ROR	@SP		; знак (C) помещается в младший бит слова, на которое указывает SP
				; (это сохранённое значение 7, используется как флаг)
	SWAB	R0		; меняем байты местами, чтобы старший байт (экспонента+мантисса) оказался в младшем
	BISB	R0,R2		; R2 получает старший байт исходного R0 (экспонента + старшие биты мантиссы)
	BNE	NE0		; если R2 != 0, число не ноль
;
; Число равно нулю - сразу переходим к формированию строки "0"
	CLR	R4		; R4 = 0 (нет цифр)
	INC	R5		; R5 = 1 (особый признак для формата G)
	BR	ISLIND		; переход к выводу
;
NE0:	SEC			; устанавливаем C=1
	ROR	R0		; восстанавливаем исходный старший бит R0 (часть мантиссы)
	CLRB	R0		; обнуляем младший байт R0 (оставляем только старший байт)
	SWAB	R1		; меняем байты R1: старший байт R1 (биты 8-15 мантиссы) становится младшим
	BISB	R1,R0		; теперь R0 = старший байт исходного R0 (экспонента+старшие биты) | младший байт исходного R1
	CLRB	R1		; обнуляем младший байт R1, оставляя только старший байт (биты 16-23 мантиссы)
	SUB	#200,R2		; R2 = (смещённая экспонента) - 128 - истинная экспонента (со знаком)
	BLT	NEGAT		; если экспонента < 0, число < 1
	BEQ	ZERO		; если экспонента = 0, особый случай (мантисса = 1.0...)
;
; Экспонента положительная - число >= 1.
; Нужно выделить целую часть и преобразовать её в десятичные цифры.
POSIT:	TST	R0		; проверяем старший бит R0 (бит 23 мантиссы)
	BLT	MAZINT		; если бит установлен, мантисса >= 2^23 - требуется коррекция масштаба
	ASL	R1		; иначе сдвигаем мантиссу влево (умножение на 2)
	ROL	R0
	DEC	R2		; уменьшаем экспоненту (компенсируем сдвиг)
	BGT	POSIT		; продолжаем, пока экспонента > 0
	BR	ZERO		; когда экспонента стала 0, переходим к формированию строки
;
MAZINT:	CALL	DG4DL5		; умножаем мантиссу на 4/5 (масштабирование для десятичного разложения)
	INC	R5		; увеличиваем счётчик десятичных знаков
	SUB	#3,R2		; корректируем экспоненту (эквивалент сдвига вправо на 3 бита)
	BGT	POSIT		; продолжаем сдвиги, если экспонента ещё положительна
	BEQ	ZERO		; если экспонента стала 0, переходим к выводу
;
; Экспонента отрицательная - число < 1.
; Выделяем дробную часть, генерируя цифры после запятой.
NEGAT:	CMP	R0,#146314	; сравниваем мантиссу с константой, соответствующей 1.0 в формате
	BHIS	PDALYT		; если мантисса >= 1.0, переходим к делению на 2
	CMP	R2,#-3		; иначе проверяем экспоненту
	BGT	PDALYT		; если экспонента > -3, идём на деление
	CALL	DG5DL4		; иначе умножаем мантиссу на 5/4 (масштабирование)
	DEC	R5		; уменьшаем счётчик знаков после запятой
	ADD	#2,R2		; корректируем экспоненту (увеличиваем на 2)
	BR	TOLIAU		; продолжаем
PDALYT:	CALL	DALYT2		; делим мантиссу на 2 (сдвиг вправо)
TOLIAU:	INC	R2		; увеличиваем экспоненту
	BNE	NEGAT		; пока экспонента не станет 0, повторяем
;
; Теперь экспонента = 0, мантисса приведена к диапазону [1.0, 10.0).
; Начинаем извлекать десятичные цифры (целую часть и дробные).
ZERO:	CLR	R4		; обнуляем старший байт (R4) для накопления очередной цифры
DAUG10:	CALL	DG5DL4		; умножаем мантиссу на 5/4 (эквивалент умножения на 1.25)
	CALL	DAUG8		; умножаем на 8 - суммарно умножение на 10
				; теперь R4 содержит целую часть (цифру от 0 до 9)
	TST	R4		; проверяем, получилась ли ненулевая цифра
	BNE	ISLIND		; если да, начинаем вывод
	DEC	R5		; иначе уменьшаем счётчик знаков (пропускаем ведущие нули)
	BR	DAUG10		; продолжаем извлекать следующую цифру
;
; ISLIND - начало формирования строки.
; Здесь уже получены все десятичные цифры (в R5 - их количество).
; Происходит коррекция указателей и вставка десятичной точки.
ISLIND:	MOV	6(SP),R3	; R3 = 7 (максимальное количество цифр целой части)
	SUB	R3,R2		; R2 = R2 - 7 (смещение для выравнивания)
	DEC	R2		; дополнительная коррекция
;
KLIOP:	CALL	APVAL		; записываем очередную цифру в буфер (используется R4)
;	SUB	#4,10(SP)
;	RORB	@SP
;	BEQ	E	;
;	BCC	1$	;E
;
; Далее логика определения позиции десятичной точки и обработки знаков
;
	CMP	R5,#-1		; проверяем счётчик цифр
	BLT	1$		; если цифр меньше -1, пропускаем
	CMP	R5,6(SP)	; сравниваем с 7
	BGT	1$		; если больше 7, пропускаем
	CLRB	@SP		; сбрасываем флаг (слово на вершине стека)
	ADD	R5,R2		; корректируем указатель
1$:	SUB	#4,10(SP)	; уменьшаем указатель конца буфера на 4 (резервируем место)
E:	ADD	10(SP),R2	; R2 = R2 + конец буфера (теперь R2 указывает на позицию для цифр)
	MOV	R2,R3		; R3 - текущий указатель в буфере
	TSTB	@SP		; проверяем флаг (был ли установлен особый формат)
	BNE	1$		; если флаг установлен, переход к другой ветке
	TST	R5		; проверяем количество цифр
	BLE	TRUP		; если цифр <= 0, идём на TRUP
	SUB	R5,R3		; иначе отступаем назад на R5 позиций
	DEC	R3
	CALL	ZENKL		; записываем знак числа
	BR	OPA		; переходим к форматированию
1$:	DEC	R5
	INC	R2
;
TRUP:	DEC	R3		; отступаем на одну позицию
	CALL	ZENKL		; записываем знак
;	MOVB	#60,(R3)+
	MOVB	#56,(R3)+	; записываем символ '8' (временный заполнитель)
PNUL:	CMP	R3,10(SP)	; проверяем, не достигли ли конца буфера
	BHIS	SKAITM
	MOVB	#60,(R3)+	; заполняем нулями
	BR	PNUL
SKAITM:	MOV	R2,R3		; восстанавливаем указатель
;	INC	R3
	TSTB	@SP		; проверяем флаг
	BEQ	1$
	DEC	R3		; коррекция
	BR	OPA
1$:	INC	R3
	SUB	R5,R3		; корректируем позицию
OPA:	CALL	FORMSK		; финальное форматирование (вставка десятичной точки и т.п.)
	TST	(SP)+		; удаляем одно слово со стека (флаг)
	BEQ	VISKA1		; если флаг не установлен, пропускаем вывод экспоненты
;
; Вывод экспоненты (формат E или G)
	MOVB	#105,(R3)+	; символ 'E'
	MOVB	#'+,@R3		; символ '+'
	TST	R5		; проверяем знак экспоненты
	BGE	VIRS0
	NEG	R5		; если отрицательная, меняем знак
	MOVB	#55,(R3)	; символ '-'
VIRS0:	INC	R3		; переходим к следующему символу
EILE:	MOVB	#60,@R3		; временно '0'
DESIMT:	SUB	#12,R5		; вычитаем 10 (десятичное)
	BLT	VIENZ
	INCB	@R3		; увеличиваем цифру
	BR	DESIMT
VIENZ:	ADD	#72,R5		; преобразуем остаток в ASCII-цифру (0-9)
	INC	R3		; переходим к следующему байту
	MOVB	R5,(R3)+	; записываем младшую цифру экспоненты
;
; Завершение
VISKA1:	MOV	R3,R2		; сохраняем конечный указатель
VISKAS:	MOVB	#40,(2)+	; записываем пробел
	MOV	(SP)+,R5	; восстанавливаем R5
	MOV	(SP)+,@SP	; восстанавливаем SP ??
	SUB	4(SP),R2	; вычисляем длину строки
	MOV	R2,2(SP)	; сохраняем её
	MOV	SAVJMP,R4	; восстанавливаем R4
	CLR	SAVJMP
	RETURN
;
; Подпрограмма DG5DL4: умножает 24-битное число (R1:R0:R4) на 5/4,
; т.е. вычисляет (5/4)*X. Используется в паре с DAUG8 для умножения на 10.
; Вход: R1 = младшее слово, R0 = среднее слово, R4 = старший байт/слово (24 бита).
; Выход: результат в тех же регистрах (R1:R0:R4).
DG5DL4:	MOV	R0,-(SP)	; сохраняем исходное R0 (среднее слово)
	MOV	R1,-(SP)	; сохраняем исходное R1 (младшее слово)
	CALL	DL4		; подпрограмма деления на 4 (сдвиг вправо на 2 бита)
				; После DL4: (R1:R0:R4) = X/4, с учётом переносов.
	ADC	R1		; коррекция переноса после деления (если DL4 не сохранила флаги)
	ADC	R0		; аналогично
	ADD	(SP)+,R1	; добавляем сохранённое исходное R1 (X младшее) к R1 (X/4 младшее)
	ADC	R0		; перенос в среднее слово
	ADC	R4		; перенос в старший байт
	ADD	(SP)+,R0	; добавляем сохранённое исходное R0 (X среднее) к R0 (X/4 среднее)
	ADC	R4		; финальный перенос в старший байт
	RETURN			; результат: X + X/4 = (5/4)*X
;
; Подпрограмма DAUG8: умножает 24-битное число (R1:R0:R4) на 8.
; Используется как часть умножения на 10 (вместе с DG5DL4).
; Вход: R1 - младшее слово, R0 - среднее слово, R4 - старший байт.
; Выход: результат в тех же регистрах (R1:R0:R4) = 8*X.
DAUG8:	MOV	#3,-(SP)	; счётчик = 3 (три сдвига влево)
DG2:	ASL	R1		; сдвиг влево младшего слова (умножение на 2)
	ROL	R0		; сдвиг влево среднего слова с переносом из младшего
	ROL	R4		; сдвиг влево старшего байта с переносом из среднего
	DEC	@SP		; уменьшаем счётчик
	BGT	DG2		; повторяем 3 раза - всего умножение на 2^3 = 8
	TST	(SP)+		; удаляем счётчик из стека
	RETURN
;
; APVAL - добавление десятичной цифры в буфер и подготовка к следующей.
; На входе: R3 - текущий указатель в буфере (куда писать цифру).
;           R4 - десятичная цифра (0?9), полученная из мантиссы.
;           Стек содержит ранее сохранённые значения регистров и флаги.
; На выходе: цифра записывается в буфер, R5 увеличивается (счётчик знаков),
;            R4,R0,R1 могут быть изменены.
; Если позиция R3 выходит за допустимые границы (0..10), ничего не делается.
; Если R3 = 0, выполняется особая коррекция: к цифре добавляется 5 (округляет?).
; Для позиций 1?10 выполняются вычисления, связанные с масштабированием,
; которые, видимо, корректируют мантиссу для извлечения следующей цифры.
APVAL:	CMP	R3,#12		; R3 > 10?
	BGT	NEREIK		; если да - выход (недопустимая позиция)
	TST	R3		; проверяем R3 на 0
	BEQ	SVEIKS		; если 0 - особая обработка
	BLT	NEREIK		; если отрицательное - выход
	MOV	R4,-(SP)	; сохраняем цифру
	MOV	R0,-(SP)	; сохраняем мантиссу (старшее слово)
	MOV	R1,-(SP)	; сохраняем мантиссу (младшее слово)
	MOV	#100000,R0	; загружаем константу 2^15 (32768)
	CLR	R1		; R1=0
DALINT:	DEC	R3		; уменьшаем позицию
	BEQ	UZTEKS		; если достигли нуля - выход из цикла
	CALL	DG4DL5		; умножаем (R1:R0:R4) на 4/5
	CALL	DL4		; делим на 4 (фактически сдвиг на 2)
	CALL	DALYT2		; делим на 2 (сдвиг на 1)
	BR	DALINT		; повторяем для каждой позиции
UZTEKS:	CLR	R4		; обнуляем R4 (старший байт)
	ADD	(SP)+,R1	; добавляем сохранённую цифру к R1
	ADC	R0		; перенос в R0
	ADD	(SP)+,R0	; добавляем сохранённое старшее слово мантиссы
	ADC	R4		; перенос в R4
	ADD	(SP)+,R4	; добавляем сохранённую цифру в R4 (финальная коррекция)
PATIKR:	CMP	#12,R4		; проверяем, не превысила ли цифра 10 (12?=10??)
	BGT	NEREIK		; если >10 - выход (некорректно)
	INC	R5		; увеличиваем счётчик знаков после запятой
NEREIK:	RETURN
SVEIKS:	ADD	#5,R4		; при R3=0 добавляем 5 к цифре (округление)
	BR	PATIKR		; и проверяем результат

; ZENKL - вставка знака числа в строку.
; На входе: R3 - указатель на текущую позицию в буфере (куда писать знак).
;           На стеке (SP+2) - слово, содержащее флаг знака в младшем бите.
; На выходе: в буфер по адресу R3 записывается либо пробел,
;            либо, если знак отрицательный, минус
;            R3 увеличивается на 1.
ZENKL:	MOV	R3,14(SP)	; сохраняем указатель в стеке (для последующего использования)
	MOVB	#40,(R3)+	; записываем пробел (ASCII пробел) и увеличиваем R3
	ASL	2(SP)		; сдвигаем влево слово на стеке (флаг знака); бит знака попадает в C
	BCC	1$		; если C=0 (положительное число), то оставляем пробел
	MOVB	#55,-1(3)	; иначе заменяем последний записанный байт на минус
1$:	RETURN

; FORMSK - финальное форматирование строки: вставка десятичной точки,
; добавление недостающих нулей, округление.
; На входе: R2 - указатель на конец целой части (или начало буфера цифр),
;           R3 - текущий указатель в буфере,
;           R4 - текущая десятичная цифра (для добавления после точки),
;           Стек содержит адрес конца буфера (SP+14) и другие служебные данные.
; На выходе: в буфер вставляется десятичная точка, дробные цифры,
;            возможно, округление; R3 становится указателем на следующий свободный байт.
FORMSK:	MOV	R2,-(SP)	; сохраняем R2 (указатель на начало целой части)
	DEC	@SP		; уменьшаем его на 1 (для удобства сравнений)
	CMP	#12,R4		; сравниваем R4 с 10.
	BGT	NEDVIZ		; если цифра >10, пропускаем вставку десятичной точки
	MOV	R3,@SP		; иначе сохраняем текущий указатель в стеке
	MOVB	#61,(R3)+	; записываем символ '=' - возможно, десятичная точка?
	SUB	#12,R4		; вычитаем 10 из R4 (коррекция для следующего шага)
NEDVIZ:	CMP	R2,R3		; сравниваем указатель начала целой части и текущий
	BNE	NETASK		; если не равны, переходим
	MOVB	#56,(R3)+	; иначе записываем '8' - возможно, заполнитель?
NETASK:	CMP	14(SP),R3	; проверяем, не достигли ли конца буфера
	BLOS	GRIZT		; если R3 <= конец буфера, выходим
	TST	R4		; проверяем, есть ли цифра для вывода
	BEQ	1$		; если нет, пропускаем
	MOV	R3,@SP		; сохраняем указатель
1$:	ADD	#60,R4		; преобразуем цифру (0?9) в ASCII-символ
	MOVB	R4,(R3)+	; записываем цифру
	CLR	R4		; обнуляем R4 (цифра использована)
	CALL	DG5DL4		; умножаем мантиссу на 5/4 (для следующей цифры)
	CALL	DAUG8		; умножаем на 8 - суммарно умножаем на 10
	BR	NEDVIZ		; повторяем для следующей цифры
GRIZT:	MOV	(SP)+,R3	; восстанавливаем R3 (текущий указатель)
	INC	R3		; переходим к следующему символу
	CMP	R3,R2		; сравниваем с указателем начала целой части
	BHIS	2$		; если R3 >= R2, то всё
	MOV	R2,R3		; иначе восстанавливаем R2
2$:	RETURN

; Процедуры арифметики с плавающей точкой
;
ADR::	FADD	SP
	JMP	@(R4)+		; возврат
;
SUB::	FSUB	SP
	JMP	@(R4)+		; возврат
;
MLR::	FMUL	SP
	JMP	@(R4)+		; возврат
;
DVR::	FDIV	SP
	JMP	@(R4)+		; возврат
;
; Обработчик ошибок арифметики с плавающей точкой
; устанавливается на вектор прерывания 244 в MONIT.MAC
FERRI::
	TST	(SP)+
	MTPS	(SP)+
	BCS	1$
	BPL	2$
	CLR	@SP
	CLR	2(SP)
	JMP	@(R4)+		; возврат
2$:	TRAP	6		; Ошибка: переполнение
1$:	TRAP	11.		; Ошибка: деление на ноль

; ABS – модуль числа с плавающей точкой.
; На стеке: старшее слово числа, затем младшее.
; Результат (положительное число) помещается на то же место.
ABS::	BIC	#100000,@SP	; сбросить знаковый бит в старшем слове (сделать число положительным)
	JMP	@(R4)+		; возврат

; SGN – знак числа с плавающей точкой.
; На стеке: два слова – число.
; Результат: +1.0, -1.0 или 0.0 (заменяет исходное число).
SGN::	TST	@SP		; проверить старшее слово (если 0, то число ноль)
	BEQ	1$		; если ноль, перейти к 1$ (оставить 0.0)
	ASL	@SP		; сдвинуть старшее слово влево: знак попадает в C
	MOV	#100400,@SP	; временно записать константу (старшее слово +1.0 с неявной единицей в бите 13)
	ROR	@SP		; вращение вправо: в старший бит вдвигается знак из C, получаем +1.0 или -1.0
	CLR	2(SP)		; обнулить младшее слово (у 1.0 младшее слово 0)
1$:	JMP	@(R4)+		; возврат

; EXPG – экспоненциальная функция e^x.
; Вход: на стеке два слова (float) – аргумент x.
; Выход: на стеке два слова (float) – результат e^x.
; Ошибка переполнения – TRAP 6 (EXK).
; Алгоритм:
;   1. Если x <= -7.0 (приблизительно), результат 0 (EX0).
;   2. Если x >= 7.0 (приблизительно), переполнение (EXK).
;   3. Иначе: представляем x = k * ln 2 + r, где k – целое, |r| ≤ ln 2/2.
;      Тогда e^x = 2^k * e^r.
;   4. Вычисляем e^r методом разложения в ряд (полином) с помощью шитого кода.
;   5. Умножаем на 2^k (сдвигом порядка) и возвращаем результат.
;
EXPG::	MOV	R4,-(SP)	; сохранить R4
	TST	SAVJMP
	BNE	1$
	MOV	R4,SAVJMP	; сохранить глобально
	CLR	@SP		; обнулить младшее слово адреса возврата
1$:	MOV	SP,R4		; R4 указывает на стек
	TST	(R4)+		; пропустить сохранённый R4
	MOV	@R4,R0		; R0 = старшее слово аргумента
	BGT	EX1		; если >0, проверить на переполнение
	CMP	R0,#141662	; если x отрицательный, проверить порог -7.0
	BLOS	EX2		; если >= -7.0, перейти к нормальному вычислению
EX0:	CLR	R0		; иначе результат 0
	CLR	R1
	BR	EXI
EX1:	CMP	R0,#41660	; положительный x, проверить порог +7.0
	BHI	EXK		; если > +7.0, переполнение
EX2:	ASL	R0		; умножить старшее слово на 2 (для выделения целой части)
	CMP	R0,#63000	; если результат меньше порога, то x мал – e^x ≈ 1
	BCS	EX3		; перейти к возврату 1.0
	; иначе вычисляем e^x через разложение
	TST	-(SP)		; выравнивание стека
	CLR	-(SP)		; выделить место
	MOV	#40200,-(SP)	; константа 1.0
	MOV	2(R4),-(SP)	; скопировать младшее слово аргумента
	MOV	@R4,-(SP)	; скопировать старшее слово аргумента
	MOV	2(R4),-(SP)	; дублировать аргумент для операций
	MOV	@R4,-(SP)
	JSR	R4,STAND	; выполнить шитый код для разложения в ряд
	.WORD	EX4		; загрузить константу (1/ln 2)
	.WORD	MLR		; умножение x * (1/ln 2)
	.WORD	RI		; преобразовать в целое (k)
	.WORD	EX5		; сохранить k
	.WORD	IR		; преобразовать k обратно в float
	.WORD	EX4		; загрузить ln 2
	.WORD	DVR		; поделить? (на самом деле r = x - k·ln 2)
	.WORD	SUB		; вычитание
	.WORD	EX6		; начало полинома (ряд для e^r)
	.WORD	MLR		; умножение (r^2)
	.WORD	ADR		; сложение с коэффициентом
	.WORD	DVR		; деление
	.WORD	ADR
	.WORD	ADR
	.WORD	DVR		; деление
	.WORD	EX7		; коррекция порядка
	.WORD	ADR
	.WORD	EX8		; сохранение результата
	.WORD	MLR
	.WORD	EX9		; завершение
EX7:	ADD	#100200,@SP	; инвертировать знак и добавить к порядку +1
	JMP	@(R4)+		; возврат к шитому коду
; EX8 – копирует результат для последующего умножения.
EX8:	MOV	2(SP),-(SP)
	MOV	2(SP),-(SP)
	JMP	@(R4)+		; возврат к шитому коду
; EX4 – помещает константу 1/ln 2 (или ln 2?) на стек.
EX4:	MOV	#125073,-(SP)	; младшее слово? (константа)
	MOV	#40270,-(SP)	; старшее слово? (ln 2 = 40061,71030, здесь 40270 – другое)
	JMP	@(R4)+		; возврат к шитому коду
; EX5 – сохраняет целую степень k.
EX5:	MOV	@SP,12(SP)	; переместить k в нужное место стека
	JMP	@(R4)+		; возврат к шитому коду
; EX6 – подготовка к полиному (сдвиги и коррекция).
EX6:	ROL	@SP		; циклический сдвиг
	ROL	R0
	SUB	#400,@SP
	BLOS	EX10
	ROR	R0
	ROR	@SP
	MOV	@SP,R0
	MOV	2(SP),R1
	MOV	#36602,-(SP)
	MOV	#141100,-(SP)
	MOV	R1,-(SP)
	MOV	R0,-(SP)
	MOV	#71571,-(SP)
	MOV	#42426,-(SP)
	MOV	#56133,-(SP)
	MOV	#41560,-(SP)
	MOV	R1,-(SP)
	MOV	R0,-(SP)
	MOV	R1,-(SP)
	MOV	R0,-(SP)
	JMP	@(R4)+		; возврат к шитому коду
;
EX10:	CMP	(SP)+,(SP)+
EX9:	MOV	(SP)+,R0
	MOV	(SP)+,R1
	MOV	(SP)+,R4
	SWAB	R4
	CLRB	R4
	ASR	R4
	ADD	R4,R0
	BMI	EXK
	; затем падение в EXI (эпилог)
;
; EXI – эпилог для процедур с плавающей точкой, возвращающих результат в R0,R1.
; Вход: R0,R1 – старшее и младшее слова результата (float).
;       Стек содержит адрес возврата в вызывающую программу (через R4) или сохранённый R4.
;       Глобальная переменная SAVJMP используется для сохранения R4 при вложенных вызовах.
; Выход: результат помещается на стек (заменяя операнды), управление передаётся по адресу в R4.EXI:	MOV	(SP)+,R4
EXI:	MOV	(SP)+,R4	; снять слово со стека (если там был адрес возврата – он попадёт в R4)
	BNE	1$		; если R4 ≠ 0, то это нормальный адрес возврата – перейти к 1$
	MOV	SAVJMP,R4	; иначе (R4=0) восстановить R4 из глобальной переменной
	CLR	SAVJMP		; очистить её
1$:	MOV	R0,@SP		; поместить старшее слово результата на вершину стека (заменяя первый операнд)
	MOV	R1,2(SP)	; поместить младшее слово результата на SP+2 (заменяя второй операнд)
	JMP	@(R4)+		; возврат к шитому коду
;
; EX3 – возвращает константу 1.0 (используется, например, при вычислении e^0)
EX3:	MOV	#40200,R0	; старшее слово 1.0 во float
	CLR	R1		; младшее слово 1.0
	BR	EXI		; перейти к эпилогу
;
; EXK – обработка ошибки переполнения при вычислении экспоненты.
EXK:	TRAP	6		; вызов системной ошибки (переполнение)

; ALNG – натуральный логарифм (ln x) числа с плавающей точкой.
; Вход: на стеке два слова – число x (float).
; Выход: на стеке два слова – результат ln x (float).
; Ошибка: если x <= 0, TRAP 5.
; Алгоритм:
;   1. Представить x = m * 2^k, где 1 ≤ m < 2, k – целое.
;      Для этого извлекается экспонента числа (смещённая) и корректируется,
;      а мантисса приводится к диапазону [1,2) установкой неявной единицы.
;   2. ln x = k * ln 2 + ln m.
;      ln m вычисляется с помощью разложения в ряд для ln(1+t), где t = m-1,
;      либо через преобразование m = (1+y)/(1-y) (y = (m-1)/(m+1)), что даёт
;      более быструю сходимость: ln m = 2*(y + y^3/3 + y^5/5 + ...).
;      Для этого используется полином нечётных степеней с коэффициентами:
;        c1 = 2.0, c2 = 0.666669, c3 = 0.399659, c4 = 0.3009745
;      (приближающими 2, 2/3, 2/5, 2/7).
;   3. Шитый код выполняет:
;      - вычисление y = (x-1)/(x+1)
;      - возведение y² в квадрат,
;      - вычисление полинома: 2 * y * (c1 + y²*(c2 + y²*(c3 + y²*c4)))
;      - добавление k * ln 2 (константа ln 2 = 40061,71030 ~= 0.69314718)
;   4. Результат упаковывается и возвращается.
;
ALNG::	MOV	R4,-(SP)	; сохранить R4
	TST	SAVJMP		; проверить глобальную переменную (вложенные вызовы)
	BNE	1$		; если уже занята, не трогать
	MOV	R4,SAVJMP	; сохранить R4 глобально
	CLR	@SP		; обнулить младшее слово адреса возврата (выравнивание)
1$:	MOV	SP,R4		; R4 = текущий указатель стека (вершина – сохранённый R4)
	TST	(R4)+		; пропустить сохранённый R4 (увеличить R4 на 2)
	; теперь R4 указывает на адрес возврата
	CLR	-(SP)		; выделить слово для временной переменной (0)
	MOV	#71030,-(SP)	; младшее слово константы? (вероятно, 1/ln 2)
	MOV	#137661,-(SP)	; старшее слово константы (1/ln 2)
	CMP	-(SP),-(SP)	; дважды уменьшить SP (пропустить эти два слова? странно)
	MOV	2(R4),-(SP)	; скопировать старшее слово аргумента (x) на стек
	MOV	@R4,-(SP)	; скопировать младшее слово аргумента (адрес возврата? Ошибка! Должно быть 4(R4)?)
	BGT	2$		; если аргумент > 0 (проверка по младшему слову? – рискованно)
	TRAP	5		; иначе ошибка: x <= 0
;
2$:	ASL	@SP		; сдвинуть младшее слово аргумента влево (умножить на 2)
	MOVB	1(SP),14(SP)	; скопировать старший байт младшего слова (часть мантиссы)
	MOVB	#200,1(SP)	; установить старший бит мантиссы (восстановить неявную единицу)
	ROR	@SP		; циклический сдвиг вправо (восстановление)
	; Теперь на стеке: временные переменные, константы и модифицированный аргумент
	MOV	#2363,-(SP)	; константа? (младшее слово)
	MOV	#40065,-(SP)	; константа? (старшее слово) – возможно, ln 2
	MOV	6(SP),-(SP)	; скопировать нечто (вероятно, y)
	MOV	6(SP),-(SP)	; ещё одну копию
	MOV	#2363,-(SP)	; снова константа
	MOV	#40065,-(SP)	; снова константа
	JSR	R4,STAND	; выполнить шитый код
	.WORD	SUB		; вычитание (y - константа?)
	.WORD	ALO1		; сохранить результат
	.WORD	ADR		; сложение
	.WORD	DVR		; деление
	.WORD	ALO2		; копирование
	.WORD	ALO2		; ещё раз
	.WORD	MLR		; умножение (возведение в квадрат)
	.WORD	ALO3		; загрузить таблицу коэффициентов (IR)
	.WORD	ALO4		; сохранить результат
	.WORD	ALO4		; сохранить
	.WORD	ALO4		; сохранить
	.WORD	MLR		; умножение
	.WORD	ADR		; сложение
	.WORD	MLR		; умножение
	.WORD	ADR		; сложение
	.WORD	MLR		; умножение
	.WORD	ADR		; сложение
	.WORD	MLR		; умножение
	.WORD	ADR		; сложение
	.WORD	ALO5		; преобразование экспоненты
	.WORD	IR		; преобразование целого (k) в float
	.WORD	ALO6		; добавить ln 2
	.WORD	MLR		; умножить k * ln 2
	.WORD	ADR		; сложить с ln m
	.WORD	ALO7		; коррекция знака
	.WORD	MLR		; умножить на 2 (неявно)
	.WORD	ALO7		; финальная коррекция
; ALO3 – загружает адрес таблицы коэффициентов (IR) и передаёт их в стек.
ALO3:	MOV	(SP)+,R0	; снять первое слово (результат)
	MOV	(SP)+,R1	; снять второе
	MOV	#IR,R2		; адрес таблицы коэффициентов (IR – метка)
	BR	ALO9
; ALO4 – сохраняет текущий результат на стек (два слова) и переходит к загрузке коэффициента.
ALO4:	MOV	R1,-(SP)
	MOV	R0,-(SP)
ALO9:	MOV	-(R2),-(SP)	; загрузить старшее слово коэффициента (из таблицы IR)
	MOV	-(R2),-(SP)	; загрузить младшее слово
	JMP	@(R4)+		; переход к следующей операции STAND
; ALO1 – перемещает результат сложения/вычитания в нужное место стека.
ALO1:	MOV	(SP)+,12(SP)	; взять старшее слово и поместить на SP+12
	MOV	(SP)+,12(SP)	; взять младшее слово и поместить на SP+12
	JMP	@(R4)+
; ALO5 – преобразует байт экспоненты (извлечённый ранее) в число float.
ALO5:	CLR	-(SP)		; выделить место
	BISB	6(SP),@SP	; объединить байт экспоненты с младшим словом?
	SUB	#200,@SP	; вычесть смещение 128 (получить истинную экспоненту)
	JMP	@(R4)+
; ALO2 – копирует два слова (вероятно, y) на вершину стека.
ALO2:	MOV	2(SP),-(SP)	; взять старшее слово со смещением 2
	MOV	2(SP),-(SP)	; взять младшее слово
	JMP	@(R4)+
; ALO6 – помещает на стек константу ln 2 (40061 71030).
ALO6:	MOV	#71030,-(SP)	; константа ln 2 младшее слово
	MOV	#40061,-(SP)	; константа ln 2 старшее
	JMP	@(R4)+
; ALO7 – коррекция
ALO7:	DECB	5(SP)		; уменьшить байт (счётчик)
	BLT	ALO8		; если стало отрицательным, перейти к ALO8
	MOV	#55731,-(SP)	; константа 0.43429449 = log10(e)
	MOV	#37736,-(SP)
	JMP	@(R4)+
;
ALO8:	MOV	(SP)+,R0	; снять старшее слово результата
	MOV	(SP)+,R1	; снять младшее слово
	TST	(SP)+		; очистить стек
	JMP	EXI		; перейти к эпилогу EXI (возврат)

; Таблица коэффициентов для полинома (вероятно, для ln(1+x) или arcth).
; Хранится в формате плавающих чисел (float), в порядке: старшее слово, младшее.
	.WORD	37632, 14525	; 0.3009745
	.WORD	37714, 120036	; 0.399659
	.WORD	40052, 125332	; 0.666669
	.WORD	40400, 0	; 2.0

; IR - преобразование 16-битного целого в число с плавающей точкой (float).
; Результат (два слова) помещается на стек; вызывающая сторона уже выделила
; место под младшее слово (0 на вершине). Знак обрабатывается отдельно,
; экспонента и мантисса формируются путём нормализации модуля числа.
;
IR::	CLR	-(SP)		; выделяем слово для хранения знака
	MOV	2(SP),R1	; загружаем исходное целое (оно лежит на два слова выше)
	BGT	IR1		; положительное -> нормализация
	BEQ	IR4		; ноль -> результат 0.0 (уже на стеке)
	NEG	R1		; отрицательное: берём модуль, знак запомним позже
IR1:	ROL	-(SP)		; сохраняем знак (флаг C) в младшем бите нового слова на стеке
	MOV	#220,R2		; начальное значение экспоненты = 128 (смещение) + 16 (макс. сдвигов)
	CLRB	4(SP)		; очищаем поле мантиссы в старшем слове результата
IR2:	ROL	R1		; сдвигаем модуль влево, ищем старшую единицу
	BCS	IR3		; нашли - выходим
	DEC	R2		; уменьшаем экспоненту (компенсируем сдвиг)
	BR	IR2
IR3:	MOVB	R1,5(SP)	; помещаем оставшиеся биты мантиссы в старшее слово результата
	CLRB	R1		; выделяем байт экспоненты
	BISB	R2,R1		; добавляем к нему смещённую экспоненту
	SWAB	R1		; меняем байты, чтобы экспонента оказалась на своём месте
	ROR	(SP)+		; извлекаем знак из временного слова и снимаем его со стека
	ROR	R1		; вставляем знак в старший бит результата
	RORB	3(SP)		; завершаем формирование мантиссы
	MOV	R1,@SP		; сохраняем старшее слово результата на стеке (младшее уже было)
IR4:	JMP	@(R4)+		; возврат к интерпретатору

; RI - преобразование плавающего числа (float) в 16-битное целое со знаком.
; На стеке лежат два слова числа (младшее, затем старшее). После работы
; на стеке остаётся одно слово - целое число. Если число выходит за пределы
; -32768..32767 или не является целым, генерируется ошибка.
;
RI::	CLR	R2		; R2 будет аккумулятором целой части
	INC	R2		; неявная единица мантиссы (1.xxxx)
	MOV	(SP)+,R1	; забираем младшее слово числа (SP теперь на старшем слове)
	ROL	@SP		; извлекаем знак в C, сдвигая старшее слово
	ROL	R1		; знак попадает в младший бит R1
	ROL	-(SP)		; используем слово перед числом как временное для хранения знака
	MOVB	R1,R0		; R0 = мл.байт R1 (знак + часть мантиссы)
	CLRB	R1		; выделяем байт экспоненты
	SWAB	R1		; экспонента в мл.байте R1
	SUB	#201,R1		; вычитаем 129.: (экспонента - 128. - 1) = количество сдвигов для нормализации
	BLT	RI1		; экспонента < 129. -> число < 1 -> целая часть 0
	BEQ	RI2		; экспонента = 129. -> число = 1.0 -> сдвиг не нужен
	CMP	#17,R1		; проверяем, не слишком ли велика экспонента (> 15.)
	BLT	RI3		; экспонента <= 15. -> нормализация
	; экспонента >=16. -> число не помещается в 16. бит
	SWAB	R0		; подготавливаем старшие биты мантиссы
	CLRB	R0
	BISB	3(SP),R0	; добавляем ещё 8. битов из временного слова
RI4:	ROL	R0		; сдвигаем 32-битную пару (R0,R2) влево
	ROL	R2
	DEC	R1		; повторяем нужное число раз
	BGT	RI4
RI2:	NEG	R2		; результат пока положительный, меняем знак (если нужно)
	BVS	RI5		; переполнение (R2 = -32768.) требует специальной обработки
	BGT	RI3		; если результат стал положительным после NEG - ошибка (был 0)
RI7:	ROR	(SP)+		; извлекаем знак из временного слова
	BCS	RI6		; если знак отрицательный, оставляем R2 как есть
	NEG	R2		; иначе делаем положительным
RI6:	MOV	R2,@SP		; помещаем результат на стек
	JMP	@(R4)+		; возврат
RI5:	ROR	(SP)+		; извлекаем знак для особого случая (-32768.)
	BCS	RI6		; если знак отрицательный, -32768. допустим
RI3:	TRAP	6		; Ошибка: недопустимое значение или переполнение
RI1:	CLR	R2		; число < 1 -> результат 0
	BR	RI7

; SQRG – квадратный корень числа с плавающей точкой (float).
; Вход: на стеке два слова – число (старшее, младшее).
; Выход: на стеке два слова – корень (в том же формате).
; Отрицательный аргумент → TRAP 5. Ноль → результат 0.
; Алгоритм: итерационный метод Ньютона с начальным приближением,
;           использующий шитый код STAND (DVR – деление, ADR – сложение).

SQRG::	CLR	-(SP)		; выделить слово для счётчика итераций (3)
	MOV	R4,SAVJMP	; сохранить R4
	MOV	SP,R4		; R4 указывает на вершину стека (временный указатель)
	TST	(R4)+		; пропустить младшее слово аргумента (проверка?)
	MOV	@R4,R1		; R1 = старшее слово аргумента
	BMI	SQRK		; если отрицательное – ошибка
	BEQ	SQR0		; если ноль – результат 0
	MOV	#3,-(SP)	; счётчик итераций (3) на стек
	ASR	R1		; экспоненту делим на 2 (приближение)
	ADD	#20100,R1	; коррекция мантиссы (начальное приближение)
	CLR	-(SP)		; младшее слово приближения = 0
	MOV	R1,-(SP)	; старшее слово приближения на стек
	CLR	-(SP)		; младшее слово аргумента (0)
	MOV	@R4,-(SP)	; старшее слово аргумента (копия)
	CLR	-(SP)		; младшее слово для операции
	MOV	R1,-(SP)	; старшее слово приближения (второй операнд)
SQR3:	JSR	R4,STAND	; выполнить шитый код:
	.WORD	DVR		; деление: аргумент / приближение
	.WORD	ADR		; сложение: (приближение + результат деления)
	.WORD	SQR4		; переход к SQR4
SQR4:	SUB	#200,@SP	; поделить результат на 2 (экспонента -= 128? – деление на 2 в формате float)
	DEC	4(SP)		; уменьшить счётчик итераций (лежит на 4 выше SP)
	BEQ	SQR2		; если счётчик = 0, выходим
	MOV	12(SP),-(SP)	; иначе скопировать текущее приближение для следующей итерации
	MOV	12(SP),-(SP)
	MOV	6(SP),-(SP)
	MOV	6(SP),-(SP)
	BR	SQR3		; повторить
;
SQR2:	MOV	(SP)+,R0	; снять старшее слово результата
	MOV	(SP)+,R1	; снять младшее слово результата
	TST	(SP)+		; удалить счётчик итераций
SQR1:	JMP	EXI		; переход к эпилогу (вероятно, восстановление R4 и возврат)
;
SQRK:	TRAP	5		; ошибка: корень из отрицательного числа
;
SQR0:	CLR	R0		; результат 0.0
	CLR	R1
	BR	SQR1

; KOS и SING - вычисление косинуса и синуса числа с плавающей точкой.
; Алгоритм:
;   1. Приведение аргумента к диапазону [0, PI/2] путём деления на PI/2,
;      выделения целой части (квадранта) и взятия дробной части.
;   2. Для синуса: если квадрант нечётный, добавляется PI/2.
;      Для косинуса: аргумент сдвигается на PI/2 (cos x = sin(x+PI/2)).
;   3. Приведённый аргумент (в [0, PI/2]) раскладывается в полином
;      с коэффициентами из таблицы ATANG.
;   4. Знак результата корректируется в зависимости от квадранта.
; Полином вычисляется по схеме Горнера:
;   sin(x) ~= t * (a1 + t^2*(a2 + t^2*(a3 + t^2*(a4 + t^2*a5))))
; Коэффициенты получены из разложения Маклорена sin(x) с подстановкой x = (PI/2)*t:
;   a1 = PI/2 ~= 1.57079632679
;   a2 = -(PI/2)^3 / 3! ~= -0.645964
;   a3 = (PI/2)^5 / 5! ~= 0.0796897
;   a4 = -(PI/2)^7 / 7! ~= -0.00467377
;   a5 = (PI/2)^9 / 9! ~= 0.000151484
; Вход: на стеке два слова (аргумент, float).
; Выход: на стеке два слова (результат, float).
;
; KOS - косинус
; cos(x) = sin(x + PI/2)
KOS::	MOV	R4,-(SP)	; сохранить адрес возврата
	TST	SAVJMP		; если SAVJMP не занят,
	BNE	1$		; то сохранить R4 глобально (для вложенных вызовов)
	MOV	R4,SAVJMP
	CLR	@SP		; обнулить младшее слово аргумента (для выравнивания?)
1$:	CLR	-(SP)		; выделить место под результат
	MOV	6(SP),-(SP)	; скопировать старшее слово аргумента
	MOV	6(SP),-(SP)	; скопировать младшее слово аргумента
	MOV	#007733,-(SP)	; младшее слово PI/2
	MOV	#040311,-(SP)	; старшее слово PI/2
	JSR	R4,STAND	; выполнить STAND:
	.WORD	ADR		; сложение: аргумент + PI/2
	.WORD	SING1		; затем перейти к общей части SING1 (синус от x+PI/2)
;
; SING - синус
SING::	MOV	R4,-(SP)
	TST	SAVJMP
	BNE	1$
	MOV	R4,SAVJMP
	CLR	@SP
1$:	CLR	-(SP)		; выделить место
	MOV	6(SP),-(SP)	; скопировать аргумент (старшее)
	MOV	6(SP),-(SP)	; скопировать аргумент (младшее)
SING1:	ASL	@SP		; выдвигаем знак в C
	ROR	4(SP)		; сохраняем знак в 4(SP)
	ROR	@SP		; старшее слово сдвигаем обратно, знак 0
	MOV	#7733,-(SP)	; младшее слово 2/PI? (константа)
	MOV	#40711,-(SP)	; старшее слово 2/PI (40711,7733 = 2/PI в float)
	JSR	R4,STAND	; выполнить шитый код
	.WORD	DVR		; деление: (2x) / (2/PI) = x * PI
	; На самом деле это приведение: вычисляем t = (2x)/PI, затем выделяем целую часть.
	.WORD	TAR1		; копировать результат (t)
	.WORD	SVD1		; отбросить дробную часть -> целое число квадрантов N
	.WORD	SUB		; вычесть: t - N -> дробная часть в [0,1)
	.WORD	TAR2		; проверить флаг (была ли дробная часть)
	.WORD	TAR1		; снова скопировать t
	.WORD	SVD1		; опять отбросить дробную часть (уже не нужно? возможно, для другого)
	.WORD	TAR3		; объединить флаги
	.WORD	SUB		; вычесть (подготовка к полиному)
	.WORD	TAR4		; коррекция знака и добавление 1.0 при необходимости
TAR8:	.WORD	TAR1		; начало полиномиального разложения
	.WORD	TAR1
	.WORD	MLR		; умножение (возведение в квадрат)
	.WORD	TAR5		; загрузить коэффициенты
	.WORD	MLR
	.WORD	ADR
	.WORD	MLR
	.WORD	ADR
	.WORD	MLR
	.WORD	ADR
	.WORD	MLR
	.WORD	ADR
	.WORD	MLR
	.WORD	SING2
SING2:	TST	4(SP)		; проверить флаг квадранта (знак)
	BGE	SINGI
	ADD	#100000,@SP	; изменить знак результата (добавить 100000₈ к старшему слову)
SINGI:	MOV	(SP)+,6(SP)	; переместить результат на место исходного аргумента
	MOV	(SP)+,6(SP)
	TST	(SP)+		; удалить временное слово
BYE:	MOV	(SP)+,R4	; восстановить R4
	BNE	1$
	MOV	SAVJMP,R4
	CLR	SAVJMP
1$:	JMP	@(R4)+		; возврат
; TAR1 - дублирует два слова (число) с позиции SP+2 на вершину стека.
TAR1:	MOV	2(SP),-(SP)
	MOV	2(SP),-(SP)
	JMP	@(R4)+		; возврат
; TAR2 - если вершина стека ≠ 0, увеличивает байт по адресу SP+1
; (используется для коррекции знака или счётчика квадрантов).
TAR2:	TST	@SP
	BEQ	SING2
	INCB	1(SP)
	JMP	@(R4)+		; возврат
; TAR3 - побитовое ИЛИ вершины стека со словом 10(SP) (объединение флагов).
TAR3:	BIS	@SP,10(SP)
	JMP	@(R4)+		; возврат
; TAR4 - проверяет байт 4(SP). Если не ноль, корректирует знак,
; добавляет 1.0 и переходит к полиному (TAR8).
TAR4:	TSTB	4(SP)
	BEQ	SING3
	ADD	#100000,@SP	; инвертировать знак (xor с 100000₈)
	CLR	-(SP)		; 1.0 (младшее слово 0)
	MOV	#40200,-(SP)	; старшее слово 1.0
	JSR	R4,STAND	; выполнить шитый код
	.WORD	ADR		; сложение с 1.0
	.WORD	SING4
SING4:	MOV	#TAR8,R4	; указатель на продолжение шитого кода
SING3:	ASRB	5(SP)		; проверить младший бит байта 5(SP)
	BCC	4$
	ADD	#100000,@SP	; если бит = 1, изменить знак
4$:	JMP	@(R4)+		; начать выполнение полинома

; TAR5 - завершает загрузку коэффициентов полинома из таблицы ATANG.
; Таблица содержит 5 коэффициентов (по два слова каждый) для разложения.
TAR5:	MOV	(SP)+,R0	; снять текущий результат (старшее слово)
	MOV	(SP)+,R1	; снять младшее слово
	MOV	#ATANG,R2	; адрес таблицы коэффициентов
	MOV	#5,R3		; количество коэффициентов
	BR	TAR6
TAR7:	MOV	R1,-(SP)	; сохранить промежуточный результат
	MOV	R0,-(SP)
TAR6:	MOV	-(R2),-(SP)	; взять старшее слово коэффициента
	MOV	-(R2),-(SP)	; взять младшее слово коэффициента
	DEC	R3
	BGT	TAR7		; повторять для всех коэффициентов
	JMP	@(R4)+		; перейти к следующей подпрограмме
;
; Таблица коэффициентов для полиномиальной аппроксимации синуса/косинуса.
; Коэффициенты представлены в формате float (по два слова: старшее, младшее).
	.WORD	035036, 153672	; a5 (~= 0.000151484)
	.WORD	136231, 023143	; a4 (~= -0.00467377)
	.WORD	037243, 032130	; a3 (~= 0.0796897)
	.WORD	140045, 056741	; a2 (~= -0.645964)
	.WORD	040311, 007733	; a1 = PI/2 (~= 1.5707963)

; ATANG – вычисление арктангенса числа с плавающей точкой (float).
; Алгоритм:
;   1. Запоминаем знак аргумента, работаем с |x|.
;   2. Если |x| > 1, используем тождество arctg(x) = PI/2 - arctg(1/x).
;   3. Если |x| > tan(PI/12) ~= 0.267949, используем тождество arctg(x) = PI/4 + arctg((x-1)/(x+1)).
;      Это приводит аргумент к интервалу [0, tan(PI/12)].
;   4. Для малого аргумента (|x| <= tan(PI/12)) вычисляем полином:
;        arctg(x) ~= x * (c1 + x^2*(c2 + x^2*(c3 + x^2*(c4 + x^2*c5))))
;      где коэффициенты c1..c5 подобраны для минимизации ошибки на данном интервале
;      (c1 = 1, c2 = -1/3, c3 = 0.199977, c4 = -0.141957, c5 = 0.0963035).
;   5. Корректируем знак и добавляем PI/4 или PI/2 в зависимости от выполненных преобразований.
;
ATANG::	CLR	-(SP)		; выделить место для флага знака? (будет использоваться)
	MOV	R4,SAVJMP	; сохранить R4 глобально (для вложенных вызовов STAND)
	CLR	-(SP)		; выделить место под временные переменные? (5 слов)
	CLR	-(SP)
	CLR	-(SP)
	CLR	-(SP)
	CLR	-(SP)
	MOV	16(SP),-(SP)	; скопировать младшее слово аргумента (лежит на SP+16)
	MOV	16(SP),-(SP)	; скопировать старшее слово аргумента
	BGE	AT1		; если аргумент >=0 переходим
	ADD	#100000,@SP	; инвертировать знак числа – сделать положительным
	INC	14(SP)		; увеличить флаг знака – запомнить, x был отрицательным
AT1:	CMP	@SP,#40200	; сравнить старшее слово аргумента с 1.0
	BCS	AT3		; если аргумент < 1.0, перейти к AT3 (не требуется деление)
	BGT	AT2		; если > 1.0, перейти к AT2 (нужно использовать arctg(x) = PI/2 - arctg(1/x))
	TST	2(SP)		; x = 1.0 ? проверить младшее слово (должно быть 0)
	BEQ	AT3		; если действительно 1.0, то arctg(1)=PI/4, но здесь идёт на AT3 (возможно, особый случай)
;
AT2:	MOV	#140311,4(SP)	; положить PI/2 (старшее слово 140311? но PI/2 = 40311 7733, здесь 140311 – это -PI/2? Проверим: 140311₈ = 1 40311, т.е. отрицательное PI/2)
	MOV	#7733,6(SP)	; младшее слово PI/2 (7733)
	DEC	14(SP)		; уменьшить флаг знака (коррекция для формулы arctg(x) = PI/2 - arctg(1/x))
	MOV	2(SP),-(SP)	; скопировать младшее слово аргумента (1/x?) пока нет, это исходный x? Здесь нужно вычислить 1/x.
	MOV	2(SP),-(SP)	; дублируем
	MOV	#40200,4(SP)	; положить 1.0 (старшее) на место?
	CLR	6(SP)		; младшее 0
	JSR	R4,STAND	; выполнить шитый код
	.WORD	DVR		; разделить 1.0 на x → 1/x (результат на стеке)
	.WORD	AT3		; затем перейти к AT3 (дальнейшая обработка для аргумента 1/x)

AT3:	MOV	2(SP),-(SP)	; скопировать аргумент (теперь это либо исходный x, либо 1/x) – старшее слово
	MOV	2(SP),-(SP)	; скопировать младшее слово
	CLR	4(SP)		; обнулить временное слово (возможно, для хранения константы)
	CLR	6(SP)
	CMP	@SP,#37611	; сравнить старшее слово аргумента с константой tan(PI/8)? 37611₈ = 0.4142?
	BCS	AT5		; если аргумент < tan(PI/8), перейти к полиному (малый аргумент)
	BHI	AT4		; если >, перейти к AT4
	CMP	2(SP),#30243	; если равен, проверить младшее слово (30243₈ – вероятно, младшая часть tan(PI/8))
	BLOS	AT5		; если <=, то малый аргумент
AT4:	MOV	#40006,4(SP)	; константа? 40006₈ – возможно, PI/4? но PI/4 = 40200/2? Не точно.
	MOV	#5222,6(SP)	; младшее слово константы
	; Здесь используется тождество arctg(x) = PI/4 + arctg((x-1)/(x+1)) для x>tan(PI/8)
	; Вычисляем (x-1)/(x+1) и затем arctg от него.
	MOV	@SP,R0		; старшее слово x
	MOV	2(SP),R1	; младшее слово x
	MOV	#131727,-(SP)	; константа? старшее слово 1.0? 131727₈ = 1.0? Нет, 40200 – это 1.0.
	MOV	#140335,-(SP)	; константа? 140335₈ = -0.5? Непонятно.
	MOV	R1,-(SP)	; положить x (младшее)
	MOV	R0,-(SP)	; положить x (старшее)
	CLR	-(SP)		; 0 (младшее)
	MOV	#40200,-(SP)	; 1.0 (старшее)
	MOV	#131727,-(SP)	; снова константа?
	MOV	#40335,-(SP)	; константа?
	MOV	R1,-(SP)	; x
	MOV	R0,-(SP)	; x
	JSR	R4,STAND	; выполнить шитый код
	.WORD	MLR		; умножение (вероятно, для вычисления (x-1)/(x+1))
	.WORD	SUB		; вычитание
	.WORD	AT6		; переход к AT6 (промежуточное сохранение)
	.WORD	SUB		; ещё вычитание
	.WORD	DVR		; деление
	.WORD	AT5		; переход к AT5 (полином)
AT5:	MOV	@SP,R0		; взять аргумент (уже приведённый к малому) – старшее слово
	MOV	2(SP),R1	; младшее слово
	MOV	R1,-(SP)	; положить на стек
	MOV	R0,-(SP)	; дублировать
	MOV	R1,-(SP)	; и ещё раз (для умножения)
	MOV	R0,-(SP)
	JSR	R4,STAND	; выполнить шитый код
	.WORD	MLR		; умножение (возведение в квадрат)
	.WORD	AT7		; переход к AT7 (загрузка коэффициентов полинома)
	.WORD	MLR		; умножение
	.WORD	ADR		; сложение
	.WORD	MLR		; умножение
	.WORD	ADR		; сложение
	.WORD	MLR		; умножение
	.WORD	ADR		; сложение
	.WORD	MLR		; умножение
	.WORD	ADR		; сложение
	.WORD	MLR		; умножение
	.WORD	ADR		; сложение
	.WORD	ADR		; сложение
	.WORD	AT8		; переход к AT8 (коррекция знака)
	.WORD	ADR		; сложение
	.WORD	SINGI		; переход к SINGI (общий выход)
;
AT6:	MOV	(SP)+,12(SP)	; переместить результат (старшее слово) на место (SP+12)
	MOV	(SP)+,12(SP)	; переместить младшее слово
	JMP	@(R4)+		; продолжить выполнение шитого кода
;
AT7:	MOV	(SP)+,R0	; снять результат (старшее)
	MOV	(SP)+,R1	; снять младшее
	MOV	#STAND,R2	; загрузить адрес таблицы коэффициентов (STAND – вероятно, метка начала таблицы)
	MOV	#5,R3		; 5 коэффициентов
	BR	AT9
AT10:	MOV	R1,-(SP)	; сохранить промежуточный результат (младшее)
	MOV	R0,-(SP)	; сохранить старшее
AT9:	MOV	-(R2),-(SP)	; взять очередной коэффициент (старшее слово) и положить на стек
	MOV	-(R2),-(SP)	; взять младшее слово коэффициента
	DEC	R3
	BGT	AT10		; повторить для всех 5 коэффициентов
	JMP	@(R4)+		; продолжить выполнение шитого кода
;
AT8:	TST	10(SP)		; проверить флаг (слово по адресу SP+10 – возможно, признак использования PI/4)
	BEQ	5$		; если 0, пропустить
	ADD	#100000,@SP	; иначе изменить знак результата
5$:	JMP	@(R4)+		; продолжить (далее идёт SINGI – общий выход, который восстанавливает R4 и возвращает результат)
;
; Таблица коэффициентов для полинома арктангенса
	.WORD	037305, 035302	; c5 = 0.0963035
	.WORD	137421, 056514	; c4 = -0.141957
	.WORD	037514, 143333	; c3 = 0.199977
	.WORD	137652, 125244	; c2 = -1/3 ≈ -0.333333
	.WORD	040200, 000000	; c1 = 1.0

; Начать выполнение шитого кода
STAND::	TST	(SP)+
	JMP	@(R4)+		; продолжить выполнение шитого кода

; TANG – вычисление тангенса числа с плавающей точкой (tg(x) = sin(x)/cos(x)).
; Вход: на стеке два слова (аргумент, float).
; Выход: на стеке два слова (результат, float).
; При cos(x) = 0 генерируется ошибка TRAP 6.
;
TANG::	CLR	-(SP)		; выделить слово для временного использования (флаг или выравнивание)
	MOV	R4,SAVJMP	; сохранить R4 глобально (для вложенных вызовов STAND)
	MOV	4(SP),-(SP)	; скопировать старшее слово аргумента на стек
	MOV	4(SP),-(SP)	; скопировать младшее слово аргумента
	JSR	R4,STAND	; запустить выполнение шитого кода
	.WORD	SING		; 1) вычислить sin(x) (результат на стеке)
	.WORD	TAN1		; 2) перейти к TAN1 (сохранить sin(x) во временной области)
	.WORD	KOS		; 3) вычислить cos(x) (результат на стеке)
	.WORD	TAN3		; 4) перейти к TAN3 (проверить cos(x) на ноль)
	.WORD	DVR		; 5) разделить sin(x) на cos(x) → tg(x)
	.WORD	TAN2		; 6) перейти к TAN2 (завершение)
;
TAN2:	MOV	(SP)+,4(SP)	; переместить результат (старшее слово) на место исходного аргумента
	MOV	(SP)+,4(SP)	; переместить младшее слово
	JMP	BYE		; перейти к эпилогу BYE (восстановление R4, возврат)
;
TAN1:	MOV	10(SP),-(SP)	; скопировать sin(x) (лежит на стеке с некоторым смещением) на вершину
	MOV	10(SP),-(SP)	; для последующего использования (сохранить для деления)
TAN4:	JMP	@(R4)+		; продолжить выполнение шитого кода
;
TAN3:	TST	@SP		; проверить старшее слово cos(x) (на вершине стека)
	BNE	TAN4		; если не ноль (cos(x) ≠ 0), перейти к TAN4 (продолжить)
	TRAP	6		; иначе ошибка: деление на ноль (cos(x) = 0 → tg(x) не определён)

; RAN - генератор псевдослучайных чисел в диапазоне [0,1)
; Параметр (16 бит) на стеке:
;   0 -> вернуть предыдущее значение (RNDSAV)
;   <0 -> инициализация генератора (seed = |параметр|, но здесь seed фиксирован PI/2)
;   >0 -> выдать новое случайное число
; Результат: два слова float на стеке (заменяют параметр)
; Глобальные переменные:
;   RNDSAV - предыдущее случайное число (float, 4 байта)
;   III    - состояние генератора (4 байта, 31-битное целое)
;
RAN::	TST	@SP		; проверяем старшее слово параметра
	BEQ	RAN6		; параметр 0 => отдать текущее значение
	BPL	1$		; > 0 => генерация следующего
; Параметр < 0 - инициализация
	CLR	RNDSAV		; сбросить сохранённое значение
	MOV	#40311,III	; начальное состояние = PI/2
	MOV	#7733,III+2
1$:	MOV	#III,R2		; адрес состояния (старшее слово)
	MOV	#III+2,R3	; адрес состояния (младшее слово)
	MOV	@R2,R0		; загрузить текущее состояние
	MOV	@R3,R1
	BEQ	RAN1		; если ноль, особая инициализация
; state = (state * 3 + 1) mod 2^31
	ASL	R1		; умножить на 2
	ROL	R0
	ADD	@R2,R0		; state*3
	ADD	@R3,R1
	ADC	R0
	ADD	@R3,R0		; + state (младшее слово) -> state*3 + 1
	BPL	RAN2		; если нет переполнения знакового бита
	ADD	#100000,R0	; инвертировать знаковый бит
RAN2:	MOV	R0,@R2		; сохранить новое состояние в III
	MOV	R1,@R3
	MOV	#201,R2		; начальная экспонента = 129.
RAN4:	ASL	R1		; нормализация:
	ROL	R0		; сдвигать, пока старшая единица не выйдет в C
	BCS	RAN3
	DEC	R2		; уменьшать экспоненту
	BR	RAN4
; Упаковка в формат float: знак = 0, экспонента = R2, мантисса из старших битов R0,R1
RAN3:	CLRB	R1
	BISB	R0,R1
	SWAB	R1
	CLRB	R0
	BISB	R2,R0
	SWAB	R0
	ROR	R0		; знак = 0
	ROR	R1
	BR	RAN5
; Если состояние обнулилось (например, при инициализации нулём), используем (1,3)
RAN1:	MOV	#3,R1
	INC	R0
	BR	RAN2
RAN5:	TST	RNDSAV		; RNDSAV ещё не заполнено? первый вызов после инициализации
	BNE	RAN7		; не ноль, значит уже было - просто сохраняем новое
; Первое после инициализации: преобразуем целое состояние в float [0,1)
	MOV	R4,SAVJMP	; сохраняем адрес возврата
	MOV	R1,-(SP)	; помещаем полученное число (R0,R1) на стек
	MOV	R0,-(SP)
	CLR	R5		; R5 = 0 (счётчик масштабирования)
	MOV	6(SP),-(SP)	; дублируем число для операций
	MOV	6(SP),-(SP)
	BIC	#100000,@SP	; сбросить знак (работаем с положительным числом)
; Цикл приведения в диапазон [0,1)
13$:	CMP	#40200,@SP	; сравнить старшее слово с 1.0
	BGT	11$		; если > 1.0 -> уменьшить
	DEC	R5		; иначе увеличиваем счётчик
	BGE	15$		; если R5 >= 0, выходим (достигли нужного интервала)
; Число < 1.0, но R5 < 0 -> нужно делить на 10.0
	JSR	R4,STAND	; выполнить шитый код
	.WORD	12$		; положить константу 10.0 на стек
	.WORD	DVR		; разделить число на 10
	.WORD	13$		; продолжить цикл
11$:	MOV	SP,R2
	MOV	(R2)+,6(R2)
	MOV	(R2)+,6(R2)
	INC	R5
	BLE	15$
	JSR	R4,STAND	; выполнить шитый код
	.WORD	12$		; 10.0
	.WORD	MLR		; умножить на 10 (F×)
	.WORD	13$		; повторить
; Подпрограмма для шитого кода: положить 10.0 на стек
12$:	CLR	-(SP)		; константа 10.0 младшее слово
	MOV	#41040,-(SP)	; константа 10.0 старшее слово
	JMP	@(R4)+		; продолжить выполнение шитого кода
; Подпрограмма для шитого кода
15$:	ADD	#4,SP		; удаляем временные копии числа
; Теперь число в [0,1), но требуется ещё отбросить целую часть (которая могла накопиться в R5)
	JSR	R4,STAND	; выполнить шитый код
	.WORD	12$		; положить 10.0 на стек
	.WORD	DVR		; деление на 10.0
	.WORD	16$		; положить 1.0 на стек
	.WORD	ADR		; сложение с 1.0
	.WORD	SUB		; вычитание 1.0 (приведение к [0,1))
	.WORD	17$
; Подпрограмма для шитого кода: положить 1.0 на стек
16$:	CLR	-(SP)		; подпрограмма: положить 1.0 на стек
	MOV	#40200,-(SP)
	JMP	@(R4)+		; продолжить выполнение шитого кода
; Вызывается из для шитого кода
17$:	BIC	#100000,@SP	; сбросить знак результата
	MOV	SP,R2
	MOV	(R2)+,III	; временно сохранить результат в III
	MOV	(R2)+,III+2
	MOV	-(2),R1		; восстановить R0,R1 из результата
	MOV	-(2),R0
	MOV	SAVJMP,R4
	CLR	SAVJMP
;
RAN7:	MOV	R1,RNDSAV+2	; сохранить сгенерированное значение как предыдущее
	MOV	R0,RNDSAV
RAN6:	MOV	RNDSAV+2,2(SP)	; поместить результат на стек (заменяя параметр)
	MOV	RNDSAV,@SP
	JMP	@(R4)+		; возврат в интерпретатор

; ROTG – возведение в степень (общий вход для вещественного показателя)
; На стеке: основание (float, 2 слова), показатель (float, 2 слова).
; Результат: основание^показатель (float).
;
ROTG::	MOV	R4,-(SP)	; сохранить R4 (адрес возврата)
	MOV	R4,SAVJMP	; сохранить глобально (для вложенных вызовов STAND)
	MOV	4(SP),-(SP)	; скопировать старшее слово основания на стек
	MOV	4(SP),-(SP)	; скопировать младшее слово основания
	MOV	2(SP),-(SP)	; скопировать старшее слово показателя
	MOV	2(SP),-(SP)	; скопировать младшее слово показателя
	JSR	R4,STAND	; запустить интерпретатор шитого кода:
	.WORD	SVD1		; 1) отбросить дробную часть показателя (получить целую часть)
	.WORD	ROT3		; 2) перейти к ROT3 (общий код для степени)
;
; ROT3 – ROT5: вспомогательные метки для возведения в степень (POWER).
; На стеке: основание (float, 2 слова), показатель (float, 2 слова).
; Результат: основание ^ показатель (float).
;
ROT3:	CMP	(SP)+,2(SP)	; сравнить младшие слова основания и показателя?
	BNE	ROT4		; если не равны, перейти к ROT4
	CMP	(SP)+,2(SP)	; сравнить старшие слова
	BNE	ROT5		; если не равны, перейти к ROT5
	BR	ROTS		; иначе основание = показатель -> специальный случай
ROT4:	TST	(SP)+		; выровнять стек (удалить одно слово)
ROT5:	MOV	14(SP),-(SP)	; скопировать основание (старшее слово)
	MOV	14(SP),-(SP)	; скопировать основание (младшее слово)
	BEQ	ROT0		; если основание = 0, перейти к ROT0
	BMI	ROTK		; если основание отрицательное, перейти к ROTK (ошибка для нецелого показателя)
	JSR	R4,STAND	; выполнить шитый код
	.WORD	ALNG		; ALNG – логарифм (вероятно, натуральный)
	.WORD	MLR		; умножить логарифм на показатель
	.WORD	ROT1		; затем переход к ROT1
ROT1:	MOV	(SP)+,10(SP)	; переместить результат (старшее слово) на место основания
	MOV	(SP)+,10(SP)	; переместить младшее слово
	MOV	(SP)+,R4	; восстановить R4
	CLR	SAVJMP		; очистить глобальную переменную
	CMP	(SP)+,(SP)+	; очистить стек (два слова)
	JMP	EXPG		; перейти к EXP (экспонента) – завершение

; ROT0 – обработка нулевого основания
ROT0:	CMP	(SP)+,(SP)+	; очистить два слова (копия основания)
	TST	(SP)+		; удалить ещё одно слово? (показатель?)
	BMI	1$		; если показатель отрицательный – ошибка (0 в отрицательной степени)
	TST	(SP)+		; иначе удалить оставшееся слово показателя
	MOV	(SP)+,R4	; восстановить R4
	CMP	(SP)+,(SP)+	; очистить стек
	CLR	2(SP)		; обнулить старшее слово результата (1.0? нет, здесь 0)
	CLR	@SP		; обнулить младшее слово результата
	CLR	SAVJMP
	JMP	@(R4)+		; возврат (результат 0)
1$:	TRAP	11.		; деление на ноль (0^отрицательное)
;
; ROTK – ошибка: отрицательное основание и нецелый показатель
ROTK:	TRAP	5		; ошибка "недопустимый аргумент"

; ROTI – возведение числа с плавающей точкой в целую степень.
; Вход: на стеке – основание (два слова, float), показатель (одно слово,
;       16-битное целое со знаком). Порядок: сначала основание (старшее, младшее),
;       затем показатель на вершине.
; Выход: на стеке – результат (два слова, float) на месте основания,
;        стек очищается от показателя.
;
ROTI::	MOV	@SP,-(SP)	; скопировать показатель (целое) на стек
	BGE	1$		; если >=0, пропустить
	NEG	@SP		; иначе взять модуль (для последующего знака)
1$:	MOV	R4,-(SP)	; сохранить R4
	MOV	R4,SAVJMP	; сохранить глобально
	BR	ROTIJ		; перейти к общему циклу
;
; ROTS – специальный случай: основание = показатель (оба равны 1?)
ROTS:	MOV	@SP,-(SP)	; скопировать основание (или показатель)
	BIC	#100000,@SP	; сбросить знак (сделать положительным)
	CMP	(SP)+,#43777	; сравнить с константой 1.0? (43777 – старшее слово 1.0)
	BGE	ROT5		; если >=1, перейти к обычному возведению
	JSR	R4,STAND	; выполнить шитый код
	.WORD	RI		; преобразовать показатель в целое (RI)
	.WORD	ROT11		; перейти к ROT11
ROT11:	MOV	@SP,6(SP)	; сохранить целый показатель
	BGE	ROT12		; если >=0, пропустить
	NEG	@SP		; иначе взять модуль
ROT12:	MOV	(SP)+,2(SP)	; переместить показатель
ROTIJ:	ASR	2(SP)		; сдвинуть вправо (проверить младший бит)
	BCC	ROT13		; если бит = 0, перейти
	MOV	10(SP),-(SP)	; иначе скопировать основание для умножения
	MOV	10(SP),-(SP)
	TST	6(SP)		; проверить знак основания?
	BEQ	ROT18
	BR	ROT14
ROT13:	CLR	-(SP)		; положить 1.0 (младшее слово 0)
	MOV	#40200,-(SP)	; старшее слово 1.0
	TST	6(SP)
	BEQ	ROT18
ROT14:	MOV	14(SP),-(SP)	; скопировать основание
	MOV	14(SP),-(SP)
ROT16:	MOV	2(SP),-(SP)	; скопировать показатель (целый)
	MOV	2(SP),-(SP)
	JSR	R4,STAND	; выполнить шитый код
	.WORD	MLR		; умножить
	.WORD	ROT15
ROT15:	ASR	12(SP)		; сдвинуть показатель вправо (очередной бит)
	BCC	ROT16		; если бит 0, повторить умножение (возведение в квадрат)
	MOV	6(SP),-(SP)	; иначе скопировать основание
	MOV	6(SP),-(SP)
	MOV	6(SP),-(SP)
	MOV	6(SP),-(SP)
	JSR	R4,STAND	; выполнить шитый код
	.WORD	MLR
	.WORD	ROT17
ROT17:	MOV	(SP)+,6(SP)	; переместить результат
	MOV	(SP)+,6(SP)
	TST	12(SP)		; проверить остаток показателя
	BNE	ROT16		; если не ноль, продолжить
	CMP	(SP)+,(SP)+	; очистить стек
ROT18:	MOV	(SP)+,10(SP)	; переместить результат на место основания
	MOV	(SP)+,10(SP)
	MOV	(SP)+,R4	; восстановить R4
	CLR	SAVJMP
	CMP	(SP)+,(SP)+	; очистить стек
	BLE	PI1		; если результат <= 0? (вероятно, проверка знака)
	MOV	2(SP),-(SP)	; иначе взять обратное значение (1/x)
	MOV	2(SP),-(SP)
	CLR	6(SP)
	MOV	#40200,4(SP)	; 1.0
	JMP	DVR		; разделить 1 на результат (для отрицательного показателя)
;
PI::	MOV	#7733,-(SP)	; константа PI младшее слово
	MOV	#40511,-(SP)	; старшее слово
PI1:	JMP	@(R4)+		; возврат

; SVD1 – отбрасывание дробной части числа с плавающей точкой (приведение к целому)
; Вход: на стеке два слова (число float) – снимаются в R0 (старшее) и R1 (младшее)
; Выход: на стеке два слова – целое число в том же формате
;
SVD1::	MOV	(SP)+,R0	; взять старшее слово числа
	MOV	(SP)+,R1	; взять младшее слово числа
	MOV	R0,R3		; копия старшего слова
	ROL	R3		; сдвиг влево: знак → C, экспонента – в старший байт
	CLRB	R3		; оставить только старший байт (экспонента + старшие биты мантиссы)
	SWAB	R3		; перенести его в младший байт (теперь R3 = смещённая экспонента)
	SUB	#230,R3		; вычесть 152 (коррекция для получения количества сдвигов)
	BGE	2$		; если результат ≥ 0, число ≥ 1 → переход к сохранению (целая часть уже в R0,R1?)
	CMP	#177750,R3	; сравнить с -28 (граница очень малых чисел)
	BLT	1$		; если R3 < -28, число очень маленькое – перейти к отбрасыванию дробной части
	CLR	R0		; иначе (число в (0,1)) результат 0
	CLR	R1
	BR	2$		; на сохранение
;
1$:	MOV	R3,-(SP)	; сохранить счётчик сдвигов
3$:	ROR	R0		; сдвиг вправо (деление на 2) – отбрасывание младших битов
	ROR	R1
	INC	R3		; увеличить счётчик
	BLT	3$		; повторять, пока R3 < 0 (всего |R3| раз)
	MOV	(SP)+,R3	; восстановить исходный счётчик
4$:	ASL	R1		; сдвиг влево (умножение на 2) – возврат масштаба
	ROL	R0
	INC	R3
	BLT	4$		; повторять, пока R3 < 0 (снова |R3| раз)
2$:	MOV	R1,-(SP)	; поместить младшее слово результата на стек
	MOV	R0,-(SP)	; поместить старшее слово результата на стек
	JMP	@(R4)+		; возврат

; INT – приведение числа с плавающей точкой к целому.
; Положительные: отбрасывание дробной части (floor).
; Отрицательные: округление вниз (к меньшему целому, дальше от нуля).
; Вход: на стеке два слова (float).
; Выход: на стеке два слова – целое число в том же формате (без дробной части).
;
INT::	TST	@SP		; проверить знак числа (старшее слово)
	BPL	SVD1		; положительное → просто отбросить дробную часть

	; Отрицательное число: нужно округлить вниз.
	MOV	R4,-(SP)	; сохранить R4 (используется в STAND)
	MOV	R4,SAVJMP	; сохранить глобально для возврата
	MOV	4(SP),-(SP)	; дублируем исходное число на стек (будет операндом)
	MOV	4(SP),-(SP)
	JSR	R4,STAND	; выполнить шитый код
	.WORD	SVD1		; отбросить дробную часть (получить целое)
	.WORD	INT1		; скопировать исходное число на стек
	.WORD	SCMP		; сравнить исходное число с его целой частью
	.WORD	INT2		; подготовить 0 или 1.0 в зависимости от результата сравнения
	.WORD	SUB		; вычесть 1.0, если была дробная часть (иначе 0)
	.WORD	INT0		; завершить и восстановить стек
; INT0 – завершающая подпрограмма: помещает результат на место исходного числа
; и восстанавливает регистры.
INT0:	MOV	(SP)+,4(SP)	; взять результат (старшее слово) и положить на стек выше
	MOV	(SP)+,4(SP)	; то же для младшего
	MOV	(SP)+,R4	; восстановить R4
	CLR	SAVJMP
	JMP	@(R4)+		; продолжить выполнение шитого кода
; INT1 – копирует исходное число (два слова) на вершину стека.
INT1:	MOV	10(SP),-(SP)
	MOV	10(SP),-(SP)
	JMP	@(R4)+		; продолжить выполнение шитого кода
; INT2 – если исходное число равно своему целому (дробной части нет), кладёт 0,
; иначе кладёт 1.0 (для последующего вычитания).
INT2:	BEQ	1$		; если сравнение показало равенство → 0
	CMP	-(SP),-(SP)	; (выравнивание стека)
	CLR	-(SP)		; младшее слово константы 1.0
	MOV	#40200,-(SP)	; старшее слово
	BR	2$
1$:	CMP	-(SP),-(SP)	; (выравнивание)
	CLR	-(SP)		; младшее 0
	CLR	-(SP)		; старшее 0
2$:	JMP	@(R4)+		; продолжить выполнение шитого кода

;
TEXT::

	.END
