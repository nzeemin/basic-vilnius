	.INCLUDE /GENUKD.MAC/
	.SBTTL	INOUT
	.ENABLE	LC


; =========================
; ****БЛОК ВВОДА-ВЫВОДА****
; =========================

; ------------------------------------
; ####КОНСТАНТЫ БЛОКА ВВОДА-ВЫВОДА####
; ------------------------------------

LF==12
CR==15
FF==14
ESC==33

ERRBYT==52

MCSR	=176674
MDBR	=176676
AWPM	=474

ARSK	==177560
ARDK	=177562
ARSTV	=177564
ARDTV	=177566
AVPK	==60
LN	==23.		; КОЛИЧЕСТВО СТРОК ЭКРАНА
MAXLL	==80.		; ШИРИНА ЭКРАНА В СИМВОЛАХ

IRPR=176664

AWPKL==60

DEVEXT==0

; ========================
; ****МАКРООПРЕДЕЛЕНИЯ****
; ========================

	.MCALL	.HRESET

	.MACRO	.BJSR	N
	.IF EQ,MASINA-BK0011
		MOV	#PAG2,-(SP)
		MOV	#N,-(SP)
		.BJSR0
	.IFF
		CALL	N
	.ENDC
	.ENDM	.BJSR

	; ---------------------------------------
	; ## ИНИЦИАЛИЗАЦИЯ БЛОКА ВВОДА-ВЫВОДА ###
	; ---------------------------------------

	.GLOBL	TEXT,BUF,BEND,IODEV,BUFOUT,LPTPOS,FCB,LPLCFL
	.GLOBL	BC,CASCII,BLOCKN,FNDBUF,TRTOPL,BREAK,LYGIS
	.GLOBL	TOINT,SETST,CAS,NEXINT,NEXJMP,JMP,RTS,LNUM,ISVARD
	.GLOBL	STAR,STEP,SEPAP,NOUSR,CTRLC
	.GLOBL	RTIO,BRKO,BREAKW,NAMEW,NAMER,ADRR,ADRW,RD.,WR.,FR.,RER.,MER.
	.GLOBL	TIMER

	.GLOBL	SYSPTR,USRLOC

	.GLOBL	PARAM

	.GLOBL	SCR0,SCR3,RSCR,CSCR,CRTGRP


	.GLOBL	FILTYP,CURS,TABX,TABY,MIDLE,LL,LN,EBUF,LAST,FIRST
	.GLOBL	DFCB,RUSLAT,SCRL,ENDBUF,KOM2P

; MIDM - инициализация устройств ввода-вывода (экран, графика) при старте
; и после сбоя (см. START/INIT в MONIT.MAC). Сбрасывает вывод на экран
; (IODEV=0), временно ставит максимальную ширину (MAXLL) для очистки экрана
; (FF), затем возвращает рабочую ширину по умолчанию (0100 окт.=64).
MIDM::
	.HRESET			; аппаратный сброс
	CALL	NOSTOP
	MOV	#5007,@#BUF	; маркер "буфер пуст" в начало BUF
;	MOV	#BUF,R0
;1$:	MOV	#5012,(R0)+
;	CMP	R0,#BEND
;	BLO	1$
	CLR	@#IODEV		; вывод на экран
;
	MOV	#MAXLL,R2	; временно - максимальная ширина
	CALL	SETWDT

	.BJSR	GRINIT		; инициализировать графику

	MOV	#FF,R0
	CALL	ISV		; очистить экран (form feed)
	MOV	#100,R2		; рабочая ширина по умолчанию (64)
	CALL	SETWDT
;
	CLRB	@#KOM2P		; выключить признак "2-я командная система"
;
	CALL	STOPEN		; разрешить BREAK
	RETURN
;
; SETWDT - установить ширину экрана R2 (символов в строке, для WIDTH):
; LL = ширина, ENDBUF = конец экранного буфера (LN+1 строк * ширина, от
; EBUF), MIDLE = смещение для центрирования при ширине уже полноэкранной.
SETWDT::
	MOV	R2,LL		; LL = ширина строки экрана
	MOV	#LN+1,R1	; LN+1 строк (с запасной)
	MUL	R2,R1
	ADD	#EBUF,R1
	MOV	R1,ENDBUF	; конец экранного буфера
	ASR	R2		; половина ширины
	SUB	#MAXLL/2,R2	; минус половина максимальной ширины
	NEG	R2
	MOV	R2,MIDLE	; смещение центрирования
	RETURN
;
	;
	; -------------------
	; ## ЧТЕНИЕ СТРОКИ ##
	; -------------------
	;
; ISVTO - вывести один символ (R0) с учётом перенаправления IODEV: экран -
; как обычно (ISV); принтер/файл - через ISVETO, оформив символ как строку
; из 1 байта в BUFOUT (LF выводится как пара CR,LF - принтер/файл получают
; настоящий LF вторым байтом).
ISVTO::	TST	IODEV
	BEQ	ISV		; экран => обычный вывод символа =>
	MOV	#BUFOUT,R1
	MOV	#1,R2		; длина по умолчанию - 1 символ

	CMPB	R0,#LF
	BNE	1$		; не LF => как есть =>
	INC	R2		; LF => длина 2 (CR + LF)
	MOVB	R0,1(R1)	; сам LF - вторым байтом
	MOV	#CR,R0		; первым байтом пойдёт CR
1$:
	MOVB	R0,@R1
	JMP	ISVETO		; => вывести через ISVETO (принтер/файл)

;---------------------------
;	FULL SCREEN EDITOR
;---------------------------

;-------------------------------------------
;	ВВОД СТРОКИ
;		ВЫХОД:	R1-КОНЕЧНЫЙ АДРЕС
;			#BUF-НАЧАЛЬНЫЙ АДРЕС
;-------------------------------------------
; IVEIL - полноэкранный ввод строки (клавиатурный цикл). Читает символы
; (IV) и передаёт их на обработку курсора/вставки (PROC, см. таблицу KOD/K*
; ниже), пока не встретит CR (конец строки). CTRL/C прерывает в CTRLC;
; CTRL/A (код 1) выполняет STEP (пошаговый режим), не прерывая ввод.
IVEIL::
	MOV	R0,-(SP)
	MOV	R3,-(SP)
	MOV	CURS,R1		; R1 = позиция курсора в экранном буфере
1$:	CALL	IV		; прочитать символ
	CMP	R0,#CR
	BEQ	3$		; Enter => закончить ввод =>
	CMP	R0,#3
	BEQ	4$		; CTRL/C => прервать =>
	CMP	R0,#1
	BNE	2$		; не CTRL/A => обработать символ =>
	CALL	STEP		; CTRL/A => пошаговое выполнение
2$:	CALL	PROC		; обработать символ (движение курсора/вставка/забой)
	BR	1$
3$:
	CALL	PROC		; обработать сам CR (перевод строки в буфере)
	MOV	R1,CURS
	MOV	(SP)+,R3
	MOV	(SP)+,R0
	RETURN
;
4$:	MOV	R1,CURS
	JMP	CTRLC
;
;--------------------------------
;	ПЕРЕПИСКА СТРОКИ В БУФЕР
;---------------------------------
; INBF0 - ввод строки для INPUT: отмечает начало вводимого текста на экране
; (LF-маркер перед приглашением, если не самое начало буфера), вызывает
; IVEIL для полноэкранного ввода, затем поправляет запомненную позицию
; начала на число строк прокрутки экрана за время ввода (SCRL) и передаёт
; в INBF2 для извлечения текста из экранного буфера в линейный вид.
INBF0::	MOV	R3,-(SP)	;ДЛЯ INPUT
	MOV	CURS,R1
	MOV	TABX,-(SP)	; сохранить колонку курсора (для вычисления начала строки)
	SUB	@SP,R1		; R1 = начало текущей строки экрана
	CMP	R1,#EBUF
	BEQ	4$		; самое начало буфера => LF-маркер не нужен =>
	MOVB	#LF,-1(R1)	; отметить границу перед приглашением
4$:	MOV	R1,-(SP)	; запомнить начало строки ввода
	CLRB	SCRL		; счётчик прокрутки экрана за время ввода
	CALL	IVEIL		; полноэкранный ввод строки
	MOVB	SCRL,R3		; R3 = сколько раз экран прокрутился
	BEQ	2$		; не прокручивался => без поправки =>
1$:	SUB	LL,@SP		; поправить запомненное начало строки на прокрутку
	CMP	@SP,#EBUF
	BEQ	2$		; дошли до начала буфера => хватит =>
	SOB	R3,1$
2$:	SUB	LL,R1		; R1 - на строку выше текущего курсора
	CALL	EPR		; найти конец введённого текста
	CMP	R3,(SP)+	; сравнить со скорректированным началом строки ввода
	BNE	3$
	ADD	@SP,R3
3$:	CLR	(SP)+
	BR	INBF2		; => извлечь текст из экранного буфера
;
; INBF1 - вход для ANALIZ (прямой режим): R1 - конечная позиция курсора,
; оставленная предыдущим IVEIL. Находит конец введённого текста (EPR) и
; передаёт в INBF2.
INBF1::	MOV	R3,-(SP)	;ДЛЯ ANALIZ
	SUB	LL,R1		; строкой выше текущего курсора
	CALL	EPR		; найти конец введённого текста
;
; INBF2 - извлечь текст между границами, найденными EPR (в R3, вход) и EPB
; (начало текста), в линейный буфер BUF. Пустой ввод (длина<=0) => CLC, без
; копирования (3$). Слишком длинный (>=0400) => TRAP 25 (переполнение).
; Иначе копирует и возвращает SEC. Точный знак/направление вычитания длины
; (SUB R2,R3) не выяснен до конца.
INBF2:	MOV	R2,-(SP)
	MOV	R3,R2		; R2 = конец текста (из EPR)
	CALL	EPB		; R3 = начало текста
	SUB	R2,R3		; R3 = длина (см. хедер)
	BLE	3$		; пусто => без копирования =>
	CMP	R3,#400
	BGE	5$		; слишком длинно => ошибка =>
	INC	R3
	MOV	#BUF,R1
2$:	MOVB	(R2)+,(R1)+	; скопировать текст в BUF
	SOB	R3,2$
	SEC			; успех
	BR	4$
3$:	CLC			; пусто
4$:	MOV	(SP)+,R2
	MOV	(SP)+,R3
	RETURN
5$:	TRAP	25.		; ошибка: строка слишком длинная
;
;----------------------------------------------
;	ВЫВОД СИМВОЛА
;		ВХОД:	РО-КОД СИМВОЛА
;----------------------------------------------
; ISV - вывести один символ (R0) на экран. Поднимает приоритет и запрещает
; BREAK на время обновления экрана, убирает курсор (CSCR), обрабатывает
; символ (PROCLF - LF/CR спецобработка, затем PROC - таблица KOD/K*),
; возвращает курсор (RSCR), восстанавливает BREAK/приоритет.
ISV::
	MOV	R0,-(SP)
	MOV	R1,-(SP)
	MFPS	-(SP)
	MTPS	#340		; запретить прерывания

	CALL	NOSTOP		; запретить BREAK
	CALL	CSCR		; убрать курсор с экрана

	MOV	CURS,R1
	CALL	PROCLF		; обработать символ
	MOV	R1,CURS

	CALL	RSCR		; вернуть курсор на экран
	CALL	STOPEN		; снова разрешить BREAK
	MTPS	(SP)+
	MOV	(SP)+,R1
ENDISV:
	MOV	(SP)+,R0
	CALL	SETALF		; установить алфавит (РУС/ЛАТ) по символу
	RETURN
;
;--------------------------------------------
;	ВЫВОД СТРОКИ
;		ВХОД:	R1-НАЧАЛЬНЫЙ АДРЕС
;			R2-ДЛИНА (МЛАДШИЙ БАЙТ)
;			  -ПРИЗНАК КОНЦА (СТАРШИЙ БАЙТ)
;--------------------------------------------
; ISVEIL - вывести строку на экран: R1 -> текст, R2 = длина в младшем байте
; + байт-терминатор в старшем (0, если не нужен). Выводит посимвольно через
; PROCLF/PROC, пока не кончится счётчик или не встретится терминатор
; (терминатор тоже выводится). Курсор убирается/возвращается вокруг вывода
; (CSCR/RSCR), как в ISV.
ISVEIL::
	MOV	R0,-(SP)
	MOV	R3,-(SP)
	MOV	R5,-(SP)
	MFPS	-(SP)
	MTPS	#340		; запретить прерывания
	CALL	NOSTOP		; запретить BREAK

	MOV	R1,R5		; R5 -> текущий символ строки
	CALL	CSCR		; убрать курсор с экрана
	MOV	CURS,R1
	MOV	R2,R3
	SWAB	R3		; R3 = байт-терминатор
1$:	MOVB	(R5)+,R0	; взять очередной символ
	CMPB	R0,R3
	BEQ	2$		; это терминатор => вывести и закончить =>
	CALL	PROCLF		; вывести символ
	SOB	R2,1$		; ещё есть символы => следующий =>
	BR	3$		; счётчик исчерпан => готово =>
2$:	CALL	PROCLF		; вывести терминатор
3$:	MOV	R1,CURS

	CALL	RSCR		; вернуть курсор на экран
	CALL	STOPEN		; снова разрешить BREAK
	MTPS	(SP)+
	MOV	(SP)+,R5
	MOV	(SP)+,R3
	BR	ENDISV
;
;------------------------------------------
;	ОБРАБОТКА СИМВОЛА
;		R0-СИМВОЛ
;		R1-МЕСТО КУРСОРА В БУФЕРЕ
;------------------------------------------
; PROCLF - при выводе (не вводе) LF/CR подменяются на "виртуальные" коды
; CTRL/U(025)/CTRL/V(026), чтобы обработка ушла через тот же диспетчер PROC,
; что и для реально нажатых клавиш (K15 "ВК" и т.п.), затем падает в PROC.
PROCLF:	CMPB	R0,#LF	;- ПРИ ВЫВОДЕ LF=CTRL/U
	BNE	1$
	MOV	#25,R0
1$:	CMPB	R0,#CR	; CR=CTRL/V
	BNE	PROC
	MOV	#26,R0
;
; PROC - диспетчер символа R0 (курсор, вставка, управляющие коды и т.п.) по
; таблице KOD. Если ждём второй байт расширенной команды (KOM2P, см. K33) -
; использовать вторую таблицу (KOD+15) и снять старший бит R0. Первый байт
; каждой таблицы - порог: R0 выше него - обычный печатаемый символ (сразу
; 3$, без поиска). Иначе линейный поиск R0 среди кодов таблицы; позиция
; найденного кода даёт индекс в таблицу адресов обработчиков KOM.
PROC:
	MOV	R2,-(SP)
	MOV	R3,-(SP)

	MOV	#KOD,R2
	TSTB	KOM2P
	BEQ	1$		; не ждём 2-й байт => обычная таблица =>
	ADD	#15,R2		; ждём => вторая таблица (расширенные команды)
	BIC	#200,R0		; снять признак-бит расширенной команды
	CLRB	KOM2P
	BR	2$
1$:	CMPB	R0,(R2)+	; R0 не меньше порога (обычный символ)?
	BHIS	3$		; да => не искать, сразу обработать =>
2$:	TSTB	@R2		; конец таблицы (код не найден)?
	BEQ	4$		; да => нет обработчика, ничего не делать =>
	CMPB	R0,(R2)+	; код совпал?
	BNE	2$		; нет => следующий код в таблице =>
3$:	SUB	#KOD+1,R2	; R2 = позиция найденного кода = индекс обработчика
	ASL	R2		; -> индекс слова в KOM
	CALL	@KOM(R2)	; вызвать обработчик
4$:
	MOV	(SP)+,R3
	MOV	(SP)+,R2
	RETURN
;
				;------  ДЛЯ 2-ОЙ КОМ.СИСТ.
K33:	INCB	KOM2P
	RETURN
;
				;------ БУКВА
; K40 - вставить обычный печатаемый символ R0 в позицию курсора R1. Код 177
; (DEL) обрабатывается отдельно, как забой (K177). Если курсор у самого
; конца экранного буфера - прокрутить экран (ROLL, или K10 в графике) перед
; вставкой. Если символ перед курсором - LF (курсор в конце ранее введённой
; более короткой строки на этой экранной строке) - раскрыть LF-заполнение
; обратно в пробелы на длину TABX, освобождая место для нового текста.
; Вставляет символ, продвигает колонку TABX, рисует его (ISV0); при
; достижении ширины строки (LL) - перевод на следующую строку (CRLF).
K40:	CMP	R0,#177
	BEQ	K177		; DEL => обработать как забой =>
;
	MOV	ENDBUF,R2
	DEC	R2
	CMP	R1,R2
	BNE	1$		; курсор не у конца буфера => вставить сразу =>

	TST	CRTGRP
	BEQ	10$		; не графика =>
	MOV	R0,-(SP)
	CALL	K10		; прокрутить экран (графический режим)
	MOV	(SP)+,R0
	BR	1$

10$:	CALL	ROLL		; прокрутить экран (текстовый режим)
;
1$:	CMPB	-1(R1),#LF
	BNE	3$		; символ перед курсором - не LF => вставить как есть =>
	MOV	R1,R3

	MOV	TABX,R2
	BEQ	3$		; курсор в начале строки => нечего раскрывать =>
2$:	CMPB	-(R3),#LF
	BNE	3$		; дошли до непустого символа => хватит =>
	MOVB	#40,@R3		; раскрыть LF-заполнение в пробел
	SOB	R2,2$
;
3$:	MOVB	R0,(R1)+	; вставить символ в буфер
	INC	TABX		; продвинуть колонку курсора
	CALL	ISV0		; отрисовать символ на экране
	CMP	TABX,LL
	BNE	KKK		; строка ещё не заполнена => готово =>
	JMP	CRLF		; заполнена => перевод на следующую строку
;
; KL/KR - переключить режим ЛАТ/РУС (RUSLAT), затем показать индикатор (ISV1).
KL:	CLR	RUSLAT		; ЛАТ
	BR	KK
;
KR:	MOV	#-1,RUSLAT	; РУС
KK:	CALL	ISV1		; показать индикатор режима
KKK: 	RETURN
				;------ ЗАБОЙ
; K177 - забой (Backspace): найти конец текста (EPR); если курсор уже там -
; нечего удалять, только обновить экран (K24). Иначе, если перед курсором
; LF (граница строки) - только сдвинуть курсор влево (K104), символ не
; удаляя; иначе сдвинуть курсор влево (K104) и сомкнуть текст (K24).
K177:	CALL	EPR		; найти конец введённого текста
	CMP	R1,R3
	BEQ	2$		; курсор уже там => нечего удалять =>
	MOVB	#104,R0
	CMPB	-1(R1),#LF
	BEQ	K104		; перед курсором - граница строки => только сдвинуть влево =>
	CALL	K104		; сдвинуть курсор влево
2$:	CALL	K24		; сомкнуть/перерисовать текст после удаления
1$:	RETURN
;
				;------ ГТ
; K11 - табуляция: вставлять пробелы (через K40), пока колонка TABX не
; станет кратной 8.
K11:
	MOVB	#40,R0
1$:	CALL	K40		; вставить пробел
	BIT	#7,TABX
	BNE	1$		; ещё не кратно 8 => следующий пробел =>
	RETURN
;
;
				;------- СТР -СБРОС СТРОКИ
; K37 - "сброс строки": найти истинное начало текущей логической (возможно,
; перенесённой на несколько экранных строк) строки, поднимаясь по экранным
; строкам (R3, полученный от EPR, - опорная граница), позиционировать курсор
; туда (LOK) и провалиться в K13, чтобы очистить всё до конца строки -
; вместе получается очистка всей текущей логической строки.
K37:
	CALL	EPR		; найти конец введённого текста (R3 - опорная граница)
	SUB	TABX,R1		; R1 -> начало текущей экранной строки
	CLR	TABX
1$:	CMP	R1,R3
	BEQ	2$		; дошли до границы => готово =>
	SUB	LL,R1		; подняться на экранную строку выше
	DEC	TABY
	BR	1$
2$:	CALL	LOK		; поставить курсор в найденную позицию
				;------ СТС -СБРОС КОНЦА СТРОКИ
; K13 - "сброс конца строки": если курсор уже в конце (LF сразу под ним) -
; нечего делать. Иначе находит конец текста (EPB) и визуально закрашивает
; экранные строки от курсора до конца маркером 113 (окт.), построчно (цикл
; 1$ - точный смысл кода 113 и построчного шага не выяснены до конца), затем
; переставляет курсор (LOK) и забивает соответствующий участок буфера LF.
K13:
	CMPB	@R1,#LF
	BEQ	4$		; курсор уже в конце строки => нечего очищать =>
	CALL	EPB		; найти конец текста
	MOV	R1,R2

	SUB	TABX,R2		; R2 -> начало текущей экранной строки
1$:	MOVB	#113,R0
	CALL	ISV2		; закрасить экранную строку маркером очистки
	ADD	LL,R2		; следующая экранная строка
	CMP	R2,R3
	BHI	2$		; вышли за конец текста => готово =>
	MOV	#LF,R0
	CALL	ISV1
	MOV	#CR,R0
	CALL	ISV1
	BR	1$
2$:	CALL	LOK		; вернуть курсор на место
	MOV	R3,R2
	SUB	R1,R2		; R2 = длина очищаемого участка буфера
3$:	MOVB	#LF,-(R3)	; забить его LF (пусто)
	SOB	R2,3$
4$: 	RETURN
;
				;-------- СБР -СБРОС ЭКРАНА
; K14 - "сброс экрана": физически очистить экран (вывести FF), вернуть
; курсор в начало (K10) и забить весь экранный буфер от курсора до конца LF
; (пусто).
K14::
	MOV	#FF,R0
	CALL	ISV1		; очистить экран
	CALL	K10		; вернуть курсор в начало
	MOV	ENDBUF,R2
	SUB	R1,R2		; R2 = размер буфера от курсора до конца
	MOV	R1,R3
1$:	MOVB	#LF,(R3)+	; забить буфер (пусто)
	SOB	R2,1$
	RETURN
;
;
				;----- ВК -ВВОД СТРОКИ
; K15 - обработчик CR при выводе (см. PROCLF: CR->CTRL/V->эта таблица):
; найти конец текста строки (EPB), переставить курсор туда (KC) и перейти
; на новую экранную строку (CRLF).
K15:
	CALL	EPB		; найти конец текста строки
	CALL	KC		; переставить курсор в конец строки
	CALL	CRLF		; перейти на новую экранную строку
	RETURN
;
				;------ КУРСОР ВВЕРХ
; K101 - курсор вверх: если не в верхней строке (TABY<>0), сдвинуть R1 на
; строку вверх (SUB LL) и переставить курсор на экране (ISV2, без движения
; в буфере вставки текста - просто визуальное позиционирование).
K101:	TST 	TABY
	BEQ	1$		; уже в верхней строке => никуда не двигаться =>
	DEC 	TABY
	SUB	LL,R1
	CALL	ISV2
1$:	RETURN
;
				;------ КУРСОР ВНИЗ
; K102 - курсор вниз: симметрично K101, если не в нижней строке (TABY<>LN).
K102:	CMP 	TABY,#LN
	BEQ	1$		; уже в нижней строке =>
	INC  	TABY
	ADD	LL,R1
	CALL	ISV2
1$:	RETURN
;
				;------ КУРСОР НАПРАВО
; K103 - курсор вправо: если дошли до конца строки (TABX=LL), перейти на
; начало следующей строки (или остаться на месте, если она последняя, 3$);
; иначе просто сдвинуть курсор на экране на 1 позицию (ISV2) и в буфере (R1).
K103:
	INC	TABX

	CMP	TABX,LL
	BNE	1$		; строка ещё не кончилась =>
	DEC	TABX		; кончилась - откатить лишний INC
	CMP	TABY,#LN
	BEQ	3$		; это последняя строка => остаться на месте =>
	CLR	TABX
	INC	TABY		; перейти на начало следующей строки
	CALL	LOK		; переставить курсор (смена строки)
	BR	2$
1$: 	CALL	ISV2		; сдвинуть курсор на экране
2$:	INC	R1		; сдвинуть курсор в буфере
3$:   	RETURN
;
				;------ КУРСОР НАЛЕВО
; K104 - курсор влево: симметрично K103. Если уже в начале строки (TABX=0),
; перейти в конец предыдущей строки (или остаться на месте, если это первая
; строка, 4$); иначе сдвинуть курсор на экране (ISV2) и в буфере (R1) назад.
K104:	TST	TABX
	BNE	1$		; не в начале строки =>
	TST	TABY
	BEQ	4$		; первая строка => остаться на месте =>
	MOV	LL,TABX
	DEC	TABX		; перейти в конец предыдущей строки
	DEC	TABY
	CALL	LOK		; переставить курсор (смена строки)
	BR	3$
1$:	DEC	TABX
	CALL	ISV2		; сдвинуть курсор на экране
3$:	DEC	R1		; сдвинуть курсор в буфере
4$: 	RETURN
;
				;--- R3- НАЧАЛО СТРОКИ
; EPR - найти начало текущей логической (возможно, перенесённой на
; несколько экранных строк) строки: подняться от курсора R1 по экранным
; строкам (R3), пока не дойдём до начала буфера (EBUF) или до экранной
; строки, перед которой стоит LF (настоящая граница предыдущей строки).
EPR:
	MOV	R1,R3
	SUB	TABX,R3		; R3 -> начало текущей экранной строки
1$:	CMP	R3,#EBUF
	BEQ	2$		; дошли до начала буфера => это и есть начало строки =>
	CMPB	-1(R3),#LF
	BEQ	2$		; перед этой экранной строкой - граница строки => готово =>
	SUB	LL,R3		; иначе подняться ещё на экранную строку выше
	BR	1$
2$:	RETURN
;
				;---- R3- КОНЕЦ СТРОКИ
; EPB - найти конец текста текущей строки, начиная от R1, и обрезать
; хвостовые пробелы (заменяя их на LF). Если курсор уже стоит на LF: при
; TABX=0 - делать нечего (3$); иначе сначала вернуться к началу текущей
; экранной строки.
EPB:	MOV	R1,R3
	CMPB	@R3,#LF
	BNE	1$		; курсор не на LF => искать конец текста дальше =>
	TST	TABX
	BEQ	3$		; курсор на LF и в начале строки => уже конец =>
	SUB	TABX,R3		; иначе вернуться к началу экранной строки
1$:	CMPB	(R3)+,#LF
	BNE	1$		; искать LF (конец текста) =>
	DEC	R3		; R3 -> на сам символ LF
2$:	CMPB	-1(R3),#40
	BNE	3$		; перед LF - не пробел => готово =>
	MOVB	#LF,-(R3)	; пробел => заменить на LF (обрезать хвост)
	BR	2$		; и проверить ещё на один символ раньше =>
3$:	RETURN
;
				;----- РАЗДВИЖКА СИМВОЛОВ
; K23 - раздвинуть символы (открыть место под вставку в позиции курсора
; R1): если курсор уже в конце строки - нечего раздвигать (4$). Иначе найти
; конец текста (EPB), и если он у самого конца буфера - освободить строку
; прокруткой (ROLL, либо звуковой сигнал и отказ в графике - не хватает
; места). Если строка ещё не занимает всю ширину экрана - подвинуть её
; начало (ROLL2). Затем сдвинуть весь текст от курсора до конца текста на
; один байт вправо (3$, копирование с конца), освободив байт в R1, и
; заполнить его пробелом; перерисовать (EISV) и переставить курсор (LOK).
K23:
	CMPB	@R1,#LF
	BEQ	4$		; курсор в конце строки => раздвигать нечего =>
	CALL	EPB		; найти конец текста строки
	INC	R3		; R3 -> сразу за концом (включая LF)
	CMP	R3,ENDBUF
	BNE	1$		; не у конца буфера =>

	TST	CRTGRP
	BEQ	10$		; текстовый режим => прокрутить экран =>
	MOV	#7,R0
	JMP	KK		; графика: некуда - звуковой сигнал и выйти

10$:	CALL	ROLL		; освободить строку прокруткой экрана
	SUB	LL,R3		; поправить R3 на прокрутку
	BR	2$
1$:	CMPB	@R3,#LF
	BEQ	2$		; за концом текста сразу LF - место есть =>
	CALL	ROLL2		; иначе подвинуть начало строки
2$:	MOV	R3,R2
	SUB	R1,R2		; R2 = длина сдвигаемого текста (от курсора до конца)
3$:	MOVB	-(R3),1(R3)	; сдвинуть байт вправо (с конца, освобождая R1)
	SOB	R2,3$
	MOVB	#40,@R3		; заполнить освободившееся место пробелом
	CALL	EISV		; перерисовать
	CALL	LOK		; переставить курсор
4$:	RETURN
;
				;---- СДВИЖКА СИМВОЛОВ
; K24 - сдвинуть символы (закрыть место после удаления в позиции курсора
; R1, обратное K23): если курсор уже в конце строки - нечего сдвигать.
; Иначе сдвинуть весь текст от курсора до конца на один байт влево (1$),
; перерисовать (EISV), стереть освободившийся последний символ пробелом
; и переставить курсор (LOK).
K24:	CMPB	@R1,#LF
	BEQ	2$		; курсор в конце строки => сдвигать нечего =>
	MOV	R1,R3
1$:    	MOVB	1(R3),(R3)+	; сдвинуть байт влево (закрыть место R1)
	CMPB	@R3,#LF
	BNE	1$		; ещё не дошли до конца текста =>
	MOV	R1,R3
	CALL	EISV		; перерисовать
	MOV	#40,R0
	CALL	ISV1		; стереть освободившийся хвостовой символ
	CALL	LOK		; переставить курсор
2$:	RETURN
;
				;---- КУРСОР В КОНЕЦ СТРОКИ
; KC - переставить курсор с текущей позиции R1 на конец текста R3 (найденный
; заранее, напр. через EPB): сдвигает R1 к R3 и пересчитывает TABX/TABY,
; раскладывая пройденное расстояние на целые экранные строки (1$, вычитание
; LL) и остаток-колонку (2$), с переносом колонки через ширину строки.
KC:
	SUB	R1,R3		; R3 = расстояние от курсора до конца текста
	BEQ	3$		; уже в конце => ничего не делать =>
	ADD	R3,R1		; R1 = конец текста (новая позиция курсора)
1$:	SUB	LL,R3		; вычесть одну экранную строку из расстояния
	BMI	2$		; расстояние меньше строки => остаток - в R3 =>
	INC	TABY		; ещё строка пройдена
	BR	1$
2$:	ADD	LL,R3		; вернуть последнее вычитание (R3 = остаток-колонка)
	ADD	R3,TABX
	CMP	TABX,LL
	BLT	3$		; колонка в пределах строки => готово =>
	INC	TABY		; вышла за ширину => перенос на следующую строку
	SUB	LL,TABX

3$:	RETURN
;
				;------- СДВИГ БУФЕРА ВВЕРХ
; ROLL - прокрутить экранный буфер на одну строку вверх (когда курсор
; дошёл до конца буфера и нужно освободить строку снизу): сдвигает весь
; буфер от EBUF+LL на LL байт назад (1$), забивает освободившуюся последнюю
; строку LF (2$), поправляет курсор (R1/TABY) и счётчик прокрутки SCRL (см.
; INBF0). Физическая прокрутка экрана выполняется аппаратно: курсор ставится
; в последнюю строку и выводится LF (терминал сам прокручивает картинку),
; затем курсор возвращается на место.
ROLL:
	MOV	R2,-(SP)
	MOV	R3,-(SP)
	MOV	R1,-(SP)
	MOV	#EBUF,R3	; R3 -> начало буфера (назначение сдвига)
	MOV	ENDBUF,R2
	SUB	LL,R2
	SUB	R3,R2		; R2 = размер сдвигаемой части (буфер минус одна строка)
	MOV	R3,R1
	ADD	LL,R1		; R1 -> вторая строка буфера (источник сдвига)
1$:	MOVB	(R1)+,(R3)+	; сдвинуть весь буфер на одну строку вверх
	SOB	R2,1$
	MOV	LL,R2
2$:	MOVB	#LF,(R3)+	; забить освободившуюся последнюю строку (пусто)
	SOB	R2,2$
	MOV	(SP)+,R1
	MOV	(SP)+,R3
	MOV	(SP)+,R2
	SUB	LL,R1		; поправить курсор на сдвиг
	DEC	TABY
	INCB	SCRL		; учесть прокрутку (см. INBF0)

	MOV	R0,-(SP)
	MOV	TABY,-(SP)
	MOV	#LN,TABY	; временно - последняя строка экрана
	CALL	LOK		; поставить курсор туда
	MOV	#LF,R0
	CALL	ISV1		; вывести LF - аппаратная прокрутка изображения
	MOV	(SP)+,TABY	; вернуть настоящую строку курсора
	CALL	LOK
	MOV	(SP)+,R0

	RETURN
;
				;------- СДВИГ ЧАСТИ БУФЕРА И ЭКРАНА ВНИЗ
; ROLL2 - вставить пустую экранную строку сразу после конца текущего текста
; (когда логическая строка не занимает всю ширину экрана и нужно "раздвинуть"
; последующие строки вниз на одну, вместо полной прокрутки всего буфера).
; Переставляет курсор в конец текста (KC/LOK), сдвигает часть буфера от
; этой точки до ENDBUF на LL байт вниз (1$, копирование с конца), забивает
; освободившуюся строку LF (3$) и перерисовывает последующие строки (4$,
; маркер очистки 113 - как в K13). Детали цикла перерисовки (4$) не
; выяснены до конца.
ROLL2:
	MOV	R1,-(SP)
	MOV	TABX,-(SP)
	MOV	TABY,-(SP)
	MOV	R3,-(SP)
	CALL	KC		; переставить курсор в конец текста (R3 - от вызывающего)
	CALL	LOK
	MOV	ENDBUF,R3
	MOV	R3,R2
	SUB	R1,R2
	SUB	LL,R2		; R2 = размер части буфера для сдвига вниз
	BEQ	2$		; сдвигать нечего =>
	MOV	R1,-(SP)
	MOV	R3,R1
	SUB	LL,R1
1$:	MOVB	-(R1),-(R3)	; сдвинуть часть буфера на одну строку вниз
	SOB	R2,1$
	MOV	(SP)+,R1
2$:	MOV	LL,R2

3$:	MOVB	#LF,-(R3)	; забить освободившуюся строку (пусто)
	SOB	R2,3$
	MOV	ENDBUF,R2
	DEC	R2
	MOVB	#LF,@R2		; подстраховка: терминатор в самом конце буфера
	INC	R2
	SUB	LL,R2		; R2 = начало последней строки буфера (граница цикла)
4$:	MOV	R1,R3
	MOV	R2,-(SP)
	CALL	EISV		; перерисовать текущую строку
	MOV	#113,R0
	CALL	ISV2		; закрасить маркером очистки (как в K13)
	CALL	KC		; перейти к следующей строке
	MOV	(SP)+,R2
	CMP	R1,R2
	BGE	5$		; дошли до конца буфера => готово =>
	CALL	CRLF		; иначе перейти на следующую экранную строку
	BR	4$
5$:
	MOV	(SP)+,R3
	MOV	(SP)+,TABY
	MOV	(SP)+,TABX
	MOV	(SP)+,R1
	CALL	LOK		; вернуть курсор на исходное место
	RETURN
				;------ КУРСОР В НАЧАЛО ЭКРАНА
; K10 - курсор в начало экрана: TABX=TABY=0, R1=EBUF, переставить (LOK).
K10:
	CLR 	TABX
	CLR 	TABY
	CALL	LOK
	MOV	#EBUF,R1
	RETURN
;

; K25/CRLF - курсор в начало следующей физической (экранной) строки. Если
; текущая строка последняя (TABY=LN): в графике - просто вернуться в начало
; экрана (K10, прокрутка не поддерживается); иначе - прокрутить экран (ROLL).
; Иначе (1$) - просто перейти на следующую строку. K26 - отдельная точка
; входа "в начало ТЕКУЩЕЙ строки" (без перехода на следующую).
K25:				;-------- КУРСОР В НАЧАЛО СЛЕДУЮЩЕЙ СТРОКИ
CRLF:				;	(ФИЗИЧЕСКОЙ)
	CMP	TABY,#LN
	BNE	1$		; не последняя строка => просто перейти на следующую =>

	TST	CRTGRP
	BNE	K10		; графика => в начало экрана (без прокрутки) =>

	CALL	ROLL		; текст => прокрутить экран
1$:	INC	TABY
	ADD	LL,R1		; R1 -> следующая экранная строка

K26:	SUB	TABX,R1		; вернуться к началу (текущей) строки
	CLR	TABX
;
				;------ КУРСОР В ПОЛОЖЕНИЕ TABX,TABY
; LOK - физически позиционировать аппаратный курсор терминала в TABX,TABY:
; посылает управляющую последовательность ESC 'Y' <строка+40> <колонка+
; MIDLE+40> (классическая VT52-подобная адресация курсора). BRKFLG
; сохраняется/восстанавливается, чтобы не сбить уже отключённый BREAK у
; вызывающего (вложенный вызов).
LOK::
	MOV	BRKFLG,-(SP)	; запомнить, был ли BREAK уже отключён
	CALL	NOSTOP		; отключить BREAK на время посылки escape-последовательности
	MOV	#131,R0
	CALL	ISV2		; послать ESC 'Y' (начало команды позиционирования)
	MOV	TABY,R0
	ADD	#40,R0		; строка + 32 (смещение кодировки VT52)

	CALL	ISV1		; послать байт строки
	MOV	TABX,R0
	ADD	MIDLE,R0	; + смещение центрирования
	ADD	#40,R0		; колонка + 32
	CALL	ISV1		; послать байт колонки
	TSTB	(SP)+
	BEQ	1$		; BREAK был уже отключён => оставить отключённым =>
	CALL	STOPEN		; иначе - снова разрешить
1$:	RETURN
;
; K12 - ПС (Line Feed): перейти на следующую физическую строку, сохраняя
; колонку (в отличие от CRLF/K25 не сбрасывает TABX). Прокручивает экран
; (ROLL), если это была последняя строка. Хвостом передаёт управление в
; ISV1, которая отправит исходный символ (R0, оставшийся от PROC) на
; терминал - собственно аппаратный перевод строки.
K12::				;------ПС -ПЕРЕВОД СТРОКИ
	CMP	TABY,#LN
	BNE	1$		; не последняя строка =>
	CALL	ROLL		; последняя => прокрутить экран =>
1$:	INC	TABY
	ADD	LL,R1		; R1 -> следующая экранная строка (та же колонка)
	BR	ISV1		; => отправить символ (R0) на терминал
;
				;----- ВЫВОД ПАРЫ  ESC, R0
; ISV2 - послать терминалу ESC, затем байт R0 (двухбайтовая управляющая
; последовательность). R0=0 - ничего не посылать (нет данных для команды).
ISV2:	TST	R0
	BEQ	2$		; R0=0 => нечего посылать =>
	MOV	BRKFLG,-(SP)	; запомнить, был ли BREAK уже отключён
	CALL	NOSTOP
1$:	TSTB	@#ARSTV
	BPL	1$		; порт терминала не готов => ждать =>
	MOV	#ESC,@#ARDTV	; послать ESC напрямую в порт
	CALL	ISV1		; послать байт R0 обычным путём
	TSTB	(SP)+
	BEQ	2$		; BREAK был уже отключён => оставить отключённым =>
	CALL	STOPEN		; иначе - снова разрешить
2$:
	RETURN
;
				;------ ВЫВОД R0
; ISV0 - вывести символ R0 на терминал, автоматически переключая шрифт
; РУС/ЛАТ по коду символа (не трогая коды < 0100 - управляющие/цифры/
; пунктуация, для них переключение не нужно). Символ >= 0300 (КОИ8-байт с
; установленным старшим битом) - кириллица: снять старший бит и, если
; терминал ещё не в режиме РУС, послать код 16 (переключить) и отметить
; RUSLAT. Символ в [0100,0300) - латиница: если терминал в режиме РУС,
; послать код 17 (переключить обратно). Затем (ISV1) - собственно отправка
; байта на порт.
ISV0::	CMPB	R0,#100
	BLO	ISV1		; управляющий/цифра/пунктуация => без переключения =>
	CMPB	R0,#300
	BLO	2$		; латинский диапазон =>
	BICB	#200,R0		; кириллица: снять старший бит (КОИ8 -> код терминала)
	TSTB	RUSLAT
	BNE	ISV1		; терминал уже в режиме РУС => просто отправить =>
1$:	TSTB	@#ARSTV
	BPL	1$		; порт не готов => ждать =>
	MOVB	#16,@#ARDTV	; переключить терминал в режим РУС
	BR	4$
2$:	TSTB	RUSLAT
	BEQ	ISV1		; терминал уже в режиме ЛАТ => просто отправить =>
3$:	TSTB	@#ARSTV
	BPL	3$		; порт не готов => ждать =>
	MOVB	#17,@#ARDTV	; переключить терминал в режим ЛАТ
4$:	COMB	RUSLAT		; отметить смену режима
ISV1::
	TSTB	@#ARSTV
	BPL	ISV1		; порт не готов => ждать =>
	MOVB	R0,@#ARDTV	; отправить байт символа

;!	CMPB	R0,#LF

;	BNE	6$
;	MOVB	#CR,R0
;	BR	ISV1
;6$:
	RETURN
;
				;------ ВЫВОД СТРОКИ (АДРЕС-R3)
; EISV - перерисовать текст из буфера, начиная с R3, до LF - используется
; после операций типа K23/K24/ROLL2, где содержимое буфера уже изменено и
; экран нужно просто перерисовать заново. Выводит каждый символ через K40
; (как при обычном вводе - со всей его логикой переноса строк), затем
; восстанавливает исходные TABX/TABY/R1 (перерисовка не должна сдвигать
; логический курсор) и синхронизирует режим РУС/ЛАТ терминала (SETALF).
EISV:	MOV	TABX,-(SP)
	MOV	TABY,-(SP)
	MOV	R1,-(SP)
1$:	CMPB	@R3,#LF
	BEQ	2$		; конец текста => готово =>
	MOVB	(R3)+,R0	; взять символ
	MOV	R3,-(SP)
	CALL	K40		; вывести его (как при вводе)
	MOV	(SP)+,R3
	BR	1$
2$:	MOV	(SP)+,R1	; восстановить курсор в буфере
	MOV	(SP)+,TABY
	MOV	(SP)+,TABX	; и на экране
	CALL	SETALF		; восстановить режим РУС/ЛАТ терминала
	RETURN
;
; SETALF - после вывода восстановить режим шрифта терминала (РУС/ЛАТ) на
; "штатный" (RUSLAT+1 - видимо, режим клавиатурного ввода), если вывод
; (через ISV0) оставил терминал в другом режиме (RUSLAT). Посылает код 16
; (в РУС) или 17 (в ЛАТ) в зависимости от целевого режима.
SETALF:	CMPB	RUSLAT+1,RUSLAT		;-----ВОССТАНОВЛЕНИЕ РУС/ЛАТ
	BEQ	1$		; терминал уже в нужном режиме => ничего не делать =>
	MOV	#16,-(SP)	; предположить переключение в РУС
	MOVB	RUSLAT+1,RUSLAT	; RUSLAT = штатный (целевой) режим
	BNE	3$		; целевой режим - РУС => отправить код 16 =>
	INC	@SP		; целевой режим - ЛАТ => код 17
3$:	TSTB	@#ARSTV
	BPL	3$		; порт не готов => ждать =>
	MOV	(SP)+,@#ARDTV	; отправить код переключения режима
1$:	RETURN
;
				;----- ВВОД СИМВОЛА С КЛАВИАТУРЫ В R0
; IV - прочитать символ с клавиатуры в R0 (ждать, если очередь пуста - см.
; кольцевой буфер FIRST/LAST в IVS). Разрешает прерывания на время ожидания.
IV::
	MFPS	-(SP)
	MTPS	#0		; разрешить прерывания (чтобы IVS наполнял очередь)
1$:	CMP	FIRST,LAST
	BEQ	1$		; очередь пуста => ждать =>
	MTPS	(SP)+		; восстановить исходный приоритет
; NIM - взять байт из очереди клавиатуры без ожидания (очередь уже
; непустая). Коды букв (>= 0100, кроме DEL=177) в режиме РУС помечаются
; старшим битом (КОИ8-код) - тот же признак, что проверяет ISVETO/ISV0.
NIM::
	MOVB	@FIRST,R0	; взять байт из головы очереди
	CMPB	R0,#100
	BLO	MOVFRS		; управляющий код => без пометки РУС/ЛАТ =>
	CMPB	R0,#177
	BEQ	MOVFRS		; DEL => без пометки =>
	TSTB	RUSLAT
	BEQ	MOVFRS		; режим ЛАТ => без пометки =>
	BISB	#200,R0		; режим РУС => пометить старшим битом (КОИ8)
MOVFRS:	INC	FIRST		; продвинуть указатель очереди
	CMP	FIRST,DFCB
	BNE	1$		; не дошли до конца буфера =>
	MOV	FCB,FIRST	; дошли => перейти на начало (кольцевой буфер)
1$:	RETURN
;
;----- АДРЕСА ПОДПРОГРАММ
;
; KOM/KOD - таблицы диспетчера PROC. KOD[0] - порог (обычный печатаемый
; символ); KOD[1..] - распознаваемые управляющие коды по порядку, KOM[i] -
; соответствующий обработчик той же позиции (K40 - для порога, т.е. индекс
; 0 в обеих таблицах). ESC(033) => K33 - вход в режим 2-байтовых расширенных
; команд, для которых PROC использует вторую таблицу (KOD+15/KOM+15,
; см. ADD #15,R2 в PROC) - совпадающие хвосты кодов используются как набор
; кодов для стрелок/Home/Insert/Delete, приходящих от клавиатуры как
; отдельная (2-байтовая) последовательность. Символ 16/17 (KR/KL) - тот же
; способ переключения РУС/ЛАТ, что ISV0 посылает терминалу на вывод.
KOM: 	.WORD	K40,KK,K11,K12,K13,K14,K15,KR,KL,K25,K26,KK,K37,K33,K101,K102
	.WORD	K103,K104,K10,K23,K24
	.WORD	K14
;
;------ КОДЫ КЛАВИШ
;
KOD:	.BYTE	40,7,11,LF,13,FF,CR,16,17,25,26,27,37,ESC,101,102,103,104
	.BYTE	110
	.BYTE	23,24
	.BYTE	112
	.BYTE	0		; конец таблицы
;
	.EVEN

;
; --------------------------
; ### ОТОБРАЖЕНИЕ СТРОКИ ###
; --------------------------
; ВХОД:	R1- АДРЕС СТРОКИ
;	R2- ДЛИНА СТРОКИ (МЛ. БАИТ)
;	  - СИМВОЛ ОГРАНИЧИТЕЛЬ (СТ. БАИТ)
;
; ISVETO - вывод текста (R1,R2 - как у ISVEIL: адрес, счётчик в младшем
; байте + байт-терминатор в старшем) с учётом перенаправления IODEV:
; 0 - экран (просто делегировать в ISVEIL); >0 - файл (PRINT#, см. FILOUT);
; <0 - принтер (LLIST, продолжение здесь же, метка LP). Для принтера LF
; печатается как CR (сохраняя обычный терминатор экрана); символы >='@'
; трактуются как переключатели спецрежима принтера (РУС/ЛАТ?) через
; LPLCFL/LPISV с escape-кодами 16/17; LF/CR/FF в тексте сбрасывают счётчик
; колонки LPTPOS. Побочный эффект: строка-источник (R1) физически
; изменяется - байт LF заменяется на CR перед отправкой.
ISVETO::
	TST	IODEV
	BNE	LP		; вывод не на экран =>
	JMP	ISVEIL		; экран => делегировать целиком
LP:	MOV	R0,-(SP)
	MOV	R3,-(SP)
	MOV	R2,R3
	SWAB	R3		; R3 = байт-терминатор (старший байт R2)
	CMPB	R3,#LF
	BNE	7$		; терминатор - не LF =>
	MOVB	#CR,R3		; на принтере LF всегда идёт как CR - терминатор тоже
7$:	BIC	#177400,R2	; R2 = только счётчик символов
	MOV	@#IODEV,R0
	BPL	FILOUT		; IODEV>0 (файл) => =>

1$:	CMPB	@R1,#'@		; символ - код переключения режима принтера (>= '@')?
	BLO	2$		; нет, обычный символ =>
	CMPB	@R1,#200+'@
	BLO	3$		; в диапазоне ['@'..'@'+200) => выключить спецрежим =>

	TST	@#LPLCFL	; вне диапазона (>='@'+200): включить спецрежим
	BNE	4$		; уже включён => ничего не делать =>
	MOV	SP,@#LPLCFL	; отметить "включён" (ненулевым значением)
	MOV	#16,R0
	CALL	LPISV		; послать принтеру escape-код 16 (вкл. режим)
	BR	4$
3$:
	TST	@#LPLCFL
	BEQ	4$		; не был включён => ничего не делать =>
	CLR	@#LPLCFL
	MOV	#17,R0
	CALL	LPISV		; послать принтеру escape-код 17 (выкл. режим)
	BR	4$
2$:

	CMPB	@R1,#LF
	BNE	9$
	MOVB	@R1,R0		; LF => послать как есть в R0...
	MOVB	#CR,@R1		; ...но подменить в буфере-источнике на CR
	INC	R2		; (компенировать - на один символ больше сравнений впереди)
	BR	10$

9$:	CMPB	@R1,#CR
	BEQ	6$
	CMPB	@R1,#FF
	BNE	4$		; не CR и не FF => обычный символ =>

6$:	MOV	#-1,@#LPTPOS	; CR/FF => сбросить колонку (INC ниже даст 0)
4$:	INC	@#LPTPOS	; учесть колонку
	MOVB	(R1)+,R0	; взять символ для отправки
10$:	CALL	LPISV		; отправить байт R0 на принтер

	CMPB	R0,R3		; это был байт-терминатор?
	BEQ	8$		; да =>
	SOB	R2,1$		; нет, ещё есть символы => следующий =>
	BR	5$

8$:	DEC	R2
5$:	MOV	(SP)+,R3
	MOV	(SP)+,R0
	RETURN

; LPISV - послать байт R0 на принтер (ждать готовности порта через IRPR).
LPISV:
	TSTB	@#IRPR
	BPL	LPISV		; порт не готов => ждать =>
	MOV	R0,@#IRPR+2	; отправить байт
	RETURN
;
; FILOUT - вывод в файл (PRINT#, IODEV = номер файла). Находит FCB файла
; (FNDBUF), проверяет, что он открыт и не в режиме ASCII-чтения (BIT #4000 -
; NOTOUT), и передаёт данные в COPOUT (буферизованная запись в файл).
FILOUT:
	TST	(SP)+
	MOV	R0,R3		; R3 = номер файла (IODEV)
	.BJSR	FNDBUF		; найти FCB этого файла
	TST	@R0
	BEQ	NOTOP		; файл не открыт => ошибка =>
	BIT	#4000,@R0
	BNE	NOTOUT		; открыт не для вывода => ошибка =>
	CLR	R3
	BISB	@R0,R3
	ADD	R0,R3
	ADD	#22,R3		; R3 -> буфер вывода этого файла
	CALL	COPOUT		; записать данные в буфер/на диск
	MOV	(SP)+,R0
	RETURN

; COPOUT - буферизованная запись R2 байт из (R1) в буфер файла (R3), FCB в
; R0. Копирует байт за байтом, считая заполнение буфера в младшем байте FCB
; (INCB @R0); когда буфер заполнен (256 байт, INCB переполнился в 0) -
; записать блок на диск (CASCII/CAS, см. DISK.MAC), увеличить номер блока
; (BLOCKN) и продолжить с начала буфера (SUB #400,R3).
COPOUT::DEC	R2
	BMI	1$		; байтов не осталось => готово =>
	MOVB	(R1)+,(R3)+	; скопировать байт в буфер файла
	INCB	@R0		; учесть его в счётчике заполнения буфера (в FCB)
	BNE	COPOUT		; буфер ещё не полон => следующий байт =>
	MOV	R1,-(SP)	; буфер полон - сохранить позицию в источнике
	CALL	CASCII		; подготовить параметры записи блока
	CALL	CAS		; записать блок на диск

	BIS	#400,@R0	; отметить блок как записанный
	.BJSR	BLOCKN		; увеличить номер блока
	MOV	(SP)+,R1
	SUB	#400,R3		; буфер сброшен - вернуть R3 на начало
	BR	COPOUT		; продолжить с оставшимися байтами
1$:	RETURN
NOTOUT:	TRAP	52.		; ошибка: файл не открыт для вывода
NOTOP:	TRAP	59.		; ошибка: файл не открыт

; WAIT - клавиатура вернула пустой код (см. IVS); отключить прерывание
; клавиатуры (CLR ARSK), дождаться готовности устройства опросом (бит 7
; ARSK), снова разрешить прерывание и вернуться из обработчика (RTI, т.к.
; вызвано веткой изнутри обработчика прерывания IVS, не подпрограммой).
WAIT:
	MFPS	-(SP)
	MTPS	#340		; поднять приоритет (запретить прерывания)
	CLR	@#ARSK		; выключить прерывание клавиатуры
	MTPS	(SP)+		; вернуть исходный приоритет
1$:	TSTB	@#ARSK
	BPL	1$		; устройство ещё не готово => ждать =>
	MOV	#100,@#ARSK	; снова разрешить прерывание клавиатуры
	RTI

; IVS - обработчик прерывания клавиатуры (вектор AVPK, см. SETW): положить
; принятый символ в кольцевой буфер очереди клавиатуры (LAST, см. CLRBUF в
; MONIT.MAC), с переносом через границу буфера (DFCB->FCB). Пустой код - не
; настоящий символ (WAIT). Если очередь переполнилась (LAST догнал FIRST) -
; сдвинуть и начало очереди (MOVFRS), теряя самый старый непрочитанный символ.
IVS::	MOVB	@#ARDK,@LAST	; принять байт из регистра данных клавиатуры
	BEQ	WAIT		; пустой код => подождать готовности устройства =>
	INC	LAST		; продвинуть указатель записи в очереди
	CMP	LAST,DFCB
	BNE	1$		; не дошли до конца буфера =>
	MOV	FCB,LAST	; дошли => перейти на начало (кольцевой буфер)
1$:	CMP	LAST,FIRST
	BNE	DEJA		; очередь не переполнена => готово =>
	CALL	MOVFRS		; переполнена => сдвинуть начало очереди тоже
DEJA:	RTI
;
; BRUK - обработчик клавиши СТОП, живёт в спецстранице памяти УКНЦ (прямые
; вызовы по фиксированным ПЗУ-адресам). Если BRKFLG=0 (BREAK запрещён) -
; только запомнить нажатие, не прерывая программу; иначе подменить копию
; счётчика команд (BREAKD) адресом BREAK. Последние `.WORD` - машинные
; инструкции (не данные), код выполняется прямо на этой странице.
BRUK::
	MOV	R5,-(SP)
	TST	CRTGRP
	BEQ	10$		; не графика => сразу снять прерывание =>
	MOV	R0,-(SP)
	MOV	R1,-(SP)
	MOV	#15,R1
15$:	CLR	R0
	CALL	@#172632	; (ПЗУ-подпрограмма, назначение по адресу не выяснено)
	SOB	R1,15$
	JSR	R4,@#163006	; переключить экран на SCR3 (текстовый режим?)
	.WORD	SCR3
	CALL	@160272		;BREAK ПОЙМАН - СНЯТЬ ПРЕРЫВАНИЕ
	JSR	R4,@#163006	; переключить экран обратно на SCR0
	.WORD	SCR0
	MOV	(SP)+,R1
	MOV	(SP)+,R0
	BR	11$
10$:	CALL	@160272		;BREAK ПОЙМАН - СНЯТЬ ПРЕРЫВАНИЕ
11$:	MOV	(SP)+,R5
	TSTB	BRKFLG		;BREAK РАЗРЕШЕН?
	BNE	1$		;ДА - ВЫПОЛНЯТЬ
	INCB	BRKFLG+1	;НЕТ - ЗАПОМНИТЬ
	BR	2$
1$:	MOV	#BREAKD,R0	;СМЕНИТЬ КОПИЮ СЧЕТЧИКА КОМАНД
	.WORD	33		;ИЛИ 32	(машинная инструкция, не данные)
2$:	.WORD	12		;ВЫЙТИ ИЗ ПРЕРЫВАНИЯ (RTI)

;
;
; BREAKD - выполнить отложенное нажатие СТОП (из BRUK через подмену счётчика
; команд, или из STOPEN, если BREAK был отложен). Восстанавливает CURS из
; TABX/TABY (экранных координат курсора) и передаёт управление в BREAK.
BREAKD:				;ВЫПОЛНЕНИЕ BREAK
	CALL	NOSTOP
	CLR	BRKFLG		;ЗАПРЕТИТЬ BREAK И ОЧИСТИТЬ ЗАПОМНЕННЫЙ
	MOV	#EBUF,R0	; R0 -> начало экранного буфера
	MOV	TABY,R1
	BEQ	2$		; строка курсора = 0 => пропустить сложение строк =>
1$:	ADD	LL,R0		; сложить ширину строки TABY раз
	SOB	R1,1$
2$:	ADD	TABX,R0		; + колонка курсора
	MOV	R0,CURS		; CURS = адрес курсора в экранном буфере
	JMP	BREAK

; NOSTOP/STOPEN - отложить/разрешить обработку клавиши СТОП вокруг критичных
; участков (BRKFLG=0 - отложено; нажатие в это время лишь запоминается в
; BRKFLG+1, см. BRUK). STOPEN, разрешая снова, выполняет отложенное нажатие
; (BREAKD), если оно было.
NOSTOP::CLRB	BRKFLG		; отложить обработку BREAK
	RETURN

STOPEN::
	TSTB	BRKFLG+1	; было отложенное нажатие СТОП?
	BNE	BREAKD		; да => выполнить его сейчас =>
	INCB	BRKFLG		; нет => просто снова разрешить BREAK
	RETURN


; SIGNAL - подать звуковой сигнал (BEL).
SIGNAL::MOV	#7,R0
	CALL	ISV
	RETURN
;
; USEROM - заглушка недоступной функции ПЗУ: ошибка ILLEGAL FUNCTION CALL.
USEROM::TRAP	5

;-------------------
KOMDEV::.BYTE	RD.,16,WR.,21,FR.,0
;--------------------

; MOUT - послать байт (младший байт R1) контроллеру накопителя (MCSR/MDBR),
; дождавшись готовности (бит 7 MCSR).
MOUT:	TSTB	@#MCSR
	BPL	MOUT		; контроллер не готов => ждать =>
	MOVB	R1,@#MDBR	; отправить байт
	RETURN

; MAGNIT - выполнить операцию на кассетном накопителе через FCB-подобный блок
; параметров (R1 -> блок; поля NAMEW/LENW и коды RD./WR./FR. - см. DAT.MAC,
; тот же формат, что использует DISK.MAC). FR. (014) - код операции "список
; файлов" (см. KOMDEV/FILES в DISK.MAC). Если это FILES с длиной запроса 1 и
; ещё не задано спецификатора имени - заполнить поле имени спецзначением
; 0401*0352 ("любое имя"/маска-джокер для поиска), сдвинув старое значение
; на 6 байт (сохранить для последующего использования). Затем адрес блока
; (R1) передаётся контроллеру побайтно через MOUT (младший/старший байт),
; плюс маркер 0377 дважды; по завершении - ждать готовности контроллера и
; проверить байт статуса в блоке (SEC при ошибке). Поле по смещению 2(R1)
; (проверяемое в начале) в NAMEW/LENW/... не входит - его роль не выяснена.
MAGNIT::
	MOV	R0,-(SP)
	MOV	R1,-(SP)		; сохранить R1 (адрес блока) для передачи контроллеру
	CMP	2(R1),#12	; поле блока == 10 (код операции FILES, см. DISK.MAC)?
	BNE	2$		; нет => обычный случай, без предобработки =>
	CMP	LENW(R1),#1	; запрошена ровно 1 запись?
	BNE	10$
	CLRB	@R1		; обнулить байт статуса блока
	CMP	@R1,#FR.*400	; режим блока - FR. (список файлов)?
	BNE	8$		; нет => выйти совсем (см. ниже) =>
10$:	CMP	NAMEW+6(R1),#401*352	; имя уже = спецзначению "любое имя"?
	BEQ	2$		; да => пропустить заполнение =>

6$:	ADD	#NAMEW,R1	; R1 -> поле имени файла в блоке
	MOV	#3,R0
3$:	MOV	@R1,12(R1)	; сохранить старое слово имени 6 байт дальше
	MOV	#401*352,(R1)+	; и записать спецзначение "любое имя" (джокер поиска)
	SOB	R0,3$
	MOV	#401*352,(R1)+	; ещё два слова спецзначения
	MOV	#401*352,(R1)+
	MOV	@SP,R1		; вернуть R1 = адрес блока (как был при входе)
2$:
	CALL	NOSTOP		; запретить BREAK на время передачи
	CALL	MOUT		; отправить контроллеру младший байт адреса блока
	SWAB	R1
	CALL	MOUT		; и старший байт
	MOV	#377,R1
	CALL	MOUT		; отправить байт-маркер 0377
	CALL	MOUT		; дважды
	CALL	STOPEN		; снова разрешить BREAK
1$:	TSTB	@#MCSR
	BPL	1$		; ждать завершения операции контроллером =>
8$:	MOV	(SP)+,R1	; восстановить R1 = адрес блока
	MOV	(SP)+,R0
	TSTB	@R1		; байт статуса блока ненулевой (ошибка)?
	BEQ	9$
	SEC			; да => сообщить об ошибке (флаг переноса)
9$:
	RETURN

; CURON/CUROFF - включить/выключить курсор (мигающий символ на экране) через
; MIG (см. GRAFUK.MAC), передавая символ курсора (CHAR-1) или -1 (нет курсора).
CURON::
	MOV	CHAR,R1		; символ под курсором
	DEC	R1
	MOV	#-1,R2
	CALL	MIG		; включить отображение курсора
;!	CALL	STOPEN
	RETURN
CUROFF::
	MOV	#-1,R1		; нет символа
	MOV	R1,R2
	CALL	MIG		; выключить курсор
;!	CALL	STOPEN
ISVSS::				; пустая точка входа (только RETURN)
	RETURN

	.END
