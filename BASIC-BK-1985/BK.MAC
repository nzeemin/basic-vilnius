PELING:	MOV	R0,-(SP)	; PELING: подсчёт позиции курсора и числа экранных строк, занимаемых текстом
	MOV	R1,-(SP)
	MOV	R3,-(SP)
	SUB	#BUF,R1
	SUB	#BUF,R3
	ADD	16(SP),R1
	ADD	16(SP),R3
	INC	R1
	CALL	SSE
	CLR	R5
9$:	SUB	R0,R3
	BLT	4$
	BEQ	6$
	INC	R5
	BR	9$
6$:	CMPB	#27,4(SP)
	BNE	4$
	INC	R5
4$:	SUB	R0,R1
	BLE	5$
	INC	12(SP)
	DEC	R5
	BR	4$
5$:	MOV	R0,10(SP)
	MOV	(SP)+,R3
	MOV	(SP)+,R1
	MOV	(SP)+,R0
	RTS	PC
;
RSSE:	MOV	R0,(SP)
	MOV	R1,-(SP)
	MOV	R5,-(SP)
SSE:	EMT	34		; SSE: EMT 34 - слово состояния дисплея
	ROR	R0
	BCS	1$
	MOV	#100,R0
	RTS	PC
1$:	MOV	#40,R0
	RTS	PC
;
; Ветка .IFF (до ближайшего .IFT/.IFTF): код других машин (EL60, NC80, SM4, MDS) - в сборку БК-0010 не входит.
	.IFF
;
; ----------------------
; ----------------------
; ВЫХОД : КОД В R0 (МЛ. БАИТ)
;
IVS::	CLR	ARSK
	MOVB	ARDK,R0
	INCB	SIIKP
	CALL	ALRIC
	RTI
;
; --------------------
; ### ВЫВОД СИМВОЛА ##
; --------------------
; ВХОД : КОД В R0 (МЛ. БАИТ)
;
	.IFT
ISV::	EMT	16		; ISV: вывести символ R0 на экран (EMT 16)
    .IF	EQ,KONTYP-KLAS
	TST	EKRHUK
	BEQ	1$
	CALL	@EKRHUK
1$:
    .ENDC
	RETURN
	.IFTF
; ISVTO - вывести один символ (R0) с учётом перенаправления IODEV: экран -
; как обычно (ISV); принтер/файл - через ISVETO, оформив символ как строку
; из 1 байта в BUFOUT (LF выводится как пара CR,LF - принтер/файл получают
; настоящий LF вторым байтом).
ISVTO::	TST	IODEV		; ISVTO
	BEQ	ISV		; экран => обычный вывод символа =>
	MOV	#BUFOUT,R1
	MOV	#1,R2		; длина по умолчанию - 1 символ
	MOVB	R0,@R1
; Ветка .IFF (до ближайшего .IFT/.IFTF): код других машин (EL60, NC80, SM4, MDS) - в сборку БК-0010 не входит.
	.IFF
	JMP	ISVEIL
;
CRLF:	MOV	#15,R0
	CMPB	TABY,#27
	BEQ	ISV
	INCB	TABY
;
ISV::	TSTB	ARSTV
	BPL	ISV
	MOVB	R0,ARDTV
	CMPB	R0,#12
	BEQ	CRLF
	CMPB	TABX,#117
	BNE	30$
	CMPB	TABY,#27
	BEQ	31$
	INCB	TABY
	BR	31$
30$:	INCB	TABX
	CMPB	R0,#15
	BNE	33$
31$:	CLRB	TABX
33$:	RTS	PC
;
; ---------------------
; ### ЧТЕНИЕ СТРОКИ ###
; ---------------------
;
IVEIL::	MOV	R0,-(SP)	;СОХРАНЕНИЕ РЕГИСТРОВ
	MOV	R2,-(SP)
	MOV	R3,-(SP)
	MOV	R5,-(SP)
	MOVB	TABX,-(SP)
SBROS:	MOV	#BUF,R1		;АДРЕС СТРОКИ
	MOV	R1,R3
	MOV	#377,R2		;ДЛИНА СТРОКИ
	MOV	R2,-(SP)
PIJ::	CLRB	SIIKP		;РЕЗРЕШЕНИЕ ПРЕРЫВАНИЯ С КЛАВИАТУРЫ
	BIS	#100,ARSK
14$:	TSTB	SIIKP		;ЧТЕНИЕ ОЧЕРЕДНОГО СИМВОЛА
	BEQ	14$
	CMPB	R0,#40
	BGE	6$
	CMPB	R0,#11
	BNE	22$
	JMP	33$
22$:	CMPB	R0,#13
	BNE	21$
	JMP	15$
21$:	CMPB	R0,#3
	BNE	44$
	JMP	CTRLC
44$:	CMPB	R0,#14
	BEQ	1$
	CMPB	R0,#15
	BEQ	2$
	CMPB	R0,#16
	BEQ	3$
	CMPB	R0,#17
	BEQ	3$
	CMPB	R0,#23
	BEQ	27$
	CMPB	R0,#24
	BEQ	30$
	CMPB	R0,#25
	BEQ	8$
	CMPB	R0,#31
	BEQ	4$
	CMPB	R0,#32
	BEQ	5$
	CMPB	R0,#33
	BNE	PIJ
	BIS	#100,ARSK
	CALL	STEP
	BR	PIJ
6$:	CMPB	R0,#177
	BEQ	53$
	JMP	16$
53$:	CMP	R2,@SP		;АНУЛИРОВАНИЕ СИМВОЛА
	BEQ	PIJ
	CMP	R1,R3
	BNE	7$
	DEC	R1
	DEC	R3
	TST	(R2)+
	BR	11$
7$:	CMP	#BUF,R1
	BEQ	PIJ
	MOVB	#40,-(R1)
	INC	R2
11$:	MOVB	#32,R0
	DECB	TABX
	DECB	TABX
	CALL	ISV
