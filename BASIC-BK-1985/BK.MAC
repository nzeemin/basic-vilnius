; ###################
;
; ИСПОЛНИТЕЛЬ: ВЦКП ВГУ
; ВИЛЬНЮС,1985
;
; ======================
; ****БЛОК НАСТРОИКИ****
; ======================
;
BK0010=0
EL60=1
NC80=2
SM4=3				;RAFOS
MDS=4				;MDS RAFOS
RAM=10000
ROM=120000
MVIDEO=40000
NORM=0
KLAS=1
;
MASINA=BK0010
MEMTYP=ROM
KONTYP=NORM
;
; ===========================
; ****СИСТЕМНЫЕ КОНСТАНТЫ****
; ===========================
;
BREAKW==4			;АДРЕС ВЕКТОРА ПРЕРЫВАНИЙ ПО КЛАВИШЕ "СТОП"
ILCODW=10
TRAPW=34			;АДРЕС ВЕКТОРА ПРЕРЫВАНИЙ ПО ИНСТРУКЦИИ TRAP
TIMER==100			;АДРЕС ВЕКТОРА ПРЕРЫВАНИЙ ТАЙМЕРА
$DRWX=176			;КООРДИНАТА X
$DRWY=200			;КООРДИНАТА Y
TSTKEY=105			;АДРЕС ПРИЗНАКА НАЖАТИЯ НА КЛАВИШУ
MSTART==264			;СТАРТОВЫЙ АДРЕС МАССИВА
MLEN=266			;ДЛИНА МАССИВА
MAG==320			;АДРЕС БЛОКА ПАРАМЕТРОВ МАГНИТОФОНА
IRPSW=360			;АДРЕС ВЕКТОРА ПРЕРЫВАНИЙ ИРПС
IRPSRG=176560			;АДРЕС РЕГИСТРА ИРПС
AUSROM=160000			;АДРЕС ПЕРЕХОДА НА ПОЛЬЗОВАТЕЛЬСКОЕ БИС ПЗУ
ARPORT=177714			;АДРЕС РЕГИСТРА ПРОГРАММИРУЕМОГО ПОРТА
ASPORT=177716			;adres registra sistemnogo porta
;
; ============================
; ****СИСТЕМНЫЕ ПЕРЕМЕННЫЕ****
; ============================
;
	.ASECT
	.=2000
;
STACK::
LYGIS::	.BLKW	1		;РЕЖИМ РАБОТЫ СИСТЕМЫ
TXEND::	.BLKW	1		;МЕТКА КОНЦА ТЕКСТА И НАЧАЛА ОБ'ЕКТНОГО КОДА
STRREG::.BLKW	1		;МЕТКА НАЧАЛА ОБЛАСТИ СТРОК
STRSIZ::.BLKW	1		;УКАЗАТЕЛЬ ДЛИНЫ ОБЛАСТИ СТРОК
FREBEG::.BLKW	1		;МЕТКА СВОБОДНОЙ ЧАСТИ ОБЛАСТИ СТРОК
FRELEN::.BLKW	1		;ТЕКУЩАЯ ДЛИНА СВОБОДНОЙ ЧАСТИ ОБЛАСТИ СТРОК
ENDCOD::.BLKW	1		;МЕТКА НАЧАЛА СВОБОДНОЙ ОБЛАСТИ
				;И КОНЦА ОБ'ЕКТНОГО КОДА
CIKL::	.BLKW	1		;metka na~ala steka ciklow
LIMIT::	.BLKW	1		;ukazatelx wer{iny steka podprogramm
LENT::	.BLKW	1		;МЕТКА НАЧАЛА ТАБЛИЦЫ ИМЕН
TABTOP::.BLKW	1		;МЕТКА КОНЦА ТАБЛИЦ СВЯЗИ И ИМЕН
FCB::	.BLKW	1		;МЕТКА НАЧАЛА ОБЛАСТИ ФАЙЛОВ И ТАБЛИЦЫ СВЯЗИ
HIMEM::	.BLKW	1		;УКАЗАТЕЛЬ ВЕРХНЕГО АДРЕСА, ДОСТУПНОГО БЕЙСИКУ
ERRS::	.BLKW	1		;ПРИЗНАК ЗАПРЕТА ВЫПОЛНЕНИЯ ПРОГРАММЫ
TYPE::	.BLKW	1		;ТИП КОМПИЛИРУЕМОГО ВЫРАЖЕНИЯ
DATBEG::.BLKW	1		;ukazatelx na~ala bufera DATA
DATPTR::.BLKW	1		;teku}ij ukazatelx bufera DATA
DATINP::.BLKW	1		;flag READ/INPUT
NUMBER::.BLKW	1		;НОМЕР КОМПИЛИРУЕМОЙ СТРОКИ
ADRHLT::.BLKW	1		;АДРЕС ОСТАНОВА ПРОГРАММЫ
TRFLAG::.BLKW	1		;ФЛАГ РЕЖИМА ТРАССИРОВКИ
AUTOON::.BLKW	1		;ФЛАГ РЕЖИМА AUTO
AUINC::	.BLKW	1		;AUTO ПРИРАЩЕНИЕ
CURLIN::.BLKW	1		;УКАЗАТЕЛЬ ТЕКУЩЕЙ СТРОКИ
III::	.BLKW	4		;РАБОЧИЕ ЯЧЕЙКИ ФУНКЦИИ RND
RNDSAV::.BLKW	4		;ТЕКУЩЕЕ ЗНАЧЕНИЕ RND
;MAXFIL::.BLKW	1	;maksimalxnoe koli~estwo fajlow dannyh
USRTAB::.BLKW	10.		;ТАБЛИЦА АДРЕССОВ USR
;APRL::	.BLKW	15	;tablica neqwnogo opredeleniq tipow
PNTSAV::.BLKW	1		;rabo~aq q~ejka {aga
PFACT::	.BLKW	2		;ukazatelx bloka parametrow dlq FN
TMP::	.BLKW	1		;ukazatelx wremennyh deskriptorow
SAVJMP::.BLKW	1		;adres koda wypolnqemoj programmy
LPTPOS::.BLKB	1		;s~et~ik golowki printera
	.EVEN
;
    .IF	EQ,MASINA-BK0010
FNKSTR::.BLKB	170.		;БУФЕР ТЕКСТОВ ФУНКЦИОНАЛЬНЫХ КЛАВИШ
$SCRT:	.BLKW	1		;rabo~aq peremennaq DRAW
    .IF	EQ,KONTYP-KLAS
COPPNT:	.BLKW	1		;ukazatelx ozu |krana dlq COPY
EKRHUK:	.BLKW	1		;adres dopoln. podpr.
	.ENDC
;
; Ветка .IFF (до ближайшего .IFT/.IFTF): код других машин (EL60, NC80, SM4, MDS) - в сборку БК-0010 не входит.
    .IFF
TABX::	.BLKB	1		;НО. ПОЗИЦИИ КУРСОРА
TABY::	.BLKB	1		;НО. СТРОКИ КУРСОРА
SIIKP::	.BLKB	1		;ПРИЗНАК ЗАПИСИ КОДА ИЗ КЛАВИАТУРЫ
RLPOZ::	.BLKB	1		;ПРИЗНАК РУС. ЛАТ.
SAUG::	.BLKW	4		;ХРАНЕНИЕ ВЕКТОРА ПРЕРЫВАНИЯ КЛАВИАТУРЫ
				;И КОМАНД ПЕРЕЗАПУСКА СИСТЕМЫ
    .IFTF
WRITE::	.BLKW	1		;adres drajwera ustrojstwa wne{nej pamqti
IODEV:: .BLKW	1		;НОМЕР ТЕКУЩЕГО ФАЙЛА
INK::	.BLKW	1		;БУФЕР INKEY
BUF::	.BLKB	400		;БУФЕР ВВОДА
BUFOUT::.BLKB	30		;БУФЕР ВЫВОДА
TEXT::	.BLKW	1		;ОБЛАСТЬ ПРОГРАММЫ ПОЛЗОВАТЕЛЯ
;
; ====================
; ****ПУСК СИСТЕМЫ****
; ====================
;
	.GLOBL	MONIT,TRAP,CLRTXT,BC,CASCII,BLOCKN,FNDBUF,NEXDBL,NEXJMP
	.GLOBL	TOINT,$B93,$B95,ID,SI,DI,$DMUL$,SETST,CAS,JMP,DFNRET
	.GLOBL	LNUM

	.=MEMTYP
; START - точка входа ПЗУ БК-0010. Структура файла: BK.MAC содержит системные
; константы и переменные, пуск системы, ввод-вывод через монитор ПЗУ (EMT),
; редактор строки, отладочный STEP, сервис клавиш и обмен через ИРПС.
START::
    .IFT
    .IF	EQ,MEMTYP-ROM
	MOV	#100000,R1	;CHECK SUM
	MOV	#3,R3		; 3 блока
4$:	MOV	#10000,R2	; 4096 слов в блоке
	CLR	R0
3$:	ADD	(R1)+,R0	; сумма с циклическим переносом
	ADC	R0
	SOB	R2,3$
	CMP	R0,#177777	; ожидается 177777
	BEQ	2$		; верна =>
	RETURN			; нет - запуск не выполняется
2$:	SOB	R3,4$
	.ENDC
;
    .IFTF
	MOV	#STACK,SP	; стек интерпретатора
; Ветка .IFF (до ближайшего .IFT/.IFTF): код других машин (EL60, NC80, SM4, MDS) - в сборку БК-0010 не входит.
    .IFF
	MOV	AVPK,SAUG
	MOV	AVPK+2,SAUG+2
	MOV	0,SAUG+4
	MOV	2,SAUG+6
    .IFTF
    .IF	EQ,MEMTYP-ROM
	MOV	#MVIDEO,HIMEM	; верх памяти Бейсика (ПЗУ): под экран, MVIDEO
    .IFF
	MOV	#MEMTYP,HIMEM	; верх памяти Бейсика (ОЗУ): MEMTYP
	.ENDC
	CLR	TRFLAG		; трассировка выключена
	CLRB	LPTPOS		; позиция головки принтера = 0
	MOV	#200.,STRSIZ	; размер области строк по умолчанию - 200 байт (десятичное)
	MOV	#AUINC,R0	; R0 -> AUINC (за ним CURLIN, III, RNDSAV)
	MOV	#12,(0)+	; AUINC = 10 (шаг AUTO по умолчанию)
	MOV	#12,(0)+	;CURLIN (= 10 по умолчанию)
	MOV	R0,R1
	MOV	#40101,(0)+	; начальное значение генератора RND (4 слова)
	MOV	#44122,(0)+
	MOV	#37502,(0)+
	MOV	#52125,(0)+
	.REPT	4		; копия начального значения - в следующие 4 слова (RNDSAV)
	MOV	(1)+,(0)+
	.ENDR
;	MOV	#1,(R0)+	;MAXFIL <- 1
	MOV	#10.,R1		; 10 функций USR
1$:	MOV	#NOUSR,(0)+	;НЕОПРЕДЕЛЕННЫЕ ФУНКЦИИ USR
	SOB	R1,1$
    .IFT
	MOV	#4,@#$SCRT	;SENAS DRAW
; 	MOV	#2000,@#$SCRT
;
    .IFTF
;	MOV	#15,R1		;neqwnyj tip
;5$:	MOV	#2004,(R0)+
;	SOB	R1,5$
;
;	CLR	(R0)+		;STOPAR
	CLR	PNTSAV		; нет точек останова STEP
	CALL	MIDM		;ИНИЦИАЛИЗАЦИЯ УСТРОЙСТВ
	CALL	CLRTXT		; очистить программу, вывести начальное сообщение
    .IFT
	CALL	KINIT		;ИНИЦИАЛИЗАЦИЯ КЛЮЧЕЙ
    .IFTF
	BR	SETW		; => установка векторов и вход в монитор
SUM1::	.WORD	0		; SUM1 - балансирующее слово контрольной суммы ПЗУ
; Ветка .IFF (до ближайшего .IFT/.IFTF): код других машин (EL60, NC80, SM4, MDS) - в сборку БК-0010 не входит.
    .IFF
; INIT - обработчик вектора 2 (нечётный адрес/ошибка шины) - аварийное
; восстановление: сбросить стек, снять точки останова (SEPAP), заново
; инициализировать устройства и вернуться к установке векторов.
INIT:	MOV	#STACK,SP
	JSR	R2,SEPAP	; снять точки останова STEP, сбросить стек интерпретатора
	CALL	MIDM		; переинициализировать устройства
	BR	SETW
    .IFTF
;
; CTRLC - обработчик CTRL/C вне выполнения программы (LYGIS>=0): просто
; прервать текущий ввод и вернуться в монитор. Во время выполнения (LYGIS<0)
; - полноценная обработка через BREAK.
CTRLC:	TST	LYGIS
	BMI	BREAK		; программа выполняется => полная обработка =>
	MOV	#STACK,SP
	MOV	#12,R0
	CALL	ISV		; перевод строки
	JMP	MONIT+4
;
;
WSTOP::	.BYTE	12,363,364,357,360,12	; WSTOP: LF + текст "СТОП" (КОИ-8) + LF
;
BREAK::	MOV	#IRPS2-10,@#BREAKW
	CLR	@#177660
	CLR	IODEV
    .IFT
	EMT	34		; получить слово состояния дисплея в R0
	BIT	#400,R0		; бит 8 = режим текстовой графики "ГРАФ"
	BEQ	1$		; не в графике => пропустить выход из неё =>
	MOV	#225,R0
	EMT	16		; выйти из режима "ГРАФ"
	CALL	ISVSS
    .IFTF
1$:	MOV	#WSTOP,R1
	MOV	#5,R2
	CALL	ISVEIL		; вывести "СТОП"
	TST	LYGIS
	BGE	2$		; программа не выполнялась => просто перевод строки =>
	TST	SAVJMP		; ждал ли CONT после HALT (SAVJMP)?
	BEQ	3$
	MOV	SAVJMP,R4	; да - использовать эту точку продолжения
	CLR	SAVJMP
3$:	CMP	R4,STRREG
	BHI	2$		; R4 вне кода программы => не выводить номер строки =>
	CMP	@SP,#NEXDBL-20
 	BEQ	10$
	CMP	@SP,#NEXJMP+22
	BEQ	10$
	CMP	@SP,#JMP+2
	BEQ	10$
	CMP	@SP,#DFNRET-14
	BLO	11$
	CMP	@SP,#DFNRET-2
	BHI	11$
	BEQ	10$
	TST	(4)+		; поправить R4 (прервано на выборке инструкции)
10$:	TST	(4)+		; поправить R4 ещё на слово
11$:	CALL	LNUM		; вывести номер прерванной строки
	MOV	-(4),ADRHLT	; запомнить адрес останова для CONT
	BR	4$
2$:	MOV	#12,R0
	CALL	ISV		; перевод строки
4$:	JSR	R2,SEPAP	; снять точки останова STEP, сбросить стек интерпретатора
   	CLR	LYGIS
SETW:	CLR	@#TIMER+2	;УСТАНОВКА ВЕКТОРОВ ПРЕРЫВАНИЙ
	MOV	#IRPS2-10,@#TIMER	;TAIMERIS DARBUI SU PRINTERIU
	MOV	#IRPS2-10,@#BREAKW	; клавиша СТОП,
	CLR	@#BREAKW+2
	MOV	#TRAP,TRAPW	; TRAP,
	CLR	TRAPW+2
	MOV	#IRPS2-10,@#ILCODW	; неверная инструкция
	CLR	@#ILCODW+2
; Ветка .IFF (до ближайшего .IFT/.IFTF): код других машин (EL60, NC80, SM4, MDS) - в сборку БК-0010 не входит.
    .IFF
	MOV	#137,@#0
	MOV	#INIT,@#2
;
    .IFT
    .IF	EQ	KONTYP-KLAS
    .IFTF
	CLR	@#IRPSRG+4
    .IFT
	MOV	#IRPS1,@#IRPSW
	CLR	@#IRPSW+2
	BIS	#100,@#IRPSRG
	CLR	EKRHUK
; Ветка .IFF (до ближайшего .IFT/.IFTF): код других машин (EL60, NC80, SM4, MDS) - в сборку БК-0010 не входит.
    .IFF
	CLR	@#IRPSRG
    .ENDC
    .IFTF
	MOV	#SYSERR,@#ILCODW	; неверная инструкция (ILCODW) - ошибка 51
SYS1:	MOV	#BREAK,@#BREAKW	; клавиша СТОП - обработчик BREAK
	JMP	STAR		;ПЕРЕХОД НА БЭЙСИК-МОНИТОР
SYSERR:	TRAP	51.		; SYSERR: ошибка 51 - системная ошибка
;
;
; =========================
; ****БЛОК ВВОДА-ВЫВОДА****
; =========================
;
; ------------------------------------
; ####КОНСТАНТЫ БЛОКА ВВОДА-ВЫВОДА####
; ------------------------------------
;
; Ветка .IFF (до ближайшего .IFT/.IFTF): код других машин (EL60, NC80, SM4, MDS) - в сборку БК-0010 не входит.
	.IFF
	.IF	EQ,MASINA-MDS
TIMER=177546			;АДРЕС CSR ТАЙМЕРА
	.ENDC
ARSK=177560			;АДРЕС РСК
ARDK=177562			;АДРЕС РДК
ARSTV=177564			;АДРЕС РСТВ
ARDTV=177566			;АДРЕС РДТВ
AVPK=60				;АДРЕС ВЕКТОРА ПРЕР. КЛ.
;
	.IFT
ARDK=177662			;АДРЕС РДК БК0010
;
; ---------------------------------------
; ## ИНИЦИАЛИЗАЦИЯ БЛОКА ВВОДА-ВЫВОДА ###
; ---------------------------------------
;
MIDM:				; MIDM: инициализация монитора БК
	.IF	EQ,MEMTYP-ROM
	RESET			; сброс устройств
	EMT	14		; EMT 14 - инициализация экрана
	.IFF
	CLR	@#260
	EMT	34
	ASR	R0
	BCS	1$
	.ENDC
 	MOV	#233,R0		; код 233 драйверу экрана (режим экрана)
	EMT	16		; вывод кода
1$:	MOV	#236,R0
	EMT	16		; код 236 драйверу экрана
	MOV	#BUF,R0		; BUF..TEXT заполнить словами LF-LF (#5012)
2$:	MOV	#5012,(0)+
	CMP	R0,#TEXT
	BLO	2$
	CLR	IODEV		; IODEV = 0 - вывод на экран
	RETURN
;
KINIT:	MOV	#FNKSTR,R1	; KINIT: R1 -> буфер текстов функциональных клавиш FNKSTR
	MOV	#KEYTXT,R2	; R2 -> тексты по умолчанию KEYTXT
	CLR	R3		; R3 - номер клавиши
2$:	INC	R3
	MOV	R1,R4
	MOV	R3,R0
	EMT	12		; EMT 12 - привязка строки клавиши (по смыслу вызова)
	MOVB	@R2,R5		; длина текста
	INC	R5
1$:	MOVB	(R2)+,(R4)+
	SOB	R5,1$
	ADD	#17.,R1		; 17. байт на клавишу
	CMP	R3,#10.		; 10. клавиш
	BLO	2$
	CALL	ISVSS		; показать строку клавиш
	RETURN
KEYTXT:	.ASCII	<6>/COLOR /<5>/AUTO /<5>/GOTO /<5>/LIST /<4>/RUN/<12>	; KEYTXT: тексты клавиш F1..F10: длина, текст
	.ASCII	<12>/COLOR 1,0/<12><6>/CLOAD"/<5>/CONT/<12><2>/./<12>
	.ASCII	<5><14>/RUN/<12>
	.EVEN
;
ISVSS::	MOV	#236,R0		; ISVSS: вывести строку функциональных клавиш
	EMT	16		; код 236 драйверу
	MOV	#FNKSTR,R3	; R3 -> FNKSTR
	CLR	R1
4$:	MOV	R3,R5
	MOVB	(R5)+,R2
	MOV	#' ,R0		; пробел по умолчанию
3$:	DEC	R2
	BMI	5$
	CMPB	#' ,(R5)+
	BGE	3$
	MOVB	-(R5),R0
5$:	EMT	22		; EMT 22 - вывод символа в позицию строки клавиш
	ADD	#17.,R3		; к следующей клавише
	INC	R1
	CMP	R1,#10.
	BLT	4$
	MOVB	#' ,R0
	EMT	22
	INC	R1
	EMT	22
	RETURN
;
; Ветка .IFF (до ближайшего .IFT/.IFTF): код других машин (EL60, NC80, SM4, MDS) - в сборку БК-0010 не входит.
	.IFF
MIDM:
	.IF	EQ,MASINA-MDS
	CLR	TIMER
	.ENDC
	RESET
	MOV	#12,BUF+6
	MOV	#IVS,AVPK
	BIS	#100,ARSK
	CLR	IODEV
	RTS	PC
;
	.IFTF
;
; -------------------
; ## ЧТЕНИЕ СТРОКИ ##
; -------------------
;
	.IFT
; IVEIL - ввод строки с клавиатуры в BUF: экранный редактор строки БК. Символы
; приходят из монитора ПЗУ (EMT 6) и сразу выводятся на экран (EMT 16); коды
; управления (стрелки, вставка/удаление символа, очистка, возврат строки, ГРАФ)
; обрабатываются здесь. Обработчики: 4$ очистка, 6$ аннулирование символа, 7$ и
; 2$ курсор вправо/влево, 26$ смыкание строки (удалить символ), 27$ размыкание
; (вставить пробел), 3$ конец ввода, 21$ возврат строки, 51$ табуляция.
IVEIL::	MOV	R0,-(SP)	;СОХРАНЕНИЕ РЕГИСТРОВ
	MOV	R2,-(SP)
	MOV	R3,-(SP)
	MOV	R5,-(SP)
SBRALL:	EMT	26		; EMT 26 - текущие координаты курсора в R1,R2
	MOV	R1,-(SP)
SBROS:	MOV	#BUF,R1		;АДРЕС СТРОКИ
	MOV	R1,R3
	MOV	#400,R2		;ДЛИНА СТРОКИ
	MOV	R2,-(SP)
PIJ::	EMT	6		;ЧТЕНИЕ ОЧЕРЕДНОГО СИМВОЛА
	MOVB	R0,R5
	BGE	5$		; код < 200 (обычные и управляющие)  =>
	CMPB	R0,#211		; 211?
	BEQ	55$
    .IF	EQ,MEMTYP-RAM
	CMPB	R0,#214
	BEQ	PIJ
    .ENDC
	CMPB	R0,#240		; 240 и выше - буквы (КОИ-8) =>
	BGE	14$
	CMPB	R0,#233		; 233..237 - вывести как есть =>
	BGE	55$
	CMPB	R0,#231		; 231 - смыкание строки (удалить символ) =>
	BNE	153$
	JMP	26$
153$:	CMPB	R0,#225
	BGT	PIJ		; код > 225 - игнорировать
	BNE	12$		; 225 (ГРАФ) =>
13$:	EMT	16		; ГРАФ: выводить коды драйверу экрана
	EMT	6
	CMPB	R0,#225
	BNE	13$		; пока не придёт ещё 225
	EMT	16
	CMP	(SP)+,(SP)+
	CALL	ISVSS		; показать строку клавиш и начать ввод заново
	BR	SBRALL
12$:	CMPB	R0,#220		; 220 - клавиша STEP
	BNE	55$
	CALL	STEP		; выполнить шаг отладки
55$:	EMT	16		; вывод кода на экран
	CMPB	R5,#236
	BNE	PIJ
	CALL	ISVSS
	BR	PIJ
14$:	CMP	R1,R3		;ЗАПИСЬ ОЧЕРЕДНОГО СИМВОЛА
	BEQ	17$
	INC	R2
	DEC	R3
17$:	MOVB	R0,(R1)+
16$:	INC	R3
15$:				;wywod na |kran
    .IF	EQ,KONTYP-KLAS
	CALL	ISV
    .IFF
	EMT	16
    .ENDC
	DEC	R2
	BNE	PIJ
47$:	TRAP	25.		;СЛИШКОМ ДЛИННАЯ СТРОКА
5$:	CMPB	R0,#177		; 177 (ЗБ)?
	BNE	155$
	MOVB	#26,R0
	BR	26$
155$:	CMPB	R0,#3		; 3 (СТОП/Ctrl-C) =>
	BNE	20$
	JMP	CTRLC
20$:	CMPB	R0,#40		; печатные символы (>= 40) =>
	BGE	14$
	CMPB	R0,#7		; 7 (звонок) - только вывод
	BEQ	55$
	CMPB	R0,#10		; 10 (влево) =>
	BEQ	2$
	CMPB	R0,#12		; 12 (LF) - конец строки =>
	BEQ	3$
	CMPB	R0,#14		; 14 (очистка экрана) =>
	BEQ	4$
	SUB	#23,R5		; прочие управляющие: таблица переходов по коду 23..37
	BLT	PIJ
	ASL	R5
	ADD	R5,PC
	BR	21$
	BR	51$
	BR	PIJ
	BR	26$
	BR	27$
	BR	6$
	BR	7$
	BR	132$
	BR	133$
	BR	134$
	BR	135$
	BR	136$
	BR	137$
4$:	EMT	16		;ОЧИСТКА
	TST	(SP)+
	BR	SBROS
6$:	CMP	R2,@SP		;АНУЛИРОВАНИЕ СИМВОЛА
	BEQ	152$
	CMP	R1,R3
	BNE	1$
	DEC	R1
	DEC	R3
	INC	R2
	BR	151$
1$:	CMP	#BUF,R1
	BEQ	152$
	TSTB	-(R1)
151$:	EMT	16
152$:	MOVB	#26,R0
	BR	26$
2$:	CMP	#BUF,R1		;  <---
	BEQ	PIJ
	DEC	R1
	BR	55$
7$:	CMP	R1,R3		;  --->
	BEQ	11$
	INC	R1
	INC	R2
	BR	15$
11$:	MOVB	#40,(R1)+
	BR	16$
51$:	MOVB	#31,R0		;gorizontalxnaq tabulqciq
	CMP	R1,R3
	BLO	52$
	MOVB	#40,R0
	INC	R3
	DEC	R2
	BLE	47$
