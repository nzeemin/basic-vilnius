	CALL	ISV
	MOVB	#32,R0
	BR	12$
1$:	CALL	ISV		;ОЧИСТКА
	CLRB	TABX
	CLRB	TABY
	TST	(SP)+
	BR	SBROS
2$:	MOVB	#12,R0		;КОНЕЦ ЧТЕНИЯ СТРОКИ
	MOV	R3,R1
	DEC	R2
	BEQ	24$
	MOVB	R0,(R1)+
	CALL	ISV		;ПО СИМВОЛУ ЗАВЕРШИТЕЛЮ
	BR	KCTSTR
3$:	DECB	TABX
	CALL	ISV		;РУС. ЛАТ.
	BR	PIJ
27$:	CMP	R1,R3		;РАЗМЫКАНИЕ СТРОКИ
	BEQ	PIJ
	MOV	R3,R5
31$:	MOVB	-(R5),1(R5)
	CMP	R5,R1
	BHI	31$
	MOVB	#40,@R1
	DECB	TABX
	BR	17$
30$:	CMP	R1,R3		;СМЫКАНИЕ СТРОКИ
	BEQ	18$
	MOV	R1,R5
	INC	R5
32$:	MOVB	(R5)+,-2(R5)
	CMP	R5,R3
	BLO	32$
	TST	(R2)+
	DEC	R3
	DECB	TABX
	CALL	KISV
	BR	23$
4$:	CMP	R1,R3		; --->
	BEQ	13$
	INC	R1
	INC	R2
	CALL	KISV
	BR	23$
