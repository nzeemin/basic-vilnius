	BIS	#100,ARSK
	TRAP	31		;СЛИШКОМ ДЛИННАЯ СТРОКА
KCTSTR:	CMP	(SP)+,(SP)+
	MOV	(SP)+,R5
	MOV	(SP)+,R3
	MOV	(SP)+,R2
	MOV	(SP)+,R0
	CLRB	SIIKP
	BIS	#100,ARSK
	RTS	PC
KISV:	CALL	ISV		;ОТОБРАЖЕНИЕ ОЧЕРЕДНОГО СИМВОЛА
	TSTB	TABX
	BGE	21$
	DECB	TABY
	BLT	22$
	MOVB	#117,TABX
21$:	RTS	PC
22$:	MOVB	#27,TABY
	MOVB	#117,TABX
	RTS	PC
;
; --------------------------
; ### ОТОБРАЖЕНИЕ СТРОКИ ###
; --------------------------
; ВХОД:	R1- АДРЕС СТРОКИ
;		R2- ДЛИНА СТРОКИ (МЛ. БАИТ)
;		  - СИМВОЛ ОГРАНИЧИТЕЛЬ (СТ. БАИТ)
;
	.IFT
ISVETO::MOV	R3,-(SP)	; ISVETO: вывод строки R1,R2 на устройство IODEV: 0 - экран, <0 - принтер, >0 - файл
	MOV	IODEV,R3	; R3 = IODEV
	BNE	LP		; не экран =>
	MOV	(SP)+,R3
ISVEIL::			; ISVEIL: вывод строки (R1 адрес, R2 длина) на экран
    .IF	EQ,KONTYP-KLAS
	MOV	R1,-(SP)
	MOV	R2,-(SP)
    .IFTF
	EMT	20		; EMT 20 - вывод строки
    .IFT
	TST	EKRHUK
	BEQ	3$
	MOV	(SP)+,R2
	MOV	(SP)+,R1
	MOV	R0,-(SP)
	MOV	R3,-(SP)
	MOV	R2,R3
	SWAB	R3		; R3 = байт-терминатор (старший байт R2)
	BIC	#177400,R2
1$:	MOVB	(R1)+,R0
	CALL	@EKRHUK
	CMPB	R0,R3
	BEQ	2$
	SOB	R2,1$
2$:	MOV	(SP)+,R3
	MOV	(SP)+,R0
    .ENDC
3$:	RETURN
;
LP::	BPL	FILOUT		; LP: вывод строки на принтер (IODEV < 0) или в файл
	MOV	R0,-(SP)
	MOV	R5,-(SP)
	MOV	R2,R3
	SWAB	R3
	BIC	#177400,R2
	MOV	#ARPORT,R5	; R5 -> регистр программируемого порта
	MOVB	#23,R0		; код 23 принтеру (инициализация)
	CALL	LPISV		; послать
1$:	MOVB	(1)+,R0
	CMPB	R0,#37		; управляющий символ?
	BLOS	2$
	CMPB	R0,#177		; 127..255 - печатные =>
	BLO	3$
	CMPB	R0,#277
	BHI	3$
2$:	CMPB	R0,#10		; BS?
	BEQ	6$
	CMPB	R0,#14		; FF/CR/(205)?
	BEQ	8$
	CMPB	R0,#15
	BEQ	8$
	CMPB	R0,#205
	BEQ	8$
	CMPB	R0,#12		; LF: сначала CR
	BNE	9$
	MOVB	#15,R0
	CALL	LPISV
	MOV	#12,R0
8$:	CLRB	LPTPOS		; LPTPOS - головка в начало строки
	BR	9$
6$:	DECB	LPTPOS		; BS: позиция - 1
	BGT	9$
	MOVB	#77,LPTPOS
	BR	9$
3$:	INCB	LPTPOS		; печатный символ: позиция + 1
9$:	CALL	LPISV		; послать
	CMPB	R0,R3		; терминатор?
	BEQ	5$
	SOB	R2,1$
5$:	MOV	(SP)+,R5
	MOV	(SP)+,R0
	MOV	(SP)+,R3
	RETURN
;
LPISV:	BIC	#177000,R0	; LPISV: послать байт R0 принтеру через порт ARPORT
	BIS	#400,R0		; бит 8 - строб
2$:	BIT	#400,@R5	; ждать готовности
	BEQ	2$
	MOV	R0,@R5		; выдать байт
3$:	BIT	#400,@R5	; ждать приёма
	BNE	3$
	CLR	@R5		; снять строб
	CMPB	LPTPOS,#100	; длина строки принтера 64. (100 окт.)
	BLE	1$
	CLRB	LPTPOS
1$:	RETURN
;
; Ветка .IFF (до ближайшего .IFT/.IFTF): код других машин (EL60, NC80, SM4, MDS) - в сборку БК-0010 не входит.
	.IFF
ISVETO::
ISVEIL::MOV	R0,-(SP)
	MOV	R3,-(SP)
	MOV	R2,R3		;ОТРАБОТКА ПРИЗНАКОВ КОНЦА СТРОКИ
	SWAB	R3
	CMPB	R3,#12
	BNE	11$
	MOVB	#15,R3
11$:	BIC	#177400,R2
	MOV	IODEV,R0
	BNE	LP
1$:	TSTB	@R1
	BPL	2$
	TSTB	RLPOZ		;КИРИЛИЦЫ
	BNE	4$
	INCB	RLPOZ
	MOVB	#16,R0
	CALL	ISV
	DECB	TABX
4$:	CLR	-(SP)
	MOVB	(R1)+,@SP
	SUB	#200,@SP
	MOVB	@SP,R0
	TST	(SP)+
	BR	3$
2$:	TSTB	RLPOZ
	BEQ	5$
	CLRB	RLPOZ
	MOVB	#17,R0
	CALL	ISV
	DECB	TABX
5$:	MOVB	(R1)+,R0
3$:	CALL	ISV
	CMPB	R0,R3
	BEQ	ISVG
	DEC	R2
	BNE	1$
ISVG:	CLRB	RLPOZ		;КОНЕЦ ВЫВОДА СТРОКИ
	MOVB	#17,R0
	CALL	ISV
	DECB	TABX
ENDLP:	MOV	(SP)+,R3
	MOV	(SP)+,R0
	RTS	PC
;
LP:	BPL	FILOUT
	MOVB	(R1)+,R0
10$:	TST	@#177514
	BMI	11$
	TSTB	@#177514
	BPL	10$
	MOVB	R0,@#177516
	CMPB	R0,#12
	BNE	15$
	MOV	#15,R0
	BR	10$
15$:	CMPB	R0,R3
	BEQ	2$
	DEC	R2
	BNE	LP
2$:	BR	ENDLP
11$:	TRAP	23
;
FILOUT:	CMP	(SP)+,(SP)+
	MOV	R0,R3
	.IFT
FILOUT:	TST	(SP)+
	.IFTF
	CALL	FNDBUF
	BITB	#1,(R0)+
	BNE	NOTOUT		; открыт не для вывода => ошибка =>
	CLR	R3
	BISB	@R0,R3
	ADD	R0,R3
	ADD	#21,R3
COPOUT::DEC	R2
	BMI	NOSTEP
	MOVB	(R1)+,(R3)+	; скопировать байт в буфер файла
	INCB	@R0		; учесть его в счётчике заполнения буфера (в FCB)
	BNE	COPOUT		; буфер ещё не полон => следующий байт =>
	MOV	R1,-(SP)	; буфер полон - сохранить позицию в источнике
	DEC	R0
	CALL	CASCII
	CALL	CAS
	CALL	BLOCKN
	MOV	(SP)+,R1
	SUB	#400,R3
	INC	R0
	BR	COPOUT		; продолжить с оставшимися байтами
NOSTEP:	RETURN
NOTOUT:	TRAP	52.		; ошибка: файл не открыт для вывода
;
; Ветка .IFF (до ближайшего .IFT/.IFTF): код других машин (EL60, NC80, SM4, MDS) - в сборку БК-0010 не входит.
    .IFF
ALRIC:	CMPB	R0,#20
	BNE	1$
	.IF	GE,MASINA-SM4
	BIC	#0,177776
	.IFF
	MTPS	#0
	.ENDC
	TST	(SP)+
	JMP	BREAK
1$:	MOVB	@#ARDK,INK
	MOVB	#100,ARSK
	RTS	PC
;
INKEY::	MOV	#INK,-(SP)
	CLR	-(SP)
	TSTB	SIIKP
	BEQ	1$
	INC	@SP
	CLRB	SIIKP
1$:	RETURN

	.IFTF
	.GLOBL	VYKDYT,STAR,HALT,EILUTE,KODTST,AGAUD,IFGAUD
STEP:	TST	LYGIS
	BNE	NOSTEP
	CMP	R3,#BUF
	BNE	NOSTEP
	TST	ERRS
	BNE	1$
	ADD	#20,SP
	NEG	TRFLAG
	MOV	ADRHLT,R4
	BNE	TRIN		; уже стояли на останове => найти следующий оператор =>
	MOV	FCB,R4
	TST	(R4)+
	BR	STP2
1$:	TRAP	17.
TRIN::	MOV	#IRPS2-10,@#BREAKW
      	CALL	AGAUD		; найти запись строки, содержащую R4 (текущий адрес)
STP2:	CLR	AUTOON		; выключить AUTO-режим
	CLR	NUMBER		; сбросить текущий номер строки
	CMP	-(R4),-(R4)	; сдвинуть R4 на 4 байта назад (см. AGAUD/DEL)
	JSR	R0,SETST	; зарегистрировать позицию (0/1-сдвиг возврата)
	BR	50$		; 0-сдвиг => продолжить поиск следующего оператора =>
	JMP 	SYS1
; 50$..22$ - классифицировать текущий оператор (KODTST): GOTO/GOSUB/RETURN/
; RESTORE => 3$, IF/ON => 4$ (через IFGAUD), иначе обычный оператор. Находит
; целевую строку перехода и ставит на неё останов (REPA/HCOR). Разбор
; операндов через TRAP 110/111 понятен в общих чертах, детали не выяснены.
50$:	CMP	(4)+,(4)+	; пропустить 4 байта (заголовок оператора)
	MOV	R4,R2		; R2 = начало кода оператора
	MOV	R4,R0
	MOV	-(0),R0		; R0 = слово опкода оператора (перед R4)
	JSR	R5,KODTST	; классифицировать опкод
	BR	3$		; GOTO/GOSUB/RETURN/RESTORE =>
	BR	4$		; IF/ON =>
	CMPB	#40,@R0		; обычный оператор: это FOR?
	BNE	21$
	JSR	R5,NEXPAP	; FOR - обработать через NEXPAP (см. ниже)
	MOV	R2,R4
21$:	SUB	#6,R4		; точка останова - сразу после заголовка оператора
	BR	32$
4$:	MOV	R0,R3		; R3 -> текст оператора IF/ON (для поиска номеров строк)
	INC	R3
41$:	CMPB	(3)+,#12	; конец строки текста оператора?
	BEQ	45$		; да - завершить =>
42$:	JSR	R2,IFGAUD	; найти следующий символ-разделитель/номер строки
	BR	45$		; конец =>
	BR	41$		; не найдено - следующий символ =>
    	CMP	#4,R5
	BNE	47$
	JSR	R5,NEXPAP	; спецсимвол - через NEXPAP =>
	BR	42$
47$:	CMP	#6,R5
	BEQ	42$
	MOV	R5,R0
48$:	TRAP	110		; разобрать номер строки-цели
	BR	43$
	TRAP	111		; найти её в таблице строк
	BR	44$
	BR	42$
44$:	JSR	R5,HCOR		; поставить точку останова на найденной строке
	TRAP	112		; пропустить пробелы
	CMPB	#',,@R3		; следующий операнд через запятую (ON ... GOTO n1,n2,...)?
	BNE	42$
	INC	R3
	BR	48$
45$:	MOV	R2,R4
	BR	21$
43$:	CMP	#2,R0
	BNE	42$
	JSR	R5,REPA		; строка не найдена - попробовать место возврата GOSUB
	BR	42$
	BR	44$
3$:	CMPB	#74,@R0		;RESTORE
	BEQ	21$		; RESTORE без разбора операнда - точка останова сразу за ним =>
	INC	R0
	MOV	R0,R3
	TRAP	110		; разобрать номер строки-цели (GOTO/GOSUB/RETURN)
	BR	31$
	TRAP	111		; найти её в таблице строк
	BR	32$
	NOP
31$:	JSR	R5,REPA		; не найдена - через REPA (место возврата GOSUB)
	BR	37$
32$:	JSR	R5,HCOR		; найдена - поставить точку останова
37$:	MOV	R2,R4
    	MOV	SP,PNTSAV
	CALL	EILUTE
	TST	TRFLAG
	BLE	2$		; трассировка выключена => без скобок =>
	MOVB	#133,R0
	CALL	ISV		; вывести "["
	BIS	#20000,R2
	CALL	ISVEIL
	MOVB	#135,R0
	CALL	ISV		; вывести "]"
	BR	22$
2$:	CALL	ISVEIL
22$:	MOV	-(4),R4
	MOV	#BREAK,@#BREAKW
	JMP	VYKDYT		; вернуться в интерпретатор (выполнить один оператор)
;
; REPA - помощник STEP: если есть активный GOSUB, найти его точку возврата
; в таблице строк (AGAUD), чтобы туда тоже можно было поставить останов.
REPA:	TST	(SP)+
	CMP	LENT,LIMIT
	BEQ	1$		; нет активных GOSUB => вернуться как есть =>
	MOV	@LIMIT,R4	; R4 = адрес возврата ближайшего активного GOSUB
	CALL	AGAUD		; найти его запись в таблице строк
	CMP	-(4),-(4)
	TST	(5)+		; 1-сдвиг адреса возврата
1$:	MOV	R5,PC
;
; HCOR - помощник STEP: ставит временную точку останова на строке R4 (если
; она действительна и не равна текущему оператору) - сохраняет исходное
; слово кода на стеке и подменяет его переходом на STPEND.
HCOR:	TST	(SP)+
	JSR	R0,SETST	; проверить/зарегистрировать строку
	BR	2$		; строка действительна => поставить точку останова =>
	BR	1$		; иначе => выйти без установки =>
2$:	CMP	(4)+,(4)+	; пропустить служебные слова записи (см. AGAUD)
	CMP	R4,R2
	BEQ	1$		; цель = текущий оператор => не ставить =>
	CMP	R4,TABTOP
	BLO	1$		; цель вне таблицы строк => не ставить =>
	CMP	-(4),-(4)	; сдвинуть R4 на 4 байта назад
	MOV	@R4,R4		; R4 = реальный адрес кода строки-цели
	MOV	R4,-(SP)	; сохранить адрес для восстановления в STPEND
	MOV	@R4,-(SP)	; сохранить подменяемое слово кода
	INC	NUMBER		; отметить, что точка останова поставлена
	MOV	#STPEND,@R4	; подменить код переходом на STPEND
1$:	MOV	R5,PC
;
; NEXPAP - помощник STEP: поставить точку останова (HCOR) на строке каждого
; активного FOR (стек CIKL..LIMIT). AUTOON временно занят как флаг реентрантности
; и хранилище адреса возврата. Размер кадра FOR (ROL R0/BCS) не выяснен до конца.
NEXPAP:	TST	AUTOON
	BEQ	1$		; не в процессе обхода => начать =>
	RTS	R5		; уже внутри обхода (реентрантный вызов) => просто выйти
1$:	TST	(SP)+
	MOV	R5,AUTOON	; сохранить адрес возврата (и флаг "идёт обход")
	MOV	CIKL,R1		; R1 -> вершина стека кадров
3$:	CMP	R1,LIMIT
	BHIS	2$		; вышли за пределы кадров FOR (дошли до GOSUB) => готово =>
	MOV	2(1),R4		; поле кадра -> адрес строки цикла
	CALL	AGAUD		; найти её запись в таблице строк
	CMP	-(4),-(4)
	JSR	R5,HCOR		; поставить точку останова на этой строке
	MOV	@R1,R0		; слово кадра (флаг/тип?)
	ADD	#10,R1		; перейти к следующему кадру (мин. размер)
	MOV	-(0),R0
	ROL	R0		; проверить бит в слове кадра
	BMI	3$
	ADD	#14,R1		; иначе кадр больше - доп. смещение
	BR	3$
2$:	MOV	AUTOON,PC	; вернуться по сохранённому адресу
;
STPEND::MOV	#IRPS2-10,BREAKW
	JSR	R2,SEPAP	; снять все точки останова, восстановить код
	TST	-(R4)		; поправить R4 (сдвинуть на слово назад)
	TST	TRFLAG
	BLE	1$		; трассировка выключена => настоящая остановка =>
	JMP	TRIN		; включена => искать следующую точку останова =>
1$:	MOV	R4,ADRHLT
	NEG	TRFLAG
	MOV	#BREAK,BREAKW
	JMP	STAR
;
; SEPAP - общий сброс выполнения: снимает точки останова STEP (пары
; адрес/слово из стека, по счётчику NUMBER, до отметки PNTSAV) и сбрасывает
; стек интерпретатора. Вызывается при остановке/завершении программы
; (STOP, END, ошибка, CTRL/C), не только после STEP.
SEPAP::	TST	(SP)+
	INC	ERRS		; временно запретить выполнение
	TST	PNTSAV
	BEQ	5$		; точек останова не было (обычный сброс) =>
	MOV	PNTSAV,SP	; откатить стек к отметке начала сканирования STEP
2$:	DEC	NUMBER
	BLT	5$
	MOV	(SP)+,@(SP)+	; восстановить очередное подменённое слово кода
	BR	2$
5$:	CLR	PNTSAV
	MOV	#STACK,SP	; сбросить стек интерпретатора к началу
	CLR	ERRS		; снова разрешить выполнение
	CLR	NUMBER
	MOV	R2,PC
;
	.IFT
; CURON/CUROFF - включить/выключить курсор. EMT 34 - слово состояния
; дисплея в R0 (бит 14, #40000 = "гашение курсора"); код 232 через ISV
; переключает это состояние, поэтому обе проверяют бит и шлют код только
; когда переключение действительно нужно.
CURON::	EMT	34		; получить слово состояния дисплея в R0
	BIT	#40000,R0
	BEQ	C2		; курсор уже виден (не погашен) => ничего не делать =>
C1:	MOV	#232,R0		; курсор погашен => переключить (включить)
	CALL	ISV
C2:	RETURN
;
CUROFF::EMT	34		; получить слово состояния дисплея в R0
	BIT	#40000,R0
	BEQ	C1		; курсор виден => переключить (погасить) =>
	RETURN			; уже погашен => ничего не делать
;
INKEY::	MOV	#INK,-(SP)
	CLR	-(SP)
	TSTB	@#TSTKEY
	BEQ	1$
	EMT	6
	MOVB	R0,INK
	INC	@SP
1$:	JMP	@(R4)+
;
MAGNIT::
	EMT	36
	RETURN
;
    .IF EQ,1
SIGNAL::MOV	R2,R0
	MOVB	#320,@#ASPORT
1$:	SOB	R0,1$
	MOV	R2,R0
	MOVB	#220,@#ASPORT
2$:	SOB	R0,2$
	SOB	R1,SIGNAL
	RETURN
    .ENDC
;
USEROM::MOV	(4)+,R3
	MOV	R4,SAVJMP
	MOV	#1,R0
	MOV	#NOROM,@#BREAKW
NEXROM:	MOVB	R0,@#ASPORT+1
	ASL	R0
	CALL	@#AUSROM
	BCS	ERROM
	JSR	R0,STATUSQ
	JMP	@(R4)+
;
STATUSQ:TST	(SP)+
	MOV	#BREAK,@#BREAKW
	MOVB	#200,@#ASPORT+1
	CLRB	@#ASPORT+1
	MOV	SAVJMP,R4
	CLR	SAVJMP
	MOV	R0,PC
;
NOROM:	ADD	#6,SP
ERROM:	CMP	R0,#10
	BNE	NEXROM
	JSR	R0,STATUSQ
;
; Ветка .IFF (до ближайшего .IFT/.IFTF): код других машин (EL60, NC80, SM4, MDS) - в сборку БК-0010 не входит.
	.IFF
; SIGNAL - подать звуковой сигнал (BEL).
SIGNAL::MOV	#7,R0
	CALL	ISV
	RETURN
;
USEROM::
	.IFTF
NOUSR:	TRAP	5
;
ADDRMN::TRAP	106
	MOV	#14,R0
	CALL	ISV
;
	.IFT
	MOV	#1000,SP
	JMP	100274
;
; Ветка .IFF (до ближайшего .IFT/.IFTF): код других машин (EL60, NC80, SM4, MDS) - в сборку БК-0010 не входит.
	.IFF
	.IF	EQ,MASINA-MDS
	COM	TIMER
	.ENDC
	MOV	SAUG,AVPK
	MOV	SAUG+2,AVPK+2
	MOV	SAUG+4,0
	MOV	SAUG+6,2
	COM	ARSK
	JMP	0
;
	.IFTF
LOC::	TST	(SP)+		; LOC: включить/выключить курсор (LOCATE ,,n)
	BNE	1$
	CALL	CUROFF
	JMP	@(R4)+
1$:	CALL	CURON
	JMP	@(R4)+
;
; ZONA - запятая-разделитель PRINT: добить пробелами до границы следующей
; 16-позиционной зоны. Колонка берётся по устройству (IODEV), остаток до
; границы печатает SPC1 (общий хвост с TAB/SPC).
ZONA::				; ZONA
	.IFT
	MOV	IODEV,R3
	BLT	3$		; принтер =>
	BGT	4$		; файл =>
	EMT	26		; экран: опросить текущую колонку курсора в R1
	MOV	R1,-(SP)
	BR	41$
3$:	MOVB	LPTPOS,-(SP)	; принтер: текущая колонка на строке
	BR	41$
4$:	CALL	FNDBUF		; файл: найти FCB
	MOVB	@R0,-(SP)	; текущая колонка вывода в файл
41$:	SUB	#20,@SP		; вычесть одну зону (16 позиций)
	BGT	41$		; ещё есть целые зоны до текущей колонки => =>
	BEQ	42$		; колонка ровно на границе зоны => =>
	NEG	@SP		; иначе - остаток до конца текущей зоны
	BR	SPC1		; => вывести столько пробелов
42$:	MOV	#20,@SP		; на границе - добить всю следующую зону целиком
	BR	SPC1
;
; Упрощённый вариант (другая конфигурация): просто выводить пробелы, пока
; колонка TABX не достигнет кратности 16.
; Ветка .IFF (до ближайшего .IFT/.IFTF): код других машин (EL60, NC80, SM4, MDS) - в сборку БК-0010 не входит.
	.IFF
	MOV	#40,R0
1$:	CALL	ISV		; вывести пробел
	BITB	#17,TABX
	BNE	1$		; колонка ещё не кратна 16 => следующий пробел =>
2$:	JMP	@(R4)+
;
	.IFT
;SPC::	CALL	TIKR
;	BR	SPC1
TAB::	CALL	TIKR		; TAB: TAB(n)
	MOV	IODEV,R3
	BEQ	1$
	BGT	2$
	MOVB	LPTPOS,R1
	BR	3$
2$:	CALL	FNDBUF
	CLR	R1
	BISB	@R0,R1
	BR	3$
1$:	EMT	26
3$:	SUB	R1,@SP
SPC1:	MOV	#40,R0
1$:	DEC	@SP
	BLT	2$
	CALL	ISVTO
	BR	1$
2$:	TST	(SP)+
	JMP	@(4)+
;
TIKR:	TSTB	3(SP)
	BNE	NOUSR
	RETURN
;
AT::	CALL	TIKR		; AT: AT(x,y)
	MOV	(SP)+,R2
	TST	IODEV
	BNE	TAB
 	CALL	TIKR
	MOV	(SP)+,R1
	EMT	24
	JMP	@(R4)+
;
DLOCX::	CMP	(SP)+,(SP)+	; LOCX: колонка курсора (EMT 26)
SLOCX::	TST	(SP)+
ILOCX::	TST	(SP)+
LOCX::	EMT	26
	MOV	R1,-(SP)
	JMP	@(R4)+
;
DLOCY::	CMP	(SP)+,(SP)+	; LOCY: строка курсора
SLOCY::	TST	(SP)+
ILOCY::	TST	(SP)+
LOCY::	EMT	26
	MOV	R2,-(SP)
	JMP	@(R4)+
;
$KEY::	MOV	(SP)+,R0	; $KEY: KEY n,"текст": запомнить текст функциональной клавиши
	CMP	R0,#16.		; длина текста не больше 16.
	BLOS	1$
	MOV	#16.,R0
1$:	MOV	(SP)+,R2
	MOV	(SP)+,R3
	BLE	NOUSR
	CMP	R3,#10.		; номер клавиши 1..10
	BGT	NOUSR
	MOV	#FNKSTR-17.,R1	; R1 -> запись клавиши в FNKSTR (по 17. байт)
2$:	ADD	#17.,R1
	SOB	R3,2$
	MOVB	R0,(R1)+	; длина
	BLE	4$
3$:	MOVB	(R2)+,(R1)+
	SOB	R0,3$
4$:	CALL	ISVSS		; показать строку клавиш
	JMP	@(R4)+
;
    .IF EQ,1
KEYISV::MOV	#FNKSTR,R3
4$:	MOV	R3,R1
	MOVB	(R1)+,R2
	BEQ	1$
3$:	MOVB	(R1)+,R0
	CMPB	#' ,R0
	BLE	2$
	MOVB	#' ,R0
2$:	CALL	ISV
	SOB	R2,3$
1$:	MOV	#12,R0
	CALL	ISV
	ADD	#17.,R3
	CMP	R3,#FNKSTR+170.
	BLO	4$
	JMP	@(R4)+
;
KEYON::
	CALL	ISVSS
	JMP	@(R4)+
KEYOFF::MOV	@#214,R2
	MOV	@#212,@#214
	MOV	#236,R0
	EMT	16
	MOV	R2,@#214
	JMP	@(R4)+
;
    .ENDC
; Ветка .IFF (до ближайшего .IFT/.IFTF): код других машин (EL60, NC80, SM4, MDS) - в сборку БК-0010 не входит.
	.IFF
AT::	MOV	(SP)+,R2
1$:	SUB	#30,R2
	BPL	1$
	ADD	#30,R2
	MOV	#15,R0
	CLRB	TABX
2$:	CALL	ISV
	MOV	#35,R0
	DECB	TABX
	CMPB	R2,TABY
	BEQ	TAB
	BGT	3$
	INCB	TABY
	BR	2$
3$:	DECB	TABY
	DEC	R0
	BR	2$
TAB::	MOV	(SP)+,R1
1$:	SUB	#120,R1
	BPL	1$
	ADD	#120,R1
2$:	CMPB	R1,TABX
	BEQ	3$
	MOV	#40,R0
	CALL	ISV
	BR	2$
3$:	JMP	@(R4)+
;
IRPS::
MAGNIT::MOVB	#2,1(1)
CURON::
CUROFF::RETURN
;
RSP::	TST	-(SP)
SPFORM::JMP	@(R4)+
$PAINT::TST	(SP)+
$KEY::	CMP	(SP)+,(SP)+
	TST	(SP)+
KEYON::
KEYOFF::
KEYISV::JMP	@(R4)+
;
PUNKT::
VEKT::	CMP	(SP)+,(SP)+
COLR::
COLF::	TST	(SP)+
TRECIA::JMP	@(R4)+
;
;
;======================
;======================
;
;
	.IFT
	.IF	EQ,KONTYP-KLAS
IRPS1:
	.GLOBL	GRBCOL,ASCCOD,ATSTAB
;
	MOV	R0,-(SP)
	MOVB	@#IRPSRG,R0
	BIC	#1,R0
	CMP	R0,#24
	BHIS	1$
	JMP	@LEN(R0)
1$:	MOV	(SP)+,R0
	RTI
;
LEN:	.WORD	START
	.WORD	0
	.WORD	NET
	.WORD	CLOAD1
	.WORD	CSAVE1
	.WORD	GR
	.WORD	GR
	.WORD	COPY
	.WORD	GR
	.WORD	SHO
;
ST:	ADD	#6,SP
	JMP	@#0
;
CLOAD1:
	MOV	FCB,TABTOP
	MOV	FCB,CIKL
	MOV	FCB,LIMIT
	MOV	FCB,LENT
	CLR	STRREG
	MOV	#MAG,R0
	MOV	#3,(R0)+
	MOV	#TEXT,(R0)+
	MOV	FCB,@R0
	SUB	#TEXT,(R0)+
	CALL	CAS1
	MOV	#MAG+26,R3
	MOV	(R3)+,R2
	MOV	@R3,R0
	MOV	#TEXT,R3
	ADD	R3,R0
	SUB	R2,R3
	MOV	FCB,R2
	MOV	R2,R4
	SUB	-(R0),R4
5$:	MOV	-(R0),-(R2)
	MOV	-(R0),-(R2)
	ADD	R3,@R2
	MOV	-(R0),-(R2)
	CMP	R2,R4
	BHI	5$
	MOV	R0,ENDCOD
	MOV	R0,TXEND
	MOV	R2,LENT
	MOV	R2,LIMIT
	MOV	R2,CIKL
	MOV	R4,TABTOP
	BR	ST
;
CSAVE1:
	MOV	#MAG,R0
	MOV	#2,(R0)+
	MOV	#TEXT,(R0)+
	CALL	GRBCOL
	MOV	R1,R5
	MOV	TABTOP,R4
	MOV	R5,@R0
	SUB	#TEXT-2,(R0)+
	MOV	@PC,ERRS
7$:	MOV	(R4)+,(R5)+
	CMP	R4,FCB
	BLO	7$
	MOV	R4,@R5
	SUB	TABTOP,(R5)
	MOV	#MAG,R1
	ADD	(R5)+,4(R1)
	CALL	IRPS
	CALL	ATSTAB
	BR	ST
;
CAS1:	MOV	#MAG,R1
	CALL	IRPS
	RETURN
    .IFTF
;TRP:	MOV	#IRPS2-10,@#BREAKW
;	MOVB	#4,@#MAG+1
;	BR	IRPS2
IRPS::				; IRPS: обмен через последовательный интерфейс ИРПС (префикс TT:) по блоку параметров магнитофона MAG
    .IFT
	BIC	#100,@#IRPSRG
    .IFTF
;	MOV	#TRP,@#BREAKW
	BIS	#100,@#177660	; разрешить прерывание клавиатуры
	MOV	R0,-(SP)
	MOV	R1,-(SP)
	MOV	R2,-(SP)
	MOV	R3,-(SP)
;	MOV	R4,-(SP)
	MOV	R5,-(SP)
;	MOV	SP,R4
	CLR	R5
	MOVB	@#IRPSRG+2,R0
	MOVB	(R1)+,R0	; имя/заголовок
	CALL	ISVT
	CALL	IVT
	MOV	R1,R2
	ADD	#5,R2
	MOV	#12,R3
1$:	MOVB	(R2)+,R0
	CALL	ISVT
	SOB	R3,1$
	MOV	#4,R3
	CALL	IVT
	MOVB	R0,(R1)+
	BNE	IRPS2
	CMPB	-2(R1),#3
	BLO	6$		;BK->TT
	ADD	#6,R2
10$:				;CLR	@#MSTART	;TT->BK
	CALL	IVT
	MOVB	R0,(R2)+
	SOB	R3,10$
	MOV	-(R2),R3
;	MOV	R3,@#MLEN
	BEQ	IRPS2
	TST	@R1
	BEQ	11$
	MOV	@R1,R2
	BR	4$
11$:	MOV	-(R2),R2
	MOV	R2,@#MSTART
4$:	CALL	IVT
	MOVB	R0,(R2)+
	ADD	R0,R5
	SOB	R3,4$
	BR	3$
;
6$:	MOVB	(R1)+,R0
	CALL	ISVT
	SOB	R3,6$
	MOV	-(R1),R3
;	BEQ	IRPS2
	MOV	-(R1),R2
7$:	MOVB	(R2)+,R0
	CALL	ISVT
	ADD	R0,R5
	SOB	R3,7$
3$:	CALL	IVT
	CMPB	R0,R5
	BEQ	12$
	MOVB	#2,-(R1)
12$:	MOV	R5,R0
	CALL	ISVT
IRPS2::	MOV	#MAG+32,R2
	MOV	#MAG+6,R1
	MOV	#10,R3
16$:	MOV	(R1)+,(R2)+
	SOB	R3,16$
;	MOV	R4,SP
	MOV	(SP)+,R5
;	MOV	(SP)+,R4
	MOV	(SP)+,R3
	MOV	(SP)+,R2
	MOV	(SP)+,R1
	MOV	(SP)+,R0
	CLR	@#177660
    .IFT
	BIS	#100,@#IRPSRG
    .IFTF
	RETURN
;
IVT:	TSTB	@#IRPSRG	; IVT: принять байт из ИРПС
	BPL	IVT
	MOVB	@#IRPSRG+2,R0
	RETURN
ISVT:	TSTB	@#IRPSRG+4	; ISVT: передать байт в ИРПС
	BPL	ISVT
	MOVB	R0,@#IRPSRG+6
	RETURN
;
    .IFT
NET:	BIS	#100,@#177660
SHO:	MOV	#TRTR,@#IRPSW
	MOV	#ISVT,EKRHUK
	BR	GR
TRTR:
	MOV	R0,-(SP)
	MOVB	@#IRPSRG+2,R0
	CMPB	R0,#6
	BEQ	BG
	MOVB	R0,@#104
	MOVB	R0,@#105
	MOV	@#TSTCHR,R0
	BEQ	GR
	CALL	@R0
GR:	MOV	(SP)+,R0
	RTI
BG:
	CLR	@#IRPSRG+4
	MOV	#IRPS1,@#IRPSW
	BIC	#100,@#177660
	CLR	EKRHUK
	BR	GR
COPY:
	MOV	#40000,COPPNT
	MOV	#CPTR,@#IRPSW+4
	BIS	#100,@#IRPSRG+4
	MOVB	@#177664,@#IRPSRG+6
	BR	SHO
CPTR:	CMP	COPPNT,#40000
	BLO	1$
	MOVB	@COPPNT,@#IRPSRG+6
2$:	INC	COPPNT
	CMP	COPPNT,#100000
	BLO	3$
	MOV	#37777,COPPNT
3$:	RTI
1$:	MOVB	@#177664,@#IRPSRG+6
	BR	2$
    .ENDC
    .IFT
