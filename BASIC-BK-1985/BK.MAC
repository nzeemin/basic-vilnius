	MOV	(SP)+,R1
	BIT	#7,R5
	BNE	51$
	JMP	PIJ
21$:	CMP	R3,#BUF		; возврат строки (23)
	BNE	49$
	TST	LYGIS
	BMI	49$
	JMP	BC
49$:	MOVB	#10,R0		;wozwrat stroki
41$:	CMP	#BUF,R1
	BEQ	48$
	EMT	16
	DEC	R1
	BR	41$
26$:	CMP	R1,R3		;СМЫКАНИЕ СТРОКИ
	BEQ	48$
	BR	42$
3$:	CMP	R3,R1		;konec ~teniq stroki
	BEQ	53$
	CMP	-(SP),-(SP)
	CALL	PELING
40$:
    .IF	EQ,KONTYP-KLAS
	CALL	ISV
    .IFF
	EMT	16
    .IFTF
	DEC	R5
	BGE	40$
	CMP	(SP)+,(SP)+
	BR	54$
53$:
    .IFT
	CALL	ISV
    .IFF
	EMT	16
    .ENDC
