	BEQ	18$
	CMP	#BUF,R1
	BEQ	18$
	DEC	R1
	INC	R2
12$:	DECB	TABX
	DECB	TABX
	CALL	KISV
	BR	23$
8$:	CMP	R3,#BUF		;wozwrat stroki
	BNE	180$
	JMP	BC
180$:	MOVB	#32,R0
9$:	CMP	R1,#BUF
	BEQ	23$
	DEC	TABX
	DEC	TABX
	CALL	KISV
	DEC	R1
	INC	R2
	BR	9$
15$:	DEC	TABX		;sbros konca stroki
	CALL	KISV
	MOV	R1,R3
26$:	JMP	PIJ
33$:	MOVB	#31,R0		;gorizontalxnaq tabulqciq
	CMP	R1,R3
	BLO	34$
	MOVB	#40,R0
	INC	R3
	DEC	R2
	BLE	24$
34$:	INC	R1
	CALL	KISV
	BITB	#111,TABX
	BNE	33$
	JMP	PIJ
