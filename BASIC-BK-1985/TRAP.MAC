.ENABLE	LC
.GLOBL	DFRE,IFRE,$FRE,DLOCX,SLOCX,ILOCX,DLOCY,SLOCY,ILOCY
.GLOBL	FRE,SFRE,PEEK,LEN,INP,LOCX,LOCY,EOF	;INSTR
.GLOBL	ASC,VAL,SUM,SKIRT,SAND,POINT	;INSTR2
.GLOBL	LPOS,ILPOS,DLPOS,SLPOS
.GLOBL	$DADD$,$DSUB$,TMP,TSTSQZ
.GLOBL	$DDIV$,$DMUL$
.GLOBL	PI,RAN,$B91,$B93,$B95,$TAN,$B97,$B99
.GLOBL	$B103,$INT,$FIX,ABS,IABS,ISGN,DSGN,SSGN
.GLOBL	ISVEIL,NUMBER,ATLIN1,LNUM,ISV,DI,ID,SI,SD,IS,DS
.GLOBL	SEPAP,DVAR,SVAR,IVAR,DCONST,SCONST,ICONST
.GLOBL	APLMI,ADGDL,INEG,NEG,PACK,ADRHLT,AFUN,IRPS2,BREAK,BREAKW
.GLOBL	TABTOP,LENT,STAR,LYGIS,ERRS,SETST,DATINP,SAVJMP
.GLOBL	INDEX,ARRAY,ARR10,$USR,ISTR,DSTR,SSTR,BIN,OCT,HEX
.GLOBL	DXVAR,SXVAR,IXVAR,$XVAR,DCMP,SCMP,ICMP,$CMP,NOT,ADLOG,ADDRBR
.GLOBL	ATCONV,MOD,IDIV,$B103,$DMUL$,$B99,POW,BUFOUT
.GLOBL	FCB,INKEY,NEWSTR,CURLIN,STRREG,I1,TYPE,CIKL,STACK,LIMIT
.GLOBL	STR,STR2,IODEV,CONCAT,CHR,ALLSM,ALLSK	;SIGNAL
.GLOBL	FNST,FNCALL,DPAR,SPAR,IPAR,APAR,PFACT	;APRL
; TRAP – обработчик программных прерываний (инструкции TRAP).
; Используется для вызова встроенных функций и операторов языка BASIC.
; Вектор прерывания (34) устанавливается в MONIT.MAC.
; При вызове TRAP процессор сохраняет в стеке: PSW, затем PC (адрес следующей инструкции).
; В нашем случае после TRAP обычно следует слово с номером функции.
TRAP::	MOV	R0,-(SP)	; сохранить R0
	MOV	R2,-(SP)	; сохранить R2
	MOV	4(SP),R0	; R0 = адрес инструкции после TRAP
	MOV	-2(R0),R2	; R2 = код инструкции TRAP
	BIC	#177400,R2	; оставить младшие 8 бит - номер TRAP
	SUB	#100,R2		; вычесть 64.
	BLT	ERROR		; если номер < 100, то этот TRAP сообщает об ошибке
	ASL	R2		; умножить на 2
	CALL	@ATRAP(R2)	; вызвать подпрограмму из таблицы ATRAP
	MOV	R0,4(SP)	; записать (возможно изменённый Tnnn) R0 как адрес возврата -
				; так Tnnn может пропустить N слов кода после TRAP N у вызывающего
TREND:	MOV	(SP)+,R2	; восстановить R2
	MOV	(SP)+,R0	; восстановить R0
	RTI			; возврат из прерывания (восстанавливает PSW и PC)
;
; ERROR - общий обработчик ошибок. Входит из TRAP::, если номер TRAP меньше
; 100: такой TRAP - не вызов подпрограммы, а код ошибки (R2 = номер-100).
; Печатает "ОШИБКА n", затем в зависимости от режима LYGIS: монитор (0),
; выполнение программы (<0, см. RUNERR) или режим с номером строки в NUMBER.
ERROR:	CLR	IODEV		; вывод сообщения - на экран (не на устройство программы)
	MOV	R2,R5		; R5 = код ошибки
	ADD	#100,R5		; (TRAP N с N < 100: номер TRAP и есть код ошибки)
;	MOV	#400,R1
;	MOV	#24,R2
;	CALL	SIGNAL
	MOV	#ERR,R1		; R1 = текст "ОШИБКА " (КОИ-8, последний байт 7 - звонок)
	MOV	#10,R2		; R2 = длина текста, 8 байт
	CALL	ISVEIL		; вывести текст
;	MOV	#400,R1
;	MOV	#37,R2
;	CALL	SIGNAL
	MOV	R5,R2		; R2 = код ошибки (для TRAP 114)
	TRAP	114		;KEICIA R1,R3,R5(R4 NE) (меняет R1,R3,R5; R4 не меняет); вывести число R5
	TST	LYGIS
	BEQ	MONERR		; LYGIS=0 - прямой режим (программа не выполняется) =>
	BMI	RUNERR		; LYGIS<0 - ошибка во время выполнения программы =>
	TSTB	LYGIS		; LYGIS: младший байт 0 (напр. #400 - прямой оператор) - как в мониторе =>
	BEQ	MONERR
	MOV	@PC,ERRS	; ERRS := ненулевое (читается слово смещения самой инструкции) - запрет выполнения программы
	MOV	NUMBER,R5	; R5 = NUMBER - номер строки, при работе с которой возникла ошибка (LIST, перенумерация)
	MOV	R5,CURLIN	; сделать её текущей строкой
	CALL	ATLIN1		; вывести " В СТРОКЕ n"
	TSTB	LYGIS		; режим #200 (перенумерация строк, MONIT.MAC)?
	BMI	TREND		; => вернуться как обычно (RTI)
	BR	COMERR		; иначе (напр. LIST, LYGIS=1) - в монитор =>
; Ошибка во время выполнения программы (LYGIS<0). Если это ошибка 13 при вводе
; с клавиатуры (INPUT, DATINP=0) - повторить ввод (GETERR). Иначе определить
; строку программы, в которой произошла ошибка, и вернуться в монитор.
; SAVJMP - адрес кода оператора INPUT/READ/USEROM, запомненный перед
; выполнением (в R4 к этому моменту уже не он).
RUNERR:	CMPB	R2,#13.		; ошибка 13 (ошибка при вводе значения)?
	BNE	10$		; нет =>
	TST	DATINP		; ввод с клавиатуры (не READ и не файл)?
	BEQ	GETERR		; да - вернуться и повторить ввод =>
10$:	TST	SAVJMP		; запомнен адрес оператора ввода?
	BEQ	1$		; нет - R4 уже указывает в код программы =>
	MOV	SAVJMP,R4	; да - R4 = адрес оператора, вызвавшего ошибку
	CLR	SAVJMP		; использовать только один раз
1$:	CMP	R4,STRREG	; адрес внутри кода программы?
	BHI	MONERR		; нет (выше области кода) - просто в монитор =>
	JSR	R2,SEPAP	; снять точки останова (STEP/TRON) и сбросить стек интерпретатора
	MOV	#IRPS2-10,@#BREAKW	; вернуть вектор клавиши СТОП в исходное состояние
	CALL	LNUM		; R2 = номер строки программы по адресу в R4
	MOV	R2,CURLIN	; сделать её текущей строкой (CURLIN)
;	CMP	-(4),-(4)
;	JSR	R0,SETST
;	BR	2$
	CLR	ADRHLT		; ADRHLT := 0 - продолжить выполнение командой CONT нельзя
;	BR	3$
;2$:	MOV	@R4,ADRHLT
3$:	CLR	LYGIS		; LYGIS := 0 - перейти в прямой режим
	MOV	#BREAK,@#BREAKW	; восстановить обработчик клавиши СТОП
	BR	COMERR
; Ошибка в прямом режиме (не в программе): вывести перевод строки и вернуться
; в основной цикл монитора (приглашение OK).
MONERR::MOV	#12,R0		; #12 = LF (перевод строки)
	CALL	ISV		; вывести символ
COMERR:	MOV	#STACK,SP	; сбросить стек
COMER2:	JMP	STAR
; Ошибка при INPUT: вывести перевод строки и вернуться в прерванную
; программу (не сбрасывая её), чтобы повторить ввод.
GETERR:	MOV	#12,R0		; #12 = LF (перевод строки)
	CALL	ISV		; вывести символ
	BR	TREND		; вернуться в программу (см. TRAP::)
;
ERR:	.BYTE	357,373,351,342,353,341,40,7
	.EVEN
;
; Таблица адресов обработчика TRAP
ATRAP:	.WORD	T100		; парсинг выражения
	.WORD	T101		; сравнение символа со списком вариантов
	.WORD	T102		; классификация символа: буква/цифра/иначе
	.WORD	T103		; ссылка на переменную/элемент массива
	.WORD	T104		; поиск/создание переменной в таблице
	.WORD	T105		; разбор имени: функция или переменная (4 варианта возврата, см. T105)
	.WORD	T106		; конец оператора
	.WORD	T107		; имя переменной: строковая - без пропуска, числовая - с пропуском слова
	.WORD	T110		; разбор номера строки
	.WORD	T111		; поиск номера строки в таблице строк программы
	.WORD	T112		; пропуск пробелов
	.WORD	T113		; сравнение с ключевым словом (со списком слов)
	.WORD	T114		; вывод числа R5 в десятичном виде (ERROR, ATLIN1)
	.WORD	T115		; разбор строкового аргумента (имя файла и т.п.)
	.WORD	T116		; необязательный аргумент через запятую (",выражение")
	.WORD	T117		; пропуск цифр с одной десятичной точкой (мантисса числа)
	.WORD	T120		; строковый литерал в кавычках?
	.WORD	T121		; параметр DEF FN (если имя совпадает)?
	.WORD	T122		; строковое выражение, за которым не следует знак отношения?
	.WORD	T123		; три целых выражения через запятую
	.WORD	T124		; два целых выражения через запятую
	.WORD	T125		; одно целое выражение
	.WORD	T126		; обязательная запятая
	.WORD	T127		; (
	.WORD	T130		; )
;
RWMOD:	.ASCII	/MOD /
RWLOG:	.ASCII	/NOT IMP EQV XOR OR AND /
FUN:	.ASCII	/PI POINT INP PEEK /
	.ASCII	/RND SQR SIN COS TAN ATN /
	.ASCII	/EXP LOG INT FIX ABS SGN CINT CDBL CSNG /
	.ASCII	/EOF CSRLIN POS LPOS FRE LEN ASC VAL /
;	.ASCII	/INSTR VARPTR /
	.ASCII	/USR FN /
SFUN:	.ASCII	/INKEY MID STRING STR CHR BIN OCT HEX /
RELAT:	.BYTE	'=,'>,'<,0
PLMI::	.BYTE	'+,'-,0
DGDL:	.BYTE	'/,'*,0
PRSPEC::.BYTE	'"
SPECHR:	.BYTE	'&,'.,'(,0
TYPBOH:	.BYTE	'B,'O,'H,0
TYPCHR:	.BYTE	'$,'!,'#,'%,0
	.EVEN
;
; T100 - разбор выражения (результат в коде по R1; его тип остаётся в TYPE).
; Низший уровень: логические операции IMP, EQV, XOR, OR, AND, разбираются по
; приоритетам: ожидающие операции хранятся на стеке (их уровни R5 = 2*номер
; операции, на дне -1), операнды разбирает SANT.
T100:	MOV	#-1,R5		; R5 = -1 - уровень "дна" стека ожидающих операций
1$:	MOV	R5,-(SP)	; запомнить уровень ожидающей операции
	CALL	SANT		; уровень отношений
	TRAP	113		; ключевое слово AND/OR/XOR/IMP/EQV?
	.WORD	RWLOG+4		; таблица "IMP EQV XOR OR AND "
	.BYTE	3,10		; режим 3 (без сокращений); искать до слова AND (R5 до 10); найдено: R5 = 2*номер = приоритет (IMP 0, EQV 2, XOR 4, OR 6, AND 10)
	BR	4$		; нет - выражение окончено =>
	CALL	CINT		; левый операнд привести к целому
2$:	CMP	R5,@SP		; приоритет новой операции выше ожидающей?
	BGT	1$		; да - сначала разобрать её правый операнд (ожидающая остаётся на стеке) =>
	MOV	(SP)+,R2	; нет - снять ожидающую операцию (R2 = её приоритет)
	MOV	ADLOG(R2),(R1)+	; вставить опкод ожидающей операции
	BR	2$		; и сравнить новую операцию со следующей ожидающей =>
3$:	CALL	CINT		; правый операнд привести к целому
	MOV	ADLOG(R2),(R1)+	; опкод логической операции (см. ADLOG)
4$:	MOV	(SP)+,R2	; снять ожидающую операцию; -1 - дно стека
	BGE	3$		; не дно - вставить её опкод =>
	RETURN
;
; SANT - уровень отношений: [NOT] сумма [знак отношения сумма ...]. Строки
; сравниваются отдельной веткой (TRAP 115, опкод $CMP), числа приводятся к
; общему типу и сравниваются опкодом ICMP/DCMP/SCMP (таблица ACMP).
SANT:	TRAP	112		; пропуск пробелов
	CLR	-(SP)		; флаг NOT: 0 - NOT есть, 1 - нет
	TRAP	113		; ведущее NOT?
	.WORD	RWLOG,3		; только слово NOT (R5 до 0), без сокращений
	INC	@SP		; NOT не найден - флаг = 1
	MOV	TMP,-(SP)	; запомнить TMP (учёт временных строк)
	TRAP	115		; левый операнд - строковое выражение?
	BR	1$		; нет - обычное выражение =>
	CALL	LYGOP		; прочитать знак отношения
	BCS	10$		; знака нет (LYGOP сделала COM - перенос) - ошибка =>
	TRAP	115		; разобрать правый строковый операнд
10$:	TRAP	13.		; ошибка 13 - несоответствие типов
	MOV	(SP)+,TMP	; восстановить TMP
	MOV	#$CMP,(R1)+	; опкод сравнения строк
	BR	7$		; => вставить опкод конкретного отношения
1$:	TST	(SP)+		; не строка - снять сохранённый TMP
	CALL	SUDAT		; левый операнд - сумма
2$:	CALL	LYGOP		; есть ли знак отношения (=,<>,<,>,<=,>=)?
	BMI	8$		; нет =>
	MOV	R2,-(SP)	; запомнить знак отношения,
	MOV	R1,-(SP)	; позицию в коде после левого операнда
	MOV	TYPE,-(SP)	; и тип левого операнда
	CALL	SUDAT		; разобрать правый операнд (сумму)
	MOVB	TYPE,R5		; R5 = тип правого операнда
	CMPB	R5,@SP		; типы операндов одинаковы?
	BEQ	5$		; да =>
	BHI	4$		; тип правого "старше" левого (беззнаковое сравнение) =>
	MOV	@SP,TYPE	; иначе приводится левый операнд к типу правого (TYPE пока = тип левого); новый конец кода
	MOV	R1,R4
	TST	(R4)+		; (на слово больше) запомнить
	MOV	R4,@SP
3$:	MOV	-(R1),-(R4)	; сдвинуть код правого операнда на слово вверх
	CMP	R1,2(SP)
	BHI	3$
	INC	R5		; R5 = тип правого, преобразование к нему - в таблице ATCONV
	ASL	R5
	CALL	@ATCONV(R5)	; вставить в освободившееся место опкод преобразования
	MOV	@SP,R1		; R1 = новый конец кода
	BR	6$
4$:	MOVB	@SP,R5		; тип правого "старше": привести правый операнд (на стеке) к типу левого
	INC	R5
	ASL	R5
	CALL	@ATCONV(R5)
	BR	6$
5$:	INC	R5		; тип один: -1, 0, 1 -> 0, 2, 4 - индекс в таблице ACMP
	ASL	R5
6$:	MOV	ACMP(R5),(R1)+	; вставить опкод сравнения нужного типа
	CMP	(SP)+,(SP)+	; снять тип и позицию кода
	MOV	(SP)+,R2	; R2 = знак отношения
7$:	MOV	#377,TYPE	; результат сравнения - целое
	MOV	ADDRBR (R2),(R1)+	; опкод конкретного отношения (см. ADDRBR)
	BR	2$		; проверить, нет ли следующего отношения =>
8$:	TST	(SP)+		; снять флаг NOT
	BNE	9$		; NOT не было - ничего не добавлять =>
	CALL	CINT		; операнд привести к целому
	MOV	#NOT,(R1)+	; опкод NOT
9$:	RETURN
;
ACMP:	.WORD	ICMP,	DCMP,	SCMP
;
; LYGOP - разобрать знак отношения (=,<>,<,>,<=,>=), индекс в R2 (см. ADDRBR).
; Пробует один символ (=,>,<) через RELAT; если это начало двухсимвольного
; знака (<=,>=,<>) - смотрит второй символ тем же способом и объединяет оба
; совпадения в итоговый индекс R2. Если первого символа не нашлось - R4
; получает отрицательное значение (COM отрицательного -2), сообщая
; вызывающему (SANT: BMI), что знака отношения нет.
LYGOP:	TRAP	101		; первый символ - один из =,>,<?
	.WORD	RELAT
	BR	1$		; нет =>
	MOV	R4,R2		; да - R2 = индекс первого символа
	TRAP	101		; второй символ - тоже один из =,>,<?
	.WORD	RELAT
	RETURN			; нет - однознаковое отношение (R2 уже готов)
	CMP	R4,R2		; да - совпал с тем же символом (напр. "<<")?
	BEQ	2$		; да - недопустимо =>
	CMP	(R4)+,(R4)+
	ADD	R4,R2		; объединить оба индекса в итоговый (двухсимвольный знак)
	RETURN
1$:	COM	R4		; символа отношения нет - R4 положительный (см. SANT: BMI)
	RETURN
2$:	TRAP	2		; ошибка синтаксиса
;
; SUDAT - уровень сложения/вычитания: сумма слагаемых уровня LIEK (MOD).
SUDAT:	CALL	LIEK
3$:	TRAP	101		; следующий символ '+' или '-'?
	.WORD	PLMI
	RETURN			; нет - выражение окончено
	MOV	TYPE,-(SP)	; запомнить тип левого операнда
	MOV	R4,-(SP)	; и знак операции (R4 = 0 для '+', 2 для '-')
	CALL	CDBL		; левый операнд в двойную точность (целому вставляется преобразование ID)
	MOV	R1,-(SP)	; запомнить конец кода левого операнда
	CALL	LIEK		; разобрать правый операнд
	MOV	(SP)+,R4	; R4 = конец кода левого операнда
	MOV	(SP)+,R2	; R2 = знак операции
	TSTB	TYPE		; правый операнд целый?
	BPL	1$		; нет =>
	TSTB	@SP		; левый операнд целый?
	BPL	1$		; нет =>
	CALL	SUSP		; оба целые: убрать вставленное преобразование (код правого сдвигается на слово вниз)
	CMP	(R2)+,(R2)+	; R2 += 4 - целочисленный вариант в APLMI (SUM, SKIRT)
	BR	2$
1$:	CALL	CDBL		; один из операндов не целый: правый тоже в двойную точность
2$:	MOV	APLMI(R2),(R1)+	; вставить опкод сложения/вычитания (APLMI)
	TST	(SP)+		; снять тип левого операнда
	BR	3$		; следующая операция +/- =>
;
; LIEK - оператор MOD (остаток от деления целых).
LIEK:	CALL	SDAL
1$:	TRAP	113		; ключевое слово MOD?
	.WORD	RWMOD
	.WORD	3
	RETURN			; нет =>
	CALL	CINT		; левый операнд привести к целому
	CALL	SDAL		; правый операнд
	CALL	CINT		; привести к целому
	MOV	#MOD,(R1)+	; опкод MOD
	BR	1$
;
; SDAL - оператор \ (целочисленное деление).
SDAL:	CALL	DAUG
1$:	CMPB	@R3,#'\		; символ '\'?
	BNE	D3		; нет =>
	INC	R3		; съесть '\'
	CALL	CINT		; левый операнд привести к целому
	CALL	DAUG1		; правый операнд (унарный знак не допускается)
	CALL	CINT		; привести к целому
	MOV	#IDIV,(R1)+	; опкод IDIV
	BR	1$
;
; DAUG - унарный знак и умножение/деление *,/ (уровень LAIPS - возведение в степень).
DAUG:	CLR	-(SP)		; знак = 0 (нет знака или '+')
	TRAP	101		; ведущий '+' или '-'?
	.WORD	PLMI
	BR	DAUG2		; нет =>
	MOV	R4,@SP		; знак = 2 для '-'
	BR	DAUG2
DAUG1:	CLR	-(SP)
DAUG2:	CALL	LAIPS		; операнд
	TST	(SP)+		; снять знак: 0 - смену знака не вставлять
	BEQ	D2		; =>
	TSTB	TYPE		; операнд целый?
	BPL	D1		; нет - NEG =>
	MOV	#INEG,(R1)+	; опкод INEG (смена знака, целое)
	BR	D2
D1:	MOV	#NEG,(R1)+	; опкод NEG (смена знака, вещественное)
D2:	TRAP	101		; символ '*' или '/'?
	.WORD	DGDL
D3:	RETURN			; нет =>
	MOV	TYPE,-(SP)	; запомнить тип левого операнда
	MOV	R4,-(SP)	; и знак операции (R4 = 0 для '/', 2 для '*')
	CALL	CDBL		; левый операнд в двойную точность
	MOV	R1,-(SP)	; запомнить конец кода левого операнда
	CALL	LAIPS		; правый операнд (степень)
	MOV	(SP)+,R4	; R4 = конец кода левого операнда
	MOV	(SP)+,R2	; R2 = знак операции
	BEQ	1$		; '/' - деление всегда вещественное =>
	TSTB	TYPE		; правый операнд целый?
	BPL	1$		; нет =>
	TSTB	@SP		; левый операнд целый?
	BPL	1$		; нет =>
	CALL	SUSP		; оба целые: убрать вставленное преобразование
	TST	(R2)+		; R2 = 4 - целочисленное умножение SAND
	BR	2$
1$:	CALL	CDBL		; правый операнд в двойную точность
2$:	MOV	ADGDL(R2),(R1)+	; опкод умножения/деления (см. ADGDL)
	TST	(SP)+		; снять тип левого операнда
	BR	D2		; следующая операция * или / =>
;
; LAIPS - оператор ^ (возведение в степень).
LAIPS:	CALL	OPER
1$:	CMPB	(R3),#'^	; символ '^'?
	BNE	D3		; нет =>
	INC	R3		; съесть '^'
	CALL	CDBL		; левый операнд в двойную точность
	MOV	#$B103,(R1)+	; опкод $B103 (LOG: x^y = EXP(y*LOG(x)))
	MOV	R1,-(SP)	; запомнить позицию после LOG
	CALL	OPER		; показатель степени
	MOV	(SP)+,R4	; R4 = позиция после LOG
	TSTB	TYPE		; показатель целый?
	BMI	2$		; да =>
	CALL	CDBL		; показатель в двойную точность
	MOV	#$DMUL$,(R1)+	; y*LOG(x)
	MOV	#$B99,(R1)+	;EXP
	BR	1$		; следующая операция ^ =>
2$:	CALL	SUSP		; целый показатель: убрать опкод LOG
	MOV	#POW,(R1)+	; возведение в целую степень POW
	CLR	TYPE		; результат - двойной точности
	BR	1$
;
; SUSP - стереть слово перед кодом второго операнда: код от R4 до R1 сдвигается
; вниз на слово, R1 -= 2. Так убирают опкод преобразования/LOG, который оказался
; не нужен, когда выяснился тип правого операнда.
SUSP:	MOV	R4,R5
	TST	-(R5)
3$:	MOV	(R4)+,(R5)+
	CMP	R4,R1
	BLO	3$
	TST	-(R1)
	RETURN
;
OPER:	CALL	CISLO		; разобрать число (возврат CISLO с пропуском слов, см. CISLO)
	TRAP	24.		; возврат +0: не число и не имя - ошибка 24 (;SPEC - спецсимвол)
	BR	3$		; +2: имя (переменная/функция) => (;RAIDE - буква)
	BR	2$		; +4: '(' - выражение в скобках =>
	MOV	R4,TYPE		; тип числа от CISLO: -1 целое (&-число), 0 двойной точности, 1 одинарной
	BMI	13$		; целое =>
	BEQ	11$		; двойной точности =>
	MOV	#SCONST,(R1)+	; одинарная: опкод SCONST (константа одинарной точности)
	CMP	(R1)+,(R1)+	; место под 2 слова значения
	MOV	R1,R4		; R4 = конец кода
	BR	12$		; значение со стека =>
11$:	MOV	#DCONST,(R1)+	; двойная: опкод DCONST (константа двойной точности)
	ADD	#10,R1		; место под 4 слова значения
	MOV	R1,R4		; R4 = конец кода
	MOV	(SP)+,-(R4)	; перенести значение со стека в код (с конца)
	MOV	(SP)+,-(R4)
12$:	MOV	(SP)+,-(R4)	; (одинарная начинает здесь) оставшиеся 2 слова
	MOV	(SP)+,-(R4)
	RETURN			; число скомпилировано
13$:	MOV	#ICONST,(R1)+	; опкод ICONST (целая константа)
	MOV	R5,(R1)+	; значение
	CLRB	TYPE+1		; старший байт TYPE = 0
	RETURN			; число скомпилировано
2$:	JMP	OP2		; => разбор "(выражение)"
3$:	TRAP	105		; разобрать имя (+ тип), сравнить со списком встроенных функций
	BR	31$		; совпало с именем функции =>
	TRAP	13.
	TRAP	13.
	CLR	R4
	TRAP	121		; обычная переменная - проверки типа/массива
	TRAP	103		; скомпилировать ссылку на переменную/элемент массива
30$:	RETURN
31$:	CMP	R5,#66		; R5 = 2*номер слова таблицы FUN; USR и FN (>= 66 окт.) - отдельная ветка
	BLT	4$		; простая встроенная функция одного аргумента =>
;	BEQ	34$	;VARPTR
	MOV	TMP,-(SP)	; запомнить TMP
	CALL	USR		; разобрать вызов USR или FN
	BMI	32$		; признак ошибки =>
	MOV	(SP)+,TMP	; восстановить TMP
	RETURN
32$:	TRAP	13.		; ошибка 13 - несоответствие типов
;33$:	TRAP	5
;34$:	TRAP	127	;VARPTR
;	CLR	R4
;	TRAP	107
;	NOP
;	TST	R5
;	BEQ	33$
;	MOV	#377,TYPE
;	TSTB	R5
;	BMI	35$
;	MOV	#ICONST,(1)+
;	MOV	R4,(1)+
;35$:	JMP	OP3
; Разбор встроенной функции с индексом R5 (R5 = 2*номер слова в таблице FUN).
; Дальше - ветки по группам индексов: функции без аргументов, числовые,
; строковые (LEN, ASC, VAL), USR/FN. Подробности разбора аргументов выяснены
; не до конца.
4$:	MOV	R5,-(SP)	; запомнить индекс функции
	BEQ	6$		; PI (индекс 0) - без аргументов =>
	CMP	R5,#46		; слова с номерами меньше EOF - числовые функции (SURISTA SU FUNKCIJOMIS - связано с функциями) =>
	BLT	5$
	CMP	R5,#60		; (SURISTA SU FUNKCIJOMIS - связано с функциями) LEN, ASC, VAL и выше =>
	BGE	40$		; LEN, ASC, VAL (60 окт. и выше) - аргумент-строка =>
	DECB	TYPE		; TYPE -= 1 (смысл не выяснен до конца)
	CMP	R5,#46
	BEQ	6$
	CMPB	@R3,#'(		; '(' после имени?
	BNE	6$		; нет =>
	SUB	#61,R5
	ASL	R5
	ADD	R5,@SP
40$:	ADD	#32,@SP
	TRAP	127		; (
	CMP	@SP,#100	;SURISTA SU FUNKCIJOMIS
	BGT	42$
41$:	TRAP	100		; аргумент - выражение
	MOVB	TYPE,R5
	INC	R5
	SUB	R5,TYPE
	ASL	R5
	ADD	@SP,R5
	BR	46$
42$:	MOV	TMP,-(SP)
	TRAP	122
	BR	47$
	MOV	(SP)+,TMP
	CLR	TYPE
	CMP	@SP,#116
	BEQ	45$
;	BLT	44$
;	TRAP	126
;	TRAP	115
;43$:	TRAP	13.
44$:	DECB	TYPE
45$:	MOV	@SP,R5		; R5 = индекс функции
46$:	TRAP	130		; )
	BR	6$
47$:	TST	(SP)+
	ADD	#2,@SP
	CMP	@SP,#104
	BEQ	41$
;	CMP	@SP,#122
	BNE	32$
;	TRAP	125
;	TRAP	126
;	BR	42$
48$:	TRAP	124
	BR	45$
49$:	TRAP	125
	BR	45$
5$:	TRAP	127		; (
	CMP	R5,#6		; номера меньше PEEK (POINT, INP)?
	BLT	48$		; да - два целых аргумента =>
	BEQ	49$		; PEEK - одно целое =>
	TRAP	100		; остальные - числовое выражение
	TRAP	130		; )
	MOV	(SP),R5		; R5 = индекс функции
	CMP	R5,#26		; RND...LOG (до 26 окт.) - вычисляются в двойной точности =>
	BLE	52$
	MOVB	TYPE,R4		; R4 = 2*(TYPE+1): 0 - целое, 2 - двойная, 4 - одинарная
	INC	R4
	ASL	R4
	CMP	R5,#36		; CINT, CDBL, CSNG (выше SGN) =>
	BGT	7$		;CSNG,CINT
	BEQ	51$		; SGN =>
	CMP	R5,#34
	BEQ	50$		;ABS
	TST	R4		;INT,FIX
	BNE	52$		; нет - вычислить в двойной точности =>
	BR	60$		; да - для целого ничего не вставлять =>
50$:	TST	R4
	BNE	6$		; не целое - опкод по индексу R5 =>
51$:	TST	(R4)+		; целое: R4 = 2
	ADD	R4,R5		; R5 += 2 - целочисленный вариант функции (IABS, ISGN) в AFUN
	BR	6$
52$:	CALL	CDBL		; аргумент в двойную точность
6$:	MOV	AFUN(R5),(R1)+	; вставить опкод функции (таблица AFUN)
60$:	TST	(SP)+		; снять индекс функции
	RETURN
7$:	SUB	#40,R5		; CINT/CDBL/CSNG: R5 = номер преобразования
	CALL	@ATCONV(R5)	; вставить опкод преобразования
	BR	60$
; OP2 - "(выражение)": разобрать вложенное выражение целиком и проверить ')'.
OP2:	TRAP	100		; разобрать выражение внутри скобок
T130:
OP3:	CMPB	(R3)+,#')	; ')' на месте?
	BEQ	SKLUZ		; да - пропустить пробелы и вернуться =>
OP4:	TRAP	2		; нет - ошибка синтаксиса
;
T127:	TRAP	112		; пропуск пробелов
	CMPB	(R3)+,#'(	; '(' на месте?
	BNE	OP4		; нет - ошибка синтаксиса
SKLUZ:	TRAP	112		; пропуск пробелов
	RETURN
;
; Типы выражений на БК: байт TYPE = -1 - целое (1 слово), 0 - двойной точности
; (4 слова), 1 - одинарной (2 слова). CINT/CSNG/CDBL приводят тип только что
; скомпилированного операнда к нужному, вставляя в код опкод преобразования
; (имена опкодов XY: X - исходный тип, Y - целевой; I целое, S одинарная, D двойная).
CINT::	MOVB	TYPE,R4		; R4 = тип (байт TYPE): -1 целое, 0 двойной точности, 1 одинарной
	BLT	1$		; уже целое => (TYPE < 0)
	ASL	R4		; R4 = 0 (двойная) или 2 (одинарная) - индекс в ACINT
	MOV	ACINT(R4),(R1)+	; вставить в код опкод преобразования DI или SI
	MOV	#377,TYPE	; TYPE = -1 (целое); слово #377, байт TYPE читается как -1
1$:	RETURN
;
CSNG::	MOVB	TYPE,R4		; R4 = тип (байт TYPE)
	BGT	1$		; уже одинарной точности =>
	INC	R4		; целое (-1) -> 0, двойная (0) -> 1
	ASL	R4		; R4 = 0 или 2 - индекс в ACSNG
	MOV	ACSNG(R4),(R1)+	; вставить опкод преобразования IS или DS
	MOV	#1,TYPE		; TYPE = 1 (одинарная точность)
1$:	RETURN
;
CDBL::	MOVB	TYPE,R4		; R4 = тип (байт TYPE)
	BEQ	1$		; уже двойной точности =>
	INC	R4		; целое (-1) -> 0, одинарная (1) -> 2: индекс в ACDBL
	MOV	ACDBL(R4),(R1)+	; вставить опкод преобразования ID или SD
	CLR	TYPE		; TYPE = 0 (двойная точность)
1$:	RETURN
;
ACDBL:	.WORD	ID,SD		; опкоды преобразования в двойную: из целого, из одинарной
ACSNG:	.WORD	IS,DS		; опкоды преобразования в одинарную: из целого, из двойной
ACINT:	.WORD	DI,SI		; опкоды преобразования в целое: из двойной, из одинарной
ABOH:	.WORD	CBIN,COCT,CHEX	; разбор чисел &B, &O, &H: двоичные, восьмеричные, шестнадцатеричные (TYPBOH)
;
CHEX:	CLR	R5		; R5 = значение числа &H
6$:	TRAP	102		; классифицировать очередной символ
	BR	C1		; не буква и не цифра - конец числа =>
	BR	7$		; буква =>
	SUB	#77,R4		; цифра: R4 = код цифры, из него ниже получается значение 0-9
8$:	ADD	#15.,R4		; (для буквы A-F: код - 'F' + 15 = 10-15)
	INC	R3		; съесть символ
	CMP	R5,#10000	; в R5 уже 4 шестнадцатеричных цифры?
	BHIS	C3		; да - переполнение (ошибка 6) =>
	ASL	R5		; R5 = R5*16
	ROL	R5
	ROL	R5
	ROL	R5
	BIS	R4,R5		; добавить цифру
	BR	6$
7$:	SUB	#'F,R4		; буква: больше 'F'?
	BLE	8$		; A-F - принять =>
C1:	RETURN
;
COCT:	CLR	R5
5$:	MOVB	@R3,R4		; R4 = очередной символ
	SUB	#60,R4		; в значение цифры
	BIT	#177770,R4	; не '0'-'7' - конец числа =>
	BNE	C1		; =>
	INC	R3		; съесть символ
	ASL	R5		; R5 = R5*8; перенос из старшего бита - переполнение (ошибка 6)
	BCS	C3
	ROL	R5
	BCS	C3
	ROL	R5
	BCS	C3
	BIS	R4,R5		; добавить цифру
	BR	5$
;
CBIN:	CLR	R5		; R5 = значение числа &B
2$:	MOVB	@R3,R4		; очередной символ
	SUB	#60,R4		; в значение цифры
	ROR	R4		; C = цифра; если после сдвига не 0 - это не '0'/'1'
	BNE	C1		; конец числа =>
	INC	R3		; съесть символ
	ROL	R5		; R5 = R5*2 + цифра
	BCC	2$		; нет переполнения - дальше =>
C3:	TRAP	6		; переполнение: ошибка 6
;
;
BOHPAP::TRAP	102		; классифицировать символ после '&'
	BR	14$		; не буква =>
	BR	11$		; буква =>
14$:	MOV	4(SP),R4	; (слово со стека в R4 - назначение не выяснено до конца)
	TRAP	2		; ошибка синтаксиса
11$:	TRAP	101		; буква B, O или H?
	.WORD	TYPBOH
	BR	14$		; нет =>
	CALL	@ABOH(R4)	; разобрать цифры в выбранной системе счисления
	RETURN
;
CISLO::	MOV	(SP)+,R2	; R2 = адрес возврата (снят со стека)
	TST	(R2)+		; пропустить слово у вызывающего (там TRAP 24.)
	TRAP	101		; первый символ: '&', '.' или '('?
	.WORD	SPECHR
	BR	1$		; нет =>
	ADD	R4,PC		; переход по номеру совпавшего символа
	BR	10$		; '&' =>
	BR	13$		; '.' =>
	TST	(R2)+		; '(' - это не число: возврат с пропуском двух слов (в OPER - BR 2$)
	MOV	R2,PC		; вернуться
10$:	CALL	BOHPAP		; &B, &O или &H
12$:	MOV	#-1,R4		; тип результата -1 (целое), значение в R5
15$:	CMP	(R2)+,(R2)+	; возврат с пропуском трёх слов: число получено
	MOV	R2,PC		; вернуться
1$:	TRAP	102		; классифицировать первый символ
	BR	16$		; не буква и не цифра =>
	MOV	R2,PC		; буква - это имя: вернуться со сдвигом +2 (в OPER - BR 3$)
	BR	2$		; цифра - число =>
16$:	TST	LYGIS		; при выполнении программы (LYGIS<0) пробовать разобрать и это как число =>
	BMI	2$
	TST	-(R2)		; при компиляции - не число: вернуться на TRAP 24. у вызывающего (операнда нет)
	MOV	R2,PC		; вернуться
13$:	DEC	R3		; '.' - вернуть точку в текст, разбор начнётся с неё
2$:	MOV	R3,-(SP)	; запомнить начало числа в тексте
	CLR	-(SP)		; слово: признак знака
	TRAP	101		; знак '+' или '-' перед числом?
	.WORD	PLMI
	NEG	R4		; (знака нет)
	MOV	R4,@SP		; запомнить признак знака
	TRAP	117		; пропустить цифры мантиссы (допускается одна точка)
	TRAP	101		; суффикс типа '!', '#' или '%'?
	.WORD	TYPCHR+1
	NEG	R4		; суффикса нет
	CMP	R4,#2		; R4: 0 - '!', 2 - '#' или без суффикса, 4 - '%'
	BLE	20$		; '!', '#' или без суффикса - вещественное число =>
	MOV	(SP)+,R4	; суффикс '%' - целое число; R4 = признак знака
	BMI	21$
	INC	@SP
21$:	MOV	(SP)+,R3	; вернуться к началу числа
	MOV	R4,-(SP)
	TRAP	110		; разобрать цифры целого в R5
	CLR	R5		; (пропускается, если цифры были)
	TRAP	117		; пропустить цифры
	INC	R3		; съесть '%'
	TST	R5		; проверка диапазона целого (-32768..32767) по знаку: за диапазоном - ошибка 6 (детали не выяснены до конца)
	BMI	24$
	TST	(SP)+
	BLE	12$
26$:	NEG	R5
	BMI	12$
	BR	27$
24$:	TST	(SP)+
	BGT	26$
27$:	TRAP	6		; переполнение: ошибка 6
20$:	MOV	R4,R5		; R5 = 0 - суффикс '!', 2 - '#' или суффикса нет
	TST	(SP)+		; снять признак знака
	MOV	@SP,R3		; R3 = начало числа в тексте
	MOV	#500,-(SP)	; параметр PACK
	CALL	PACK		; упаковать текст числа в двоичное вещественное (4 слова на стеке, FLOAT.MAC); сверху слово статуса
	CLR	R4		; тип 0 - двойная точность
	ROR	(SP)+		; C = бит 0 статуса PACK: в тексте была буква E (одинарная точность)
	BCS	23$		; да =>
	TST	R5		; R5 = 0 - суффикс '!', 2 - '#' или суффикса нет (задан до вызова PACK)
	BEQ	22$		; =>
	BMI	15$		; =>
	INC	R3		; съесть символ суффикса
	BR	15$		; двойная точность - готово =>
22$:	INC	R3		; съесть символ суффикса
23$:	ROL	4(SP)		; округлить до одинарной точности: сдвиг с переносом младших слов
	ADC	2(SP)		; (переполнение или признак V - ошибка 6)
	ADC	@SP
	BVS	27$
	BCS	27$
	MOV	(SP)+,2(SP)	; убрать два младших слова числа
	MOV	(SP)+,2(SP)
	INC	R4		; тип 1 - одинарная точность
	BR	15$		; => готово
;
; TRAP 101 - сравнить текущий символ с коротким списком однобайтовых
; вариантов. Операнд после TRAP: адрес таблицы байт-символов, оканчивающейся
; нулевым байтом (см. PLMI, RELAT, DGDL, TYPCHR, PRSPEC, TYPBOH и др.).
; При совпадении символ съедается (R3++), пропускается слово после TRAP у
; вызывающего, и R4 = номер совпавшего варианта*2 (0,2,4,...). Если совпадения
; нет - слово не пропускается, R4 = -2.
T101:	TRAP	112		; пропуск пробелов
	MOV	(R0)+,R2	; R2 = адрес таблицы символов (операнд после TRAP)
	MOV	#-2,R4		; R4 = -2 (пока ничего не совпало)
1$:	TSTB	@R2		; конец таблицы (нулевой байт)?
	BEQ	2$		; да - совпадения нет =>
	ADD	#2,R4		; R4 += 2 (номер очередного варианта)
	CMPB	(R2)+,@R3	; совпадает с текущим символом?
	BNE	1$		; нет - проверить следующий вариант =>
	INC	R3		; да - съесть символ
	TST	(R0)+		; пропустить слово-операнд у вызывающего (см. TRAP::)
2$:	RETURN
;
; MZ - текущий символ строчная буква (a-z): сделать заглавной (снять бит
; регистра) и заново классифицировать через T102.
MZ:	BICB	#40,@R3
T102:	MOVB	@R3,R4
	CMPB	R4,#172		; > 'z' ?
	BHI	2$		; да - не буква/цифра =>
	CMPB	R4,#140		; > '`' (т.е. 'a'..'z') ?
	BHI	MZ		; да - строчная буква =>
	CMPB	R4,#132		; > 'Z' (т.е. '['..'`') ?
	BHI	2$		; да - не буква/цифра =>
	CMPB	R4,#100		; > '@' (т.е. 'A'..'Z') ?
	BHI	1$		; да - заглавная буква =>
	CMPB	R4,#71		; > '9' (т.е. ':'..'@') ?
	BHI	2$		; да - не буква/цифра =>
	CMPB	R4,#60		; < '0' ?
	BLO	2$		; да - не буква/цифра =>
	TST	(R0)+		; иначе '0'..'9' - цифра: пропустить ещё слово
1$:	TST	(R0)+		; буква (или продолжение случая с цифрой): пропустить слово
2$:	RETURN
;
; TRAP 103 - скомпилировать ссылку на переменную или элемент массива (имя уже
; разобрано TRAP 105: R5 - имя, TYPE - тип). Слово имени кодирует тип: бит 15 -
; строка, бит 14 - целое, бит 13 - одинарная точность, иначе двойная; бит 7
; младшего байта - массив. После '(' разбирается список индексов (TRAP 125).
T103:	TRAP	112		; пропуск пробелов
	CLR	R2		; R2 = число индексов (0 - не массив)
	CMPB	@R3,#'(		; '(' - есть индексы (элемент массива)?
	BNE	2$		; нет - простая переменная =>
	MOV	R4,R2		; сохранить R4 на время разбора индексов
	TST	(R2)+		; (и учесть слово)
	INC	R3		; съесть '('
	MOV	TYPE,-(SP)	; запомнить тип
	MOV	R5,-(SP)	; и имя переменной
	TRAP	125		; первый индекс - целое выражение
	CLR	-(SP)		; счётчик остальных индексов
6$:	TRAP	116		; есть ещё индекс (',')?
	BR	1$		; нет =>
	INC	@SP		; да - посчитать
	CALL	CINT		; индекс привести к целому
	BR	6$
1$:	MOV	R2,R4		; вернуть R4
	MOV	(SP)+,R2	; R2 = число индексов без первого
	MOV	(SP)+,R5	; имя
	MOV	(SP)+,TYPE	; тип
	TRAP	130		; )
	BR	8$
2$:	TST	R4		; не массив?
	BEQ	7$		; простая переменная =>
8$:	BIS	#200,R5		; пометить имя как массив (бит 7 младшего байта)
	INC	R2		; R2 = число индексов
	DECB	TYPE+1		; DECB TYPE+1 - признак массива (у строки было -1, станет -2)
	BR	4$
7$:	TST	R5		; строка (бит 15 имени)?
	BMI	4$		; да =>
	TSTB	TYPE		; тип: двойная, одинарная или целое
	BEQ	5$		; двойная =>
	BPL	4$		; одинарная =>
	TST	(R4)+		; целое: к индексу R4 прибавить 2
5$:	CMP	(R4)+,(R4)+	; двойная: прибавить 4 (индекс в AKINPP)
4$:	MOV	AKINPP(R4),(R1)+	; опкод ссылки на переменную/массив (см. AKINPP)
	TRAP	104		; найти/завести переменную в таблице переменных
	MOV	R4,(R1)+	; адрес переменной
	TSTB	R5
	BPL	3$		; не массив - готово =>
	MOV	R2,(R1)+	; массив - записать число индексов
	MOV	#6,R2		; для строки индекс 6 в AXKINP
	INCB	TYPE+1		; снять признак массива из TYPE
	BMI	9$		; строка =>
	MOVB	TYPE,R2		; R2 = 2*(TYPE+1): индекс в AXKINP по типу
	INC	R2
	ASL	R2
9$:	MOV	AXKINP(R2),(R1)+	; доп. опкод вычисления адреса элемента (по типу)
3$:	RETURN
;
AKINPP:	.WORD	SVAR,	INDEX,	DVAR,IVAR
	.WORD	ARR10,	ARRAY
;
AXKINP:	.WORD	IXVAR,DXVAR,SXVAR,$XVAR
;
; Запись таблицы переменных: слово имени (тип закодирован в нём так же, как в
; T103), затем значение: целое - 1 слово, одинарная - 2, двойная - 4, строка
; и массив - 2 слова (дескриптор).
; TRAP 104 - найти переменную с именем R5 (упаковано в слово) в таблице
; переменных программы (от LENT до TABTOP); если не найдена и идёт
; компиляция - завести новую запись (расширить таблицу, LENT растёт вверх
; к TABTOP). R4 на выходе - адрес найденной/созданной записи (слова со
; значением, сразу после слова имени).
T104:	MOV	LENT,R4
1$:	CMP	R4,TABTOP	; конец таблицы?
	BHIS	2$		; да - не найдена =>
	MOV	(R4)+,R2	; R2 = слово имени записи; R4 -> значение
	CMP	R5,R2		; имя совпадает?
	BEQ	3$		; да - найдена =>
	TSTB	R2		; массив (бит 7 младшего байта имени)?
	BMI	10$		; да - значение занимает 2 слова =>
	ROL	R2		; бит 15 - строка?
	BCS	10$		; да - 2 слова =>
	BMI	11$		; бит 14 - целое: 1 слово =>
	ROL	R2		; бит 13 - одинарная?
	BMI	10$		; да - 2 слова =>
	CMP	(R4)+,(R4)+	; иначе двойная: 4 слова (2 здесь и 2 ниже)
10$:	TST	(R4)+		; пропустить слово значения
11$:	TST	(R4)+		; и ещё слово
	BR	1$		; к следующей записи =>
2$:	TST	LYGIS
	BMI	50$		; выполняется программа (не компиляция) - создавать нельзя =>
	MOV	LENT,R4		; R4 = конец таблицы переменных
	SUB	#6,R4		; вычесть 6: место под имя и два слова значения
	MOV	TYPE,R2		; R2 = тип; старший байт - признак массива
	BMI	20$		; строка или массив: имя и 2 слова =>
	TSTB	R2		; целое, одинарная или двойная?
	BEQ	22$		; двойная =>
	BGT	20$		; одинарная: имя и 2 слова =>
	TST	(R4)+		; целое: имя и 1 слово
	BR	20$		; =>
22$:	CMP	-(R4),-(R4)	; двойная: имя и 4 слова
20$:	CMP	R4,R1		; хватает памяти (не залезли на буфер кода)?
	BLOS	4$		; нет =>
	MOV	R4,LENT		; да - зафиксировать новый конец таблицы переменных
	MOV	R4,LIMIT	; граница стека кадров LIMIT
	MOV	R4,CIKL		; и CIKL - вершина стека циклов
	MOV	R5,(R4)+	; записать имя переменной
	MOV	R4,R2		; R2 -> место значения
	TST	TYPE+1		; строка или массив?
	BMI	30$		; да - обнулить 2 слова =>
	TSTB	TYPE		; тип: целое, одинарная или двойная
	BMI	33$		; целое: 1 слово =>
	BNE	30$		; одинарная: 2 слова =>
	CLR	(R2)+		; двойная: ещё два слова
	CLR	(R2)+		; обнулить
30$:	CLR	(R2)+		; обнулить слово значения
33$:	CLR	(R2)+		; и ещё одно
	TSTB	R5		; массив (бит 7 имени)?
	BPL	3$		; нет - запись готова =>
	MOVB	#2,-(R2)	; массив: в последнем слове - размер элемента в байтах (начиная с 2: целое)
	TST	R5		; строка?
	BMI	40$		; да =>
	TSTB	TYPE		; целое?
	BMI	3$		; да - 2 байта =>
	BNE	35$		; не двойная (одинарная) - один сдвиг =>
	ASLB	@R2		; двойная: два сдвига - 8 байт
35$:	ASLB	@R2		; одинарная: 4 байта
3$:	RETURN
40$:	INCB	@R2		; строка: 3 байта (упакованный дескриптор)
	RETURN
50$:	CLR	R4		; не найдена, создать нельзя - R4=0
	RETURN
4$:	TRAP	7		; не хватает памяти под переменные
;
; TRAP 105 - разобрать имя: встроенная функция или переменная. Сначала имя ищется
; через TRAP 113 в таблицах FUN и SFUN (подряд; индекс до 110 окт., граница
; между ними 72 окт.). Четыре варианта возврата (слова после TRAP у вызывающего):
;   +0 - числовая функция (R5 = индекс в таблице FUN);
;   +1 слово - строковая функция (R5 = индекс в SFUN с нуля, после имени '$');
;   +2 слова - строковая переменная ($);
;   +3 слова - числовая переменная.
; Для переменной R5 = имя: два первых символа (6 бит каждый) и биты типа
; (бит 15 - строка, 14 - целое, 13 - одинарная точность, иначе двойная);
; TYPE - тип по суффиксу: $ строка, ! одинарная, # двойная, % целое; без суффикса -
; двойная. Границы 72 и 110 привязаны к числу имён в FUN/SFUN.
T105:	MOV	R3,-(SP)	; запомнить начало имени
	CLR	TYPE
	TRAP	113
	.WORD	FUN
	.BYTE	6,110		;КОЛИЧЕСТВО ФУНКЦИЙ
	BR	2$
	TST	(SP)+
	CMP	R5,#72		;КОЛИЧЕСТВО ЧИСЛОВЫХ ФУНКЦИЙ
	BLT	1$
	SUB	#72,R5		;ПЕРЕКОДИРОВАТЬ С НУЛЯ
	CMPB	(R3)+,#'$	; после имени обязателен '$'
	BEQ	6$
	TRAP	13.
; Обычная переменная: упаковать первые символы имени в R5, TYPE - по суффиксу.
2$:	MOV	(SP)+,R3	; вернуться к началу имени
	CMP	(R0)+,(R0)+
	CLR	R5		;MOV	#20000,R5	TRACE
	BISB	(R3)+,R5	; R5 = первый символ имени
	BIC	#100,R5
	SWAB	R5
	TRAP	102		; следующий символ - буква/цифра?
	BR	4$		; нет - имя из одного символа =>
	NOP			;CLRB	R5		TRACE
	BISB	(R3),R5		; R5 |= второй символ имени (в младший байт)
	BIC	#100,R5
3$:	INC	R3
	TRAP	102		; ещё символ буква/цифра?
	BR	4$		; нет - конец имени =>
	BR	3$		; да - пропустить (учитываются только первые 2 символа)
	BR	3$
4$:	TRAP	101		; суффикс типа: $, ! или %?
	.WORD	TYPCHR
	BR	6$		;8$	SU DEFTYP
9$:	ADD	R4,PC		; переход по тому, какой суффикс совпал
	BR	5$		;$		; '$' - строка =>
	BR	7$
	BR	6$
	BIS	#40000,R5
	DECB	TYPE
	BR	6$
7$:	BIS	#20000,R5
	INC	TYPE
6$:	TST	(R0)+
1$:	RETURN
;8$:	MOV	R5,R4
;	CLRB	R4
;	SWAB	R4
;	MOVB	APRL-1(R4),R4
;	BR	9$
5$:	BIS	#160000,R5
	COMB	TYPE+1
	RETURN
;
APLMI::	.WORD	$DADD$,$DSUB$,SUM,SKIRT
ADGDL::	.WORD	$DDIV$,$DMUL$,SAND
AFUN::	.WORD	PI,POINT,INP,PEEK,RAN,$B91,$B93,$B95,$TAN,$B97,$B99
	.WORD	$B103,$INT,$FIX,ABS,IABS,ISGN,DSGN,SSGN
	.WORD	EOF,LOCY,LOCX,LPOS,FRE,ILOCY,DLOCY,SLOCY
	.WORD	ILOCX,DLOCX,SLOCX,ILPOS,DLPOS,SLPOS
	.WORD	$FRE,IFRE,DFRE,SFRE
	.WORD	LEN,ASC,VAL	;INSTR2,INSTR
;
; TRAP 106 - проверить конец оператора: конец строки (LF) или символ ' - иначе
; ошибка синтаксиса.
T106:	TRAP	112		; пропустить пробелы
	TST	4(SP)		; R0 вызывающего = 0 - конец оператора не проверять
	BEQ	2$
	CMPB	@R3,#12		; конец строки (LF)?
	BEQ	2$
	CMPB	@R3,#''		; символ комментария '?
	BNE	1$		; ни то, ни другое - ошибка =>
2$:	RETURN
1$:	TRAP	2
;
; TRAP 107 - разобрать имя переменной (DIM, NEXT, MID$= и т.п.): R4 - адрес
; записи в таблице переменных, R5 - имя. Возврат: строковая переменная - без
; пропуска слова у вызывающего, числовая - с пропуском одного слова.
T107:	MOV	R4,R2		; сохранить R4
	TRAP	112		; пропуск пробелов
	TRAP	102		; первый символ буква?
	TRAP	2		; нет (и не цифра) - ошибка "ожидалось имя"
	BR	2$		; буква - разобрать имя =>
3$:	TRAP	2		; цифра первой в имени - тоже ошибка
1$:	SUB	#2,R5		; строковая функция (R5 = 2*индекс): допустима только MID$ (индекс 1)
	BNE	3$		; другая - ошибка синтаксиса =>
	RETURN			; MID$ - принять
2$:	TRAP	105		; разобрать имя
	TRAP	2		; числовая функция - не имя переменной, ошибка синтаксиса
	BR	1$		; строковая функция =>
; Код ниже выполняет сам T107 (вложенный TRAP 105 даёт четыре возврата: +0 числовая
; функция, +1 строковая функция, +2 строковая переменная, +3 числовая переменная).
	TST	-(R0)		; R0 -= 2: вместе со следующей командой сдвиг R0 равен 0 (строковая переменная)
	TST	(R0)+		; R0 += 2: для числовой переменной вызывающий пропускает слово после TRAP 107
	MOV	R2,R4		; восстановить R4
	TRAP	121		; имя - параметр DEF FN?
	BR	5$		; нет - обычная переменная =>
	CMP	-(1),-(1)
	MOV	#APAR,(1)+
	MOV	-6(4),(1)+
	NEGB	R5		; (параметр функции; детали не выяснены до конца)
	RETURN
5$:	TRAP	103		; скомпилировать ссылку на переменную
	TSTB	R5		; массив?
	BMI	4$		; да =>
	TST	-(R1)		; нет - стереть из кода слово ссылки
4$:	TST	-(R1)		; стереть ещё слово: нужны только R4 (адрес переменной) и R5 (имя)
	RETURN
;
; TRAP 110 - разбор номера строки (для GOTO/GOSUB/RUN/RESTORE и т.п.).
; Накапливает цифры в R5 (R5 = R5*10 + цифра), проверяет переполнение (>14631 - максимум).
; Через возврат-со-сдвигом R0 сообщает вызывающему коду, был ли номер строки указан.
T110:	CLR	R5
	TRAP	112		; пропуск пробелов
	TRAP	102		; первый символ буква/цифра/иначе?
	RETURN			; не буква, не цифра - номера нет
	RETURN			; буква - тоже не номер (это идентификатор)
1$:	SUB	#60,R4		; цифра - значение цифры
	INC	R3		; съесть символ
	ASL	R5		; R5 = R5*10 + цифра (через сдвиги: *8 + *2)
	ADD	R5,R4
	ASL	R5
	ASL	R5
	ADD	R4,R5
	BCS	2$		; переполнение =>
	TRAP	102		; следующий символ буква/цифра/иначе?
	BR	3$		; не буква, не цифра - число кончилось =>
	BR	3$		; буква - тоже конец числа =>
	CMP	R5,#14631	; цифра - в пределах максимального номера строки?
	BLOS	1$		; да - продолжить накопление =>
2$:	MOV	16(SP),R4	;12?!
	TRAP	6		; ошибка - слишком большой номер строки
3$:	TST	(R0)+		; хотя бы одна цифра была - номер строки получен
	RETURN
;
T111:	MOV	FCB,R4		; начать с последней строки программы (FCB)
	TST	-(R4)
1$:	CMP	R4,TABTOP	; вышли за начало таблицы строк?
	BLO	2$		; да - не найдена =>
	CMP	R5,(R4)		; номер строки этой записи совпадает?
	BEQ	3$		; да - найдена, вернуться без пропуска слова =>
	BLO	2$		; уже прошли нужный номер (строки не существует) =>
	SUB	#6,R4		; нет - к предыдущей строке (запись - 3 слова)
	BR	1$
2$:	TST	(R0)+		; не найдена - пропустить слово у вызывающего
3$:	RETURN
;
; TRAP 112 - пропустить пробелы (код 40 = пробел).
T112:	CMPB	(R3)+,#40	; пробел?
	BEQ	T112		; да - следующий символ =>
	DEC	R3		; не пробел - вернуть символ назад
	RETURN
;
; TRAP 113 - поиск в тексте (R3) одного из ключевых слов таблицы.
; Операнды после TRAP: .WORD адрес таблицы (слова через пробел, заканчиваются
; пробелом, напр. RWLOG), затем слово: младший байт - режим (1,2 - допускается
; сокращение слова, 3 и больше - только слово целиком), старший - значение R5
; последнего слова таблицы, до которого вести поиск (R5 = 2*номер слова).
; Выход: слово найдено - пропустить 1 слово у вызывающего (после операнда),
; R5 = 2*номер слова, R3 за словом и за пробелами; не найдено - не пропускать,
; R3 не изменён. Сокращение: если полного совпадения нет, принимается слово,
; у которого совпали хотя бы 2 первые буквы (самое длинное совпадение; если
; два слова совпали одинаково - считается, что слова нет). Точное назначение
; сокращений не выяснено до конца.
; Стек: (SP) - счётчик совпавших букв (мл. байт) и номер лучшего слова (ст.),
; 2(SP) - начало слова в тексте, 4(SP) - сохранённый R1 (R1 = конец лучшего
; сокращённого совпадения).
T113:	MOV	R1,-(SP)	; сохранить R1
	MOV	R3,-(SP)	; сохранить начало слова в тексте
	MOV	#-1,-(SP)	; счётчик совпавших букв / номер лучшего слова = -1
	CLR	R1		; лучшего сокращённого совпадения пока нет
	CLR	R5		; R5 = 2*номер текущего слова таблицы
	MOV	(R0)+,R2	; R2 = адрес таблицы слов (первый операнд после TRAP)
	TRAP	102		; первый символ текста: буква, цифра или другой?
	TRAP	112		; другой (напр. пробел) - пропустить пробелы и искать дальше
	BR	1$		; буква - искать =>
	BR	14$		; цифра - слова нет =>
1$:	CLRB	@SP		; число совпавших букв = 0
2$:	CMPB	(R3),(R2)+	; буква текста совпала с буквой слова таблицы?
	BNE	3$		; нет =>
	INC	R3		; да - съесть букву
	INCB	@SP		; ещё одна совпавшая буква
	CMPB	@R2,#40		; слово таблицы кончилось (пробел)?
	BEQ	6$		; да - слово совпало целиком =>
	TRAP	102		; следующий символ текста: буква, цифра или другой?
	BR	3$		; другой - слово в тексте кончилось раньше (сокращение) =>
	BR	2$		; буква - сравнивать дальше =>
3$:	DECB	@SP		; (цифра попадает сюда же) совпало меньше 2 букв?
	BLE	4$		; да - слово не подходит =>
	CMP	R1,R3		; это совпадение длиннее лучшего?
	BHI	4$		; нет, лучшее длиннее =>
	BEQ	7$		; такой же длины - неоднозначность =>
	MOV	R3,R1		; запомнить более длинное совпадение
	MOVB	R5,1(SP)	; и номер этого слова
4$:	MOV	2(SP),R3	; вернуть R3 к началу слова в тексте
	CMPB	R5,1(R0)	; это было последнее слово, которое надо проверять?
	BEQ	11$		; да =>
5$:	CMPB	(R2)+,#40	; пропустить остаток слова таблицы до пробела
	BNE	5$
	TST	(R5)+		; следующее слово таблицы (R5 += 2)
	BR	1$
7$:	MOV	#-1,@SP		; два слова совпали одинаково - лучшего нет
	BR	4$
11$:	MOVB	1(SP),R5	; R5 = номер лучшего сокращённого совпадения
	BMI	14$		; такого нет =>
	CMPB	@R0,#3		; режим 3 и выше - сокращения не допускаются
	BGE	14$		; слова нет =>
	MOV	R1,R3		; R3 = конец принятого сокращённого слова
6$:	TRAP	112		; пропустить пробелы после слова
	TST	(R0)+		; слово найдено - пропустить слово у вызывающего
14$:	TST	(R0)+		; пропустить второй операнд (режим и последнее слово)
	CMP	(SP)+,(SP)+	; снять счётчик и сохранённый R3
	MOV	(SP)+,R1	; восстановить R1
	RETURN
;
; TRAP 114 - вывести беззнаковое число R5 в десятичном виде: превращает его в
; текст (I1, MONIT.MAC) в буфере BUFOUT и выводит на экран через ISVEIL
; (ERROR - код ошибки, ATLIN1 - номер строки; вызывающие дублируют число в R2,
; но I1 читает R5; R1,R3,R5 портятся).
T114:	MOV	#BUFOUT,R3	; R3 = буфер для текста числа
	CALL	I1		; R5 -> десятичный текст в BUFOUT (R1 = адрес, R2 = длина)
	CALL	ISVEIL		; вывести этот текст
	RETURN
;
T115:	TRAP	112		; пропуск пробелов
	CLR	R2
	MOV	R3,-(SP)	; запомнить позицию (на случай неудачи - NOT$)
	TRAP	102		; классифицировать первый символ
	BR	1$		; не буква/цифра =>
	BR	6$		; буква =>
	BR	NOT$		; цифра - не может начинать строку =>
1$:	TRAP	120		; это строковый литерал в кавычках?
	BR	NOT$		; нет - не строковое выражение =>
	BR	S10		; да (уже скомпилирован) - к проверке конкатенации =>
6$:	TRAP	105		; разобрать имя (переменная или встроенная функция)
	BR	SIMUSR		; совпало со встроенной функцией (числовой/USR/FN группы) =>
	BR	SIMFUN		; иначе - переменная или строковая функция (SFUN) =>
	BR	8$
	BR	NOT$
8$:	CLR	R4
	TRAP	121
	TRAP	103
; Проверка конкатенации: "выражение + выражение + ...".
S10:	TRAP	112		; пропуск пробелов
	TST	(SP)+
	CMPB	(R3),#'+	; символ '+' - конкатенация?
	BNE	2$		; нет - готово =>
	TST	R2
	BGT	3$
4$:	INC	R2
	BEQ	4$
	CALL	TSTSQZ
3$:	INC	R3		; съесть '+'
	TRAP	115		; разобрать следующее слагаемое (рекурсивно)
	TRAP	13.		; не строка - ошибка 13 (несоответствие типов)
	TST	R4
	BGT	1$
	MOV	#NEWSTR,(R1)+	; вставить опкод NEWSTR (размещение новой строки; условие R4 <= 0 не выяснено до конца)
1$:	MOV	#CONCAT,(R1)+	; опкод CONCAT (сложить строки)
2$:	TST	(R0)+		; строковое выражение успешно разобрано
	MOV	R2,R4
	RETURN
;
SIMUSR:	CMP	R5,#66		;USR$
	BLT	NOT$		; обычная числовая функция - недопустима =>
	MOV	R1,-(SP)	; запомнить конец кода
	CALL	USR		; USR$ или FN: разобрать вызов
	BMI	S2		; результат строковый =>
	MOV	(SP)+,R1	; нет - откатить код
NOT$:	MOV	(SP)+,R3	; не строковое выражение - откатить позицию
	RETURN
S2:	TST	(SP)+		; снять запомненный R1
	INC	R2
	BR	S10
;
; Совпадение со строковой функцией (SFUN: INKEY,MID$,STRING$,STR$,CHR$,
; BIN$,OCT$,HEX$) - разобрать её аргументы. MID$ в правой части выражения
; (не как цель присваивания - см. LMID/COMP.MAC LET) обрабатывается здесь.
; Диспетчер строковых функций по индексу R5 (из таблицы SFUN, уже поделенному
; на 2 через ASR): 0=INKEY$, 1=MID$, 2=STRING$, 3=STR$, 4=CHR$, 5=BIN$,
; 6=OCT$, 7=HEX$. Каждая ветка вычитает своё смещение и проверяет остаток,
; чтобы определить, какая именно функция вызвана (S30/S40/S20 - общий код
; для похожих групп функций).
SIMFUN:	ASR	R5		;MID$
	BEQ	10$		; 0 - INKEY$ (без аргументов) =>
	TRAP	127		; ( - у остальных функций аргументы в скобках
	DEC	R5
	BNE	S30		; не MID$ (1) =>
	TRAP	115		; MID$(строка, ...) - первый аргумент строковый
	TRAP	13.		; не строка - ошибка 13
	CALL	MIDEND		; остальные аргументы MID$: запятая, позиция, длина
	DEC	R2
	BR	S10
;
10$:	MOV	#INKEY,(R1)+	;INKEY$
	BR	S10
;
; CHR$(код)/BIN$(число)/OCT$(число)/HEX$(число) - один числовой аргумент,
; опкод по конкретной функции (см. ASFINT).
S20:	DEC	R5		;CHR$,BIN$,OCT$,HEX$
	ASL	R5
	MOV	R5,-(SP)	; запомнить индекс функции
21$:	TRAP	125		; аргумент - целое выражение
	MOV	(SP)+,R5
	MOV	ASFINT(R5),(R1)+	; опкод CHR/BIN/OCT/HEX
	BR	S33
;
; STRING$(число,строка_или_код) - строка из повторов символа.
S30:	DEC	R5		;STRING$
	BNE	S40		; не STRING$ (2) =>
	TRAP	125		; число повторов - целое выражение
	TRAP	126		; обязательная запятая
	CALL	TSTSQZ
	TST	-(R1)
	TRAP	122		; второй аргумент - строка (берётся первый символ)?
	BR	31$		; нет, это код символа =>
	MOV	#ALLSM,(R1)+	; опкод ALLSM (повторить первый символ строки)
	BR	S32
31$:	TRAP	125		; код символа - целое выражение
	MOV	#ALLSK,(R1)+	; опкод ALLSK (повторить символ с данным кодом)
S32:	INC	R2
S33:	TRAP	130		; )
	BR	S10
;
; STR$(число) - преобразовать число в строку (по типу - SSTR/ISTR).
S40:	DEC	R5		;STR$
	BNE	S20		; не STR$ (3) - CHR$/BIN$/OCT$/HEX$ =>
	TRAP	100		; аргумент - выражение (любого числового типа)
	MOVB	TYPE,R4
	INC	R4
	ASL	R4
	MOV	ASTR(R4),(R1)+	; опкод SSTR (вещественное) или ISTR (целое)
	BR	S33
;
ASTR:	.WORD	ISTR,	DSTR,	SSTR
ASFINT:	.WORD	CHR,	BIN,	OCT,	HEX	; CHR$/BIN$/OCT$/HEX$
;
; LMID - разбор "MID$(строка,позиция[,длина])" - и как цель присваивания
; (LET MID$(...)=...), и как вызов справа в выражении (TRAP 115/SIMFUN).
; После TRAP 107 имя должно быть строковой переменной: для неё возврат без
; пропуска слова (BR 10$), для числовой - с пропуском, и сработает TRAP 13.
LMID::	TRAP	127		; (
	CLR	R4
	TRAP	107		; разобрать имя строковой переменной
	BR	10$
	TRAP	13.
10$:	TST	(R1)+		; пропустить слово только что записанной ссылки на переменную
	TSTB	R5		; переменная была элементом массива?
	BMI	MIDEND		; да =>
	TST	(R1)+		; нет (скаляр) - пропустить ещё одно слово ссылки
MIDEND:	TRAP	126		; обязательная запятая
	TRAP	125		; позиция - целое выражение
	TRAP	116		; есть ли ",длина"?
	BR	11$		; нет =>
	CALL	CINT
	MOV	#STR,(R1)+	; опкод STR (MID$ с указанной длиной)
	BR	12$
11$:	MOV	#STR2,(R1)+	; опкод STR2 (MID$ до конца строки)
12$:	TRAP	130		; )
	RETURN
;
; USR/USR$(аргумент) - вызов машинного подпроцесса, или FN имя(аргументы) -
; вызов пользовательской функции (DEF FN). R5 на входе - индекс из T105 (66 - USR,
; 70 - FN, окт.), используется здесь только чтобы отличить USR от FN.
USR:	TRAP	112		; пропуск пробелов
	CLR	R2		; номер USR по умолчанию - 0
	TRAP	102		; символ после USR/FN: буква/цифра/иначе?
	BR	1$		; не буква/цифра (напр. сразу '(') =>
	BR	4$		; буква - это "FN имя(...)" =>
	MOVB	(R3)+,R2	; цифра - номер подпроцесса USR<n>
	SUB	#'0,R2		; номер подпроцесса
	ASL	R2		; в индекс (слова)
1$:	CMP	R5,#70
	BEQ	SYNERR		; да - ошибка синтаксиса
	TRAP	127		; (
	TRAP	122		; аргумент - строковый литерал?
	BR	2$		; нет =>
	TST	R4
	BGT	3$
	CALL	TSTSQZ
	BR	3$
2$:	TRAP	100		; аргумент - числовое выражение
3$:	MOV	#$USR,(R1)+	; опкод $USR
	MOV	R2,(R1)+	; номер подпроцесса
	TRAP	130		; )
	MOV	TYPE,(R1)+	; тип аргумента
	RETURN
4$:	CMP	R5,#70		; только FN =>
	BNE	SYNERR		; иначе ошибка синтаксиса
	TRAP	105		; разобрать имя функции
	TRAP	2
	TRAP	2
	NOP
	BIS	#100100,R5	; отметить имя как функцию (смысл битов не выяснен до конца)
	MOV	TYPE,-(SP)
	MOV	#-1,TYPE	; TYPE = -1 на время поиска
	TRAP	104		; найти функцию по имени в таблице переменных
	MOV	R4,-(SP)	; адрес записи функции
	CALL	TSTSQZ
	MOV	#FNST,-2(1)	; заменить в коде только что записанный опкод на FNST
	TRAP	112		; пропуск пробелов
	CMPB	@R3,#'(		; есть ли список аргументов?
	BNE	7$		; нет - функция без аргументов =>
; Разбор списка аргументов через запятую (каждый - строка или число).
40$:	INC	R3		; съесть '(' или ','
	TRAP	122		; аргумент - строковый литерал?
	BR	41$		; нет =>
	MOV	#177400,-(SP)
	TST	R4
	BGT	5$
	MOV	#NEWSTR,(R1)+	; строке нужна новая память
	BR	5$
41$:	TRAP	100		; число - выражение
	MOV	TYPE,-(SP)	; запомнить тип аргумента
5$:	INC	R2		; счётчик аргументов
	CMPB	@R3,#',		; ещё аргумент?
	BEQ	40$		; да =>
6$:	TRAP	130		; )
7$:	MOV	#FNCALL,(1)+	; опкод FNCALL
	MOV	R1,R4		; R4 = место под адрес записи функции
	TST	(1)+		; зарезервировать слово
	MOV	R2,(1)+		; число аргументов
	BEQ	9$		; аргументов нет =>
; Скопировать в код запомненные типы аргументов (см. цикл выше).
8$:	MOV	(SP)+,(R1)+
	SOB	R2,8$
9$:	MOV	(SP)+,@R4	; записать в него адрес записи функции
	MOV	(SP)+,TYPE	; восстановить TYPE
	RETURN
;
T116:	TRAP	112		; пропуск пробелов
	CMPB	@R3,#',		; запятая?
	BNE	2$		; нет - аргумента нет =>
	MOV	R3,-(SP)	; да - запомнить позицию запятой
	INC	R3		; съесть запятую
	TRAP	112		; пропуск пробелов
	CMPB	@R3,#',		; сразу ещё запятая (значения нет)?
	BEQ	1$
	CMPB	@R3,#12		; или конец строки (значения нет)?
	BEQ	1$
	TRAP	100		; значение есть - выражение
	TST	(R0)+		; пропустить слово у вызывающего
	TST	(SP)+
	RETURN
1$:	MOV	(SP)+,R3	; значения не было - вернуть позицию к запятой
2$:	RETURN
;
; TRAP 117 - пропустить цифры, допуская одну десятичную точку (мантисса числа
; в CISLO, номер строки и т.п.); R3 за ними. R2 считает точки; больше одной -
; ошибка синтаксиса.
T117:	CLR	R2
1$:	TRAP	102		; классифицировать символ: буква/цифра/иначе
	BR	3$		; не буква/цифра =>
	BR	4$		; буква =>
2$:	INC	R3		; цифра - съесть её
	BR	1$
3$:	CMPB	R4,#'.		; это точка?
	BNE	4$		; нет =>
	INC	R2		; да - учесть точку
	BR	2$		; и съесть её тоже
4$:	DEC	R2		; конец числа - было не больше одной точки?
	BGT	SYNERR		; больше одной точки - ошибка =>
	RETURN
SYNERR:	TRAP	2
;
T120:	CMPB	@R3,#'"		; открывающая кавычка?
	BNE	1$		; нет =>
3$:	INC	R3		; съесть кавычку
	MOV	#SCONST,(R1)+
	MOV	R3,(R1)+	; адрес текста строки (прямо в исходном тексте программы)
	CLR	R4		; R4 = длина строки
4$:	CMPB	@R3,#12		; конец строки (LF, кавычку не закрыли)?
	BEQ	5$
	CMPB	(R3)+,#'"	; закрывающая кавычка?
	BEQ	5$
	INC	R4		; нет - ещё один символ строки
	BR	4$
5$:	MOV	R4,(R1)+	; записать длину строки
	TST	(R0)+		; литерал найден - пропустить слово у вызывающего
	MOV	#177400,TYPE
1$:	RETURN
;
T121:	MOV	PFACT,R2	; идёт компиляция DEF FN?
	BEQ	4$		; нет =>
1$:	TST	(2)+
	BEQ	4$		; конец списка параметров - не найден =>
	TST	(2)+
	CMP	(2)+,R5		; имя параметра совпадает?
	BNE	1$		; нет - следующий параметр =>
	TST	TYPE
	BMI	3$
	TSTB	TYPE
	BEQ	2$
	BPL	3$
	TST	(4)+
2$:	TST	(4)+
3$:	MOV	PARMOV(R4),(1)+	; вставить опкод чтения параметра (SPAR - строка, DPAR - двойная, IPAR - целое)
	MOV	(2),(1)+
	MOV	R2,R4
	TST	(0)+
4$:	RETURN
;
PARMOV:	.WORD	SPAR,DPAR,IPAR
;
T122:	MOV	R3,-(SP)	; запомнить позицию на случай неудачи
	TRAP	115		; это строковое выражение?
	BR	1$		; нет =>
	TRAP	101		; да - за ним сразу знак отношения?
	.WORD	RELAT
	BR	2$		; да =>
1$:	MOV	(SP)+,R3	; нет (или не строка) - вернуть позицию
	RETURN
2$:	CMP	(SP)+,(R0)+	; отбросить сохранённую позицию, доп. пропуск слова
	RETURN
;
T123:	TRAP	125		; первое целое выражение
	TRAP	126		; обязательная запятая
T124:	TRAP	125		; (при входе с T124: первое) целое выражение
	TRAP	126		; обязательная запятая
T125:	TRAP	100		; (при входе с T125: единственное) выражение
	CALL	CINT		; привести к целому
	RETURN
;
T126:	TRAP	112		; пропуск пробелов
	CMPB	(R3)+,#',	; запятая?
	BNE	1$		; нет - ошибка =>
	TRAP	112		; да - пропуск пробелов после неё
	RETURN
1$:	TRAP	2
;
	.END
