	.ENABLE LC
	.GLOBL	BREAK,BREAKW,IRPS2
	.GLOBL	TXEND,LYGIS,STRREG,STRSIZ,CURON,CUROFF,$DADD$,STACK
	.GLOBL	CISLO,ID,SD,IS,SI,SEPAP,TRFLAG,TRIN,LIMIT,SAVJMP
	.GLOBL	ADRHLT,STAR,ISV,ENDCOD,LENT,CIKL,ISVEIL,IVEIL,DCMP
	.GLOBL	ISVTO,ISVETO,FCB,EGO,DGO,ISGUNP,HIMEM,BLOCK0,BLOCKN,ISVARD
	.GLOBL	BUF,PACK,TABTOP,BUFOUT,INK,FREBEG,FRELEN,MONERR,NUMBER
	.GLOBL	USRTAB,DATINP,DATPTR,IODEV,MAG,CASCII,DAT,CAS,LASTBL	;MAXFIL
	.GLOBL	CLRBUF,CLRCOD,LPTPOS,PFACT,WSTOP,TTANAL,SETST	;SIGNAL
;
;MTONV::	MOV	#1,MAG
;MONV1:	CALL	CAS
;	JMP	@(4)+
;MTOFFV::CLR	MAG
;	BR	MONV1
;
TRUN::	TST	TRFLAG
	BNE	TEND
	INC	TRFLAG
	TSTB	LYGIS
	BEQ	TEND
	TST	NUMBER
	BEQ	1$
	NEG	TRFLAG
	BR	TEND
1$:	CMP	@R4,#ENDPRG
	BEQ	TEND
	JMP	TRIN
;
TREND::	TST	TRFLAG
	BLE	1$
	TSTB	LYGIS
	BEQ	1$
	JSR	R2,SEPAP
1$:	CLR	TRFLAG
TEND:	JMP	@(4)+
;
ENDPRG::CALL	CLOALL
	INC	LYGIS
        BNE	END1
	JSR	R2,SEPAP
        CLR	ADRHLT
	CALL	TRTOPL
END1:	JMP	STAR
;
HALT::	MOV	R4,SAVJMP
	MOV	#WSTOP,R1
	MOV	#5,R2
	CALL	ISVEIL
	CMP	R4,STRREG
	BHI	3$
	MOV	R4,ADRHLT
2$:	JSR	R2,SEPAP
	CALL	TRTOPL
	CALL	LNUM
	CMP	-(R4),-(R4)
	JSR	R0,SETST
	BR	1$
	CLR	ADRHLT
1$:	CLR	SAVJMP
   	BR	END1
3$:	CLR	SAVJMP
	JMP	MONERR
;
TRTOPL:	TST	TRFLAG
	BPL	1$
	NEG	TRFLAG
1$:	RETURN
;
LNUM::	CALL	AGAUD
	MOV	2(0),R5
ATLIN1::MOV	#ATLINE,R1
	MOV	#12,R2
	CALL	ISVEIL
	MOV	R5,R2
	TRAP	114
	MOV	#12,R0
	CALL	ISV
	RETURN
;
AGAUD:: MOV	TABTOP,R0
3$:	CMP	(R0)+,R4
	BLO	4$
	CMP	(R0)+,(R0)+
	CMP	R0,FCB
	BLO	3$
	TST	(R0)+
4$:	MOV	R0,R4
	RETURN
;
ATLINE: .BYTE	40,367,40,363,364,362,357,353,345,40	; В СТРОКЕ
	.EVEN
;
;---------------------------------------------
; ICMP – сравнение двух 16-битных целых на стеке.
; Снимает два слова, вычитает второе из первого, флаги для условного перехода.
ICMP::	SUB     (SP)+,(SP)+	; (первое) - (второе), оба удаляются
        JMP     @(R4)+		; возврат, флаги установлены
;
; NEXCMP – подготовка к сравнению вещественных чисел в цикле.
; Сохраняет текущие значения стека в буфер, затем помещает параметры для SCMP.
NEXCMP::MOV	CIKL,R1		; адрес структуры цикла
	MOV	(R1)+,R0	; адрес буфера
	MOV	SP,R2		; текущий стек
	MOV	(R2)+,(R0)+	; скопировать два слова в буфер
	BIT	#20000,-4(R0)
	BEQ	NDCMP
	MOV	(R2)+,(R0)
	MOV	@R2,R2
	ROL	R2
	ADC	@R0
	ADC	-(R0)
	BVS	1$
	BCC	NCMP
1$:	TRAP	6
;
NDCMP:	MOV     (R2)+,(R0)+
        MOV     (R2),(R0)+
        MOV     (R2),(R0)+
NCMP:	TST     (R1)+		; пропустить слово (счётчик?)
        MOV     (R1)+,-(SP)	; поместить два слова (параметры сравнения) на стек
        MOV     (R1)+,-(SP)
        MOV     (R1)+,-(SP)
        MOV     @R1,-(SP)
	JMP	DCMP
;
; SCMP – сравнение двух чисел float на стеке.
; Вход: на стеке два числа (по два слова): старшее1, младшее1, старшее2, младшее2.
; Результат: R0 = 0 (равны), >0 (первое больше), <0 (первое меньше).
SCMP::  MOV     @PC,R0		; загрузить константу (обычно 0)
        MOV     4(SP),R1	; старшее слово первого числа
        BGE     1$		; положительное -> 1$
        ASL     R0		; отрицательное – установить младший бит R0
        MOV     (SP)+,R2	; снять адрес возврата (или младшее слово?)
        BLT     2$
        BR      4$
1$:     MOV     (SP)+,R2	; снять адрес возврата
        BLT     5$
2$:     CMP     R1,R2		; сравнить старшие слова
        BNE     3$
        CMP     4(SP),@SP	; сравнить младшие слова
        BNE     3$
        CLR     R0		; равны
3$:     ROR     R0		; знак в старший бит
        BCS     5$
4$:     NEG     R0		; отрицательный результат
5$:     ADD     #6,SP		; очистить стек (удалить числа)
        TST     R0
        JMP     @(R4)+		; возврат
;
$CMP::	MOV	(SP)+,R2
	MOV	(SP)+,R3
	MOV	(SP)+,R1	; длина второй строки
	MOV	(SP)+,R0	; адрес второй строки
	SUB	R1,R2		; разница длин
	BPL	1$
	ADD	R2,R1		; выравнивание длин
1$:	DEC	R1		; счётчик
	BMI	2$
	CMPB	(R0)+,(R3)+	; побайтовое сравнение
	BEQ	1$
	JMP	@(R4)+		; возврат (флаги установлены)
2$:	NEG	R2		; строки равны – вернуть отрицательную разницу длин
	JMP	@(R4)+
;
; Условие .IF EQ,1 ложно: SWAP (SWPD..SWSII) в эту сборку не входит.
    .IF EQ,1
SWPD::	MOV	#4,R2
	BR	EXSWAP
SWPR::	MOV	#2,R2
	BR	EXSWAP
SWPI::	MOV	#1,R2
EXSWAP:	MOV	(SP)+,R0
	MOV	(SP)+,R1
1$:	MOV	@R0,-(SP)
	MOV	@R1,(0)+
	MOV	(SP)+,(1)+
	SOB	R2,1$
	JMP	@(4)+
;
SWSSI::	MOV	(SP)+,R1
	MOV	(SP)+,R0
	BR	SWAP1
SWSIS::	MOV	(SP)+,R0
	MOV	(SP)+,R1
SWAP1:	MOV	@R0,-(SP)
	MOVB	@R1,@R0
	MOVB	(SP)+,(1)+
	TST	(0)+
	MOV	#2,R2
	BR	EXSSW
SWSII::	MOV	(SP)+,R0
	MOV	(SP)+,R1
	MOV	#3,R2
;
EXSSW:	MOVB	@R0,-(SP)
	MOVB	@R1,(0)+
	MOVB	(SP)+,(1)+
	SOB	R2,EXSSW
	JMP	@(4)+
    .ENDC
;
IFT::   TST     (SP)+		; снять условие
        BNE     JMP		; не 0 (истина) - перейти по адресу из кода =>
        BR      NJMP		; 0 (ложь) - пропустить адрес перехода
;
IFF::   TST     (SP)+		; снять условие
        BEQ     JMP		; 0 (ложь) - перейти =>
        BR      NJMP		; не 0 - пропустить адрес перехода
;
ADDRBR::.WORD   EQ,GT,LT,GE,LE,NE,0	; опкоды отношений =, >, <, >=, <=, <> (по флагам после ICMP/SCMP/$CMP)
;
EQ:     BEQ     TRUE		; условие по флагам верно => истина
FALSE:  CLR     -(SP)		; ложь: 0 на стек
        JMP     @(R4)+
;
NE:     BNE     TRUE
        BR      FALSE
;
LE:     BLE     TRUE
        BR      FALSE
;
GE:     BGE     TRUE
        BR      FALSE
;
LT:     BLT     TRUE
        BR      FALSE
;
GT:     BLE     FALSE		; GT: не больше (меньше или равно) => ложь, иначе истина
TRUE:   MOV     #-1,-(SP)	; истина: -1 на стек
        JMP     @(R4)+
;
NEXJMP::MOV     CIKL,R1
	TST	22(R1)
        BMI     2$		; да =>
        TST     R0		; шаг положительный - счётчик больше предела?
        BGT     3$		; да - цикл закончен =>
1$:     MOV     2(R1),R4	; цикл продолжается - R4 = адрес возврата к телу цикла
        JMP     @(R4)+
2$:     TST     R0
        BGE     1$
3$:     ADD     #24,CIKL
        JMP     @(R4)+
;
JSR::	MOV	CIKL,R0		; R0 = вершина стека кадров
	TST	-(R0)		; освободить слово под ссылку на предыдущий LIMIT
	CMP	R0,ENDCOD	; переполнение стека (кадры уткнулись в код программы)?
	BLOS	STCKER		; да - ошибка =>
	MOV	LIMIT,@R0	; сохранить старый LIMIT (для возврата)
	MOV     R4,-(R0)	; сохранить адрес возврата (после JSR)
SUB:	MOV	R0,CIKL
	MOV	R0,LIMIT
;
JMP::   MOV     @R4,R4
        JMP     @(R4)+		;-------+26
;
; ONJMP - оператор ON выражение GOTO строка,строка,... (см. COMP.MAC/ON::).
; R0 (со стека) - значение выражения (1-based индекс). Список целей и их
; количество записаны в коде сразу после опкода (см. также ONJSR).
ONJMP::	MOV	(SP)+,R0	; R0 = значение выражения-селектора
	BEQ	ONSKIP		; 0 - не переходить никуда (просто продолжить) =>
	BIT	#177400,R0	; отрицательное или слишком большое?
	BNE	ONERR		; да - ошибка =>
	CMP	R0,@R4		; в пределах числа целей (записано в коде)?
	BLE	JUMP		; да - перейти на нужную цель =>
ONSKIP:	MOV	(R4)+,R0	; вне диапазона - R0 = число целей, пропустить их все
	ASL	R0
	ADD	R0,R4
	JMP	@(R4)+		; продолжить после списка целей
ONERR:	TRAP	5		; ошибка - недопустимое значение выражения ON
;
ONJSR::	MOV	(SP)+,R0	; R0 = значение выражения-селектора
	BEQ	ONSKIP		; 0 - никуда не переходить =>
	BIT	#177400,R0	; отрицательное или слишком большое?
	BNE	ONERR		; да - ошибка =>
	CMP	R0,@R4		; в пределах числа целей?
	BGT	ONSKIP		; нет - вне диапазона, просто продолжить =>
	MOV	@R4,R1		; R1 = число целей
	ASL	R1
	ADD	R4,R1		; R1 = адрес сразу после списка целей (адрес возврата)
	MOV	CIKL,R2		; завести кадр возврата (как в JSR)
	TST	-(R2)
	CMP	R2,ENDCOD	; переполнение стека кадров?
	BLOS	STCKER		; да - ошибка =>
	MOV	LIMIT,@R2	; сохранить старый LIMIT
	MOV	R1,-(R2)	; сохранить адрес возврата (после списка целей)
	MOV	R2,CIKL
	MOV	R2,LIMIT
JUMP:	ASL	R0
	ADD	R0,R4
	BR	JMP
STCKER:	TRAP	7		; ошибка - переполнение стека кадров (FOR/GOSUB)
;
RTSTO::	MOV	LIMIT,R0	; RETURN <строка>: снять кадр GOSUB, но перейти на указанную строку
	CMP	R0,LENT		; кадров GOSUB нет?
	BHIS	RETERR		; да - ошибка 3 (RETURN без GOSUB) =>
	MOV	@R0,R0		; R0 = предыдущий LIMIT (из кадра)
	BR	SUB		; снять кадр и перейти (как GOSUB)
RETERR:	TRAP	3
;
RTS::   MOV     LIMIT,R0	; RETURN: R0 = текущий кадр GOSUB
	CMP	R0,LENT
	BHIS	RETERR		; кадров GOSUB нет - ошибка 3 =>
	MOV	(R0)+,R4	; R4 = адрес возврата из кадра
	MOV	(R0)+,LIMIT	; LIMIT = предыдущий кадр
	MOV	R0,CIKL		; CIKL - кадр снят
;
NJMP:   TST     (R4)+		; пропустить слово
        JMP     @(R4)+
;
DFNRET::MOV	#4,R1		; результат функции 4 слова (двойная точность)
;
RETFN:	MOV	PFACT,R0
	MOV	(R0)+,PFACT	; восстановить PFACT вызывающего (снять кадр)
	MOV	R1,R2
	ASL	R2
	ADD	SP,R2		; R2 = адрес результата на стеке (перед снятыми параметрами)
1$:	MOV	-(2),-(0)	; сдвинуть слова результата на место параметров
	SOB	R1,1$
	MOV	R0,SP		; SP = после результата - параметры/локальные сняты
	MOV	@(4)+,R4
	JMP	@(4)+
;
SFNRET::MOV	#2,R1		; результат 2 слова (одинарная точность или строка)
	BR	RETFN
;
IFNRET::MOV	#1,R1		; результат 1 слово (целое)
	BR	RETFN
;
; DFN - опкод, которым начинается тело DEF FN в основном потоке кода
; (см. COMP.MAC DEF::). При обычном, "сквозном" выполнении программы (не
; через вызов функции) нужно перепрыгнуть через тело функции, попутно
; регистрируя, где оно начинается, чтобы FNCALL мог его найти.
DFN::	MOV	(4)+,R0		; R0 = адрес продолжения программы (после тела функции)
	MOV	(4)+,R1		; R1 = адрес ячейки переменной-функции в таблице переменных
	MOV	R4,@R1		; записать туда адрес начала тела функции (сразу за этими операндами)
	MOV	R0,R4		; перепрыгнуть через тело функции
	JMP	@(4)+		; продолжить (диспетчер шитого кода)
;
; FNST - подготовка вызова DEF FN (см. USR:: в TRAP.MAC): запомнить текущий
; PFACT (для вложенных/повторных вызовов) и место в стеке, где он сохранён,
; - FNCALL восстановит его оттуда после разбора аргументов.
FNST::	MOV	PFACT,-(SP)	; сохранить PFACT вызывающего уровня
	MOV	SP,PFACT+2	; запомнить, где именно он сохранён на стеке
	JMP	@(4)+		; продолжить (диспетчер шитого кода)
;
; FNCALL - собственно вызов DEF FN (см. TRAP.MAC, USR::/7$). В коде сразу
; после опкода: адрес ячейки переменной-функции, затем список типов
; переданных аргументов. Тело функции (записанное DFN::) начинается со
; своего списка типов формальных параметров - они должны совпасть.
FNCALL::MOV	(4)+,R0		; R0 = адрес ячейки переменной-функции
	MOV	(0)+,R2		; R2 = адрес тела функции (записан туда через DFN::)
	BEQ	2$		; тело не зарегистрировано (DEF FN не выполнялся) =>
	MOV	@R4,R1		; R1 = число переданных аргументов
	INC	R1
1$:	CMP	(4)+,(2)+	; тип переданного аргумента = тип формального параметра?
	BNE	3$		; нет - ошибка =>
	SOB	R1,1$		; да - проверить следующий
	MOV	R4,@R0		; запомнить место возврата (после списков типов)
	MOV	R2,R4		; перейти к исполняемому телу функции (после списка параметров)
	MOV	PFACT+2,PFACT	; PFACT = адрес аргументов на стеке (см. FNST) - для $PAR/SPAR/IPAR
	JMP	@(4)+		; выполнить тело функции
2$:	TRAP	18.		; ошибка - функция не определена (нет DEF FN)
3$:	TRAP	5		; ошибка - несоответствие типов аргументов
;
; APAR - адрес параметра (а не значение): PFACT минус смещение из кода.
APAR::	MOV	PFACT,-(SP)	; положить PFACT на стек
	SUB	(4)+,@SP	; вычесть смещение - адрес параметра
	JMP	@(4)+		; продолжить (диспетчер шитого кода)
;
IPAR::	MOV	#1,R1
	BR	PARAM
;
SPAR::	MOV	#2,R1
	BR	PARAM
;
DPAR::	MOV	#4,R1
;
; PARAM - прочитать параметр DEF FN как значение: R1 = число слов (1 целая,
; 2 одинарная/строка, 4 двойная); PFACT - адрес аргументов текущего вызова
; (см. FNCALL), смещение параметра - в коде.
PARAM:	MOV	PFACT,R0	; R0 = адрес аргументов текущего вызова
	SUB	(4)+,R0		; R0 -= смещение - адрес значения параметра
1$:	MOV	-(0),-(SP)	; скопировать слово значения на стек выражения
	SOB	R1,1$
	JMP	@(4)+		; продолжить (диспетчер шитого кода)
;
; DCONST/SCONST/ICONST - константа в потоке кода: 4 слова (двойная точность),
; 2 слова (одинарная), 1 слово (целая); значение переносится на стек
; выражения (общий вход - падение вниз от DCONST к ICONST).
DCONST::MOV     (R4)+,-(SP)	; DCONST: двойная константа - 4 слова из кода на стек (сначала два последних)
        MOV     (R4)+,-(SP)	; и два следующих
SCONST::MOV     (R4)+,-(SP)	; SCONST: одинарная константа - 2 слова из кода
ICONST::MOV     (R4)+,-(SP)	; ICONST: целая константа - 1 слово из кода
        JMP     @(R4)+
;
DXVAR:: MOV     (SP)+,R1	; DXVAR: элемент массива двойной точности: адрес со стека
        BR      DVAR1
;
DVAR::  MOV     (R4)+,R1	; DVAR: переменная двойной точности: адрес значения из кода
DVAR1:  ADD     #10,R1		; к концу значения (4 слова)
        MOV     -(R1),-(SP)	; скопировать 4 слова значения на стек (с конца)
        MOV     -(R1),-(SP)
        MOV     -(R1),-(SP)
        MOV     -(R1),-(SP)
        JMP     @(R4)+		; продолжить (диспетчер шитого кода)
;
; SXVAR - элемент массива одинарной точности (2 слова): адрес со стека, затем как SVAR1.
SXVAR:: MOV     (SP)+,R1	; R1 = адрес значения (со стека)
        BR      SVAR1
;
; SVAR - переменная из 2 слов (одинарной точности или строка): адрес из кода.
SVAR::  MOV     (R4)+,R1	; R1 = адрес значения (из кода)
SVAR1:  MOV     2(R1),-(SP)	; переложить старшее слово числа
        MOV     @R1,-(SP)	; переложить младшее слово числа
        JMP     @(R4)+		; продолжить (диспетчер шитого кода)
;
; IXVAR - целый элемент массива: адрес со стека, значение - одно слово.
IXVAR:: MOV     @(SP)+,-(SP)	; снять адрес, положить значение по этому адресу
        JMP     @(R4)+		; продолжить (диспетчер шитого кода)
;
; IVAR - простая целая переменная: адрес из кода, значение - одно слово.
IVAR::  MOV     @(R4)+,-(SP)	; значение по адресу из кода
        JMP     @(R4)+		; продолжить (диспетчер шитого кода)
;
$XVAR:: MOV     @SP,R0		; $XVAR: элемент строкового массива - на стеке адрес упакованного 3-байтового дескриптора
        MOVB    (R0)+,R1	; R1 = длина строки (первый байт)
        MOVB    (R0)+,@SP	; младший байт адреса строки
        MOVB    (R0)+,1(SP)	; старший байт адреса
        CLR     -(SP)		; длина строки на стек
        BISB    R1,@SP		; (под ней адрес)
        JMP     @(R4)+
;
$XMOV:: MOV     (SP)+,R0	; R0 = длина новой строки
        MOV     (SP)+,R1	; R1 = адрес новой строки
        MOV     (SP)+,R2	; R2 = адрес дескриптора элемента массива (цель)
        MOVB    R0,(R2)+	; записать длину (байт)
        MOVB    R1,(R2)+	; записать младший байт адреса
        SWAB    R1
        MOVB    R1,(R2)+	; записать старший байт адреса
        JMP     @(R4)+		; продолжить (диспетчер шитого кода)
;
; SXMOV - вещественное в элемент массива: адрес цели - третье слово на
; стеке (под значением), само значение (2 слова) - выше.
SXMOV:: MOV     4(SP),R1	; R1 = адрес цели (не снимая пока со стека)
        BR      XMOV
;
DXMOV:: MOV     10(SP),R1
        MOV     (SP)+,(R1)+
        MOV     (SP)+,(R1)+
XMOV::  MOV     (SP)+,(R1)+	; переложить первое слово значения по адресу
        MOV     (SP)+,@R1	; переложить второе слово значения
SPJ:	TST     (SP)+		; снять теперь ненужный адрес цели со стека
        JMP     @(R4)+		; продолжить (диспетчер шитого кода)
;
;
; IXMOV - целое в элемент массива: значение и адрес цели - по одному слову
; на стеке (значение сверху, адрес под ним).
IXMOV:: MOV     (SP)+,@(SP)+	; снять значение и адрес, записать по адресу
        JMP     @(R4)+		; продолжить (диспетчер шитого кода)
;
SMOV::  MOV     (R4)+,R1
        BR      MOVS
;
DMOV::  MOV     (R4)+,R1
	MOV     (SP)+,(R1)+
        MOV     (SP)+,(R1)+
MOVS:	MOV     (SP)+,(R1)+	; переложить первое слово значения
	MOV	(SP)+,@R1	; переложить второе слово значения
	JMP     @(R4)+		; продолжить (диспетчер шитого кода)
;
; IMOV - целое в простую переменную: адрес из кода, значение - одно слово.
IMOV::  MOV     (SP)+,@(R4)+
        JMP     @(R4)+
;
MIDMOV::MOV     (SP)+,R3
        MOV     (SP)+,R2
        MOV     (SP)+,R1
        MOV     (SP)+,R0	; R0 = адрес назначения (позиция внутри целевой строки)
        CMP     R3,R1		; новая строка длиннее ограничения MID$?
        BLE     1$		; нет =>
        MOV     R1,R3		; да - скопировать не больше ограничения
1$:     DEC     R3
        BMI     3$		; скопировано нужное число байт =>
        MOVB    (R2)+,(R0)+	; скопировать очередной байт
        BR      1$
3$:     JMP     @(R4)+		; продолжить (диспетчер шитого кода)
;
FORDBL::MOV     CIKL,R0		; R0 = вершина стека кадров
        MOV     (SP)+,-(R0)	; шаг (вещественный) - старшее слово
        MOV     (SP)+,-(R0)	; шаг - младшее слово
        MOV     (SP)+,-(R0)
        MOV     (SP)+,-(R0)
        MOV     (SP)+,-(R0)
        MOV     (SP)+,-(R0)
	BR	FORMOV
FORINT::MOV	CIKL,R0
FORMOV: MOV     (SP)+,-(R0)	; предел цикла (или шаг для FORINT) - со стека
        MOV     (SP)+,-(R0)
        MOV     (R4)+,-(R0)	; служебное слово из кода (адрес тела цикла - см. NEXJMP)
        MOV     (R4)+,-(R0)	; служебное слово из кода
        CMP     R0,ENDCOD	; переполнение стека кадров (уткнулись в код программы)?
        BLO     1$
        MOV     R0,CIKL
        JMP     @(R4)+
1$:     TRAP    7
;
LIT::	MOV	(SP)+,R2	; R2 = длина строки
	BEQ	SPJ		; пустая строка - нечего выводить, снять адрес и продолжить =>
	BR	OUT2		; вывести R2 байт по адресу (ещё на стеке)
;
NXSKIP::MOV     CIKL,R1		; R1 = самый внутренний блок цикла/кадр
	MOV	(R4)+,R0	; R0 = адрес переменной из NEXT (0, если без переменной)
	BNE	1$		; переменная указана =>
	MOV	@R1,R0		; без переменной - взять переменную самого внутреннего цикла
1$:	CMP	R1,LIMIT	; кадры кончились (цикл не найден)?
	BHIS	3$		; да - ошибка =>
	CMP	R0,(R1)+	; переменная этого блока совпадает с искомой?
	BEQ	2$
	MOV	-(R1),R2
	ADD	#10,R1
	BIT	#40000,-(R2)
	BNE	10$
	ADD	#14,R1
10$:	MOV	R1,CIKL
	BR	1$
2$:	JMP	@(R4)+
3$:	TRAP	1
;
NEXSNG::MOV	-2(R0),R2
	ROL	R2
	BMI	1$
	ROL	R2
	BPL	NEXDBL
	CLR	-(SP)
	CLR	-(SP)
	CMP	(R0)+,(R0)+
	BR	NEXADD
1$:	CMP	(R4)+,(R4)+
;
NEXINT::CMP	(R1)+,(R1)+	; пропустить служебные слова блока (к шагу)	;---STOP---
	MOV	@R1,R2		; R2 = шаг
	ADD	@R0,R2		; R2 = счётчик + шаг
	BVS	4$		; переполнение =>
	MOV	R2,@R0		; записать новое значение счётчика
	TST	@R1		; шаг отрицательный?
	BMI	2$		; да =>
	CMP	R2,-(R1)	; шаг положительный - счётчик больше предела?
	BGT	3$		; да - цикл закончен =>
1$:	MOV	-(R1),R4	; цикл продолжается - R4 = адрес возврата к телу цикла
	JMP	@(R4)+		;-------+24
2$:	CMP	R2,-(R1)	; шаг отрицательный - счётчик всё ещё >= предела?
	BGE	1$		; да - цикл продолжается =>
3$:	ADD	#10,CIKL	; цикл закончен - снять блок цикла
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
4$:	TRAP	6		; ошибка - переполнение при вычислении шага
;
NEXDBL::ADD     #6,R0
        MOV     @R0,-(SP)
        MOV     -(R0),-(SP)
NEXADD: MOV     -(R0),-(SP)
        MOV     -(R0),-(SP)
	ADD     #12,R1
        MOV     (R1)+,-(SP)
        MOV     (R1)+,-(SP)
        MOV     (R1)+,-(SP)
        MOV     @R1,-(SP)
        JMP     $DADD$
;
NEWSTR::MOV     (SP),R1
	CALL	TSTFRE
        SUB     R1,FRELEN
        MOV     2(SP),R0
        MOV     FREBEG,R2
        MOV     R2,2(SP)
        ADD     R1,FREBEG
1$:     DEC     R1
        BMI     2$
        MOVB    (R0)+,(R2)+
        BR      1$
2$:     JMP     @(R4)+
;
TSTFRE:	CMP	R1,FRELEN
;	BLOS	1$
;	MOV	R1,-(SP)
;	CALL	STRSQU
;	MOV	(SP)+,R1
;	CMP	R1,FRELEN
 	BHI	2$
1$:	RETURN
2$:	TRAP	14.
;
NEG::   TST     @SP
        BEQ     1$
        ADD     #100000,@SP
1$:     JMP     @(R4)+
;
BEEP0::	MOV	#7,R0		;TIK PYPT
	BR	JEND		;TIK PYPT
;	MOV	#1000,-(SP)
;BEEP1::	MOV	#37,-(SP)
;BEEP2::	MOV	(SP)+,R2
;	MOV     (SP)+,R1
;	CALL	SIGNAL
;	JMP	@(R4)+
;
NEWLIN::MOV	#12,R0
	BR	JEND
;
JCLS::	MOV	#14,R0
JEND:	MOV	R4,SAVJMP
	CALL    ISVTO
	BR	OUT3
;
SOUTSP::CALL	EGO
	BR	OUT
;
DOUTSP::CALL	DGO
OUT:	MOV	(SP)+,R2
OUT2:	MOV	(SP)+,R1
OUT1:	MOV	R4,SAVJMP
	CALL	ISVETO
OUT3:	CLR	SAVJMP
	JMP	@(R4)+
;
DLPOS::	CMP	(SP)+,(SP)+
SLPOS::	TST	(SP)+
ILPOS::	TST	(SP)+
LPOS::	CLR	-(SP)
	MOVB	LPTPOS,@SP
	INC	@SP
	JMP	@(4)+
;
IOUTSP::MOV     (SP)+,R5
        CALL    ISGUNP
        BR      OUT1
;
;-----------------------------------------------
; GETLIT - оператор INPUT со своим приглашением (см. COMP.MAC INPUT::):
; приглашение уже выведено (опкодом LIT), стандартное "? " печатать не
; нужно - входит в общий код GET (ниже) сразу после его собственного
; MOV R4,SAVJMP (SAVJMP отводится назад на длину этого опкода).
GETLIT::MOV	R4,SAVJMP
	SUB	#10,SAVJMP	; поправить SAVJMP на начало этого опкода (см. GET)
	BR	G01		; => общий код ввода (без вывода "? ")
;
; RESTV - оператор RESTORE без номера строки: восстановить указатель DATA
; на адрес, записанный в коде (пропатчен при компиляции - см. ENDTXT/AUTOON
; в COMP.MAC, обрабатывает и случай "DATA не найден" - там пишется 0).
RESTV::	MOV	(4)+,DATPTR	; DATPTR = адрес, вписанный компилятором
	JMP	@(4)+		; продолжить (диспетчер шитого кода)
;
; READV - оператор READ: взять текст очередного значения из цепочки DATA
; (DATPTR) и разобрать его как INPUT (общий код GET, точка входа G1).
READV::	MOV	DATPTR,R3	; R3 = адрес текста очередного значения DATA
	BNE	1$		; данные ещё есть =>
	TRAP	4		; данные кончились - ошибка "Out of DATA"
1$:	MOV	#-1,DATINP	; отметить: это READ, а не INPUT (см. ERROR::/RUNERR)
	MOV	R4,SAVJMP	; запомнить позицию в коде
	MOV	(4)+,-(SP)	; переложить операнд (ссылку на список переменных)
	BR	G1		; => общий код разбора значения (без запроса ввода)
;
; GET - общий разбор значений для INPUT/READ. В коде после опкода - конец списка
; переменных (G01), затем адреса целей (для элемента массива - опкод GETARR).
;   G01/G00 - при вводе с клавиатуры (DATINP = 0) вывести "?" и считать строку
;             в BUF (IVEIL); G03 - то же из файла (FILINP). READV входит в G1
;             сразу с текстом из цепочки DATA.
;   G1      - цикл по списку переменных (между значениями запятая).
;   G30     - разбор значения по типу цели (см. ниже); G20 - строка: текст
;             копируется в область строк, в переменную пишется 3-байтовый
;             дескриптор (длина, адрес).
;   G40     - после значения: запятая - следующая переменная; конец строки -
;             G1; иначе G4: ошибка 13 и повтор оператора с SAVJMP (повторный
;             ввод). G6 - завершение: для READ запомнить позицию в DATPTR.
GET::   MOV     R4,SAVJMP	; запомнить начало оператора (для повтора при ошибке)
G01:	MOV     (R4)+,-(SP)	; сохранить конец списка переменных (операнд из кода)
	MOV	IODEV,R0
	MOV	R0,DATINP
	BNE	G03		; ввод не с клавиатуры (файл) =>
        MOV     #'?,R0
        BR      G00
G13:	CMPB	@R3,#12		; конец введённой строки, а переменных ещё много?
	BEQ	G02		; да - запросить продолжение ввода =>
	CMP	@R4,LENT
	BHIS	G30
	MOV	R3,-(SP)
	TST	(4)+
	JMP	@(4)+
G03:	CALL	FILINP		; чтение значения из файла
	CMP	R1,#BUF
	BNE	G04
	TRAP	55.
G02:	MOV	DATINP,R0
	BEQ	1$
	BPL	G03
	TRAP	4
1$:	MOV     #'?,R0
	CALL    ISV
G00:    CALL    ISV		; вывести "?"
        CALL    CURON
        CALL    IVEIL
        CALL    CUROFF
G04:	MOV	#BUF,R3		; R3 = введённый текст
	TRAP	112		; пропуск пробелов
	CMPB	@R3,#12		; пустая строка?
	BEQ	G5
; Цикл по списку переменных.
G1:     CMP     R4,@SP		; список переменных кончился?
        BEQ     G6		; да - завершить =>
	TRAP	112		; пропуск пробелов
        CMPB    @R3,#',		; в тексте ожидается запятая (после предыдущего значения)?
        BNE     G13		; нет =>
        CMP     (R4)+,LENT
	BHIS	G12
	MOV	-(R4),R4
G12:    INC     R3		; съесть запятую
        BR      G1
; G20 - строковое значение: скопировать текст (в кавычках - до закрывающей
; кавычки, иначе - до запятой/конца строки) в новую строку.
G20:	MOV	#',,-(SP)	; разделитель по умолчанию - запятая
	MOV	R1,-(SP)
	CLR	R1		; R1 = длина считываемого текста
	MOV	R3,-(SP)	; запомнить начало текста значения
        CMPB    @R3,#'"		; значение в кавычках?
        BNE     22$
21$:    MOVB    (R3)+,4(SP)	; да - разделитель теперь кавычка
	INC	(SP)
22$:    CMPB    @R3,#12		; конец строки текста?
        BEQ     24$
        CMPB    (3)+,4(SP)	; дошли до разделителя (кавычки/запятой)?
        BEQ     24$
        INC     R1		; нет - ещё один символ значения
        BR      22$
24$:	MOV	R0,R5
	MOV	@SP,-(SP)
	MOV	R3,2(SP)
	BIT	#177400,R1	; длина строки в допустимых пределах?
	BNE	28$		; нет - ошибка =>
	CALL	TSTFRE
	MOV	FREBEG,R2
	MOV	(SP)+,R3
	MOV	R1,R0
	BEQ	26$
25$:	MOVB	(3)+,(2)+
	SOB	R1,25$
26$:	MOV	(SP)+,R3
	MOV	(SP)+,R1
	MOVB	R0,(R1)+	; записать дескриптор строки в переменную
	TSTB	R5
	BMI	27$
	CLRB	(R1)+
27$:	MOVB	FREBEG,(R1)+
	MOVB	FREBEG+1,(R1)+
	SUB	R0,FRELEN
	MOV	R2,FREBEG
        CMP     (SP)+,#',	; значение оканчивалось запятой?
        BEQ     G1		; да - к следующей переменной =>
        BR      G40
28$:    TRAP    15.		; ошибка - слишком длинная строка
; G30 - цель очередной переменной: R1 = адрес её значения, слово перед ним -
; имя с битами типа. Бит 15 - строка (G20); иначе число: CISLO разбирает его из
; текста, затем TODBL/TOSNG/TOINT приводят к типу цели (бит 14 - целая, бит 13 -
; одинарная точность, иначе двойная) и записывают значение (DXMOV/SXMOV/IXMOV).
G30:    MOV     (R4)+,R1	; R1 = адрес цели
	MOV	R1,R0
G3:	MOV	-(R0),R0	; R0 = флаги цели (перед адресом значения)
        BMI     G20
	MOV	R4,-(SP)
	MOV	R1,-(SP)
	CALL	CISLO		; нет - разобрать число
	BR	G41
	BR	G41
	BR	G41
	ROL	R0
	BMI	32$
	ROL	R0
	BMI	31$
	JSR	R4,TODBL
	.WORD	SD,DXMOV,G33
	.WORD	ID,DXMOV,G33
31$:	JSR	R4,TOSNG
	.WORD	IS,SXMOV,G33
32$:	JSR	R4,TOINT
	.WORD	SI,IXMOV,G33
G5:	MOV	@SP,R4
; Завершение оператора: для READ - запомнить новую позицию в DATPTR, для
; интерактивного INPUT - выключить курсор.
G6:	CLR	SAVJMP
	TST	DATINP
	BPL	G66
	MOV	R3,DATPTR
G66:	TST	(SP)+
	JMP	@(4)+		; продолжить (диспетчер шитого кода)
G33:	MOV	(SP)+,R4
; После значения - запятая (следующая переменная) или конец строки/DATA
; (готово); иначе - ошибка "Redo from start" (G4), перезапуск оператора.
G40:	TRAP	112		; пропуск пробелов
	CMPB	@R3,#',		; запятая?
        BEQ     G12		; да - к следующей переменной =>
        CMPB    @R3,#12		; конец строки?
        BEQ     G1		; да =>
	TST	DATINP
	BGT	G1
G4:     TRAP    13.		; ошибка - лишние символы после значения
        TST     (SP)+
        MOV     SAVJMP,R4	; перезапустить оператор с начала (см. GET::/GETLIT::)
	JMP	@-2(R4)
G41:	CMP	(SP)+,(SP)+	; снять сохранённые R4/R1 (число не разобралось)
	BR	G4		; ошибка "Redo from start"
; GETARR - вариант входа в GET для цели-элемента массива (см. TRAP 103/
; AKINPP): R1/R3 подготовлены компилятором, R0 - флаги типа элемента
; (перечитываются из кода) - дальше как для обычной переменной (G3).
GETARR::MOV     (SP)+,R1	; R1 = адрес значения элемента массива
        MOV     (SP)+,R3	; R3 = позиция в тексте
        MOV     -6(R4),R0	; R0 = флаги типа элемента
	BR	G3		; => общий разбор значения (как для обычной переменной)
;
; TODBL/TOSNG/TOINT - привести число, разобранное CISLO (на стеке; R2 - его
; тип), к типу цели (двойная, одинарная, целая) и записать. Вызываются как
; JSR R4 с тремя словами-операндами: преобразование (SD, ID, IS, SI), опкод
; записи (DXMOV, SXMOV, IXMOV), точка продолжения (G33). Целое, не влезающее в
; диапазон цели, - ошибки 6 и 5 (E1..E3).
TOINT::	MOV	(SP)+,R2	; R2 = признак типа разобранного числа
	BGE	1$
	MOV	R5,@(SP)+
	BR	G33
1$:	CMP	@SP,#44000
	BGE	E1
	CMP	@SP,#144000
	BLO	3$
	BNE	E1
	TSTB	3(SP)
	BNE	E1
3$:	TST	R2
	BNE	FROMS
FROMD:	MOV	(SP)+,2(SP)
	MOV	(SP)+,2(SP)
	JMP	@(R4)+
;
E1:
E2:
E3:	TRAP	6
	TRAP	5
;
TOSNG:	MOV	(SP)+,R2
	BMI	1$
	BNE	NOCONV
	ROL	4(SP)
	ADC	2(SP)
	ADC	@SP
	BVS	E2
	BCS	E2
	TST	(R4)+
	BR	FROMD
1$:	TST	-(R4)
	BR	FROMI
;
TODBL:	TST	(SP)+
	BEQ	NOCONV
	BPL	FROMS
	CMP	(R4)+,(R4)+
FROMI:	MOV	R5,-(SP)	; целое - положить значение для преобразования (IR)
NOCONV:	TST	(R4)+		; пропустить слово подпрограммы преобразования
FROMS:	JMP	@(R4)+		; выполнить преобразование/присваивание (шитый код)
;
ARR12:	TRAP	12.
;
; INDEX - вычислить адрес элемента массива. В коде после опкода: адрес записи
; массива в таблице переменных (слово: адрес данных или 0, если массив не
; создан; байт: число измерений) и число индексов в обращении; индексы - на
; стеке. Данные массива: размеры измерений (по слову на измерение), затем
; элементы. Если массив не создан: при выполнении программы создаётся неявно
; (одно измерение 0..10), в прямом режиме - ошибка 12. Число индексов не
; совпало с числом измерений - ошибка 9; индекс выходит за размер - ошибка 9,
; отрицательный - ошибка 5. Адрес элемента = свёртка индексов умножением (DAUG).
INDEX:: MOV     (R4)+,R1	; R1 = адрес записи массива
        MOV     (R1)+,R0	; R0 = флаг "уже объявлен через DIM"
        BNE     1$		; объявлен =>
	TSTB	LYGIS		; идёт выполнение программы (не прямой режим)?
	BEQ	ARR12		; нет - ошибка "массив не объявлен" =>
        MOV     ENDCOD,R0	; неявный DIM: R0 = текущий конец занятой памяти
	INC	R0
	BIC	#1,R0
        CMP     R0,CIKL		; хватает места под служебные слова?
        BHIS    AR7		; нет =>
        MOV     #11.,@R0	; отметить неявное измерение (по умолчанию 1)
        MOVB    #1,@R1		; отметить массив как объявленный
1$:     MOV     (R4)+,R3	; R3 = число индексов в обращении
        CMPB    R3,@R1		; совпадает с числом измерений массива?
        BNE     AR9		; нет - ошибка =>
        MOV     (SP)+,R1
        BMI     AR5
        CMP     R1,(R0)+
        BGE     AR9
2$:     DEC     R3
        BLE     3$
        MOV     (SP)+,R2
        BMI     AR5
        CMP     R2,@R0
        BGE     AR9
        MOV     R1,-(SP)
        MOV     -(R0),R1
        CALL    DAUG
        ADD     (SP)+,R1
        CMP     (R0)+,(R0)+
        BR      2$
3$:     MOV     -4(R4),R3
        MOVB    3(R3),R2
        CALL    DAUG
        ADD     R1,R0		; R0 = адрес элемента
        MOV     R0,-(SP)	; вернуть его на стек
        TST     (R3)+
        BEQ     4$
        JMP     @(R4)+		; продолжить (диспетчер шитого кода)
4$:     CMP     -(R4),-(R4)
;
; ARR10 - массив без DIM: размер измерения по умолчанию 10 (индексы 0..10).
ARR10::MOV      #10.,-(SP)	; размер измерения по умолчанию
;
ARRAY:: INC     ENDCOD
        BIC     #1,ENDCOD
AR1:    MOV     (R4)+,R0
        TST     (R0)+
        BNE     AR10
        MOV     @R4,R3
        MOV     ENDCOD,R0
        ADD     R0,R3
        CMP     R3,CIKL
        BHIS    AR7
        SUB     R0,R3
        MOV     (SP)+,R1
        BMI     AR5
        INC     R1
        BVS     AR7
        MOV     R1,(R0)+
1$:     DEC     R3
        BEQ     AR2
        MOV     (SP)+,R2	; R2 = размер очередного измерения (со стека)
        BLT     AR5		; отрицательный - ошибка =>
        INC     R2		; (индексы 0..N, значит N+1 элементов)
        BVS     AR7
        MOV     R2,(R0)+	; записать размер измерения
        CALL    DAUG
        BPL     1$
AR7:    TRAP    7
AR2:    MOV     -2(R4),R3
        MOVB    3(R3),R2
        CALL    DAUG
        BMI     AR7
        ADD     R1,R0
        BVS     AR7
        CMP     R0,CIKL
        BHI     AR7
        MOV     ENDCOD,(R3)+
        MOV     R0,ENDCOD
        MOVB    (R4)+,@R3
        INC     R4
        BIT     #400,@R3
        BEQ     3$
2$:     CLRB    -(R0)
        DEC     R1
        BGT     2$
        BR      4$
3$:     CLR     -(R0)
        SUB     #2,R1
        BGT     3$
4$:     TSTB    LYGIS
        BEQ     5$
        JMP     @(R4)+
5$:     JMP     STAR
AR5:    TRAP    5
AR9:    TRAP    9.
AR10:   TRAP    10.
;
DAUG::	MOV     R1,R5		; DAUG: R1 = R1*R2 сдвигами и сложениями (беззнаковое); R5 = -1 при переполнении
	CMP	R5,R2		; меньший из множителей - в R5
        BLOS    3$
        MOV     R2,R5
        MOV     R1,R2
3$:     CLR     R1
4$:     TST     R5		; R5 (множитель) исчерпан?
        BEQ     7$
        TST     R2		; слагаемое переполнило знак?
        BMI     6$
        ASR     R5		; очередной бит множителя
        BCC     5$
        ADD     R2,R1		; бит был 1 - прибавить
        BVS     6$
5$:     ASL     R2		; удвоить второй множитель
        BR      4$
6$:     MOV     #-1,R5		; переполнение - признак R5 = -1
7$:     RETURN
;
CHR::   BIT     #177400,@SP	; CHR$: код больше 255?
        BNE     IFCERR		; да - ошибка 5 =>
	MOVB	@SP,INK+1	; записать код в INK+1
        MOV     #INK+1,@SP	; адрес строки = INK+1
	MOV     #1,-(SP)	; длина 1
        JMP     @(R4)+
IFCERR:	TRAP	5
;
POKJMP::MOV     (SP)+,@(SP)+	; POKE: записать значение по адресу
        JMP     @(R4)+
;
OUTJMP::TST     (SP)+		; OUT: флаг (1 - установить биты, 0 - сбросить)
        BEQ     1$
        BIS     (SP)+,@(SP)+	; BIS: установить биты маской
        JMP     @(R4)+
1$:     BIC     (SP)+,@(SP)+	; BIC: сбросить биты маской
        JMP     @(R4)+
;
PEEK::  MOV     @(SP),(SP)	; PEEK: адрес на стеке заменить словом по адресу
        JMP     @(R4)+
;
INP::   MOV     @2(SP),2(SP)	; INP: значение по адресу
        COM     (SP)		; инвертировать маску
        BIC     (SP)+,(SP)	; значение AND маска
        JMP     @(R4)+
;
DFRE::  CMP     (SP)+,(SP)+
SFRE::  TST     (SP)+
IFRE::  TST     (SP)+
FRE::   MOV     CIKL,-(SP)	; FRE: свободно = CIKL - ENDCOD
        SUB     ENDCOD,@SP
ENDFRE: JMP     @(R4)+
;
$FRE::	TST	(SP)+		; $FRE: снять аргумент
	CALL	STRSQU		; сборка мусора строк
	MOV	FRELEN,@SP	; результат - свободное место в области строк
	JMP	@(R4)+
;
$SQUEE::CALL	STRSQU		; $SQUEE: сборка мусора строк
	JMP	@(R4)+
;
CLRMEM::			; CLRMEM: CLEAR с адресом HIMEM
	CMP	@SP,#70000	; адрес выше 70000 окт.?
	BHI	IFCERR		; да - ошибка 5 =>
	MOV	#IRPS2-10,@#BREAKW	; на время работы клавиша СТОП отключена
	CALL	CLOALL		; закрыть файл
	MOV	(SP)+,R2	; R2 = новый HIMEM
	ASR	R2		; округлить до чётного
	ASL	R2
	SUB	HIMEM,R2	; R2 = новый HIMEM - старый
	CALL	TABMOV		; сдвинуть таблицу строк программы
	ADD	R2,HIMEM	; HIMEM = новый
	CALL	CLRBUF		; пересоздать буфер файла
	CALL	CLRCOD		; сбросить указатели кода
	MOV	(SP)+,R0	; размер области строк
	INC	R0		; округлить до чётного
	BIC	#1,R0
	MOV	R0,STRSIZ	; STRSIZ = размер
	MOV	#BREAK,@#BREAKW	; вернуть обработчик СТОП
S1T:	JMP	STAR		; в монитор
;
TABMOV::MOV	TABTOP,R0
	ADD	R2,R0
	CMP	R0,TXEND	; новая вершина ниже конца текста?
	BLT	CLRERR		; да - ошибка памяти =>
	MOV	FCB,R1		; размер таблицы в байтах
	SUB	TABTOP,R1
	BEQ	4$		; таблица пуста =>
	ASR	R1		; в словах
	TST	R2		; сдвиг вверх или вниз?
	BMI	2$
	MOV	FCB,R3		; вверх: копировать с конца
	MOV	R3,R0
	ADD	R2,R0
3$:	MOV	-(R3),-(R0)
	SOB	R1,3$
	BR	4$
2$:	MOV	TABTOP,R3	; вниз: копировать с начала
5$:	MOV	(R3)+,(R0)+
	SOB	R1,5$
4$:	ADD	R2,TABTOP	; TABTOP сдвинут
	RETURN
;
CLRSTR::MOV	@SP,R0		; CLEAR n: R0 = новый размер области строк
	BLT	IFCERR		; отрицательный - ошибка 5 =>
	INC	R0		; округлить до чётного
	BIC	#1,R0
	MOV	R0,@SP
	SUB	STRSIZ,R0	;
	MOV	R0,R1		;АНАЛИЗ I-ГО АРГУМЕНТА
	ADD	ENDCOD,R0	;
	CMP	R0,LENT		; не хватает до стека кадров?
	BHI	CLRERR		; да - ошибка памяти =>
	MOV	(SP)+,STRSIZ	; STRSIZ = новый размер
	BR	CLR1
CLRERR:	TRAP	7
CLR::	CLR	R1		; CLEAR без аргумента: размер не меняется
;.............УСТАНОВКА ОБЛАСТИ ДЛЯ СТРОК..........
CLR1:	MOV	STRREG,R0	; R0 = STRREG - начало области строк
	MOV	#IRPS2-10,@#BREAKW
	MOV	R0,FREBEG	; FREBEG = начало
	MOV	STRSIZ,FRELEN	; FRELEN = размер
	MOV	LENT,LIMIT	; стек кадров пуст
	MOV	LENT,CIKL
	ADD     R1,ENDCOD	; ENDCOD сдвинут на изменение размера
;.........................СДВИГ МАССИВОВ...........
	ADD	STRSIZ,R0	; R0 -> конец области строк
	MOV	ENDCOD,R3	; R3 = новый ENDCOD
	MOV	R1,R5		; R5 = изменение размера
	BEQ	1$		; не изменился =>
	NEG	R1
	BMI	20$		; область выросла =>
	ADD	R0,R1
10$:	MOV	(R1)+,(R0)+	; сдвиг вперёд (область уменьшилась)
	CMP	R0,R3
	BLO	10$
	BR	1$
20$:	ADD	R3,R1
22$:	MOV	-(R1),-(R3)	; сдвиг с конца (область выросла)
	CMP	R3,R0
	BHI	22$
;...................ОЧИСТКА ПЕРЕМЕННЫХ.............
1$:	MOV	LENT,R2		; R2 -> таблица переменных
7$:	CMP	R2,TABTOP	; конец таблицы?
	BHIS	8$
	TSTB	@R2		; массив (бит 7 имени)?
	BPL	6$
	TST	(R2)+		; пропустить имя и слово
	TST	(R2)+
	BEQ	77$		; массив не создан =>
	ADD	R5,-(R2)	; поправить адрес данных массива на изменение
	CALL	MASREG		; R1 = размер массива без индексов
	MOV	(R2)+,R0	; R0 = адрес данных
	CLR	R3
	BISB	@R2,R3		; R3 = число измерений
	ASL	R3
	ADD	R3,R0		; R0 -> элементы массива (пропущены размеры измерений)
	ASR	R1		; в слова
2$:	CLR	(R0)+		; обнулить элементы
	SOB	R1,2$
77$:	TST	(R2)+
	BR	7$
6$:	MOV	(R2)+,R0	; скалярная: слово имени (тип)
	BMI	5$		; строка (бит 15) - 2 слова =>
	ASL	R0
	BMI	4$		; целая - 1 слово =>
	ASL	R0
	BMI	5$		; одинарная - 2 слова =>
	CLR	(R2)+		; двойная - ещё 2 слова
	CLR	(R2)+
5$:	CLR	(R2)+
4$:	CLR	(R2)+
3$:	BR	7$
8$:	MOV	#BREAK,@#BREAKW	; вернуть обработчик СТОП
	CMP	R4,STRREG	; R4 внутри кода программы?
	BLO	9$		; да - продолжить =>
 	BR	S1T		; нет (прямой режим) - в монитор
9$:	JMP	@(R4)+		; продолжить программу
;
; MID$(строка,позиция[,длина]) как выражение (в отличие от LMID/MIDMOV -
; присваивания, см. TRAP.MAC SIMFUN/MIDEND). На стеке: длина,адрес строки,
; позиция, и (для STR) явная длина результата сверху.
; STR2 - без явной длины: взять "до конца строки" - использовать длину
; самой строки (2(SP), уже на стеке) как верхнюю границу для STR1.
STR2::  MOV     2(SP),R0	; R0 = длина исходной строки (как предел длины результата)
        BR      STR1
;
; STR - с явной длиной результата (снята со стека, R0).
STR::   MOV     (SP)+,R0	; R0 = запрошенная длина результата
        BLT     A5		; отрицательная - ошибка =>
; STR1 - общий хвост: вычислить итоговые (длина,адрес) подстроки.
STR1:   MOV     (SP)+,R1	; R1 = позиция (1-based)
        BLE     A5		; позиция <= 0 - ошибка =>
        DEC     R1		; перевести в 0-based смещение
        ADD     R1,2(SP)	; сдвинуть адрес строки на это смещение
        SUB     R1,@SP		; длина -= смещение = сколько символов осталось от позиции
        BLE     A5		; позиция за концом строки - ошибка =>
        CMP     R0,@SP		; запрошенная длина не превышает остаток?
        BGE     1$		; не превышает =>
        MOV     R0,@SP		; превышает - обрезать до запрошенной длины
1$:     JMP     @(R4)+
;
ALLSK::	MOV	(SP)+,R5	; STRING$(n,код): R5 = код символа
	BIT	#177400,R5	; больше 255?
	BEQ	STRING		; нет - построить строку =>
A5:	TRAP	5
;
ALLSM::	TST	(SP)+		; STRING$(n,"s$"): длина строки s$
	BEQ	A5		; пустая - ошибка 5 =>
	MOVB	@(SP)+,R5	; R5 = первый символ
STRING: MOV	(SP),R1		; R1 = n (число повторов)
	BIT	#177400,R1	; больше 255?
	BNE	A5
	CALL	TSTFRE		; проверить место в области строк
	SUB	R1,FRELEN	; FRELEN -= n
	MOV	FREBEG,R2	; R2 = место для новой строки (FREBEG)
	MOV	R2,@SP		; адрес строки на стек
	MOV	R1,-(SP)	; длина
	BEQ	2$
1$:	MOVB	R5,(R2)+	; заполнить символом
	SOB	R1,1$
	MOV	R2,FREBEG	; FREBEG сдвинут
2$:	JMP	@(R4)+
;
CONCAT::MOV	(SP)+,R0
	MOV	(SP)+,R1
	MOV	@SP,R2
	ADD	R0,@SP		; итоговая длина = длина1 + длина2
	BIT	#177400,@SP	; итоговая длина > 255?
	BNE	2$		; да - ошибка =>
	ADD	2(SP),R2	; R2 = адрес1 + длина1 = место сразу за первой строкой
	TST	R0
	BEQ	3$		; вторая строка пуста - копировать нечего =>
1$:	MOVB	(R1)+,(R2)+	; дописать байты второй строки следом за первой
	SOB	R0,1$
3$:	SUB	FREBEG,R2	; R2 = насколько записанное продвинулось за FREBEG
	ADD	R2,FREBEG	; сдвинуть границу свободной области
	SUB	R2,FRELEN
        JMP     @(R4)+
2$:	TRAP	15.
;
LEN::   MOV     (SP)+,@SP	; LEN: снять адрес, длина остаётся
        JMP     @(R4)+
;
; Условие .IF EQ,1 ложно: INSTR/INSTR2 в эту сборку не входят.
    .IF EQ,1
INSTR::	MOV	(SP)+,R0
	MOV	(SP)+,R1
	MOV	(SP)+,R2	; R2 = длина строки, в которой ищем
	BEQ	I3		; строка пуста - не найдено =>
	MOV	(SP)+,R3	; R3 = адрес строки, в которой ищем
	MOV	(SP)+,R5	; R5 = позиция старта (1-based)
	BLE	A5		; <= 0 - ошибка =>
	CMP	R5,#255.	; > 255 - ошибка =>
	BHI	A5
	DEC	R5		; перевести в 0-based смещение
; I0 - общая точка входа (сюда же попадает INSTR2 с R5=0, без позиции старта).
I0:	MOV	R2,-(SP)	; запомнить полную длину строки поиска
	SUB	R5,R2		; R2 = сколько символов осталось от позиции старта
	BLE	A5		; старт за концом строки - ошибка =>
	ADD	R3,R5		; R5 = адрес, с которого начинать сканирование
	MOV	R0,-(SP)	; запомнить длину искомой строки
	BEQ	I6		; искомая строка пуста - результат = сама позиция старта =>
; Сканировать в поисках символа, совпадающего с первым символом искомой строки.
I1:	MOV	R1,-(SP)	; запомнить адрес искомой строки (для сверки с начала)
1$:	CMPB	(R5)+,(R1)	; символ строки поиска = первый символ искомой?
	BEQ	I5		; да - попробовать сверить целиком =>
	SOB	R2,1$		; нет - следующий символ
; Не найдено (дошли до конца строки поиска).
I2:	TST	(SP)+		; снять сохранённый адрес искомой строки
I3:	TST	(SP)+		; снять сохранённую длину искомой строки
I4:	CLR	@SP		; результат 0 (не найдена)
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
; Первый символ совпал - сверить искомую строку целиком с этой позиции.
I5:	CMP	R2,R0		; оставшихся символов хватает на всю искомую строку?
	BLT	I2		; нет - не найдено =>
	MOV	R5,-(SP)	; запомнить текущую позицию сканирования
	DEC	R5		; вернуться к только что совпавшему символу
8$:	CMPB	(R5)+,(R1)+	; посимвольная сверка искомой строки
	BNE	I7		; не совпало - продолжить сканирование дальше =>
	SOB	R0,8$
	CMP	(SP)+,(SP)+	; совпало целиком - снять сохранённые позицию и адрес
I6:	TST	(SP)+		; снять сохранённую длину искомой строки
	DEC	R2
	SUB	R2,@SP		; результат = позиция найденного совпадения (1-based)
	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
; Символ не совпал при полной сверке - вернуться к сканированию со следующей позиции.
I7:	MOV	(SP)+,R5	; восстановить позицию сканирования
	MOV	(SP)+,R1	; восстановить адрес искомой строки (сначала)
	MOV	(SP),R0		; восстановить длину искомой строки (не снимая)
	DEC	R2
	BR	I1
;
INSTR2::MOV	(SP)+,R0
	MOV	(SP)+,R1
	MOV	(SP)+,R2	; R2 = длина строки, в которой ищем
	BEQ	I4		; строка пуста - не найдено =>
	MOV	(SP)+,R3	; R3 = адрес строки, в которой ищем
	CLR	R5		; смещение старта = 0
	BR	I0		; => общий код поиска (см. INSTR)
    .ENDC
;
ASC::   TST     (SP)+		; ASC: длина строки
	BEQ	A5		; пустая - ошибка 5 =>
	CLR	R0
	BISB	@(SP)+,R0	; R0 = первый символ
        MOV     R0,-(SP)
	JMP	@(R4)+
;
VAL::	MOV	R4,SAVJMP	; запомнить позицию (для PACK - как признак контекста)
	CALL	PACK		; разобрать строку (адрес,длина на стеке) в число
	MOV	SAVJMP,R4
	CLR	SAVJMP
	TST	(SP)+
	JMP	@(R4)+
;
SSTR::	CALL	EGO		; STR$ одинарной точности (EGO - число в текст)
	JMP	@(R4)+
;
DSTR::	CALL	DGO		; STR$ двойной точности (DGO)
	JMP	@(R4)+
;
ISTR::	MOV	(SP)+,R5	; STR$ целого: R5 = число
	CALL	ISGUNP		; в текст в BUFOUT (R1 = адрес, R2 = длина)
	MOV	R1,-(SP)	; адрес на стек
	MOV	R2,-(SP)	; длина на стек
	JMP	@(R4)+
;
OCT::	CLR	R0
	MOV	#BUFOUT+6,R1
	MOV	(SP)+,R5
1$:	MOV	R5,R2
	BIC	#177770,R2
	ADD	#'0,R2
	MOVB	R2,-(R1)
	INC	R0
	CLC
	ROR	R5
	ASR	R5
	ASR	R5
	BNE	1$
	MOV	R1,-(SP)
	MOV	R0,-(SP)
	JMP	@(R4)+
;
BIN::	CLR	R0
	MOV	#BUFOUT+16,R1
	MOV	(SP)+,R5
1$:	MOV	R5,R2
	BIC	#177776,R2
	ADD	#000060,R2
	MOVB	R2,-(R1)
	INC	R0
	CLC
	ROR	R5
	BNE	1$
	MOV	R1,-(SP)
	MOV	R0,-(SP)
	JMP	@(R4)+
;
HEX::	CLR	R0
	MOV	#BUFOUT+4,R1
	MOV	(SP)+,R5
3$:	MOV	R5,R2
	BIC	#177760,R2
	CMP	R2,#9.
	BLE	1$
	ADD	#000067,R2
	BR	2$
1$:	ADD	#000060,R2
2$:	MOVB	R2,-(R1)
	INC	R0
	CLC
	ROR	R5
	ASR	R5
	ASR	R5
	ASR	R5
	BNE	3$
	MOV	R1,-(SP)
	MOV	R0,-(SP)
	JMP	@(R4)+
;
DS::	ROL	4(SP)		; DS: двойная в одинарную - округлить 4 слова до 2
	ADC	2(SP)
	ADC	(SP)
	BVS	1$		; переполнение - ошибка 6
	BCS	1$
	MOV	(SP)+,2(SP)	; убрать два младших слова
	MOV	(SP)+,2(SP)
	JMP	@(R4)+
1$:	TRAP	6
;
IDIV::	MOV	(SP)+,R2	; \ : R2 = делитель
	MOV	@SP,R1
	CALL	DAL		; DAL: R1 = частное, R3 = остаток
	MOV	R1,@SP		; частное
	JMP	@(R4)+
;
MOD::	MOV	(SP)+,R2	; MOD: R2 = делитель
	MOV	@SP,R1
	CALL	DAL
	MOV	R3,@SP		; остаток
	JMP	@(R4)+
;
SUM::	ADD	(SP)+,@SP	; SUM: сложение целых (Lith. suma)
SUMPAB:	BVS	OVF		; переполнение - ошибка 6
	JMP	@(R4)+
OVF:	TRAP	6
;
SKIRT::	SUB	(SP)+,@SP	; SKIRT: вычитание целых (Lith. skirtumas)
	BR	SUMPAB
;
SAND::	CLR	R0		; SAND: умножение целых (Lith. sandauga); R0 - знак результата
	MOV	(SP)+,R2
	BGE	1$
	INC	R0
	NEG	R2
1$:	MOV	@SP,R1
	BGE	2$
	DEC	R0
	NEG	R1
2$:	CALL	DAUG		; умножить модули
	TST	R5		; переполнение?
	BLT	OVF
	TST	R0
	BEQ	3$
	NEG	R1
3$:	MOV	R1,@SP
	JMP	@(R4)+
;
DAL:	CLR	R0		; DAL: деление знаковых R1/R2 (Lith. dalyba): R1 = частное, R3 = остаток
	MOV	R1,R3
	BPL	1$
	NEG	R3
	BMI	OVF
	INC	R0
1$:	TST	R2
	BEQ	2$
	BPL	3$
	NEG	R2
	BIS	#2,R0
3$:	MOV	R2,R5
	CLR	R1
5$:	CMP	R2,R3
	BHI	4$
	ASL	R2
	BR	5$
4$:	CMP	R2,R5
	BEQ	6$
	CLC
	ROR	R2
	ASL	R1
	CMP	R2,R3
	BHI	4$
	SUB	R2,R3
	INC	R1
	BR	4$
6$:	ASR	R0
	BCC	7$
	NEG	R1
	NEG	R3
7$:	TST	R0
	BEQ	8$
	NEG	R1
8$:	RETURN
2$:	TRAP	11.		; деление на 0 - ошибка 11
;
ADLOG::	.WORD	IMP,EQV,XOR,OR,AND
;
NOT::	COM	@SP		; NOT: поразрядная инверсия
	JMP	@(R4)+
OR::	BIS	(SP)+,@SP	; OR
	JMP	@(R4)+
AND::	COM	@SP		; AND (через инверсию и BIC)
	BIC	(SP)+,@SP
	JMP	@(R4)+
XOR::	MOV	@SP,R0		; XOR
	BIC	2(SP),R0
	BIC	(SP)+,@SP
	BIS	R0,@SP
	JMP	@(R4)+
EQV::	COM	@SP		; EQV = NOT XOR
	BR	XOR
IMP::	COM	2(SP)		; IMP = (NOT a) OR b
	BIS	(SP)+,@SP
	JMP	@(R4)+
;
$DEFUS::MOV	(SP)+,@(R4)+	; DEF USRn=адрес: записать адрес в USRTAB
	JMP	@(R4)+
;
OPINP::	MOV	#3,R1		; OPEN FOR INPUT: режим 3 (чтение)
	BR	OPFILE
;
OPOUT::	MOV	#2,R1		; OPEN FOR OUTPUT: режим 2 (запись)
OPFILE:				;MOV	MAXFIL,R3	;JEI NERA AS#
;	MOV	(SP)+,R3	;JEI  YRA AS#
;	BLE	BADFN
;	CMP	R3,MAXFIL
;	BHI	BADFN
	CALL	FNDBUF		; получить блок управления файлом (FCB)
	TST	(0)+
	BNE	2$		; файл уже открыт - ошибка =>
	CALL	NAMTYP
	SUB	#22,R0
	MOV	R1,@R0
	ROR	R1
	BCC	10$
	CALL	CASCII
	CALL	CAS
	CALL	ISVARD
10$:	JMP	@(R4)+		; продолжить (диспетчер шитого кода)
2$:	TRAP	54.		; ошибка - файл уже открыт
BADFN:	TRAP	52.		; ошибка - недопустимое имя файла (сейчас недостижимо)
;
; FNDBUF - получить FCB. В этой (однофайловой) версии просто фиксированное
; смещение от FCB; закомментированный код - остатки поддержки нескольких
; открытых файлов (по номеру AS#, см. выше).
FNDBUF::MOV	FCB,R0		; FNDBUF: R0 -> буфер файла (под HIMEM)
;	SUB	#22,R0
1$:	ADD	#400,R0		;VELIAU #422
;	SOB	R3,1$
	RETURN
;
NAMTYP::MOV	4(SP),R3
	MOV	(SP)+,2(SP)
	MOV	(SP)+,R2
	MOV	R4,SAVJMP	; запомнить позицию (контекст для возможной ошибки)
	CALL	TTANAL		; разобрать необязательный префикс устройства
	MOV	SAVJMP,R4
	CLR	SAVJMP
	TST	R2
	BLOS	5$
	MOV	#6,R5		; до 6 символов имени
; Скопировать символы имени (до точки или конца текста, или 6 символов).
1$:	CMPB	(R3),#'.	; точка (начало расширения)?
	BEQ	6$		; да =>
	MOVB	(R3)+,(R0)+	; скопировать символ имени
	DEC	R5
	BEQ	3$		; имя набрало 6 символов =>
	SOB	R2,1$
2$:	MOVB	#40,(R0)+	; текст кончился раньше 6 символов - дополнить пробелами
	SOB	R5,2$
3$:	DEC	R2
	BGT	4$
	CALL	DAT
	RETURN
4$:	CMPB	@R3,#'.		; далее действительно точка (расширение)?
	BEQ	7$		; да =>
5$:	TRAP	56.		; нет - ошибка (лишние символы в имени)
6$:	MOVB	#40,(0)+	; имя короче 6 символов - дополнить пробелами
	SOB	R5,6$
; Скопировать символы расширения (после точки).
7$:	MOV	#4,R5
8$:	MOVB	(3)+,(0)+	; скопировать символ расширения
	DEC	R5
	BEQ	10$
	SOB	R2,8$
9$:	MOVB	#40,(0)+	; расширение короче - дополнить пробелами
	SOB	R5,9$
10$:	DEC	R2
	BGT	5$		; текст ещё остался - ошибка (лишние символы) =>
	CALL	BLOCK0
	RETURN
;
DEVICE::MOV	#1,IODEV	;MAXFIL,IODEV		;VERSIJA 1
	JMP	@(R4)+
;	MOV	(SP)+,IODEV
;	BLE	NOTOP
;	CMP	IODEV,MAXFIL
;	BGT	INIPRP		;VELIAU - BLOS
NOTOP:	TRAP	59.
;
DEVLP::	MOV	#-1,IODEV	; LPRINT: вывод на принтер/ИРПС (IODEV = -1)
INIPRP::JMP	@(4)+
;
CLRDEV::CLR	IODEV		; вернуть вывод на экран (IODEV = 0)
	JMP	@(R4)+
;
CLOFIL::
;	MOV	(R4)+,R2
;	BEQ	3$
;1$:	MOV	(SP)+,R3
;	BEQ	2$
;	CMP	R3,MAXFIL
;	BHI	BADFN
;	CALL	FNDBUF
;	CALL	CLOF
;2$:	SOB	R2,1$
;	JMP	@(R4)+
3$:	CALL	CLOALL
	JMP	@(R4)+
;
CLOALL::			;MOV	MAXFIL,R2
;	BEQ	5$
	MOV	HIMEM,R0	; R0 = HIMEM
4$:	SUB	#422,R0		; R0 -> блок файла (422 окт. байт под HIMEM)
;	CALL	CLOF
;	SOB	R2,4$
;5$:	RETURN
;
CLOF:	MOV	(R0),R3		; CLOF: R3 = слово состояния файла (0 - не открыт)
	BEQ	2$
	RORB	R3		; бит 0: файл открыт на чтение?
	BCS	3$		; да =>
	CLRB	R3		; запись: позиция в буфере блока
	SWAB	R3
	ADD	R0,R3
	ADD	#22,R3
	CALL	CLOUTF		; CLOUTF: дописать последний блок
1$:	CLR	(0)		; файл закрыт
2$:	RETURN
3$:	CALL	CASCII		;CLINF
	CALL	LASTBL		; имя блока по умолчанию
	CALL	CAS		; прочитать (закрыть)
	BR	1$
;
CLOUTF::MOVB	#32,@R3		;^Z
	CALL	CASCII		; подготовить блок параметров
	CALL	CAS		; записать последний блок
	CALL	LASTBL		; имя для конечного блока
	CLR	@MAG+2		; адрес данных 0
	MOV	#2,MAG+4	; длина 2
	CALL	CAS		; записать пустой блок (конец файла)
	RETURN
;
FNDCHR:	MOV	IODEV,R3	; FNDCHR: IODEV <= 0 (нет файла) - ошибка 59 =>
	BLE	NOTOP
FNDCR:	CALL	FNDBUF		; найти блок файла
	BITB	#1,(0)+		; файл открыт на чтение?
	BEQ	BADFN		; нет - ошибка 52 =>
	CLR	R3		; R3 = позиция чтения в буфере
	BISB	@R0,R3
	ADD	R0,R3
	ADD	#21,R3
	RETURN
;
EOF::	CLR	-(SP)		; EOF: ^Z в текущей позиции - конец файла
	CALL	FNDCR
	CMPB	@R3,#32		;^Z
	BNE	1$
	COM	@SP		; да - результат -1
1$:	JMP	@(4)+
;
FILINP:	CALL	FNDCHR		; FILINP: найти файл, R5 -> состояние
	MOV	R0,R5
	ADD	#21,R5
COPYIN::MOV	#BUF,R1		; COPYIN: копировать строку (до LF) из блока файла в BUF
1$:	CMPB	@R3,#32		; ^Z - конец файла?
	BEQ	3$
	CMP	R1,#BUF+420	; строка длиннее 420 окт.?
	BHIS	4$
	MOVB	(3)+,(1)	; скопировать символ
	INCB	(0)		; счётчик байт блока исчерпан?
	BNE	2$
	MOV	R1,-(SP)
	MOV	R0,-(SP)
	DEC	R0
	SUB	#400,R3		; назад к началу блока
	CALL	BLOCKN		; увеличить номер блока в имени
	CALL	CASCII
	CALL	CAS		; прочитать следующий блок
	CALL	ISVARD
	MOV	(SP)+,R0
	MOV	(SP)+,R1
2$:	CMPB	(1)+,#12
	BNE	1$
3$:	MOVB	#12,@R1		; завершить строку LF
	RETURN
4$:	TRAP	25.		; ошибка 25 - строка слишком длинная
;
; STRSQU - сборка мусора в области строк (алгоритм: сначала найти среди всех
; строковых переменных и элементов строковых массивов строку с наименьшим
; адресом не ниже R3, затем перенести её на R3 (PERK) и повторять, пока строк
; не останется - результат: все живые строки плотно в начале области, FREBEG и
; FRELEN пересчитываются). Строки без владельца (потерянные значения) при этом
; затираются. Обходит таблицу переменных процедурой FIND; для массивов -
; SSQ1/SSQ2 (3-байтовые дескрипторы элементов: длина, адрес).
STRSQU::MOV	R4,SAVJMP	; R4 запомнить в SAVJMP; R3 - новый FREBEG (NAUJAS FREBEG)
	MOV	R5,-(SP)	; R5 сохранить; R0 - начало переносимой строки (PERKELIAMO MAS. PRADZIA)
	MOV	STRREG,R3	; R3 = STRREG - начало области строк; R2 - указатель по таблице переменных после LENT
	MOV	R3,-(SP)	; @SP - конец области строк (STRREG GALAS)
	ADD	STRSIZ,@SP	; конец = STRREG + STRSIZ
40$:	MOV	@SP,R0		; R0 = минимальный найденный адрес (пока конец области)
	MOV	LENT,R2		; R2 -> таблица переменных
8$:	CMP	R2,TABTOP	; конец таблицы?
	BHIS	58$		; да - проход 1 завершён =>
	JSR	R4,FIND		; FIND: +0 не строка, +1 строковый массив, +2 строковая переменная
	BR	8$		; не строка - следующая запись =>
	BR	1$		; строковый массив =>
	TST	(R2)+		; строковая переменная: пропустить слово длины
	BEQ	7$		; длина 0 - строки нет =>
	CMP	@R2,R0		; адрес не меньше найденного минимума?
	BHIS	7$		; да - пропустить =>
	CMP	@R2,R3		; адрес меньше начала нераспределённой части (R3)?
	BLO	7$		; да (уже уплотнена) - пропустить =>
	MOV	@R2,R0		; новый минимум адреса строки
7$:	TST	(R2)+		; к следующей записи
	BR	8$
1$:	CALL	SSQ1		; массив: R5 -> дескрипторы, R1 - конец
38$:	CALL	SSQ2		; прочитать очередной дескриптор (R4 = адрес строки)
	CMP	R4,R0		; не меньше минимума?
	BHIS	39$
	CMP	R4,R3		; меньше R3 (уже уплотнена)?
	BLO	39$
	MOV	R4,R0		; новый минимум
39$:	CMP	R5,R1		; все дескрипторы массива просмотрены?
	BLO	38$
	CMP	(R2)+,(R2)+	; к следующей записи
	BR	8$
58$:	CMP	R0,@SP		; минимум остался равным концу - живых строк выше R3 нет?
	BEQ	22$		; да - готово =>
	MOV	LENT,R2		; проход 2: найти владельца строки по адресу R0
14$:	JSR	R4,FIND		; FIND
	BR	14$		; не строка =>
	BR	11$		; строковый массив =>
	TST	(R2)+		; строковая переменная: длина строки не 0?
	BNE	3$		; да =>
	TST	(R2)+		; нет - следующая запись
	BR	14$
3$:	CMP	(R2)+,R0	; адрес строки совпал с R0?
	BNE	14$		; нет - дальше
	MOV	R3,-(R2)	; записать в переменную новый адрес (R3)
	MOV	-(R2),R1	; R1 = длина
	CALL	PERK		; перенести строку на новое место (PERK), R3 += длина
	BR	40$		; и повторить с поиска следующего минимума
11$:	CALL	SSQ1		; массив: R5 -> дескрипторы, R1 - конец
37$:	CALL	SSQ2		; прочитать дескриптор
	CMP	R4,R0		; адрес совпал с R0?
	BEQ	36$		; да =>
	CMP	R5,R1		; все дескрипторы просмотрены?
	BLO	37$
	CMP	(R2)+,(R2)+	; к следующей записи
	BR	14$
36$:	SWAB	R3		; записать новый адрес (R3) в 3-байтовый дескриптор
	MOVB	R3,-(R5)
	SWAB	R3
	MOVB	R3,-(R5)
	CLR	R1		; R1 = длина строки из дескриптора
	BISB	-(R5),R1
	CALL	PERK		; перенести строку
	BR	40$
22$:	MOV	R3,FREBEG	; FREBEG = конец уплотнённой части
	SUB	R3,@SP		; FRELEN = размер свободного остатка
	MOV	(SP)+,FRELEN
	MOV	(SP)+,R5
	MOV	SAVJMP,R4	; вернуть R4
	CLR	SAVJMP
	RETURN
PERK:	CMP	R0,R3		; PERK: перенести R1 байт со старого адреса R0 на новый R3, R3 += R1 ;R0 - SENAS (старый)
	BEQ	3$		;R3 - NAUJAS
1$:	MOVB	(R0)+,(R3)+	;R1 - ILGIS
	SOB	R1,1$
	RETURN
3$:	ADD	R1,R3		; только сдвинуть R3
	RETURN
MASREG::MOV	R0,-(SP)	; MASREG: R1 = размер массива в байтах без размеров измерений ;R2 -> VARD.+2 (R2 -> имя+2)
	MOV	R2,-(SP)
	MOV	R3,-(SP)
	MOV	(R2)+,R3	; R3 = адрес данных массива
	CLR	R0		; R0 = число измерений
	BISB	(R2)+,R0
	MOVB	@R2,R1		; R1 = размер элемента в байтах
1$:	MOV	(R3)+,R2	; R2 = размер очередного измерения
	CALL	DAUG		; R1 *= R2
	SOB	R0,1$
	INC	R1		; округлить до чётного
	ASR	R1
	ASL	R1		;R1<- MAS. ILG. BE IND.
	MOV	(SP)+,R3
	MOV	(SP)+,R2
	MOV	(SP)+,R0
	RETURN
;
SSQ1:	CALL	MASREG		; SSQ1: R1 = конец, R5 = начало дескрипторов элементов строкового массива
	ADD	(R2)+,R1	; плюс адрес данных
	CLR	R5
	BISB	@R2,R5		; R5 = число измерений
	ASL	R5
	ADD	R5,R1		; пропустить размеры измерений
	ADD	-(R2),R5
	RETURN
SSQ2:	CLR	R4		; SSQ2: R4 = адрес строки из 3-байтового дескриптора (0 - пустая), R5 продвинут
	TSTB	(R5)+		; длина 0?
	BEQ	1$		; да - пропустить адрес =>
	BISB	(R5)+,R4	; собрать адрес из двух байт
	SWAB	R4
	BISB	(R5)+,R4
	SWAB	R4
	RETURN
1$:	CMPB	(R5)+,(R5)+	; пустая строка: пропустить два байта
	RETURN
FIND:	TSTB	@R2		; FIND: +0 не строка, +1 слово - строковый массив, +2 слова - строковая переменная ;IEJ.: R2-> VARD. (вход: R2 -> имя)
	BPL	6$		;	R4= GRAZ. ADR.
	TST	(R2)+		;ISEJ:	+0	NESIMB.	R2->SEK.VARD.
	BMI	1$		;	+2	SIMB.MAS. R2->VARD.+2
	BR	3$		;	+4	SIMB.KINT. --//---
6$:	MOV	(R2)+,R1	;	R1 GADINA
	BMI	5$		; строка (бит 15) =>
	ASL	R1		; целая?
	BMI	2$		; да - 1 слово =>
	ASL	R1		; одинарная?
	BMI	3$		; да - 2 слова =>
	CMP	(R2)+,(R2)+	; двойная: 4 слова (2 здесь и 2 ниже)
3$:	TST	(R2)+
2$:	TST	(R2)+
	RTS	R4		; не строка
5$:	TST	(R4)+		; строковая переменная
1$:	TST	(R4)+
	RTS	R4		; строковый массив
;
$USR::	MOV	SP,R5		; $USR: R5 = SP (аргумент), R0 = номер процедуры
	MOV	(R4)+,R0
	MOV	(R4)+,R3	; R3 = данные
	MOV	R4,SAVJMP	; запомнить R4 (процедура может испортить)
	CALL	@USRTAB(R0)	; вызвать машинную подпрограмму
	MOV	SAVJMP,R4
	CLR	SAVJMP
	JMP	@(R4)+
;
; Условие .IF EQ,1 ложно: оператор ERASE ($ERASE) в эту сборку не входит.
    .IF EQ,1
$ERASE::TST	@R4
	BEQ	$ER0
3$:	MOV	(R4)+,R2
	BEQ	$EREND
	TST	@R2
	BEQ	1$
	CALL	MASREG
	MOV	@R2,R3
	CLR	(R2)+
	CLR	R0
	BISB	@R2,R0
	CLRB	@R2
	ASL	R0
	ADD	R0,R1
	MOV	R3,R2
	ADD	R1,R2
	MOV	R3,R0
6$:	MOV	(R2)+,(R3)+
	CMP	R2,ENDCOD
	BLO	6$
	MOV	R3,ENDCOD
	MOV	LENT,R2
2$:	TSTB	@R2
	BPL	7$
	TST	(R2)+
	CMP	@R2,R0
	BLO	8$
	SUB	R1,@R2
8$:	CMP	(R2)+,(R2)+
	BR	9$
7$:	CALL	PRAL
9$:	CMP	R2,TABTOP
	BLO	2$
	BR	3$
1$:	TRAP	5
;
PRAL:	TSTB	@R2
	BMI	1$
	MOV	(R2)+,R1
	BMI	1$
	ASL	R1
	BMI	8$
	ASL	R1
	BMI	1$
	CMP	(R2)+,(R2)+
1$:	TST	(R2)+
8$:	TST	(R2)+
	RETURN
;
$ER0:	MOV	LENT,R2
1$:	TSTB	@R2
	BMI	2$
	CALL	PRAL
	BR	4$
2$:	TST	(R2)+
	CLR	(R2)+
	CLRB	(R2)+
	INC	R2
4$:	CMP	R2,TABTOP
	BLO	1$
	MOV	STRREG,R0
	ADD	STRSIZ,R0
	MOV	R0,ENDCOD
	TST	(R4)+
$EREND:	JMP	@(R4)+
;
    .ENDC
	.END
