	HS=3

	MAGSIZ==54	;30
	WR.==20
	RD.==10
	FR.==14		;30
	NER.==1
	MER.==2
	FER.==3
	RER.==10
	SER.==-1

	NAMEW==4	;10
	ADRW==24	;4
	LENW==26	;6
	NAMER==30	;10
	ADRR==50	;4
	LENR==52	;6

	FLEN=4

.Macro	.Dw	Name,Type
	Name	== Count
	.If	B	Type
	Count	= Count + 2
	.Iff
	Count	= Count + <Type*2>
	.EndC
.EndM


.Macro	.Db	Name,Type
	Name	== Count
	.If	B	Type
	Count	= Count + 1
	.Iff
	Count	= Count + Type
	.Endc
.EndM



Count	=	STACK

