;------------------------------------------------------------------------------
; FONT - образы 9 знаков MASSIM для интерфейса IDE: по 11 байт (11 строк
; развёртки, 8 точек в строке, старший бит - слева, по форме стрелок). SwpFnt
; (IDE.MAC) подставляет их в таблицу шрифта ПП (14542, 9 указателей) вместо
; прежних, RSTFNT возвращает. Знаки 200-210 (восьм.) используют WINDOW.MAC и
; EDIT.MAC: стрелки и бегунок полос прокрутки, точка переключателя, тени
; кнопок и окон. Таблица указателей шрифта ПЗУ - 14142 (слово на код, 256 слов),
; слот кода 200 - 14542 (14142 + 2 * 200), то есть слоты соответствуют кодам
; 200-210 (проверено по RAM.LST); назначение знаков - по применению в IDE
;------------------------------------------------------------------------------
.PSECT	DATA


				; 200: стрелка вверх (начало полосы)
MASSIM::.BYTE	0  ,20 ,20 ,70 ,70 ,174,174,376,376,0  ,0
				; 201: стрелка вниз (конец полосы)
	.BYTE	0  ,376,376,174,174,70 ,70 ,20 ,20 ,0  ,0
				; 202: стрелка влево (начало полосы)
	.BYTE	0  ,200,300,340,370,376,370,340,300,200,0
				; 203: стрелка вправо (конец полосы)
	.BYTE	0  ,2  ,6  ,16 ,76 ,376,76 ,16 ,6  ,2  ,0
				; 204: дорожка полосы (шашка)
	.BYTE	325,253,325,253,325,253,325,253,325,253,325
				; 205: точка переключателя "( )"
	.BYTE	0  ,0  ,0  ,0  ,30 ,74 ,74 ,30 ,0  ,0  ,0
				; 206: бегунок полосы
	.BYTE	0  ,0  ,0  ,176,176,176,176,176,0  ,0  ,0
				; 207: тень справа (нижние 6 строк)
	.BYTE	0  ,0  ,0  ,0  ,0  ,377,377,377,377,377,377
				; 210: тень снизу (верхние 5 строк)
	.BYTE	377,377,377,377,377,0  ,0  ,0  ,0  ,0  ,0


.END
