; Автор модуля: Саша Акулин
;
;******************************************************************************
;*                  Оконная система IDE (Turbo Basic для УКНЦ)                *
;******************************************************************************
;
; Модуль выполняется в периферийном процессоре (ПП) в составе резидента IDE
; (секция SYSTEM, образ Ide.Sav). Рисует окна, меню и диалоги, читает клавиши
; и вызывает обработчики выбранных пунктов. Сами окна описаны статически в
; IDDAT.MAC и IDDAT2.MAC (макросы .WIND, .BUTON, .EDIT, .USER, .ENDS в IDE.MLB),
; здесь только код. Вызывается из IDE.MAC, EDIT.MAC, UPEXEC.MAC, HELP.MAC.
;
; Точки входа (макросы IDE.MLB):
;	WINDOW	#окно		открыть окно (-> $WIND), R4 = адрес описания
;	WCLOSE			закрыть последнее окно ($CLOSE), C=1 - окон нет
;	UPMENU	#меню		верхнее меню (-> $UPMEN)
;	PRINT	адрес		вывести строку (-> PR)
;	COLOR	цвет,фон	задать цвет вывода (-> $COLOR)
;	LOCATE	X,Y		позиция курсора на экране (-> $LOCAT)
;	KEYJMP	#таблица	переход по коду клавиши (-> $KJMP)
;
; Описание окна (R4 -> описание; относительные координаты X, Y внутри окна):
;	+0	слово	адрес заголовка / текста пунктов (см. $WIND, $INBAR)
;	+2	байт	W0: тип окна, биты MEMORY=1 запомнить фон, EXE=2 сразу
;			выполнять цикл ввода, SHADOW=4 тень, BARS=10 двойная
;			рамка (диалог); MENU, DIALOG, PRINT - комбинации
;	+3,+4	байты	W1,W2: координаты X, Y левого верхнего угла
;	+5,+6	байты	W3,W4: ширина и высота
;	+7	байт	цвет (биты 0-2 символ, 4-6 фон), см. $COLOR
;	+10	слово	для меню - с этого места слова-адреса обработчиков
;			пунктов (по слову на пункт); для диалога (BARS) -
;			адрес текста тела окна
;	+12	...	для диалога - список элементов (см. ниже)
; Элемент диалога начинается со слова-кода: 0 - конец списка (дальше слово -
; адрес обработчика по Enter, JMPADR); 1 - группа переключателей "( )" (выбран
; один, значение = номер); 2 - группа флажков "[X]" (значение = маска битов);
; 3 - строка ввода (.EDIT); 4 - процедура пользователя (.USER); любое число
; >= 400 - кнопка (.BUTON), это адрес её надписи. Адрес обработчика с битом
; 0 = 1 вызывается как подпрограмма (после неё окно остаётся), иначе окно
; закрывается и выполняется переход. В комментариях $TREX коды 1 и 2 названы
; "триггерный" и "селективный список"; значение кодов - по разбору $$TSPR.
;
; Рабочие переменные (VAR.MAC): W0-W4 (копия заголовка окна, см. $COP), WA
; (адрес текущего окна), WBUF/WBPNT (стек сохранённых фонов, запись 6 байт:
; X, Y, ширина с рамкой и тенью, высота, адрес копии в видеопамяти), WAREA
; (номера пунктов меню, перед которыми разделитель), JMPADR, KEYCOD (код
; клавиши, закрывшей окно), TMP,
; B.PTR/BAREA (отложенное восстановление полей ввода при отказе).
;
; Обращения к оборудованию и системе ПП (формат не выяснен до конца):
;	177010	регистр адреса доступа к видеопамяти; 177012, 177014, 177024 -
;		регистры данных (по плоскостям изображения, назначение 177024
;		уточнить); 177016, 177020, 177022 - запись цвета/палитры.
;		$$TSPR и $WER читают через 177010 и 177012 и прежнее значение
;		поля ввода - в какой памяти оно лежит, не выяснено
;	@#2476	начало связного списка строк экрана (шаг 52), см. $GETY
;	@#23150	структура текущего экрана/курсора (смещения 0-70), см. $$LC
;	@#22656	таблица цветов, +34..+44 используются в $COLOR
;	EMT 22	прочитать код клавиши в R0 (ждать)
;	EMT 42	вывести символ из R0 в текущую позицию
;	TRAP 0	вывести строку TTBUF через очередь терминала ($$PR)
;
; Соглашения: символ с ведущим $ - подпрограмма модуля; REL перед командой
; (макрос .RelDef G) заносит её адресное слово в таблицу релокации RELTAB, чтобы
; инсталлятор (IDE.MAC, IdeIni) настроил адрес после загрузки резидента в ПП.
; Многие подпрограммы сохраняют регистры вызовом $PUSH/$POP (R0-R5, 177010).
; Коды клавиш (DEFINE в IDE.MLB): UP=200, DOWN=201, RIGHT=202, LEFT=203,
; ENTER=15, ESCAPE=33, TAB=11, FK1..FK10=204..215, DEL=216, INS=217.
; Модуль использует самомодифицирующийся код (DEC (PC)+, 3$+2, $$$1 и т.п. в
; $SHDW, $SAVE, $CLOSE, $INV) - при правке учитывать.
;
	.INCLUDE/IDE.MLB/
	Define			; Коды клавиш, цвета, биты типа окна (IDE.MLB)
	.RelDef	G


	.PSECT	SYSTEM
;------------------------------------------------------------------------------
; $COLOR - установить цвет вывода (макрос COLOR)
; Вход: в стеке слово, младший байт = цвет: биты 0-2 символ, биты 4-6 фон.
;       Слово снимается со стека.
; Прежние значения запоминаются в области @#22656 (+36 цвет, +42 заливка
; фона) для RSTCOL. COLRS - таблица заливок: код цвета, повторённый в
; каждой тетраде слова.
;------------------------------------------------------------------------------
$COLOR::POP	TMP		; Адрес возврата убрать (цвет на вершине)
	BIC	#177610,(SP)	; Оставить биты 0-2 (символ) и 4-6 (фон)
	MOV	@#22656+34,@#22656+36	; Запомнить прежний цвет
	MOVB	(SP),@#22656+34	; Текущий цвет вывода
	MOVB	(SP),@#177016	; В регистр 177016 (предположительно цвет)
	MOVB	(SP)+,R0	; R0 = цвет, слово цвета снято со стека
	PUSH	TMP		; Вернуть адрес возврата
	ASH	#-3,R0		; R0 = номер цвета фона * 2 (индекс в COLRS)
REL	MOV	COLRS(R0),R0	; R0 = заливка с кодом фона (COLRS)
	MOV	@#22656+40,@#22656+42	; Запомнить прежнюю заливку
$SCL:	MOV	R0,@#22656+44	; Копия заливки (назначение не выяснено)
	MOV	R0,@#22656+40	; Текущая заливка фона
	MOV	R0,@#177020	; Заливка в регистры 177020 и 177022
	MOV	R0,@#177022	; (регистры не выяснены до конца)
	RETURN			; Выход

;------------------------------------------------------------------------------
; RSTCOL - вернуть цвет и заливку, бывшие до последнего $COLOR
; (только один уровень). В оригинале цвет пишется в 177010, а не в 177016
; (как в $COLOR) - возможная ошибка, не выяснено.
;------------------------------------------------------------------------------
RSTCOL::
	MOV	@#22656+36,@#22656+34	; Текущий цвет = прежний цвет
	MOV	@#22656+34,@#177010	; В 177010? (в $COLOR - 177016)
	MOV	@#22656+42,R0	; R0 = прежняя заливка
	BR	$SCL		; Записать её как текущую


;------------------------------------------------------------------------------
; $LOCAT - установить позицию курсора (макрос LOCATE)
; Вход: в стеке после адреса возврата Y (слово), затем X (слово).
; Координаты - в знакоместах от левого верхнего угла экрана.
;------------------------------------------------------------------------------
$LOCAT::POP	TMP		; Убрать адрес возврата
	MOVB	(SP)+,1$	; Y из стека в младший байт аргумента 1$
	MOVB	(SP)+,1$+1	; X из стека в старший байт аргумента 1$
	PUSH	TMP		; Вернуть адрес возврата
	JSR	R4,$$LC		; Установить позицию по слову 1$ за вызовом
1$:	.BLKW	1		; Аргумент для $$LC: Y (мл.), X (ст.)
	RETURN			; Выход


;------------------------------------------------------------------------------
; $$LC - установить позицию курсора (макрос LOC)
; Вход: JSR R4,$$LC; .BYTE Y,X. Заполняет структуру курсора ПП, адрес
; которой в @#23150 (назначение полей выяснено частично): +0 видеоадрес
; курсора, +16 и +20 расстояния до правого и нижнего краёв (предположительно),
; +32 описатель строки.
;------------------------------------------------------------------------------
$$LC::	PUSH	<R5,R0,R2,R3>	; Сохранить регистры
	MOV	@#23150,R5	; R5 -> структура курсора ПП
	MOVB	(R4)+,R3	; R3 = Y
	MOVB	(R4)+,R2	; R2 = X
	MOV	12(R5),20(R5)	; Расстояние до нижнего края:
	SUB	R3,20(R5)	; +20 = (+12) - Y
	CALL	$GETY		; R0 -> описатель строки Y, R3 = его видеоадрес
	MOV	4(R5),16(R5)	; Расстояние до правого края:
	SUB	R2,16(R5)	; +16 = (+4) - X
	ADD	R2,R3		; Видеоадрес строки + X
	MOV	R3,(R5)		; Видеоадрес курсора
	MOV	R0,32(R5)	; Запомнить описатель строки
	POP	<R3,R2,R0,R5>	; Восстановить регистры
	INC	@#7066		; Признак изменения (@#7066 не выяснено)
	RTS	R4		; Возврат за встроенный аргумент


;------------------------------------------------------------------------------
; $WLOC - как $LOCAT, но координаты относительно окна (к Y и X в стеке
; прибавляются W2 и W1 - координаты окна)
;------------------------------------------------------------------------------
$WLOC::	ADD	W2,2(SP)	; Y += Y левого верхнего угла окна
	ADD	W1,4(SP)	; X += X левого верхнего угла окна
	JMP	$LOCAT		; Установить позицию, возврат к вызывающему

	RETURN			; Недостижимо (после JMP)

;------------------------------------------------------------------------------
; $UPMEN - верхнее меню: строка пунктов вверху экрана (макрос UPMENU)
; Вход: R4 -> описание меню (MAIN в IDDAT.MAC): +0 адрес строки меню, +2 цвет,
; +3 номер последнего пункта, +4 байты смещений пунктов в строке (по одному
; на пункт), затем с чётного адреса слова-адреса выпадающих окон (UPWRK).
; Рисует строку, подсвечивает пункт WPNT, ждёт клавишу (или берёт KEYCOD
; после закрытия окна) и переходит по таблице UKJMP. ENTFLG <> 0 - режим
; "окно открыто": смена пункта сразу открывает его окно. Выбор пункта -
; JMP на его обработчик (JMPADR), возврат - к вызвавшему UPMENU.
; UpMn1 - вход без сброса ENTFLG.
;------------------------------------------------------------------------------
$UPMEN::
	CLR	ENTFLG		; Режим без открытого окна
UpMn1::	CALL	$CUROF		; Выключить курсор
	MOVB	3(R4),R3	; R3 = номер последнего пункта
	TST	(R3)+		; R3 += 2
	BIC	#1,R3		; Округлить до чётного
	CMP	(R3)+,(R3)+	; R3 += 4 (заголовок до таблицы смещений)
	ADD	R4,R3		; R3 -> таблица адресов окон
	MOV	R3,UPWRK	; Запомнить её
	JSR	R4,$$LC		; Курсор в левый верхний угол
	.WORD	0		; Аргумент: Y = 0, X = 0
	COLOR	2(R4)		; Цвет строки меню
	PRINT	(R4)		; Вывести строку меню

; $UUNK - прочая клавиша: вход в UBG (показать пункт, ждать клавишу)
$UUNK::
UBG::	MOV	R4,R1		; R1 -> описание меню
	ADD	WPNT,R1		; Плюс номер текущего пункта
	MOVB	4(R1),R1	; R1 = смещение названия пункта в строке
	CLR	R3		; R3 = Y = 0 (верхняя строка)
	MOV	#1,R2		; Счётчик ширины подсветки
	PUSH	R1		; Запомнить смещение
	ADD	(R4),R1		; R1 -> название пункта в строке меню
1$:	INC	R2		; Считать ширину до пробела
	Cmpb	(R1)+,#40	; Пробел?
	Bne	1$		; не пробел => дальше
	POP	R1		; R1 = смещение названия
	DEC	R1		; Подсветка с пробела перед названием
	CALL	$INV		; Инвертировать (подсветить) пункт
	Tst	EntFlg		; Окно открыто?
	Beq	2$		; нет => ждать клавишу
	PUSH	R4		; Сохранить адрес меню
	MOV	WPNT,R4		; R4 = номер пункта
	ASL	R4		; R4 = номер * 2
	ADD	UPWRK,R4	; R4 -> адрес окна пункта
	WINDOW	(R4)		; Открыть выпадающее окно (до его закрытия)
	POP	R4		; Вернуть адрес меню
	MOV	KEYCOD,R0	; R0 = клавиша, закрывшая окно
	BR	3$		; Не ждать клавишу
2$:	FLUSH			; Сбросить буфер клавиатуры
	EMT	22		; R0 = код нажатой клавиши
3$:	CALL	$INV		; Снять подсветку
REL	KEYJMP	#UKJMP		; Переход по коду клавиши (UKJMP)


; $UR - клавиша "вправо"
$UR::	INCB	WPNT		; Вправо: следующий пункт
	Cmpb	Wpnt,3(r4)	; Сравнить с номером последнего
	Blos	Ubg		; <= последнего => показать
	CLR	WPNT		; иначе перейти на первый
	BR	UBG		; Показать

; $UL - клавиша "влево"
$UL::	DECB	WPNT		; Влево: предыдущий пункт
	BPL	UBG		; >= 0 => показать
	MOVB	3(R4),WPNT	; иначе перейти на последний
	BR	UBG		; Показать

; $UE - Enter или "вниз"
$UE::	Tst	EntFlg		; Enter, вниз: окно уже открывалось?
	Bne	1$		; да => выбрать пункт
	COM	ENTFLG		; Включить режим открытого окна
	BR	UBG		; Показать пункт и открыть окно
1$:	JMP	@JMPADR		; Выполнить выбранный пункт (адрес из $EE)

; $UES - Esc
$UES::	Tst	EntFlg		; Esc: окно открыто?
	Beq	1$		; нет => выйти из меню
	CLR	ENTFLG		; Закрыть режим окна
	BR	UBG		; Показать пункт без окна
1$:	CALL	$CURON		; Включить курсор
	RETURN			; Выход из меню

;------------------------------------------------------------------------------
; $INV - инвертировать прямоугольник знакомест (подсветка пункта, кнопки)
; Вход: R1 = X, R2 = ширина в знакоместах, R3 = Y (абсолютные). Регистры
; сохраняются. Через регистр данных 177014 по адресу из 177010 обрабатываются
; 11 строк развёртки (высота знакоместа) на каждую позицию. Обработка -
; команды по метке $$$1: COM (R3) и NOP. Вызывающие (см. $$TSPR, $TRBG)
; подменяют их: слово $$$1 := 313 (SWAB (R3)) вместо COM (R3) или
; $$$1+2 := 313 вместо NOP, затем восстанавливают (5113 и 240). Что это
; даёт на экране (вероятно, перекраска), не выяснено до конца.
;------------------------------------------------------------------------------
$INV::	CALL	$PUSH		; Сохранить регистры и 177010
	MOV	#177010,R5	; R5 -> регистр адреса видеопамяти
	CALL	$GETY		; R3 = видеоадрес строки Y
	MOV	@#23150,R0	; R0 -> структура курсора ПП
	MOV	10(R0),R0	; R0 = шаг между строками развёртки
	ADD	R1,R3		; Плюс X
	MOV	R3,(R5)		; Адрес в видеопамяти
	MOV	#177014,R3	; R3 -> регистр данных
	MOV	#11.,R4		; Строк развёртки в знакоместе
$$$2:	PUSH	R2		; Запомнить ширину
$$$1::	COM	(R3)		; Инвертировать (подменяется, см. выше)
	NOP			; Место второй подмены
	INC	(R5)		; Следующий адрес
	SOB	R2,$$$1		; Для всех знакомест по ширине
	POP	R2		; Вернуть ширину
	SUB	R2,(R5)		; Адрес - в начало строки
	ADD	R0,(R5)		; К следующей строке развёртки
	SOB	R4,$$$2		; Для всех строк
	CALL	$POP		; Восстановить регистры
	RETURN			; Выход

;------------------------------------------------------------------------------
; $CUROF / $CURON - выключить / включить курсор. Флаг курсора лежит в
; структуре @#23150 (+70) и в байте @#2460 (IDE.MAC копирует первое во
; второе); сам курсор рисует прерывание таймера (Int100 в IDE.MAC).
;------------------------------------------------------------------------------
$CUROF::PUSH	R5		; Сохранить R5
	CALL	$CHIDE		; Убрать образ курсора с экрана
	MOV	@#23150,R5	; R5 -> структура курсора ПП
	CLR	70(R5)		; Флаг курсора: выключен
	CLRB	@#2460		; Режим курсора ПП: выключен (предп.)
	POP	R5		; Восстановить R5
	RETURN			; Выход


$CURON::PUSH	R5		; Сохранить R5
	MOV	@#23150,R5	; R5 -> структура курсора ПП
	MOV	#7,70(R5)	; Флаг курсора: включён (режим 7)
	MOVB	#7,@#2460	; Режим курсора ПП (предположительно)
	POP	R5		; Восстановить R5
	RETURN			; Выход

;------------------------------------------------------------------------------
; $CHIDE - убрать образ курсора с экрана. Портит R5.
; Таблица образа (@#23150+60): 11 записей по 2 слова; бит 0 второго слова
; сбрасывается (назначение бита предположительно - признак видимости).
;------------------------------------------------------------------------------
$CHIDE::PUSH	R2		; Сохранить R2
	MOV	@#23150,R5	; R5 -> структура курсора ПП
	MOV	60(R5),R5	; R5 -> таблица образа курсора
	MOV	#11.,R2		; Записей по числу строк знакоместа
3$:	TST	(R5)+		; Пропустить первое слово записи
	BIC	#1,(R5)+	; Сбросить бит 0 второго слова
	SOB	R2,3$		; Для всех записей
	POP	R2		; Восстановить R2
	RETURN			; Выход


;------------------------------------------------------------------------------
; $WIND - открыть окно (макрос WINDOW)
; Вход: R4 -> описание окна. Диалог (бит BARS) рисует $INBAR, иначе - меню:
; строки пунктов (ASCIZ, W4 штук) окружаются рамкой, фон сохраняется ($SAVE),
; рисуется тень ($SHDW), окно с битом EXE сразу переходит к выбору ($EXE).
; Коды в тексте пункта: 2 в начале - разделитель перед пунктом (занимает
; строку без счёта в W4, номера пунктов с разделителями идут в WAREA); 3 -
; три точки; 1, затем необязательно 4/5/6 (Ctrl/Shift/Alt), затем название
; клавиши - подсказка, прижатая к правому краю. W2 при выводе увеличивается.
;------------------------------------------------------------------------------
$WIND::	CALL	$PUSH		; Сохранить регистры
	MOV	R4,WA		; Запомнить текущее окно
	CALL	$COP		; Заголовок окна в W0-W4
	LOCATE	W1,W2		; Курсор в левый верхний угол окна
	COLOR	7(R4)		; Цвет окна
	BIT	#BARS,W0	; Диалог (двойная рамка)?
	BEQ	1$		; нет => меню
	JMP	$INBAR		; Нарисовать диалог
1$:	MOV	(R4),R4		; R4 -> текст пунктов меню
	PUSH	R4		; Запомнить его начало
	INC	W4		; Строк + 1 (в высоту: тень; см. WF1)
	MOV	W4,R1		; R1 = счётчик строк
	CLR	R3		; R3 = число разделителей
REL	MOV	#WAREA+1,R5	; R5 -> список разделителей WAREA
1$:	Cmpb	(r4),#2		; Маркер разделителя (код 2)?
	Bne	2$		; нет =>
	INC	R3		; Посчитать разделитель
	MOVB	W4,R2		; R2 = W4
	SUB	R1,R2		; R2 = номер строки (с нуля)
	MOVB	R2,(R5)+	; Записать в WAREA
2$:	Tstb	(r4)+		; Следующий символ текста
	Bne	1$		; не конец строки => дальше
	DEC	R1		; Следующая строка
	BNE	1$		; Для всех строк
	MOVB	R3,WAREA	; Число разделителей
	CLRB	(R5)+		; Конец списка
	ADD	W4,R3		; R3 = строки + разделители
	TST	(R3)+		; R3 += 2 (верхняя и нижняя рамка)
	MOV	WBPNT,R4	; R4 -> запись стека окон
	MOVB	W1,(R4)+	; X окна
	MOVB	W2,(R4)+	; Y окна
	MOVB	W3,R1		; R1 = ширина
	ADD	#8.,R1		; Ширина с рамкой и тенью (предп.)
	MOVB	R1,(R4)+	; Ширина записи
	MOVB	R3,(R4)+	; Высота записи
	TST	(R4)+		; Место под адрес копии фона
	CALL	$TSTOP		; Сохранить фон, нарисовать тень
	POP	R4		; R4 -> текст пунктов
	MOV	#TTBUF,R1	; R1 -> буфер строки вывода
	CONCAT 	1,< ┌─>		; Верхняя рамка: пробел, угол, линия
	CALL	WP1		; W3 линий
	CONCAT	1,<─┐>		; Линия и правый угол
WP4:	MOVB	#40,(R1)+	; Пробел справа
	CLRB	(R1)+		; Конец строки
	CALL	$PRTZ		; Вывести строку на экран
WP2:	INC	W2		; Следующая строка экрана
	LOCATE	W1,W2		; Курсор в её начало
	MOV	#TTBUF,R1	; R1 -> буфер
	MOVB	#40,(R1)+	; Пробел слева
	Cmpb	(r4),#2		; Разделитель перед пунктом?
	Bne	Wp3		; нет => обычная строка
	CONCAT	1,<├─>		; Разделитель: левый тройник
	CALL	WP1		; W3 линий
	CONCAT	1,<─┤>		; Линия и правый тройник
	TSTB	(R4)+		; Пропустить маркер
	BR	WP4		; Вывести разделитель
WP3:	CONCAT	1,<│ >		; Левая рамка и пробел
1$:	Cmpb	(r4),#1		; Маркер подсказки клавиши (код 1)?
	Beq	Wp5		; да => подсказка
	Tstb	(r4)		; Конец названия?
	Beq	Wp6		; да => добить пробелами
	Cmpb	(r4),#3		; Код 3 (многоточие)?
	Bne	2$		; нет => обычный символ
	MOVB	(R4)+,R0	; R0 = 3
3$:	MOVB	#'.,(R1)+	; Три точки
	SOB	R0,3$		; Повторить
	BR	1$		; Дальше

2$:	MOVB	(R4)+,(R1)+	; Копировать символ названия
	BR	1$		; Дальше
WP6:	CALL	WP7		; Добить пробелами до правой рамки
WF1:	TSTB	(R4)+		; Пропустить конец строки
	CONCAT	1,<│>		; Правая рамка
	DEC	W4		; Строк осталось
	BNE	WP4		; есть => вывести строку, взять следующую
	MOV	#TTBUF,R1	; Не выводится: курсор уже на нижней рамке
	CONCAT	1,< └─>		; Нижняя рамка: пробел, угол, линия
	CALL	WP1		; W3 линий
	CONCAT	1,<─┘ >		; Линия, правый угол, пробел
	CLRB	(R1)+		; Конец строки
	CALL	$PRTZ		; Вывести нижнюю рамку
	CLR	JMPADR		; Обработчик пока не выбран
	BIT	#EXE,W0		; Окно с вводом (EXE)?
	BEQ	1$		; нет =>
	CALL	$EXE		; Цикл выбора пункта
1$:	CALL	$POP		; Восстановить регистры
	RETURN			; Выход

; WP5 - подсказка клавиши: копируется с конца названия справа налево
WP5:	CALL	WP7		; Добить пробелами до правой рамки
1$:	Tstb	(r4)+		; Найти конец названия
	Bne	1$		; Дальше
	DEC	R4		; R4 -> нуль-байт
	PUSH	<R1,R4>		; Запомнить R1, R4
	DEC	R1		; Оставить пробел у рамки
2$:	MOVB	-(R4),-(R1)	; Копировать подсказку справа налево
	Cmpb	(r4),#7		; Скопирован код (<= 7)?
	Bhi	2$		; нет => дальше
	Cmpb	(r4),#1		; Код > 1 (модификатор)?
	Bhi	$3		; да => вставить название
$2:	MOVB	#40,(R1)	; Код заменить пробелом
	POP	<R4,R1>		; Вернуть R1, R4
	BR	WF1		; Дописать правую рамку

$3:	MOVB	(R4),R3		; R3 = код модификатора
	ASL	R3		; Индекс в таблице ETB
REL	MOV	ETB-10(R3),R3	; R3 -> конец названия клавиши
	INC	R1		; R1 на символ вправо
	MOVB	#'-,-(R1)	; Код заменить дефисом
1$:	MOVB	-(R3),-(R1)	; Название справа налево
	BNE	1$		; до нуль-байта
	BR	$2		; Нуль заменить пробелом


; WP1 - вывести W3 символов "горизонтальная линия" в буфер (R1)
WP1:	MOVB	W3,R5		; R5 = ширина окна
1$:	CONCAT 	1,<─>		; Горизонтальная линия
	SOB	R5,1$		; Повторить
	RETURN			; Выход


; WP7 - добить буфер пробелами до позиции правой рамки
WP7:	MOV	W3,R5		; R5 = ширина окна
	ADD	#TTBUF+4,R5	; R5 -> позиция правой рамки
	SUB	R1,R5		; R5 = число пробелов
1$:	MOVB	#40,(R1)+	; Пробел
	SOB	R5,1$		; Повторить
	RETURN			; Выход

; $TSTOP - по битам W0 сохранить фон и нарисовать тень
$TSTOP:	BIT	#MEMORY,W0	; Запоминать фон?
	BEQ	8$		; нет =>
	CALL	$SAVE		; Сохранить фон под окном
8$:	BIT	#SHADOW,W0	; Тень?
	BEQ	9$		; нет =>
	CALL	$SHDW		; Нарисовать тень
9$:	RETURN			; Выход

;------------------------------------------------------------------------------
; $INBAR - диалог (окно с двойной рамкой, бит BARS), продолжение $WIND
; Рисует верхнюю рамку UL (╔═[ значок 206 ]; значок закрытия, предположительно)
; с заголовком, тело окна (текст по адресу 10(R4)), нижнюю рамку, затем
; элементы диалога. Заголовок: байт - позиция названия, затем ASCIZ.
; Тело, по строке окна: 0 - пустая строка; 1-77 (восьмеричн.) - столбец
; начала текста, затем ASCIZ (символ < 40 внутри - столько пробелов);
; 100+n - n пустых строк подряд. Число строк - W4.
;------------------------------------------------------------------------------
$INBAR:	MOV	WBPNT,R4	; R4 -> запись стека окон
	MOVB	W1,(R4)+	; X окна
	MOVB	W2,(R4)+	; Y окна
	MOVB	W3,R1		; R1 = ширина окна
	CMP	(R1)+,(R1)+	; R1 += 4 (рамка и тень)
	MOVB	R1,(R4)+	; Ширина записи
	MOVB	W4,R1		; R1 = число строк тела
	ADD	#3,R1		; Плюс 2 рамки и строка тени
	MOVB	R1,(R4)+	; Высота записи
	TST	(R4)+		; Место под адрес копии фона
	CALL	$TSTOP		; Сохранить фон, нарисовать тень

	MOV	#TTBUF,R1	; R1 -> буфер строки вывода
	MOV	#5,R0		; Длина начала рамки UL
$$L:
REL	MOVB	UL-TTBUF(R1),(R1)+	; Начало верхней рамки (UL)
	SOB	R0,$$L		; Для всех 5 символов
	MOV	W3,R0		; R0 = ширина окна
	CMP	-(R0),-(R0)	; R0 -= 4 (5 символов UL и угол выведены)
1$:	CONCAT	1,<═>		; Горизонтальные линии
	SOB	R0,1$		; Повторить
	CONCAT	1,<╗>		; Правый верхний угол
	CLRB	(R1)+		; Конец строки
	MOV	@WA,R4		; R4 -> заголовок окна
	MOVB	(R4)+,R1	; R1 = позиция заголовка
	ADD	#TTBUF+2,R1	; R1 -> место в буфере
	MOVB	#40,(R1)+	; Пробел перед заголовком
2$:	MOVB	(R4)+,(R1)+	; Копировать заголовок
	BNE	2$		; до нуль-байта
	MOVB	#40,-(R1)	; Нуль заменить пробелом

	CALL	$PRTZ		; Вывести верхнюю рамку
	MOV	WA,R4		; R4 -> описание окна
	MOV	10(R4),R4	; R4 -> текст тела окна
	CLR	R3		; R3 = число оставшихся пустых строк
6$:	INC	W2		; Следующая строка экрана
12$:	LOCATE	W1,W2		; Курсор в её начало
	MOV	#TTBUF,R1	; R1 -> буфер
	CONCAT	1,<║>		; Левая рамка
	MOV	W3,R0		; R0 = ширина
3$:	CONCAT	1,< >		; Пробелы внутри окна
	SOB	R0,3$		; Повторить

	DEC	R3		; Пустые строки ещё есть?
	BPL	4$		; да => вывести пустую строку

	MOVB	(R4)+,R2	; Первый байт строки тела
	BEQ	4$		; код 0 => пустая строка
	SUB	#100,R2		; Минус 100 (64)
	BMI	11$		; код < 64 => смещение текста
	MOV	R2,R3		; код >= 64: число пустых строк
	BR	12$		; Вывести первую из них

11$:	ADD	#TTBUF+77,R2	; R2 -> позиция перед текстом

5$:	INC	R2		; Следующая позиция в буфере
	MOVB	(R4)+,(R2)	; Копировать символ
	CMPB	(R2),#40	; Обычный символ?
	BHIS	5$		; да => дальше
	TSTB	(R2)		; Конец строки?
	BEQ	8$		; да =>
	MOVB	(R2),R0		; R0 = код (число пробелов)
9$:	MOVB	#40,(R2)+	; Вставить пробелы
	SOB	R0,9$		; Повторить
	BR	5$+2		; Продолжить копирование

8$:	MOVB	#40,(R2)	; Нуль заменить пробелом

4$:	CONCAT	1,<║>		; Правая рамка
	CALL	$PRTZ		; Вывести строку
	DEC	W4		; Строк осталось
	BNE	6$		; есть => следующая
	INC	W2		; Нижняя строка окна
	LOCATE	W1,W2		; Курсор в её начало
	MOV	#TTBUF,R1	; R1 -> буфер
	CONCAT	1,<╚>		; Нижняя рамка
	MOV	W3,R0		; R0 = ширина
7$:	CONCAT	1,<═>		; Горизонтальные линии
	SOB	R0,7$		; Повторить
	CONCAT	1,<╝>		; Правый нижний угол
	CALL	$PRTZ		; Вывести нижнюю рамку
	MOV	WA,R4		; R4 -> описание окна
	CALL	$COP		; Вернуть W0-W4 (W2, W4 изменились)
	ADD	#12,R4		; R4 -> первый элемент
REL	MOV	#BAREA,B.PTR	; Список сохранённых значений пуст

;------------------------------------------------------------------------------
; $$BRPR - цикл по элементам диалога (R4 -> следующий). Каждый элемент
; рисуется и управление возвращается сюда; код 0 - конец списка.
; Кнопка: надпись по центру, справа и снизу тень (символы 207, 210).
;------------------------------------------------------------------------------
$$BRPR:	MOV	(R4)+,R1	; R1 = код элемента
	BEQ	$$INBE		; ноль => конец списка
	Cmp	r1,#400		; Адрес надписи кнопки?
	Blo	$$TsPr		; нет => не кнопка
	COLOR	BLACK,CYAN	; Цвет кнопки


11$:
	TST	(R4)+		; Пропустить адрес обработчика
	MOVB	(R4)+,-(SP)	; X кнопки
	MOVB	(R4),-(SP)	; Байт: Y (младшая тетрада), ширина (старшая)
	BIC	#^C17,(SP)	; Оставить Y
	PUSH	<2(SP),2(SP)>	; Вторая копия Y, X (для тени)
	CALL	$WLOC		; Курсор на кнопку
	MOVB	(R4)+,R3	; R3 = байт Y и ширины
	BIC	#^C360,R3	; Оставить ширину
	ASH	#-4,R3		; R3 = ширина кнопки
	PUSH	@#22716		; Запомнить слово заливки фона
	BIS	#^B0110000001100000,@#22716	; Изменить заливку для кнопки
	MOV	R3,R5		; R5 = ширина
	MOV	#TTBUF,R2	; R2 -> буфер
1$:	MOVB	#40,(R2)+	; Пробелы по ширине кнопки
	SOB	R5,1$		; Повторить
	CLRB	(R2)		; Конец строки
	SUB	R3,R2		; R2 -> начало буфера
	MOV	R1,R5		; R5 -> надпись
2$:	TSTB	(R5)+		; Найти конец надписи
	BNE	2$		; Дальше
	SUB	R1,R5		; R5 = длина с нулём
	DEC	R5		; R5 = длина надписи
	SUB	R3,R5		; Вычесть ширину
	NEG	R5		; R5 = ширина - длина
	ASR	R5		; Отступ для центровки
	ADD	R5,R2		; R2 -> место надписи в буфере
3$:	MOVB	(R1)+,(R2)+	; Копировать надпись
	BNE	3$		; до нуль-байта
	MOVB	#40,-(R2)	; Нуль заменить пробелом
	CALL	$PRTZ		; Вывести кнопку
	POP	@#22716		; Вернуть заливку
	MOV	#207,R0		; Символ тени справа (знак шрифта IDE)
	EMT	42		; Вывести
	INC	(SP)		; Y + 1
	INC	2(SP)		; X + 1
	CALL	$WLOC		; Курсор под кнопку, сдвиг на 1
	MOV	#210,R0		; Символ тени снизу
10$:	EMT	42		; Вывести
	SOB	R3,10$		; Тень по ширине кнопки
	BR	$$BRPR		; Следующий элемент

12$:


; $$INBE - конец списка элементов диалога
$$INBE:
	MOV	(R4)+,JMPADR	; Обработчик по Enter (слово после списка)
	CALL	$POP		; Восстановить регистры
	BIT	#EXE,W0		; Нужен ввод (EXE)?
	BEQ	1$		; нет =>
	JMP	$EXEB		; Цикл по элементам
1$:	RETURN			; Выход

;------------------------------------------------------------------------------
; $$TSPR - элементы диалога с кодом < 400: 3 строка ввода, 4 процедура
; пользователя, 1/2 списки значков. Для списков старое значение и адрес
; сохраняются в BAREA - отказ ($NOPR) восстанавливает их.
;------------------------------------------------------------------------------
$$TSPR:
	Cmp	r1,#3		; Строка ввода?
	Bne	4$		; нет =>
	COLOR	YELLOW,BLUE	; Цвет поля ввода
	MOV	(R4)+,R0	; R0 -> буфер поля
	MOV	(R4)+,R2	; R2 = адрес прежнего значения (или 0)
	MOVB	(R4)+,-(SP)	; X поля
	MOVB	(R4)+,-(SP)	; Y поля
	CALL	$WLOC		; Курсор на поле
	MOVB	(R4)+,R3	; R3 = ширина поля
	MOV	R3,R5		; R5 = ширина
	DEC	R5		; R5 = максимум символов
	PUSH	R0		; Запомнить адрес буфера
6$:	MOVB	#40,(R0)+	; Заполнить буфер пробелами
	SOB	R3,6$		; Повторить
	CLRB	(R0)+		; Конец строки
	CLRB	(R0)		; Длина текста = 0
	MOV	R0,R3		; R3 -> байт длины
	BITB	#1,(R4)		; Взять прежнее значение (флаг бит 0)?
	BEQ	11$		; нет =>
	MOV	(SP),R1		; R1 -> буфер
12$:	MOV	R2,@#177010	; Адрес прежнего значения
	MOV	@#177012,R0	; Прочитать (память не выяснена)
	BITB	#2,(R4)		; Строка с нулём в конце (флаг бит 1)?
	BEQ	14$		; нет =>
	TSTB	R0		; Конец строки?
	BNE	15$		; нет => взять символ
	BR	13$		; иначе конец
14$:	BISB	#200,(R4)	; Отметить 200: прежнее можно подсказать
	CALL	$BTTST		; Допустимый символ? (C=1 нет)
	BCS	13$		; недопустимый => конец
15$:	INC	R2		; Следующий адрес
	MOVB	R0,(R1)+	; Символ в буфер
	SOB	R5,12$		; Для всех символов
13$:	CMPB	-(R1),#40	; Убрать пробелы в конце
	BEQ	13$		; Дальше
	INC	R1		; R1 -> после последнего символа


	SUB	(SP),R1		; R1 = длина текста
	MOVB	R1,(R3)		; Записать длину
	BEQ	11$		; пусто =>
	BISB	#100,(R4)	; Отметить: поле заполнено
	MOV	#^B0000001000000010,@#22716	; Заливка для поля ввода


11$:	INC	R4		; Пропустить байт флагов
	PRINT	(SP)+		; Вывести поле
16$:	JMP	$$BRPR		; Следующий элемент


4$:	Cmp	r1,#4		; Процедура пользователя?
	Bne	17$		; нет => список
	CALL	@(R4)+		; Вызвать процедуру рисования
	TST	(R4)+		; Пропустить адрес процедуры ввода
	BR	16$		; Следующий элемент


17$:	PUSH	R1		; Запомнить код списка
	MOV	B.PTR,R1	; R1 -> конец списка сохранений
	MOV	(R4)+,R2	; R2 -> переменная состояния списка
	MOV	(R2),(R1)+	; Сохранить значение
	MOV	R2,(R1)+	; и адрес переменной
	MOV	R1,B.PTR	; Новый конец списка
	POP	R1		; R1 = код списка
	MOV	(R2),R2		; R2 = значение
	MOVB	(R4)+,R5	; R5 = смещение подписи (бит 7 - без подсв.)
	INC	R4		; Пропустить второй байт заголовка

2$:	MOVB	(R4)+,-(SP)	; X очередного пункта
	BNE	1$		; есть =>
	TST	(SP)+		; Конец списка
	TSTB	(R4)+		; Пропустить второй нуль
	JMP	$$BRPR		; Следующий элемент
1$:	MOVB	(R4)+,-(SP)	; Y пункта
	CALL	$WLOC		; Курсор на значок пункта
	TST	R5		; Подсветка нужна?
	BMI	10$		; нет =>
	PUSH	<R1,R2>		; Запомнить R1, R2
	MOVB	-(R4),R3	; R3 = Y
	MOVB	-(R4),R1	; R1 = X
	TST	(R4)+		; Вернуть R4
	ADD	W1,R1		; X в абсолютные
	ADD	W2,R3		; Y в абсолютные
	SUB	R5,R1		; Подпись слева от значка
	DEC	R1		; На знакоместо левее
	MOV	R5,R2		; R2 = смещение подписи
	BIC	#177600,R2	; Без бита 7
	ADD	#5,R2		; Ширина = смещение + 5 (с значком)
	MOV	#313,$$$1	; В $INV вместо COM - SWAB (предп. перекраска)
	CALL	$INV		; Перекрасить подпись
	MOV	#5113,$$$1	; Вернуть COM
	COLOR	BLACK,BLUE	; Цвет значка
	POP	<R2,R1>		; Вернуть R1, R2

10$:	Cmp	r1,#2		; Код 2 (флажки)?
	Beq	7$		; да => [X]
	MOV	#'(,R0		; Переключатель: "("
	EMT	42		; Вывести
	MOV	#' ,R0		; Пробел
	SUB	#1,R2		; Значение - 1
	BCC	3$		; C=0 (не этот пункт) => пробел
	MOV	#205,R0		; C=1: значение было 0 - точка
3$:	EMT	42		; Вывести
	MOV	#'),R0		; Скобка ")"
9$:	EMT	42		; Вывести
	BR	2$		; Следующий пункт
7$:	MOV	#'[,R0		; Флажок: "["
	EMT	42		; Вывести
	MOV	#' ,R0		; Пробел
	ASR	R2		; Бит значения -> C
	BCC	8$		; бит 0 => пробел
	MOV	#'X,R0		; бит 1 => X
8$:	EMT	42		; Вывести
	MOV	#'],R0		; Скобка "]"
	BR	9$		; Вывести закрывающую скобку


;------------------------------------------------------------------------------
; $EXEB - цикл ввода диалога: элементы списка по кругу ($BGRS). Кнопка
; подсвечивается и ждёт клавишу по таблице BRJMP: Enter ($BRE) - выполнить
; обработчик, Esc - $NOPR, Tab и стрелки - следующий элемент ($BRT, кнопка
; занимает 6 байт), прочие - снова та же кнопка. Остальные элементы - $TREX.
; Комментарии автора модуля сохранены.
;------------------------------------------------------------------------------
				; Исполняемая часть процедур окна
$EXEB::

	MOV	WA,R4		; Установка указателя на первый элемент
	ADD	#12,R4		; списка окна


$BGRS::	MOV	(R4),R5		; Прочитать код объекта
	BEQ	$EXEB		; Если ноль - кольцо
	Cmp	r5,#10		; Код элемента > 10?
	Bhi	2$		; Код > 10, значит "кнопка"
	JMP	$TREX		; Иначе что-то другое


2$:	MOVB	4(R4),R1	; Взять координату X в окне
	MOVB	5(R4),R3	; Распаковать координату Y и ширину
	MOV	R3,R2		; Выделение :
	BIC	#^C17,R3	; координаты Y в окне
	BIC	#^C360,R2	; ширины "кнопки"
	ASH	#-4,R2		; R2 = ширина кнопки
	ADD	W1,R1		; Переход из системы с относительными
	ADD	W2,R3		; координатами в абсолютные

$BRBG::	CALL	$INV		; Инверсия изображения "кнопки"

	EMT	22		; Прочитать код нажатой клавиши
	CALL	$INV		; Инверсия
REL	KEYJMP	#BRJMP		; Распознавание кода клавиши

				; Клавиша Enter
$BRE::
	MOV	2(R4),R0	; R0 = обработчик кнопки
	BIT	#1,R0		; Бит 0 = 1 (вызвать и остаться)?
	BNE	1$		; да =>
	WCLOSE			; Закрыть окно
	JMP	(R0)		; Переход на процедуру "кнопки"
1$:	BIC	#1,R0		; Убрать признак
	CALL	(R0)		; Вызвать обработчик
	BR	$EXEB		; Снова с первого элемента

				; Клавиша Tab
$BRT::	ADD	#6,R4		; Перевод указателя на следуюший элемент списка
	BR	$BGRS		; Повтор процедуры для следующего элемента

;------------------------------------------------------------------------------
; $TREX - элементы диалога, кроме кнопок (R5 = код 1-4); R4 -> слово кода,
; R2 = следующее слово (буфер строки ввода или переменная списка).
; Список (1, 2): слова - код, адрес переменной состояния; байты - заголовок
; (смещение подписи влево от значка, бит 7 - без подсветки; ширина подписи),
; затем пары X, Y значков пунктов, конец - слово 0.
;------------------------------------------------------------------------------
				; Раскрутка других процедур :
				; Коды процедур
				; 1 - тригерный список
				; 2 - селективный список
				; 3 - микроредактор
				; 4 - процедура пользователя
$TREX::
	TST	(R4)+		; Пропуск слова - кода элемента
	MOV	(R4)+,R2	; Взять первый элемент списка
				; Проверка кода
	Cmp	r5,#3		; Строка ввода?
	Bne	1$		; нет =>
	JMP	$EDEX		; Да - вызов процедуры


1$:	Cmp	r5,#4		; Процедура пользователя?
	Bne	2$		; Процедура пользователя ?
	CALL	@(R4)+		; Вызов процедуры пользователь.
				; После выхода из процедуры пользователоя
				; R4 должен указывать на следующий
				; элемент списка окна.
	BR	$BGRS		; Кольцо


				; Отработка списков
				; R2 указывает на слово в котором
				; закодирован список

2$:	COLOR	BLACK,BLUE	; Установить цвет пиктограмм
	TST	(R4)+		; Пропуск ненужного слова
	MOV	R4,R3		; Запомнить начало списка

	Cmp	R5,#2		; Для селективного списка
	Beq	$TrBg		; флажки => курсор на первый пункт
	MOV	(R2),R0		; определить номер альтернативы, уже
	ASL	R0		; содержащейся в списке для установкм
	ADD	R0,R4		; на нее курсора

;------------------------------------------------------------------------------
; $TRBG - выбор пункта списка: подсветить значок и подпись, ждать клавишу
; (таблица TRJMP): Tab - следующий элемент, стрелки - соседний пункт,
; пробел - выбрать/переключить, Enter - $ENTER, Esc - $NOPR.
;------------------------------------------------------------------------------
$TRBG::
	CALL	$CURON		; Включить апаратный курсор
	MOVB	(R4),-(SP)	; Установить апаратный курсор
	INC	(SP)		; На элемент списка
	MOVB	1(R4),-(SP)	; Y значка
	CALL	$WLOC		; Курсор внутрь значка

	PUSH	<R4,R2,R3>	; Подсветка элемента
	MOVB	(R4),R1		; списка , на котором стоит
	MOV	#3,R2		; апаратный курсор
	MOVB	1(R4),R3	; R3 = Y значка
	ADD	W1,R1		; X в абсолютные
	ADD	W2,R3		; Y в абсолютные
	MOV	#313,$$$1+2	; В $INV после COM добавить SWAB (предп.)
	CALL	$INV		; Подсветить значок (R2 = 3)
	MOV	(SP),R4		; R4 -> начало списка пунктов
	MOVB	-(R4),R2	; R2 = ширина подписи (2-й байт заголовка)
	MOVB	-(R4),R0	; R0 = смещение подписи влево от значка
	BIC	#177600,R0	; Без бита 7
	PUSH	R1		; Запомнить X значка
	SUB	R0,R1		; R1 = X начала подписи
	CALL	$INV		; Подсветить подпись
	EMT	22		; R0 = код клавиши
	CALL	$INV		; Снять подсветку подписи
	POP	R1		; R1 = X значка
	MOV	#3,R2		; Ширина значка
	CALL	$INV		; Снять подсветку значка


	POP	<R3,R2,R4>	; Вернуть R3, R2, R4
	MOV	#240,$$$1+2	; Вернуть NOP в $INV


REL	KEYJMP	#TRJMP		; Переход по коду клавиши (TRJMP)


$TRN::	TST	(R4)+		; Пропустить пункты списка
	BNE	$TRN		; не слово 0 => дальше
	CALL	$CUROF		; Выключить курсор
	BR	$BGRS		; К следующему элементу

$TRU::	IF	R4 = R3 THEN $TRBG	; первый пункт => остаться
	TST	-(R4)		; К предыдущему пункту
	BR	$TRBG		; Подсветить

$TRD::	TST	2(R4)		; Следующий пункт есть?
	BEQ	$TRBG		; нет => остаться
	TST	(R4)+		; К следующему пункту
	BR	$TRBG		; Подсветить


$TRSP::	IF	-6(R3) = #2 THEN 1$	; Код списка 2 (флажки) =>
	MOV	#205,R0		; Переключатель: код точки
	EMT	42		; Поставить точку в текущем пункте
	MOV	(R2),R0		; R0 = прежнее значение
	ASL	R0		; R0 = смещение пары (2 байта)
	ADD	R3,R0		; R0 -> пункт прежнего выбора
	IF	R4 = R0 THEN $TRBG	; тот же пункт => ничего
	MOVB	(R0)+,-(SP)	; X прежнего пункта
	INC	(SP)		; Внутрь значка
	MOVB	(R0)+,-(SP)	; Y прежнего пункта
	CALL	$WLOC		; Курсор на него
	MOV	#40,R0		; Пробел
	EMT	42		; Стереть точку
	MOV	R4,R0		; R4 -> текущий пункт
	SUB	R3,R0		; Минус начало списка
	ASR	R0		; R0 = номер пункта
	MOV	R0,(R2)		; Новое значение
	BR	$TRBG		; Подсветить
1$:	MOV	R4,R0		; R4 -> текущий пункт
	SUB	R3,R0		; Минус начало списка
	ASR	R0		; R0 = номер пункта
	MOV	#1,R1		; R1 = 1
	ASH	R0,R1		; R1 = маска бита пункта
	XOR	R1,(R2)		; Переключить бит
	MOV	#' ,R0		; Пробел
	BIT	R1,(R2)		; Бит установлен?
	BEQ	2$		; нет => пробел
	MOV	#'X,R0		; Да: X
2$:	EMT	42		; Вывести в текущий значок
	BR	$TRBG		; Подсветить


;------------------------------------------------------------------------------
; $NOPR - отказ (Esc, "Отмена") или "OK" без действия: закрыть окно и
; вернуть значения списков, сохранённые в BAREA при рисовании ($$TSPR).
;------------------------------------------------------------------------------
$NOPR::	CALL	$CUROF		; Выключить курсор
	WCLOSE			; Закрыть окно

REL	MOV	#BAREA,R1	; R1 -> сохранённые значения
	MOV	B.PTR,R2	; R2 = конец списка сохранённого
	SUB	R1,R2		; R2 = размер в байтах
	BEQ	2$		; нет => выход
	ASR	R2		; Пара = 4 байта
	ASR	R2		; R2 = число пар
1$:	MOV	(R1)+,@(R1)+	; Вернуть значение в переменную
	SOB	R2,1$		; Для всех пар


2$:	RETURN			; Выход

;------------------------------------------------------------------------------
; $EDEX - строка ввода (.EDIT: слова - код 3, адрес буфера, адрес прежнего
; значения; байты - X, Y, ширина, флаги). Буфер (R2): ширина символов, нуль,
; байт длины (позиция курсора). R1 - курсор в буфере, EX, EY - в окне, R3 -
; последний символ, (R4) - флаги: 1 - взять прежнее значение, 2 - оно ASCIZ
; (иначе отбор по допустимым символам, $BTTST), 100 - поле перерисовать;
; ввод символа с ним сначала очищает поле (замена исходного значения),
; 200 - прежнее значение подсказывается клавишей "вправо" (ставится в $$TSPR,
; если прежнее значение не ASCIZ). Ввод - со вставкой.
; Клавиши - по таблице MEJMP; остальные коды - $WES.
;------------------------------------------------------------------------------
$EDEX:
	COLOR	YELLOW,BLUE	; Цвет поля ввода
	CALL	$CURON		; Включить курсор
	MOV	R2,R1		; R1 -> буфер поля (курсор)
	TST	(R4)+		; Пропустить адрес прежнего значения
	MOVB	(R4)+,EX	; X поля
	MOVB	(R4)+,EY	; Y поля
	MOVB	(R4)+,R3	; R3 = ширина поля
	ADD	R2,R3		; R3 -> конец буфера
	CLRB	(R3)+		; Нуль в конце текста
	MOVB	(R3),R5		; R5 = сохранённая длина (позиция курсора)
	ADD	R5,R1		; Курсор в конец текста
	ADD	R5,EX		; Экранная X курсора
	TST	-(R3)		; R3 -> последний символ поля

	BR	WEB1		; Показать курсор и ждать клавишу

WEBG:	BITB	#100,(R4)	; Нужна перерисовка поля?
	BEQ	WEB1		; нет =>

WEB2:	BICB	#100,(R4)	; Сбросить признак
	PUSH	R1		; Запомнить курсор
	MOV	R2,R1		; R1 -> буфер
	MOVB	-3(R4),-(SP)	; X поля
	MOV	EY,-(SP)	; Y поля
	CALL	$WLOC		; Курсор в начало поля
	CALL	PR		; Вывести поле
	POP	R1		; Вернуть курсор

WEB1:	MOV	R1,R0		; R0 = R1 - R2:
	SUB	R2,R0		; позиция курсора в поле
	MOVB	R0,2(R3)	; Позиция курсора - в байт длины

	PUSH	<EX,EY>		; Y, X курсора
	CALL	$WLOC		; Поставить курсор
	CLRB	C.MOVE		; На время ожидания клавиши (см. IDE.MAC)
	EMT	22		; R0 = код клавиши
	MOVB	#377,C.MOVE	; Вернуть признак
REL	KEYJMP	#MEJMP		; Переход по коду клавиши (MEJMP)


; $WES - любой другой код: символ в поле
$WES::	BITB	#100,(R4)	; Признак 100 (исходное значение)?
	BEQ	2$		; нет =>
	MOV	R2,R5		; R5 -> буфер
3$:	MOVB	#40,(R5)+	; Очистить поле пробелами
	CMP	R5,R3		; до последнего символа
	BLO	3$		; Повторить
	MOV	R2,R1		; Курсор в начало
	MOVB	-3(R4),EX	; Экранная X в начало поля
2$:	CMPB	R0,#40		; Управляющий код?
	BLO	WEBG		; да => игнорировать
	CMPB	R0,#240		; Коды 200-240 (клавиши)?
	BLE	WEBG		; да => игнорировать
	CMPB	R0,#100		; Цифра или знак?
	BLO	5$		; да => как есть
	BIS	RSLT,R0		; Буква: учесть РУС/ЛАТ

5$:	CMP	R1,R3		; Курсор в последнем символе?
	BHIS	WEBG		; да => игнорировать
	CMPB	#40,(R3)	; Последний символ - пробел?
	BNE	WEBG		; нет => места нет
	MOV	R3,R5		; R5 -> последний символ
1$:	MOVB	-(R5),1(R5)	; Раздвинуть текст вправо
	CMP	R5,R1		; до курсора
	BHI	1$		; Повторить
	MOVB	R0,(R1)+	; Вставить символ
	INC	EX		; Курсор вправо
$4:	BICB	#200,(R4)	; Прежнее значение больше не подсказывать
	BR	WEB2		; Перерисовать поле

; $WER - "вправо": сдвинуть курсор (при 200 - взять символ прежнего значения)
$WER::	CMP	R1,R3		; Курсор в конце поля?
 	BHIS	WEBG		; да =>
	BITB	#200,(R4)	; Подсказывать прежнее значение (200)?
	BEQ	1$		; нет =>
	MOV	#177010,R5	; R5 -> регистр адреса
	MOV	-5(R4),(R5)	; Адрес прежнего значения
	ADD	R1,(R5)		; Плюс позиция курсора
	SUB	R2,(R5)		; Минус начало буфера
	TSTB	2(R5)		; Прочитать символ
	BEQ	2$		; нуль => значение кончилось
	MOVB	2(R5),(R1)+	; Взять символ в поле
	INC	EX		; Курсор вправо
	BR	WEB2		; Перерисовать поле
2$:	BICB	#200,(R4)	; Подсказки больше не нужны
1$:	INC	EX		; Курсор вправо
	INC	R1		; Указатель вправо
	BR	WEBG		; Дальше


; $WEL - "влево"
$WEL::	CMP	R1,R2		; Курсор в начале?
	BLOS	WEBG		; да =>
	DEC	EX		; Курсор влево
	DEC	R1		; Указатель влево
	BR	WEBG		; Дальше

; $WET - Tab, "вверх", "вниз": к следующему элементу
$WET::
	INC	R4		; Пропустить байт флагов
	CLRB	C.MOVE		; Не двигать курсор (см. C.MOVE)
	CALL	$CUROF		; Выключить курсор
	JMP	$BGRS		; К следующему элементу


; $WED - забой (клавиша DEL): удалить символ слева от курсора
$WED::	CMP	R1,R2		; Курсор в начале?
	BLOS	WEBG		; да =>
	DEC	R1		; Указатель влево
	MOV	R1,R5		; R5 -> удаляемый символ
1$:	MOVB	1(R5),(R5)+	; Сдвинуть остаток текста влево
	CMPB	R5,R3		; до последнего символа
	BNE	1$		; Повторить
	MOVB	#40,(R3)	; Последний - пробел
	DEC	EX		; Курсор влево
	BR	$4		; Перерисовать

; $WERS / $WELT - клавиши РУС / ЛАТ
$WERS::	MOV	#200,R0		; Русский регистр
	BR	$201		; Общая часть

$WELT::	CLR	R0		; Латинский регистр
$201:	CMP	R0,RSLT		; Режим не меняется?
	BEQ	1$		; да =>
	MOV	R0,RSLT		; Запомнить режим
	SWAB	@#7220		; Поменять местами байты
	SWAB	@#7222		; системных ячеек (назначение не выяснено)
1$:	JMP	WEBG		; Дальше


;------------------------------------------------------------------------------
; $ENTER - Enter в списке или строке ввода: обработчик из JMPADR (как $BRE)
;------------------------------------------------------------------------------
$ENTER::
	CALL	$CUROFF		; Выключить курсор
	CLRB	C.MOVE		; Не двигать курсор
	MOV	JMPADR,R0	; R0 = обработчик по Enter
	BIT	#1,R0		; Вызвать и остаться?
	BNE	1$		; да =>
	WCLOSE			; Закрыть окно
	JMP	(R0)		; Выполнить обработчик
1$:	BIC	#1,R0		; Убрать признак
	CALL	(R0)		; Вызвать обработчик
	JMP	$EXEB		; Продолжить диалог


;------------------------------------------------------------------------------
; $SHDW - тень окна (вызывается из $TSTOP). R4 после записи окна в стеке.
; Тень: справа 2 знакоместа шириной, (высота - 1) строк, начиная со строки
; ниже верха; снизу 1 строка, ширина - 4, от X + 2. Затемнение пикселей в
; 11 строках развёртки: из двух плоскостей H, L получаются H & ~L и H & L
; (цвет 0, 1, 2, 3 -> 0, 0, 1, 2; по разбору команд, не проверялось на экране).
; Самомодификация: 3$+2 - число знакомест, 8$+2 - описатель строки, 7$ и 9$ -
; счётчики (DEC (PC)+).
;------------------------------------------------------------------------------
$SHDW:	CALL	$PUSH		; Сохранить регистры
	SUB	#6,R4		; R4 -> запись окна (X, Y, ширина, высота)
	MOV	#2,3$+2		; Правая тень - 2 знакоместа (в команду 3$)
	MOVB	 (R4),R2	; R2 = X
	MOVB	2(R4),R1	; R1 = ширина
	ADD	R1,R2		; R2 = X + ширина
	TST	-(R2)		; R2 -= 2: первый столбец правой тени
	MOVB	1(R4),R3	; R3 = Y
	MOVB	3(R4),9$	; Число строк = высота
	DEC	9$		; Высота - 1 (тень со строки ниже)
	INC	R3		; Со следующей строки
	CALL	6$		; Нарисовать правую тень
	MOV	#1,9$		; Нижняя тень - 1 строка
	MOVB	1(R4),R3	; R3 = Y
	MOVB	3(R4),R1	; R1 = высота
	ADD	R1,R3		; R3 = Y + высота
	DEC	R3		; R3 = последняя строка окна
	MOVB	2(R4),3$+2	; Число знакомест = ширина
	SUB	#4,3$+2		; минус 4
	MOVB	(R4),R2		; R2 = X
	TST	(R2)+		; R2 = X + 2
	CALL	6$		; Нарисовать нижнюю тень
	CALL	$POP		; Восстановить регистры
	RETURN			; Выход

6$:	CALL	$GETY		; R0 -> описатель строки R3, R3 = видеоадрес
	MOV	R0,8$+2		; Подставить описатель в команду 8$
	MOV	#177010,R5	; R5 -> регистр адреса видеопамяти
8$:	MOV	@#2500,(R5)	; Адрес строки (описатель подставлен)
	ADD	R2,(R5)		; Плюс X
	MOV	#13,7$		; Строк развёртки в знакоместе (11)
2$:	PUSH	(R5)		; Запомнить адрес начала
3$:	MOV	#2,R1		; Число знакомест (подставляется)
1$:	MOV	4(R5),R0	; Слово 177014: L - мл., H - ст. байт
	SWAB	R0		; R0 = L, H
	MOVB	R0,4(R5)	; Младший байт := H
	SWAB	R0		; R0 = H, L (исходное)
	BICB	R0,4(R5)	; Младший байт := H & ~L
	COMB	R0		; Младший байт R0 := ~L
	BICB	R0,5(R5)	; Старший байт := H & L
	INC	(R5)		; Следующий адрес
	SOB	R1,1$		; Для всех знакомест
	POP	(R5)		; Вернуть адрес начала строки развёртки
	ADD	#121,(R5)	; К следующей строке развёртки (шаг 81)
	DEC	(PC)+		; Счётчик строк развёртки (7$)
7$:	.WORD	0		; Счётчик строк развёртки
	BNE	2$		; Для всех строк развёртки
	MOV	8$+2,R1		; R1 -> описатель текущей строки
	MOV	52(R1),8$+2	; Следующая строка (подстановка в 8$)
	DEC	(PC)+		; Счётчик строк знакомест (9$)
9$:	.WORD	0		; Счётчик строк знакомест
	BNE	8$		; Для всех строк
	RETURN			; Выход

;------------------------------------------------------------------------------
; $EXE - ввод в окне-меню (вызывается из $WIND при бите EXE). R4 - номер
; пункта, R3 - его строка экрана. Подсвечивает пункт, читает клавишу и
; переходит по таблице EXJMP: "вверх" $EU, "вниз" $ED (разделители
; пропускаются через $EMPT), Enter $EE, "влево"/"вправо" $EL, $ER, Esc $EES.
;------------------------------------------------------------------------------
$EXE::	CLR	KEYCOD		; Клавиши от прежнего окна нет
	MOV	WA,R4		; R4 -> описание окна
	CALL	$COP		; Заголовок в W0-W4
	MOVB	W3,R2		; R2 = ширина
	TST	(R2)+		; R2 = ширина + 2: ширина подсветки
	MOVB	W1,R1		; R1 = X окна
	TST	(R1)+		; R1 = X + 2: внутри рамки
	INC	W2		; Y первого пункта (под рамкой)
	DEC	W4		; W4 = номер последнего пункта
	MOV	W2,R3		; R3 = строка текущего пункта
	CLR	R4		; R4 = номер текущего пункта
$EUNK::
EBG::	CALL	$INV		; Подсветить текущий пункт
	TST	KEYCOD		; KEYCOD задан (оставлен ранее)?
	BEQ	1$		; нет => читать клавишу
	MOV	KEYCOD,R0	; R0 = эта клавиша
	BR	2$		; Не читать
1$:	FLUSH			; Сбросить буфер клавиатуры
	EMT	22		; R0 = код клавиши
	MOV	#20000,R5	; Задержка после клавиши
	SOB	R5,.		; Ждать

2$:	CALL	$INV		; Снять подсветку
REL	KEYJMP	#EXJMP		; Переход по коду клавиши (EXJMP)


$ED::	INC	R4		; Следующий пункт
	JSR	R5,$EMPT	; Разделитель перед ним? Нет - без 1-й INC
	INC	R3		; Разделитель: +1 строка (если есть)
	INC	R3		; Строка пункта + 1
	IF	R4 {= W4 THEN 1$ (B)	; Номер <= последнего => остаться
	CLR	R4		; Иначе первый пункт
	MOV	W2,R3		; Строка первого пункта
1$:	BR	$EEE		; Подсветить

$EU::	JSR	R5,$EMPT	; Разделитель перед текущим? Нет - без 1-й DEC
	DEC	R3		; Разделитель: -1 строка (если есть)
	DEC	R3		; Строка пункта - 1
	DEC	R4		; Предыдущий пункт
	BPL	1$		; Есть => остаться
	MOVB	WAREA,R3	; R3 = число разделителей
	ADD	W2,R3		; Плюс строка первого пункта
	MOV	W4,R4		; Последний пункт
	ADD	R4,R3		; R3 = его строка
1$:	BR	$EEE		; Подсветить


; $EL, $ER - "влево", "вправо": закрыть окно, если открыто через верхнее меню
; $EES - Esc: закрыть окно, передав клавишу верхнему меню
$EL::
$ER::
	TST	ENTFLG		; Режим открытого окна (ENTFLG)?
	BEQ	EBG		; нет => клавиша не нужна
$EES::	MOV	R0,KEYCOD	; Передать клавишу верхнему меню
	WCLOSE			; Закрыть окно
	RETURN			; Выход

; $EE - Enter: пункт без обработчика игнорируется, иначе его адрес в JMPADR
$EE::	MOV	R4,R5		; R5 = номер пункта
	ASL	R5		; Номер * 2
	ADD	#10,R5		; Плюс смещение таблицы обработчиков
	ADD	WA,R5		; R5 -> обработчик пункта
	MOV	(R5),R5		; R5 = обработчик
Rel	Cmp	#0,r5		; Нет обработчика? (REL: 0 релоцируется, предп.)
	Beq	Ebg		; да => остаться
;	BIT	#1,R5
;	BEQ	1$
;	BIC	#1,R5
;	PUSH	<R4,WAREA,WAREA+2,W4,W2,WA>
;	WINDOW	R5
;	POP	<WA,W2,W4,WAREA+2,WAREA,R4>
;	IF	KEYCOD = #ENTER THEN 2$
;	IF	KEYCOD {} #ESCAPE THEN $EEE
;	CLR	KEYCOD
;	BR	$EEE

1$:	MOV	R5,JMPADR	; Запомнить обработчик (выполнит $UE)
2$:	WCLOSE			; Закрыть окно
	MOV	R0,KEYCOD	; Клавиша (Enter) - верхнему меню
	RETURN			; Выход

$EEE:	BR	EBG		; Следующая клавиша

;------------------------------------------------------------------------------
; $EMPT - есть ли перед пунктом R4 разделитель (WAREA). Возврат через RTS R5:
; есть - на следующую команду за JSR, нет - с пропуском одного слова. Список
; сравнивается словами, так что рассчитан не более чем на один разделитель.
;------------------------------------------------------------------------------
$EMPT:	PUSH	R1		; Сохранить R1
REL	MOV	#WAREA,R1	; R1 -> список разделителей WAREA
	MOVB	(R1)+,R0	; R0 = их число
	BEQ	3$		; нет => не найден
1$:	IF	(R1)+ = R4 THEN 2$ (B)	; Пункт R4 после разделителя?
	SOB	R0,1$		; Дальше
3$:	TST	(R5)+		; Не найден: пропустить слово за JSR
2$:	POP	R1		; Вернуть R1
	RTS	R5		; Возврат (с пропуском или без)

;------------------------------------------------------------------------------
; $COP - заголовок окна (R4 -> описание) в W0-W4
;------------------------------------------------------------------------------
$COP:	MOVB	2(R4),W0	; W0 = тип окна
	MOVB	3(R4),W1	; W1 = X
	MOVB	4(R4),W2	; W2 = Y
	MOVB	5(R4),W3	; W3 = ширина
	MOVB	6(R4),W4	; W4 = высота (число строк)
	RETURN			; Выход

;------------------------------------------------------------------------------
; $PUSH / $POP - сохранить / восстановить R0-R5 и 177010. Вызываются CALL;
; адрес возврата временно лежит в TMP, возврат через JMP @TMP.
;------------------------------------------------------------------------------
$PUSH::	POP	TMP		; Адрес возврата в TMP
	PUSH	<R0,R1,R2,R3,R4,R5,@#177010>	; Сохранить регистры и 177010
	JMP	@TMP		; Вернуться к вызывающему

$POP::	POP	<TMP,@#177010,R5,R4,R3,R2,R1,R0>	; Адрес в TMP, регистры
	JMP	@TMP		; Вернуться к вызывающему

;------------------------------------------------------------------------------
; $KJMP - переход по коду клавиши (макрос KEYJMP, вызывается JMP, не CALL)
; Вход: R0 = код клавиши, R5 -> таблица: байт - число кодов n, n байт кодов,
; с чётного адреса n + 1 слов обработчиков (последний - "иначе").
; Выход: переход на обработчик через RTS (его адрес кладётся на стек вместо
; R5); R4, R3 сохранены, R5 = номер варианта клавиатуры * 2 (по @#7214 в
; AKTAB, формат не выяснен до конца).
;------------------------------------------------------------------------------
$KJMP::
;	Cmp	R0,#FK6
;	Bne	10$
;	Movb	#17.,FFFF
;	Call	$$DsCl
10$:	PUSH	<R5,R3,R4>	; Сохранить R5, R3, R4
	MOVB	(R5)+,R3	; R3 = число кодов в таблице
	CLR	R4		; R4 = номер обработчика * 2
2$:	IF	R0 = (R5)+ THEN 1$ (B)	; Код клавиши = очередному коду таблицы?
	TST	(R4)+		; нет: следующий обработчик
	SOB	R3,2$		; Все коды (иначе - "иначе")
1$:	MOVB	@4(SP),R3	; R3 = число кодов
	TST	(R3)+		; R3 += 2
	ADD	R3,R4		; Плюс номер * 2
	BIC	#1,R4		; R4 = смещение слова обработчика
	ADD	R4,4(SP)	; Адрес слова обработчика
	POP	<R4,R3>		; Вернуть R4 и R3
	MOV	@0(SP),(SP)	; На стек - адрес обработчика
REL	MOV	#AKTAB,R5	; Таблица значений @#7214
1$:	CMP	@#7214,(R5)+	; Найти текущее значение @#7214
	BNE	1$		; Не найдено => дальше (иначе зависание)
REL	SUB	#AKTAB+2,R5	; R5 = номер * 2 в AKTAB
	RETURN			; Переход на обработчик (адрес со стека)


;------------------------------------------------------------------------------
; $SAVE - сохранить фон под окном в видеопамяти. Вход: R4 - конец записи
; окна (X, Y, ширина, высота, адрес копии), запись становится вершиной
; стека окон WBPNT. Копируется слово за словом через 177010 и 177024 (11
; строк развёртки на строку знакомест). В следующей записи стека остаётся
; адрес начала свободной области копий.
;------------------------------------------------------------------------------
$SAVE::	MOV	R4,WBPNT	; Запись окна принята в стек окон
	CALL	$PUSH		; Сохранить регистры
	SUB	#6,R4		; R4 -> запись окна
REL	MOV	#CL.X,R0	; R0 -> CL.X (X, Y, ширина, высота)
	MOV	#4,R1		; Четыре байта
1$:	MOVB	(R4)+,(R0)+	; Байт записи в слово переменной
	INC	R0		; Пропустить старший байт
	SOB	R1,1$		; Повторить
	MOV	CL.Y,R3		; R3 = Y
	CALL	$GETY		; R0 -> описатель строки, R3 = видеоадрес
	MOV	R0,8$+2		; Подставить описатель в команду 8$
	MOV	(R4)+,R1	; R1 = адрес области копии
	MOV	#177024,R3	; R3 -> регистр 177024 (копирование, предп.)
	MOV	#177010,R0	; R0 -> регистр адреса 177010
8$:	MOV	@#2500,R2	; Адрес строки (описатель подставлен)
	ADD	CL.X,R2		; Плюс X
	MOV	#121,R5		; Шаг строки развёртки (81)
	SUB	CL.WX,R5	; Минус ширина
	MOV	#13,7$		; Строк развёртки в знакоместе (11)
3$:	MOV	CL.WX,R4	; Знакомест в строке
2$:	MOV	R2,(R0)		; Адрес = экран
	TST	(R3)		; Прочитать слово
	MOV	R1,(R0)		; Адрес = копия
	CLR	(R3)		; Записать (копирование)
	INC	R1		; Следующий адрес копии
	INC	R2		; Следующий адрес экрана
	SOB	R4,2$		; Для всех знакомест
	ADD	R5,R2		; К следующей строке развёртки
	DEC	(PC)+		; Счётчик строк развёртки (7$)
7$:	.WORD	0		; Счётчик строк развёртки
	BNE	3$		; Для всех строк развёртки
	MOV	8$+2,R4		; R4 -> описатель текущей строки
	MOV	52(R4),8$+2	; Следующая строка
	DEC	CL.WY		; Строк осталось
	BNE	8$		; есть =>
	MOV	WBPNT,R4	; R4 -> следующая запись окна
	MOV	R1,4(R4)	; В ней - начало свободной области копий
	CALL	$POP		; Восстановить регистры
	RETURN			; Выход


;------------------------------------------------------------------------------
; $CLOSE - закрыть последнее окно: вернуть сохранённый фон (обратное к
; $SAVE). Нет окон: C = 1. Остальные регистры сохраняются.
;------------------------------------------------------------------------------
$CLOSE::
REL	CMP	#WBUF,WBPNT	; Стек окон пуст?
	BNE	1$		; нет =>
	SEC			; Окон нет: C = 1
	RETURN			; Выход
1$:	CALL	$PUSH		; Сохранить регистры
	SUB	#6,WBPNT	; Снять запись окна
	MOV	WBPNT,R4	; R4 -> запись окна
REL	MOV	#CL.X,R1	; R1 -> CL.X
	MOV	#4,R2		; Четыре байта
1$:	MOVB	(R4)+,(R1)+	; Байт записи в слово переменной
	INC	R1		; Пропустить старший байт
	SOB	R2,1$		; Повторить
	MOV	CL.Y,R3		; R3 = Y
	CALL	$GETY		; R0 -> описатель строки, R3 = видеоадрес
	MOV	R0,8$+2		; Подставить описатель в команду 8$
	MOV	#177024,R3	; R3 -> регистр 177024
	MOV	#177010,R0	; R0 -> регистр адреса 177010
	MOV	(R4)+,(R0)	; Адрес = начало копии
8$:	MOV	@#2500,R4	; Адрес строки (описатель подставлен)
	ADD	CL.X,R4		; Плюс X
	MOV	(R0),R2		; R2 = адрес копии
	SUB	R4,R2		; R2 = копия - экран
	MOV	R2,R1		; R1 = R2
	INC	R1		; R1 = разность + 1
	MOV	#121,R5		; Шаг строки развёртки (81)
	SUB	CL.WX,R5	; Минус ширина
	MOV	#13,7$		; Строк развёртки в знакоместе (11)
4$:	MOV	CL.WX,R4	; Знакомест в строке
5$:	TST	(R3)		; Прочитать слово копии
	SUB	R2,(R0)		; Адрес = экран
	CLR	(R3)		; Записать
	ADD	R1,(R0)		; Адрес = следующее слово копии
	SOB	R4,5$		; Для всех знакомест
	SUB	R5,R2		; Разность меняется: экран ушёл
	SUB	R5,R1		; дальше копии на шаг строки
	DEC	(PC)+		; Счётчик строк развёртки (7$)
7$:	.WORD	13.		; Счётчик (задаётся MOV #13,7$)
	BNE	4$		; Для всех строк развёртки

	MOV	8$+2,R4		; R4 -> описатель текущей строки
	MOV	52(R4),8$+2	; Следующая строка
	DEC	CL.WY		; Строк осталось
	BNE	8$		; есть =>
	CALL	$POP		; Восстановить регистры
6$:	RETURN			; Выход

;------------------------------------------------------------------------------
; $GETY - видеоадрес строки знакомест. Вход: R3 = номер строки. Выход: R0 ->
; описатель строки, R3 = его первое слово (видеоадрес). Описатели - связный
; список от @#2476, ссылка в слове +52.
;------------------------------------------------------------------------------
$GETY::	MOV	@#2476,R0	; R0 -> описатель первой строки экрана
	IF	R3 = #0 THEN 2$	; Строка 0?
1$:	MOV	52(R0),R0	; К следующей строке (связный список)
	SOB	R3,1$		; Повторить R3 раз
2$:	MOV	(R0),R3		; R3 = видеоадрес строки
	RETURN			; Выход

;$PRTN::	CALL	$PUSH
;	MOV	@#22544,R0
;1$:	MOVB	(R4)+,(R0)+
;	BIC	#200,R0
;	INC	@#7064
;	SOB	R5,1$
;	MOV	R0,@#22544
;	TRAP	0
;	CALL	$POP
;	RETURN

;------------------------------------------------------------------------------
; $PRTZ - вывести ASCIZ-строку из TTBUF; PR - вывести строку по адресу R1
; (копируется в TTBUF). Вывод идёт через очередь терминала ПП: границы в
; T1PTR и TTPTR, длина в TPROC, затем TRAP 0 (имена по IDE.MAC, как именно
; используются TTPTR и T1PTR - не выяснено до конца).
;------------------------------------------------------------------------------
$PRTZ::	CALL	$PUSH		; Сохранить регистры
	MOV	#TTBUF,R1	; R1 -> буфер строки
	MOV	R1,@#T1PTR	; T1PTR := начало буфера (см. IDE.MAC)
1$:	IF	(R1)+ {} #0 THEN 1$ (B)	; Найти нуль-байт
	CALL	$$PR		; Вывести строку
	CALL	$POP		; Восстановить регистры
	RETURN			; Выход

PR::
	Call	$Push		; Сохранить регистры
	Mov	R1,r0		; R0 -> строка
	Mov	#TtBuf,r1	; R1 -> буфер TTBUF
	Mov	r1,@#T1Ptr	; T1PTR := начало буфера
1$:	Movb	(r0)+,(r1)+	; Копировать строку в TTBUF
	Bne	1$		; до нуль-байта
	Call	$$Pr		; Вывести
	Call	$Pop		; Восстановить регистры
	Return			; Выход


$$PR::	MOV	R1,@#TTPTR	; TTPTR := конец строки (за нуль-байтом)
	SUB	#TTBUF,R1	; R1 = длина с нуль-байтом
	MOV	R1,@#TPROC	; TPROC := длина (признак процесса терминала)
	TRAP	0		; Запустить вывод (INT34 в MEMORY.MAC)
	RETURN			; Выход

;------------------------------------------------------------------------------
; SCRBLP - нарисовать полосу прокрутки и бегунок; SCRBLM - только сдвинуть
; бегунок. Вход: R5 -> описатель: байт 0 - 0 горизонтальная, иначе вертикальная;
; байты 1, 2 - X, Y начала; байт 3 - длина дорожки; слова: +4 адрес текущего
; значения, +6 максимум, +10 номер ячейки бегунка (-1 - не нарисован).
; Знаки (шрифт IDE): 200-203 стрелки, 204 дорожка, 206 бегунок.
; Описатели - ESLHOR, ESLVER в IDDAT.MAC, ESLDIR в IDE.MAC.
;------------------------------------------------------------------------------
SCRBLP::
	CALL	$PUSH		; Сохранить регистры
	COLOR	BLUE,CYAN	; Цвет полосы
REL	MOV	#SCRDIR,R4	; R4 -> знаки горизонтальной полосы
	TSTB	(R5)		; Вертикальная (байт 0 <> 0)?
	BEQ	1$		; нет =>
	ADD	#6,R4		; Знаки вертикальной полосы
1$:	MOVB	1(R5),R2	; X начала
	MOVB	2(R5),R3	; Y начала
	CALL	$100		; Курсор в начало
	MOVB	(R4),R0		; Знак начала (стрелка)
	EMT	42		; Вывести
	ADD	2(R4),R2	; Шаг по X
	ADD	4(R4),R3	; Шаг по Y
	CALL	$100		; Курсор на следующую ячейку
	MOVB	3(R5),R1	; R1 = длина дорожки
	MOV	#204,R0		; Знак дорожки
2$:	EMT	42		; Вывести
	ADD	2(R4),R2	; Шаг по X
	ADD	4(R4),R3	; Шаг по Y
	CALL	$100		; Курсор на следующую ячейку
	SOB	R1,2$		; Для всей дорожки
	MOVB	1(R4),R0	; Знак конца (стрелка)
	EMT	42		; Вывести
	MOV	#-1,10(R5)	; Бегунок не нарисован
	BR	$101		; Нарисовать бегунок

$100:	LOCATE	R2,R3		; Курсор в (R2, R3)
	RETURN			; Выход

SCRBLM::
	CALL	$PUSH		; Сохранить регистры
	COLOR	BLUE,CYAN	; Цвет полосы

$101:	MOV	@4(R5),R1	; R1 = текущее значение
	MOVB	3(R5),R0	; R0 = длина дорожки
	MUL	R0,R1		; R1 = значение * длина
	CLR	R0		; Старшее слово делимого
	DIV	6(R5),R0	; R0 = ячейка = значение * длина / максимум
	CMP	R0,10(R5)	; Бегунок на месте?
	BEQ	1$		; да =>
	PUSH	R0		; Запомнить новую ячейку
	MOV	10(R5),R0	; R0 = прежняя ячейка
	BMI	2$		; не рисован =>
	CALL	$102		; Курсор на прежнюю ячейку
	MOV	#204,R0		; Знак дорожки
	EMT	42		; Стереть бегунок
2$:	POP	R0		; R0 = новая ячейка
	MOV	R0,10(R5)	; Запомнить
	CALL	$102		; Курсор на новую ячейку
	MOV	#206,R0		; Знак бегунка
	EMT	42		; Нарисовать
1$:	CALL	RSTCOL		; Вернуть прежний цвет
	CALL	$POP		; Восстановить регистры
	RETURN			; Выход


; $102 - курсор на ячейку R0 полосы (0 - первая после стрелки)
$102:	INC	R0		; Пропустить знак начала
	CMPB	R0,3(R5)	; Не дальше длины?
	BLO	3$		; да =>
	MOVB	3(R5),R0	; Ограничить длиной
3$:	MOVB	1(R5),R2	; X начала
	MOVB	2(R5),R3	; Y начала
	TSTB	(R5)		; Вертикальная?
	BEQ	1$		; нет =>
	ADD	R0,R3		; Y += номер
	BR	2$		; Установить курсор
1$:	ADD	R0,R2		; X += номер
2$:	BR	$100		; Установить курсор

.PSECT	DATA

; SCRDIR - знаки и шаги полос (горизонтальной, вертикальной)
SCRDIR:	.BYTE	202,203		; Горизонтальная: знак начала, конца
	.WORD	1,0		; шаг по X, по Y
	.BYTE	200,201		; Вертикальная: знак начала, конца
	.WORD	0,1		; шаг по X, по Y
; COLRS - заливки фона 0-7 ($COLOR): код цвета в каждой тетраде слова
COLRS::
	.Word	0,10421,21042,31463,42104,52525,63146,73567

	.End
