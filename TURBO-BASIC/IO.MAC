;******************************************************************************
;*                     Блок  ввода/вывода ТурбоБейсик                         *
;*                      Проект ТурбоБейсик для УК-НЦ                          *
;*                       Распространение свободное                            *
;*               1986 Вильнюс, 24/10/95 (Герасимов Олег)                      *
;******************************************************************************
;------------------------------------------------------------------------------
; IO - ввод-вывод Бейсика (ЦП). Консоль: регистры терминала 177560-177566
; обслуживает ПП: ISV выводит символ через 177564/177566, клавиатура приходит
; прерыванием IVS (вектор 60) в очередь FIRST/LAST (кольцо между FCB и DFCB).
; Экранного редактора IVEIL и ESC-обработки версии 1988 нет - экран и курсор
; ведёт ПП. Режим РУС/ЛАТ: признак RUSLAT (200 - РУС) и коды
; 16 (РУС) и 17 (ЛАТ) терминалу. Вывод перенаправляется IODEV: 0 - экран,
; > 0 - файл, < 0 - принтер.
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; Происхождение: Бейсик Вильнюс 1988 (IO.MAC). Сверка по тексту без
;     комментариев: блоков без изменений 8, изменённых 12, новых 5; строк кода
;     совпало 143 из 240 (59%). Метки блоков: [1988=] без изменений, [1988~N%]
;     изменено, [НОВОЕ] нет в 1988
; Главное: Экранный редактор 1988 (IVEIL, INBF1/INBF2, диспетчер символов
;     PROC/PROCLF с таблицами KOM/KOD и обработчиками K..., буфер EBUF, ROLL,
;     SETWDT/ширина, курсор CSCR/RSCR) заменён тонким слоем над терминалом ПП:
;     символ идёт прямо в регистр 177566, экран и курсор ведёт ПП. Из 1988
;     остались очередь клавиатуры (IV, NIM, IVS), вывод на принтер и в файл.
;     Убраны управление BREAK (NOSTOP/STOPEN/BRUK), ленточный драйвер (MOUT,
;     MAGNIT) и пустая точка ISVSS; GetTXY и BS новые.
; Блоки 1988, которых нет в Турбо (48): SETWDT, IVEIL, INBF1, INBF2, ENDISV,
;     PROCLF, PROC, K33, K40, KL, KR, KK, KKK, K177, K11, K37, K13, K14, K15,
;     K101, K102, K103, K104, EPR, EPB, K23, K24, KC, ROLL, ROLL2, K10, K25,
;     K26, K12, ISV2, ISV0, ISV1, EISV, SETALF, KOM, KOD, BRUK, BREAKD, NOSTOP,
;     STOPEN и ещё 3
; Блоки 1988, перенесённые в другие модули Турбо (1): SIGNAL (JEXT.MAC)
;------------------------------------------------------------------------------

	.INCLUDE /GENUKD.MAC/	; Настройки сборки (GENUKD.MAC)
	.SBTTL	INOUT		; Заголовок листинга
	.ENABLE	LC		; Строчные буквы в тексте

;******************************************************************************
;*                       Константы блока ввода/вывода                         *
;******************************************************************************

	LF	== 12		; Перевод строки
	CR	== 15		; Возврат каретки
	FF	== 14		; Перевод формата (очистка экрана)
	ESC	== 33		; ESC
	ERRBYT	== 52		; Байт ошибки RT-11 (ячейка 52)
	MCSR	= 176674	; Статус канала ПП
	MDBR	= 176676	; Данные канала ПП
	AWPM	= 474		; Вектор дисковода
	ARSK	== 177560	; Статус клавиатуры
	ARDK	= 177562	; Данные клавиатуры
	ARSTV	= 177564	; Статус вывода на терминал
	ARDTV	= 177566	; Данные вывода на терминал
	AVPK	== 60		; Вектор клавиатуры
	LN	== 23.		; Строк экрана
	MAXLL	== 80.		; Символов в строке
	IRPR=176664		; Статус принтера (данные - IRPR+2)
	AWPKL==60		; Вектор клавиатуры (тот же адрес)
	DEVEXT==0

.PSECT	BASIC			; Секция кода Бейсика

;------------------------------------------------------------------------------
; [1988~83%] изменено, IO.MAC:80-103: MIDM (1988: 15 строк кода, здесь 6;
;     добавлено/изменено 1, удалено 10). Отличия: в 1988 - аппаратный сброс
;     (.HRESET), NOSTOP, вывод FF при максимальной ширине экрана и затем SETWDT
;     с рабочей шириной 64, STOPEN; здесь остались маркер BUF (5007), IODEV =
;     0, GrInit и KOM2P.
;------------------------------------------------------------------------------
;******************************************************************************
;*                            Инициализация блока                             *
;******************************************************************************
; MIDM - начальные значения ввода-вывода
MIDM::	Mov	#5007,@#Buf	; Начало BUF: 5007 (маркер, как в 1988)
	Clr	@#IODev		; Вывод на экран
	Call	GrInit		; Графика: начальные значения
	Clrb	@#Kom2P		; Нет кодов второй системы команд
	Return			; Выход

;------------------------------------------------------------------------------
; [1988~91%] изменено, IO.MAC:129-141: ISVTO (1988: 13 строк кода, здесь 12;
;     добавлено/изменено 1, удалено 2)
;------------------------------------------------------------------------------
;******************************************************************************
;*                        Вывод символа на устройство                         *
;******************************************************************************
; ISVTO - вывести символ R0 с учётом IODEV (экран - ISV, иначе строкой в ISVETO)
ISVTO::	TST	IODEV		; Вывод на экран?
	BEQ	ISV		; да => обычный вывод символа
	MOV	#BUFOUT,R1	; R1 -> буфер из одного символа
	MOV	#1,R2		; Длина 1
	CMPB	R0,#LF		; Символ LF?
	BNE	1$		; нет =>
	INC	R2		; Длина 2
	MOVB	R0,1(R1)	; LF - вторым байтом
	MOV	#CR,R0		; CR - первым
1$:	MOVB	R0,@R1		; Символ в буфер
	JMP	ISVETO		; Вывести как строку


;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: INBF0, BS, Isv, ISVEIL (блоков: 4). в
;     1988 INBF0 вводит строку полноэкранным редактором IVEIL в экранном буфере
;     и извлекает текст из него (INBF2, счётчик прокрутки SCRL); здесь простой
;     ввод: клавиша через IV, эхо через ISV, ESC пропускает следующий код,
;     DEL/377 стирает символ строкой BS, Enter заканчивает строку LF и
;     отправляет терминалу код 25 (Ctrl-U: CR+LF в ПЗУ ПП), РУС/ЛАТ (16/17)
;     передаются терминалу, в буфере до 255 символов. INBF1 (вход для ANALIZ)
;     нет.
;------------------------------------------------------------------------------
;******************************************************************************
;*                        Ввод символов для Input                             *
;******************************************************************************
; INBF0 - ввод строки для INPUT в BUF с эхо; Enter - LF в конец, C = 1
INBF0::	Push	r3		; Сохранить R3
	Push	r0		; и R0
	Mov	#Buf,r3		; R3 -> буфер ввода
2$:	Call	Iv		; Клавиша (ждать)
	Cmpb	r0,#40		; Печатный символ?
	Bhis	4$		; да =>
	Cmpb	r0,#33		; ESC?
	Bne	1$		; нет =>
	Call	Iv		; Пропустить код после ESC
	Br	2$		; Дальше
1$:	Cmpb	r0,#15		; Enter?
	Beq	7$		; да => конец строки
	Cmpb	r0,#16		; РУС?
	Beq	3$		; да =>
	Cmpb	r0,#17		; ЛАТ?
	Bne	2$		; нет => другой код, игнорировать
3$:	Call	Isv		; Передать терминалу (смена режима)
	Br	2$		; Дальше
4$:	Cmpb	#177,r0		; DEL?
	Beq	5$		; да =>
	Cmpb	#377,r0		; DEL в режиме РУС (старший бит)?
	Bne	6$		; нет => обычный символ
5$:	Cmp	r3,#Buf		; Буфер пуст?
	Beq	2$		; да => игнорировать
	Mov	#BS,r1		; R1 -> строка стирания символа
	Clr	r2		; Конец строки - нуль-байт
	Call	ISVEIL		; Стереть символ на экране
	Dec	r3		; Убрать символ из буфера
	Br	2$		; Дальше
6$:	Cmp	r3,#Buf+377	; Буфер полон (255 символов)?
	Bhis	2$		; да => игнорировать
	Movb	r0,(r3)+	; Символ в буфер
	Call	Isv		; Эхо на экран
	Br	2$		; Дальше
7$:	Movb	#12,(r3)+	; Конец строки: LF в буфер
	Mov	#25,r0		; Код 25 (Ctrl-U: CR+LF в ПЗУ ПП)
	Call	ISV		; Вывести
	Cmp	#Buf,r3		; Флаги: C = 1 - строка введена
	Pop	r0		; Вернуть R0
	Pop	r3		; и R3
	Return			; Выход

BS:	.Byte	33,104,40,33,104,0	; Влево, пробел, влево (ESC D)

;	;----------------------------------------------
;	;	ВЫВОД СИМВОЛА
;	;		ВХОД:	РО-КОД СИМВОЛА
;	;----------------------------------------------
	
;------------------------------------------------------------------------------
; ISV - вывести символ R0 на терминал и учесть смену режима РУС/ЛАТ
;------------------------------------------------------------------------------
Isv::
	Tstb	@#ARSTV		; Терминал готов?
	Bpl	.-4		; нет => ждать
	Movb	r0,@#ARDTV	; Передать символ
	Cmp	r0,#14.		; Код РУС (14. = 16 восьм.)?
	Bne	1$		; нет =>
	Mov	#200,RusLat	; Режим РУС
1$:	Cmpb	r0,#15.		; Код ЛАТ (15. = 17 восьм.)?
	Bne	2$		; нет =>
	Clr	RusLat		; Режим ЛАТ
2$:	Return			; Выход


	;--------------------------------------------
	;	ВЫВОД СТРОКИ
	;		ВХОД:	R1-НАЧАЛЬНЫЙ АДРЕС
	;			R2-ДЛИНА (МЛАДШИЙ БАЙТ)
	;			  -ПРИЗНАК КОНЦА (СТАРШИЙ БАЙТ)
	;--------------------------------------------
	;
ISVEIL::
	Push	r0		; Сохранить R0
	Push	r3		; и R3

	Push	RusLat		; Запомнить режим РУС/ЛАТ
	Beq	4$		; ЛАТ => терминал уже в ЛАТ
	Mov	#15.,R0		; Код ЛАТ (17 восьм.)
	Call	ISV		; Терминал - в ЛАТ на время вывода
4$:	Pop	RusLat		; Вернуть признак режима

	Mov	R2,R3		; R3 = R2
	Swab	R3		; R3 = код конца (старший байт R2)
1$:	Movb	(R1)+,R0	; Символ
	Cmpb	R0,R3		; Конец строки?
	Beq	2$		; да =>
	Call	ISV		; Вывести
	Sob	R2,1$		; Следующий (SOB берёт весь R2)

2$:	Tst	RusLat		; Был режим РУС?
	Beq	3$		; нет =>
	Mov	#14.,r0		; Код РУС (16 восьм.)
	Call	ISV		; Вернуть терминал в РУС

3$:	Pop	r3		; Вернуть R3
	Pop	r0		; и R0
	Return			; Выход
	

;------------------------------------------------------------------------------
; [1988~54%] изменено, IO.MAC:816-832: LOK (1988: 16 строк кода, здесь 11;
;     добавлено/изменено 5, удалено 10). Отличия: в 1988 позиционирование ESC Y
;     с поправкой MIDLE (центрирование при ширине меньше максимальной), через
;     ISV1/ISV2 и с отключением BREAK; здесь через ISV, без MIDLE и без BREAK.
;------------------------------------------------------------------------------
				;------ КУРСОР В ПОЛОЖЕНИЕ TABX,TABY
; LOK - ESC Y: курсор в позицию TabX, TabY
LOK::
	Mov	#33,r0		; ESC
	Call	Isv		; Вывести
	Mov	#131,R0		; "Y" (ESC Y строка столбец)
	Call	ISV		; Вывести
	Mov	TabY,R0		; Строка
	Add	#40,R0		; Плюс 40 (восьм.)
	Call	ISV		; Вывести
	Mov	TabX,R0		; Столбец
	Add	#40,R0		; Плюс 40 (восьм.)
	Jmp	ISV		; Вывести и выйти
;	Return

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: GetTXY. положение курсора берётся у
;     драйвера TGRAPH (команда 23, F23: столбцов справа и строк снизу); в 1988
;     TABX/TABY вёл экранный редактор.
;------------------------------------------------------------------------------
; GetTXY - положение курсора ПП в TabX, TabY (команда 23. драйвера TGRAPH, F23)
GetTXY::
	Mov	#23.,CodP	; Команда драйвера графики 23.
	Call	PPExe		; Выполнить
	Tstb	DrvReg		; Ждать конца (бит 7 DRVREG)
	Bpl	.-4		; Не кончилась => ждать
	Mov	Work0,TabX	; Work0 = столбцов справа
	Sub	#80.,TabX	; TabX = 80. - Work0
	Neg	TabX		; (столбец)
	Mov	Work1,TabY	; Work1 = строк снизу
	Sub	#24.,TabY	; TabY = 24. - Work1
	Neg	TabY		; (строка)
	Return			; Выход



;------------------------------------------------------------------------------
; [1988=] без изменений (IO.MAC:944-949): IV
;------------------------------------------------------------------------------
; IV / NIM - символ с клавиатуры в R0 (IV ждёт; NIM - очередь не пуста)
IV::
	MFPS	-(SP)		; Сохранить PS
	MTPS	#0		; Прерывания разрешены (IVS наполняет очередь)
1$:	CMP	FIRST,LAST	; Очередь клавиатуры пуста?
	BEQ	1$		; да => ждать
	MTPS	(SP)+		; Вернуть PS

;------------------------------------------------------------------------------
; [1988~50%] изменено, IO.MAC:953-956: NIM (1988: 4 строк кода, здесь 6;
;     добавлено/изменено 3, удалено 1). Отличия: режим РУС: старший бит
;     ставится всем кодам >= 100, включая DEL (в 1988 DEL исключён, и бит
;     ставился только если RUSLAT <> 0); RUSLAT здесь сама маска 200.
;------------------------------------------------------------------------------
NIM::
	Clr	r0		; R0 = 0
	Bisb	@FIRST,R0	; R0 = байт из головы очереди
	Cmpb	r0,#100		; Управляющий код?
	Blo	MovFrs		; да => как есть
	Bisb	RusLat,r0	; Режим РУС: старший бит (DEL станет 377)

;------------------------------------------------------------------------------
; [1988=] без изменений (IO.MAC:962-1013): MOVFRS, ISVETO (блоков: 2)
;------------------------------------------------------------------------------
MOVFRS:	INC	FIRST		; Продвинуть начало очереди
	CMP	FIRST,DFCB	; Конец буфера?
	BNE	1$		; нет =>
	MOV	FCB,FIRST	; В начало (кольцевой буфер)
1$:	RETURN			; Выход


;------------------------------------------------------------------------------
; ISVETO - вывод строки R1, R2 (код конца в старшем байте) по IODEV: экран -
; ISVEIL, файл - FILOUT, принтер - ниже (LF как CR; LPTPOS - позиция головки)
;------------------------------------------------------------------------------
ISVETO::
	TST	IODEV		; Вывод на экран?
	BNE	LP		; нет =>
	JMP	ISVEIL		; Экран

;------------------------------------------------------------------------------
; [1988~96%] изменено, IO.MAC:1014-1070: LP (1988: 51 строк кода, здесь 33;
;     добавлено/изменено 1, удалено 19). Отличия: убраны коды РУС/ЛАТ принтеру
;     (16/17 по признаку LPLCFL для символов >= @ и >= 200+@); остальное без
;     изменений (LPLCFL осталась в DT.MAC).
;------------------------------------------------------------------------------
LP:	MOV	R0,-(SP)	; Сохранить R0
	MOV	R3,-(SP)	; и R3
	MOV	R2,R3		; R3 = R2
	SWAB	R3		; R3 = код конца строки
	CMPB	R3,#LF		; Конец - LF?
	BNE	7$		; нет =>
	MOVB	#CR,R3		; Принтер: LF идёт как CR - конец тоже
7$:	BIC	#177400,R2	; R2 = число символов
	MOV	@#IODEV,R0	; R0 = IODEV
	BPL	FILOUT		; IODEV > 0 => файл

1$:	CMPB	@R1,#LF		; Символ LF?
	BNE	9$		; нет =>
	MOVB	@R1,R0		; LF: послать как есть,
	MOVB	#CR,@R1		; в источнике заменить на CR
	INC	R2		; Позиция пройдёт ещё раз (как CR)
	BR	10$		; Послать

9$:	CMPB	@R1,#CR		; Символ CR?
	BEQ	6$		; да =>
	CMPB	@R1,#FF		; Символ FF?
	BNE	4$		; нет =>

6$:	MOV	#-1,@#LPTPOS	; Позиция принтера -1 (ниже +1 = 0)
4$:	INC	@#LPTPOS	; Позиция принтера + 1
	MOVB	(R1)+,R0	; Символ
10$:	CALL	LPISV		; Послать принтеру
	CMPB	R0,R3		; Конец строки?
	BEQ	8$		; да =>
	SOB	R2,1$		; Следующий
	BR	5$		; Выход

8$:	DEC	R2		; Конец уже послан: учесть в R2
5$:	MOV	(SP)+,R3	; Вернуть R3
	MOV	(SP)+,R0	; и R0
	RETURN			; Выход

;------------------------------------------------------------------------------
; [1988~80%] изменено, IO.MAC:1073-1077: LPISV (1988: 5 строк кода, здесь 5;
;     добавлено/изменено 1, удалено 1). Отличия: только оформление: ожидание
;     готовности принтера BPL .-4 вместо BPL LPISV (то же самое).
;------------------------------------------------------------------------------
; LPISV - байт R0 на принтер
LPISV:
	TSTB	@#IRPR		; Принтер готов?
	BPL	.-4		; нет => ждать
	MOV	R0,@#IRPR+2	; Послать байт
	RETURN			; Выход
	;

;------------------------------------------------------------------------------
; [1988~93%] изменено, IO.MAC:1082-1096: FILOUT (1988: 15 строк кода, здесь 15;
;     добавлено/изменено 1, удалено 1). Отличия: только оформление: CALL FNDBUF
;     вместо .BJSR FNDBUF (на УКНЦ макрос раскрывался в CALL).
;------------------------------------------------------------------------------
; FILOUT - вывод в файл IODEV (PRINT#): запись через COPOUT
FILOUT:
	TST	(SP)+		; Снять R3 (не восстанавливается)
	MOV	R0,R3		; R3 = номер файла
	Call	FNDBUF		; R0 -> FCB файла
	TST	@R0		; Файл открыт?
	BEQ	NOTOP		; нет => ошибка
	BIT	#4000,@R0	; Открыт для вывода?
	BNE	NOTOUT		; нет => ошибка
	CLR	R3		; R3 = 0
	BISB	@R0,R3		; R3 = счётчик заполнения буфера
	ADD	R0,R3		; Плюс FCB
	ADD	#22,R3		; R3 -> место в буфере файла
	CALL	COPOUT		; Записать
	MOV	(SP)+,R0	; Вернуть R0
	RETURN			; Выход

;------------------------------------------------------------------------------
; [1988~100%] изменено, IO.MAC:1103-1117: COPOUT (1988: 15 строк кода, здесь
;     14; добавлено/изменено 0, удалено 1). Отличия: после записи блока не
;     вызывается BLOCKN (в 1988 - увеличение трёхзначного ASCII-номера блока в
;     записи FCB; в Турбо такой подпрограммы нет, блоки пишет CAS) - возможное
;     изменение поведения, не проверено.
;------------------------------------------------------------------------------
; COPOUT - R2 байт из (R1) в буфер файла (R3, FCB в R0); полный - блок на диск
COPOUT::DEC	R2		; Байты кончились?
	BMI	1$		; да =>
	MOVB	(R1)+,(R3)+	; Байт в буфер файла
	INCB	@R0		; Счётчик заполнения (мл. байт FCB)
	BNE	COPOUT		; Буфер не полон =>
	MOV	R1,-(SP)	; Запомнить позицию в источнике
	CALL	CASCII		; Подготовить запись блока
	CALL	CAS		; Записать блок на диск
	BIS	#400,@R0	; Отметить блок
	MOV	(SP)+,R1	; Вернуть позицию
	SUB	#400,R3		; R3 на начало буфера
	BR	COPOUT		; Дальше
1$:	RETURN			; Выход

;------------------------------------------------------------------------------
; [1988=] без изменений (IO.MAC:1118-1119): NOTOUT, NOTOP (блоков: 2)
;------------------------------------------------------------------------------
NOTOUT:	TRAP	52.		; Ошибка 52: ошибочный номер файла
NOTOP:	TRAP	59.		; Ошибка 59: файл не открыт

;------------------------------------------------------------------------------
; [1988~100%] изменено, IO.MAC:1125-1133: WAIT (1988: 9 строк кода, здесь 6;
;     добавлено/изменено 0, удалено 3). Отличия: в 1988 очистка регистра ARSK
;     выполнялась с повышенным приоритетом (MFPS/MTPS #340); здесь без этого
;     (код вызывается из обработчика прерывания).
;------------------------------------------------------------------------------
; WAIT - пустой код клавиатуры: ждать готовности и RTI (ветка IVS)
WAIT:
	CLR	@#ARSK		; Запретить прерывания клавиатуры
1$:	TSTB	@#ARSK		; Устройство готово?
	BPL	1$		; нет => ждать
	MOV	#100,@#ARSK	; Разрешить прерывания клавиатуры
	RTI			; Выход из прерывания

;------------------------------------------------------------------------------
; [1988=] без изменений (IO.MAC:1140-1221): IVS, DEJA, USEROM (блоков: 3)
;------------------------------------------------------------------------------
; IVS - прерывание клавиатуры: байт в очередь (кольцо; полна - сдвиг FIRST)
IVS::	MOVB	@#ARDK,@LAST	; Принять байт в очередь
	BEQ	WAIT		; Пустой код => ждать готовности
	INC	LAST		; Указатель записи
	CMP	LAST,DFCB	; Конец буфера?
	BNE	1$		; нет =>
	MOV	FCB,LAST	; В начало (кольцевой буфер)
1$:	CMP	LAST,FIRST	; Очередь переполнена?
	BNE	DEJA		; нет =>
	CALL	MOVFRS		; Да: сдвинуть и начало очереди
DEJA:	RTI			; Выход из прерывания

USEROM::TRAP	5		; Ошибка 5: неправильный вызов функции


;------------------------------------------------------------------------------
; [1988~33%] изменено, IO.MAC:1287-1293: CURON (1988: 6 строк кода, здесь 3;
;     добавлено/изменено 2, удалено 5). Отличия: в 1988 мигающий символ через
;     MIG с CHAR-1; здесь команда драйвера графики цвета курсора 7 (F19): MIG в
;     GRAFUK.MAC, R1 = цвет.
;------------------------------------------------------------------------------
; CURON / CUROFF - курсор: цвет 7 / 0 (MIG в GRAFUK, команда 19. = F19)
CURON::
	Mov	#7,r1		; Цвет курсора 7 (виден)
	Jmp	MIG		; Команда драйвера (цвет курсора)

;------------------------------------------------------------------------------
; [1988~33%] изменено, IO.MAC:1294-1297: CUROFF (1988: 4 строк кода, здесь 3;
;     добавлено/изменено 2, удалено 3). Отличия: то же с цветом 0; пустой хвост
;     ISVSS убран.
;------------------------------------------------------------------------------
CUROFF::
	Clr	r1		; Цвет курсора 0 (не виден)
	Jmp	Mig		; Команда драйвера (цвет курсора)

;------------------------------------------------------------------------------
; [1988~66%] изменено, IO.MAC:1224-1224: KOMDEV (1988: 2 строк кода, здесь 3;
;     добавлено/изменено 1, удалено 0). Отличия: те же команды драйвера диска
;     (RD., WR., FR.), что в 1988; отличие только в том, что в сегмент попал
;     .END.
;------------------------------------------------------------------------------
KOMDEV::.BYTE	RD.,16,WR.,21,FR.,0	; Команды драйвера диска (DISK.MAC)
	.END

