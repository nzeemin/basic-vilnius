; [1988=] без изменений (COMP.MAC:786-789): READ
;------------------------------------------------------------------------------
	;
	READ::
		MOV	#READV,(1)+
		CLR	-(SP)
		BR	INPENT

;------------------------------------------------------------------------------
; [1988~100%] изменено, COMP.MAC:793-833: INPUT (1988: 40 строк кода, здесь 37;
;     добавлено/изменено 0, удалено 3). Отличия: убрана ветка прямого режима
;     (TSTB LYGIS, RETCRT).
;------------------------------------------------------------------------------
	;
	INPUT::
		TRAP	120
		BR	10$
		MOV	#LIT,(R1)+
		TRAP	112
		CMPB	(R3)+,#';
		BNE	SYNERR
		TRAP	112
		CLR	-(SP)
		MOV	#GETLIT,(R1)+
		BR	INPENT
	
	10$:	JSR	R2,TSTFLN
	11$:	MOV	#GET,(R1)+
	
	INPENT:	MOV	R1,-(SP)
		TST	(R1)+
	1$:	CLR	R4
		MOV	R1,-(SP)
		TST	(R1)+
		TRAP	107
		NOP
		TSTB	R5
