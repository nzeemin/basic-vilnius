;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: DATA. текст DATA копируется в код после
;     JMP и блоки связываются через DATPTR (слово-ссылка на чётном адресе);
;     читает их GET в JMIN.MAC; в 1988 DATA хранилась иначе.
;------------------------------------------------------------------------------
	;
	;
	DATA::	
		MOV	#JMP,(R1)+		; Код перехода
		PUSH	R1			
		CLR	(R1)+			; Место для адреса след. оператора
		MOV	R1,@DATPTR		; Заполнить указатель предыдущего DATA
	1$:	MOVB	(R3)+,(R1)+		; Переписать данные
		CMPB	#12,-1(R3)
		BNE	1$

	 	INC	R1			; DATPTR = ((WORD *)(R1)+1)
		BIC	#1,R1
		MOV	R1,DATPTR
		CLR	(R1)+			; Место для указатель на следующий DATA
		MOV	R1,@(SP)+		; Заполнить адрес след. команды
		DEC	R3
		RETURN
	;
	; Оператор RESTORE
	

;------------------------------------------------------------------------------
; [1988~57%] изменено, COMP.MAC:756-781: RESTOR (1988: 27 строк кода, здесь 7;
;     добавлено/изменено 3, удалено 23). Отличия: RESTORE: без номера - REST0,
;     с номером - JMP TO1 (метка через LABTOP); в 1988 здесь был разбор номера
;     строки, прямой режим и ветки AUTO.
;------------------------------------------------------------------------------
	RESTOR::
		TRAP	110			; Метка присутствует ?
		BR	1$			; Нет 1$ ->
		MOV	#RESTV,(R1)+		; RESTORE <LINE NUMBER>	
		JMP	TO1
	1$:	MOV	#REST0,(R1)+		; DEFAULT RESTORE.
		RETURN
		
		



