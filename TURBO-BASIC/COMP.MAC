
;------------------------------------------------------------------------------
; Происхождение: Бейсик Вильнюс 1988 (COMP.MAC). Сверка по тексту без
;     комментариев: блоков без изменений 36, изменённых 43, новых 30; строк
;     кода совпало 965 из 1260 (76%). Метки блоков: [1988=] без изменений,
;     [1988~N%] изменено, [НОВОЕ] нет в 1988
; Главное: Компилятор операторов в шитый код: структура и большинство
;     подпрограмм как в 1988. Главные изменения: нет OPRNAM/AOPNAM - имена
;     операторов ищет SEEK по деревьям TABL.MAC, а AOPSUB - таблица подпрограмм
;     компиляции в порядке номеров TAB.TXT; команды монитора (NEW, LIST, RUN,
;     LOAD, SAVE, MERGE, FIND, TRON/TROFF, AUTO...) убраны вместе со всеми
;     проверками прямого режима (LYGIS) и TRAP 106 (конец оператора); .T и
;     .BJSR/.BJSRA заменены на TRAP и CALL (на УКНЦ то же самое); ссылки на
;     строки идут через таблицу меток LABTOP (TSTLAB), а не TRAP 110/111;
;     добавлены REPEAT/UNTIL/WHILE/WEND, GET/PUT, PALETTE, SOUND, FSOUND,
;     NOSOUND, PAGE, DELAY, FPUT/FGET/FSAVE/FLOAD/CLOAD, SMODE, _-операторы
;     (..CREATE и др.), OPEN ... FOR APPEND, DEFINT/DEFSNG/DEFSTR (DEFTYP),
;     WIDTH - заглушка.
; Блоки 1988, которых нет в Турбо (18): OPRNAM, AOPNAM, RUN, LRUN, COMPIL,
;     MEM1, KL1, KL12, ENDTXT, TRON, TROFF, SAVE, CSAVE, LOAD, MERGE, MR,
;     AFILE, AWDT
; Блоки 1988, перенесённые в другие модули Турбо (1): FIND (JMP.MAC)
;------------------------------------------------------------------------------

.INCLUDE /GENUKD.MAC/
.SBTTL	COMPILER
.ENABLE	LC




.PSECT	BASIC



	.EVEN

;------------------------------------------------------------------------------
; [1988~38%] изменено, COMP.MAC:146-160: AOPSUB (1988: 13 строк кода, здесь 13;
;     добавлено/изменено 8, удалено 8). Отличия: таблица подпрограмм компиляции
;     по номерам TAB.TXT: убраны TROFF, TRON, KL2, FIND, SAVE, CSAVE, LOAD,
;     MERGE; добавлены REPEAT, UNTIL, WHILE, WEND, SGET, SPUT, PALETX, SOUND,
;     FSOUND, NOSOUN, PAGE, DELAY, FPUT, FGET, FSAVE, FLOAD, SMODEG, ..CREATE,
;     ..CLOSE, ..OPEN, ..READ, ..WRITE, ..PURGE, CLOAD.
;------------------------------------------------------------------------------
AOPSUB::.WORD	LET,REM,DIM,LINE,CIRCLE,DEF,FOR,GOSUB
	.WORD	GO,IF,INPUT,LET,OPEN,PRINT,CLOSE
	.WORD	NEXT,PAINT,PRINT,DRAW,REM,RET
	.WORD	READ,POKE,OUT,STOP,LPRINT,ON
	.WORD	RESTOR,END,DATA,LOCATE,CLEAR
	.WORD	KEY,BEEP,CLS,COLOR,PSET,PRESET
	.WORD	BLOAD,BSAVE,SCREEN,Width,TRAP

	.WORD	Repeat,Until,While,Wend
	.WORD	Sget,Sput,PaletX,Sound,Fsound,NoSoun,Page
	.WORD	Delay,FPut,FGet,FSave,FLoad,SModeG
	.Word	..Create,..Close,..Open,..Read,..Write,..Purge
	.Word	Cload
	

;------------------------------------------------------------------------------
; [1988~33%] изменено, COMP.MAC:165-167: AOPMON (1988: 3 строк кода, здесь 3;
;     добавлено/изменено 2, удалено 2). Отличия: в 1988 - команды монитора
;     (NEW, AUTO, LIST, DELETE, LLIST, RENUM, CONT, RUN, ADDRMN); здесь их нет,
;     остались метка AOPEND и .GLOBL.
;------------------------------------------------------------------------------
	AOPMON::
	AOPEND::

	.GLOBL	HALT,JMP,JSR,RTS,CLR,RESET,TYPE



;------------------------------------------------------------------------------
; [1988=] без изменений (COMP.MAC:347-357): LPRINT, PRINT, PRI (блоков: 3)
;------------------------------------------------------------------------------
LPRINT::MOV	#DEVLP,(R1)
	MOV	(R1)+,-(SP)
	BR	PRI

PRINT::	JSR	R2,TSTFLN
PRI:	CLR	-(SP)

;------------------------------------------------------------------------------
; [1988~91%] изменено, COMP.MAC:358-417: PR (1988: 60 строк кода, здесь 60;
;     добавлено/изменено 5, удалено 5). Отличия: .T заменено на TRAP; в 8$
;     убран TRAP 106 и добавлен RETURN.
;------------------------------------------------------------------------------
PR:	TRAP	122
	BR	10$
	MOV	#LIT,(R1)+
	CLR	@SP
	BR	PR
10$:	TRAP	112
		TRAP	102
		BR	59$
		BR	1$
	2$:	TRAP	100
		CLR	@SP
		MOV	TYPE,R4
		ASL	R4
		MOV	AOUTSP(R4),(R1)+
		BR	PR
	1$:	MOV	R3,R2
		TRAP	113
		.WORD	RWPRIN,4003
		BR	2$
		SUB	#4,R5

		BLT	77$
		CLR	@SP
		TRAP	127
		MOV	R5,R2
		TRAP	125
		TST	R2
		BNE	5$
		TRAP	126
		TRAP	125
	5$:	TRAP	130
		MOV	AFNPOZ(R2),(R1)+
		BR	PR
	59$:
		TRAP	101
		.WORD	PRSPEC
		BR	58$
		BR	57$
	58$:
		TRAP	101
		.WORD	PLMI
		BR	6$
	57$:	DEC	R3
		BR	2$
	6$:	CMPB	@R3,#';
		BEQ	7$
		CMPB	@R3,#',
		BNE	8$
		MOV	#ZONA,(R1)+
	7$:	INC	@SP
		INC	R3
		BR	PR
	77$:	MOV	R2,R3
		CMP	R5,#-2
		BEQ	2$
	8$:	TST	(SP)+
		BNE	88$
		MOV	#NEWLIN,(R1)+
	88$:	JSR	R2,TSTFIL
		RETURN
		

;------------------------------------------------------------------------------
; [1988~77%] изменено, COMP.MAC:419-422: REM (1988: 6 строк кода, здесь 9;
;     добавлено/изменено 2, удалено 0). Отличия: REM сам пропускает остаток
;     строки до LF (CMPB (R3)+,#12; BNE REM; DEC R3).
;------------------------------------------------------------------------------
	REM::	CMPB	(R3)+,#12
		BNE	REM
		DEC	R3
		RETURN
	
	;
	AFNPOZ:	.WORD	AT,TAB,SPC
	AOUTSP:	.WORD	SOUTSP,IOUTSP

;------------------------------------------------------------------------------
; [1988~92%] изменено, COMP.MAC:427-452: LOCATE (1988: 24 строк кода, здесь 25;
;     добавлено/изменено 2, удалено 1). Отличия: глобальная метка, .BJSR
;     заменено на CALL.
;------------------------------------------------------------------------------
	;
	LOCATE::CMPB	@R3,#',
		BEQ	1$
		TRAP	125
	11$:	TRAP	116
		BR	2$
		CALL	CINT
	21$:	MOV	#AT,(R1)+
		TRAP	116
		BR	3$
		CALL	CINT
		MOV	#LOC,(R1)+
		BR	CEND1
	;

	1$:	MOV	#LOCX,(R1)+
		BR	11$
	2$:	MOV	#LOCY,(R1)+
		CMPB	(R3),#',
		BNE	21$
		INC	R3
		CMPB	(R3),#',
		BEQ	21$
		TRAP	24.
	3$:	CMPB	(R3),#',
		BNE	CEND1
		TRAP	24.

;------------------------------------------------------------------------------
; [1988~96%] изменено, COMP.MAC:456-509: LET (1988: 51 строк кода, здесь 51;
;     добавлено/изменено 2, удалено 2). Отличия: .BJSR и .BJSRA заменены на
;     CALL (оформление).
;------------------------------------------------------------------------------
	;
	LET::	CLR	R2
		CLR	R4
		TRAP	107
		BR	10$
		CMP	(R2)+,(R2)+
		TST	TYPE
		BEQ	1$
	11$:	TST	(R2)+
	1$:	TSTB	R5
		BMI	15$
		MOV	R4,-(SP)
		BR	2$
	10$:	TST	R5
		BNE	11$
		CALL	LMID
	15$:	NEG	R2
	2$:	TRAP	112
		CMPB	(R3)+,#'=
		BNE	5$
	21$:	BIT	#20000,R5
		BEQ	22$
		TRAP	115
		TRAP	13.
		TST	R4
		BGT	33$
		BMI	3$
		TST	R2
		BEQ	33$
	3$:	MOV	#NEWSTR,(1)+
		BR	33$
	22$:	TRAP	100
		MOV	R2,R4
		BPL	20$
		NEG	R4
	20$:	CALL	@ATCONV-4(R4)
	33$:
		MOV	AMOV(R2),(R1)+
		TST	R2
		BLE	CEND1
		MOV	(SP)+,(R1)+
		BR	CEND1
	5$:	TRAP	2
	;
		.WORD				IXMOV		;-6

		.WORD			SXMOV			;-4
		.WORD		$XMOV				;-2
	AMOV:	.WORD	MIDMOV					; 0
		.WORD		$MOV				;+2
		.WORD			SMOV			;+4
		.WORD				IMOV		;+6

