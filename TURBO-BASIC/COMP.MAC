	RWON:	.ASCII	/GOSUB /
	RWIF:	.ASCII	/GOTO /
		.ASCII	/THEN /
		.ASCII	/ELSE /

	RWPRIN:	.ASCII	/EL /
		.ASCII	/ATN /
		.ASCII	/AT /
		.ASCII	/TAB /
		.ASCII	/SPC /
	RWFOR:	.ASCII	/TO /
		.ASCII	/STEP /
	RWOPEN:	.ASCII	/OUTPUT INPUT APPEND /
		.ASCII	/AS /
	OPFOR:	.ASCII	/FOR /

	RWDEF:	.ASCII	/USR /
		.ASCII	/FN /
		.ASCII	/STR /
		.ASCII	/SNG /
		.ASCII	/INT /

	;RWKEY:	.ASCII	/LIST /

	RWMOT:	.ASCII	/ON /

	RWTRAP:	.ASCII	/OFF /


	RWON1:	.ASCII	/TRAP /

	RWLINE:	.ASCII	/BF B /
		.EVEN

;------------------------------------------------------------------------------
; [1988~76%] изменено, COMP.MAC:605-656: IF (1988: 52 строк кода, здесь 50;
;     добавлено/изменено 12, удалено 14). Отличия: вложенный оператор после
;     THEN/ELSE компилирует INSCMP (PPIO.MAC) вместо вызова по таблицам
;     OPRNAM/AOPSUB; ветка с числом после THEN/ELSE идёт в GO; .T заменено на
;     TRAP, .BJSR на CALL.
;------------------------------------------------------------------------------
	;
	IF::	TRAP	100
		CALL	CINT
		TRAP	113		;THEN,GOTO?
		.WORD	RWIF,1002
		TRAP	2
		TRAP	102
		BR	6$
		BR	6$
		MOV	#IFT,(R1)+	;THEN <LINE NUMBER>
		MOV	R0,-(SP)
		CLR	R0
		CALL	TO
		CLR	-(SP)
		BR	5$
	6$:	MOV	#IFF,(R1)+	;THEN	<STATMENT>
		MOV	R0,-(SP)
		MOV	R1,-(SP)
		
		TST	(R1)+
		CALL	INSCMP			;??
	
	;??	TRAP	113
	;??	.WORD	OPRNAM
	;??	.BYTE	2,AOPMON-AOPSUB-2
	;??	CLR	R5
	;??	TST	(R1)+
	;??	CLR	R0
	;??	CALL	@AOPSUB(R5)
		CLR	R2
	5$:
		TRAP	113

		.WORD	RWIF+12,2	;ELSE?
		BR	62$
		TRAP	102
		BR	50$
		BR	50$
		Mov	#-1,r5
		
		
		BR	55$
	50$:
	;??	TRAP	113
	;??	.WORD	OPRNAM
	;??	.BYTE	2,AOPMON-AOPSUB-2
		CLR	R5
	55$:	TST	@SP
		BEQ	4$
		MOV	#JMP,(R1)+
		MOV	R1,R2
		TST	(R1)+
		MOV	R1,@(SP)+
		MOV	R2,-(SP)
	4$:
		Tst	r5			;??
		Beq	63$			;??
		Call	Go			;??
		Br	62$			;??
	63$:	CALL	INSCMP			;??
	;??	CALL	@AOPSUB(R5)
	62$:	MOV	(SP)+,R0
		BEQ	7$
		MOV	R1,@R0
	7$:	MOV	(SP)+,R0
		Return
	

;------------------------------------------------------------------------------
; [1988~89%] изменено, COMP.MAC:662-705: FOR (1988: 49 строк кода, здесь 47;
;     добавлено/изменено 5, удалено 7). Отличия: убрана проверка прямого режима
;     (TSTB LYGIS), оформление (CALL @ATCONV).
;------------------------------------------------------------------------------
	;
	;
	FOR::	CLR	R4
		TRAP	107
		TRAP	13.
		TSTB	R5
		BMI	SYNERR
		TRAP	112
		CMPB	(R3)+,#'=
		BNE	SYNERR
		MOV	R4,-(SP)
		MOV	TYPE,R2
		ASL	R2
		TRAP	100
		CALL	@ATCONV(R2)
		MOV	AMOV+4(R2),(R1)+
		MOV	@SP,(R1)+
		TRAP	113
		.WORD	RWFOR,2
		TRAP	2
		TRAP	100
	10$:	CALL	@ATCONV(R2)
		TRAP	113
		.WORD	RWFOR+3,2
		BR	F2$
		TRAP	100
		CALL	@ATCONV(R2)
	F1$:	MOV	AFOR(R2),(R1)+
		MOV	#ASTAR+2,(R1)+
		MOV	(SP)+,(R1)+
	;	TSTB	LYGIS
	;	BEQ	CEND

		MOV	R1,-4(R1)
	CEND0:	BR	CEND
	F2$:	TST	R2
		BNE	3$
		MOV	#SCONST,(1)+
		CLR	(R1)+
		MOV	#40200,(R1)+
		BR	F1$
	3$:	MOV	#ICONST,(R1)+
		MOV	#1,(R1)+
		BR	F1$
	SYNERR:	TRAP	2
	;
	AFOR:	.WORD	FORSNG,FORINT

