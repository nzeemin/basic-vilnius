;******************************************************************************
;*                     Модуль сообщений об ошибках                            *
;*                          Файл : ErMsg.Mac                                  *
;*                 Распространение свободное (FreeWare)                       *
;*                       09.05.95.  Герасимов Олег                            *
;******************************************************************************


	.Include /Ide.Mlb/		; Подключение макро библиотеки
	Define				; Определение констант
	.RelDef	F			; Oпределения макроса Rel



.PSECT	SYSTEM


;	Процедура вывода сообщения об ошибке в окне

GETMSG::
REL	MOV	#DBMSG+1,R0		; Указатель на строку в окне
	MOV	#30.,R1			; Очистка выходной строки
1$:	MOVB	#40,(R0)+
	SOB	R1,1$
	CALL	GETFMS			; Получение указателя на сообщение
	MOV	R0,R1			; Получение длины строки
4$:	TSTB	(R1)+
	BNE	4$
	SUB	R0,R1
	DEC	R1			; В r1 - длина строки
	MOV	R1,R2
	SUB	#32.,R1			; Центровка сообщения в окне
	NEG	R1
	ASR	R1
REL	ADD	#DBMSG+1,R1
5$:	MOVB	(R0)+,(R1)+		; Копирование строки в окно
	SOB	R2,5$	
	RETURN				; Возврат

;	Процедура вывода сообщения в виде строки статуса

GETMS1::
	PUSH	R5
	MOV	#TTBUF,R4		; Очистка буфера
	MOV	#80.,R2
1$:	MOVB	#40,(R4)+
	SOB	R2,1$
	CLRB	(R4)+
	MOV	#TTBUF+1,R4		; Указатель на начало буфера
	MOV	R5,R1
	CALL	$D.CNV			; Получение символьного представления числа
2$:	CMPB	#40,(R0)+
	BEQ	2$
	DEC	R0
3$:	MOVB	(R0)+,(R4)+
	CMPB	-1(R0),#40
	BNE	3$
	DEC	R4
	MOVB	#':,(R4)+		; Заполнеие строки.
	MOVB	#' ,(R4)+
	POP	R5
	CALL	GETFMS			; Указатель на нужное сообщения
4$:	MOVB	(R0)+,(R4)+		; Копирование сообщения в выходную строку
	BNE	4$
	MOVB	#40,-1(R4)
	RETURN				; Возврат
	
	
	

;	Процедура получения указателя на сообщение
;	Вход   r5 = код ошибки.
;	Выход  r0 = указатель на сообщение

GETFMS:
REL	MOV	#ERR.MS,R0		; Адрес списка сообщений
2$:	TSTB	(R0)+			; Конец сообщения ?
	BEQ	3$			; Да выход
	CMPB	R5,-1(R0)		; Коды сообщений совпадают ?
	BEQ	3$			; Да - выход
1$:	TSTB	(R0)+			; Иначе искать дальше 
	BNE	1$
	BR	2$
3$:	RETURN				; Возврат





.PSECT	TEXT
;	Список сообщений об ошибках

ERR.MS::.Asciz	<1.>/NEXT без FOR/
	.Asciz	<2.>/Синтаксическая ошибка/
	.Asciz	<3.>/RETURN без GOSUB/
	.Asciz	<4.>/Кончилась DATA/
	.Asciz	<5.>/Неправильный вызов функции/
	.Asciz	<6.>/Переполнение/
	.Asciz	<7.>/Переполнение памяти/
	.Asciz	<8.>/Неопределеная метка/
	.Asciz	<9.>/Недопустимый индекс/
	.Asciz	<10.>/Повторное определение/
	.Asciz	<11.>/Деление на нуль/
	.Asciz	<13.>/Ошибка типов/
	.Asciz	<14.>/Нет памяти для строк/
	.Asciz	<15.>/Слишком длиная строка/
	.Asciz	<16.>/Переполнение стека/
	.Asciz	<18.>/Не определена функция/
	.Asciz	<19.>"Ошибка ввода/вывода"
	.Asciz	<23.>/Повтроная метка строки/
	.Asciz	<24.>/Отсутствует операнд/
	.Asciz	<51.>/CPU: Прерывание 10/
	.Asciz	<52.>/Ошибочный номер файла/
	.Asciz	<53.>/Файл не найден/
	.Asciz	<54.>/Файл уже открыт/
	.Asciz	<55.>/Конец файла/
	.Asciz	<56.>/Ошибочное имя файла/
	.Asciz	<59.>/Файл не открыт/
	.Asciz	<63.>/Ошибка компилятора/
	.Asciz	<255.>/CPU: Прерывание 4/
	.Asciz	<254.>/*** СТОП ***/
	.Asciz	<0.>/?/
	

	.Even
.End				; Конец модуля

