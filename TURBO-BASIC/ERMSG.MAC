;******************************************************************************
;*                     Модуль сообщений об ошибках                            *
;*                          Файл : ErMsg.Mac                                  *
;*                 Распространение свободное (FreeWare)                       *
;*                       09.05.95.  Герасимов Олег                            *
;******************************************************************************


;------------------------------------------------------------------------------
; ERMSG - тексты сообщений об ошибках (раздел Text) и их вывод: GETMSG - строка
; в окне ошибки (DBMSG, центровка по 32 символам), GETMS1 - строка "код: текст"
; в TTBUF (80. символов). Вход обеих: R5 = код ошибки (сравнивается байт)
;------------------------------------------------------------------------------
	.Include /Ide.Mlb/	; Подключение макро библиотеки
	Define			; Определение констант
	.RelDef	F		; Oпределения макроса Rel



.PSECT	SYSTEM


; GETMSG - R5 = код: сообщение по центру строки окна DBMSG+1 (длина больше 32
; не проверяется)
;	Процедура вывода сообщения об ошибке в окне

GETMSG::
REL	MOV	#DBMSG+1,R0	; Указатель на строку в окне
	MOV	#30.,R1		; Очистка выходной строки
1$:	MOVB	#40,(R0)+	; Заполнить пробелами
	SOB	R1,1$
	CALL	GETFMS		; Получение указателя на сообщение
	MOV	R0,R1		; Получение длины строки
4$:	TSTB	(R1)+
	BNE	4$
	SUB	R0,R1
	DEC	R1		; В r1 - длина строки
	MOV	R1,R2		; R2 = длина
	SUB	#32.,R1		; Центровка сообщения в окне
	NEG	R1		; R1 = 32 - длина
	ASR	R1		; R1 = отступ слева (центровка)
REL	ADD	#DBMSG+1,R1	; R1 -> позиция в строке окна
5$:	MOVB	(R0)+,(R1)+	; Копирование строки в окно
	SOB	R2,5$
	RETURN			; Возврат

; GETMS1 - R5 = код: в TTBUF строка "код: сообщение"; на выходе R4 -> за ней
;	Процедура вывода сообщения в виде строки статуса

GETMS1::
	PUSH	R5		; Сохранить код ошибки
	MOV	#TTBUF,R4	; Очистка буфера
	MOV	#80.,R2		; 80. символов
1$:	MOVB	#40,(R4)+	; Заполнить пробелами
	SOB	R2,1$
	CLRB	(R4)+		; Нуль в конце
	MOV	#TTBUF+1,R4	; Указатель на начало буфера
	MOV	R5,R1		; R1 = код ошибки
	CALL	$D.CNV		; Получение символьного представления числа
2$:	CMPB	#40,(R0)+	; Пропустить ведущие пробелы
	BEQ	2$
	DEC	R0		; Вернуться на первую цифру
3$:	MOVB	(R0)+,(R4)+	; Копировать цифры
	CMPB	-1(R0),#40	; до пробела
	BNE	3$
	DEC	R4		; Убрать скопированный пробел
	MOVB	#':,(R4)+		; Заполнеие строки.
	MOVB	#' ,(R4)+
	POP	R5		; Вернуть код ошибки
	CALL	GETFMS		; Указатель на нужное сообщения
4$:	MOVB	(R0)+,(R4)+	; Копирование сообщения в выходную строку
	BNE	4$
	MOVB	#40,-1(R4)	; Нуль заменить пробелом (R4 -> за текстом)
	RETURN			; Возврат




; GETFMS - поиск сообщения в списке ERR.MS: нет кода в списке - берётся "?"
;	Процедура получения указателя на сообщение
;	Вход   r5 = код ошибки.
;	Выход  r0 = указатель на сообщение

GETFMS:
REL	MOV	#ERR.MS,R0	; Адрес списка сообщений
2$:	TSTB	(R0)+		; Конец сообщения ?
	BEQ	3$		; Да выход
	CMPB	R5,-1(R0)	; Коды сообщений совпадают ?
	BEQ	3$		; Да - выход
1$:	TSTB	(R0)+		; Иначе искать дальше
	BNE	1$
	BR	2$
3$:	RETURN			; Возврат





.PSECT	TEXT
; Формат записи: байт кода (.Asciz <код.>/текст/), текст с нулём на конце.
; Коды 1-24 - как в Бейсике (NEXT без FOR, синтаксис, RETURN без GOSUB, ...),
; 51-59 - файлы, 63 - компилятор, 254/255 - СТОП и прерывание 4 ЦП. Кодов 12,
; 17, 20-22 и 25-50 в списке нет
;	Список сообщений об ошибках

ERR.MS::.Asciz	<1.>/NEXT без FOR/
	.Asciz	<2.>/Синтаксическая ошибка/
	.Asciz	<3.>/RETURN без GOSUB/
	.Asciz	<4.>/Кончилась DATA/
	.Asciz	<5.>/Неправильный вызов функции/
	.Asciz	<6.>/Переполнение/
	.Asciz	<7.>/Переполнение памяти/
	.Asciz	<8.>/Неопределеная метка/	; Опечатка: "Неопределеная"
	.Asciz	<9.>/Недопустимый индекс/
	.Asciz	<10.>/Повторное определение/
	.Asciz	<11.>/Деление на нуль/
	.Asciz	<13.>/Ошибка типов/
	.Asciz	<14.>/Нет памяти для строк/
	.Asciz	<15.>/Слишком длиная строка/	; Опечатка: "длиная"
	.Asciz	<16.>/Переполнение стека/
	.Asciz	<18.>/Не определена функция/
	.Asciz	<19.>"Ошибка ввода/вывода"
	.Asciz	<23.>/Повтроная метка строки/	; Опечатка: "Повтроная"
	.Asciz	<24.>/Отсутствует операнд/
	.Asciz	<51.>/CPU: Прерывание 10/	; Вектор 10 ЦП (нет команды)
	.Asciz	<52.>/Ошибочный номер файла/
	.Asciz	<53.>/Файл не найден/
	.Asciz	<54.>/Файл уже открыт/
	.Asciz	<55.>/Конец файла/
	.Asciz	<56.>/Ошибочное имя файла/
	.Asciz	<59.>/Файл не открыт/
	.Asciz	<63.>/Ошибка компилятора/	; Ошибка при компиляции
	.Asciz	<255.>/CPU: Прерывание 4/	; Вектор 4 ЦП (ошибка шины)
	.Asciz	<254.>/*** СТОП ***/	; Остановка программы по СТОП (254)
	.Asciz	<0.>/?/		; Код 0 - конец; "?" - неизвестный код


	.Even
.End				; Конец модуля

