;------------------------------------------------------------------------------
; IDDAT2 - описания окон IDE (структуры для $WIND/$INBAR/$EXEB/$$TSPR из
; WINDOW.MAC), таблицы клавиш диалогов и тексты окон (секция Text). Меню и общие
; сообщения - IDDAT.MAC. Окно: слово - адрес заголовка (xxxN); .WIND тип, X, Y,
; ширина, высота, цвета (DIALOG - с вводом, PRINT - без ввода; IDE.MLB); слово -
; адрес тела (xxxT); элементы:
;   .BUTON надпись, обработчик, X, Y, ширина (бит 0 обработчика: 1 - вызов
;          подпрограммой, окно остаётся; 0 - закрыть окно и перейти);
;   .EDIT буфер, прежнее значение, X, Y, ширина, флаги (бит 1 - взять прежнее
;          значение, бит 2 - строка с нулём на конце);
;   .USER рисование, ввод; код 1 - группа "( )", 2 - группа "[X]": слово-код,
;          слово - адрес переменной, байты: смещение подписи (бит 7 - без
;          подсветки), ещё байт (не выяснено), пары X, Y значков, 0, ещё 0,
;          затем код следующего элемента; .ENDS обработчик - конец и Enter
; Числа в разделе Data - десятичные (.RADIX 10.), в Text - восьмеричные
;------------------------------------------------------------------------------
	.INCLUDE/IDE.MLB/
	Define
	.RelDef	D

;__________________ Масивы параметров для диалоговых окошек ___________________

.PSECT	DATA
	.RADIX	10.
; У ABOUT и DBGD после кода 0 нет слова обработчика Enter (как у .ENDS):
; читается следующее слово данных; безвредно, пока JMPADR не нужен (кнопки
; работают по своим обработчикам)
ABOUT::
REL	.WORD	ABOUTW		; Заголовок
				; Диалог: X, Y, ширина, высота, цвета
	.WIND	DIALOG,22,5,31,9,BLACK,CYAN
REL	.WORD	ABOUTT		; Тело окна
				; Кнопка: надпись, обработчик, X, Y, ширина
	.BUTON	OKB,$NOPR,13,8,6
	.WORD	0		; Конец списка (слова для Enter нет)

;______________________________________________________________________________
; Палитра: 4 группы по 8 значков (значения 0-7: Черный...Белый), PLG1-PLG4
PALETE::
REL	.WORD	PALETN		; Заголовок
				; Диалог: X, Y, ширина, высота, цвета
	.WIND	DIALOG,20,4,40,12,BLACK,CYAN
REL	.WORD	PALETT		; Тело окна

	.WORD	1		; Группа значков "( )" (код 1)
REL	.WORD	PLG1		; Переменная - палитра PLG1
				; Подпись 9 (бит 7), 7; X=12, Y=2..9
	.BYTE	128!9,7,12,2,12,3,12,4,12,5,12,6,12,7,12,8,12,9
	.WORD	0,1		; Конец списка; код следующей группы
REL	.WORD	PLG2		; Переменная - PLG2
	.BYTE	128!17,7,20,2,20,3,20,4,20,5,20,6,20,7,20,8,20,9
	.WORD	0,1
REL	.WORD	PLG3		; Переменная - PLG3
	.BYTE	128!25,7,28,2,28,3,28,4,28,5,28,6,28,7,28,8,28,9
	.WORD	0,1
REL	.WORD	PLG4		; Переменная - PLG4
				; Подсветка строки (бит 7 снят), X=36
	.BYTE	33,7,36,2,36,3,36,4,36,5,36,6,36,7,36,8,36,9
	.WORD	0		; Конец списка
	.BUTON	PLK1,$SPCL,3,11,7	; "Цвет": палитра $SPCL
	.BUTON	PLK2,$SPMN,13,11,6	; "Моно": палитра $SPMN
	.BUTON	OKB,$SETPL,21,11,6	; Применить ($SETPL)
	.BUTON	CANCB,$NOPR,29,11,8	; Отмена
	.ENDS	$SETPL		; Enter - $SETPL

;______________________________________________________________________________
OPEND::
REL	.WORD	OPENN		; Заголовок
				; Диалог: X, Y, ширина, высота, цвета
	.WIND	DIALOG,16,3,44,15,BLACK,CYAN
REL	.WORD	OPENT		; Тело окна


OP.PTR==.+4			; Метка не используется в других модулях
				; Поле: LBUF, EFNAM, X, Y, ширина, 3
	.EDIT	LBUF,EFNAM,4,3,26,3,,REL
	.USER	$DRPRT,$DREXE	; Список файлов: рисование и ввод (IDE.MAC)
	.BUTON	FLK1,$OPF!1,33,3,9	; Открыть: $OPF как подпрограмма
	.BUTON	FLK2,$NOPR,33,6,9	; Заменить: только закрывает окно
	.BUTON	CANCB,$NOPR,33,9,9	; Отмена
	.BUTON	HLPB,GetHlp,33,12,9	; Помощь
	.ENDS	$OPF!1		; Enter - как "Открыть"
;______________________________________________________________________________
TsChD::
Rel	.Word	Warnn		; Заголовок "Предупреждение"
				; Диалог: X, Y, ширина, высота, цвета
	.Wind	Dialog,25,7.,32.,7,Black,Cyan
Rel	.Word	TsCht		; Тело окна

	.Buton	Flk3,SfQ,2,6,8	; "Да": SfQ - сохранить и выйти
	.Buton	Flk4,Qui,12,6,8	; "Нет": Qui - выйти
	.Buton	CancB,$NopR,22,6,8	; Отмена
	.Ends	SfQ		; Enter - SfQ




;______________________________________________________________________________
HELPW::
REL	.WORD	HlpN		; Заголовок
	.Wind	Print,16,3,44,15,Black,Cyan	; Окно без ввода (PRINT)
Rel	.WORD	HlpT		; Тело окна
	.Word	0		; Конец



;______________________________________________________________________________
SAVED::
REL	.WORD	SaveN		; Заголовок
				; Диалог: X, Y, ширина, высота, цвета
	.WIND	DIALOG,16,3,44,15,BLACK,CYAN
REL	.WORD	OpenT		; Тело окна - то же, что у "Открыть"


SV.PTR==.+4			; Метка не используется в других модулях
				; Поле: LBUF, EFNAM, X, Y, ширина, 3
	.EDIT	LBUF,EFNAM,4,3,26,3,,REL
	.USER	$DRPRT,$DREXE	; Список файлов: рисование и ввод
				; Надпись "Да" (FLK3), $SVF как подпрограмма
	.BUTON	FLK3,$SVF!1,33,3,9
	.BUTON	CANCB,$NOPR,33,9,9	; Отмена
	.BUTON	HLPB,GetHlp,33,12,9	; Помощь
	.ENDS	$SVF!1		; Enter - как кнопка




COMPD::
REL	.WORD	COMPN		; Заголовок
	.WIND	PRINT,20,5,39,12,BLACK,CYAN	; Окно без ввода (PRINT)
REL	.WORD	COMPT		; Тело окна
	.WORD	0		; Конец


;______________________________________________________________________________
DBGD::
REL	.WORD	DBGN		; Заголовок
				; Диалог: X, Y, ширина, высота, цвета
	.WIND	DIALOG,23,7,32,7,BLACK,CYAN
REL	.WORD	DBGT		; Тело окна
	.BUTON	OKB,ErHl,6,6,8	; Ok: ErHl - показать ошибку
	.BUTON	HLPB,GetHlp,18,6,8	; Помощь
	.WORD	0		; Конец списка
;______________________________________________________________________________


EDITD::
REL	.WORD	EDITN		; Заголовок
				; Диалог: X, Y, ширина, высота, цвета
	.WIND	DIALOG,22,5,37,12,BLACK,CYAN
REL	.WORD	EDITTT		; Тело окна
	.WORD	2		; Группа флажков "[X]" (код 2)
REL	.WORD	ESW		; Переменная - ESW
				; Подпись 24, 24; X=30, Y=1..9
	.BYTE	24,24,30,1,30,2,30,3,30,4,30,5,30,6,30,7,30,8,30,9
	.WORD	0		; Конец списка
	.BUTON	OKB,$RET,7,11,8	; Ok
	.BUTON	CANCB,$NOPR,22,11,8	; Отмена
	.ENDS	$RET		; Enter - как Ok
;______________________________________________________________________________
.If	Eq	Version-Beta
COMPO::				; Версия Beta
REL	.WORD	CMPN
	.WIND	DIALOG,16,4,49,13,BLACK,CYAN
REL	.WORD	CMPT


	.WORD	2
REL	.WORD	CSW1
	.BYTE	18,18,21,2,21,3,45,2,45,3
	.WORD	0,2
REL	.WORD	CSW2
	.BYTE	18,18,21,6,21,7,45,6,45,7
	.WORD	0,2
REL	.WORD	CSW3
	.BYTE	18,18,21,9,21,10,45,9,45,10
	.WORD	0
	.BUTON	OKB,$RET,6,12,8
	.BUTON	CANCB,$NOPR,20,12,8
	.BUTON	HLPB,GetHlp,34,12,8
	.ENDS	$RET
.EndC
;______________________________________________________________________________

FINDD::

REL	.WORD	FINDN		; Заголовок
				; Диалог: X, Y, ширина, высота, цвета
	.WIND	DIALOG,18,4,44,14,BLACK,CYAN
REL	.WORD	FINDT		; Тело окна
FB.PTR==.+4			; Слово адреса прежнего значения поля ввода
				; Поле: LBUF, FDBUF, X, Y, ширина, 3
	.EDIT	LBUF,FDBUF,3,2,40,3,,REL
	.WORD	1		; Группа значков "( )"
REL	.WORD	FSW1		; Направление: вперёд (0), назад (1)
	.BYTE	12,9,16,5,16,6
	.WORD	0,1
REL	.WORD	FSW2		; Пространство (в коде не используется)
	.BYTE	16,16,39,5,39,6
	.WORD	0,1
REL	.WORD	FSW3		; Начать: сверху (0), снизу (1), от курсора (2)
	.BYTE	12,10,16,9,16,10,16,11
	.WORD	0,2
REL	.WORD	FSW4		; Флажки: РУС/ЛАТ (1), ВР/НР (2), Слово (4)
	.BYTE	16,14,39,9,39,10,39,11
	.WORD	0
	.BUTON	FNDB,$FNDEX,4,13,8	; Поиск: $FNDEX
	.BUTON	CANCB,$NOPR,18,13,8	; Отмена
	.BUTON	HLPB,GetHlp,32,13,8	; Помощь
	.ENDS	$FNDEX		; Enter - $FNDEX
;______________________________________________________________________________
NOTI::
REL	.WORD	NOTN		; Заголовок
				; Диалог: X, Y, ширина, высота, цвета
	.WIND	DIALOG,24,8,30,6,BLACK,CYAN
REL	.WORD	NOTT		; Тело окна

	.BUTON	OKB,$NOPR,12,5,6	; Ok

	.ENDS	$NOPR		; Enter - закрыть
;______________________________________________________________________________
GOLNM::
REL	.WORD	GOLNN		; Заголовок
				; Диалог: X, Y, ширина, высота, цвета
	.WIND	DIALOG,24,8,30,6,BLACK,CYAN
REL	.WORD	GOLNT		; Тело окна

				; Поле: LBUF, нет прежнего, ширина 20
	.EDIT	LBUF,0,6,3,20,0

	.BUTON	OKB,$GOLIN,6,5,8	; Ok: $GOLIN
	.BUTON	CANCB,$NOPR,17,5,8	; Отмена
	.ENDS	$GOLIN		; Enter - $GOLIN
;______________________________________________________________________________
PREFM::
REL	.WORD	PREFN		; Заголовок
				; Диалог: X, Y, ширина, высота, цвета
	.WIND	DIALOG,18,4,41,11,BLACK,CYAN
REL	.WORD	PREFT		; Тело окна

	.WORD	1		; Группа значков "( )"
REL	.WORD	PSW1		; Рабочий экран: 4 цвета (0), 8 цветов (1)
	.BYTE	15,9,17,3,17,4
	.WORD	0,2
				; Автозапись: программа (1), настр. (2)
REL	.WORD	PSW2
	.BYTE	14,12,17,7,17,8
	.WORD	0,1
REL	.WORD	PSW3		; Отладка: включена (0), выключена (1)
	.BYTE	13,9,37,3,37,4
	.WORD	0,1
REL	.WORD	PSW4		; Объектный код: память (0), файл (1)
	.BYTE	13,9,37,7,37,8
	.WORD	0
	.BUTON	OKB,$RET,5,10,8
	.BUTON	CANCB,$NOPR,17,10,8
	.BUTON	HLPB,GetHlp,29,10,8

	.ENDS	$RET
;______________________________________________________________________________

EVLMDD::
REL	.WORD	EVLMDN		; Заголовок
				; Диалог: X, Y, ширина, высота, цвета
	.WIND	DIALOG,13,5,52,9,BLACK,CYAN
REL	.WORD	EVLMDT		; Тело окна

	.EDIT	LBUF,0,2,2,38,0	; Выражение (LBUF)
	.EDIT	LBUF+50,0,2,5,38,0	; Результат (LBUF+50)
	.EDIT	LBUF+100,0,2,8,38,0	; Переменные (LBUF+100)

	.BUTON	EVLB,$EVLT!1,41,2,10	; Считать: $EVLT как подпрограмма
	.BUTON	MODB,$EVLT!1,41,5,10	; Изменить: тот же $EVLT
	.BUTON	CANCB,$RET,41,8,10	; Отмена
	.ENDS	$EVLT!1		; Enter - $EVLT






;------------------------------------------------------------------------------
; BRJMP - таблица KEYJMP кнопок: Esc, Enter, Tab, стрелки; TRJMP - списка
; значков (с пробелом); MEJMP - строки ввода (Del, РУС, ЛАТ). Обработчики -
; WINDOW.MAC: $NOPR - закрыть, $BRE - выполнить, $BRT - следующий элемент,
; $ENTER - Enter, $TRU/$TRD - вверх/вниз по значкам, $WE* - редактирование поля
;------------------------------------------------------------------------------
BRJMP::
	.BYTE	7,ESCAPE,ENTER,TAB,UP,DOWN,LEFT,RIGHT	; Число кодов; клавиши
				; Обработчики; последний - прочие
REL	.WORD	<$NOPR,$BRE,$BRT,$BRT,$BRT,$BRT,$BRT,$BRBG>


TRJMP::
				; Число кодов; клавиши, 0 - выравнивание
	.BYTE	8,ENTER,ESCAPE,TAB,UP,LEFT,DOWN,RIGHT,32,0
				; Обработчики; последний - прочие
REL	.WORD	<$ENTER,$NOPR,$TRN,$TRU,$TRU,$TRD,$TRD,$TRSP,$TRBG>

MEJMP::
				; Число кодов; клавиши, 0 - выравнивание
	.BYTE	10,ENTER,ESCAPE,TAB,UP,DOWN,LEFT,RIGHT,DEL,RUS,LAT,0
				; Обработчики; последний - прочие
REL	.WORD	<$ENTER,$NOPR,$WET,$WET,$WET,$WEL,$WER,$WED,$WERS,$WELT,$WES>

.PSECT	TEXT

.RADIX	8.

;------------------------------------------------------------------------------
; Тексты. Заголовок: байт - столбец названия, ASCIZ. Тело - по строкам окна:
; 0 - пустая строка; 1-77 - столбец и ASCIZ (код < 40 внутри - пробелы);
; 100 + n - n пустых строк (последний байт добивает окно до конца)
;------------------------------------------------------------------------------
;_______________________________________________________________________________
AboutW:	.Asciz	<4>/О программе/
.If	Ne	Version-Demo	; Полная версия
AboutT:
	.Byte	0
	.Asciz	<11.>/Turbo Basic/
	.Asciz	<11.>/Версия  1.1/
	.Asciz	<4>/Copyright (c) 1994, 95 by/
	.Asciz	<6>"Геpасимов Олег, ЛИнТех"
	.Asciz	<2>/Телефон/Факс (095) 361-95-92/
	.Byte	102		; Две пустые строки (100 + 2)
.Iff				; Демо-версия (запись запрещена)

AboutT:
	.Byte	0
	.Asciz	<5>/Turbo Basic, demo version/
	.Asciz	<5>/Операция записи запрещена/
	.Asciz	<4>/Для получения информации о/
	.Asciz	<4>/полной  версии  звоните  :/
	.Asciz	<10.>/(095) 939-34-94/
	.Asciz	<5>/Электронные Работы, ltd./
	.Byte	120		; 16. пустых строк (до конца окна)
.EndC

;______________________________________________________________________________


PaletN:	.Asciz	<14.>/Палитра/

PaletT:	.Asciz	<3>/Цвет /<5>/0/<7>/1/<7>/2/<7>/3/
	.Asciz	<3>/Черный/
	.Asciz	<3>/Синий/
	.Asciz	<3>/Красный/
	.Asciz	<3>/Розовый/
	.Asciz	<3>/Зеленый/
	.Asciz	<3>/Голубой/
	.Asciz	<3>/Желтый/
	.Asciz	<3>/Белый/
	.Byte	103		; Три пустые строки




;______________________________________________________________________________
OpenN:	.Asciz	<14.>/Открыть файл/

OpenT:	.Byte	0
	.Asciz	<3>/Имя/
	.Byte	0
	.Asciz	<3>/Файлы/
	.Byte	114		; 12. пустых строк

;______________________________________________________________________________
SaveN:	.Asciz	<13.>/Сохранить файл/
;______________________________________________________________________________



CompN:	.Asciz	<13.>/Компилятор/

; Окно компиляции: числа и имя файла выводит F511 (UPEXEC.MAC) по $Wloc
CompT:	.Byte	0
	.Asciz	<2>/Компиляция/
	.Asciz	<2>/Линковка/
	.Byte	0
	.Asciz	<23.>/Всего/<3>/Файл/
	.Byte	0
	.Asciz	<2>/Обработано строк:/<8.>/0/<6.>/0/
	.Asciz	<2>/Возникло/<2>/ошибок:/<8.>/0/<6.>/0/
	.Byte	0
	.Asciz	<2>/Доступная память:/<9.>/,байтов/
	.Byte	0
	.Asciz	<9.>/Ctrl-Break для останова/
;______________________________________________________________________________

DbgN:	.Asciz	<10.>/Отладка/

DbgT:	.Byte	0
	.Asciz	<3.>/Ошибка/<2>/выполнения программы/
	.Byte	0
				; Строка сообщения (32 знака)
DbMsg::	.Asciz	<1>/Place for error mesages size 3  /
	.Byte	103		; Три пустые строки

;______________________________________________________________________________
EditN:	.Asciz	<13.>/Редактор/
; Подписи флажков ESW: маски 1, 2, 4, 10, 20, 40, 100, 200, 400 по порядку
EditTT:
	.Asciz	<6.>/Резервная копия/
	.Asciz	<6.>/Режим вставки/
	.Asciz	<6.>/Автоотступ/
	.Asciz	<6.>/Удаление автоотступа/
	.Asciz	<6.>/Перманентные блоки/
	.Asciz	<6.>/Большой курсор/
	.Asciz	<6.>/Поиск под курсором/
	.Asciz	<6.>/Длинные строки/
	.Asciz	<6.>/Замена пробелов/
	.Byte	103		; Три пустые строки
;______________________________________________________________________________
; Тексты окна опций компилятора (версия Beta)
.If	Eq	Version-Beta
CMPN:	.Asciz	<19.>/Compiler/

CMPT:	.Asciz	<19.>/Code generation/
	.Asciz	<3.>/Debug information/<7.>/Assembler allowed/
	.Asciz	<3.>/Overlay allowed/<9.>/Make .OBJ file/
	.Byte	0
	.Asciz	<19.>/Runtime/<2>/errors/
	.Asciz	<3.>"Overflow checking"<7>"I/O checking"
	.Asciz	<3.>/Range checking/<10.>/Stack checking/
	.Asciz	<16.>/Bus adress protection/
	.Asciz	<3.>/System variables/<8.>/Compiler area/
	.Asciz	<3.>/Output registers/<8.>/Input registers/
	.Byte	103
.Endc


;______________________________________________________________________________
FINDN:	.ASCIZ	<18.>/Поиск/
FINDT:	.ASCIZ	<2>/Текст/
	.BYTE	102
	.ASCIZ	<4>/Направление/<10>/Пространство/
	.ASCIZ	<4>/Вперед/<15>/Выделенный текст/
	.ASCIZ	<4>/Назад/<16>/Везде/
	.BYTE	0
	.ASCIZ	<4>/Начать/<14>/Регистр/
	.ASCIZ	<4>"Сверху"<15>"РУС/ЛАТ"
	.ASCIZ	<4>"Снизу"<16>"ВР/НР"
	.ASCIZ	<4>/От курсора/<11>/Слово/
	.BYTE	103		; Три пустые строки
;______________________________________________________________________________
NOTN:	.ASCIZ	<10.>/Поиск/
NOTT:	.BYTE	102
	.ASCIZ	<3>/Невозможно найти этот текст/
	.BYTE	120

;______________________________________________________________________________
GOLNN:	.ASCIZ	<5.>/Переход к строке/
GOLNT:	.BYTE	0
	.ASCIZ	<10.>/Номер строки/
	.BYTE	120
;______________________________________________________________________________
PREFN:	.ASCIZ	<14.>/Система/
PREFT:	.BYTE	0
	.ASCIZ	<3>/Рабочий экран/<8.>/Oтладкa/
	.ASCIZ	<3>/4 Цвета/<14.>/Включена/
	.ASCIZ	<3>/8 Цветов/<13.>/Выключена/
	.BYTE	0
	.ASCIZ	<3>/АвтоЗапись/<11.>/Объектный код/
	.ASCIZ	<3>/Программы/<12.>/Память/
	.ASCIZ	<3>/Настройки/<12.>/Файл/
	.BYTE	120		; 16. пустых строк

EVLMDN:	.ASCIZ	<18.>"Калькулятор"

EVLMDT:
	.ASCIZ	<3>/Выражение/
	.BYTE	102
	.ASCIZ	<3>/Результат/
	.BYTE	102
	.ASCIZ	<3>/Переменные/
