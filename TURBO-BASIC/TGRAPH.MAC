; THE TURBO GRAPHICS HANDLER. 4..20 
; THIS UNIT CAN USE WITH RT11 PROGRAMMS
; HOW CAN YOU USE THIS UNIT, YOU CAN READ IN 'TGRAPH.LST'  
; BY GERASIMOW OLEG IN 17.11.94


;DRVREG == 374
;-10(DRVREG) - АДРЕС НАЧАЛА ВИДЕОПАМЯТИ. (R)
; -6(DRVREG) - ШИРИНА В БАЙТАХ ЭКРАНА (80/40) (R)
; -4(DRVREG) - ПОСЛЕДНИЙ КОД ПОЛУЧЕННЫЙ ОТ КЛАВИАТУРЫ. (R)
; -2(DRVREG) - МАСКА НАЖАТЫХ УПРАВЛЯЮЩИХ КЛАВИШ. (R)
;  0(DRVREG) - 7 БИТ : 1 - ПРОЦЕСС ВЫПОЛНЕН. 0 - ПРОЦЕСС ВЫПОЛНЯЕТСЯ. (R/W)
;  2(DRVREG) - КОД ПРОЦЕДУРЫ (W)
;  3(DRVREG) - ПАРОЛЬ : 10. ОБНУЛЯЕТСЯ ПРИ ПРОЧТЕНИЕ КОМАНДЫ. (R/W)
;  4(DRVREG) - 
;  ........  - РАБОЧИЕ ЯЧЕЙКИ ДЛЯ ПРОЦЕДУР. (R/W)
; 12(DRVREG) - 



;------------------------------------------------------------------------------
; TGRAPH - драйвер "Турбо-графики" ПП: примитивы, звук, клавиатура, палитры
; (линкуется в Ide.Sav последним). Установка: TGINST (в ЦП) шлёт ПП по каналу
; 176674/176676 блоки MP.PUT (10000, 32, адрес в ПП, адрес в ЦП, длина в словах:
; записать Inst в ОЗУ ПП с 1000) и MP.EXE (14000, 32, адрес: запуск). Inst при
; отключённом ПЗУ (177054) копирует TGPut..TGEnd из памяти ЦП (окно 177010/
; 177014) в ОЗУ ПП с 170400. Кто потом вызывает TGPut (вход +0 - установка, +2 -
; RstVct), не выяснено до конца. TGPut ставит вектора ПП: 100 (таймер, мелодия),
; 300 (клавиатура), 7126 (адрес запуска фиктивного процесса диспетчера ПЗУ -
; INT330), 13172 (CLS), вектор 14 (BPT) - F.RUN.
; Обмен с ЦП - переменные ЦП у DRVREG (DT.MAC): -10 RADR (начало видеопамяти),
; -6 RWIDTH, -4 HOTKB (последняя клавиша), -2 KBBIT (маска), 0 DRVREG (бит
; 7: 1 - выполнено, 0 - выполняется), +2 CODP (код процедуры), +3 PASSW (пароль
; 20 восьм.: INT330 выполняет команду, если он равен 20, и обнуляет его), +4...
; +12 WORK0..WORK3 (аргументы R1..R4 и результат). Со стороны ЦП - PPEXE в
; GRAFUK.MAC. Процедуры по DTAB (CODP): 0 звук (пауза), 1 сдвиг экрана, 2 режим
; вывода (замена/XOR), 3-5 палитра, 6 точка, 7 цвет вектора, 8 цвета текста, 9
; указатель, 10 линия, 11 закрашенный прямоугольник, 12 цвет точки, 13 читать
; указатель, 14 заливка, 15 нота в очередь, 16 остановить мелодию, 17 режим
; экрана 80/40, 18 страницы, 19 цвет курсора, 20 снять драйвер, 21/22 образ
; символа, 23 положение курсора, 24 читать плоскость 0, 25 вывести образ.
; Регистры ПП (по коду, не все выяснены): 177010 - адрес окна в память ЦП и
; видеопамять, 177012 (байт), 177014 (слово) - данные, 177016 - цвет записи,
; 177024 - запись байта с цветом 177016, 177026 - запрет плоскостей (бит 0 -
; плоскость 0, режим 4 цветов; ПЗУ пишет 0), 177716 (бит 7 - динамик, биты
; 8-11 - звуковой сигнал ПЗУ), 177054 - ПЗУ/ОЗУ, 177710-177714 - таймер звука.
; Ячейки ПП (листинги ПЗУ): 22656 - таблица видеопараметров (ТВ) экрана
; пользователя, 23150 - указатель текущей ТВ, 23412-23657 - рабочая область
; графического терминала ПЗУ, 13172 - слово таблицы обработчиков управляющих
; кодов (код Ctrl-L, CLS); процедуры ПЗУ: 110210 - ТВ из R5 текущая, 113262 -
; очистка экрана, 151714 - обработка Esc UB.
;------------------------------------------------------------------------------
	.PSECT	TGRAPH		; Секция драйвера

TGINST::Mov	#176674,R1	; R1 -> статус канала ПП
	Mov	#MP.PUT,R0;
	Call	Put		; Послать: записать Inst в память ПП
	Mov	#MP.EXE,R0	; R0 -> блок команды запуска
	Jmp	Put		; Послать: запустить Inst в ПП
	
	

; PUT - послать блок R0 каналу ПП (4 байта: адрес блока, дважды), ждать конца
PUT:	MOV	#4,R2		; Байт в сообщении: 4
	INC	R0		; Адрес блока + 1
	CLRB	(R1)		; Начало передачи
1$:	TSTB	(R1)		; Канал готов?
	BPL	1$		; нет => ждать
	MOVB	R0,2(R1)	; Послать байт
	SWAB	R0		; Следующий байт
	SOB	R2,1$		; Повторить
2$:	TSTB	(R1)		; Ждать конца команды
	BPL	2$		; нет => ждать
	DEC	R0		; Вернуть адрес блока
	RETURN			; Выход

MP.PUT:	.WORD	10000,32,1000,Inst,<EndInst-Inst>/2
MP.EXE:	.WORD	14000,32,1000


;------------------------------------------------------------------------------
; Inst - выполняется в ПП (с адреса 1000): копирует драйвер в ОЗУ ПП с 170400
;------------------------------------------------------------------------------
Inst:
	Bis	#1,@#177026	; Плоскость 0 запрещена (4 цвета)
	Mov	#177010,R5	; R5 -> регистр адреса окна в память ЦП
	Mov	#<TGPut/2>,(R5)	; Адрес TGPut в памяти ЦП (в словах)
	Mov	#<TGEnd-TGPut>/2,R0	; Длина кода в словах
	Mov	#170400,R1	; Куда: ОЗУ ПП с 170400
	Mtps	#340		; Прерывания запрещены
	Bis	#360,@#177054	; ПЗУ ПП отключено (на его месте ОЗУ)
1$:	Mov	4(r5),(r1)+	; Слово из памяти ЦП
	Inc	(r5)		; Следующий адрес
	Sob	r0,1$		; Повторить
	Bic	#360,@#177054	; ПЗУ включено
	Mtps	#0		; Прерывания разрешены
	Return			; Выход
EndInst:
	



;------------------------------------------------------------------------------
; TGPUT - установка драйвера в ПП: вектора, очередь нот (+0); вход +2 - RstVct
;------------------------------------------------------------------------------
TGPUT::
	Br	1$		; Установка
	Jmp	RstVct		; Вход TGPut+2: снять драйвер
1$:	MOV	@#100,OLD100	; Запомнить вектор таймера
	MOV	PC,R0		; R0 = адрес INT304
	ADD	#INT304-.,R0	; (независимо от места загрузки)
	MOV	R0,PTR304	; Запомнить
;	ADD	#MUSBUF-INT304,R0
	
	MOV	#MUSBUF,REDPTR	; Очередь нот пуста
	MOV	#MUSBUF,WRTPTR	; (чтение = запись)
;	ADD	#END-MUSBUF,R0
	MOV	#END,ENDPTR	; Конец очереди

	ADD	#INT100-INT304,R0	; R0 = адрес INT100
	MOV	R0,@#100	; Вектор 100 (таймер)
	ADD	#INT300-INT100,R0	; R0 = адрес INT300
	MOV	@#300,OLD300	; Запомнить вектор клавиатуры
	MOV	R0,@#300	; Вектор 300 (клавиатура)
	ADD	#INT330-INT300,R0	; R0 = адрес INT330
	TST	@#7126		; Ячейка 7126 (процесс ПП)
	BMI	2$		; адрес ПЗУ (174222) => OLD330 = 174164
	MOV	@#7126,OLD330	; Запомнить прежний процесс
2$:	MOV	R0,@#7126	; Процесс - INT330
	ADD	#CLS-INT330,R0	; R0 = адрес CLS
	MOV	R0,@#13172	; Очистка экрана ПП - наша CLS
	ADD	#F.RUN-CLS,R0	; R0 = адрес F.RUN
	MOV	R0,@#14		; Ячейка 14 := F.RUN
	CLR	@#36		; PSW вектора TRAP = 0 (в ПЗУ 200)
	RETURN			; Выход



;------------------------------------------------------------------------------
; INT304 - прерывание таймера звука (вектор 304): полуволна, период NOTE1
;------------------------------------------------------------------------------
INT304:	
	Push	r0		; Сохранить R0
	Mov	#200,r0		; Бит 7:
	Xor	r0,@#177716	; Переключить динамик
	MOV	NOTE1,@#177712	; Период следующей полуволны
	TST	@#177714	; Сбросить флаг таймера
	Pop	r0		; Вернуть R0
	RTI			; Выход из прерывания

;------------------------------------------------------------------------------
; INT100 - таймер ПП: тик TMID, длительность и смена ноты из очереди REDPTR..
; WRTPTR (запись: длительность, период), затем прежний обработчик OLD100
;------------------------------------------------------------------------------
INT100:	MOV	#177777,TMID	; Метка тика (TWAIT)
	BIC	#17400,@#177716	; Выключить звуковой сигнал ПЗУ (биты 8-11)
	CLR	@#7046		; 7046 := 0: ПЗУ не сбросит 17600 (бит 7)
	TST	MCOUNT		; Нота ещё звучит?
	BEQ	3$		; нет =>
	DEC	MCOUNT		; Один тик
	BR	1$		; К прежнему обработчику
3$:	CMP	PTR304,@#304	; Вектор 304 наш?
	BEQ	2$		; да =>
	CMP	#174612,@#304	; или стандартный?
	BNE	1$		; чужой => не трогать
2$:	CMP	WRTPTR,REDPTR	; Очередь нот пуста?
	BNE	6$		; нет =>
	BIC	#100,@#177710	; Остановить таймер звука
	BR	1$		; К прежнему обработчику
6$:	MOV	R1,-(SP)	; Сохранить R1
	MOV	REDPTR,R1	; R1 -> следующая нота
	MOVB	(R1)+,MCOUNT	; Длительность в тиках
	MOVB	(R1)+,NOTE1	; Период
5$:	CMP	R1,ENDPTR	; Конец очереди?
	BNE	4$		; нет =>
 	SUB	#END-MUSBUF,R1	; Кольцо: в начало
4$:	MOV	R1,REDPTR	; Новый указатель чтения
	MOV	(SP)+,R1	; Вернуть R1
	MOV	PTR304,@#304	; Вектор 304 := INT304
	MOV	#107,@#177710	; Запустить таймер звука
	MOV	#1,@#177712	; Период 1 (до первой ноты)
	TST	@#177714	; Сбросить флаг таймера
1$:	JMP	@(PC)+		; К прежнему обработчику
OLD100:	.WORD	0		; Прежний вектор таймера

;------------------------------------------------------------------------------
; INT300 - прерывание клавиатуры: код клавиши в системный буфер ПП, STOP (4) -
; флаг On Break, иначе HOTKB и маска нажатых управляющих клавиш KBBIT (TOPK):
; нажатие ставит бит по таблице KTAB, отпускание (бит 7) снимает - сравнение при
; снятии идёт по младшей тетраде байта KTAB, возможно ошибка. Прежний обработчик
; не вызывается. ПЗУ (175412) при нажатии даёт щелчок (бит 7 регистра 177716,
; 7046 := 2), по STOP очищает буферы клавиатуры и ставит HALT ЦП (бит 20
; регистра 177716); здесь ни того, ни другого - только флаг @#16.
;------------------------------------------------------------------------------
INT300:	PUSH	R1		; Сохранить R1
	MOV	@#7200,R1	; R1 -> место в буфере клавиш ПП
	MOVB	@#177702,(R1)	; Код клавиши - в буфер
	CMPB	(R1),#4		; Код 4 (СТОП)?
	BNE	6$		; нет =>
	POP	R1		; Вернуть R1
	MOV	#177777,@#16	; Флаг On Break (см. IDE.MAC)
	RTI			; Выход из прерывания

6$:
	Tstb	(R1)		; Код клавиши
	Bpl	60$		; меньше 200 =>
	Mov	@#7202,@#7204	; Отпускание: очистить буфер автоповтора
	Mov	@#7206,@#7210	; и очередь ASCII-кодов (ПЗУ: 7206/7210)

60$:	INC	@#7200		; Продвинуть указатель в буфере
	BIC	#10,@#7200	; Кольцо из 8 байт
	INC	@#7060		; Счётчик клавиш
61$:	PUSH	@#177010	; Сохранить регистр адреса
	PUSH	R0		; R0
	PUSH	R3		; R3
	PUSH	R4		; R4
	MOV	#<DRVREG-4>/2,@#177010	; Адрес HOTKB
	MOVB	(R1),R0		; R0 = код клавиши
	MOVB	(R1),@#177014	; HOTKB = код
	MOV	PC,R1		; R1 = адрес KTAB
	ADD	#KTAB-.,R1	; (независимо от места загрузки)
	MOV	#1,R3		; Бит маски
2$:	CMPB	R0,(R1)+	; Код = очередному из KTAB?
	BNE	1$		; нет =>
	BIS	R3,TOPK		; Взвести бит в TOPK
1$:	ASL	R3		; Следующий бит
	BCC	2$		; Все 16 бит
	TSTB	R0		; Код клавиши
	BPL	5$		; нажатие => готово
	MOV	#1,R3		; Бит маски
	BIC	#200,R0		; Отпускание: код без бита 7
	SUB	#20,R1		; R1 -> KTAB
4$:	MOVB	(R1)+,R4	; Байт KTAB
	BIC	#177760,R4	; Младшая тетрада (смысл не выяснен)
	CMPB	R4,R0		; Совпало с кодом?
	BNE	3$		; нет =>
	BIC	R3,TOPK		; Снять бит в TOPK
3$:	ASL	R3		; Следующий бит
	BCC	4$		; Все 16 бит
5$:	INC	@#177010	; Адрес KBBIT
	MOV	TOPK,@#177014	; KBBIT = маска
	POP	R4		; Вернуть R4
	POP	R3		; R3
	POP	R0		; R0
	POP	@#177010	; Регистр адреса
	POP	R1		; R1
	RTI			; Выход из прерывания

; KTAB - коды клавиш для маски KBBIT (бит по порядку, 16 штук)
KTAB:	.BYTE	154,134,116,133,113,153,46,105,107,66,6,10,11,12,14,15
TOPK:	.WORD	0		; Текущая маска

;------------------------------------------------------------------------------
; INT330 - процесс ПП: цикл диспетчера ПЗУ (174164) делает JMP по ненулевой
; ячейке запуска (7126 - фиктивный процесс) и обнуляет её, поэтому INT330
; в конце снова ставит себя в 7126. Принять команду ЦП (пароль PASSW = 20),
; выполнить её через F.RUN, обновить RADR, RWIDTH, поставить бит 7 DRVREG, затем
; прежний процесс OLD330. При неверном коде F.RUN уходит на EX, который снимает
; со стека адрес возврата вместо R1 - возможная ошибка оригинала.
;------------------------------------------------------------------------------
INT330:	MOV	#177010,R5	; R5 -> регистр адреса
	MOV	#<DRVREG+2>/2,(R5)	; Адрес: код команды и пароль
	CMPB	5(R5),#20	; Пароль 20 (восьм.)?
	BNE	NOCALL		; нет => команды нет
$C:	MOV	R1,-(SP)	; Сохранить R1 (адрес процесса)
	DEC	(R5)		; Слово DRVREG
	CLRB	4(R5)		; Бит 7 = 0: выполняется
	INC	(R5)		; Слово кода команды
	MOVB	4(R5),R0	; R0 = код процедуры
	INC	(R5)		; WORK0
	MOV	4(R5),R1	; R1 = WORK0
	INC	(R5)		; WORK1
	MOV	4(R5),R2	; R2 = WORK1
	INC	(R5)		; WORK2
	MOV	4(R5),R3	; R3 = WORK2
	INC	(R5)		; WORK3
	MOV	4(R5),R4	; R4 = WORK3
	SUB	#4,(R5)		; Адрес кода команды
	CLRB	5(R5)		; Пароль := 0 (команда принята)
	
	CALL	F.RUN		; Выполнить процедуру


EX:	MOV	(SP)+,R1	; Вернуть R1
NOCALL:	MOV	#177010,R5	; R5 -> регистр адреса
	MOV	#<DRVREG-10>/2,(R5)	; Адрес RADR
	MOV	VIDEO,4(R5)	; RADR = начало видеопамяти
	INC	(R5)		; RWIDTH
	MOV	WIDTH,4(R5)	; RWIDTH = ширина строки
	MOV	#DRVREG/2,(R5)	; Адрес DRVREG
	BIS	#200,4(R5)	; Бит 7 = 1: выполнено
	
	
	MOV	R1,@#7126	; Процесс - снова INT330
	
	
	
	
	JMP	@(PC)+		; К прежнему процессу
OLD330:	.WORD	174164		; Прежний процесс; 174164 - цикл диспетчера ПЗУ

;------------------------------------------------------------------------------
; F.RUN - вызвать процедуру по коду R0 (таблица DTAB, вызов позиционно-
; независимый: смещение подставляется в команду JSR PC). R1..R4 - аргументы
;------------------------------------------------------------------------------
F.RUN:	ASL	R0		; R0 = код * 2
	CMP	#F0-DTAB-2,R0	; Код в пределах таблицы?
	BMI	EX		; нет => EX (см. заголовок)
	ADD	PC,R0		; R0 -> запись DTAB
	MOV	DTAB-.(R0),RN	; Смещение процедуры - в команду вызова
	.WORD	4767		; JSR PC, процедура
RN:	.+2			; Смещение (подставляется)
	RETURN			; Выход
		



AN=RN+2
DTAB:	.WORD	F0-AN,F1-AN,F2-AN,F3-AN,F4-AN,F5-AN,F6-AN,F7-AN,F8-AN
	.WORD	F9-AN,F10-AN,F11-AN,F12-AN,F13-AN,F14-AN,F15-AN,F16-AN
	.WORD	F17-AN,F18-AN,F19-AN,F20-AN,F21-AN,F22-AN,F23-AN,F24-AN
	.WORD	F25-AN

; F0 - пауза/звук по циклу: R1 - число периодов, R2 - период
F0:	MFPS	-(SP)		; Сохранить PS
	MTPS	#200		; Приоритет 4
	INC	R1		; ГЕНЕРАЦИЯ ЗВУКА 
	INC	R2		; ВХОД R1 = ДЛИТЕЛЬНОСТЬ, R2 = ЧАСТОТА
3$:	MOV	R2,R3		; R3 = частота
	BIC	#200,@#177716	; Динамик: 0
1$:	SOB	R3,1$		; Пауза
	BIS	#200,@#177716	; Динамик: 1
	MOV	R2,R3		; R3 = частота
2$:	SOB	R3,2$		; Пауза
	SOB	R1,3$		; Периоды
	MTPS	(SP)+		; Вернуть PS
	RETURN			; Выход

; F1 - сдвиг экрана на байт (меняет адреса строк в таблице ПП)
F1:				; СДВИГ ЭКРАНА. 
	MOV	@#23150,R5	; ВХОД : R1< 0 ВЛЕВО, R1>0 ВПРАВО
	MOV	24(R5),R0	; R0 -> начало таблицы строк экрана
	MOV	26(R5),R2	; R2 -> её конец
	SUB	R0,R2		; Длина
	ASR	R2		; В словах / 2
	ASR	R2		; R2 = число пар слов
	MOV	#5220,1$	; Команда INC (R0)+
	TST	R1		; R1 = направление
	BPL	1$		; вправо =>
	MOV	#5320,(PC)	; Влево: команда DEC (R0)+
1$:	.+2			; Подставленная команда
	TST	(R0)+		; Пропустить второе слово пары
	SOB	R2,1$		; Все строки
	RETURN			; Выход

; F2 - режим вывода: R1 = 0 замена, иначе XOR (точки, линии)
F2:
	Mov	r1,RPut		; Режим вывода: 0 - замена, иначе XOR
	Return			; Выход

; F3-F5 - палитра: вызов замены R2 -> R1 (и парного цвета при 177026)
F3:
F4:
F5:	
	PUSH	R1		; Сохранить R1
	PUSH	R2		; и R2
	CALL	2$		; Заменить цвет в палитре
	POP	R2		; Вернуть R2
	POP	R1		; и R1
	TST	@#177026	; Есть запрещённые плоскости?
	BEQ	4$		; нет =>
	MOV	#1,R0		; R0 = 1
	XOR	R0,R2		; Парный цвет
	CALL	2$		; Заменить и его
4$:	RETURN			; Выход
	
	




2$:	MOV	#2470,R5	; ЗАМЕНА В ПАЛИТРЕ ЦВЕТА1 НА ЦВЕТ2 
	BIT	#4,R2		; ВХОД R1 = ЦВЕТ2, R2 = ЦВЕТ1
	BEQ	1$		; цвета 0-3 =>
	TST	(R5)+		; Цвета 4-7: второе слово палитры
1$:	BIC	#177774,R2	; R2 = цвет1 & 3
	BIC	#177760,R1	; R1 = цвет2 & 17
	MOV	#17,R0		; Маска поля
	MOV	R2,R4		; R4 = R2
	ASL	R2		; Поле 4 бита:
	ASL	R2		; сдвиг * 4
	ASHC	R2,R0		; Маска и значение - на место поля
	BIC	R0,(R5)		; Очистить поле
	BIS	R1,(R5)		; Записать цвет
	MOV	(R5),4700-2470(R5)	; Копия палитры
	RETURN			; Выход
	
; F6 - точка (R2, R1) цветом ячейки 23442; при RPut <> 0 - XOR
F6:	CALL	F9		; РИСОВАНИЕ ТОЧКИ
	CALL	CLCADR		; ВХОД : R2 = X , R1 = Y
	MOV	@#23442,@#177016	; Цвет точки (23442) - в регистр цвета
	MOV	#401,R4		; Маска в обоих байтах
	ASH	R3,R4		; На место бита
	Tst	RPut		; Режим XOR?
	Bne	2$		; да =>
	MOVB	R4,@#177024	; Записать точку
1$:	RETURN			; Выход
2$:	Xor	r4,@#177014	; XOR в слове
	Return			; Выход
		


;------------------------------------------------------------------------------
; CLCADR - адрес точки: вход R2 = X, R1 = Y; выход R1 - адрес в видеопамяти
; (записан в 177010), R3 = номер бита. Строки идут вниз по убыванию адресов.
;------------------------------------------------------------------------------
CLCADR:	MOV	R2,R3		; R3 = X
	MUL	WIDTH,R1	; ПРОЦЕДУРА ВЫЧИСЛЕНЯ АДРЕСА 
	ASH	#-3,R2		; ВХОД : R2 = X , R1 = Y
	SUB	R2,R1		; ВЫХОД : R1 = ADDRES
	SUB	VIDEO,R1	; Минус начало видеопамяти
	NEG	R1		; R1 = VIDEO - Y*WIDTH + X/8
	BIC	#177770,R3	; R3 = номер бита (X & 7)
	MOV	R1,@#177010	; Адрес - в регистр
	RETURN			; Выход

; TSTCRD - ограничить координаты экраном (X <= ширина, Y <= 263.)
TSTCRD:	CMP	R2,@#23412	; ПРОВЕРКА КООРДИНАТ НА ВХОЖДЕНИЕ
	BMI	1$		; В ОБЛАСТЬ ЭКРАНА
	MOV	@#23412,R2	; X = ширина экрана
1$:	CMP	R1,#263.	; Y больше 263.?
	BMI	2$		; нет =>
	MOV	#263.,R1	; Y = 263.
2$:	TST	R2		; X < 0?
	BPL	3$		; нет =>
	CLR	R2		; X = 0
3$:	TST	R1		; Y < 0?
	BPL	4$		; нет =>
	CLR	R1		; Y = 0
4$:	RETURN			; Выход

F7:	MOV	R1,@#23442	; УСТАНОВКА ЦВЕТА ВЕКТОРА
	RETURN			; ВХОД : R1 = ЦВЕТ

F8:	MOV	#22656,R5	; УСТАНОВКА ЦВEТОВ ТЕКСТОВГО 
	ASL	R2		; РЕЖИМА
	ASL	R3		; ВХОД : R1 = СИМВOЛ
	CALL	1$		; R2 = ЗНАКОМЕСТО , R3 = ЭКРАН
	ADD	#76,R5		; Структура второго экрана
1$:	MOV	R1,34(R5)	; Цвет символа
	MOV	113512(R2),40(R5)	; Заливка знакоместа (таблица ПЗУ)
	MOV	113512(R3),44(R5)	; Заливка экрана
	RETURN			; Выход

F9:	CALL	TSTCRD		; УСТАНОВКА ГРАФИЧЕСКОГО УКАЗАТЕЛЯ
	MOV	R2,@#23420	; ВХОД : R2 = X , R1 = Y 
	MOV	R1,@#23422	; Y
	RETURN			; Выход


;------------------------------------------------------------------------------
; F10 - линия (алгоритм Брезенхема): режим XOR - XrLin; вертикальная и
; горизонтальная - отдельно (маски краёв BITMP0/BITMP1)
;------------------------------------------------------------------------------
F10:	
	MOV	@#23420,R4	; ПОСТРОЕНИЕ ВЕКТОРА 
	MOV	@#23422,R3	; ВХОД : R2 = X , R1 = Y
	CALL	F9		; Конец вектора - указатель
	CALL	SORTCR		; DX, DY, порядок точек
	MOV	@#23442,@#177016	; Цвет
	CALL	CLCADR		; R1 = адрес, R3 = бит
	Tst	Rput		; Режим XOR?
	Beq	100$		; нет =>
	Jmp	XrLin		; Рисовать с XOR
100$:	MOV	#177010,R4	; R4 -> регистр адреса
	MOV	#177024,R5	; R5 -> запись с цветом
	TST	DX		; DX = 0?
	BNE	660$		; нет =>

	MOV	DY,R0		; ВЕРТИКАЛЬНЫЙ DX=0
	BEQ	666$		; DY = 0: нечего рисовать
	MOV	#1,R2		; R2 = 1
	ASH	R3,R2		; Маска бита
	MOV	YADD,R1		; Шаг строки
	TST	(R0)+		; R0 = DY + 1
	ASR	R0		; Пары точек
	BCC	4$		; чётное =>
2$:	MOVB	R2,(R5)		; Точка
	SUB	R1,(R4)		; К следующей строке
4$:	MOVB	R2,(R5)		; Точка
	SUB	R1,(R4)		; К следующей строке
	SOB	R0,2$		; Все точки
	RETURN			; Выход

660$:	TST	DY		; ГОРИЗОНТАЛЬНЫЙ  DY=0
	BNE	661$		; DY <> 0 => наклонная
	MOV	DX,-(SP)	; Длина (DX)
	MOV	R3,R2		; R2 = бит
	MOV	#7,R0		; R0 = 7
	XOR	R0,R2		; R2 = 7 - бит
	SUB	R2,(SP)		; Длина минус точек в первом байте
	BMI	8$		; Один байт =>
	ADD	PC,R3		; R3 -> BITMP0
	MOVB	BITMP0-.(R3),(R5)	; Первый байт: маска от бита
	TST	(SP)		; Остаток?
	BEQ	667$		; нет => конец
	INC	(R4)		; Следующий байт
	MOV	(SP),R0		; R0 = остаток
	ASH	#-3,R0		; Полных байтов
	BEQ	3$		; нет =>
	MOV	#377,R2		; R2 = 377
1$:	MOVB	R2,(R5)		; Полный байт
	INC	(R4)		; Следующий байт
	SOB	R0,1$		; Все
3$:	MOV	(SP),R3		; R3 = остаток
	BIC	#177770,R3	; Остаток точек (0-7)
	ADD	PC,R3		; R3 -> BITMP1
	MOVB	BITMP1-.(R3),(R5)	; Последний байт: маска до бита
	BR	667$		; Конец
8$:	ADD	PC,R3		; R3 -> BITMP0
	MOVB	BITMP0-.(R3),R1	; Маска от бита
	MOV	(SP),R3		; R3 = остаток
	NEG	R3		; - остаток
	XOR	R0,R3		; Номер бита справа
	ADD	PC,R3		; R3 -> BITMP0
	BICB	BITMP0+1-.(R3),R1	; Убрать лишнее справа
	MOVB	R1,(R5)		; Записать байт
667$:	TST	(SP)+		; Снять длину
	BR	666$		; Выход

661$:	CMP	DY,DX		; НАКЛОННЫЙ DY>DX 
	BMI	662$		; АЛГОРИТМ БРЕЗЕНХЕМА ДЛЯ 8 СВЯЗНОЙ 
	MOV	DY,R0		; РАЗВЕРТКИ ВЕКТОРА.
	MOV	DY,-(SP)	; DY
	ASL	(SP)		; 2 * DY
	MOV	DX,-(SP)	; DX
	ASL	(SP)		; 2 * DX
	MOV	(SP),R2		; R2 = 2 * DX
	SUB	R0,R2		; Ошибка = 2 * DX - DY
	INC	R0		; R0 = DY + 1 точек
	MOV	#1,R1		; R1 = 1
	ASH	R3,R1		; Маска точки
	MOV	YADD,R3		; Шаг строки
9$:	MOVB	R1,(R5)		; Точка
	TST	R2		; Ошибка < 0?
	BMI	6$		; да =>
	ASLB	R1		; Шаг по X
	BCC	7$		; в этом байте =>
	INC	R1		; Первый бит следующего байта
	INC	(R4)		; Следующий байт
7$:	SUB	2(SP),R2	; Ошибка - 2 * DY
6$:	ADD	(SP),R2		; Ошибка + 2 * DX
	SUB	R3,(R4)		; Шаг по Y
	SOB	R0,9$		; Все точки
10$:	CMP	(SP)+,(SP)+	; Снять рабочие слова
666$:	RETURN			; Выход


662$:	MOV	DX,R0		; НАКЛОННЫЙ DY<DX
	MOV	DX,-(SP)	; DX
	ASL	(SP)		; 2 * DX
	MOV	DY,-(SP)	; DY
	ASL	(SP)		; 2 * DY
	MOV	(SP),R2		; R2 = 2 * DY
	SUB	R0,R2		; Ошибка = 2 * DY - DX
	INC	R0		; R0 = DX + 1 точек
	MOV	#1,R1		; R1 = 1
	ASH	R3,R1		; Маска точки
	MOV	YADD,R3		; Шаг строки
19$:	MOVB	R1,(R5)		; Точка
	TST	R2		; Ошибка < 0?
	BMI	16$		; да =>
	SUB	R3,(R4)		; Шаг по Y
	SUB	2(SP),R2	; Ошибка - 2 * DX
16$:	ADD	(SP),R2		; Ошибка + 2 * DY
	ASLB	R1		; Шаг по X
	BCC	17$		; в этом байте =>
	INC	R1		; Первый бит следующего байта
	INC	(R4)		; Следующий байт
17$:	SOB	R0,19$		; Все точки
	BR	10$		; Конец



; SORTCR - DX, DY и шаг строки YADD; точки упорядочены так, чтобы X рос
SORTCR:	MOV	@#22666,YADD	; ПРОЦЕДУРА СОРТИРОВКИ ДВУХ ПАР КООРДИНАТ
	MOV	R3,DY		; DY = Y2
	SUB	R1,DY		; - Y1
	BPL	2$		; Вниз =>
	NEG	DY		; DY = |DY|
	NEG	YADD		; Вверх: шаг строки с минусом
2$:	MOV	R4,DX		; DX = X2
	SUB	R2,DX		; - X1
	BPL	1$		; Вправо =>
	NEG	DX		; DX = |DX|
	MOV	R3,R1		; Начало и конец
	MOV	R4,R2		; меняются (X растёт)
	NEG	YADD		; Шаг строки по Y меняется
1$:	RETURN			; Выход



; XrLin - линия с XOR (запись через 177014)
XrLin:
	Mov	#177010,r4	; R4 -> регистр адреса
	Mov	#177014,r5	; R5 -> данные (XOR)
	CMP	DY,DX		; НАКЛОННЫЙ DY>DX 
	BMI	662$		; АЛГОРИТМ БРЕЗЕНХЕМА ДЛЯ 8 СВЯЗНОЙ 
	MOV	DY,R0		; РАЗВЕРТКИ ВЕКТОРА.
	MOV	DY,-(SP)	; DY
	ASL	(SP)		; 2 * DY
	MOV	DX,-(SP)	; DX
	ASL	(SP)		; 2 * DX
	MOV	(SP),R2		; R2 = 2 * DX
	SUB	R0,R2		; Ошибка = 2 * DX - DY
	INC	R0		; R0 = DY + 1 точек
	Mov	#401,r1		; Маска точки (оба байта)
	ASH	R3,R1		; На место бита
	MOV	YADD,R3		; Шаг строки
9$:	Xor	r1,(r5)		; Инвертировать точку
	TST	R2		; Ошибка < 0?
	BMI	6$		; да =>
	ASL	R1		; Шаг по X
	BCC	7$		; в этом слове =>
	Mov	#401,R1		; Первый бит следующего байта
	INC	(R4)		; Следующий байт
7$:	SUB	2(SP),R2	; Ошибка - 2 * DY
6$:	ADD	(SP),R2		; Ошибка + 2 * DX
	SUB	R3,(R4)		; Шаг по Y
	SOB	R0,9$		; Все точки
10$:	CMP	(SP)+,(SP)+	; Снять рабочие слова
666$:	RETURN			; Выход


662$:	MOV	DX,R0		; НАКЛОННЫЙ DY<DX
	MOV	DX,-(SP)	; DX
	ASL	(SP)		; 2 * DX
	MOV	DY,-(SP)	; DY
	ASL	(SP)		; 2 * DY
	MOV	(SP),R2		; R2 = 2 * DY
	SUB	R0,R2		; Ошибка = 2 * DY - DX
	INC	R0		; R0 = DX + 1 точек
	MOV	#401,R1		; Маска точки
	ASH	R3,R1		; На место бита
	MOV	YADD,R3		; Шаг строки
19$:	Xor	r1,(r5)		; Инвертировать точку
	TST	R2		; Ошибка < 0?
	BMI	16$		; да =>
	SUB	R3,(R4)		; Шаг по Y
	SUB	2(SP),R2	; Ошибка - 2 * DX
16$:	ADD	(SP),R2		; Ошибка + 2 * DY
	ASL	R1		; Шаг по X
	BCC	17$		; в этом слове =>
	Mov	#401,R1		; Первый бит следующего байта
	INC	(R4)		; Следующий байт
17$:	SOB	R0,19$		; Все точки
	BR	10$		; Конец
	
	
	

; F11 - закрашенный прямоугольник: строка в FILBUF (маски краёв, 377), BARPUT
F11:	CALL	TSTCRD		; РИСОВАНИЕ ЗАКРАШЕНОГО ПРЯМОУГОЛЬНИКА
	MOV	R1,@#23416	; ВХОД : (R2,R1)-(R4,R3)
	MOV	R2,@#23414	; Первый угол: X
	MOV	R3,R1		; R1 = Y2
	MOV	R4,R2		; R2 = X2
	CALL	F9		; Второй угол - в указатель (с проверкой)
	MOV	R1,R3		; R3 = Y2 (проверенный)
	MOV	R2,R4		; R4 = X2
	MOV	@#23416,R1	; R1 = Y1
	MOV	@#23414,R2	; R2 = X1
	CALL	SORTCR		; DX, DY, порядок
	MOV	DX,-(SP)	; Ширина
	CALL	CLCADR		; R1 = адрес, R3 = бит
	MOV	#FILBUF,R1	; R1 -> буфер строки закраски
	MOV	R1,TMP		; Начало буфера
	MOV	R3,R2		; R2 = бит
	MOV	#7,R5		; R5 = 7
	XOR	R5,R2		; R2 = 7 - бит
	ADD	PC,R3		; R3 -> BITMP0
	MOVB	BITMP0-.(R3),(R1)+	; Левый байт: маска от бита
	SUB	R2,(SP)		; Ширина минус точек в байте
	BMI	5$		; Один байт =>
	MOV	(SP),R4		; Остаток
	ASH	#-3.,R4		; Полных байтов
	BEQ	1$		; нет =>
2$:	MOVB	#377,(R1)+	; Полный байт
	SOB	R4,2$		; Все
1$:	BIC	#177770,(SP)	; Остаток точек
	MOV	(SP),R3		; R3 = остаток
	ADD	PC,R3		; R3 -> BITMP1
	MOVB	BITMP1-.(R3),(R1)+	; Правый байт: маска до бита
	BR	4$		; Конец
5$:	NEG	(SP)		; Остаток по модулю
	MOV	(SP),R3		; R3 = остаток
	XOR	R5,R3		; Номер бита справа
	ADD	PC,R3		; R3 -> BITMP0
	BICB	BITMP0+1-.(R3),-1(R1)	; Убрать лишнее справа
4$:	TST	(SP)+		; Снять ширину
	SUB	R1,TMP		; TMP = конец буфера
	NEG	TMP		; TMP = длина строки в байтах
	INC	DY		; Число строк

BARPUT:	MOV	@#23442,@#177016	; Цвет
	MOV	#FILBUF,R1	; R1 -> буфер строки
	MOV	#177010,R4	; R4 -> регистр адреса
	MOV	#177024,R5	; R5 -> запись с цветом
	MOV	YADD,R0		; Шаг строки
	ADD	TMP,R0		; Минус длина строки
	MOV	TMP,-(SP)	; Длина строки
	MOV	DY,R2		; R2 = число строк
2$:	MOV	(SP),R3		; R3 = байтов в строке
1$:	MOVB	(R1)+,(R5)	; Байт строки - на экран
	INC	(R4)		; Следующий адрес
	SOB	R3,1$		; Вся строка
	SUB	R0,(R4)		; К следующей строке
	SUB	(SP),R1		; Буфер сначала
	SOB	R2,2$		; Все строки
	TST	(SP)+		; Снять длину
EXT:	RETURN			; Выход

; F12 - цвет точки в WORK0 (по трём байтам плоскостей)
F12:	CALL	CLCADR		; ЧТЕНИЕ ЦВЕТА ТОЧКИ
	INC	R3		; R3 = номер бита + 1
	NEG	R3		; Сдвиг к нужному биту
	MOVB	2(R5),R1	; Байт 177012
	MOVB	4(R5),R2	; Байт 177014 (мл.)
	MOVB	5(R5),R4	; Байт 177014 (ст.)
	CLR	R0		; R0 = 0
	ASH	R3,R4		; Бит третьего байта
	ROL	R0		; в R0
	ASH	R3,R2		; Бит второго байта
	ROL	R0		; в R0
	ASH	R3,R1		; Бит первого байта
	ROL	R0		; в R0
	BIC	@#177026,R0	; Убрать запрещённые плоскости
	MOV	#<DRVREG+4>/2,(R5)	; Адрес WORK0
	MOV	R0,4(R5)	; Цвет - в WORK0
	RETURN			; Выход

F13:	MOV	#<DRVREG+4>/2,(R5)	; ЧТЕНИЕ КООРИНАТ ГРАФИЧЕСКОГО КУРСОРА 
	MOV	@#23422,4(R5)	; WORK0 = Y
	INC	(R5)		; WORK1
	MOV	@#23420,4(R5)	; WORK1 = X
	RETURN			; Выход

F14:	MOV	@#23422,@#23414	; ЗАЛИВКА ОГРАНИЧЕНОЙ ФИГУРЫ
	MOV	@#23420,@#23416	; ВХОД : R1 = ЦВЕТ ЗАЛИВКИ  
	MOV	R1,@#23450	; Цвет заливки
	CALL	@#151714	; НАГЛОЕ ИСПОЛЬЗОВАНЕ "ПЗУШНОЙ" П/П (Esc UB)
	RETURN			; Выход

F15:	MOV	WRTPTR,R5	; ДОБАВИТЬ ЭЛЕМЕНТ В ОЧЕРЕДЬ ПРОИГРЫВАТЕЛЯ.
	TST	(R5)+		; ВХОД : R1 - ДЛИТЕЛЬНОСТЬ, R2 -  
	CMP	R5,ENDPTR	; Конец очереди?
	BNE	2$		; нет =>
	SUB	#END-MUSBUF,R5	; Кольцо: в начало
2$:	CMP	R5,REDPTR	; Очередь полна?
	BEQ	1$		; да => нота теряется
	MOV	R5,WRTPTR	; Новый указатель записи
	MOVB	R2,-(R5)	; Период
	MOVB	R1,-(R5)	; Длительность
1$:	RETURN			; Выход

F16:	MOV	ENDPTR,WRTPTR	; ВЫКЛЮЧИТЬ ПРОИГРЫВАТЕЛЬ
	SUB	#END-MUSBUF,WRTPTR	; Очередь пуста:
	MOV	WRTPTR,REDPTR	; чтение = запись
	RETURN			; Выход

;------------------------------------------------------------------------------
; F17 - режим экрана: R1 = 0 - 80 символов, 1 - 40. Перестраивает системные
; ТВ экрана ПП (22656; 22666 = +10: длина видеострок), список (2500).
;------------------------------------------------------------------------------
F17:	MOV	#22656,R5	; R5 -> системная структура экрана ПП
	MOV	#2,74(R5)	; ТВ +74: рулон есть (2)
	MOV	R1,-(SP)	; Сохранить R1 (режим)
	CALL	CLS		; Очистить экран
	MOV	(SP)+,R1	; Вернуть R1
	MOV	#4534,@#23432	; 23432: 264-я видеострока (2500 + 4*264 - 4)
	MOV	#1,@#22744	; ТВ +66: формат экрана 1 (80 знаков)
	CLR	@#2462		; Регистр отображения (2460/2462) := 0
	MOV	#1200,@#23412	; Ширина экрана 640. точек
	MOV	#120,R4		; УСТАНОВИТЬ ВИДЕОРЕЖИМ
	TST	R1		; ВХОД R1 - РЕЖИМ (0 - 80 СИМВ.,1 - 40 СИМВ.) 
	BEQ	1$		; Режим 80 =>
	MOV	#20,@#2462	; Режим 40: бит 20 регистра отображения
	ASR	R4		; Шаг строки / 2
	ASL	@#22744		; ТВ +66 := 2 (40 знаков)
	MOV	#500,@#23412	; Ширина экрана 320. точек
1$:	MOV	R4,@#22666	; ТВ +10: длина видеострок в байтах
	MOV	R4,@#22662	; ТВ +4: знаков в строке
	MOV	#100000,R0	; R0 = 100000
	MOV	R0,@#22660	; ТВ +2: начальный видеоадрес
	MOV	#2500,R1	; R1 -> таблица строк
	MOV	R1,-2(R1)	; Слово перед списком видеострок
	MOV	#436,R3		; Число строк (436 восьм.)
	MOV	R4,WIDTH	; Ширина строки для драйвера
	CALL	3$		; Заполнить таблицу строк
	MOV	@#4534,VIDEO	; Начало видеопамяти
	CALL	@#110210	; ПЗУ: ТВ из R5 - текущая (23150 := R5)
	CMP	#120,R4		; Режим 80?
	BEQ	2$		; да => готово
	MOV	#410,R3		; Вторая структура экрана:
	MOV	#4704,R1	; R1 -> её таблица строк
	MOV	R0,@#4674	; значения (не выяснены)
	MOV	R0,@#22754+2	; Экран установки (ТВ 22754): +2 начало
	MOV	R3,@#22754+6	; +6 видеострок (264.)
	MOV	#30,@#22754+12	; +12 строк знаков (24.)
	MOV	R3,@#22754+14	; +14 всего видеострок
	MOV	R3,@#22754+16	; +16 (значение 264. - не ясно)
	MOV	R1,@#22754+24	; +24 начало списка видеострок
	MOV	R1,@#22754+30	; +30 список верхней части
	ADD	R4,R0		; Адрес следующей страницы
	CALL	3$		; Заполнить таблицу строк
2$:	CALL	CLS		; Очистить экран
	CMP	#120,@#22666	; Режим 80?
	BEQ	4$		; да =>
	CLR	@#22656+74	; Режим 40: рулона нет (ТВ +74 := 0)
4$:	RETURN			; Выход

3$:	MOV	R0,(R1)+	; Адрес строки - в таблицу
	TST	(R1)+		; Пропустить слово
	ADD	R4,R0		; Следующая строка
	SOB	R3,3$		; Все строки
	RETURN			; Выход


; F18 - страницы: R1 - видимая, R2 - активная (переключает таблицы строк)
F18:	CMP	#120,@#22666	; УСТАНОВКА ВИДЕОСТРАНИЦ
	BEQ	5$		; ВХОД R1 = VISUAL , R2 = ACTIVE
	MOV	#2500,R3	; Таблица строк страницы 0
	TST	R1		; R1 = видимая страница
	BMI	2$		; отрицательная => не менять
	BEQ	1$		; нулевая =>
	MOV	#4672,R3	; Таблица строк страницы 1
1$:	MOV	R3,@#2476	; Видимая страница: таблица строк
2$:	MOV	#22656,R5	; R5 -> структура страницы 0
	MOV	#4534,@#23432	; 23432: 264-я видеострока (2500 + 4*264 - 4)
	TST	R2		; R2 = активная страница
	BMI	5$		; отрицательная => не менять
	BEQ	3$		; нулевая =>
	MOV	#6734,@#23432	; Страница 1: последняя видеострока
	MOV	#22754,R5	; R5 -> структура страницы 1
3$:	CALL	@#110210	; ПЗУ: ТВ из R5 - текущая (23150 := R5)
	MOV	2(R5),VIDEO	; Начало видеопамяти страницы
	ADD	#51060/2,VIDEO	; Плюс 51060 / 2
	MOV	#76,R4		; R4 = 76
	CMP	#22656,R5	; Страница 0?
	BEQ	6$		; да =>
	NEG	R4		; R4 = -76
6$:	ADD	R4,R5		; R5 -> структуру другой страницы
	MOV	60(R5),R1	; R1 -> таблицу образа курсора
	MOV	#13,R2		; Записей (11.)
7$:	TST	(R1)+		; Пропустить слово
	BIC	#1,(R1)+	; Бит 0 второго слова := 0 (скрыть курсор)
	SOB	R2,7$		; Все записи
5$:	RETURN			; Выход


F19:	MOV	R1,@#22656+70	; УСТАНОВКА ЦВЕТА КУРСОРА 
	MOV	R1,@#22754+70	; ВХОД R1 = ЦВЕТ 
	RETURN			; Выход



; RstVct - снять драйвер: вернуть вектора и процесс ПП
RstVct:	Mov	OLD100,@#100	; REMOVE FROM PP
	Mov	#174612,@#304	; Вектор 304: стандартный
	Mov	OLD300,@#300	; Вернуть вектор клавиатуры
	Mov	#113236,@#13172	; Очистка экрана ПЗУ
	Mov	#200,@#36	; PSW вектора TRAP: 200 (как в ПЗУ)
	Mov	OLD330,R1	; R1 = прежний процесс
	Bpl	1$		; нормальный =>
	Mov	#174222,R1	; 174222 - фиктивная п/п ПЗУ
1$:	Mov	R1,@#7126	; Ячейка 7126 := прежний процесс
	Return			; Выход
	
	
f20:	Call	RstVct		; Снять драйвер
	CMP	(SP)+,(SP)+	; Снять два адреса возврата
	JMP	(R1)		; К прежнему процессу
	
	
; F21 - образ символа из памяти ЦП (R1 - код, R2 - адрес) в шрифт ПП (11 байт)
F21:
	Bic	#177400,r1	; R1 = код символа
	Mov	r1,r3		; R3 = код
	Asl	r3		; Индекс в таблице указателей
	Mul	#13,r1		; Смещение образа (11 байт на символ)
	Ror	r2		; Адрес образа в памяти ЦП - в слова
	Mov	r2,(r5)		; В регистр адреса
	Add	#15602-<13*40>,r1	; Область знаков пользователя ПП
	Mov	r1,14142(r3)	; Указатель на образ
	Mov	#13,r2		; 11 байт
1$:	Movb	4(r5),(r1)+	; Байт из памяти ЦП
	Inc	(r5)		; Следующий адрес
	Sob	r2,1$		; Все байты
	Return			; Выход
	
; F22 - образ символа из шрифта ПП в память ЦП (R1 - код, R2 - адрес)
F22:
	Bic	#177400,r1	; R1 = код символа
	Asl	r1		; Индекс в таблице указателей
	Mov	14142(r1),r1	; R1 -> образ символа
	Ror	r2		; Адрес в памяти ЦП - в слова
	Mov	r2,(r5)		; В регистр адреса
	Mov	#13,r2		; 11 байт
1$:	Movb	(r1)+,4(r5)	; Байт - в память ЦП
	Clrb	5(r5)		; Старший байт = 0
	Inc	(r5)		; Следующий адрес
	Sob	r2,1$		; Все байты
	Return			; Выход
	
	
; F23 - положение курсора ПП (поля +16, +20 структуры @#23150) в WORK0, WORK1
F23:	Mov	#<DrvReg+4>/2,(r5)	; Адрес WORK0
	Mov	@#23150,r0	; R0 -> структура курсора ПП
	Mov	16(r0),4(r5)	; WORK0 = столбцов справа (+16)
	Inc	(r5)		; WORK1
	Mov	20(r0),4(r5)	; WORK1 = строк снизу (+20)
	Return			; Выход


F24:				; Get Support for plan 0
	Mov	r2,(r5)		; Адрес в видеопамяти
	Mov	#1000,r0	; R0 -> буфер FILBUF
	Mov	r3,r4		; R4 = длина в байтах
	Bit	#1,@#177026	; Плоскость 0 запрещена?
	Bne	2$		; да => нули
1$:	Movb	2(r5),(r0)+	; Байт 177012
	Inc	(r5)		; Следующий адрес
	Sob	r4,1$		; Все байты
	Br	3$		; Дальше
2$:	Clrb	(r0)+		; Нули
	Sob	r4,2$		; Все байты
3$:	Asr	r3		; Длина / 2
	Inc	r3		; Слов
	Mov	r1,(r5)		; Адрес в памяти ЦП
	Mov	#1000,r0	; R0 -> буфер
4$:	Mov	(r0)+,4(r5)	; Слово - в память ЦП
	Inc	(r5)		; Следующий адрес
	Sob	r3,4$		; Все слова
	Return			; Выход



; F25 - вывести образ из памяти ЦП в видеопамять: R1 - адрес образа, R2 - видео-
; адрес, R3 - ширина и режим (0 замена, 1 XOR, 2 OR, 3 сброс); только если не
; взят бит 0 регистра 177026. Исполнители - MovPut, XorPut, BisPut, BicPut
F25:	
	Bit	#1,@#177026	; Плоскость 0 запрещена?
	Bne	F251		; да => ничего не делать
	Mov	r1,(r5)		; Адрес образа в памяти ЦП
	Mov	#1000,r1	; R1 -> буфер FILBUF
	Movb	r3,r0		; R0 = ширина в байтах
	Asr	r0		; В слова
	Inc	r0		; Слов

1$:	Mov	4(r5),(r1)+	; Образ из памяти ЦП - в буфер
	Inc	(r5)		; Следующий адрес
	Sob	r0,1$		; Все слова
	Mov	#<DrvReg+6>/2,(r5)	; Адрес WORK1
	Clr	4(r5)		; WORK1 = 0
	
	Mov	r2,(r5)		; Адрес в видеопамяти
	Movb	r3,r0		; R0 = ширина в байтах
	Mov	#1000,r1	; R1 -> буфер
	Swab	r3		; Режим из старшего байта R3
	Bic	#^C3,r3		; Оставить 0-3
	Asl	r3		; Индекс * 2
	Add	PC,R3		; R3 -> RpTab
	MOV	RpTAB-.(R3),PN	; Смещение процедуры - в команду
	.WORD	167		; JMP процедура
PN:	.+2			; Смещение (подставляется)
XN	= PN + 2
RpTab:	.Word	MovPut-XN,XorPut-XN,BisPut-XN,BicPut-XN
	
F251:				; Адрес WORK1
	Mov	#<DrvReg+6>/2,(r5)	; WORK1 = 0
	Clr	4(r5)
	Return			; Выход
	

MovPut:
	Movb	r4,r3		; Маска левого края
	Dec	r0		; Ширина - 1
	Beq	4$		; Один байт =>
	Bicb	r3,2(r5)	; Очистить биты края
	Bisb	(r1)+,2(r5)	; Записать
	Br	6$		; Дальше

3$:	Movb	(r1)+,2(r5)	; Полный байт
6$:	Inc	(r5)		; Следующий адрес
	Sob	r0,3$		; Все байты
	Clr	r3		; R3 = 0
4$:
	Swab	r4		; Маска правого края
	Bisb	r4,r3		; В R3
	Bicb	r3,2(r5)	; Очистить биты
	Bisb	(r1)+,2(r5)	; Записать
	Return			; Выход


XorPut:
1$:	Movb	(r1)+,r3	; Байт образа
	Xor	r3,2(r5)	; XOR с экраном
	Inc	(r5)		; Следующий адрес
	Sob	r0,1$		; Все байты
	Return			; Выход
	
BisPut:
1$:	Bisb	(r1)+,2(r5)	; OR с экраном
	Inc	(r5)		; Следующий адрес
	Sob	r0,1$		; Все байты
	Return			; Выход
	
BicPut:
1$:	Bicb	(r1)+,2(r5)	; Снять биты
	Inc	(r5)		; Следующий адрес
	Sob	r0,1$		; Все байты
	Return			; Выход
	



	
10$:	Return			; Выход



TWAIT:	CLR	TMID		; ОЖИДАНИЕ ПРЕРЫВАНИЯ ОТ СЕТЕВОГО ТАЙМЕРА
1$:	TST	TMID		; Тик таймера пришёл?
	BEQ	1$		; нет => ждать
	RETURN			; Выход

; CLS - очистка экрана ПП: заливка фона из таблицы ПЗУ, процедура 113262
CLS:	
	PUSH	@50(R5)		; Сохранить две ячейки
	PUSH	@52(R5)		; экранной структуры
	MOV	#8.,R0		; Цветов
	MOV	#113512,R1	; R1 -> таблица заливок ПЗУ
1$:	CMP	44(R5),(R1)+	; Найти текущую заливку фона
	BEQ	2$		; Нашли =>
	SOB	R0,1$		; Все цвета
	MOV	#113514,R1	; Не нашли: последняя запись
2$: 	SUB	#113514,R1	; R1 = смещение
	CLR	R0		; R0 = 0
	ASR	R1		; Номер цвета
	ASR	R1		; делится
	BCC	3$		; чётный =>
	MOV	#-4,R0		; Нечётный: сдвиг -4
3$:	ADD	50(R5),R1	; Плюс адрес
	MOVB	(R1),R2		; Байт
	ASH	R0,R2		; Выделить поле
	BIC	#177770,R2	; Номер 0-7
	ASL	R2		; Индекс в таблице
	MOV	113512(R2),R2	; Заливка фона
	MOV	R2,@50(R5)	; В первую ячейку
	MOV	R2,@52(R5)	; и во вторую
	JMP	@#113262	; Очистка экрана - процедура ПЗУ

	


; BITMP0 - маски от бита до конца байта; BITMP1 - от начала байта до бита
BITMP0:	.BYTE	^B11111111
	.BYTE	^B11111110
	.BYTE	^B11111100
	.BYTE	^B11111000
	.BYTE	^B11110000
	.BYTE	^B11100000
	.BYTE	^B11000000
	.BYTE	^B10000000
BITMP1:	.BYTE	^B00000000
	.BYTE	^B00000001
	.BYTE	^B00000011
	.BYTE	^B00000111
	.BYTE	^B00001111
	.BYTE	^B00011111
	.BYTE	^B00111111
	.BYTE	^B01111111


OLD300:	.WORD	0		; Прежний вектор клавиатуры
VIDEO:	.WORD	151060		; Начало видеопамяти (режим 80)
WIDTH:	.WORD	120		; Ширина строки в байтах (80.)
TMID:	.WORD	0		; Метка тика (INT100)
DX:	.WORD	0		; Приращение по X
DY:	.WORD	0		; Приращение по Y
TMP:	.WORD	0		; Рабочая ячейка
YADD:	.WORD	0		; Шаг строки (со знаком)
PTR304:	.WORD	0		; Адрес INT304
ENDPTR:	.WORD	0		; Конец очереди нот
REDPTR:	.WORD	0		; Указатель чтения
WRTPTR:	.WORD	0		; Указатель записи
MCOUNT:	.WORD	0		; Тиков до конца ноты
NOTE1:	.WORD	0		; Период текущей ноты
Rput:	.Word	0		; Режим вывода (F2)

TGEND::
	FILBUF	=   1000	; Буфер строки закраски
	MUSBUF	=   FILBUF + 122	; Очередь нот: 2 байта на ноту
	END	=   MUSBUF + 2*100.	; Конец очереди (100. нот)

	.END

