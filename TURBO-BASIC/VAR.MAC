; Системный переменые, испрользуемые IDE
;------------------------------------------------------------------------------
; VAR - переменные IDE в разделе Variable резидента ПП (между Locked и System).
; Макрос .DW имя [байт] - метка и место (по умолчанию слово), COUNT - счётчик.
; Пометка ;! у автора (смысл не выяснен до конца). В других модулях не найдены:
; CopStm, HLLN, SWPFLG, SBX, SBY; EDWIND закомментирована
;------------------------------------------------------------------------------


.MACRO	.DW	NAME TYPE=2

;	NAME==	COUNT
NAME::	.Blkb	Type
	.IF	NB TYPE
	COUNT =	COUNT + TYPE
	.IFF
	COUNT = COUNT + 2
	.ENDC


.ENDM





;MaxTex=	6.		; Максимальное число одновремено редактиру-
				; емых текстов

.Psect	Variable

COUNT	=.
VARSEG	==Count			; Верхнее меню :
.DW	UPWRK		;!	; Указатель на первое окно верхнего меню
.DW	WPNT		;!	; Номер текущей альтернативы в верхнем меню
.DW	ENTFLG		;!	; Режим: перемеюение указателя с окном или без
.Dw	CopStm			; Копия регистра управления памятью



.DW	MX.PTR			; Максимальное значение указателя
.DW	SL.LEN	20.		; Длины видимых строк
.DW	HLLN			; Не используется (в других модулях не найдено)
			;!	; Системные ячейки оконой системы
.DW	CL.X		;!	; координата X рабочего окна
.DW	CL.Y		;!	; координата Y рабочего окна
.DW	CL.WX		;!	; размер X рабочего окна
.DW	CL.WY		;!	; размер Y рабочего окна
.DW	WA		;!	; указатель на массив параметров текущего окна
.DW	W0		;!	; указатель на текст окна
.DW	W1		;!	; Рабочий X
.DW	W2		;!	; Рабочий Y
.DW	W3		;!	; Рабочий WX
.DW	W4		;!	; Рабочий WY
.DW	EX		;!	; Столбец в окне; в списке файлов - индекс
.DW	EY			; Строка в окне
.DW	RSLT		;!	; Рус/Лат
.DW	KEYCOD			; Код 'горячей' клавиши, после выхода из окна
.DW	TMP		;!	; Рабочая ячейка всех процедур.
.DW	TMRED			; Готовность таймера
.DW	WBPNT		;!	; Указатель стека видео окон
.DW	JMPADR			; Указатель на процедуру
.DW	WAREA	4		; Рабочий массив меню
.DW	WBUF	40.		; Стек видео окон (4 окна )
.DW	SWPFLG			; Флаг свапирования
.DW	BAREA	28.		; Место для сохранения списков
.DW	B.PTR		;!
.DW	CM.PTR			; Указатель на компилируюмую строку
.DW	CM.NUM			; Номер комп. строки
.DW	CM.FLG			; Флаг режима компиляции
.DW	CM.ERN			; Код последней ошибки
.DW	CM.ERL			; Номер строки, содержащей ошибку
.DW	RN.FLG			; Флаг режима исполнения
.DW	TrsFlg	1		; Флаг трансфера
.DW	RWait	1		; Признак необходимости ожидания клавиши после компиляции

.DW	R.PUT			; Режим вывода PRTL
.DW	C.IDEN	1		; Куросор On/Off
.DW	C.MOVE	1		; Курсор Move/Don't move
.DW	EDFLG	1		; Флаг внесения изменений в строку
.DW	DEC.BF	10		; Буфер ввода/вывода числа
.DW	XSIM	21.		; Табличка символов для сдига экрана
.DW	F.LEN			; Длина файла / конец загружаемого текста
.DW	OLDFNT	18.		; Таблица для сохранения старого фонта
.DW	DR.X			; Координата курсора в каталоге файлов
.DW	DR.PTR			; Абсолютная кордината
.DW	DR.MAX			; Число файлов в каталоге
.DW	DS.PTR			; Обработчик поля ввода диалога ($OpF, $SvF)

.DW	SYSPL	4		; Палитра, до входа в бейсик
.DW	IDEPL	4		; Палитра, используемая в редакторе
.DW	BASPL	4		; Палитра, используемая в Basic

.DW	BBUF			; Начало буфера вв/выв
.DW	kBUF			; Конец буфера вв/выв
.Dw	nHelp			; Контекст помощи (HELP.MAC)
.Dw	LhPtr			; Указатель истории тем помощи (HELP.MAC)

;.DW	EDWIND	34.*6


;------------------------------------------------------------------------------
; DSCTOP..ENDPP - рабочий стол: F75 записывает эту область в DK:TURBO.DSC, а
; $LdSk читает обратно (положение курсора, имя файла, палитры, опции окон)
;------------------------------------------------------------------------------
DSCTOP	== COUNT
				; Редактор :
.DW	ED.X			; Координата X курсора
.DW	ED.Y			; Координата Y курсора
.DW	LB.PTR			; Указатель на символ в буфрере строки
.DW	ROL.HD			; Смещение по горизонтали S = X Mod 256
.DW	ROL.GD			; Смещение по вертикали S = X Mod 20
.DW	UP.PTR			; Указатель на начало текста
.DW	DN.PTR			; Указaтель на конец текста
.DW	SL.PTR			; Указатель на верхнюю строку экрана
.DW	EFNAM	16.		; Имя файла
.DW	MX.LIN			; Число строк в тексте
.Dw	NONMID	1		; Прихнак файла NONAME.BAS
.Dw	ChngID	1		; Признак наличия измений


.DW	SBX	1		; Не используется
.DW	SBY	1		; Не используется
.DW	PLG1			; Палитра: цвет 0 (0-7), диалог PALETE
.DW	PLG2			; Палитра: цвет 1
.DW	PLG3			; Палитра: цвет 2
.DW	PLG4			; Палитра: цвет 3
.DW	ESW			; EDITOR STATUS WORD
.DW	CSW1			; COMPILER STATUS WORD
.DW	CSW2			; Опции компилятора (окно COMPO, Beta)
.DW	CSW3			; Опции компилятора (окно COMPO, Beta)
.DW	FSW1			; FIND STATUS WORDS
.DW	FSW2			; Пространство (в коде не используется)
.DW	FSW3			; Начать: 0 сверху, 1 снизу, 2 от курсора
.DW	FSW4			; Флажки: 1 РУС/ЛАТ, 2 ВР/НР, 4 слово
.DW	PSW1			; Экран: 0 - 4 цвета, 1 - 8 цветов
.DW	PSW2			; Автозапись: бит 1 - текст, 2 - установки
.DW	PSW3			; Отладка: 0 - включена, 1 - выключена
.DW	PSW4			; Объектный код: 0 - память, 1 - файл

.DW	FDBUF	40.		; Образец поиска



ENDPP	==Count


.End
