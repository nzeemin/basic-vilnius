
;------------------------------------------------------------------------------
; PPIO - выполнение запросов IDE (ПП) в Бейсике (ЦП), модуль Basic.Sav.
; Запрос (IDE.MAC, $$DSCL): ПП заносит в память ЦП 7 слов, начиная с PCOD:
; байт PCOD - код запроса, байт PREADY = 377 ("ЦП занят"), PNAME - имя файла
; (4 слова RAD50), PBLOCK - блок, PLEN - длина, PERR. Затем берёт из вектора
; 104 ЦП адрес INT104 (его ставит IOINI), подставляет в вектор 24 и прерывает
; ЦП через 177716 (слово 26 = 0 - приоритет 0). INT104 по JTAB вызывает
; процедуру запроса; она кончается JMP CPEND: PREADY := 0, ЦП ждёт (BR .).
; ПП ждёт PREADY = 0 и читает PERR: 0 - успех, 1 - ошибка RT-11 (RT1E), иначе
; номер ошибки Бейсика (ERMSG.MAC; 376 восьм. = 254 "СТОП"); в PTEST PERR+1
; - признак маски. Данные идут через область TEXT, ПП читает и пишет её окном
; 177010/177014. Файлы - EMT RT-11 по каналу CHAN, ошибки .SERR - в бит C.
; Коды запросов (десятичные, JTAB): 0 POPEN, 1 PCLOSE, 2 PREAD, 3 PCREAT, 4
; PWRITE, 5 PSWAP, 6 PUNSWP, 7 PCOMP, 8 PRUN, 9 PCSIOP, 10 PCSICR, 11 PCSCRN,
; 12 PGETFT, 13 PTEST, 14 PEXIT, 15 PPRINT, 16 PPrgRs, 17 PLdTbo (в IDE и
; UPEXEC встречаются и восьмеричные: #15 = 13).
; Результат .CSISPC (BUF+120): 15 слов выходных спецификаций, затем входные по
; 4 слова (по RT-11): BUF+156 - первая входная. R3 (расширения) не задаётся
; перед CSI в PCOMP, PCSIOP, PCSICR, PCSCRN (только в LdObj).
; Компиляция (PCOMP): строки ЦП берёт у ПП: пишет CPCD = 10001 и ждёт, пока ПП
; (Comp.H в IDE.MAC) положит строку в BUF и обнулит CPCD; ^Z - конец текста.
; Не используются в исходниках Turbo: UBRUK, APUSH, APOP, DEVIC.
;------------------------------------------------------------------------------
; new input/output module for basic
; this unit handle IO operations of IDE

;------------------------------------------------------------------------------
; [НОВОЕ] модуль почти целиком: в Бейсике Вильнюс 1988 аналога нет; ниже
;     отмечены только блоки, найденные в 1988
;------------------------------------------------------------------------------

.Inclu	/GenUkd.mac/		; Настройки сборки (GENUKD.MAC)

.TITLE	PPIO			; Заголовок листинга

.MCALL	.SERR .LOOKUP .CLOSE .ENTER .WRITW .READW .DELETE .CSISPC	; RT-11
.MCALL	.PUSH .POP .RENAME .PURGE	; Макрокоманды RT-11
CHAN	= 15			; Канал RT-11 для файлов IDE (восьм. 15)

.MACRO	PUSH	ARG,R=SP	; Локальные PUSH/POP со своим регистром стека
	.IRP	A,<ARG>
	MOV	A,-(R)		; Занести в стек
	.ENDR
.ENDM

.MACRO	POP	ARG,R=SP
	.IRP	A,<ARG>
	MOV	(R)+,A		; Взять из стека
	.ENDR
.ENDM	
	.PSECT	BASIC		; Секция кода Бейсика

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: IOINI. новое: ставит вектор 104 (INT104)
;     для запросов IDE.
;------------------------------------------------------------------------------
IOINI::	MOV	#INT104,@#104	; Вектор 104: обработчик запросов IDE
	CLR	@#26		; PSW вектора 24 = 0 (по нему ПП вызывает ЦП)
	.SERR			; Ошибки RT-11 - в бит C, без аварийного выхода
	MOV	#DEFALT,R0	; R0 -> имя файла по умолчанию
	MOV	#DM,R1		; R1 -> "DK:*.BAS"
1$:	MOVB	(R1)+,(R0)+	; Копировать
	BNE	1$		; до нуль-байта
	Call	ClrCod		; Очистить программу и таблицы
	
	RETURN			; Выход

	
;------------------------------------------------------------------------------
; UBRUK - ошибка "СТОП" (в исходниках не вызывается)
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: UBRUK. ошибка «СТОП» (в исходниках не
;     вызывается); в 1988 BREAK обрабатывали BRUK/BREAKD в IO.MAC, здесь BREAK
;     ведёт IDE.
;------------------------------------------------------------------------------
UBRUK::
	MOV	#376,PERR	; Код ошибки 376 (восьм.): "СТОП"
	JMP	CPEND		; Конец запроса
	



;------------------------------------------------------------------------------
; INT104 - вход запроса IDE (вектор 104). В прерванный код возврата нет:
; стек сбрасывается, запрос кончается через CPEND.
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: INT104, JTAB (блоков: 2). новое: вход
;     запроса IDE; сбрасывает стек, вызывает VRES и переходит по JTAB.
;------------------------------------------------------------------------------
INT104::
	MOV	#1000,SP	; Чистый стек: в прерванный код не вернёмся
	CALL	VRES		; Вектора для работы Бейсика
	MOVB	PCOD,%0		; R0 = код запроса
	ASL	%0		; R0 = смещение в JTAB
	CLR	PERR		; Ошибки нет
	JMP	@JTAB(%0)	; На процедуру запроса


;------------------------------------------------------------------------------
; JTAB - процедуры запросов по коду PCOD (список кодов - в шапке модуля)
;------------------------------------------------------------------------------
JTAB:	.WORD	POPEN,PCLOSE,PREAD,PCREATE,PWRITE,PSWAP,PUNSWP,PCOMP
	.WORD	PRUN,PCSIOP,PCSICR,PCSCRN,PGETFT,PTEST,PEXIT,PPRINT
	.Word	PPrgRs,PLdTBO

;	16.
;------------------------------------------------------------------------------
; PPrgRs (16) - сброс программы: файлы закрыть, типы по умолчанию, CLEAR
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: PprgRs. запрос 16 - сброс программы.
;------------------------------------------------------------------------------
PprgRs:
	Call	CloAll		; Закрыть все файлы
	Call	Vres		; Вектора для работы Бейсика
	Mov	#Aprl,r0	; R0 -> таблица типов переменных
	Mov	#15,r1		; Число слов (восьм. 15)
1$:	Mov	#1002,(r0)+	; Тип по умолчанию (как в MONIT:START)
	Sob	r1,1$		; Для всех
	Mov	First,Last	; Очистить буфер клавиатуры
	Jsr	r4,Stand	; Выполнить шитый код:
	.Word	Iconst		; Целое на стек:
	.Word	200.		; 200. - размер области строк
	.Word	ClrStr		; Очистить память (как CLEAR)
	.Word	CpEnd		; Конец запроса



;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: POPEN, PCLOSE, PREAD, PCREAT, PWRITE
;     (блоков: 5). запросы 0-4 (открыть, закрыть, читать, создать, писать): EMT
;     RT-11 по каналу 13; в 1988 файлы открывал DISK.MAC по требованию
;     программы.
;------------------------------------------------------------------------------
POPEN:						; ОТКРЫТЬ ФАЙЛ ДЛЯ ЧТЕНИЯ (0)
	.LOOKUP	#AREA,#CHAN,#PNAME	; Открыть файл PNAME
	BCS	RT1E		; ошибка =>
	MOV	R0,@#PLEN	; PLEN = длина файла в блоках
	JMP	CPEND		; Конец запроса


PCLOSE:						; ЗАКРЫТЬ ФАЙЛ		  (1)
	.CLOSE	#CHAN		; Закрыть канал
	BCS	RT1E		; ошибка =>
	JMP	CPEND		; Конец запроса


PREAD:						; СЧИТАТЬ ДАННЫЕ	  (2)
	.READW	#AREA,#CHAN,#TEXT,@#PLEN,@#PBLOCK	; PLEN слов -> TEXT
	BCS	RT1E		; ошибка =>
	JMP	CPEND		; Конец запроса
	

PCREAT:						; СОЗДАТЬ ФАЙЛ		  (3)
	.ENTER	#AREA,#CHAN,#PNAME,#-1	; Создать файл PNAME (-1: любой размер)
	BCS	RT1E		; ошибка =>
	JMP	CPEND		; Конец запроса

PWRITE:						; ЗАПИСАТЬ ДАННЫЕ	  (4)
	.WRITW	#AREA,#CHAN,#TEXT,@#PLEN,@#PBLOCK	; TEXT -> PLEN слов
	BCS	RT1E		; ошибка =>
	JMP	CPEND		; Конец запроса


;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: PSWAP, RT1E, PUNSWP (блоков: 3). запросы
;     5/6: область TEXT в файл подкачки DK:TBASIC.SWP и обратно (режим 8 цветов
;     - место под экран); в 1988 нет.
;------------------------------------------------------------------------------
PSWAP:						; ОБМЕН ОБЛАСТЬ           (5)
	.ENTER	#AREA,#CHAN,#NTMP,#-1	; Создать файл подкачки DK:TBASIC.SWP
	.WRITW	#AREA,#CHAN,#TEXT,#512.*10.,#0	; 5120 слов из TEXT
	BCS	RT1E		; ошибка записи (.ENTER не проверяется) =>
	JMP	PCLOSE		; Закрыть файл, конец запроса

RT1E:	MOV	#1,PERR		; Код ошибки 1: ошибка RT-11
	.PURGE	#CHAN		; Освободить канал
	JMP	CPEND		; Конец запроса


PUNSWP:						; ВОССТАНОВЛЕНИЕ ОБЛАСТИ  (6)  
	.LOOKUP	#AREA,#CHAN,#NTMP	; Открыть файл подкачки
	.READW	#AREA,#CHAN,#TEXT,#512.*10.,#0	; Прочитать 5120 слов в TEXT
	.DELETE	#AREA,#CHAN,#NTMP	; Удалить файл подкачки
	BCS	RT1E		; ошибка (только .DELETE) =>
	JMP	CPEND		; Конец запроса

;------------------------------------------------------------------------------
; CSI - разобрать командную строку RT-11 из BUF (.CSISPC); C = 1 - ошибка
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: CSI, PCSIOP, PCSICR, $E, PCSCRN (блоков:
;     5). разбор командной строки .CSISPC и запросы 9-11 (открыть, создать,
;     создать с BAK) - вместо .CSIGEN в DISK.MAC 1988.
;------------------------------------------------------------------------------
CSI:	
	MOV	SP,R5		; Запомнить SP (.CSISPC кладёт ключи в стек)
	.CSISPC	#BUF+120,R3,#BUF	; BUF -> BUF+120, R3 - расширения
	MOV	R5,SP		; Снять ключи со стека
	RETURN			; Выход: C = 1 - ошибка



;------------------------------------------------------------------------------
; PCSIOP (9) - разобрать имя и открыть файл на чтение; PCSICR (10) - на
; создание; PCSCRN (11) - то же, старый файл переименовать в *.BAK
;------------------------------------------------------------------------------
PCSIOP:						;			  (9)
	CALL	CSI		; Разобрать имя из BUF
	BCS	RT1E		; ошибка =>
	.LOOKUP	#AREA,#CHAN,#BUF+156	; Открыть первый входной файл
	BCS	RT1E		; ошибка =>
	MOV	R0,@#PLEN	; PLEN = длина файла в блоках
	JMP	CPEND		; Конец запроса


	
PCSICR:						;			 (10)
	CALL	CSI		; Разобрать имя из BUF
	BCS	RT1E		; ошибка =>
$E:	.ENTER	#AREA,#CHAN,#BUF+156,#-1	; -1: любой размер
	BCS	RT1E		; ошибка =>
	JMP	CPEND		; Конец запроса
PCSCRN:						;			 (11)			
	CALL	CSI		; Разобрать имя из BUF
	BCS	RT1E		; ошибка =>
	MOV	#BUF+156,R0	; R0 -> прежнее имя
	MOV	#BUF+166,R1	; R1 -> новое имя
	MOV	(R0)+,(R1)+	; Устройство
	MOV	(R0)+,(R1)+	; Имя, слово 1
	MOV	(R0)+,(R1)+	; Имя, слово 2
	MOV	(PC)+,(R1)+	; Расширение - слово за командой:
	.RAD50	/BAK/		; BAK
	.RENAME	#AREA,#CHAN,#BUF+156	; в *.BAK (ошибка не важна)
	BR	$E		; Создать новый файл





;------------------------------------------------------------------------------
; PCOMP (7) - компиляция. Имя исходного файла из BUF -> имя .TBO (TBONAM).
; Строки приходят по CPCD (см. шапку); метки собираются в таблицу LABTOP..FCB
; (запись из трёх слов, растёт вниз: состояние, адрес кода, номер строки;
; состояние <> 0 - есть неразрешённые ссылки, в нём номер строки ссылки).
; Ошибки компиляции - через TRAP в PERR. В конце: ENDPRG, STRMEM, TBOCre.
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: PCOMP. запрос 7: построчная компиляция
;     исходного текста от IDE (слово CPCD) через INSCMP в код и .TBO; в 1988
;     это делали цикл ввода MONIT и COMPIL.
;------------------------------------------------------------------------------
PCOMP:				; КОМПИЛЯЦИЯ ПРОГРАММЫ    (7)
	Call	Csi		; Разобрать имя исходного файла
	Mov	#Buf+156,r0	; R0 -> имя
	Mov	#TboNam,r1	; R1 -> имя .TBO
	Mov	(r0)+,(r1)+	; Устройство
	Mov	(r0)+,(r1)+	; Имя, слово 1
	Mov	(r0)+,(r1)+	; Имя, слово 2
	Mov	#^RTBO,(r1)+	; Расширение TBO

	CALL	VRES		; Вектора для работы Бейсика
	CLR	NUMBER		; Номер строки = 0
	MOV	FCB,TABTOP	; TABTOP = FCB (ниже уменьшается)
	SUB	#6*600.,TABTOP	; КРИВОЙ МЕТОД ОПРЕДЕЛЕНИЯ
				; РАЗМЕРА ТАБЛИЦЫ !!!!!
	MOV	FCB,LABTOP	; R0 - РЕАЛЬНЫЙ АДРЕС ВЕРШИНЫ ТАБЛИЦЫ ССЫЛОК
	CALL	CLRCOD		; ИНИЦИАЛИРОВАТЬ О.К.
	MOV	#DATBEG,DATPTR	; УКАЗАТЕЛЬ НАЧАЛА ТАБЛИЦ DATA
	MOV	#1,LYGIS	; УСТАНОВИТЬ РЕЖИМ РАБОТЫ
	MOV	#TEXT,R1	; АДРЕС НАЧАЛА О.K.



6$:	MOV	#10001,CPCD	; ЗАПРОС В ПП. НА ЧТЕНИЕ СТРОКИ ИСХОДНОГО Т.
1$:	TSTB	CPCD		; СТРОКУ ПРИСЛАЛИ
	BNE	1$		; НЕТ
	Tstb	DbgId		; Признак DbgId (отладка)
	Bne	18$		; не 0 => без номера строки в коде
	Mov	#D$Num,(r1)+	; В код: D$Num (запомнить номер строки)
	Mov	Number,(r1)+	; и сам номер

	
18$:	
	Mov	TabTop,MemAvl	; MemAvl = граница таблицы
	Sub	r1,MemAvl	; минус адрес кода = свободная память
	
	INC	NUMBER		; Следующий номер строки
	MOV	#BUF,R3		; КОМПИЛЯЦИЯ СТРОКИ
	CMPB	#32,(R3)	; КОНЕЦ ТЕКСТА ПРОГРАММЫ
	BEQ	7$		; ДА
	TRAP	112		; ПРОПУСК ПРОБЕЛОВ
	TRAP	110		; МЕТКА ЕСТЬ
	BR	9$		; НЕТ
	MOV	LABTOP,R0	; R0 -> вершина таблицы меток
	JSR	R1,TSTLAB	; ПРОВЕРКА ССЫЛОК НА МЕТКУ
	BR	10$		; ССЫЛОК НЕТУ.  
	TST	-4(R4)		; ДВОЙНОЕ ОПРЕДЕЛЕНИЕ МЕТКИ ?
	BNE	12$		; 
	TRAP	23.		; ДА. 
12$:	MOV	-(R4),R5	; ССЫЛКА НОМЕР 1
11$:	MOV	(R5),R2		; СПАСТИ АДРЕС СЛЕДУЮЩЕЙ ССЫЛКИ
	MOV	R1,(R5)		; ПОДСТАВИТЬ АДРЕС НА МЕСТО ССЫЛКИ
	MOV	R2,R5		; ВОСТАНОВИТЬ АДРЕС СЛЕД. ССЫЛКИ
	BNE	11$		; КОНЕЦ ССЫЛОК ? НЕТ.
	MOV	R1,(R4)		; ПОДСТАВИТЬ АДРЕС В ТАБЛИЦУ
	CLR	-(R4)		; ОТМЕНИТЬ ЗАПРОС НА МЕТКУ
	BR	9$		; Метка обработана





10$:	MOV	R5,-(R0)	; ЗАНЕТИ В ТАБЛИЦУ НОМЕР СТРОКИ
	MOV	R1,-(R0)	; АДРЕС ОБ'ЕКТНОГО КОДА СТРОКИ
	CLR	-(R0)		; ОПРЕДЕЛИТЬ СЛОВО СОСТОЯНИЯ МЕТКИ
	MOV	R0,LABTOP	; Новая вершина таблицы меток

9$:	CMPB	#12,(R3)	; СТРОКА ПУСТАЯ ?
	BEQ	6$		; ДА

3$:	CALL	INSCMP		; СКОМПИЛИРОВТЬ ИНСТРУКЦИИ
	CMPB	#12,(R3)	; КОНЕЦ СТРОКИ ?
	BEQ	6$		; ДА
4$:	CMPB	#'',(R3)	; КОММЕНТАРИЙ
	BEQ	6$		; ДА
	TRAP	2		; ЕСЛИ НЕТ, ТО ОШИБКА

				; УСПЕШНОЕ ЗАВЕРШЕНИЕ КОМПИЛЯЦИИ
7$:	
	MOV	LABTOP,R0	; R0 -> вершина таблицы меток
14$:	CMP	R0,FCB		; Таблица просмотрена?
	BHIS	13$		; да => ссылки все разрешены
	TST	(R0)+		; Слово состояния метки
	BNE	15$		; не 0 => ссылка не разрешена
	CMP	(R0)+,(R0)+	; Пропустить адрес и номер
	BR	14$		; Дальше
15$:	MOV	-2(R0),NUMBER	; NUMBER = номер строки со ссылкой
	TRAP	8.		; Ошибка 8: неопределённая метка




13$:	MOV	#ENDPRG,(R1)+	; ПОДСТАВИТЬ В КОНЕЦ СТОПОВУЮ ИНСТУКЦИЮ
	MOV	R1,ENDCOD	; АДРЕС ОКОНЧАНИЯ КОДА.
	MOV	DATBEG,DATPTR	; АДРЕС БЛОКА DATA
	CALL	STRMEM		; РАСПРЕДЕЛИТЬ ПАМЯТЬ
	Call	TBOCre		; Создать Object файл
	CLR	PERR		; ОЧИСТИТЬ ФЛАГ ОШИБКИ 
	JMP	CPEND		; ВЫЙТИ ИЗ ПРОЦЕССА.


;------------------------------------------------------------------------------
; Формат .TBO (TboCre, LdObj). Блок 0: слово 0 = TEXT, слово 1 = размер кода
; и таблиц в байтах, слово 2 = "BO", нули до смещения 400 (восьм.), затем 128
; слов системных переменных с адреса STACK (LYGIS...WHIMEM, DT.MAC). С блока 1:
; код (TEXT..ENDCOD) и за ним таблицы LENT..TABTOP. LdObj проверяет слово 0
; и WHIMEM (из файла не больше текущего), возвращает переменные и таблицы.
; PLdTbo (17) - запрос загрузки; C = 1 из LdObj - ошибка.
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: PLdTbo, LdObj, LdErr, DefTbo, TboCre,
;     TBONAM (блоков: 6). загрузка готового .TBO (LdObj, TboCre записывает); в
;     1988 не было.
;------------------------------------------------------------------------------
PLdTbo::
	Call	LdObj		; Загрузить .TBO
	Bcc	1$		; успех =>
	Mov	#1,PErr		; Код ошибки 1
1$:	Jmp	CpEnd		; Конец запроса


LdObj::	Mov	#DefTbo,R3	; R3 -> расширение по умолчанию TBO
	Call	CSI		; Разобрать имя
	.LookUp	#Area,#Chan,#Buf+156	; Открыть файл
	Bcs	LdErr		; ошибка =>
	.ReadW	#Area,#Chan,#BufFil,#400,#0	; блок 0 (заголовок) в BufFil
	Bcs	LdErr		; ошибка =>
	Cmp	BufFil,#Text	; Слово 0 заголовка = TEXT?
	Bne	LdErr		; нет => не .TBO
	Cmp	BufFil+WHIMEM-LYGIS+400,WHIMEM	; WHIMEM файла больше текущего?
	Bhi	LdErr		; да => не хватит памяти
	Mov	#BufFil+400,r0	; R0 -> сохранённые системные переменные
	Mov	#LYGIS,r1	; R1 -> LYGIS
	Mov	#200,r2		; Слов (восьм. 200 = 128)
1$:	Mov	(r0)+,(r1)+	; Восстановить системные переменные
	Sob	r2,1$		; Повторить
	Mov	BufFil+2,r1	; R1 = размер кода и таблиц в байтах
	Asr	r1		; В слова
	Mov	#Text,r0			;Небольшое мероприятие по
2$:	Clr	(r0)+				;очистке памяти
	Cmp	r0,TabTop	; до TabTop
	Blo	2$		; Повторить
	.ReadW	#Area,#Chan,#Text,r1,#1	; код и таблицы (блок 1) в TEXT
	Bcs	LdErr		; ошибка =>
	Mov	EndCod,r1	; R1 -> таблицы за кодом (ENDCOD)
	Mov	Lent,r2		; R2 -> LENT (их место)
3$:	Mov	(r1)+,(r2)+	; Вернуть таблицы на место
	Cmp	r2,TabTop	; до TabTop
	Blo	3$		; Повторить
	.Close	#Chan		; Закрыть канал
	Clc			; Успех: C = 0
	Return			; Выход

LdErr:	.Purge	#Chan		; Освободить канал
	Sec			; Ошибка: C = 1
	Return			; Выход

DefTbo:	.Rad50	/TBO/		; Расширение по умолчанию

TboCre::
	Tstb	TboId		; Создавать .TBO (признак TboId)?
	Beq	11$		; нет =>
	Mov	#BUFFIL,r0	;Буфер файла
	Mov	#Text,(r0)+	;Адрес начала
	Clr	(r0)+		; Слово 1 (размер) - позже
	Mov	#"BO,(r0)+	;Признак файла
2$:	Clrb	(r0)+		; Остаток первой половины блока - нули
	Cmp	r0,#BufFil+400	; до смещения 400 (восьм.)
	Bne	2$		; Повторить
	Mov	#Stack,r1	; R1 -> системные переменные (с STACK)
	Mov	#200,r2		; Слов (восьм. 200 = 128)
3$:	Mov	(r1)+,(r0)+	; Снимок переменных - во вторую половину
	Sob	r2,3$		; Повторить
	
	Mov	Lent,r2		; R2 -> LENT
	Mov	EndCod,r1	; R1 -> ENDCOD (за кодом)
4$:	Mov	(r2)+,(r1)+	; Дописать таблицы после кода
	Cmp	r2,TabTop	; до TabTop
	Blo	4$		; Повторить
	Sub	#Text,r1	; R1 = размер в байтах
	Mov	r1,BufFil+2	; В слово 1 заголовка
	Asr	r1		; В слова
	.Enter	#Area,#Chan,#TBONAM,#-1	; Создать файл TBONAM
	.WritW	#Area,#Chan,#BufFil,#400,#0	; Записать заголовок (блок 0)
	.WritW	#Area,#Chan,#Text,r1,#1	; Записать код и таблицы с блока 1
	Bcs	12$		; ошибка =>
	.Close	#Chan		; Закрыть файл
11$:	Return			; Выход

12$:	Trap	19.		; Ошибка 19: ввод/вывод

TBONAM:	.Blkw	4		; Имя .TBO: устройство, имя, TBO

;------------------------------------------------------------------------------
; CPEND - конец запроса: вектор 474 (дисковод) и его PSW восстановить, снять
; PREADY, ждать следующего прерывания ПП
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: CPEND. конец запроса: PREADY := 0 и
;     ожидание; в 1988 на этом месте был вывод OK и возврат в монитор.
;------------------------------------------------------------------------------
CPEND::				; ОКОНЧАНИЕ ВЫПОЛНЕНИЯ ПРОЦЕССОВ ЦП
	MOV	#1000,SP	; Чистый стек
	MOV	SAV474,@#474	; Востановить вектор дисковода
	MOV	#340,@#476	; PSW
	CLRB	PREADY		; Запрос выполнен (PREADY = 0)
	MTPS	#0		; Приоритет 0: прерывания разрешены
	BR	.		; Ждать следующего запроса от ПП
	



	
;------------------------------------------------------------------------------
; INSCMP - скомпилировать операторы строки до конца (разделитель ":").
; Ключевое слово ищет SEEKOP в дереве TABL.MAC, номер оператора * 2 в R5,
; не найден - R5 = 0 (LET); подпрограмма компиляции - из AOPSUB (COMP.MAC).
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: INSCMP. компиляция блока операторов
;     строки (IF ... THEN, метки); в 1988 оператор после THEN искали по
;     таблицам OPRNAM/AOPSUB (TRAP 113).
;------------------------------------------------------------------------------
INSCMP::			; КОМПИЛЯЦИЯ БЛОКА ОПЕРАТОРОВ

1$:
	TRAP	112		; ПРОПУСК ПЕРВЫХ ПРОБЕЛОВ
	JSR	R0,SEEKOP	; ОПРЕДЕЛИТЬ КОД ОПЕРАТОРА
	.WORD	L0000 / 2 ! 100000	; Корень таблицы операторов
	.WORD	2		; Параметр SEEK: мин. длина совпадения
	CLR	R5		; НЕ ОПОЗНАНЫЙ ОПЕРАТОР
	CALL	@AOPSUB(R5)	; КОМПИЛЯЦИЯ ОДНОГО ОПЕРАТОРА
	TRAP	112		; ПРОПУСТИТЬ ПРОБЕЛЫ
	CMPB	#':,(R3)+	; ЕЩЕ ОПЕРАТОРЫ ЕСТЬ ?
	BEQ	1$		; ДА.
	DEC	R3		; 
	RETURN			; Выход

;------------------------------------------------------------------------------
; TSTLAB - есть ли метка R5 в таблице (R0 - вершина). Вызов JSR R1,TSTLAB;
; BR <нет>. Найдена - возврат с пропуском BR, R4 -> номер метки.
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: TSTLAB. таблица меток LABTOP вместо
;     цепочки ссылок на строки в служебном слове (1988).
;------------------------------------------------------------------------------
TSTLAB::MOV	FCB,R4		; ПРОЦЕДУРА ОПРЕДЕЛЯЕТ НАЛИЧИЕ
1$:	CMP	R4,R0		; В ТАБЛИЦЕ ССЫЛОК НАЛИЧИЕ МЕТКИ
	BLOS	3$		; ВОЗВРАТ
	CMP	-(R4),R5	; .   МЕТКИ НЕТУ
	BEQ	2$		; .+2 МЕТКА ЕСТЬ
	CMP	-(R4),-(R4)	; Пропустить адрес и состояние
	BR	1$		; Дальше

2$:	TST	(R1)+		; Есть: пропустить команду за JSR
3$:	RTS	R1		; Выход (R4 -> номер найденной метки)


;------------------------------------------------------------------------------
; PRUN (8) - запуск скомпилированной программы с TEXT
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: PRUN. запрос 8: запуск программы; в 1988
;     команда RUN монитора.
;------------------------------------------------------------------------------
PRUN::	
	CALL	CLOALL		; Закрыть все файлы
	CLR	LYGIS		; Режим: выполнение (LYGIS = 0)
	CALL	VRES		; Вектора для работы Бейсика
	Call	ScrRes		; Экран в начальное состояние
	Call	CurOff		; Выключить курсор
	Clr	ApdId		; Не дописывать в файл
	MOV	#TEXT,R4	; R4 -> код программы
	JMP	@(R4)+		; Выполнить

;------------------------------------------------------------------------------
; VRES - вектора для работы Бейсика: таймер (100) на RTI в ячейке 76,
; клавиатура на IVS
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: VRES. вектора Бейсика на время выполнения
;     (таймер 100 на RTI, клавиатура IVS); в 1988 их ставил SETW/BRUK.
;------------------------------------------------------------------------------
VRES::
	MOV	#2,@#76		; Слово 2 = команда RTI (000002)
	MOV	#76,@#100	; Вектор 100 (таймер) -> RTI
	MOV	#IVS,@#AVPK	; Вектор клавиатуры -> IVS
	MOV	#100,@#ARSK	; Разрешить прерывания клавиатуры
	RETURN			; Выход
	


;------------------------------------------------------------------------------
; PPRINT (15) - вычисление для IDE: присваивания (поле BUF+60.) и вывод
; выражения (поле BUF) через LPRINT компилируются в TEXT и выполняются.
; Куда уходит вывод (IODEV = -1, принтер) и как поля связаны с диалогом
; EVLMDD, не выяснено до конца.
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: PPRINT. запрос 15: вычисление выражений
;     для окна Evaluate/Modify (присваивания из BUF+60., вывод выражения); в
;     1988 - прямой режим PRINT в мониторе.
;------------------------------------------------------------------------------
PPRINT::
	Call	Vres		; Вектора для работы Бейсика
	MOV	#BUF+60.,R3	; R3 -> поле присваиваний (BUF + 60.)
	MOV	#TEXT,R1	; R1 -> место для кода
	Trap	112		; Пропуск пробелов
	Cmp	r3,#Buf+97.	; Поле пусто (пропущено)?
	Bhi	2$		; да => только вычисление

1$:	Trap	112		; Пропуск пробелов
	Call	Let		; Скомпилировать присваивание
	Trap	112		; Пропуск пробелов
	Cmpb	#':,(r3)+	; За ним ":"?
	Beq	1$		; да => ещё присваивание
	Cmp	r3,#Buf+97.	; Конец поля?
	Bhi	3$		; да =>
7$:	Trap	2		; Ошибка 2: синтаксис
3$:	Mov	#2$,(r1)+	; В код: адрес 2$ (продолжить при выполнении)
	Mov	#Text,r4	; R4 -> код
	Jmp	@(r4)+		; Выполнить присваивания

2$:	
	Mov	#Buf,r3		; R3 -> поле выражения (BUF)
	Mov	#Text,r1	; R1 -> код
	CALL	LPRINT		; Скомпилировать вывод выражения (LPRINT)
	Trap	112		; Пропуск пробелов
	Cmp	r3,#Buf+37.	; Конец поля?
	Blos	7$		; нет => ошибка
	MOV	#CpEnd,(R1)+	; В код: конец запроса
	Clr	LplCfl		; Признак русского регистра принтера = 0
	Clr	LptPos		; Позиция головки принтера = 0
	MOV	#TEXT,R4	; R4 -> код
	JMP	@(R4)+		; Выполнить
	









;------------------------------------------------------------------------------
; PTEST (13) - разобрать и достроить имя файла в BUF: устройство, имя и
; расширение берутся из BUF, недостающее - из DEFALT (DK:*.BAS)
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: PTEST, FTEST, COP ... CPY (блоков: 9).
;     запрос 13: разбор и достройка имени dev:name.ext по таблицам DSEEK
;     (FTEST, COP, FT1, CPY); в 1988 имя разбирал .CSIGEN.
;------------------------------------------------------------------------------
PTEST:				; СИНТАКСИЧЕСКИЙ АНАЛИЗАТОР ИМЕНИ ФАЙЛА
	MOV	#DEFALT,R4	; КОМПОНЕНТЫ ИМЕНИ ФАЙЛА ПО УМОЛЧАНИЮ 
	MOV	#BUF,R5		; ИМЯ ФАЙЛА
	CALL	FTEST		; ВЫЗОВ АНАЛИЗАТОРА
	MOVB	MASKID,PERR+1	; ПРИЗНАК НАЛИЧАИЯ МАСКИ
	BCC	2$		; ОШИБКА В ИМЕНИ ФАЙЛА ?
	INC	PERR		; ДА, ПОЖАЛУЕМСЯ ПП.
2$:	JMP	CPEND		; Конец запроса
	
	



;------------------------------------------------------------------------------
; FTEST - разобрать имя R5 по умолчаниям R4 и собрать в R5
;------------------------------------------------------------------------------
FTEST:
	PUSH	R5		; СОХРАНИТЬ УКАЗАТЕЛЬ НА ИМЯ ФАЙЛА
	MOV	R4,R5		; ВЫЗВАТЬ ПРОЦЕДУРУ С ИМЕНЕМ ПО УМОЛЧАНИЮ
	CALL	FT1		; 
	MOV	(SP),R5		; ВОСТАНОВИТЬ УКАЗАТЕЬ НА И.Ф.
1$:	CMPB	#40,(R5)+	; Пропустить пробелы в начале имени
	DEC	R5		; Вернуть указатель
	BEQ	1$		; пробел => дальше
	
	
	
	
	CLR	MASKID		; ОЧИСТИТЬ ПРИЗНАК МАСКИ
	CALL	FT1		; ВЫЗВАТЬ ПРОЦЕДУРУ С ИМЕНЕМ ФАЙЛА ИЗ ПП.
	POP	R5		; 
	BCS	20$		; ОШИБКА БЫЛА ?
	JSR	R1,COP		; СКОПИРОВАТЬ ИМЯ УСТРОЙСТВА
	.WORD	DEVNAM,':	; Буфер и разделитель ":"
	JSR	R1,COP		; СКОПИРОВАТЬ ИМЯ ФАЙЛА
	.WORD	FLENAM,'.	; Буфер и разделитель "."
	JSR	R1,COP		; СКОПИРОВАТЬ РАСШИРЕНИЕ
	.WORD	EXTNAM,0	; Буфер, без разделителя

20$:	RETURN			; ВЫЙТИ
	

;------------------------------------------------------------------------------
; COP - копировать строку (R1 -> слово: адрес) в R5 с признаком маски,
; нуль заменить байтом за словом адреса
;------------------------------------------------------------------------------
COP:				; КОПИРОВАНИЕ ИМЕН, И РАСПОЗНАВАНИЕ МАСКИ
	MOV	(R1)+,R0	; R0 -> копируемая строка
1$:	CMPB	#'*,(R0)	; Символ маски "*"?
	BEQ	2$		; да =>
	CMPB	#'%,(R0)	; Символ маски "%"?
	BNE	3$		; нет =>
2$:	MOVB	#1,MASKID	; Признак маски

3$:	MOVB	(R0)+,(R5)+	; Копировать символ
	BNE	1$		; до нуль-байта
	MOVB	(R1)+,-1(R5)	; Нуль заменить разделителем
	INC	R1		; Пропустить старший байт слова
	RTS	R1		; Выход
	
	
	
	
;------------------------------------------------------------------------------
; FT1 - разобрать имя R5 по таблицам DSEEK (запись: разделитель, процедура
; копирования компонента, следующая таблица)
;------------------------------------------------------------------------------
FT1:	MOV	#DSEEK,CURTAB	; УСТАНОВИТЬ УКАЗАТЕЛЬ НА ТАБЛИЦУ ПОИСКА УСРОЙСТВА
	MOV	R5,R3		; УКАЗАТЕЛЬ 1 НА ИМЯ ФАЙЛА
	MOV	R5,R2		; УКАЗАТЕЛЬ 2 НА ИМЯ ФАЙЛА
	
	
10$:	MOV	CURTAB,R1	; R1 - АДРЕС ТЕКУЩЕЙ ТАБЛИЦЫ
	BEQ	EXIT		; ЕСЛИ НОЛЬ, ТО ВСЕ ТАБЛИЦЫ ОТРАБОТАЛИ
	
1$:	CMPB	(R1),@R3	; СЛЕДУЮЩИЙ СИМВОЛ СОВПАДАЕТ С ТАБЛИЧНЫМ РАЗДЕЛИТЕЛЕМ
	BEQ	3$		; ДА - ПЕРЕХОД
	TSTB	@R1		; КОНЕЦ ТАБЛИЦЫ ДОСТИГНУТ
	BEQ	2$		; ДА - ПЕРЕХОД
	ADD	#6,R1		; ИНАЧЕ - СЛЕДУЮЩИЙ ЭЛЕМЕНТ ТАБЛИЦЫ
	BR	1$		; Следующий элемент

2$:	INC	R3		; ПЕРЕХОД НА СЛЕДУЮЩИЙ СИМВОЛ ИМЕНИ 
	BR	10$		; Продолжить
	

				; ТАБЛИЧНЫЙ РАЗДЕЛИТЕЛЬ НАЙДЕН
3$:	MOV	4(R1),CURTAB	; ЗАГРУЗКА ИЗ ТАБЛИЦЫ АДРЕСА СЛЕДУЮЩЕЙ ТАБЛИЦЫ
	CALL	@2(R1)		; ПЕРЕХОД НА ПРОЦЕДУРУ КОПИРОВАНИЯ КОМПОНЕНТЫ
	BCC	10$		; НЕТ ОШИБКИ - ПРОДОЛЖАТЬ
	

EXIT:	RETURN			; Выход (C = 1 - ошибка)


DEVCPY:	JSR	%1,CPY		; КОПИРОВАНИЕ ИМЕНИ УСТРОЙСТВА В ПРОМЕЖУТОЧНЫЙ БУФЕР
	.WORD	DEVNAM		; АДРЕС БУФЕРА
	.WORD	3		; МАКСИМАЛЬНОЕ ЧИСЛО СИМВОЛОВ В ИМЕНИ = 3
	RETURN			; Выход
	
FNCPY:				; Не более 6 символов
	JSR	%1,CPY		; КОПИРОВАНИЕ ИМЕНИ ФАЙЛА
	.WORD	FLENAM		; Буфер имени
	.WORD	6		; Максимум символов
	RETURN			; Выход
	
EXTCPY:
	JSR	%1,CPY		; КОПИРОВАНИЕ РАСШИРЕНИЯ 
	.WORD	EXTNAM		; Буфер расширения
	.WORD	3		; Максимум символов
	RETURN			; Выход


;------------------------------------------------------------------------------
; CPY - скопировать компонент имени (R2..R3) в буфер: JSR R1,CPY; слова -
; буфер, максимум символов. Допустимы цифры, буквы, "*", "%". C = 1 - ошибка.
;------------------------------------------------------------------------------
CPY:				; ВНУТРЯНЯ ПРОЦЕДУРА КОПИРОВАНИЯ В БУФЕР
	MOV	(R1)+,R0	; R0 -> буфер
	MOV	R3,R5		; R5 = конец компонента
	MOV	R2,R4		; R4 -> начало компонента
	SUB	R4,R5		; R5 = длина компонента
	CMP	(R1)+,R5	; Больше допустимой?
	BLO	ERROR		; да => ошибка (C = 1)
	TST	R5		; Пустой?
	BEQ	2$		; да => буфер не менять
1$:	CMPB	#'*,(R4)	; Символ "*"?
	BEQ	5$		; да => копировать
3$:	CMPB	#'%,(R4)	; Символ "%"?
	BEQ	5$		; да => копировать
	CMPB	(R4),#'0	; Меньше "0"?
	BLO	ERROR		; да => ошибка
	CMPB	(R4),#'9	; Цифра?
	BLOS	5$		; да => копировать
	BICB	#40,(R4)	; В верхний регистр
	CMPB	(R4),#'A	; Меньше "A"?
	BLO	ERROR		; да => ошибка
	CMPB	#'Z,(R4)	; Больше "Z"?
	BLO	ERROR		; да => ошибка
5$:	MOVB	(R4)+,(R0)+	; Копировать символ
	SOB	R5,1$		; Все символы
	CLRB	(R0)+		; Конец строки
2$:	INC	R3		; Пропустить разделитель
	MOV	R3,R2		; Начало следующего компонента

;------------------------------------------------------------------------------
; [1988=] без изменений (GRAFUK.MAC:1576-1577): ERROR
;------------------------------------------------------------------------------
ERROR:	RTS	R1		; Выход









;------------------------------------------------------------------------------
; PGETFT (12) - список файлов по маске из BUF: записи по 16 байт в TEXT
; (имя.расш, нули, длина в блоках), конец - слово 0. Каталог читается
; сегментами с блока 6 прямо с устройства.
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: PGETFT, FNCMP (блоков: 2). запрос 12:
;     список файлов по маске для диалога IDE (каталог читается с блока 6, маска
;     % и * - FNCMP); в 1988 чтение каталога было в DISK.MAC (F4$-F13$, RASC),
;     здесь написано заново.
;------------------------------------------------------------------------------
PGETFT:
	
	MOV	#BUF,R5		; R5 -> имя из IDE
	MOV	#FLMASK,R4	; R4 -> буфер маски
11$:	MOVB	(R5)+,(R4)+	; Копировать устройство
	CMPB	#':,-1(R4)	; до ":"
	BNE	11$		; Повторить
	CLRB	(R4)+		; Конец строки "DK:"
	
	MOV	SP,R4		; Запомнить SP (ключи .CSISPC)
	.CSISPC	#BUF+120,#DEVEXT,#FLMASK	; Разобрать устройство
	MOV	R4,SP		; Снять ключи со стека
	MOV	#FLMASK,R4	; R4 -> буфер маски
12$:	MOVB	(R5)+,(R4)+	; Дописать имя и расширение (маску)
	BNE	12$		; до нуль-байта
	
	
	
	MOV	#TEXT,R1	; R1 -> список файлов в TEXT
	MOV	#1,R5		; Сегмент каталога 1
1$:	CALL	20$		; Прочитать сегмент R5
	MOV	#DBUF+12,R0	; R0 -> первая запись
2$:	BIT	#2000,(R0)	; Постоянный файл?
	BNE	4$		; да => обработать
	BIT	#4000,(R0)	; Конец сегмента?
	BNE	3$		; да =>
	ADD	#16,R0		; Следующая запись (14 байт)
	BR	2$		; Дальше
3$:	MOV	@#DBUF+2,R5	; Номер следующего сегмента
	BEQ	9$		; нет => конец списка
	BR	1$		; Читать его
4$:	TST	(R0)+		; Пропустить слово состояния
	MOV	R1,R2		; R2 -> запись списка
	MOV	#10,R5		; Слов в записи (восьм. 10)
41$:	CLR	(R2)+		; Очистить запись
	SOB	R5,41$		; Повторить
	PUSH	R1		; Запомнить начало записи
	ADD	#3,R1		; R1 -> конец первой части
	MOV	#3,R2		; Слов RAD50: имя 2, расширение 1
5$:	MOV	(R0)+,R5	; Слово RAD50
	MOV	#3,R3		; Три символа
6$:	CLR	R4		; R4 = 0
	DIV	#50,R4		; Последний символ (деление на 50 восьм.)
	MOVB	RTAB(R5),-(R1)	; Символ в запись (справа налево)
	MOV	R4,R5		; Остаток слова
	SOB	R3,6$		; Все символы слова
	ADD	#6,R1		; К следующей части
	CMP	R2,#2		; Вторая часть имени?
	BNE	8$		; нет =>
	SUB	#3,R1		; R1 -> конец имени
7$:	CMPB	-(R1),#40	; Убрать пробелы в конце имени
	BEQ	7$		; Дальше
	INC	R1		; R1 -> после имени
	MOVB	#'.,(R1)+	; Точка
	ADD	#3,R1		; R1 -> место расширения
8$:	SOB	R2,5$		; Все три слова
	MOV	(SP),R2		; R2 -> начало записи
	ADD	#16,R2		; R2 -> слово длины (запись 16 байт)
	SUB	#3,R1		; R1 -> после расширения
14$:	CLRB	(R1)+		; Дополнить запись нулями
	CMP	R1,R2		; до слова длины
	BLOS	14$		; Повторить
	
	MOV	(R0)+,(R2)	; Длина файла в блоках - в запись
	
	MOV	(SP),R1		; R1 -> имя в записи
	PUSH	R0		; Запомнить R0
	MOV	#FLMASK,R0	; R0 -> маска
	CALL	FNCMP		; Имя подходит под маску?
	POP	R0		; Вернуть R0
	POP	R1		; R1 -> начало записи
	BCS	10$		; нет => запись не нужна
	ADD	#20,R1		; К следующей записи (16 байт)
	
10$:	ADD	#4,R0		; Пропустить остаток записи каталога
	BR	2$		; Дальше

9$:	CLR	(R1)+		; Конец списка
	JMP	CPEND		; Конец запроса


20$:	ASL	R5		; Номер сегмента * 2
	CMP	(R5)+,(R5)+	; Плюс 4: блок сегмента (с блока 6)
	.LOOKUP	#AREA,#CHAN,#BUF+156	; Открыть устройство
	.READW	#AREA,#CHAN,#DBUF,#1000,R5	; сегмент (2 блока) в DBUF
	BCC	21$		; успех =>
	JMP	RT1E		; Ошибка RT-11
21$:	.CLOSE	#CHAN		; Закрыть канал
	RETURN			; Выход


;------------------------------------------------------------------------------
; FNCMP - имя (R1) подходит под маску (R0)? "%" - любой символ, "*" - любая
; строка. C = 0 - да.
;------------------------------------------------------------------------------
FNCMP::	
	PUSH	R0		; Запомнить маску
	PUSH	R1		; и имя
1$:	TSTB	(R0)		; Конец маски?
	BNE	2$		; нет =>
	TSTB	(R1)		; Конец имени?
	BEQ	7$		; да => совпало
	BR	6$		; нет => не совпало
2$:	CMPB	#'%,(R0)+	; Символ "%"?
	BNE	3$		; нет =>
	TSTB	(R1)+		; Любой один символ (имя не кончилось?)
	BEQ	6$		; кончилось => не совпало
	BR	1$		; Дальше
3$:	CMPB	#'*,-(R0)	; Символ "*"?
	BNE	5$		; нет => обычный символ
	INC	R0		; Пропустить "*"
	TSTB	(R0)		; Маска кончилась?
	BEQ	7$		; да => совпало
4$:	CALL	FNCMP		; Остаток маски совпадает с остатком имени?
	BCC	7$		; да =>
	TSTB	(R1)+		; Сдвинуть имя на символ
	BEQ	6$		; кончилось => не совпало
	BR	4$		; Повторить
5$:	CMPB	(R0)+,(R1)+	; Символы равны?
	BEQ	1$		; да => дальше
6$:	SEC			; Не совпало: C = 1
7$:	POP	R1		; Вернуть имя
	POP	R0		; и маску
	RETURN			; Выход (C = 0 - совпало)
	

;------------------------------------------------------------------------------
; PEXIT (14) - выход из Бейсика
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: PEXIT. запрос 14: выход.
;------------------------------------------------------------------------------
PEXIT:
	JMP	ADDRMN		; Выход из Бейсика в RT-11 (MONIT)
	



;------------------------------------------------------------------------------
; APUSH / APOP - сохранить / вернуть регистры (JSR R5,...). Порядок APOP не
; обратный APUSH: значения регистров меняются местами. Не используются.
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [1988~71%] изменено, JMP.MAC:964-969: APUSH (1988: 6 строк кода, здесь 7;
;     добавлено/изменено 2, удалено 1). Отличия: APUSH/APOP (стек разбора
;     выражений) - из JMP.MAC 1988 (83% совпало), в Турбо не вызываются.
;------------------------------------------------------------------------------
APUSH::	MOV	R4,-(SP)	; Сохранить R4
	MOV	R3,-(SP)	; R3
	MOV	R2,-(SP)	; R2
	MOV	R1,-(SP)	; R1
	MOV	R0,-(SP)	; R0
	MOV	R5,PC		; Вернуться по адресу из R5

APOP::	MOV	R5,1$		; Адрес возврата - в ячейку 1$
	TST	(SP)+		; Снять слово от JSR R5
	MOV	(SP)+,R5	; R5 := значение R0 (порядок не обратный!)
	MOV	(SP)+,R4	; R4 := значение R1
	MOV	(SP)+,R3	; R3 := значение R2
	MOV	(SP)+,R2	; R2 := значение R3
	MOV	(SP)+,R1	; R1 := значение R4
	MOV	(SP)+,R0	; R0 := прежний R5
	JMP	@(PC)+		; Вернуться по запомненному адресу
1$:	.BLKW	1		; Адрес возврата


;------------------------------------------------------------------------------
; SEEKOP / SEEK - поиск ключевого слова в тексте R3. После JSR R0 два слова:
; корень таблицы (адрес / 2 + 100000) и параметр - минимальная длина слова,
; принимаемого при несовпадении хвоста (смысл не выяснен до конца); за ними
; одна пропускаемая при успехе команда. Таблицы - TABL.MAC: корень из 32
; слов по букве, узлы (буква, смещение) и хвосты (код слова, остаток,
; конец 40 или 200). Найдено: R5 = код * 2. SEEKOP сначала проверяет "?" и
; апостроф.
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: SEEKOP, SEEK, NEXT.C ... DM (блоков: 19).
;     поиск ключевого слова по деревьям TABL.MAC вместо TRAP 113 по спискам
;     OPRNAM/AOPNAM/FUN (линейный перебор, 1988); CMPRET - слова из одного
;     символа ('?' PRINT, апостроф REM).
;------------------------------------------------------------------------------
SEEKOP::
	JSR	R1,CMPRET	; Текст начинается с "?"
	.BYTE	'?, 13.		; "?" - код 13. (PRINT)
	JSR	R1,CMPRET	; Текст начинается с апострофа
	.BYTE	'', 1.		; апостроф - код 1 (REM)

SEEK::	MOV	R3,OLDR3	; Запомнить начало текста
	MOV	(R0)+,R2	; R2 = корень (бит 15), R0 -> параметр
	ASL	R2		; R2 = адрес таблицы, C = бит корня
	BCC	NEXT.C		; не корень => узел дерева
	MOVB	(R3)+,R5	; Первая буква
	BICB	#40,R5		; В верхний регистр
	CMPB	R5,#'A		; Меньше "A"?
	BLO	E.BAD		; да => не найдено
	CMPB	R5,#'_		; Больше "_"?
	BHI	E.BAD		; да => не найдено
	BIC	#^C37,R5	; Номер буквы 0-37 (восьм.)
	ASL	R5		; Смещение: слово на букву
	ADD	R5,R2		; R2 -> слово этой буквы
	MOV	(R2),R2		; R2 -> список узлов буквы
	BEQ	E.BAD		; нет слов на эту букву => не найдено
	BR	ENTRY		; Разобрать список
NEXT.C: 
	MOVB	(R3)+,R4	; Очередная буква
	BICB	#40,R4		; В верхний регистр
	CMPB	R4,#'A		; Меньше "A"?
	BLO	E.BAD		; да => не найдено
	CMPB	R4,#'Z		; Больше "Z"?
	BHI	E.BAD		; да => не найдено
	BIC	#^C37,R4	; Номер буквы
LOOP:	MOV	(R2)+,R5	; Узел: буква (5 бит) и смещение
	BIC	#^C37,R5	; Буква узла
	CMPB	R5,R4		; Сравнить с искомой
	BLO	LOOP		; меньше => следующий узел
	BGT	E.BAD		; больше => не найдено (узлы упорядочены)
	MOV	-(R2),R5	; R5 = слово узла (R2 -> узел)
	ASH	#-5,R5		; Смещение в байтах = слово >> 5
	ADD	R5,R2		; R2 -> следующий список узлов или хвост
ENTRY:	CMP	R2,#TAILS$	; Адрес в области хвостов (Tails$)?
	BLO	NEXT.C		; нет => ещё список узлов
	CLR	R5		; R5 = 0
	BISB	(R2)+,R5	; R5 = код слова (первый байт хвоста)
NEXT.T:	MOVB	(R3)+,R4	; Символ текста
	Cmpb	r4,#100		; Буква?
	Blo	1$		; нет =>
	BIC	#40,R4		; В верхний регистр
1$:	CMPB	R4,(R2)+	; Совпадает с хвостом?
	BEQ	NEXT.T		; да => дальше
	DEC	R3		; Вернуть символ
	CMPB	-(R2),#200	; Конец хвоста (код 200)?
	BEQ	E.OK		; да => слово найдено
	MOV	R3,R2		; R2 = R3
	SUB	OLDR3,R2	; R2 = число совпавших символов
	CMP	R2,(R0)		; Меньше параметра?
	BLO	E.BAD		; да => не найдено


E.OK:	ASL	R5		; R5 = код * 2 (индекс в AOPSUB)
	CMP	(R0)+,(R0)+	; Пропустить параметр и команду за ним
	TRAP	112		; Пропуск пробелов
	RTS	R0		; Найдено: возврат с пропуском

E.BAD:	MOV	(PC)+,R3	; Вернуть указатель на начало текста
OLDR3:	.BLKW	1		; Начало текста
	TST	(R0)+		; Пропустить параметр
	RTS	R0		; Не найдено: возврат без пропуска

;------------------------------------------------------------------------------
; CMPRET - одиночный символ как ключевое слово (JSR R1,CMPRET)
;------------------------------------------------------------------------------
CMPRET:
	CMPB	(R3),(R1)+	; Символ текста = заданному?
	BNE	1$		; нет =>
	MOVB	(R1)+,R5	; R5 = код слова
	POP	R1		; Вернуть R1 (в SEEKOP не возвращаемся)
	TST	(R0)+		; Пропустить слово корня
	INC	R3		; Символ принят
	BR	E.OK		; Как при успешном SEEK
1$:	INC     R1		; Пропустить код
	RTS     R1		; Дальше




;------------------------------------------------------------------------------
; Таблицы разбора имени (FT1): запись - разделитель, процедура, следующая
; таблица. DSEEK продолжается в FSEEK, поэтому ":" не обязательно.
;------------------------------------------------------------------------------
DEVEXT:	.RAD50	/BASBASBASBAS/	; Расширения для .CSISPC
NTMP:	.RAD50	/DK TBASICSWP/	; Файл подкачки DK:TBASIC.SWP

AREA:	.BLKW	6		; Область параметров EMT
RTAB:	.ASCII	/ ABCDEFGHIJKLMNOPQRSTUVWXYZ$%*0123456789/	; RAD50 -> ASCII
DEVIC:	.RAD50	/DK          /	; Не используется


DSEEK:	.WORD	':	,DEVCPY	,FSEEK
FSEEK:	.WORD	'.	,FNCPY	,ESEEK
	.WORD	0	,FNCPY	,0


ESEEK:	.WORD	0	,EXTCPY	,0


DM:	.ASCIZ	/DK:*.BAS/	; Имя по умолчанию


.EVEN

.END
