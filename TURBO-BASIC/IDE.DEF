;______________________________________________________________________________
;	Режим работы памяти.
	Base	= 0			; Основной режим
	Extend	= 1			; Расширеный режим
	
	MemTyp	= Base			; Текущий режим.
	
;______________________________________________________________________________
;	Версия системы
	Demo	= 0			; Демо версия
	Alpha	= 1			; Полная Alpha версия
	Beta	= 2			; Полная Beta версия

	Version	= Alpha			; Текущая версия.
	
;______________________________________________________________________________
;	Защита от изменеия
	On	= 0			; Включена
	Off	= 1			; Выключена
	
	SavPrt	= Off			; 
	
