;******************************************************************************
;*                               Главный модуль                               *
;*                               Файл : Ide.Mac                               *
;*                    Свободное распространение (Free Ware)                   *
;*                          Герасимов Олег   (09.05.95)                       *
;******************************************************************************
;------------------------------------------------------------------------------
; IDE - главный модуль интегрированной среды Turbo Basic. Части: Install (ЦП) -
; IdeIni: имя устройства запуска, запрос памяти у ПП (Mp.All), релокация
; резидента по таблице Rtab (макрос Rel), запись в ПП (Mp.Put), TGINST.
; Locked/System (резидент в ПП): Begin - вектора 100, 34, 300, палитры,
; клавиатура (ReKey), экран (ReScr), файл установок DK:TURBO.DSC ($LdSk),
; CmAppl - вызывается диспетчером процессов (TRAP 0, MEMORY.MAC): обслуживает
; компиляцию (Comp.H) и Break. Текст лежит в ОЗУ ПП 100000-170000 под ПЗУ
; (PZUOff/PZUOn), буфер обмена с ЦП - область TEXT ЦП (Bbuf..kBuf, 5120. слов,
; адрес в Ds). Запросы к ЦП - $$DSCL (коды PCOD, см. PPIO.MAC); данные ЦП
; ЦП читаются и пишутся окном 177010/177014.
;------------------------------------------------------------------------------
	.Mcall	.GtLin	.RofDF .Print .Cstat .Exit	; Макрокоманды RT-11
	.RofDf			; Смещения RT-11

	.Title	IDE		; Заголовок листинга
	.Ident	/V1.0/		; Номер версии

;	Определение порядка расположения програмных секций
	.Psect	Install		; Инсталятор в ЦП
	.Psect	Locked		; Защишеная часть системы в ПП
	.Psect	Variable	; Переменые
	.Psect	System		; Простая часть системы в ПП
mSwap::
	.Psect	Data		; Данные 
	.Psect	Text		; Тексты окошек и сообщения
	.Psect	Reltab		; Таблица релокации
PpStp::
Rtab:
;	Определение констант	
	Lbuf	== 1000		; Буфер строки текстового редактора
	Farea	== 1300		; Область для имени файла при обмене
	TtBuf	== 2000		; Буфер очередь терминала
	TtPtr	== 22544	; Указатель на начало очереди терминала
	T1Ptr	== 22542	; Указатель на конец очереди терминала
	TProc	== 7064		; Признак процесса терминала
	TExtR	== 100000	; Начало текста 
	HiText	== 170000	; Верхний предел текста
	EdXPl	== 13000	; Регистр палитры окна редактора
	NmXPl	== 13010	; Регистр палитры нижней строки

	.Includ	/IDE.MLB/	; Подключение макробиблиотеки
	Define			; Определение популярных констант
	.RelDef	A		; Определение макроса Rel

;______________________________________________________________________________

;	Исполняемая часть ЦП. (Инсталятор)
.Psect	Install			; Програмная секция

;------------------------------------------------------------------------------
; IdeIni - инсталлятор (в ЦП): запустить IDE в ПП, C = 0 - успех
;------------------------------------------------------------------------------
IdeIni::
;	Call	TgInst			; Запуск Турбо-Графики 
;	Bcs	All.Er			; В случае ошибки выход.

;	Проверка дополнительных параметров
	Clrb	FdBuf		; Имя файла из командной строки - нет
	Mov	@#SysPtr,r0	; R0 -> монитор RT-11
	Bit	StatWd(r0),#10000	; Бит слова состояния монитора
	Beq	10$		; не взведён =>
	.GtLin	#FdBuf,#Prom	; Запросить имя файла


10$:
;	Определение имени устройства запуска
	.Cstat	#Area,#17,#Addr	; Состояние канала 17 (устройство запуска)
	Mov	#HName+3,r1	; R1 -> конец имени
	
	Mov	Addr+10.,r5	; Получить имя устройства
	Mov	#3,r2		; В имени три буквы
11$:	Clr	r4		; R4 = 0
	Div	#40.,r4		; Преобразвание к ASCII
	Add	#100,r5		; Запись симола в строку
	Movb	r5,-(r1)	; Символ - в имя
	Mov	r4,r5		; Остаток
	Sob	r2,11$		; Все три буквы

	Movb	Addr+8.,HName+2	; Получить номер устройства
	Bisb	#60,HName+2	; Преобразовать к ASCII


;	Процедура загрузки резидента в ПП
	Mov	#176674,R1	; Адрес регистра
	Mov	#Mp.All,R0	; Выделить памяти
	Call	Put		; Послать запрос ПП
	Tstb	(r0)		; Проверить ответ от ПП
	Bne	All.Er		; Ошибка - выход.
	Mov	Pp.Adr,r2	; Адрес начала выделенной памяти
	Sub	#Begin,R2	; R2 = сдвиг релокации
	Mov	#Rtab,r0	; Адрес таблицы релокации
1$:	Add	R2,@(R0)+	; Релокация обращения метки
	Tst	(R0)		; Конец таблицы ?
	Bne	1$		; Нет - продолжать..
	Mov	#Mp.Put,R0	; Переписать инсталятор в ПП
	Call	Put		; Послать: записать резидент в ПП
	Clc			; Очистить признак ошибки
	Mov	Pp.Adr,Es	; Запомнить адрес
	Call	TGINST		; Поставить драйвер Турбо-графики
	Return			; Выход из модуля

;	Процедура отправки МП в ПП
Put:	Mov	#4,R2		; Число байтов в посылке
	Inc	R0
	Clrb	(R1)		; Подготовка канала к приему байта
1$:	Tstb	(R1)		; Канал готов ?
	Bpl	1$		; - Нет. ждать
	Movb	R0,2(R1)	; Записать байт в канал
	Swab	R0		; Следующий байт
	Sob	R2,1$		; Цикл для всех байтов
2$:	Tstb	(r1)		; Ожидание окончания выполнения команды
	Bpl	2$
	Dec	R0
	Return			; Возврат
;	Обработка ошибки
All.Err:
	.Print	#NoMem		; Сообщение: нет памяти
	.Exit			; Выход в RT-11

;______________________________________________________________________________
;	Массив данных "Выделить память"
Mp.All:	.Word	400,32		; Команда: выделить память
Pp.Adr:	.Word	0		; Ответ: адрес в ПП
Pp.Len:	.Word	<PPStp-Begin>/2	; Длина резидента в словах


;	Массив данных "Записать данные в ПП"
Mp.Put:	.Word	10000,32	; Команда: записать в ПП
Rel	.Word	Begin		; Адрес в ПП (релоцируется)
	.Word	Begin		; Адрес в ЦП
	.Word	<PPStp-Begin>/2	; Длина в словах

;	Массив данных "Запуск"
Mp.Exe:	.Word 	14000,32	; Команда: запустить
Rel	.Word	Begin		; Адрес запуска (Begin в ПП)
	
Answ:	.Word	-1		; Не используется
;______________________________________________________________________________

NoMem:	.Asciz	/Нет памяти в сопроцессоре. Выгрузите резидентые программы./ 
Prom:	.Ascii	/Имя файла #/<200>
.Even				; Выровнять
Area:	.Blkw	3		; Масив параметров .Cstat
Addr:	.Blkw	6		; Блок данных .Cstat

;______________________________________________________________________________
;	Резидентная часть в ПП
	.Psect	Locked		; Програмная секция в ПП
;------------------------------------------------------------------------------
; Begin - вход резидента в ПП (после релокации и запуска Mp.Exe)
;------------------------------------------------------------------------------
Begin::	Clr	@#16		; Очистка флага On Break

	Mov	@#100,OldTM	; Сохранение вектора таймера 
	Mov	@#34,OldTR	; Сохранение вектора TRAP
	Mov	@#300,OldKb	; Сохранение вектора клавиатуры
Rel	Mov	#Int100,@#100	; Новое значение вектора таймера
Rel	Mov	#Int300,@#300	; Новое значение вектора клавиатуры
Rel	Mov	#Int34,@#34	; Новое значение вектора TRAP

Rel	Mov	#VarSeg,R0	; Адрес секции переменных
	Mov	#<FdBuf-VarSeg>/2,R1	; Длина секции переменных
1$:	Clr	(R0)+		; Очистка переменных
	Sob	R1,1$		; Повторить

	Mov	@#2470,SysPl	; Сохранение старой палитры
	Mov	@#2472,SysPL+2
	Mov	#135400,BasPl	; Палитра рабочего экрана
	Mov	#177735,BasPl+2
	Call	$Spcl		; Установка палитры редактора

	Mov	#Ds/2,@#177010	; Получение адреса буфера в ЦП
	Mov	@#177014,r0	; R0 = адрес TEXT в памяти ЦП
	Asr	r0		; В слова
	Mov	r0,Bbuf		; Начало буфера
	Add	#5120.,r0	; Размер буфера 5120. слов
	Mov	r0,kbuf		; Конец буфера



	Call	SwpFnt		; Догрузка необходимого шрифта
	Call	ReKey		; Переназначение клавиатуры
	Call	ReScr		; Инициализация экрана


Rel	Mov	#WBuf,WBPnt	; Вершина стека видеокон
	Mov	#12200,LhPtr	; LhPtr = 12200 (не выяснено)
	Call	$BgPrt		; Печать начального экрана

	Call	$LDSK		; Загрузка DeskTop файла
	Call	$Ewp		; Отрытие окна редактора
	Call	$Edit		; Переход в редактор
;	Выход из среды
	Call	@#100242	; ПЗУ: сброс 7070, разрешить TRAP 2 и TRAP 4
	Return			; Выход в Ос ПП


;------------------------------------------------------------------------------
; CmAppl - вызывается диспетчером процессов ПП (TRAP 0): запрос компиляции -
; Comp.H; Break (флаг @#16): при компиляции или выполнении прерывает ЦП по
; его вектору 4 (через вектор 24), иначе кладёт F10 в очередь клавиш ПП
;------------------------------------------------------------------------------
CmAppl::
	Tst	Cm.Flg		; Идёт компиляция?
	Beq	2$		; нет =>
	Call	Comp.H		; Обслужить запрос строки
2$:	
	Tst	@#16		; Флаг On Break?
	Beq	5$		; нет =>
	Clr	@#16		; Сбросить флаг
	
	
	Tst	Cm.Flg		; Идёт компиляция?
	Bne	4$		; да =>
	Tst	RN.FLG		; Программа выполняется?
	Beq	3$		; нет =>
	
4$:	
	Mov	#4/2,@#177010	; Окно: вектор 4 ЦП
	Push	@#177014	; Запомнить его
	Mov	#24/2,@#177010	; Окно: вектор 24 ЦП
	Pop	@#177014	; Вектор 24 := вектор 4
	Bic	#100000,@#177716	; Прервать ЦП
	Bis	#100000,@#177716	; (по вектору 24)
5$:	Return			; Выход
	
	


3$:	
	Mov	@#7210,r0	; R0 -> запись очереди клавиш ПП
	Mov	#FK10,(r0)+	; Клавиша F10 в очередь
	Bic	#40,r0		; Кольцо
	Mov	r0,@#7210	; Новый указатель
	Return			; Выход


;------------------------------------------------------------------------------
; Comp.H - ЦП просит строку исходного текста (CPCD = 10001): очередная строка
; из текста (адрес Cm.Ptr в памяти ЦП) - в BUF ЦП, CPCD := 0; после последней -
; ^Z и C = 1. Каждую 16-ю строку обновляется окно компиляции (число строк,
; свободная память MemAvl); Cm.Flg на это время сброшен (нет повторного входа)
;------------------------------------------------------------------------------
Comp.H:	Mov	#177010,R0	; R0 -> регистр адреса окна
	Mov	#177014,R1	; R1 -> регистр данных
	Mov	#CPCD/2,(R0)	; Адрес CPCD в ЦП
	Cmp	#10001,(R1)	; Запрос строки (10001)?
	Beq	1$		; да =>
	Return			; Нет запроса
1$:	Mov	#Lbuf,R2	; R2 -> буфер строки
	Mov	Cm.Ptr,(R0)	; Адрес текущей строки текста

	Cmp	Cm.Num,Mx.Lin	; Строки кончились?
	Bhi	8$		; да =>

	Mov	#177012,R1	; R1 -> регистр байта
2$:	Movb	(R1),(R2)+	; Байт строки
	Beq	4$		; конец строки =>
	Inc	(R0)		; Следующий адрес
	Br	2$		; Дальше

4$:	Inc	(R0)		; Пропустить нуль
	Mov	(R0),Cm.Ptr	; Адрес следующей строки
	Movb	#12,-1(R2)	; Конец строки: LF
	Sub	#Lbuf-2,R2	; Длина с LF
	Asr	R2		; В слова
	Tst	(R1)+		; R1 -> регистр слова
	Mov	#Lbuf,R3	; R3 -> строка
	Mov	#Buf/2,(R0)	; Адрес BUF в ЦП

5$:	Mov	(R3)+,(R1)	; Слово строки - в BUF
	Inc	(R0)		; Следующий адрес
	Sob	R2,5$		; Все слова
	Clc			; Успех
9$:	Mov	#CPCD/2,(R0)	; Адрес CPCD
	Bic	(R1),(R1)	; CPCD := 0 (строка передана)

	Mov	Cm.Num,R1	; Номер строки
	Bcs	17$		; Конец текста => показать
	Bit	#17,R1		; Кратен 16?
	Bne	10$		; нет =>
17$:	Call	$D.CNV		; Число - в текст
	Push	<#22.,#7.>	; Позиция в окне
	Call	$Wloc		; X = 22., Y = 7.
	Clr	Cm.Flg		; Запретить повторный вход
	Print	R0		; Обработано строк
	Push	<#29.,#7.>	; Позиция в окне
	Call	$Wloc		; X = 29., Y = 7.
	Print	R0		; То же число во втором столбце
	Mov	#MemAvl/2,@#177010	; Адрес MemAvl в ЦП
	Mov	@#177014,r1	; Свободно байт
	Call	$D.CNV		; Число - в текст
	Push	<#22.,#10.>	; Позиция в окне
	Call	$Wloc		; X = 22., Y = 10.
	Print	r0		; Доступная память
	Mov	#177777,CM.FLG	; Компиляция продолжается
	
10$:	Inc	CM.NUM		; Следующая строка
	Return			; Выход

8$:	
	Mov	#Buf/2,(R0)	; Адрес BUF в ЦП
	Mov	#32,(R1)	; ^Z - конец текста
	Sec			; Признак конца
	Br	9$		; Передать
	
	.Psect	System		; Простая часть системы

	
;------------------------------------------------------------------------------
; ReKey - перенастройка клавиатуры: у пяти таблиц (AkTab) для клавиш из NKey
; (16 смещений, конец - нечётный байт) прежние коды сохраняются (12400...) и
; заменяются на 200, 201...: UP, DOWN, RIGHT, LEFT, FK1-FK10, DEL, INS (IDE.MLB)
;------------------------------------------------------------------------------
ReKey::	Mov	#5,R5		; Таблиц клавиатуры: 5
	Mov	#12400,R0	; R0 -> область сохранения
Rel	Mov	#AkTab,R4	; R4 -> адреса таблиц
RK:	Mov	(R4)+,R1	; R1 -> таблица
	Mov	#200,R2		; Первый новый код
Rel	Mov	#Nkey,R3	; R3 -> смещения клавиш
2$:	Movb	(R3),4$+2	; Смещение - в команду
	Bitb	#1,(R3)		; Конец списка (нечётный)?
	Bne	3$		; да =>
	Movb	(R3)+,1$+2	; Смещение - в команду
4$:	Mov	0(R1),(R0)+	; Сохранить прежний код
1$:	Mov	R2,0(R1)	; Новый код клавиши
	Inc	R2		; Следующий
	Br	2$		; Дальше
3$:	Sob	R5,RK		; Все таблицы
	Clr	@#7042		; 7042 := 0: ASCII-коды - EMT 22/24 (ПЗУ)
	Clr	@#7230		; 7230 := 0: TRAP 2 не выполнять (ПЗУ)
	Clr	@#22552		; 22552 := 0: режим ИСУ не установлен (ПЗУ)
	Call	@#105306	; ПЗУ: Ctrl-O - латинский алфавит, надпись "ЛАТ"
	Call	@#104054	; ПЗУ: очистка буферов клавиатуры
	Return			; Выход
	


;------------------------------------------------------------------------------
; NmKey - вернуть прежние коды клавиш (обратное к ReKey)
;------------------------------------------------------------------------------
NmKey::	Mov	#5,R5		; Таблиц клавиатуры: 5
	Mov	#12400,R0	; R0 -> сохранённые коды
Rel	Mov	#AkTab,R4	; R4 -> адреса таблиц

RK0:	Mov	(R4)+,R1	; R1 -> таблица

Rel	Mov	#Nkey,R3	; R3 -> смещения клавиш
2$:	Bitb	#1,(R3)		; Конец списка?
	Bne	3$		; да =>
	Movb	(R3)+,1$+2	; Смещение - в команду

1$:	Mov	(R0)+,0(R1)	; Вернуть прежний код
	Br	2$		; Дальше
3$:	Sob	R5,RK0		; Все таблицы
	Call	@#104054	; ПЗУ: очистка буферов клавиатуры
	Call	@#100242	; ПЗУ: сброс 7070, разрешить TRAP 2 и TRAP 4
	Return			; Выход


;------------------------------------------------------------------------------
; ReScr - экран IDE: системные структуры ПП (2456-2466, 22656, 23150...),
; таблица строк: меню, редактор (22 строки), нижняя строка, шаг 81., палитры
; (формат ТВ и списка видеострок - README, по листингам ПЗУ)
;------------------------------------------------------------------------------
ReScr::	Call	$TsFr		; ТВ экрана пользователя из ПЗУ
	Mov	#7,@#2462	; Регистр отображения (2460/2462, ПЗУ)
	Mov	#2476,@#2466	; (формат не выяснен)
	Mov	#2462,@#2456
	Mov	#22656,@#23150	; Текущая ТВ - экран пользователя
	Mov	#2461,@#23160	; 23160 -> регистр отображения (ТВ +62)
	Call	$SetPL		; Палитры
	Color	Yellow,Blue	; Цвет
	Call	Twait		; Ждать прерывания таймера
	Mov	#1,@#177026	; Плоскость 0 запрещена (4 цвета)
	Call	ClrScr		; Очистить экран
	Call	CurClr		; Курсор не виден
	Mov	#2500,R0	; Таблица строк
	Mov	#100000,R1	; Видеоадрес первой строки
	Mov	#22.,R2		; Строк
	Call	$$CP		; Заполнить
	Mov	#11.*21.,R2	; Строк (редактор)
	Add	#81.*2.,R1	; Следующий адрес
	Call	$$CP		; Заполнить
	Mov	#11.*2.,R2	; Строк (строка состояния)
	Add	#81.*6.,R1	; Следующий адрес
	Call	$$CP		; Заполнить
	Mov	#6742,-(R0)	; Хвост таблицы
	
	Mov	#2500+<11.*23.*4.>,@#2552+<11.*4.*21.>	; (не выяснено)
	Mov	#2630,@#2552+<11.*4.*22.>	; (не выяснено)
	Mov	#EdXPl+6,@#2472+<13*4>	; Палитра окна редактора
	Mov	#EdXPl+4,R0
	Mov	@#2474+<13*4>,(R0)+
	Mov	#2500+<13*4>,(R0)+
	Mov	#NmXPl+6,@#2502+<11.*4*24.>	; Палитра нижней строки
	Cmp	(R0)+,(R0)+
	Mov	@#2504+<11.*4*24.>,(R0)+
	Mov	#2510+<11.*4*24.>,(R0)+

	Mov	#81.,@#22666	; Шаг строки 81.
	Mov	R1,WBuf+4	; Видеоадрес - в WBuf
	Clr	@#2400		; Системные ячейки (не выяснено)
	Clr	@#2402
	Clr	@#6750
	Clr	@#6752
	Return			; Выход


; CurClr - скрыть курсор: бит 0 в таблице строк
CurClr::Mov	#2476,R0	; R0 -> таблица строк
	Mov	#286.,R1	; Строк в таблице
	Mov	#1,R2		; Бит 0
1$:	Bic	R2,(R0)+	; Бит 0 := 0 (скрыть курсор)
	Tst	(R0)+		; Пропустить слово
	Sob	R1,1$		; Все строки
	Return			; Выход


; $$CP - R2 строк в таблицу R0 (видеоадрес R1, шаг 81., ссылка на следующую)
$$CP:	Mov	R1,(R0)+	; Видеоадрес строки
	Add	#81.,R1		; Следующая строка
	Tst	(R0)+		; Пропустить слово
	Mov	R0,-2(R0)	; Ссылка на следующую запись
	Sob	R2,$$CP		; Все строки
	Return			; Выход

;------------------------------------------------------------------------------
; $SetPl - палитры из Plg1 (4 значения): цвет в обеих половинах байта
; и пишется в 2470.., палитру окна редактора и нижней строки; $Sppl - то же из
; 4 байт за вызовом (JSR R5)
;------------------------------------------------------------------------------
$SetPl::Call	$Push		; Сохранить регистры
	Mov	#2470,R3	; R3 -> регистры палитры
Rel	Mov	#Plg1,R0	; R0 -> настройки (Plg1)
	Mov	#4,R4		; Четыре слова
1$:	Mov	(R0)+,R1	; Цвет
	Bis	#10,R1		; Бит 10
	Mov	R1,R2		; R2 = цвет
	Ash	#4,R2		; Сдвиг на 4
	Bis	R2,R1		; Цвет в оба поля байта
	Movb	R1,EdXPl-2470(R3)	; Палитра окна редактора
	Movb	R1,NmXPl-2470(R3)	; и нижней строки
	Movb	R1,(R3)+	; и палитра экрана
	Sob	R4,1$		; Все четыре
	Mov	@#2470,IDEPL	; Запомнить палитру IDE
	Mov	@#2472,IDEPL+2
	Call	$Pop		; Вернуть регистры
	Return			; Выход

$Sppl::	Push	<R0,R1>		; Сохранить R0, R1
Rel	Mov	#Plg1,R0	; R0 -> настройки (Plg1)
	Mov	#4,R1		; Четыре значения
1$:	Movb	(R5)+,(R0)+	; Байт из аргумента
	Tstb	(R0)+		; Пропустить старший
	Sob	R1,1$		; Все
	Pop	<R1,R0>		; Вернуть R1, R0
	Call	$SetPL		; Применить
	Rts	R5		; Выход за встроенный аргумент
	

; NmScr - экран обычного режима (Бейсик): палитра PLG2, таблица строк, очистка
NmScr::	Call	$TsFr		; Таблица терминала из ПЗУ
	Color	7,1		; Цвет
	Mov	PLG2,R0		; Цвет PLG2
	Asl	R0		; Индекс * 2
REL	Mov	Colrs(R0),R0	; Заливка
	.Irp	F,<2470,EdXPl,NmXPl>
	Mov	R0,@#F		; Заливка в регистры палитры
	Mov	R0,@#F+2	; (две ячейки)
	.Endr
	Call	Twait		; Ждать прерывания таймера
	Mov	#2500,R0	; Таблица строк
	Mov	#100000,R1	; Видеоадрес первой строки
	Mov	#286.,R2	; Строк
1$:	Mov	R0,-2(R0)	; Ссылка на себя
	Mov	R1,(R0)+	; Видеоадрес строки
	Tst	(R0)+		; Пропустить слово
	Add	#80.,R1		; Следующая строка
	Sob	R2,1$		; Все строки
	Call	ClrScr		; Очистить экран
	Call	$CurOn		; Включить курсор
	Return			; Выход




; $BgPrt - меню и нижняя строка; $Cls - очистка окна редактора
$BgPrt::
	Call	$CurOf		; Курсор не виден
Rel	Mov	#Main,R3	; R3 -> меню (Main)
	Color	2(R3)		; Цвет меню
	Loc	0,0		; Позиция (0, 0)
	Print	(R3)		; Вывести строку меню
	Loc	0,23.		; Позиция (0, 23.)
	Mov	#13,R0		; Код 13 (восьм.)
	Emt	42		; Вывести
	
$Cls::	Call	EdHide		; Спрятать курсор редактора
	Mov	#1,R3		; Строка 1
	Call	$GetY		; R3 = видеоадрес
	Mov	#177010,R4	; R4 -> регистр адреса
	Mov	#177020,R5	; R5 -> регистры заливки
	Mov	R3,(R4)		; Адрес
	Mov	#Cyan,@#177016	; Цвет записи
	Mov	#Blue,R0	; Фон
	Asl	R0		; Индекс * 2
REL	Mov	Colrs(R0),R0	; Заливка фона
	Mov	R0,(R5)+	; Заливка
	Mov	R0,(R5)+	; Заливка
	Mov	#<<23.*11.*81.>+<8.*81.>>/2,R0	; Слов для очистки
1$:	Clr	(R5)		; Очистить слово
	Inc	(R4)		; Следующий адрес
	Clr	(R5)		; Очистить слово
	Inc	(R4)		; Следующий адрес
	Sob	R0,1$		; Повторить
	Call	EdShow		; Показать курсор редактора
	Return			; Выход


	
;------------------------------------------------------------------------------
; $LdSk - загрузка файла установок DK:TURBO.DSC (DscTop..EndPP) и затем текста:
; открыть (код 9), прочитать (2), закрыть (1), применить палитры. Нет файла -
; имя из командной строки (Csi) или новый NONAME.BAS ($New)
;------------------------------------------------------------------------------
$LdSk::
Rel	Mov	#FdBuf,r0	; R0 -> имя из командной строки
	Mov	#Lbuf+100,r1	; R1 -> Lbuf+100
	Mov	#20,r2		; Байт (16.)
1$:	Movb	(r0)+,(r1)+	; Копировать
	Sob	r2,1$		; Повторить
	Clrb	(r1)+		; Конец строки
Rel	Mov	#Dll,r1		; R1 -> "Считывается"
	Call	DnPrt		; Вывести в нижней строке
Rel	Print	#DLD		; "файл установок."
Rel	Mov	#DsFile,R1	; R1 -> DK:TURBO.DSC
	Call	$NCopy		; Передать имя в BUF ЦП
	
	Movb	#9.,FFFF	; Код 9: открыть
	Call	$$DsCl		; Запрос ПП
	Beq	$201		; открыт =>
	Call	Csi		; Имя из командной строки
	Bcc	$300		; есть =>
	

$New::	Movb	#377,NoNMid	; Нет файла: признак NONAME
	Clrb	ChngId		; Изменений нет
Rel	Mov	#NFile,R0	; R0 -> NONAME.BAS
	Movb	#1,Ferr		; Нет ошибки: Ferr = 1
	Jmp	Crfl		; Создать текст

$201:
	Clr	FBlk		; Блок 0
	Mov	#<EndPP-DscTop>/2,R3	; Слов в области настроек
	Mov	R3,Flen		; Длина
	Movb	#2,FFFF		; Код 2: читать
	Call	C1Call		; Запрос ПП
	Bcs	$New		; ошибка => новый текст
Rel	Mov	#DscTop,R4	; R4 -> DscTop
	Mov	Bbuf,@#177010	; Адрес буфера в ЦП
1$:	Mov	@#177014,(R4)+	; Слово настроек
	Inc	@#177010	; Следующий адрес
	Sob	R3,1$		; Все слова
	Movb	#1,FFFF		; Код 1: закрыть
	Call	C1Call		; Запрос ПП
	Call	$SetPl		; Применить палитры

	Call	Csi		; Имя из командной строки
	Bcc	$300		; есть =>

REL	Mov	#EFNam,R1	; R1 -> EFNam
	Call	$NCopy		; Имя - в BUF ЦП
	
$300:	Clr	Rol.GD		; Смещение по горизонтали = 0
	Clr	ED.Y		; Курсор на первой строке



;------------------------------------------------------------------------------
; $LoadF / CRFL - загрузка текста: порциями по 5120. слов (PREAD) через область
; ЦП в ОЗУ ПП 100000... (ПЗУ отключено): Tab - пробелы до кратного 8, 16/17 -
; режим РУС/ЛАТ (бит 7 букв), Enter - конец строки (пробелы справа убираются),
; строка до 253. символов, текст - строки с нулём на конце
;------------------------------------------------------------------------------
$LOADF::
	
REL	Mov	#DLL,R1		; R1 -> "Считывается"
	Call	DnPrt		; Вывести в нижней строке
	PRINT	#FAREA		; Имя файла

	MOVB	#9.,FFFF	; Код 9: открыть
	CALL	$$DSCL		; Запрос ПП



	MOV	#FAREA,R0	; R0 -> имя
	CLRB	NONMID		; Файл с именем
	Clrb	ChngId		; Изменений нет
CRFL::
REL	MOV	#EFNAM,R1	; R1 -> EFNAM
100$:	MOVB	(R0)+,(R1)+	; Имя - в EFNAM
	BNE	100$		; до нуля
	
	
	CLR	FBLK		; Блок 0
	MOV	#177010,R5	; R5 -> регистр адреса
	MOV	#177014,R4	; R4 -> регистр данных
	MOV	#PLEN/2,(R5)	; Адрес PLEN в ЦП
	MOV	(R4),F.LEN	; F.LEN = длина файла в блоках
	Mov	#TextR,R1	; R1 -> начало текста
	MOV	R1,UP.PTR	; UP.PTR = начало
	MOV	R1,SL.PTR	; SL.PTR = начало
	CLR	MX.LIN		; Строк нет
	
	
	TST	FERR		; Файл открыт (FERR)?
	BEQ	101$		; да =>
	
	CALL	PZUOFF		; ПЗУ ПП отключено
	MOV	#20.,R0		; Слов
1000$:	CLRB	(R1)+		; Очистить
	SOB	R0,1000$	; Повторить
	MOV	R1,DN.PTR	; DN.PTR = конец текста
	CALL	PZUON		; ПЗУ включено
	RETURN			; Выход
	



101$:	MOV	#HiText,DN.PTR	; DN.PTR = верхний предел
	CLR	R2		; R2 = 0 (столбец)
	CLR	R3		; R3 = 0 (режим ЛАТ)
7777$:	CALL	PZUON		; ПЗУ включено
	SUB	#20.,F.LEN	; Осталось блоков
	BMI	1$		; меньше 20 => последняя порция
	MOV	#5120.,FLEN	; 5120. слов
	BR	2$		; Читать
1$:	MOV	F.LEN,FLEN	; Остаток
	ADD	#20.,FLEN	; Плюс 20
	SWAB	FLEN		; В слова (SWAB)
2$:	MOVB	#2,FFFF		; Код 2: читать
	CALL	C1CALL		; Запрос ПП
	BCS	31$		; ошибка =>
	ADD	#20.,FBLK	; Следующая порция
	CALL	PZUOFF		; ПЗУ ПП отключено (текст под ПЗУ)
	MOV	BBUF,(R5)	; Адрес буфера в ЦП
77$:	Cmp	(R5),kBUF	; Конец буфера?
	Bhis	7777$		; да => читать ещё
	.MOVB	(R4)+,R0	; Байт
	BEQ	666$		; нуль => конец
	Cmp	r4,#177016	; Окно: второй байт слова?
	Bne	8$		; нет =>
	TST	-(R4)		; Вернуть R4
	INC	(R5)		; Следующий адрес
8$:	Cmp	r0,#100		; Буква?
	Blo	24$		; нет =>
	BISB	R3,R0		; Режим РУС: старший бит
7$:	MOVB	R0,(R1)+	; Символ - в текст
	INC	R2		; Столбец + 1
	CMPB	#375,R2		; Предел 253.?
	BEQ	79$		; да => конец строки
	BR	77$		; Дальше
24$:	Cmp	r0,#40		; Управляющий код?
	Bhis	7$		; нет => символ
	Cmp	r0,#Tab		; Tab?
	Bne	22$		; нет =>
	CLR	R0		; R0 = -столбец
	SUB	R2,R0		; R0 = число пробелов до
	BIC	#7,R2		; ближайшей позиции табуляции
	ADD	#10,R2		; (кратной 8)
	ADD	R2,R0		; Пробелы
	MOVB	#40,(R1)+	; вместо Tab
	SOB	R0,.-4		; Повторить
	BR	77$		; Дальше
22$:	Cmp	r0,#Enter	; Enter?
	Bne	23$		; нет =>
79$:	CLR	R2		; Столбец = 0
	INC	MX.LIN		; Строк + 1
	CALL	663$		; Убрать пробелы в конце строки
	CLRB	(R1)+		; Конец строки
	Cmp	R1,DN.PTR	; Конец текста?
	Bhis	666$		; да =>
	BR	77$		; Дальше
23$:	IF	R0 {} #16 THEN 3$	; РУС (16)?
	MOV	#200,R3		; Режим РУС
	BR	77$		; Дальше
3$:	IF	R0 {} #17 THEN 77$	; ЛАТ (17)?
	CLR	R3		; Режим ЛАТ
	BR	77$		; Дальше
666$:	CALL	663$		; Убрать пробелы в конце строки
	MOV	#20.,R2		; Нулей
662$:	CLRB	(R1)+		; Дополнить нулями
	SOB	R2,662$		; Повторить
	MOV	R1,DN.PTR	; DN.PTR = конец текста
	CALL	PZUON		; ПЗУ включено
	MOVB	#1,FFFF		; Код 1: закрыть
	CALL	C1CALL		; Запрос ПП
	RETURN			; Выход
663$:	PUSH	(R5)		; Запомнить адрес
	MOV	R1,(R5)		; Адрес конца строки
25$:	DEC	(R5)		; Назад
	CMPB	#40,2(R5)	; Пробел?
	BEQ	25$		; да =>
	MOV	(R5),R1		; R1 -> последний символ
	INC	R1		; Следующая позиция
	POP	(R5)		; Вернуть адрес
31$:	RETURN			; Выход

; Csi - имя из Lbuf+100 в BUF ЦП (PTEST); C = 1 - имени нет или ошибка
Csi:
	Mov	#Lbuf+100,r1	; R1 -> имя из командной строки
	Tstb	(r1)		; Имя есть?
	Beq	1$		; нет =>
	Call	$Ncopy		; Имя - в BUF ЦП (и PTEST)
	Tst	Ferr		; Ошибка PTEST?
	Bne	1$		; да =>
	Clc			; Успех
	Return			; Выход
1$:	Sec
	Return			; Нет имени: C = 1
	

	


;------------------------------------------------------------------------------
; $SaveF - сохранить текст: создать файл (10, с резервной копией BAK - 11, если
; включено ESW бит 1), строки в Lbuf с CR LF - в буфер ЦП, порциями писать (4),
; закрыть (1). Демо-версия - окно "О программе"
;------------------------------------------------------------------------------
$SaveF::
	.If	Ne Version-Demo
Rel	Mov	#EfNam,R1	; R1 -> EfNam
	Call	$NCopy		; Имя - в BUF ЦП, достроить (PTEST)
	Color	Black,Cyan	; Цвет
	Loc	0,23.		; Позиция (0, 23.)
Rel	Print	#DLS		; "Сохраняется"
Rel	Print	#EfNam		; Имя файла
	Movb	#10.,R0		; Код 10: создать
	Bit	#1,ESW		; Резервная копия (ESW, бит 1)?
	Beq	13$		; нет =>
	Inc	r0		; Код 11: с резервной копией (BAK)
13$:	Movb	R0,ffff		; Код - в запрос
	Call	C1call		; Запрос ПП
	Bcs	19$		; ошибка =>
	Clr	Fblk		; Блок 0
	Mov	#177010,R5	; R5 -> регистр адреса
	Mov	#177014,R4	; R4 -> регистр данных
	Mov	BBuf,(R5)	; Адрес буфера в ЦП
	Mov	Up.Ptr,R3	; R3 -> начало текста
	Dec	R3		; Минус 1
	Mov	Mx.Lin,-(SP)	; Число строк
10$:	Push	(R5)		; Запомнить адрес буфера
	Mov	R3,(R5)		; Адрес строки текста
	Clr	R2		; R2 = 0
	Mov	#LBuf,R1	; R1 -> Lbuf
1$:	Inc	(R5)		; Следующий адрес
	Movb	2(R5),(R1)+	; Байт строки - в Lbuf
	Bne	1$		; до нуля
	Movb	#15,-1(R1)	; Конец строки: CR
	Movb	#12,(R1)+	; и LF
	Mov	(R5),R3		; R3 = адрес следующей строки
	Pop	(R5)		; Вернуть адрес буфера
	Mov	#Lbuf,R0	; R0 -> Lbuf
	Sub	R0,R1		; R1 = длина строки
7$:	Cmp	(R5),kBuf	; Буфер заполнен?
	Blo	8$		; нет =>
	Call	11$		; Записать порцию (11$)
	Bcs	19$		; ошибка =>
	Mov	bBuf,(R5)	; Буфер сначала
8$:	Movb	(R0)+,(R4)+	; Байт - в буфер
	Bit	#1,R4		; Нечётный байт?
	Bne	12$		; да =>
	Tst	-(R4)		; Слово: назад
	Inc	(R5)		; и адрес + 1
12$:	Sob	R1,7$		; Вся строка
	Dec	(SP)		; Строк - 1
	Bpl	10$		; Ещё есть =>
	Tst	(SP)+		; Снять счётчик
	Dec	(R5)		; Назад на байт
	Call	11$		; Записать остаток
	Movb	#1,ffff		; Код 1: закрыть
	Call	C1Call		; Запрос ПП
	Clrb	ChngId		; Изменений нет
	Jmp	DLCrea		; Восстановить нижнюю строку


11$:	Mov	(R5),R2		; Конец данных в буфере
	Sub	bBuf,R2		; Минус начало буфера
	Mov	R2,Flen		; Длина в слова
	Movb	#4,ffff		; Код 4: писать
	Call	C1Call		; Запрос ПП
	Bcs	19$		; ошибка =>
	Ash	#-8.,R2		; Слов / 256 = блоков
	Add	R2,FBLK		; Номер блока + блоков
	Clc			; Успех
.Iff	
Rel	Window	#About		; Демо-версия: окно "О программе"
.EndC

19$:	Return			; Выход


;------------------------------------------------------------------------------
; C1CALL - запрос к ЦП с повтором: ошибка - сообщение, Enter повторяет, Esc -
; отказ (C = 1); DLCREA - вернуть нижнюю строку
;------------------------------------------------------------------------------
C1CALL::
	CALL	$$DSCL		; Запрос ПП
	BNE	1$		; ошибка =>
	CLC			; Успех
	RETURN			; Выход
1$:	
Rel	Mov	#IOERTX,r1	; R1 -> "Ошибка ввода-вывода"
	Call	DnPrt		; Вывести в нижней строке
3$:	EMT	22		; Клавиша
	CMP	R0,#ENTER	; Enter?
	BNE	2$		; нет =>
	CALL	RSTCOL		; Вернуть цвета
	CALL	DLCREA		; Восстановить нижнюю строку
	BR	C1CALL		; Повторить запрос

2$:	CMP	R0,#ESCAPE	; Esc?
	BNE	3$		; нет => ждать
	CALL	RSTCOL		; Вернуть цвета
	CALL	DLCREA		; Восстановить нижнюю строку
	SEC			; Отказ: C = 1
	RETURN			; Выход
DLCREA::

Rel	Mov	#DL2,r1		; R1 -> строка подсказки
	Call	DnPrt		; Вывести
	JMP	RSTCOL		; Вернуть цвета
	
DnPrt::
	Loc	0.,23.		; Позиция (0, 23.)
	Color	Black,Cyan	; Цвет
	Jmp	Pr		; Вывести строку

.Save
.Psect	Locked

;------------------------------------------------------------------------------
; $$DSCL - запрос к ЦП: блок FFFF (7 слов) - в память ЦП с PCOD, вызвать INT104
; ЦП (адрес из вектора 104 - в вектор 24, прерывание через 177716), ждать
; PREADY = 0 (TRAP 0 - пока работают процессы ПП), FERR = PERR; Z = 1 - успех
;------------------------------------------------------------------------------
$$DSCL::CALL	$PUSH		; Сохранить регистры
	MOV	#177010,R5	; R5 -> регистр адреса
	MOV	#177014,R4	; R4 -> регистр данных
	MOV	#PCOD/2,(R5)	; Адрес PCOD в ЦП
	MOV	#7,R2		; 7 слов блока запроса
REL	MOV	#FFFF,R3	; R3 -> FFFF
1$:	MOV	(R3)+,(R4)	; Слово запроса - в ЦП
	INC	(R5)		; Следующий адрес
	SOB	R2,1$		; Все 7 слов
	MOV	#104/2,(R5)			; КОМАНДА ДЛЯ ЦП.
	MOV	(R4),R3		; Слово: вектор 104 ЦП
	MOV	#24/2,(R5)	; Окно: вектор 24 ЦП
	MOV	(R4),-(SP)	; Запомнить вектор 24
	MOV	R3,(R4)		; Вектор 24 := вектор 104 (INT104)
	BIC	#100000,@#177716	; Прервать ЦП
	BIS	#100000,@#177716	; (через 177716)
	MOV	(SP)+,(R4)	; Вернуть вектор 24
2$:	TRAP	0		; Процессы ПП
	MOV	#PCOD/2,@#177010	; Адрес PCOD
	IF	@#177014 { #0 THEN 2$	; PREADY < 0 (377: ЦП занят) => ждать
	MOV	#PERR/2,@#177010	; Адрес PERR
	MOV	@#177014,FERR	; Код ошибки
	CALL	$POP		; Вернуть регистры
	TST	FERR		; Z = 1 - успех
	RETURN			; Выход

FFFF::	.BYTE	0,377		; Блок запроса: PCOD, PREADY
	.BLKW	4		; /* MicroSoft Reserved */ 
FBLK::	.WORD	0		; PBLOCK
FLEN::	.WORD	0		; PLEN
FERR::	.WORD	0		; Код ошибки

.Restore

;------------------------------------------------------------------------------
; $NCOPY - имя из R1 (без пробелов в конце) в BUF ЦП, код 15 (восьм.) - PTEST:
; ЦП достраивает имя, результат - в FAREA
;------------------------------------------------------------------------------
$NCOPY::
	PUSH	R1		; Запомнить R1
3$:	TSTB	(R1)+		; Найти конец строки
	BNE	3$		; Дальше
	DEC	R1		; R1 -> нуль
4$:	CMPB	#40,-(R1)	; Назад по пробелам
	BEQ	4$		; Пробел =>
	CLRB	1(R1)		; Нуль за последним символом
	POP	R1		; Вернуть R1
	
	
	MOV	#177010,R5	; R5 -> регистр адреса
	MOV	#BUF/2-1,(R5)	; Адрес BUF в ЦП, минус 1
1$:	INC	(R5)		; Следующий адрес
	MOVB	(R1)+,4(R5)	; Байт - в память ЦП (мл.)
	BEQ	2$		; нуль => конец
	MOVB	(R1)+,5(R5)	; Байт - (ст.)
	BNE	1$		; не нуль => дальше
2$:	MOVB	#15,FFFF	; Код 15 (восьм.): PTEST
	CALL	$$DSCL		; Запрос ПП
	MOV	#BUF/2,@#177010	; Адрес BUF в ЦП
	CALL	$$FPR		; Достроенное имя - в FAREA
	RETURN			; Выход



	.Save
	.Psect	Locked
;------------------------------------------------------------------------------
; INT100 - таймер ПП: мигание курсора IDE (период 10. тиков), форма курсора по
; ESW (бит 2 - вставка), положение из структуры @#23150; затем OLDTM.
; Назначение многих системных ячеек не выяснено
;------------------------------------------------------------------------------
INT100::CLR	@#7046		; 7046 := 0: ПЗУ не сбросит 17600 (бит 7)
	BIC	#17400,@#177716	; Выключить звуковой сигнал ПЗУ (биты 8-11)
	MOV	#177777,TMRED	; Метка тика таймера
	DEC	(PC)+		; Счётчик периода мигания
6$:	.WORD	10.		; 10 тиков
	BNE	5$		; не истёк =>
	MOV	#10.,6$		; Заново
7$	= .+2			; Операнд команды ниже (фаза мигания)
	COM	#0		; Фаза мигания курсора
5$:	TST	@#7134		; 7134: 0 - ПЗУ ставит курсор, 2 - нет
	BNE	9$		; не 0 =>
	MOV	#177777,7$	; Курсор виден
9$:	PUSH	<R5,R1,R0>	; Сохранить регистры
	MOV	#42,-(SP)	; Форма курсора 42 (восьм.)
	BIT	#2,ESW		; Режим вставки (ESW, бит 2)?
	BNE	11$		; да =>
	BIT	#40,ESW		; Бит 40 ESW?
	BEQ	11$		; нет =>
	MOV	#6,(SP)		; Форма курсора 6
11$:	MOV	@#23150,R5	; R5 -> структура курсора ПП
	MOVB	70(R5),@#2460	; Режим курсора
	TSTB	C.IDEN		; Курсор IDE?
	BNE	10$		; да =>
	TSTB	C.MOVE		; Курсор двигается?
	BNE	4$		; нет =>
10$:	MOV	(R5),R0		; R0 = положение курсора в строке
	SUB	@32(R5),R0	; минус начало строки
	MOV	66(R5),R1	; Масштаб
	BR	.+4		; Дальше
	ASL	R0		; Сдвиг
	ROR	R1		; Сдвиг
	BCC	.-4		; Повторить
	MOV	R0,@#23156	; Положение - в ячейку 23156
	MOV	60(R5),R1	; R1 -> таблица образа курсора
	BIC	#1,52(R1)	; Погасить три позиции
	BIC	#1,6(R1)	; таблицы
	BIC	#1,42(R1)	; курсора
	MOV	32(R5),60(R5)	; Таблица строк = текущая
	MOV	60(R5),R1	; R1 -> таблица
	TSTB	7$		; Фаза мигания?
	BEQ	3$		; погашен =>
8$:	TSTB	C.IDEN		; Курсор IDE?
	BNE	3$		; да =>
	BIS	#1,52(R1)	; Включить позицию курсора
	ADD	(SP),R1		; Смещение формы
	BIS	#1,(R1)		; Бит видимости
3$:	CLR	@#23166		; Ячейка 23166 := 0
	MOV	@#23160,R1	; Указатель
	MOVB	R0,(R1)		; Положение - по указателю
4$:	TST	(SP)+		; Снять форму курсора
	POP	<R0,R1,R5>	; Вернуть регистры
	MOV	#2,@#7134	; 7134 := 2: состояние курсора не менять
	JMP	@(PC)+		; К прежнему обработчику
OLDTM::	.BLKW			; Прежний вектор таймера
	.Restore
	
;	Процедура ожидания прерывания от таймера.
; TWAIT - ждать одного прерывания таймера
TWAIT:: 
	Mtps	#0		; Прерывания разрешены
	Push	@#100		; Сохранить старое значение IntVec
Rel	Mov	#Tint,@#100	; Подставить новое значение IntVec
	Br	.		; Ожидание прерывания

Tint:
	Cmp	(Sp)+,(Sp)+	; Востановить значение стека
	Pop	@#100		; Востановление IntVec
	Return			; Возврат из процедуры

	

;	Процедура обновления таблицы терминала
; $TSFR - ТВ экрана пользователя (22656, 76 байт) из ПЗУ (112144)
$TSFR::	Mov	#22656,R0	; Базовый адрес таблицы
	Mov	#76/2,R1	; Длина таблицы в словах
1$:	Mov	112144-22656(R0),(R0)+	; Копирование таблицы из ПЗУ
	Sob	R1,1$		; Повторить
	Return			; Возврат

; $D.CNV - число R1 в десятичный текст в DEC.BF, R0 -> начало
$D.CNV::
REL	MOV	#DEC.BF,R5	; R5 -> DEC.BF
	MOV	#7,R0		; Семь пробелов
1$:	MOVB	#40,(R5)+	; Пробел
	SOB	R0,1$		; Повторить
	CLRB	(R5)		; Конец строки
	DEC	R5		; R5 -> последний символ
2$:	CLR	R0		; R0 = 0
	DIV	#10.,R0		; Делить на 10.
	MOVB	#'0,-(R5)	; Цифра
	BISB	R1,(R5)		; Остаток
	MOV	R0,R1		; Частное
	BNE	2$		; не 0 => дальше
REL	MOV	#DEC.BF,R0	; R0 -> строка
	RETURN			; Выход

	
; SWPFNT - 9 образов шрифта ПП заменить образами MASSIM; RSTFNT - вернуть
SWPFNT::
REL	MOV	#OLDFNT,R0	; R0 -> OLDFNT
REL	MOV	#MASSIM,R1	; R1 -> образы MASSIM
	MOV	#14542,R2	; R2 -> слот знака 200 (шрифт 14142)
	MOV	#9.,R3		; Образов: 9.
1$:	MOV	(R2),(R0)+	; Сохранить прежний
	MOV	R1,(R2)+	; Поставить свой
	ADD	#11.,R1		; Следующий (11 байт)
	SOB	R3,1$		; Все
	RETURN			; Выход

RSTFNT::
REL	MOV	#OLDFNT,R0	; R0 -> OLDFNT
	MOV	#14542,R2	; R2 -> слот знака 200 (шрифт 14142)
	MOV	#9.,R3		; Образов: 9.
1$:	MOV	(R0)+,(R2)+	; Вернуть
	SOB	R3,1$		; Все
	RETURN			; Выход

TSTFL::				; R1 - АДРЕС ИСХОДНОЙ СТРОКИ
				; R2 - АДРЕС ВЫХОДНОЙ СТРОКИ

	



;------------------------------------------------------------------------------
; $DRPRT - диалог выбора файла (.USER $DRPRT, $DREXE): рамка колонок, маска из
; DEFALT, список файлов (PGETFT, код 12) в области ЦП: записи по 16 байт (имя,
; нули, длина в блоках); две колонки по 8 имён, полоса ESLDIR
;------------------------------------------------------------------------------
$DRPRT::
	PUSH	R4		; Сохранить R4
	COLOR	CYAN,BLUE	; Цвет
	MOV	#^B0000001000000010,@#22716	; Заливка
	MOV	#FAREA,R0	; R0 -> FAREA
	MOV	#26.,R1		; Байт
3$:	MOVB	#40,(R0)+	; Пробел
	SOB	R1,3$		; Повторить
	CLRB	(R0)+		; Конец строки
	MOVB	#'│,@#FAREA+14	; Разделитель колонок
	MOV	#8.,R5		; Строк
	MOV	#5,R4		; Начиная с Y = 5
4$:	PUSH	#4		; X = 4
	PUSH	R4		; Y
	CALL	$WLOC		; Позиция
	PRINT	#FAREA		; Вывести
	INC	R4		; Следующая строка
	SOB	R5,4$		; Все
	MOV	#2,R5		; Две строки
	MOV	#14.,R3		; Y = 14.
	ADD	W2,R3		; плюс Y окна
	MOV	#1,R1		; X = 1
	ADD	W1,R1		; плюс X окна
	MOV	#44.,R2		; Ширина 44.
5$:	CALL	$INV		; Подсветка
	INC	R3		; Следующая строка
	SOB	R5,5$		; Повторить
	MOV	#DEFALT/2,@#177010	; Адрес DEFALT в ЦП
	CALL	$$FPR		; Прочитать (маска по умолчанию)
	
	
	
	
	
DRPR1::	MOV	#FAREA,R1	; R1 -> FAREA
	CALL	$NCOPY		; Достроить имя (PTEST)
	MOV	#FAREA,R0	; R0 -> FAREA
	CALL	$FFILT		; Очистить имя
	CLRB	16(R0)		; Обрезать
	COLOR	CYAN,BLUE	; Цвет
	PUSH	<#4,#14.>	; X = 4, Y = 14.
	CALL	$WLOC		; Позиция
	PRINT	#FAREA		; Вывести имя
	
		
	
	
	
	
	
	
	MOVB	#14,FFFF	; Код 12 (восьм.): список файлов (PGETFT)
	CALL	C1CALL		; Запрос ПП
	MOV	BBUF,@#177010	; Адрес буфера в ЦП
	BCC	1$		; успех =>
	CLR	@#177014	; Ошибка: список пуст
	
	
1$:	CALL	$ONED		; Вывести файлы
	CLR	DR.PTR		; Страница 0
	CLR	DR.X		; Позиция 0
	CLR	EX		; Индекс 0
	CALL	$GET.MF		; Число файлов
REL	MOV	#ESLDIR,R5	; R5 -> ESLDIR
	MOV	#4.,R0		; X
	ADD	W1,R0		; плюс X окна
	MOVB	R0,1(R5)	; в описатель
	MOV	#13.,R0		; Y
	ADD	W2,R0		; плюс Y окна
	MOVB	R0,2(R5)	; в описатель
	MOV	DR.MAX,6(R5)	; Максимум
	DEC	6(R5)		; Число файлов - 1
	CLR	10(R5)		; Бегунок не нарисован
	CALL	SCRBLP		; Нарисовать полосу
	CALL	$FAPR		; Строка сведений о файле
	POP	R4		; Вернуть R4
	RETURN			; Выход
	
	
; $ONED - вывести две колонки по 8 имён с текущей страницы
$ONED:	COLOR	YELLOW,BLUE	; Цвет
	MOV	#^B0000001000000010,@#22716	; Заливка
	MOV	#5.,R3		; Колонка 1: X = 5
	CLR	-(SP)		; Признак конца списка
	CALL	2$		; Вывести колонку
	MOV	#18.,R3		; Колонка 2: X = 18.
	CALL	2$		; Вывести колонку
	TST	(SP)+		; Снять признак
	RETURN			; Выход



2$:	MOV	#8.,R5		; Строк в колонке
	MOV	#5,R4		; Y = 5
1$:	TST	2(SP)		; Список кончился?
	BNE	8$		; да =>
	CALL	$$FPR		; Запись списка - в FAREA
	TSTB	@#FAREA		; Запись пуста?
	BNE	8$		; нет =>
	MOV	#1,2(SP)	; Список кончился
8$:	MOV	#FAREA,R0	; R0 -> FAREA
	CALL	$FFILT		; Имя без управляющих символов
	CLRB	12(R0)		; Не более 12 символов
3$:	PUSH	<R3,R4>		; Запомнить X и Y
	CALL	$WLOC		; Позиция в окне
	PUSH	@#177010	; Запомнить адрес
	PRINT	#FAREA		; Вывести имя
	POP	@#177010	; Вернуть адрес
	INC	R4		; Следующая строка
	SOB	R5,1$		; Все строки
	
7$:	
	
	
	
	
	RETURN			; Выход
	
	
	
; $FFILT - имя R0: управляющие символы - пробелы, дополнить до 14.
$FFILT::PUSH	R0		; Запомнить R0
	DEC	R0		; Назад
5$:	INC	R0		; Следующий
	CMPB	(R0),#40	; Управляющий символ?
	BHIS	5$		; нет =>
	TSTB	(R0)		; Конец строки?
	BEQ	8$		; да =>
	MOVB	#40,(R0)	; Заменить пробелом
	BR	5$		; Дальше
8$:	MOV	(SP),R1		; R1 -> имя
	ADD	#14.,R1		; Плюс 14.
	SUB	R0,R1		; Минус конец имени
	BLOS	7$		; Длиннее => готово
	
	
6$:	MOVB	#40,(R0)+	; Дополнить пробелами
	SOB	R1,6$		; Повторить

7$:	POP	R0		; Вернуть R0
10$:	RETURN			; Выход


	

; $$FPR - 10 слов из памяти ЦП (с адреса окна) - в FAREA
$$FPR::	PUSH	<R5,R4,R3>	; Сохранить регистры
	MOV	#177010,R5	; R5 -> регистр адреса
	MOV	#FAREA,R4	; R4 -> FAREA
	MOV	#10,R3		; Слов (восьм. 10)
1$:	MOV	4(R5),(R4)+	; Слово из памяти ЦП
	INC	(R5)		; Следующий адрес
	SOB	R3,1$		; Повторить
	POP	<R3,R4,R5>	; Вернуть регистры
	RETURN			; Выход

; $GET.MF - число записей в списке файлов (DR.MAX)
$GET.MF:
	CLR	DR.MAX		; Файлов = 0
	MOV	BBUF,@#177010	; Адрес списка в ЦП
2$:	TSTB	@#177014	; Запись пуста?
	BEQ	1$		; да => конец
	INC	DR.MAX		; Файлов + 1
	ADD	#10,@#177010	; Следующая запись (16 байт)
	BR	2$		; Дальше
1$:	RETURN			; Выход

	
;------------------------------------------------------------------------------
; $DREXE - ввод в списке файлов (DIRJMP): вверх $DU, вниз $DD, Tab $DT,
; Esc $RET2, Enter $DEN, влево $DL, вправо $DR. DR.X - позиция на странице (16),
; DR.PTR - индекс первой записи страницы, EX = DR.PTR + DR.X
;------------------------------------------------------------------------------
$DREXE::	
	PUSH	R4		; Сохранить R4
	TST	DR.MAX		; Файлы есть?
	BNE	$112		; да =>
	JMP	$DT		; Нет => выход


$112::	CALL	$FINV		; Подсветить запись
$111:	CALL	$FAPR		; Сведения о файле
	
	MOV	DR.X,EX		; DR.X
	ADD	DR.PTR,EX	; плюс DR.PTR = индекс

REL	MOV	#ESLDIR,R5	; R5 -> ESLDIR
	CALL	SCRBLM		; Сдвинуть бегунок
	
	EMT	22		; Клавиша
	
	CALL	$FINV		; Снять подсветку
REL	KEYJMP	#DIRJMP		; Переход по клавише (DIRJMP)




$DU::	TST	DR.X		; Вверх: не первая в странице?
	BEQ	$113		; первая =>
	DEC	DR.X		; Выше
	BR	$112		; Показать





$113:	TST	DR.PTR		; Страница первая?
	BEQ	$112		; да => остаться
	SUB	#20,DR.PTR	; Предыдущая страница
	MOV	#17,DR.X	; Последняя запись

$115:
	MOV	DR.PTR,R1	; R1 = DR.PTR
	MUL	#10,R1		; Запись 8 слов
	ADD	BBUF,R1		; Плюс начало списка
	MOV	R1,@#177010	; Адрес - в окно
	
	
	
	CALL	$ONED		; Вывести страницу
	
	BR	$112		; Показать


$DD::
	
	

	MOV	EX,R0		; R0 = индекс
	INC	R0		; Следующий
	CMP	R0,DR.MAX	; Последний?
	BHIS	$112		; да => остаться
	CMP	DR.X,#17	; Последняя в странице?
	BEQ	$114		; да => следующая страница
	INC	DR.X		; Ниже
	BR	$112		; Показать

$114:	CLR	DR.X		; Позиция 0
	ADD	#20,DR.PTR	; Следующая страница
	BR	$115		; Вывести страницу

$DR::	MOV	EX,R0		; Вправо: индекс
	MOV	#10,R5		; 8 записей
1$:	INC	R0		; Следующая
	CMP	R0,DR.MAX	; Последняя?
	BHIS	2$		; да =>
	SOB	R5,1$		; Шаг
2$:	
	SUB	#10,R5		; Записей сдвига
	NEG	R5		; R5 = 8 - сдвиг
	
	ADD	R5,DR.X		; К позиции
	CMP	DR.X,#20	; Внутри страницы?
	BLO	$112		; да => показать
	
	SUB	#10,DR.X	; Следующая страница
	
	
	ADD	#10,DR.PTR	; Страница + 8
	CMP	DR.PTR,DR.MAX	; Не за концом списка?
	BLO	3$		; да =>
	SUB	#10,DR.PTR	; Остаться


3$:
	
	BR	$115		; Вывести страницу
	
	
$DL::
	MOV	EX,R0		; Влево: индекс
	MOV	#10,R5		; 8 записей
1$:	TST	R0		; Нуль?
	BEQ	2$		; да =>
	DEC	R0		; Меньше
	SOB	R5,1$		; Все
2$:	SUB	#10,R5		; Записей сдвига
	NEG	R5		; R5 = сдвиг
	SUB	R5,DR.X		; Позиция - сдвиг
	BPL	$112		; В странице => показать
	
	ADD	#10,DR.X	; Предыдущий столбец
	TST	DR.PTR		; Страница первая?
	BEQ	$112		; да => показать
	SUB	#10,DR.PTR	; Страница - 8
	BR	$115		; Вывести страницу


	


$DT::	POP	R4		; Выйти из диалога (Tab)
	RETURN			; Выход

; $DEN - выбор файла: Lbuf = устройство + ":" + имя, переход на DS.PTR
$DEN::
	MOV	#DEVNAM/2,@#177010	; Адрес DEVNAM в ЦП
	CALL	$$FPR		; Устройство - в FAREA
	MOV	#FAREA,R0	; R0 -> FAREA
	MOV	#LBUF,R1	; R1 -> Lbuf
1$:	MOVB	(R0)+,(R1)+	; Копировать
	BNE	1$		; до нуля
	MOVB	#':,-1(R1)	; Двоеточие вместо нуля
	PUSH	R1		; Запомнить R1
	CALL	$FAPR		; Имя выбранного файла - в FAREA
	POP	R1		; Вернуть R1
	MOV	#FAREA,R0	; R0 -> имя
2$:	MOVB	(R0)+,(R1)+	; Копировать
	BNE	2$		; до нуля
	
	
	JMP	@DS.PTR		; Обработчик строки ввода диалога

$RET2::
	
	CMP	(SP)+,(SP)+	; Снять два слова
	WCLOSE			; Закрыть окно
	RETURN			; Выход

	
; $FINV - подсветка текущей записи; $FAPR - строка сведений (имя, блоки)
$FINV:
	MOV	#5.,R1		; Колонка 1: X = 5
	MOV	DR.X,R3		; R3 = позиция
	CMP	R3,#8.		; Во второй колонке?
	BLO	1$		; нет =>
	SUB	#8.,R3		; Строка во второй колонке
	MOV	#18.,R1		; X = 18.
1$:	ADD	W1,R1		; X в окне
	ADD	W2,R3		; Y в окне
	ADD	#5,R3		; Плюс 5
	MOV	#10.,R2		; Ширина 10.
	CALL	$INV		; Инвертировать
	RETURN			; Выход
	



	
$FAPR:
	COLOR	CYAN,BLUE	; Цвет
	PUSH	<#1,#15.>	; X = 1, Y = 15.
	CALL	$WLOC		; Позиция
	MOV	DR.PTR,R1	; Индекс страницы
	ADD	DR.X,R1		; Плюс позиция
	MUL	#10,R1		; Запись 8 слов
	ADD	BBUF,R1		; Плюс начало списка
	MOV	R1,@#177010	; Адрес - в окно
	
	
	CALL	$$FPR		; Запись - в FAREA
	MOV	#FAREA,R0	; R0 -> FAREA
	CALL	$FFILT		; Имя без управляющих символов
	CLRB	12(R0)		; Не более 12 символов
	MOV	#TTBUF+44.,R1	; R1 -> TTBUF + 44.
	CLRB	(R1)		; Конец строки
	MOV	#44.,R0		; Знакомест
1$:	MOVB	#40,-(R1)	; Пробелы справа налево
	SOB	R0,1$		; Повторить
	MOV	#FAREA,R0	; R0 -> имя
	ADD	#3,R1		; R1 -> начало + 3
	MOV	#12,R2		; Символов
2$:	MOVB	(R0)+,(R1)+	; Имя - в строку
	SOB	R2,2$		; Повторить
	MOV	@#FAREA+16,R1	; Длина в блоках
	CALL	$D.CNV		; Число - в текст
	INC	R0		; Первая цифра
	MOV	#TTBUF+15.,R1	; R1 -> место числа
3$:	MOVB	(R0)+,(R1)+	; Число - в строку
	BNE	3$		; до нуля
	MOVB	#40,-(R1)	; Нуль - пробел
	CALL	$PRTZ		; Вывести строку
	RETURN			; Выход
	

; CLRSCR - очистка экрана (тот же код, что CLS в TGRAPH.MAC)
CLRSCR:	
	MOV	@#23150,R5	; R5 -> структура экрана ПП
	PUSH	@50(R5)		; Сохранить две ячейки
	PUSH	@52(R5)		; структуры
	MOV	#8.,R0		; Цветов
	MOV	#113512,R1	; R1 -> таблица заливок ПЗУ
1$:	CMP	44(R5),(R1)+	; Найти текущую заливку фона
	BEQ	2$		; Нашли =>
	SOB	R0,1$		; Все цвета
	MOV	#113514,R1	; Не нашли
2$: 	SUB	#113514,R1	; R1 = смещение
	CLR	R0		; R0 = 0
	ASR	R1		; Номер цвета
	ASR	R1		; делится
	BCC	3$		; чётный =>
	MOV	#-4,R0		; Нечётный
3$:	ADD	50(R5),R1	; Плюс адрес
	MOVB	(R1),R2		; Байт
	ASH	R0,R2		; Выделить поле
	BIC	#177770,R2	; Номер 0-7
	ASL	R2		; Индекс
	MOV	113512(R2),R2	; Заливка фона
	MOV	R2,@50(R5)	; В первую ячейку
	MOV	R2,@52(R5)	; и во вторую
	JMP	@#113262	; Очистка экрана - процедура ПЗУ

.PSECT	DATA

; DIRJMP - клавиши списка файлов (число, коды, обработчики); ESLDIR - полоса
DIRJMP:	.BYTE	7,UP,DOWN,TAB,ESCAPE,ENTER,LEFT,RIGHT

REL	.WORD	$DU
REL	.WORD	$DD
REL	.WORD	$DT
REL	.WORD	$RET2
REL	.WORD	$DEN
REL	.WORD	$DL
REL	.WORD	$DR
REL	.WORD	$112

ESLDIR:
	.BYTE	0,0,0,24.	; Полоса: горизонтальная, X, Y, длина 24.
REL	.WORD	EX		; Адрес текущего значения
	.WORD	0,0		; Максимум, бегунок
	


.END	IdeIni
