
;------------------------------------------------------------------------------
; ENDTRC - отдельная утилита RT-11 (не часть IDE и Бейсика): "Text files
; optimiser" - копирует текстовый файл, убирая пробелы в конце строк (строка
; кончается CR, LF). Запрос "EndTrc>", команда по правилам CSI (вых=вход, по
; умолчанию .LST): выход - канал 0, вход - канал 3 (.CsiGen). Чтение и запись
; блоками по 512 байт через буферы IBuff, OBuff; конец текста - нулевой байт.
; Строка до 256 байт (длина не проверяется)
;------------------------------------------------------------------------------
;	Подключение системных макроопределений

.Mcall	.ReadW .WritW .Close .Enter .LookUp .SetTop .Exit
.Mcall	.Print .CsiGen ..V1.. .TtyOut .GtLin

	..V1..


;	Внутренние макроопределения

.Macro	PutCh	Char=r0
.iif	dif Char,r0	Movb	Char,r0
	Call	PutCh
.EndM

.Macro	GetCh	Char=r0
	Call	GetCh
.iif	dif Char,r0	Movb	r0,Char
.EndM


;	Начало исполняемой части
Start:
	.SetTop	#-2		; Взять всю память

Loop:
	Mov	#StrBuf,R1	; Запрос строки с терминала
2$:	.GtLin	r1,#Prom	; Строка с приглашением
	Tstb	(r1)		; Пустая строка ?
	Bne	1$
	.Print	#Hlp		; Да вывод информации
	Br	2$
1$:	.CsiGen	#Driver,#DefExt,r1	; Обработка введенной строки
	Bcc	3$		; Ошибка была ?
	Jsr	r5,Error	; Да - Сообщить
	.Word	CsiErr
	Br	Loop		; Цикл

					; Инициализация переменных
3$:	Clr	RdBlk		; Номер блока во входном файле
	Mov	#IBuff,RdPtr	; Указатель в буфере входном потока
					; Номер блока в выходном файле
	Clr	WrBlk
	Mov	#OBuff,WrPtr	; Указатель в буфере выходного потока
	Clr	EndId

Loop1:


	Call	GetS		; Строка (до LF) в Line
	Bcs	Loop		; Ошибка => новый запрос
	Bne	1$		; Z = 0 - конец текста => завершить
	Call	PutS		; Записать строку
	Bcs	Loop		; Ошибка => новый запрос
	Br	Loop1		; Следующая строка
1$:	Call	Close		; Закрыть файлы
	.Exit			; Выход в RT-11




;------------------------------------------------------------------------------
; GetS - прочитать строку в Line до LF, убрать пробелы перед CR LF и закончить
; нулём. Выход: C = 1 - ошибка; Z = 0 - конец текста (нулевой байт); иначе Z = 1
; Для пустой строки просмотр назад идёт до байта перед Line (старший байт
; WrBlk)
;------------------------------------------------------------------------------
GetS:
	Mov	#Line,r5	; R5 -> буфер Line
1$:	GeTch	(r5)		; Символ в (R5)
	Bcs	3$		; Ошибка => выход, C = 1
	Tstb	(r5)		; Нулевой байт?
	Beq	10$		; Да - конец текста

	Cmpb	(r5)+,#12	; LF? (R5 -> за символом)
	Bne	1$		; Нет => читать дальше
	Dec	r5		; R5 -> LF
	Dec	r5		; R5 -> CR
2$:	Cmpb	-(r5),#40	; Назад: пропустить пробелы перед CR
	Beq	2$		; Пробел => дальше
	Inc	r5		; R5 -> за последним не пробелом
	Movb	#15,(r5)+	; CR
	Movb	#12,(r5)+	; LF
	Clrb	(r5)+		; Нуль в конце строки
3$:	Return			; Возврат (Z = 1, C = 0)

10$:
	ClZ			; Z = 0: конец текста
	Return			; Возврат


; PutS - записать строку из Line в выходной поток (C = 1 - ошибка)
PutS:
	Mov	#Line,r5	; R5 -> строка
1$:	Movb	(r5)+,r0	; Очередной байт
	Beq	2$		; Нуль - конец строки
	Call	PutCh		; В выходной поток
	Bcc	1$		; Без ошибки => дальше
2$:	Return			; Возврат (C = 1 - ошибка)









;	Чтение байта из входного потока

GetCh:
	Cmp	RdPtr,#IBuff	; Буфер исчерпан
	Bne	1$		; Нет.
	.ReadW	3,#IBuff,#400,RdBlk	; Иначе считать с диска.
	Bcc	2$		; Обработка ошибки, если была

;	Tst	@#52
;	Bne	5$
;	Mov	#-1,EndId
;	Return

5$:	Jsr	r5,Error	; Сообщить об ошибке ввода
	.Word	IOErr		; Сообщения IOErr
	Br	3$		; Возврат с C = 1

2$:	Inc	RdBlk		; Переход на следующий блок

1$:	Clr	r0		; R0 = 0
	Bisb	@RdPtr,r0	; Считать символ

	Inc	RdPtr		; Перевести указатель
	Cmp	RdPtr,#IBuff+1000	; Кольцо.
	Blo	4$
	Mov	#IBuff,RdPtr
4$:	Clc
3$:	Return			; Возврат в программу

;	Запись байта в выходной поток
PutCh:
	Movb	r0,@WrPtr	; Запись символа в буфер
	Inc	WrPtr		; Перевод указателя в буфере
	Cmp	#OBuff+1000,WrPtr	; Буфер исчерпан ?
	Bhi	3$		; Нет - выход.
	Call	BWrite		; Иначе запись на диск
3$:	Return			; Возврат

;	Процедура закрытия потоков
Close:
	Call	BWrite		; Запись буфера выходного потока


					; Освобождение каналов Rt11
	.Close	0
	.Close	3
	Return

;	Процедура записи буфера в выходной поток
; BWrite - записать буфер в блок WrBlk; конец блока обнуляется словами, при
; нечётном WrPtr (Close) Clr (R0)+ даст нечётный адрес - возможна ошибка автора
BWrite:
	Mov	WrPtr,r0	; Обнуление конца буфера
1$:	Clr	(r0)+		; Обнулить слово
	Cmp	r0,#OBuff+1000	; До конца блока
	Blo	1$		; Цикл
	.WritW	0,#OBuff,#400,WrBlk	; Запись на диск
	Bcc	2$		; Обработка возможной ошибки
	Jsr	r5,Error
	.Word	IOErr
	Br	3$
2$:	Mov	#OBuff,WrPtr	; Перевод указателя на начало
	Inc	WrBlk		; Переход на следующий блок

	Clc
3$:	Return




;	Процедура обработки ошибки

Error:
	.Print	#HLin$		; Вывод имени программы
	Mov	(r5)+,r0	; Раздел ошибки
	Mov	@#52,r1		; Код ошибки
	Beq	2$		;
1$:	Tstb	(r0)+		; Поиск нужного сообщения
	Bne	1$		; Дальше
	Sob	r1,1$		; Пропустить R1 сообщений
2$:	Emt	351		; Вывод его на терминал
	Sec
	Rts	r5		; Возврат



;	Область данных

DefExt:	.Rad50	/LSTLST/	; Расширения по умолчанию


;	Текстовые сообщения
Prom:	.Ascii	/EndTrc>/<200>	; Приглашение (200 - без перевода строки)
				; Справка (пустая строка)
Hlp:	.Asciz	/Text files optimiser, By Gerasimov Oleg/
Hlin$:	.Ascii	/EndTrc-F-/<200>	; Префикс сообщений об ошибках

CsiErr:	.Asciz	/Invalid command/	; Ошибки .CsiGen, код 0-4
	.Asciz	/No device/
	.Asciz	/Output file protected/
	.Asciz	/Directory overflow/
	.Asciz	/File not found/

IOErr:	.Asciz	/Unexpected end of file/	; Ошибки .ReadW/.WritW, код 0-2
	.Asciz	"I/O error"
	.Asciz	/Invalid chanel/


;	Область буферов и переменных

StrBuf:	.Blkb	81.		; Буфер ввода комндной строки
	.Even
EndId:	.Blkw			; Не используется
RdPtr:	.Blkw			; Указатель в буфере ввода
RdBlk:	.Blkw			; Номер блока входного файла
WrPtr:	.Blkw			; Указатель в буфере вывода
WrBlk:	.Blkw			; Номер блока выходного файла
Line:	.Blkb	256		; Буфер строки

Driver	=  .			; Область для загрузки драйверов

IBuff	= Driver + 3000		; Буфер входного потока
OBuff	= IBuff + 1002		; Буфер выходного потока

Header	= OBuff + 1002		; Буфер заголовка






	.End	Start		; Конец модуля

