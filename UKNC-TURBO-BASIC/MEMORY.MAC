;******************************************************************************
;*                               Диспетчер памяти                             *
;*                              Файл : Memory.Mac                             *
;*                     Свободное распространение (Free Ware)                  *
;*                          Герасимов Олег   (09.05.95)                       *
;******************************************************************************

;------------------------------------------------------------------------------
; MEMORY - раздел Locked резидента в ПП: управление ПЗУ ПП (PZUOff/PZUOn),
; обработчик TRAP (вектор 34) с диспетчером процессов (TRAP 0), подкачка
; драйвера графики (TgLoad/TgUnLo/TgSwap), запуск программы ЦП (Bs.Exe),
; клавиатура (Int300)
;------------------------------------------------------------------------------
.Include /Ide.Mlb/		; Подключение библиотеки макросов
.RelDef	L			; Определение макроса REL


.Psect	Locked

StatMem	= 177054		; Адрес регистра управления памятью


;------------------------------------------------------------------------------
; PZUOff / PZUOn - отключить / включить ПЗУ ПП (на его месте - ОЗУ); пара
; также запрещает / разрешает прерывания (PZUOn безусловно ставит приоритет 0)
;------------------------------------------------------------------------------
;	Процедура полноного откючение ПЗУ

PZUOff::
	Mtps	#340		; Запретить прерывания (приоритет 7)
	Bis	#360,@#StatMem	; Отключение ПЗУ
	Return			; Возврат

;	Процедура подключения ПЗУ

PZUOn::
	Bic	#360,@#StatMem	; ПЗУ включено (биты 360 сброшены)
	Mtps	#0		; Разрешить прерывания
	Return			; Возврат


;	Обработка прерывания Trap
;------------------------------------------------------------------------------
; INT34 - TRAP: номер из команды (104400 + N). N = 0 - диспетчер процессов
; (ниже), иначе переход по таблице в ПЗУ ПП 160160
;------------------------------------------------------------------------------
INT34::
	Mov	(SP),R0		; Адрес команды
	Mov	-(R0),R0	; Код команды
	Sub	#104400,R0	; Номер прерывания 0..255
	Beq	1$		; Если 0, то вызов диспетчера процесов
	Jmp	@160160(R0)	; Переход по таблице ПЗУ ПП (160160 + номер)



;	Дополнение к диспетчеру процесов

; Диспетчер процессов ПЗУ ПП (RAM.LST): процессы - по таблице от 7060 (ненулевой
; признак - вызов), указатель на запись - в 7056, адреса запуска - 7104-7126;
; ненулевая ячейка запуска - JMP по ней с обнулением. Здесь: CmAppl
; (компиляция, Break), адрес возврата TRAP - в запись процесса (смещение 22),
; затем (вместо возврата в цикл ПЗУ 174164) переход по ячейке 7126: INT330
; драйвера графики или фиктивная п/п ПЗУ 174222, возвращающая в цикл;
; R1 = 0 не проверяется
1$:
	Mtps	#0		; Разрешить прерывания
	Call	CmAppl		; Выполнение приложения компилятора
	Mov	@#7056,r0	; R0 -> блок текущего процесса (ячейка 7056)
	Mov	(Sp)+,22(r0)	; Сохранить в нём адрес возврата (смещение 22)
	Tst	(Sp)+		; Снять слово PSW из стека
	Mov	@#7126,R1	; Адрес процесса "рестарта"
	Clr	@#7126		; Сброс признака процесса
	Jmp	(R1)		; Выполнение процесса "рестарта"



;------------------------------------------------------------------------------
; TgLoad / TgUnLo - драйвер графики на время работы программы ЦП: TgSwap
; меняет местами образ драйвера в ПП (mSwap, длина TgEnd-TgPut) и область окна
; 170400 (адресация окна здесь и в Inst TGRAPH.MAC согласована не до конца)
;------------------------------------------------------------------------------
TGLoad::			; Загрузка модуля ТУРБО-ГРАФИКИ
	Call	TgSwap		; Обмен: образ драйвера <-> ОЗУ
	Jmp	mSwap		; Установка драйвера (mSwap = TGPut)
;	Return

					; Выгрузка модуля Турбо-Графики
TgUnLo::
	Call	mSwap+2		; Снять драйвер (mSwap+2 = TGPut+2, RstVct)

;	Br	TgSwap



TgSwap:	Mov	#177010,r5	; Регистр адреса окна
	Mov	#177012,r4	; Регистр байта окна
	Mov	#<TgEnd-TgPut>,r3	; Длина модуля
Rel	Mov	#mSwap,r2	; Адрес ПП загрузки
	Mov	#HiText+400,(r5)	; Адрес в окне: HiText + 400 (170400)
1$:	Pushb	(r4)		; Сохранить байт окна
	Movb	(r2),(r4)	; Байт образа - в окно
	Popb	(r2)+		; Прежний байт окна - в образ, R2 + 1
	Inc	(r5)		; Следующий адрес окна
	Sob	r3,1$		; Все байты
	Return			; Возврат

;------------------------------------------------------------------------------
; Bs.Exe - выполнить программу в ЦП: загрузить драйвер, запрос ЦП, выгрузить
;------------------------------------------------------------------------------
Bs.Exe::
	Call	TgLoad		; Загрузить драйвер графики
	CpCall	#10		; 10 (восьм.) = 8: PRUN (запуск ЦП)
	Br	TgUnLo		; Выгрузить драйвер, возврат
;	Return

;------------------------------------------------------------------------------
; Int300 - клавиатура ПП (вектор 300, редактор): код клавиши в кольцевой буфер
; ПП (8 байт, указатель 7200), СТОП - флаг On Break. Начало совпадает с INT300
; драйвера графики (TGRAPH.MAC), он на время программы ЦП заменяет этот
; обработчик
;------------------------------------------------------------------------------
Int300::Push	R1		; Сохранить R1
	Mov	@#7200,R1	; R1 -> место в буфере клавиш ПП
	Movb	@#177702,(R1)	; Код клавиши (177702) - в буфер
	Cmpb	(R1),#4		; Код 4 (СТОП)?
	Bne	6$		; Нет =>
	Pop	R1		; Вернуть R1
	Mov	#177777,@#16	; Флаг On Break (ячейка 16)
	Rti			; Выход из прерывания
6$:	Tstb	(R1)		; Код клавиши
	Bpl	60$		; Меньше 200 =>
	Mov	@#7202,@#7204	; Выровнять указатели
	Mov	@#7206,@#7210	; системных очередей (не выяснено)
60$:	Inc	@#7200		; Продвинуть указатель в буфере
	Bic	#10,@#7200	; Кольцо из 8 байт
	Inc	@#7060		; Счётчик клавиш
	Pop	r1		; Вернуть R1
	Rti			; Выход из прерывания



	.End			; Конец модуля
