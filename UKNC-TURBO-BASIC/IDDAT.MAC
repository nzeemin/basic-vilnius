
;******************************************************************************
;*                                 Файл данных                                *
;*                               Файл : Ide.Mac                               *
;*                    Свободное распространение (Free Ware)                   *
;*                          Герасимов Олег   (08.06.95)                       *
;******************************************************************************

;------------------------------------------------------------------------------
; IDDAT - данные IDE: верхнее и выпадающие меню (структуры для $UPMEN и $WIND
; из WINDOW.MAC), таблицы клавиш, описатели полос прокрутки, тексты сообщений.
; Остальные окна - IDDAT2.MAC. Обработчики пунктов - Fnn из UPEXEC.MAC, OnHlp из
; HELP.MAC. Макрос .WIND: тип, X, Y, ширина, высота, цвет знаков, цвет рамки
;------------------------------------------------------------------------------

	.Includ	/Ide.Mlb/
	Define
	.RelDef	C


.Psect	Data

.Radix	10.			; Дальше числа десятичные (до .RADIX 8.)


; MAIN - верхнее меню (структура для UPMENU): адрес строки, цвет, номер
; последнего пункта, смещения пунктов в строке, затем адреса окон пунктов.
; Пункты: "=" - TOP, Файл, Поиск, Компиляция, Настройки, Справка
MAIN::
REL	.WORD	MAINM		; Строка меню (MAINM)
	.COLOR	BLACK,CYAN	; Цвет: чёрный на голубом
	.Byte	5,1,4,10,17,29,40	; Последний пункт 5; смещения
REL	.WORD	<TOP,FILE,SEARCH,COMP,OPTI,HELP>	; Окна-меню пунктов

; "=": О программе, Графический редактор, Редактор шрифта
TOP:
REL	.WORD	TOPM		; Текст пунктов (TOPM)
	.WIND	MENU,0,1,30,3,BLUE,CYAN	; X, Y, ширина, пунктов, цвета
REL	.WORD	<F01,F02,F03>	; Обработчики пунктов

; Файл: Открыть, Новый, Сохранить, Сохранить как, Сохранить все,
; Обновить экран, Выход
FILE:
REL	.WORD	FILEM
	.WIND	MENU,3,1,24,7,BLUE,CYAN
REL	.WORD	<F11,F12,F13,F14,F15,F81,F19>


; Поиск: Поиск, Продолжить поиск, Переход к строке, Последняя ошибка
SEARCH:
REL	.WORD	SEARCM
	.WIND	MENU,9,1,23,4,BLUE,CYAN
REL	.WORD	<F31,F33,F34,F35>

; Компиляция: Запуск, Компиляция, Сброс программы, Калькулятор
COMP:
REL	.WORD	COMPM
	.WIND	MENU,16,1,26,4,BLUE,CYAN
REL	.WORD	<F41,F51,F45,F61>



; Настройки: Система, Редактор, Палитра, Запись настроек
OPTI:
REL	.WORD	OPTIM
	.WIND	MENU,28,1,22,4,BLUE,CYAN
REL	.WORD	<F741,F742,F744,F75>

; Справка: Содержание, Оглавление, Поиск слова, Предыдущий контекст,
; Помощь в помощи
HELP:
REL	.WORD	HELPM
	.WIND	MENU,39,1,28,5,BLUE,CYAN
REL	.WORD	<F91,O2HLP,O3HLP,O5HLP,F95>


	; KEYBOARD RECODING TABLE
	.RADIX	8.

; AKTAB - таблицы раскладки клавиатуры ПП (ПЗУ): основного регистра (7234),
; нижнего регистра (7514), УПР (10254), ГРАФ (7774), ФИКС (10534); в IDE (по
; $KJMP) модификаторы: обычный, Shift, Ctrl, GRAF, Alt (Shift = НР, Alt = ФИКС -
; по применению). Слово таблицы - клавиша: старший байт 0 - код КОИ-8,
; 1 - регистровая клавиша, больше 1 - адрес строки. NKEY - смещения в таблицах
; 16 клавиш, получающих при ReKey (IDE.MAC) коды 200...: UP, DOWN, RIGHT, LEFT,
; FK1-FK10, DEL, INS (конец - нечётный байт 1)
AKTAB::	.WORD	7234,7514,10254,7774,10534	; Адреса пяти таблиц клавиш ПП
NKEY::	.BYTE	222,174,172,152,6,10,12,16,20,244,216,214,242,270,170,0,1
	.EVEN
	; THE KEYBOARD JUMPING TABLE

; UKJMP - таблица KEYJMP верхнего меню: влево, вправо, Enter, вниз -
; открыть окно, Esc
UKJMP::	.BYTE	5,LEFT,RIGHT,ENTER,DOWN,ESCAPE	; Число кодов; коды клавиш
REL	.WORD	<$UL,$UR,$UE,$UE,$UES,$UUNK>	; Обработчики

; EXJMP - таблица KEYJMP выпадающего меню: вверх, вниз, Enter, влево,
; вправо, Esc (нуль - выравнивание)
EXJMP::	.BYTE	6,UP,DOWN,ENTER,LEFT,RIGHT,ESCAPE,0	; Число кодов; клавиши
REL	.WORD	<$EU,$ED,$EE,$EL,$ER,$EES,$EUNK>	; Обработчики


; ESLHOR, ESLVER - полосы прокрутки редактора (формат - SCRBLP, WINDOW.MAC):
; байт 0 (0 - горизонтальная), X, Y, длина; слова: адрес значения, максимум,
; номер ячейки бегунка
ESLHOR::
	.BYTE	0,18.,22.,58.	; Горизонтальная; X, Y, длина дорожки
REL	.WORD	ROL.HD		; Значение - ROL.HD
	.WORD	175.,0		; Максимум 175 (253 - 78 столбцов), 0

ESLVER::.BYTE	1,79.,2.,18.	; Вертикальная; X, Y, длина дорожки
REL	.WORD	ROL.GD		; Значение - ROL.GD
	.WORD	1000.,0		; Максимум 1000, 0




; ETB - концы названий клавиш-модификаторов в ETT (коды 4 Ctrl, 5 Shift, 6 Alt)
; для подсказок пунктов меню; названия копируются назад до нуля
ETB::
REL	.WORD	<ETT+4.,ETT+10.,ETT+14.>	; Концы названий в ETT


.Psect	Text
	.BYTE	0		; Ограничитель при копировании назад
ETT:	.ASCIZ	/Ctrl/		; Код 4
	.ASCIZ	/Shift/		; Код 5
	.ASCII	/Alt/		; Код 6




;------------------------------------------------------------------------------
; Тексты меню. Первая строка - пункты через пробелы. Коды в тексте пунктов:
; 1 - дальше подсказка клавиши (после неё может стоять модификатор: 4 Ctrl,
; 5 Shift, 6 Alt, затем текст клавиши), 2 - разделитель перед пунктом,
; 3 - три точки, 13 - CR (смысл в конце строки меню не выяснен до конца)
;------------------------------------------------------------------------------
MainM::	.Asciz	/ =  Файл  Поиск  Компиляция  Настройки  Справка /<13>

TopM:	.Asciz	/О программе/<3><1><5>/F10/
	.Asciz	<2>/Графический редактор/<1><5>/F2/
	.Asciz	/Редактор шрифта/<1><5>/F3/

FileM:	.Asciz	/Открыть/<3><1>/F3/
	.Asciz	/Новый/
	.Asciz	/Сохранить/<1>/F2/
	.Asciz	/Сохранить как/<3>
	.Asciz	/Сохранить все/
	.Asciz	<2>/Обновить экран/<1><4>/W/
	.Asciz	/Выход/<1><6>/X/

SearcM:	.Asciz	/Поиск/<3>
	.Asciz	/Продолжить поиск/
	.Asciz	<2>/Переход к строке/<3>
	.Asciz	/Последняя ошибка/

CompM:	.Asciz	/Запуск/<1><4>/F9/
	.Asciz	/Компиляция/<1><6>/F9/
	.Asciz	/Сброс программы/<1><4>/F2/
	.Asciz	/Калькулятор/<3><1><4>/F4/

OptiM:	.Asciz	/Система/<3>
	.Asciz	/Редактор/<3>
	.Asciz	<2>/Палитра/<3>
	.Asciz	<2>/Запись настроек/

HelpM:	.Asciz	/Содержание/
	.Asciz	/Оглавление/<1><5>/F1/
	.Asciz	/Поиск слова/<1><4>/F1/
	.Asciz	/Предыдущий контекст/<1><6>/F1/
	.Asciz	<2>/Помощь в помощи/



UL::	.Ascii	/╔═[/<206>/]/	; ╔═[ значок 206 ]


;------------------------------------------------------------------------------
; Сообщения: DLL/DLS + DLD - "Считывается/Сохраняется файл установок.", DL2 -
; подсказки нижней строки, IOERTX - ошибка ввода-вывода (C1CALL),
; SUCSTR/ERRSIR - итог компиляции, EbStr - ESC Y, строка 55-32 = 23, столбец 0
; и текст, PRKEYT - приглашение, CRSWFL/LDSWFL - сообщения о файле подкачки
;------------------------------------------------------------------------------
DLL::	.Asciz	/Считывается /<13>
DLS::	.ASCIZ	/Сохраняется /<13>
DLD::	.ASCIZ	/файл установок./
DL2::	.Ascii	/ F1 Помощь  F2 Запись  F3 Чтение  Alt+F9 Компиляция/
	.Asciz	/ Alt+X Выход/<13>
NOTF::	.ASCIZ	/Файл не найден :/<13>
IOERTX::.ASCII	"Ошибка ввода вывода                                  "
	.ASCIZ	"Enter - Повтор  Esc отказ"<13>
SUCSTR::.ASCIZ	/Успех/
ERRSIR::.ASCIZ	/Ошибка/
EbStr::	.Asciz	<33>/Y/<55.>/ Нажмите любую клавишу для возврата./<13>
PRKEYT::.ASCIZ	/: Нажмите любую клавишу/
SWNSC::	.ASCIZ	/DK:TB0000.SWP/	; Файл подкачки текста
CRSWFL::.ASCIZ	/Создается файл подкачки.../<13>
LDSWFL::.ASCIZ	/Загружается файл подкачки.../<13>
DSFILE::.ASCIZ	/DK:TURBO.DSC/	; Файл установок
NFILE::	.ASCIZ	/DK:NONAME.BAS/	; Имя нового файла

	.Even
	.End
