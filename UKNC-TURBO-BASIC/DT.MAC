;------------------------------------------------------------------------------
; DT - общая область переменных Бейсика (ЦП) от STACK = 1000: линкуется и в
; Basic.Sav, и в Ide.Sav. Макросы .DW имя [слов], .DB имя [байт] строят имена
; как смещения (Count). Группы: системные указатели (тексты, строки, коды,
; таблицы), компиляция и выполнение, экран и клавиатура, графика, драйвер Турбо-
; графики (RADR...WORK3), обмен с IDE (PCOD...PERR, CPCD, DbgId, TboId), файлы
; и буферы. Имена в верхнем регистре с комментариями - авторские (1988)
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; Происхождение: список переменных Бейсика Вильнюс (DAT.MAC 1988); из 108
;     переменных 57 есть в DAT.MAC, 55 - с тем же размером, новых 51
;------------------------------------------------------------------------------

	.INCLUDE /GENUKD.MAC/
	.SBTTL	DATREG
	.ENABLE LC




	HS=3			; Не используется

;
; Операции (старший байт MAG): RD. читать, WR. писать; смещения в дескрипторе
; файла: NAMEW, ADRW, LENW - имя, адрес, длина для записи; NAMER, ADRR, LENR -
; для чтения (после ; - прежние значения автора)
	MAGSIZ==54	;30
	WR.==20			; Операция: запись (код в старшем байте MAG)
	RD.==10			; Операция: чтение
	FR.==14		;30
	NER.==1			; Коды ошибок диска (DISK.MAC)
	MER.==2
	FER.==3
	RER.==10
	SER.==-1

	NAMEW==4	;10
	ADRW==24	;4
	LENW==26	;6
	NAMER==30	;10
	ADRR==50	;4
	LENR==52	;6

	FLEN=4			; Длина вещественного (Single) в байтах

.Macro	.Dw	Name,Type
	Name	== Count
	.If	B	Type
	Count	= Count + 2
	.Iff
	Count	= Count + <Type*2>
	.EndC
.EndM


.Macro	.Db	Name,Type
	Name	== Count
	.If	B	Type
	Count	= Count + 1
	.Iff
	Count	= Count + Type
	.Endc
.EndM



Count	=	STACK

;------------------------------------------------------------------------------
; [1988=] переменные из DAT.MAC без изменений: LYGIS .. LPLCFL (39)
;------------------------------------------------------------------------------
.DW	LYGIS				;РЕЖИМ РАБОТЫ СИСТЕМЫ
.DW	TXEND				;МЕТКА КОНЦА ТЕКСТА И НАЧАЛА ОБ'ЕКТНОГО КОДА
.DW	STRREG				;МЕТКА НАЧАЛА ОБЛАСТИ СТРОК
.DW	STRSIZ				;УКАЗАТЕЛЬ ДЛИНЫ ОБЛАСТИ СТРОК
.DW	FREBEG				;МЕТКА СВОБОДНОЙ ЧАСТИ ОБЛАСТИ СТРОК
.DW	FRELEN				;ТЕКУЩАЯ ДЛИНА СВОБОДНОЙ ЧАСТИ ОБЛАСТИ СТРОК
.DW	ENDCOD				;МЕТКА НАЧАЛА СВОБОДНОЙ ОБЛАСТИ
					;И КОНЦА ОБ'ЕКТНОГО КОДА
.DW	CIKL				;МЕТКА НАЧАЛА СТЕКА ЦИКЛОВ
.DW	LIMIT				;УКАЗАТЕЛЬ ВЕРШИНЫ СТЕКА ПОДПРОГРАММ
.DW	LENT				;МЕТКА НАЧАЛА ТАБЛИЦЫ ИМЕН
.DW	TABTOP				;МЕТКА КОНЦА ТАБЛИЦ СВЯЗИ И ИМЕН
.DW	FCB				;МЕТКА НАЧАЛА ОБЛАСТИ ФАЙЛОВ И ТАБЛИЦЫ СВЯЗИ
.DW	DFCB				;МЕТКА КОНЦА СИСТЕМНОГО БУФЕРА
.DW	HIMEM				;УКАЗАТЕЛЬ ВЕРХНЕГО АДРЕСА, ДОСТУПНОГО БЕЙСИКУ
.DW	WHIMEM				;МАКСИМАЛЬНО ДОПУСТИМОЕ ЗНАЧЕНИЕ HIMEM


.DW	ERRS				;ПРИЗНАК ЗАПРЕТА ВЫПОЛНЕНИЯ ПРОГРАММЫ
.DW	TYPE				;ТИП КОМПИЛИРУЕМОГО ВЫРАЖЕНИЯ
.DW	DATBEG				;УКАЗАТЕЛЬ НАЧАЛА БУФЕРА DATA
.DW	DATPTR				;ТЕКУЩИЙ УКАЗАТЕЛЬ БУФЕРА DATA
.DW	DATINP				;ФЛАГ READ/INPUT
.DW	NUMBER				;НОМЕР КОМПИЛИРУЕМОЙ СТРОКИ
.DW	ADRHLT				;АДРЕС ОСТАНОВА ПРОГРАММЫ
.DW	TRFLAG				;ФЛАГ РЕЖИМА ТРАССИРОВКИ
.DW	AUTOON				;ФЛАГ РЕЖИМА AUTO
.DW	AUINC				;AUTO ПРИРАЩЕНИЕ
.DW	CURLIN				;УКАЗАТЕЛЬ ТЕКУЩЕЙ СТРОКИ
.DW	VCTNMB				;ЧИСЛО ЗАДЕЙСТВОВАНЫХ ON TRAP
.DW	III	FLEN/2			;РАБОЧИЕ ЯЧЕЙКИ ФУНКЦИИ RND
.DW	RNDSAV	FLEN/2			;ТЕКУЩЕЕ ЗНАЧЕНИЕ RND


.DW	USRTAB	10.			;ТАБЛИЦА АДРЕССОВ USR


.DW	WRITE				;АДРЕС ДРАЙВЕРА
.DW	IODEV				;НОМЕР ТЕКУЩЕГО ФАЙЛА
.DW	SAVJMP				;ЯЧЕЙКА ХРАНЕНИЯ ТЕКУЩЕГО ЗНАЧЕНИЯ УКАЗАТЕЛЯ
					;ВЫПОЛНЯЕМОЙ ПРОГРАММЫ
.DW	PNTSAV				;РАБОЧАЯ ЯЧЕЙКА ШАГА
.DW	PFACT	2			;УКАЗАТЕЛЬ БЛОКА ПАРАМЕТРОВ ДЛЯ FN
.DW	TMPSP				;УКАЗАТЕЛЬ СПИСКА ВРЕМЕННЫХ ДЕСКРИПТОРОВ
.DW	$SCRT				;РАБОЧАЯ ПЕРЕМЕННАЯ DRAW
.DW	LPTPOS				;СЧЕТЧИК ГОЛОВКИ ПРИНТЕРА
.DW	LPLCFL				;ПРИЗНАК РУССКОГО РЕГИСТРА ПРИНТЕРА


;------------------------------------------------------------------------------
; [1988~] переменные: 8 из 11 есть в DAT.MAC (8 с тем же размером): LL ..
;     RUSLAT
;------------------------------------------------------------------------------
.DW	LL				; ДЛИНА СТРОКИ ЭКРАНА
.DW	MIDLE				; СМЕЩЕНИЕ СТРОК К ЦЕНТРУ ЭКРАНА
.DW	ENDBUF				; КОНЕЦ ЭКРАННОГО БУФЕПА
.DB	KOM2P				; ПРИЗНАК КОДОВ ИЗ 2-ОЙ КОМ.СИСТ.
.DB	SCRL				; ПРИЗНАК "ПЕРЕМОТКИ" ЭКРАНА
.DW	CURS				; МЕСТО КУРСОРА В БУФЕРЕ
.DW	TABX				; МЕСТО
.DW	TABY				;       КУРСОРА НА ЭКРАНЕ
.DW	FIRST			; Начало очереди клавиатуры (IO.MAC)
.DW	LAST			; Конец очереди клавиатуры
.DW	RUSLAT			; Режим РУС/ЛАТ (200 - РУС)

;------------------------------------------------------------------------------
; [НОВОЕ] переменные Турбо (в DAT.MAC 1988 нет): GRPEN .. CHRBOX (3)
;------------------------------------------------------------------------------
.DW	GRPEN			; Графика: цвет пера
.DW	GRPAP			; Графика: цвет фона
.DW	CHRBOX			; Графика: цвет рамки знака


;------------------------------------------------------------------------------
; [1988=] переменные из DAT.MAC без изменений: CHAR .. MAG (7)
;------------------------------------------------------------------------------
.DW	CHAR			; Графика: цвет знака
.DW	PAPER			; Графика: цвет бумаги
.DW	CRTGRP			; Графика: признак режима (CRTGRP)



					;ХРАНЕНИЕ ВЕКТОРОВ ПРЕРЫВАНИЯ
.DW	SAUG	14			;И КОМАНД ПЕРЕЗАПУСКА СИСТЕМЫ

.DW	BRKFLG				;ФЛАГ BREAK

.DW	PARAM	5			;БЛОК ПАРАМЕТРОВ ДРАЙВЕРОВ

.DW	MAG	MAGSIZ/2

;------------------------------------------------------------------------------
; [НОВОЕ] переменные Турбо (в DAT.MAC 1988 нет): INCNMB .. ApdBuf (45)
;------------------------------------------------------------------------------
				; Диск: счётчик (в закомментированном коде)
.DW	INCNMB
.DB	ASCFLG			; Признак ASCII (DISK, JMP, MONIT)
.DB	ENDFLG			; Признак конца файла (DISK)
.DW	BLKCNT			; Диск: счётчик блоков
.DW	BUFCNT			; Диск: счётчик байтов в буфере
.DW	WSCCA			; Не используется

.DW	APRL	15			; ТАБЛИЦА НЕЯВНОГО ОПРЕДЕЛЕНИЯ ТИПОВ
.DW	LABTOP				;
					; ПЕРЕМЕНЫЕ ДРАЙВЕРА ТУРБО-ГРАФИКИ

.DW	RADR				; АДРЕС НАЧАЛА ВИДЕО ПАМЯТИ
.DW	RWIDTH				; ИСТИНАЯ ШИРИНА СТРОКИ В ОКТЕТАХ
.DW	HOTKB				; КОД ПОСЛЕДНЕЙ НАЖАТОЙ КЛАВИШИ (УК)
.DW	KBBIT				; БИТОВАЯ МАСКА НАЖАТЫХ КЛАВИШ
.DW	DRVREG				; РЕГИСТР СОСТОЯНИЯ ГРАФИЧЕСКОГО КАНАЛА
.DB	CODP				; КОД ГРАФИЧЕСКОЙ КОМАНДЫ
.DB	PASSW				; ПАРОЛЬ EXECUTE = 20
.DW	WORK0				; РАБОЧИЕ ЯЧЕИКИ
.DW	WORK1
.DW	WORK2
.DW	WORK3
.Dw	Sc12Id				; Признак Screen 12 (Ibm 640*480)
.Dw	ApdId				; Признак добавления к файлу
.DW	EXTFLG				; ФЛАГ ПРИСУТСВИЯ IDE

					; ПЕРЕМЕНЫЕ ДРАЙВЕРА ДИСКОВОЙ ПОДДЕРЖКИ IDE

.DB	PCOD				; КОД ОПЕРАЦИИ
.DB	PREADY				; ФЛАГ ГОТОВНОСТИ ЦП
.DW	PNAME	4			; ИМЯ ФАЙЛА
.DW	PBLOCK				; СТАРТОВЫЙ БЛОК
.DW	PLEN				; ДЛИНА УЧАСТКА ФАЙЛА В БЛОКАХ
.DW	PERR				; КОД ОШИБКИ


					; ЗАПРОС СЛЕДУЮЩЕЙ СТРОКИ ПРИ КОМПИЛЯЦИИ
.DW	CPCD				; КОД
.DW	EXTSP				; ЯЧЕЙКА ДЛЯ СОХРАНЕНИЯ SP
.DW	RTI100			; Вектор таймера, сохраняется для ADDRMN
.DW	SAV474				; Ячейка для сохранения вектора 474
.Db	DbgId				; Признак Debug Information
.Db	TboId				; Признак создания .tbo файла
.Dw	MemAvl			; Свободная память (считает PPIO, читает IDE)

.DW	CURTAB			; Таблица разбора имени (PPIO)

.DB	DEVNAM	4		; Устройство
.DB	FLENAM	7		; Имя файла
.DB	EXTNAM	4		; Расширение
.DB	MASKID			; Признак маски в имени


.DB	DEFALT	14.		; Имя по умолчанию (DK:*.BAS)
.DB	FLMASK	14.		; Буфер маски
.DW	DS			; Адрес TEXT (MONIT, читает IDE)
.Dw	ES			; Блок запуска процедуры ПП (SETW, MONIT)
.Dw	ApdBuf	24.		; Буфер добавления к файлу (DISK)



;------------------------------------------------------------------------------
; [1988~] переменные: 3 из 3 есть в DAT.MAC (1 с тем же размером): BUFFIL ..
;     BUFOUT
;------------------------------------------------------------------------------
.DW	BUFFIL	400			;Буфер файла
.DW	BUF	200			;БУФЕР ВВОДА
.DW	BUFOUT	14			;БУФЕР ВЫВОДА
BEND	== Count
EndCPV	== Count

.Asect
.	= Count

	.Even
	.END

