
;------------------------------------------------------------------------------
; START - загрузчик Turbo.Sav (RT-11, SAV): печатает баннер, расшифровывает
; таблицу оверлеев (3 слова на запись: адрес, длина в словах, номер блока; с
; адреса 1400, 200 слов), затем читает по записям части Ide.Sav и Basic.Sav
; через канал 17 (файл Turbo.Sav), расшифровывает каждую и вызывает по адресу.
; Часть, вернувшая C = 1, завершает работу. Ошибка чтения - сообщение и выход.
; Таблицу и части шифрует XLINK.MAC (тот же Crypt). Запись из нулей не
; проверяется (длина 0 в Crypt дала бы 65536 слов)
;------------------------------------------------------------------------------
	.MCall	.ReadW ..V1..
	..V1..			; Макрос ..V1.. из SYSMAC (формат вызова .ReadW)
.Asect				; Абсолютная секция
.=	40			; Ячейки 40-50 заголовка SAV
.Word	Start,Start,1000,0,2000	; 40 старт, 42 SP, 44 JSW, 46 USR, 50 предел

.=	1000			; Код загрузчика с адреса 1000
Start:
	Mov	#BeginText,r0	; R0 -> баннер
	Emt	351		; .PRINT (EMT 351)
	Mov	#1400,r5	; R5 -> таблица оверлеев (1400)
	Mov	r5,r2		; R2 = адрес таблицы
	Mov	#200,r3		; R3 = 200 слов
	Call	Crypt		; Расшифровать таблицу


1$:
	.ReadW	17,(r5),2(r5),4(r5)	; Канал 17: адрес (R5), слов, блок
	Bcs	2$		; Ошибка чтения => сообщение
	Mov	(r5)+,r2	; R2 = адрес оверлея
	Mov	(r5)+,r3	; R3 = длина в словах
	Tst	(r5)+		; Пропустить номер блока
	Call	Crypt		; Расшифровать прочитанное
	Push	r5		; Запомнить указатель таблицы
	Call	@-6(r5)		; Вызвать оверлей по его адресу
	Pop	r5		; Вернуть указатель
	Bcs	3$		; C = 1 => выход
	Br	1$		; Следующая запись таблицы


2$:	Mov	#IoError,R0	; R0 -> сообщение
	Emt	351		; .PRINT (EMT 351)
3$:	Emt	350		; .EXIT (EMT 350)

;------------------------------------------------------------------------------
; Crypt - потоковый шифр (шифрование и расшифровка совпадают): R2 -> данные,
; R3 = число слов. Ключ - сдвиговый регистр R0:R1 с обратной связью при смене
; знака; слово данных XOR R0
;------------------------------------------------------------------------------
Crypt:
	Push	r5		; Сохранить R5
	Mov	#1,R5		; R5 = 1: сдвиг на разряд
	Mov	#40,r4		; R4 = 40: бит обратной связи
	Mov	#^rOWG,r0	; R0:R1 - начальное значение ключа
	Mov	#^rELJ,r1	; (Radix-50: OWG = 24927., ELJ = 8490.)
1$:	Ashc	r5,r0		; Сдвинуть R0:R1 влево на R5
	Bvc	3$		; Знак не менялся (V = 0) =>
	Bis	r4,r1		; Иначе бит 5 в R1
3$:	Xor	r0,(r2)+	; Слово данных XOR старшее слово R0
	Sob	r3,1$		; Все слова
	Pop	r5		; Вернуть R5
	Return			; Возврат









BeginText:
	.Asciz	/The Turbo Basic, Copyright (C) 1994 to 1995, by Gerasimov Oleg/
IoError:
	.Asciz	/Error reading overlay.../
	.Even
Area:
	.End
