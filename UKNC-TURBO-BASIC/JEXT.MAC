
;------------------------------------------------------------------------------
; [НОВОЕ] модуль почти целиком: в Бейсике Вильнюс 1988 аналога нет; ниже
;     отмечены только блоки, найденные в 1988
;------------------------------------------------------------------------------

	; EXTENDED BASIC INSTRUCTION
	; WRITTEN BY GERASIMOV OLEG
	; IN 22.01.1995


	.Mcall	.ReadW .WritW .Close .Purge .Enter .CsiSpc .LookUp	; RT-11
	.PSECT	BASIC		; Секция кода Бейсика


;------------------------------------------------------------------------------
; JEXT - расширенные операторы Turbo Basic (Герасимов, 22.01.1995): циклы
; REPEAT/UNTIL и WHILE/WEND, графические образы GET/PUT, палитра, пауза,
; прямой доступ к файлам RT-11, шрифт, звук. Это обработчики шитого кода (по
; одному на оператор, конец - JMP @(R4)+); компилируют их подпрограммы COMP.MAC.
; Многие операторы работают с ПП через ячейки DT.MAC: WORK0..WORK3 (аргументы),
; CODP (код процедуры драйвера TGRAPH, F0-F25), PpExe (GRAFUK.MAC).
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: D$Num. служебный обработчик: NUMBER :=
;     номер строки (операнд вставляет PCOMP); в 1988 аналога нет.
;------------------------------------------------------------------------------
D$Num::	Mov	(r4)+,Number	; NUMBER = номер строки (вставляет PCOMP)
	Jmp	@(r4)+		; Дальше


;------------------------------------------------------------------------------
; $REPT / $UNTIL - REPEAT / UNTIL. Кадр REPEAT в стеке кадров (CIKL): адрес
; тела и маркер 125252; UNTIL при ложном условии возвращается к телу.
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: $REPT, $UNTIL (блоков: 2). REPEAT/UNTIL:
;     кадр цикла в общем стеке кадров CIKL (как у FOR/GOSUB 1988), но со своим
;     маркером 125252.
;------------------------------------------------------------------------------
$REPT::
	MOV	CIKL,R0		; R0 -> вершина стека кадров
	MOV	#125252,-(R0)	; Маркер кадра REPEAT
	MOV	R4,-(R0)	; Адрес тела цикла
	CMP	ENDCOD,R0	; Есть место?
	BMI	1$		; да =>
	TRAP	7		; Ошибка 7: переполнение памяти
1$:	MOV	R0,CIKL		; Новая вершина
	JMP	@(R4)+		; Дальше

$UNTIL::
	MOV	CIKL,R0		; R0 -> вершина стека кадров
	CMP	2(R0),#125252	; Кадр REPEAT?
	BEQ	2$		; да =>
	TRAP	1		; Ошибка 1: UNTIL без REPEAT
2$:	TST	(SP)+		; Снять условие
	BNE	3$		; Истина => выйти из цикла
	MOV	(R0),R4		; Ложь: R4 = начало тела цикла
	JMP	@(R4)+		; Повторить тело
3$:	CMP	(R0)+,(R0)+	; Снять кадр
	MOV	R0,CIKL		; Новая вершина
	JMP	@(R4)+		; Дальше


;------------------------------------------------------------------------------
; $WHILE / $WEND - WHILE / WEND. Код: условие, $WHILE, операнд, тело, $WEND,
; 0. Операнд WHILE при компиляции - начало условия (меньше адреса), при первом
; выполнении ищется свой WEND (глубина вложенности R2): операнд WEND := начало
; условия, операнд WHILE := адрес за WEND (выход).
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: $WHILE, $WEND (блоков: 2). WHILE/WEND:
;     кадров нет, парный WEND при первом выполнении ищется по тексту с учётом
;     вложенности.
;------------------------------------------------------------------------------
$WHILE::
	CMP	(R4),R4		; Операнд указывает вперёд (уже разобран)?
	BPL	11$		; да =>
	MOV	#1,R2		; R2 = 1: глубина вложенности WHILE
	MOV	R4,R1		; R1 -> код за WHILE
5$:	TST	(R1)+		; Следующее слово кода
	CMP	STRREG,R1	; Конец кода?
	BPL	6$		; нет =>
	TRAP	1		; Ошибка 1: WHILE без WEND
6$:	CMP	#$WEND,(R1)	; Слово = $WEND?
	BNE 	7$		; нет =>
	DEC	R2		; Глубина - 1
	BEQ 	8$		; Нашли свой WEND =>
7$:	CMP	#$WHILE,(R1)	; Слово = $WHILE (вложенный)?
	BNE	5$		; нет => дальше
	INC	R2		; Глубина + 1
	BR	5$		; Дальше
8$:	MOV	(R4),2(R1)	; Операнд WEND := начало условия (из WHILE)
	CMP	(R1)+,(R1)+	; R1 -> код за WEND
	MOV	R1,(R4)		; Операнд WHILE := выход из цикла

11$:	TST	(SP)+		; Снять условие
	BNE	10$		; Истина => войти в цикл
	MOV	(R4)+,R4	; Ложь: переход за WEND
	JMP	@(R4)+		; Дальше
10$:	TST	(R4)+		; Пропустить операнд
	JMP	@(R4)+		; Тело цикла

$WEND::	TST	(R4)		; Операнд (начало условия) задан?
	BNE	1$		; да =>
	TRAP	1		; Ошибка 1: WEND без WHILE
1$:	MOV	(R4)+,R4	; Переход на условие WHILE
	JMP	@(R4)+		; Дальше



;------------------------------------------------------------------------------
; $GET - GET (x1, y1)-(x2, y2), массив: образ экрана. На стеке: адрес, Y2, X2,
; Y1, X1. Образ: слово - ширина (точек), слово - высота, затем строки по октетам
; (на каждый октет три байта: плоскость 0, 1, 2). Плоскость 0 доступна только ПП
; (F24 параллельно), плоскости 1, 2 ЦП читает окном 176640/176642. Адреса строк
; убывают (RAdr - Y * RWidth + X / 8).
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: $GET, Shift, E5, MULADR (блоков: 4). GET
;     (x1,y1)-(x2,y2),массив: образ экрана в массив, три плоскости видеопамяти
;     (плоскость 0 читает ПП, F24); в 1988 нет.
;------------------------------------------------------------------------------
$GET::
	Pop	R5		; Адрес для сохранения образа
	Pop	r2		; Координата Y2
	Call	TsSc12		; Y в систему координат ПП
	Mov	r2,r3		; Сохранить Y2 для вычисления высоты
	Pop	r0		; Координата X2
	Pop	R2		; Координата Y1
	Call	TsSc12		; Y в систему координат ПП
	Mov	r2,r1		;
	Pop	R2		; Координата X1
	Sub	r1,r3		; Вычисление высоты в видео строках
	Bhi	1$		; Если отрицательна - обмен координат
	Neg	r3		; Y2 < Y1: высота = модуль
	Sub	r3,r1		; R1 = меньший Y
1$:	Sub	r2,r0		; Вычисление ширины в пикселах
	Bmi	e5		; X2 < X1 => ошибка 5
	Inc	r0		; Ширина в точках
	Inc	r3		; Высота в строках
	Mov	r0,(r5)		; Заголовок образа: ширина
	Mov	r3,2(r5)	; и высота
	Push	r2		; Сохранение ширины в пикселах
	Call	MulAdr		; Вычисление видео адреса строки
	Pop	r2		; R2 = X1
	Bic	#^C7,r2		; число пикселов сдвига
	Neg	r2		; R2 = сдвиг вправо для выравнивания
; Копирование в буффер.
; входные параметры:
; r1 - адрес ВОЗУ
; r5 - массив :0(r5) - ширина ; 2(r5) - высота
; r2 - количество пикселов для выравнивания по границе байта

	Mov	r1,@#176640	; Адрес видеопамяти - в окно ЦП 176640
	Push	r4		; Сохранить R4
	Mov	(r5)+,r3	; Ширина в точках
	Dec	r3		; Минус 1
	Ash	#-3,r3		; Перевод в октеты
	Inc	r3		; Для точности
	Mov	(r5)+,4$	; Высота спрайта
	Mov	#<Buf+260>/2,Work0	; Команда для ПП
	Mov	r3,Work2	; WORK2 = байт в строке
	Inc	Work2		; Плюс 1
6$:	Push	r3		; Сохранение ширины


	Push	r5		; Сохранить R5
	Inc	r3		; Байт в строке + 1
	Mov	#176640,r4	; Адрес регистра данных ВОЗУ
	Mov	#Buf,r5		; R5 -> буфер Buf
	Mov	(r4),Work1	; WORK1 = видеоадрес строки
	Mov	#10000+24.,CodP	; Паралельное заполнение буфера из ПП

5$:	Movb	2(r4),130(r5)	; Байт плоскости 1 - в Buf+130
	Movb	3(r4),(r5)+	; Байт плоскости 2 - в Buf
	Inc	(r4)		; Следующий адрес
	Sob	r3,5$		; Вся строка
	Mov	2(Sp),r3	; R3 = байт в строке
	Clrb	DrvReg		; Сбросить признак готовности
	Tstb	DrvReg		; Ждать ПП
	Bpl	.-4		; нет => ждать
	Call	Shift		; Выровнять строку по границе байта
	Dec	(r4)		; Вернуть адрес

	Pop	r5		; Вернуть R5
	Mov	(Sp),r3		; R3 = байт в строке
	Mov	#Buf,r4		; R4 -> Buf
2$:	Movb	260(r4),(r5)+	; Плоскость 0 (из ПП) - в образ
	Movb	130(r4),(r5)+	; Плоскость 1
	Movb	(r4)+,(r5)+	; Плоскость 2
	Sob	r3,2$		; Вся строка

	Pop	r3		; Восстановление ширины в октетах
3$:	Sub	r3,@#176640	; К началу строки
	Sub	RWidth,@#176640	; и на строку ниже
	Dec	(pc)+		; Счётчик строк (4$)
4$:	.Word	0		; Число строк
	Bne	6$		; Все строки
	Pop	r4		; Вернуть R4
	Jmp	@(r4)+		; Дальше

; Shift - сдвиг трёх плоскостей строки в Buf на R2 бит (ASHC по словам)
Shift:
	Tst	r2		; Сдвиг нужен?
	Beq	4$		; нет => выход
	Asr	r3		; Байт в слова
	Inc	r3		; Плюс 1
	Mov	#Buf,r5		; R5 -> плоскость
	Push	r4		; Сохранить R4
	Mov	#3,r4		; Три плоскости
1$:	Push	r5		; Запомнить плоскость
	Push	r3		; и длину
2$:	Mov	(r5)+,r1	; Младшее слово пары
	Mov	(r5),r0		; Старшее слово
	Ashc	r2,r0		; Сдвинуть 32 бита на R2
	Mov	r1,-2(r5)	; Записать результат
	Sob	r3,2$		; Все слова
	Pop	r3		; Вернуть длину
	Pop	r5		; и плоскость
	Add	#130,r5		; К следующей плоскости
	Sob	r4,1$		; Все плоскости
	Pop	r4		; Вернуть R4
4$:	Return			; Выход

; E5 - ошибка 5
E5:	TRAP 5			; Ошибка 5: неправильный вызов функции


; MULADR - адрес строки R1 (Y), R2 (X) в видеопамяти (после ожидания ПП)
MULADR:	Clrb	DrvReg		; Ждать конца команды ПП
1$:	Tstb	DrvReg
	Bpl	1$		; нет => ждать
	Ash	#-3,r2		; R2 = X / 8
	Mul	@#RWidth,R1	; R1 = Y * ширина строки
	Sub	R2,R1		; Минус X / 8
	Sub	RAdr,R1		; Минус начало видеопамяти
	Neg	R1		; R1 = RAdr - Y * RWidth + X / 8
	Return			; Выход



;------------------------------------------------------------------------------
; $PUT - PUT x, y, образ, режим (0 замена, 1 XOR, 2 OR, 3 сброс). Плоскость 0
; выводит ПП (F25, WORK0..WORK3), плоскости 1, 2 - ЦП (процедура из RPUT). Края
; байтов - Bic1, Bic2 (неизменяемые биты экрана). Строка > 263. - ошибка 5.
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: $PUT, MovPut, XorPut ... RegPut (блоков:
;     12). PUT x,y,образ,режим: вывод образа (замена, XOR, OR, сброс);
;     плоскость 0 пишет ПП (F25), остальные - MovPut/XorPut/BisPut/BicPut; в
;     1988 нет.
;------------------------------------------------------------------------------
$PUT::	Mov	(SP)+,R5	; Режим (0-3)
	Cmp	r5,#3		; Больше 3?
	Bhi	e5		; да => ошибка 5
	Movb	r5,Work2+1	; Режим - в старший байт WORK2
	Asl	R5		; Индекс * 2
	Mov	Rput(R5),RegPut	; Процедура вывода образа

	Mov	(SP)+,R5	; R5 -> образ
	Mov	(SP)+,R2	; Y
	Call	TsSc12		; Y в систему координат ПП
	Mov	r2,r1		; R1 = Y
	Tst	Sc12Id		; Режим Screen 12?
	Beq	1$		; нет =>
	Sub	2(r5),r1	; Y - высота (верх образа)

1$:	Mov	(SP)+,R2	; R2 = X


	Cmp	r1,#263.	; Y больше 263.?
	Bhi	e5		; да => ошибка 5
	Mov	r1,r3		; R3 = Y
	Add	2(r5),r3	; Плюс высота
	Cmp	r3,#263.	; Больше 263.?
	Bhi	e5		; да => ошибка 5

	Push	r4		; Сохранить R4
	Push	r2		; и X
	Call	MulAdr		; R1 = адрес строки
	Pop	r2		; R2 = X
	Bic	#^c7,r2		; X mod 8
	Movb	Bit1(r2),Bic1	; Маска сохраняемых бит слева
	Mov	r2,r3		; R3 = X mod 8
	Add	(r5),r3		; Плюс ширина
	Mov	r3,r4		; R4 = то же
	Bic	#^c7,r4		; Остаток
	Movb	Bit2(r4),Bic2	; Маска сохраняемых бит справа

	Dec	r3		; Минус 1
	Ash	#-3,r3		; В байты
	Inc	r3		; Байт в строке на экране
	Push	r3		; Запомнить

	Mov	r1,@#176640	; Адрес видеопамяти - в окно ЦП
	Mov	(R5)+,r3	; R3 = ширина образа
	Dec	r3		; Минус 1
	Ash	#-3,r3		; В байты
	Inc	r3		; Байт в строке образа
	Mov	(r5)+,10$	; Число строк - в счётчик (10$)
	Mov	#<Buf+260>/2,Work0	; WORK0 = адрес плоскости 0 в ЦП
	Movb	(Sp),Work2	; WORK2 = байт на экране
	Clr	Work1		; WORK1 = 0
	Mov	Bic1,Work3	; WORK3 = ~Bic1
	Com	Work3		; для ПП

5$:	Push	r3		; Запомнить число байт


	Mov	#Buf+130,r4	; R4 -> плоскость 2
	Mov	#Buf,r0		; R0 -> плоскость 1
	Mov	#Buf+260,r1	; R1 -> плоскость 0

	Tst	Work1		; ПП занят прошлой строкой?
	Bne	.-4		; да => ждать
2$:	Movb	(r5)+,(r1)+	; Байт плоскости 0
	Movb	(r5)+,(r0)+	; плоскости 1
	Movb	(r5)+,(r4)+	; плоскости 2
	Sob	r3,2$		; Вся строка образа

	Mov	(Sp),r3		; R3 = байт на экране
	Push	r5		; Запомнить R5
	Call	Shift1		; Выровнять по X mod 8

	Mov	4(Sp),r3	; R3 = байт на экране
	Add	#Buf-1,r3	; R3 -> последний байт
	Bicb	Bic2,(r3)	; Очистить сохраняемые справа биты
	Bicb	Bic2,130(r3)	; во всех
	Bicb	Bic2,260(r3)	; трёх плоскостях


	Mov	4(Sp),r3	; R3 = байт на экране

	Mov	#176640,r4	; R4 -> окно ЦП 176640
	Mov	(r4),Work1	; WORK1 = видеоадрес
	Mov	#10000+25.,CodP	; Команда ПП: F25 (плоскость 0), пароль 20
	Mov	#Buf+130,r5	; R5 -> плоскость 2

	Call	@RegPut		; Плоскости 1 и 2 - CPU


	Pop	r5		; Вернуть R5
	Pop	r3		; и R3
	Sub	(Sp),(r4)	; К началу строки
	Sub	RWidth,(r4)	; и на строку ниже
	Dec	(pc)+		; Счётчик строк (10$)
10$:	.Word	0		; Число строк
	Bne	5$		; Все строки
	Tst	(Sp)+		; Снять запомненное

	Pop	r4		; Вернуть R4
	Clrb	DrvReg		; Ждать конца команды ПП
	Tstb	DrvReg
	Bpl	.-4		; нет => ждать

	JMP	@(R4)+		; Дальше




; MovPut - вывод строки образа с заменой (плоскости 1 и 2; края - Bic1, Bic2)
MovPut:
	Movb	Bic1,r0		; Сохраняемые слева биты
	Dec	r3		; Ширина - 1
	Beq	4$		; Один байт =>
	Comb	r0		; Биты для записи
	Bicb	r0,2(r4)	; Очистить в плоскости 1
	Bicb	r0,3(r4)	; и 2
	Bisb	-130(r5),2(r4)	; Записать образ в плоскость 1
	Bisb	(r5)+,3(r4)	; и 2
	Br	6$		; Дальше

3$:	Movb	-130(r5),2(r4)	; Средний байт: плоскость 1
	Movb	(r5)+,3(r4)	; и 2
6$:	Inc	(r4)		; Следующий адрес
	Sob	r3,3$		; Все байты
	Clr	r0		; R0 = 0

4$:	Bisb	Bic2,r0		; Последний байт: сохраняемые справа биты
	Comb	r0		; Биты для записи
	Bicb	r0,2(r4)	; Очистить в плоскости 1
	Bicb	r0,3(r4)	; и 2
	Bisb	-130(r5),2(r4)	; Записать образ в плоскость 1
	Bisb	(r5)+,3(r4)	; и 2
	Inc	(r4)		; Следующий адрес
	Return			; Выход




; XorPut / BisPut / BicPut - вывод строки образа через XOR, OR, AND NOT
XorPut:
	Mov	#Buf,r5		; R5 -> плоскости
1$:	Clr	r0		; R0 = 0
	Bisb	130(r5),r0	; Старший байт - плоскость 2
	Swab	r0		; на место
	Bisb	(r5)+,r0	; Младший - плоскость 1
	Xor	r0,2(r4)	; XOR с экраном
	Inc	(r4)		; Следующий адрес
	Sob	r3,1$		; Все слова
	Return			; Выход

BisPut:
1$:	Bisb	-130(r5),3(r4)	; OR: плоскость 2
	Bisb	(r5)+,2(r4)	; и 1
	Inc	(r4)		; Следующий адрес
	Sob	r3,1$		; Все слова
	Return			; Выход

BicPut:
1$:	Bicb	-130(r5),3(r4)	; AND NOT: плоскость 2
	Bicb	(r5)+,2(r4)	; и 1
	Inc	(r4)		; Следующий адрес
	Sob	r3,1$		; Все слова
	Return			; Выход



; Shift1 - сдвиг трёх плоскостей на R2 бит с конца строки, левый край - Bic1
Shift1:
	Tst	r2		; Сдвиг нужен?
	Beq	4$		; нет => выход
	Mov	#Buf,r5		; R5 -> плоскость
	Push	r4		; Сохранить R4
	Mov	#3,r4		; Три плоскости
2$:	Push	r5		; Запомнить плоскость
	Push	r3		; и длину

	Add	r3,r5		; R5 -> конец строки
	Asr	r3		; Байт в слова
	Inc	r3		; Плюс 1
1$:
	Mov	(r5),r0		; Старшее слово пары
	Mov	-(r5),r1	; Младшее слово
	Ashc	r2,r0		; Сдвинуть 32 бита на R2
	Mov	r0,2(r5)	; Записать результат
	Sob	r3,1$		; Все слова (с конца)

	Pop	r3		; Вернуть длину
	Pop	r5		; и плоскость
	Add	#130,r5		; К следующей плоскости
	Sob	r4,2$		; Все плоскости
	Pop	r4		; Вернуть R4
	Bicb	Bic1,Buf	; Очистить сдвинутый мусор слева
	Bicb	Bic1,Buf+130	; во всех
	Bicb	Bic1,Buf+260	; трёх плоскостях
4$:	Return			; Выход



; Bit1 - сохраняемые слева биты (X mod 8); Bit2 - справа ((X + ширина) mod 8)
Bit1:
	.Byte	^B00000000	; X mod 8 = 0
	.Byte	^B00000001	; 1
	.Byte	^B00000011	; 2
	.Byte	^B00000111	; 3
	.Byte	^B00001111	; 4
	.Byte	^B00011111	; 5
	.Byte	^B00111111	; 6
	.Byte	^B01111111	; 7

Bit2:
	.Byte	^b00000000	; (X + ширина) mod 8 = 0
	.Byte	^b11111110	; 1
	.Byte	^b11111100	; 2
	.Byte	^b11111000	; 3
	.Byte	^b11110000	; 4
	.byte	^b11100000	; 5
	.Byte	^b11000000	; 6
	.Byte	^b10000000	; 7


; RPUT - процедуры вывода образа по режиму
RPUT:
	.Word	MovPut		; Режим 0: замена
	.Word	XorPut		; 1: XOR
	.Word	BisPut		; 2: OR
	.Word	BicPut		; 3: сброс

Bic1:	.Byte	0		; Сохраняемые слева биты
Bic2:	.Byte	0		; Сохраняемые справа биты
RegPut:	.Word	0		; Процедура вывода образа







;------------------------------------------------------------------------------
; $PALET - PALETTE: F5 драйвера ПП (замена цвета в палитре)
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: $PALET. PALETTE: команда F5 драйвера ПП.
;------------------------------------------------------------------------------
$PALET::
	MOV	(SP)+,WORK0	; WORK0 = цвет 2
	MOV	(SP)+,WORK1	; WORK1 = цвет 1
	MOV	#5,CODP		; Команда ПП: F5 (палитра)
	CALL	PPEXE		; Выполнить
	JMP	@(R4)+		; Дальше


;------------------------------------------------------------------------------
; $Delay - DELAY n: n секунд * 50. тиков; ожидание счётом прерываний таймера
; (вектор 100, Int100 увеличивает R2). Отрицательное n - бесконечное ожидание
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: $Delay, Int100 (блоков: 2). DELAY n:
;     ожидание n секунд счётом тиков таймера 100 (Int100).
;------------------------------------------------------------------------------
$Delay::
	Mov	r4,SavJmp	; Запомнить R4
	Jsr	R4,STAND	; Выполнить шитый код:
	.Word	SConst		; Вещественная константа
	.Word	0,41510		; 50.0 (тиков в секунду)
	.Word	Mlr		; Умножить
	.Word	Ri		; В целое
	.Word	2$		; Затем 2$ (машинная часть)

2$:	Pop	r1		; R1 = число тиков
	Mov	SavJmp,r4	; Вернуть R4
	Clr	SavJmp		; Сбросить
	Mov	@#100,Sav100	; Запомнить вектор таймера
	Mov	#Int100,@#100	; Вектор таймера - наш
	Mfps	-(Sp)		; Сохранить PS
	Mtps	#0		; Прерывания разрешены
	Clr	r2		; R2 = счётчик тиков
1$:	Cmp	r2,r1		; Время вышло?
	Bne	1$		; нет => ждать
	Mtps	(Sp)+		; Вернуть PS

Sav100	= .+2			; Операнд команды ниже - прежний вектор
	Mov	#0,@#100	; Вернуть вектор таймера
	Jmp	@(4)+		; Дальше

Int100:				; Тик
	Inc	r2		; R2 + 1
	Rti			; Выход из прерывания

;------------------------------------------------------------------------------
; .$Read, .$Write, .$Purge, .$Close, .$Open, .$Creat - операторы _READ, _WRITE,
; _PURGE, _CLOSE, _OPEN, _CREATE: EMT RT-11 по каналу из стека (.ReadW и .WritW:
; канал, буфер, слова, блок). Ошибки RT-11 не проверяются. GtFNam: имя из
; строки (до 15 символов) через .CsiSpc в Buf+156
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: .$Read, .$Write, .$Purge ... GtFNam
;     (блоков: 7). _-операторы RT-11 (..READ, ..WRITE, ..PURGE, ..CLOSE,
;     ..OPEN, ..CREATE): EMT RT-11 напрямую, ошибки не проверяются; GtFNam
;     разбирает имя.
;------------------------------------------------------------------------------
.$Read::
	.ReadW	#Param,6(Sp),4(Sp),2(Sp),(Sp)	; Читать (см. заголовок)
	Add	#10,Sp		; Снять 4 слова
	Jmp	@(r4)+		; Дальше

.$Write::
	.WritW	#Param,6(Sp),4(Sp),2(Sp),(Sp)	; Писать (см. заголовок)
	Add	#10,Sp		; Снять 4 слова
	Jmp	@(r4)+		; Дальше

.$Purge::
	.Purge	(Sp)+		; Освободить канал
	Jmp	@(r4)+		; Дальше

.$Close::
	.Close	(Sp)+		; Закрыть канал
	Jmp	@(r4)+		; Дальше

.$Open::
	Mov	(Sp)+,r1	; R1 = длина имени
	Mov	(Sp)+,r0	; R0 -> имя
	Call	GtFNam		; Имя - в Buf, разобрать
	.LookUp	#Param,(sp)+,#Buf+156	; Открыть файл (ошибка не проверяется)
	Jmp	@(r4)+		; Дальше

.$Creat::
	Mov	(Sp)+,r1	; R1 = длина имени
	Mov	(Sp)+,r0	; R0 -> имя
	Call	GtFNam		; Имя - в Buf, разобрать
	.Enter	#Param,(sp)+,#Buf+156,#-1	; Создать файл
	Jmp	@(r4)+		; Дальше



GtFNam::
	Mov	#Buf,r2		; R2 -> Buf
	Bic	#177760,r1	; Длина (до 15)
	Beq	2$		; Пустое имя =>
1$:	Movb	(r0)+,(r2)+	; Имя - в Buf
	Sob	r1,1$		; Все символы
	Clrb	(r2)+		; Конец строки
	Mov	Sp,R3		; Запомнить SP (.CSISPC)
	.CsiSpc	#Buf+120,#0,#Buf	; Разобрать имя: Buf -> Buf+120
	Mov	R3,Sp		; Снять ключи со стека
2$:	Return			; Выход


;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: $Fsave, $Fload (блоков: 2). FSAVE/FLOAD:
;     шрифт ПП в файл и из файла .FNT через команды F21/F22 драйвера (образ 11
;     байт на символ).
;------------------------------------------------------------------------------
;──────────────────────────────────────────────────────────────────────────────
;	Оператор Fsave - запись текущего шрифта в файл
;	Входные параметры :
;	(Sp) - Номер последего символа
;	2(Sp) - Номер начального символа
;	4(Sp) - Дескриптор строки имени файла
$Fsave::
	Mov	r4,@#SavJmp	; Сохранить счетчик
	Call	CloAll		; Закрыть все открытые файлы
	Mov	(Sp)+,r0	; Код последнего символа
	Call	TstFnt		; Проверка кода на допустимость
	Mov	r0,r4		;
	Mov	(Sp)+,r0	; Код первого симола
	Call	TstFnt		; Проверка на допустимость
	Mov	r0,r5		;
	Sub	r4,r5		; Число образов для записи = Last-First
	Blos	10$		; Оно положительно ?
	Trap	5		; Нет - ошибка.
10$:	Neg	r5		; R5 = число символов
	Inc	r5		;
	Mov	r0,Work0	; Код первого симола
	Mov	r5,r1		; Вычисление длины файла.
	Mul	#13,r1		; Len = (Last-First)*11+8 (Bytes)
	Asr	r1		; Длина в словах
	Cmp	(r1)+,(r1)+	; Плюс 4 слова (заголовок)
	Mov	EndCod,r2	; Адрес начала свободной памяти
	Mov	#Mag,r0		; Адрес МП устройств
	Mov	#Wr.*400,(r0)+	; Операция - запись
	Mov	#11,(r0)+	; Тип устройства
	Mov	r2,20(r0)	; Занесение в МП начального адреса
	Mov	r1,22(r0)	; - // - // длины (в словах)
	Mov	r2,r3		; Памяти хватит
	Asl	r1		; Длина в байтах
	Add	r1,r3		; Конец данных
	Cmp	r3,Cikl		; Влезает до стека кадров?
	Blo	1$		; ?
	Trap	7		; Нет - ошибка.
1$:	Mov	#"FN,(r2)+		; Идентификатор файла
	Movb	Work0,(r2)+	; Первый символ
	Movb	r5,(r2)+	; Количество символов
2$:	Mov	#Buf,r3		; R3 -> Buf
	Mov	r3,Work1	; Адрес буфера для считывания из ПП
	Mov	#22.,CodP	; Код команды для ПП (GetFont)
	Call	PpExe		; Выполнение команды ПП
3$:	Tstb	DrvReg		; Ожидание готовности ПП
	Bpl	3$		; нет => ждать
	Mov	#13,r1		; Копирование образа из буфера
4$:	Movb	(r3)+,(r2)+	; Байт образа
	Inc	r3		; Пропустить старший байт
	Sob	r1,4$		; Цикл для 11. строк
	Inc	Work0		; Увеличить номер текущего символа
	Sob	r5,2$		; Цикл для всех образов
	Mov	SavJmp,r4	; Вернуть R4
	Call	$Fnt		; Проверка имени файла на допустимость
	Mov	r4,SavJmp	; Запомнить R4
	Call	Cas		; Выполнение записи
	Mov	@#SavJmp,r4	; Востановление счетчика
	Clr	@#SavJmp	; Сброс
	Jmp	@(r4)+		; Конец оператора



;──────────────────────────────────────────────────────────────────────────────
;	Оператор Fload - чтение шрифта из файлa
;	Входные параметры :
;	(Sp) - адрес дескриптора строки имени файла

$Fload::			; Загрузка шрифта из файла
	Call	CloAll		; Закрыть все файлы
	Mov	#Mag,r0		; Адрес МП устройств
	Mov	#Rd.*400,(r0)+	; Операция - чтение
	Mov	#11,(r0)+	; Код устройства
	Mov	EndCod,r2	; Адрес начала свободной памяти
	Mov	r2,20(r0)	; Начальный адрес - в блок параметров
	Mov	Cikl,r1		; Вычисление длины свобоной памяти
	Sub	r2,r1		; Минус начало = свободно
	Asr	r1		; В слова
	Mov	r1,22(r0)	; Длина - в блок параметров
	Call	$Fnt		; Проверка имени файла
	Call	Cas		; Выполнение операции ввода/вывода
	Mov	EndCod,r2	; R2 -> начало данных
	Cmp	#"FN,(r2)+		; Файл "родной"
	Beq	1$		; - Да, продолжение .
	Trap	5		; - Нет, ошибка.
1$:	Clr	Work0		; WORK0 = 0
	Movb	(r2)+,Work0	; Код первого образа
	Clr	r5		; R5 = 0
	Bisb	(r2)+,r5	; Число образов в файле
2$:	Mov	#Buf,r3		; Адрес промежуточного буфера
	Mov	r3,Work1	; WORK1 = Buf
	Mov	#13,r1		; Число строк в образе
3$:	Movb	(r2)+,(r3)+	; Копирование в буфер
	Clrb	(r3)+		; Старший байт = 0
	Sob	r1,3$		; Следующая строка
	Mov	#21.,CodP	; Запись образа в ПП
	Call	PpExe		; Выполнить
4$:	Tstb	DrvReg		; Ждать конца команды ПП
	Bpl	4$		; нет => ждать
	Inc	Work0		; Следущий образ
	Sob	r5,2$		; Цикл для всех образов
	Jmp	@(r4)+		; Конец оператора
;──────────────────────────────────────────────────────────────────────────────

;------------------------------------------------------------------------------
; [1988~40%] изменено, JMP.MAC:1680-1681: $Fnt (1988: 3 строк кода, здесь 5;
;     добавлено/изменено 3, удалено 1). Отличия: имя файла с расширением .FNT
;     через FILNAM - по образцу $BIN в JMP.MAC (1988); FntEND то же, что
;     BINEND.
;------------------------------------------------------------------------------
; $Fnt - достроить имя файла расширением .FNT (через FILNAM, JMP.MAC)
$Fnt:
	MOV	(SP)+,R1	; R1 = адрес возврата
	JSR	R1,FILNAM	; Достроить имя файла
	MOV	#".F,(R0)+	; Расширение ".F"
	MOV	#"NT,(R0)+	; "NT"

;------------------------------------------------------------------------------
; [1988=] без изменений (JMP.MAC:1684-1687): FntEND
;------------------------------------------------------------------------------
FntEND:	MOV	#20040,(R0)+	; Пробелы
	MOV	#20040,(R0)+	; после
	MOV	#20040,(R0)+	; имени
	RTS	PC		; Выход


;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: $Cload. CLOAD: вместо 1988 ($CLOAD читал
;     блок в область TEXT) загружается .TBO (LdObj) и запускается (PRun).
;------------------------------------------------------------------------------
; $Cload - CLOAD имя: загрузить .TBO (LdObj, PPIO.MAC) и запустить (PRun)
$Cload::
	Pop	R5		; R5 = длина имени
	Pop	R3		; R3 -> имя
	Mov	#Buf,R2		; R2 -> Buf
1$:	Movb	(r3)+,(r2)+	; Имя - в Buf
	Sob	R5,1$		; Все символы
	Clrb	(r2)+		; Конец строки
	Call	LdObj		; Загрузить .TBO
	Bcc	2$		; успех =>
	Trap	50.		; Ошибка 50
2$:	Jmp	PRun		; Запустить загруженную программу


;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: $SMode. SMODE n: команда F2 драйвера
;     (режим вывода замена/XOR); не путать с SMODE в GRAFUK.MAC (режим экрана).
;------------------------------------------------------------------------------
; $SMode - SMODE n: F2 драйвера (режим вывода: замена/XOR)
$SMode::
	Mov	(Sp)+,Work0	; WORK0 = режим
	Mov	#2,CodP		; Команда ПП: F2 (режим вывода)
	Call	PpExe		; Выполнить
	Jmp	@(r4)+		; Дальше

;------------------------------------------------------------------------------
; [1988~33%] изменено, IO.MAC:1216-1218: Signal (1988: 4 строк кода, здесь 3;
;     добавлено/изменено 2, удалено 3). Отличия: SOUND 100,100 (в 1988 SIGNAL в
;     IO.MAC выводил код 7 на терминал).
;------------------------------------------------------------------------------
; Signal - SOUND 100., 100.; $Sound - SOUND (F0); $Fsoun - FSOUND (F15);
; $NSoun - NOSOUND (F16); $Page - PAGE (F18); $FPut - FPUT (F21); $FGet - F22
Signal::
	Push	#100.		; Длительность 100.
	Push	#100.		; Частота 100.
;	Br	$Sound

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: $Sound, $Fsoun, $NSoun, $Page (блоков:
;     4). SOUND/FSOUND/NOSOUND/PAGE: команды F0, F15, F16, F18 драйвера.
;------------------------------------------------------------------------------
$Sound::
	Clr	r0		; Код F0 (звук)
	Br	Cp2Pp		; Передать ПП


$Fsoun::
	Mov	#17,r0		; Код F15 (нота в очередь)
	Br	Cp2Pp		; Передать ПП

$NSoun::
	Mov	#20,CODP	; Код F16 (остановить мелодию)
	Call	PPEXE		; Выполнить
	Jmp	@(R4)+		; Дальше

$Page::
	Mov	#22,r0		; Код F18 (страницы)
	Br	Cp2Pp		; Передать ПП


;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: $FPut, $FGet, TstFnt, Cp2Pp (блоков: 4).
;     FPUT/FGET: символ шрифта в ПП и из ПП (F21, F22); TstFnt проверяет код
;     40-377, Cp2Pp передаёт аргументы со стека в WORK0/WORK1.
;------------------------------------------------------------------------------
$FPut::
	Mov	2(sp),r0	; R0 = код символа
	Call	TstFnt		; Допустим (40-377)?
	Mov	#21.,r0		; Код F21 (образ символа в ПП)
	Br	Cp2Pp		; Передать ПП

$FGet::
	Mov	2(Sp),r0	; R0 = код символа
	Call	TstFnt		; Допустим (40-377)?
	Mov	#22.,r0		; Код F22 (образ символа из ПП)
	Mov	r4,SavJmp	; Запомнить R4
	Mov	#2$,r4		; Дальше - на 2$ (ожидание)
	Br	Cp2pp		; Передать ПП
1$:	Tstb	DrvReg		; Ждать конца команды ПП
	Bpl	1$		; нет => ждать
	Mov	SavJmp,r4	; Вернуть R4
	Clr	SavJmp		; Сброс
	Jmp	@(r4)+		; Дальше
2$:	.Word	1$		; Слово кода: ожидание (1$)


; TstFnt - код символа R0 допустим (40-377), иначе ошибка 5
TstFnt:
	Cmp	r0,#377		; Код > 377?
	Bhi	1$		; да => ошибка
	Cmp	r0,#40		; Код < 40?
	Blo	1$		; да => ошибка
	Return			; Выход
1$:	Trap	5		; Ошибка 5


; Cp2Pp - со стека WORK1, WORK0, код R0 в CODP, выполнить и продолжить
Cp2Pp:
	Mov	(Sp)+,Work1	; WORK1 = верх стека
	Mov	(Sp)+,Work0	; WORK0 = следующий
	Mov	r0,CodP		; Код процедуры ПП
	Call	PpExe		; Выполнить
	Jmp	@(r4)+		; Дальше



	.End			; Конец
