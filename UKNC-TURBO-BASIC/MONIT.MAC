;------------------------------------------------------------------------------
; MONIT - запуск Бейсика в ЦП и общие подпрограммы. Монитора версии 1988 (цикл
; "Ok", NEW/LIST/RENUM/RUN, STEP/TRON) здесь нет: команды и редактор в IDE (ПП).
; START готовит ЦП и через SETW оставляет его в ожидании (BR .) запросов ПП
; (PPIO.MAC, INT104); каждый запрос кончается CPEND. Ошибки: BREAK ("СТОП",
; PERR = 254), HALT (255), TRAP N (N - номер ошибки из ERMSG.MAC, PERR := N).
; Не используются: CHIMEM, RTIO, LC1, Switch.
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; Происхождение: Бейсик Вильнюс 1988 (MONIT.MAC). Сверка по тексту без
;     комментариев: блоков без изменений 12, изменённых 10, новых 2; строк кода
;     совпало 209 из 253 (82%). Метки блоков: [1988=] без изменений, [1988~N%]
;     изменено, [НОВОЕ] нет в 1988
; Главное: Монитор 1988 (цикл OK, ввод и анализ строк,
;     NEW/LIST/LLIST/DELETE/AUTO, отладка STEP/TRON/SEPAP/REPA, MEMORY, печать
;     ошибок MSTYPE) убран - это теперь IDE и ПП. Остались START/INIT, SETW
;     (связь с ПП), аварийные выходы BRKO/HALT/ENDPRG (они кончают запрос IDE
;     кодом в PERR и CPEND) и подпрограммы памяти (CLRBUF, CLRTXT, CLRCOD,
;     WRESET, STRMEM, IUNPCK).
; Блоки 1988, которых нет в Турбо (68): MONIT, STAR, AUTOCL, PRGLIN, NEXTL,
;     ANALIZ, AUNEXT, COMAND, BASVU, BASVEND, ATLINE, OK, TRTOPL, LNUM, ATLIN1,
;     AGAUD, ASCCOD, DEL, DELINT, NOSTEP, STEP, TRIN, STP2, REPA, HCOR, NEXPAP,
;     STPEND, SEPAP, NEW, LLIST, LIST, LS1, LS2, LS3, LS4, LS6, LS66, LARG,
;     ARGUM, EILUTE, STATM, MEMORY, SET1, SETST, SET2 и ещё 23
;------------------------------------------------------------------------------

	.INCLUDE /GENUKD.MAC/	; Настройки сборки (GENUKD.MAC)
	.SBTTL	MONIT
	.ENABLE LC		; Строчные буквы в тексте



BREAKW	==	4		;АДРЕС ВЕКТОРА ПРЕРЫВАНИЙ ПО КЛАВИШЕ "СТОП"
ILCODW	==	10		;АДРЕС ВЕКТОРА ПРЕРЫВАНИЯ "НЕДОПУСТИМЫЙ КОД"
FLOATW	==	244		;АДРЕС ВЕКТОРА ПРЕРЫВАНИЙ ПЛАВАЮЩЕЙ АРИФМЕТИКИ
TRAPW	=	34		;АДРЕС ВЕКТОРА ПРЕРЫВАНИЙ ПО ИНСТРУКЦИИ TRAP
TIMER	==	100		;АДРЕС ВЕКТОРА ПРЕРЫВАНИЙ ТАЙМЕРА
CHIMEM	==	160000

ABRKW	=	070074		;ВЕКТОР ОБРАБОТКИ "СТОП": 160170/2
AMEM	=	176640		;РЕГИСТР АДРЕСА ДОСТУПА КО ВСЕЙ ПАМЯТИ
DMEM	=	176642		;РЕГИСТР ДАННЫХ

.MCALL	.SETTOP .EXIT .PRINT .SERR .SCCA .ROFDF .CsiSpc .GtLin	; RT-11

.ROFDF				; Смещения системной области RT-11

.GLOBL	JMP,RTS,TRAP		; Подпрограммы машины шитого кода

.Psect	Main			; Секция начала программы

;------------------------------------------------------------------------------
; START - запуск: сохранить низкую память (векторы 0-13), векторы AVPK и FIS и
; вектор таймера (их вернёт ADDRMN), взять память (.SETTOP), задать начальные
; значения (AUTO, RND, USR, типы по умолчанию), пустую программу, устройства
; (MIDM), ввод-вывод IDE (IOINI), затем SETW.
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [1988~75%] изменено, MONIT.MAC:112-185: START (1988: 49 строк кода, здесь 44;
;     добавлено/изменено 11, удалено 16). Отличия: в 1988 ставился перехват
;     BREAK (ABRKW, BRUK через AMEM/DMEM), по SYSPTR/USRLOC определялась
;     верхняя граница памяти (.SERR, .SCCA с WSCCA), сбрасывался TRFLAG; здесь
;     запоминаются векторы 474 (SAV474) и 100 (RTI100), .SETTOP #-2, таблица
;     APRL заполняется значением 1002 (15 слов), затем CLRTXT и IOINI.
;------------------------------------------------------------------------------
START::


	Mov	#STACK,SP	; Начальный стек
	Mov	@#474,SAV474	; Сохранить вектор дисковода
	
10$:	MOV	#SAUG,R0	; R0 -> область сохранения
	CLR	R1		; R1 -> низкая память
	MOV	@#100,RTI100	; Вектор таймера - для ADDRMN
	MOV	#6,R2		; Слов низкой памяти (векторы 0-13)
6$:	MOV	(R1)+,(R0)+	; Сохранить
	SOB	R2,6$		; Повторить
	MOV	@#AVPK,(R0)+	; Вектор клавиатуры AVPK
	MOV	@#AVPK+2,(R0)+	; и его PSW

	MOV	@#FLOATW,(0)+	; Обработчик ошибок FIS (FLOATW)
	MOV	@#FLOATW+2,(0)+	; и его PSW
	CLR	@#BRKFLG	;ЗАПРЕТИТЬ BREAK (ДЛЯ УК)

	CLR	RUSLAT		; Режим ЛАТ

	.SETTOP	#-2		; Взять всю память: R0 = верхний адрес
		
	MOV	R0,@#WHIMEM	; WHIMEM = верхняя граница
	MOV	@#WHIMEM,@#HIMEM	; HIMEM = то же

	BIS	#10000,@#JSW	; Бит 10000 слова JSW (режим консоли RT-11)
	CLR	@#ASCFLG	; Файл не ASCII

	CLR	LPTPOS		; Позиция принтера = 0
	MOV	#200.,STRSIZ	; Область строк 200. байт
	MOV	#AUINC,R0	; R0 -> AUINC
	MOV	#12,(0)+	; AUINC = 10. (шаг AUTO)
	MOV	#12,(0)+	;CURLIN
	CLR	(R0)+		;VCTNMB

	MOV	R0,R1		; R1 -> III
	MOV	#40101,(0)+	;III
	MOV	#27076,(0)+	; III, второе слово
	MOV	(1)+,(0)+	;RNDSAV
	MOV	(1)+,(0)+	; RNDSAV, второе слово

	MOV	#10.,R1		; Число элементов USRTAB
1$:				;USRTAB
	MOV	#NOUSR,(0)+	;НЕОПРЕДЕЛЕННЫЕ ФУНКЦИИ USR
	SOB	R1,1$		; Повторить

	MOV	#APRL,R0	; R0 -> типы по буквам
	MOV	#15,R1		;НЕЯВНЫЙ ТИП
5$:	MOV	#1002,(R0)+	; Тип по умолчанию

	SOB	R1,5$		; Повторить
	
	CLR	@#PNTSAV	;STOPAR

	CALL	CLRTXT		; Пустая программа и буферы
	CALL	MIDM		;ИНИЦИАЛИЗАЦИЯ УСТРОЙСТВ
	CALL	IOINI		;ВВОД/ВЫВОД IDE
	
	
	
	CLR	@#VCTNMB	; Нет перехваченных векторов (ON)


;------------------------------------------------------------------------------
; [1988=] без изменений (MONIT.MAC:187-187): TOSETW
;------------------------------------------------------------------------------
TOSETW:	JMP	SETW		; Установить вектора

;------------------------------------------------------------------------------
; INIT - перезапуск (JMP с адреса 0, см. SETW): устройства, очистить экран
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [1988~100%] изменено, MONIT.MAC:192-197: INIT (1988: 7 строк кода, здесь 6;
;     добавлено/изменено 0, удалено 1). Отличия: в 1988 перед стартом
;     вызывалась SEPAP (снятие точек останова отладчика); здесь нет.
;------------------------------------------------------------------------------
INIT:	MOV	#STACK,SP	; Стек
	CALL	MIDM		; Устройства
	MOV	#14,R0		; Код FF:
	CALL	ISV		; очистить экран
	BR	TOSETW		; К установке векторов

;------------------------------------------------------------------------------
; [1988=] без изменений (MONIT.MAC:202-202): CTRLC
;------------------------------------------------------------------------------
CTRLC::	BR	BREAK		; CTRL/C - как STOP

;------------------------------------------------------------------------------
; ADDRMN - выход в RT-11: вернуть низкую память, векторы AVPK, FIS и таймера
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [1988~84%] изменено, MONIT.MAC:212-236: ADDRMN (1988: 22 строк кода, здесь
;     13; добавлено/изменено 2, удалено 11). Отличия: в 1988 выход в монитор:
;     TRAP 106, WRESET, очистка экрана, CURON, SETCRT, сообщение LC1; здесь
;     команда драйвера графики 10024 (снять драйвер: код 20 с паролем 20 в
;     старшем байте) и возврат вектора таймера 100.
;------------------------------------------------------------------------------
ADDRMN::
;	CALL	CURON

	MOV	#SAUG,R0	; R0 -> сохранённая область
	CLR	R1		; R1 -> низкая память
	MOV	#6,R2		; Слов
1$:	MOV	(R0)+,(R1)+	; Вернуть низкую память (векторы 0-13)
	SOB	R2,1$		; Повторить
	MOV	(R0)+,@#AVPK	; Вернуть вектор клавиатуры
	MOV	(R0)+,@#AVPK+2	; и его PSW

	MOV	(0)+,@#FLOATW	; Вернуть обработчик FIS
	MOV	(0)+,@#FLOATW+2	; и его PSW


	MOV	#10024,CODP	; F20 драйвера: слово 10024 = 20. + пароль 20
	MOV	RTI100,@#100	; Вернуть вектор таймера
	.EXIT			; Выход в RT-11

;------------------------------------------------------------------------------
; BREAK / BRKO - прерывание по СТОП или CTRL/C: запрос кончается с PERR = 254
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [1988~50%] изменено, MONIT.MAC:238-298: BRKO (1988: 48 строк кода, здесь 4;
;     добавлено/изменено 2, удалено 46). Отличия: в 1988 обработка BREAK:
;     сообщение WSTOP с номером строки, SEPAP, LNUM, TRTOPL, STOPEN; здесь
;     запрос IDE кончается кодом PERR = 376 и JMP CPEND.
;------------------------------------------------------------------------------
BRKO::

BREAK::

	MOV	#376,PERR	; Код ошибки 376 (восьм.): "СТОП"
	JMP	CPEND		; Конец запроса


;------------------------------------------------------------------------------
; SETW - вектора Бейсика: СТОП (4), TRAP (34), клавиатура, недопустимый код
; (10), ошибки FIS. Вектор, перехваченный ON...GOSUB прежней программы,
; снимается RSTVCT. В конце ЦП посылает ПП блок команды (14000, 32, Es) - по
; аналогии с Mp.Exe в IDE.MAC, запуск процедуры ПП по адресу Es (не проверено) -
; и ждёт запросов.
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [1988~58%] изменено, MONIT.MAC:303-339: SETW (1988: 30 строк кода, здесь 43;
;     добавлено/изменено 18, удалено 5). Отличия: вызовы .BJSR заменены на CALL
;     (оформление); добавлено: ILCODW := ILCDO, DS := TEXT и блок 14000, 32, Es
;     каналу ПП (176674/176676) с последующим ожиданием BR . (запросы IDE).
;------------------------------------------------------------------------------
SETW::				;УСТАНОВКА ВЕКТОРОВ ПРЕРЫВАНИЙ

	MOV	#137,@#0	; Ячейка 0: JMP @#INIT -
	MOV	#INIT,@#2	; переход на 0 перезапускает Бейсик

	MOV	#BREAKW,R0	; R0 = вектор 4 (СТОП)
	CALL	TSTVCT		; Указывает в код программы (ON)?

	BCC	2$		; да => не менять
	MOV	#BRKO,@R0	; Обработчик
	MOV	#340,2(R0)	; PSW: приоритет 7
2$:
	MOV	#TRAPW,R0	; R0 = вектор TRAP
6$:	CALL	RSTVCT		; Снять перехват ON с вектора
	BCC	6$		; снят => повторить
	MOV	#TRAP,@R0	; Обработчик TRAP (TRAP.MAC)
	MOV	#340,2(R0)	; PSW: приоритет 7

	MOV	#AVPK,R0	; R0 = вектор клавиатуры
3$:	CALL	RSTVCT		; Снять перехват ON с вектора
	BCC	3$		; снят => повторить
	MOV	#IVS,@R0	; Обработчик клавиатуры
	MOV	#340,2(R0)	; PSW: приоритет 7
	MOV	#100,@#ARSK	; Разрешить прерывания клавиатуры

	MOV	#ILCODW,R0	; R0 = вектор 10 (недопустимый код)
7$:	CALL	RSTVCT		; Снять перехват ON с вектора
	BCC	7$		; снят => повторить
	MOV	#ILCDO,@R0	; Обработчик
	MOV	#340,2(R0)	; PSW: приоритет 7

	MOV	#FLOATW,R0	; R0 = вектор FIS
4$:	CALL	RSTVCT		; Снять перехват ON с вектора
	BCC	4$		; снят => повторить
	MOV	#FERRI,@R0	; Обработчик ошибок FIS
	MOV	#340,2(R0)	; PSW: приоритет 7

	MOV	#ILCDO,@#ILCODW	; Вектор 10 ещё раз (без PSW)

	Mov	#Text,Ds	; DS = адрес TEXT (читает IDE)
	Push	Es		; Блок команды: адрес Es,
	Push	#32		; 32,
	Push	#14000		; 14000 (как Mp.Exe в IDE.MAC)
	Mov	Sp,r5		; R5 -> блок на стеке
	Mov	#4,r2		; Байт в сообщении: 4
1$:	Tstb	@#176674	; Канал ПП готов?
	Bpl	1$		; нет => ждать
	Movb	r5,@#176676	; Послать байт
	Swab	r5		; Следующий байт R5
	Sob	r2,1$		; Повторить
	


	
	
	

	BR	.		; Ждать запросов ПП (INT104)

;------------------------------------------------------------------------------
; FERRI - ошибка FIS: флаги PS кадра выбирают ошибку Бейсика (по сообщениям
; ERMSG; соответствие флагов не проверено); N - не ошибка, результат = 0
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [1988~93%] изменено, MONIT.MAC:355-374: FERRI (1988: 16 строк кода, здесь 15;
;     добавлено/изменено 1, удалено 2). Отличия: только оформление (метка и
;     команда в одной строке).
;------------------------------------------------------------------------------
FERRI:
	MOV	R0,-(SP)	; Сохранить R0
	MTPS	4(SP)		; Флаги PS из кадра прерывания
	BCS	1$		; C =>
	BMI	2$		; N => не ошибка =>
	BEQ	3$		; Z =>
	TRAP	6		; Ошибка 6: переполнение

1$:	TRAP	11.		; Ошибка 11: деление на нуль
3$:	TRAP	5		; Ошибка 5: неправильный вызов функции
2$:	MOV	SP,R0		; R0 -> стек прерванной программы
	ADD	#6,R0		; за кадром (PC, PS, R0)

	CLR	(R0)+		; Результат операции FIS = 0
	CLR	(R0)+		; (два слова)
	MOV	(SP)+,R0	; Вернуть R0
	RTI			; Выход



;------------------------------------------------------------------------------
; [1988=] без изменений (MONIT.MAC:446-477): RTIO, ILCDO, LC1 (блоков: 3)
;------------------------------------------------------------------------------
RTIO::	RTI			; Пустой обработчик
ILCDO::	TRAP	51.		; Ошибка 51: "CPU: Прерывание 10"



LC1:	.BYTE	33,'Y,'7,' ,200	; ESC Y: строка 23 (не используется)
.EVEN


;------------------------------------------------------------------------------
; ENDPRG - конец программы (ошибки нет); HALT - останов с PERR = 255
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: ENDPRG. новое: конец программы кончает
;     запрос IDE (PERR := 0, CPEND).
;------------------------------------------------------------------------------
ENDPRG::
END1:	CLR	PERR		; Ошибки нет

	JMP	CPEND		; Конец запроса

;------------------------------------------------------------------------------
; [1988~33%] изменено, MONIT.MAC:513-533: HALT (1988: 20 строк кода, здесь 3;
;     добавлено/изменено 2, удалено 19). Отличия: в 1988 останов с сообщением и
;     номером строки, SAVJMP, ADRHLT, переход в MONERR; здесь PERR := 377 и JMP
;     CPEND.
;------------------------------------------------------------------------------
HALT::
	MOV	#377,PERR	; Код 377 (восьм.): "CPU: Прерывание 4"
	JMP	CPEND		; Конец запроса

;------------------------------------------------------------------------------
; CLRBUF - отвести под HIMEM системный буфер файла (FCB, DFCB) и буфер очереди
; клавиатуры (FIRST, LAST)
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [1988=] без изменений (MONIT.MAC:654-677): CLRBUF, MEMFUL, CLRTXT, CLRTX1
;     (блоков: 4)
;------------------------------------------------------------------------------
CLRBUF::MOV	HIMEM,FCB	; Системный буфер файла под HIMEM:
1$:	SUB	#422,FCB	; 422 (восьм.) байт
	CLR	@FCB		; Буфер не занят
2$:	MOV	FCB,DFCB	; DFCB = его граница
	SUB	#400,FCB	; Буфер очереди клавиатуры ниже:
	MOV	FCB,FIRST	; очередь пуста
	MOV	FCB,LAST	; (FIRST = LAST)
	RETURN			; Выход
MEMFUL:	TRAP	7		; Ошибка 7: переполнение памяти

;------------------------------------------------------------------------------
; CLRTXT - буферы и пустая программа (CLRTX1 - только программа); CLRCOD -
; сброс кода: стек кадров пуст, ENDCOD за текстом, выполнение запрещено (ERRS)
;------------------------------------------------------------------------------
CLRTXT::CALL	CLRBUF		; Буферы
CLRTX1::MOV	FCB,TABTOP	;
	MOV	#TEXT,TXEND	; Текст пуст
	CLR	PFACT		; Нет DEF FN
	

;------------------------------------------------------------------------------
; [1988~100%] изменено, MONIT.MAC:687-695: CLRCOD (1988: 9 строк кода, здесь
;     10; добавлено/изменено 0, удалено 0). Отличия: только добавлена
;     глобальная метка CLRCOD::.
;------------------------------------------------------------------------------
CLRCOD::MOV	TABTOP,LENT	; Стек кадров FOR/GOSUB пуст
	MOV	TABTOP,LIMIT	; (LENT, LIMIT, CIKL = TABTOP)
	MOV	TABTOP,CIKL
	MOV	TXEND,ENDCOD	; ENDCOD сразу за текстом
	INC	ENDCOD
	BIC	#1,ENDCOD	; Выровнять по слову
	MOV	@PC,ERRS	;ЗАПРЕТИТЬ ВЫПОЛНЕНИЕ РАБОЧЕЙ ПРОГРАММ
	CLR	STRREG		; Области строк нет
	RETURN			; Выход
	;
;------------------------------------------------------------------------------
; WRESET - вернуть вектора, перехваченные ON...GOSUB (цепочка VCTNMB)
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [1988~95%] изменено, MONIT.MAC:702-724: WRESET (1988: 24 строк кода, здесь
;     22; добавлено/изменено 1, удалено 3). Отличия: убраны NOSTOP/STOPEN
;     (BREAK ведёт IDE), .BJSR заменено на CALL.
;------------------------------------------------------------------------------
WRESET::MOV	R0,-(SP)	; Сохранить R0
	MOV	R1,-(SP)	; и R1
	MFPS	-(SP)		; и PS
	MTPS	#340		; Прерывания запрещены
	MOV	#VCTNMB,R0	; R0 -> цепочка перехваченных векторов
2$:	MOV	@R0,R0		; R0 = очередной узел
	BEQ	3$		; нет => готово
	CALL	TSTVCT		; Вектор ещё в коде программы?
	BCS	1$		; нет => ошибка
	MOV	@R0,R1		; R1 -> узел
	MOV	-(R1),@R0	; Вернуть прежнее значение вектора
	TST	-(R1)		; Пропустить слово
	MOV	R1,R0		; К следующему узлу
	BR	2$		; Повторить
3$:	CLR	@#VCTNMB	; Цепочка пуста
	MTPS	(SP)+		; Вернуть PS
	MOV	(SP)+,R1	; и R1
	MOV	(SP)+,R0	; и R0
	RETURN			; Выход
1$:	CLR	@#VCTNMB	; Очистить цепочку
	TRAP	51.		; Ошибка 51

;------------------------------------------------------------------------------
; STRMEM - отвести область строк STRSIZ за кодом (нет места - ошибка 7)
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [1988~100%] изменено, MONIT.MAC:729-737: STRMEM (1988: 11 строк кода, здесь
;     10; добавлено/изменено 0, удалено 1). Отличия: только оформление (убрана
;     метка NOSTEP: из хвоста).
;------------------------------------------------------------------------------
STRMEM::MOV	ENDCOD,R1	; Область строк - за кодом
	MOV	R1,FREBEG	; FREBEG = начало
	ADD	STRSIZ,R1	; Плюс размер STRSIZ
	MOV	STRSIZ,FRELEN	; FRELEN = свободно
	CMP	R1,LENT		; Дошли до таблицы?
	BHI	MEMFUL		; да => нет памяти
	MOV	R1,ENDCOD	; ENDCOD - за областью строк
	MOV	FREBEG,STRREG	; STRREG = её начало
	RETURN			; Выход

;------------------------------------------------------------------------------
; ISGUNP / IUNPCK - целое R5 в десятичный текст. IUNPCK: в BUF, цифры и пробел
; после них; ISGUNP: в BUFOUT со знаком или пробелом. Выход: R1 - начало,
; R2 - длина. Деление на 10 - вычитанием сдвинутого делителя.
;------------------------------------------------------------------------------

;------------------------------------------------------------------------------
; [1988=] без изменений (MONIT.MAC:1311-1364): ISGUNP, IUNPCK, I1 (блоков: 3)
;------------------------------------------------------------------------------
ISGUNP::MOV	#BUFOUT,R3	; R3 -> BUFOUT
	MOVB	#40,(R3)+	; Пробел перед числом
	TST	R5		; Число отрицательное?
	BPL	1$		; нет =>
	MOVB	#'-,-1(R3)	; Знак "-" вместо пробела
	NEG	R5		; R5 = модуль
1$:	CALL	I1		; Преобразовать
	DEC	R1		; R1 -> знак (начало строки)
	INC	R2		; Длина + 1
	RETURN			; Выход: R1 - начало, R2 - длина
	;
IUNPCK::
	MOV	#BUF,R3		; R3 -> BUF
I1::	MOV	R3,-(SP)	; Запомнить начало
	ADD	#5,R3		; R3 -> конец поля из 5 цифр
	MOVB	#40,(R3)	; Пробел после числа
1$:	MOV	#5,R2		; R2 = 5, затем 10 (восьм. 12)
	CLR	R1		; R1 = частное
2$:	ASL	R2		; Сдвинуть делитель
	BCS	4$		; старший бит => назад
	CMP	R2,R5		; Делитель больше R5?
	BLOS	2$		; нет => ещё сдвиг
3$:	CMP	R2,#12		; Делитель = 10 (12 восьм.)?
	BEQ	5$		; да => цифра готова
	CLC			; Иначе C = 0
4$:	ROR	R2		; Сдвинуть делитель обратно
	ASL	R1		; Сдвинуть частное
	CMP	R2,R5		; Делитель больше остатка?
	BHI	3$		; да => дальше
	SUB	R2,R5		; Вычесть делитель
	INC	R1		; Бит частного
	BR	3$		; Дальше
5$:	ADD	#60,R5		; Остаток -> цифра
	MOVB	R5,-(R3)	; Цифра - в конец поля
	MOV	R1,R5		; R5 = частное
	BNE	1$		; ещё не 0 => следующая цифра
	MOV	@SP,R5		; R5 -> начало поля
	MOV	R5,R1		; R1 -> начало
	CLR	R2		; R2 = длина
	ADD	#6,@SP		; Конец поля
6$:	MOVB	(R3)+,(R5)+	; Цифры - в начало
	INC	R2		; Длина
	CMP	R3,@SP		; до конца поля
	BNE	6$		; Повторить
	TST	(SP)+		; Снять начало
	RETURN			; Выход

;------------------------------------------------------------------------------
; [НОВОЕ] в Бейсике 1988 аналога нет: Switch. новые данные: строка /RI/
;     (назначение не выяснено) и .END START.
;------------------------------------------------------------------------------
Switch:				; Не используется
	.Asciz	/RI/
	.Even
	
.END	START			; Точка входа

